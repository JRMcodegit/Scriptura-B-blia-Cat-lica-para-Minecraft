give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 34",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 E por baixo destas câmaras do Tesouro havia uma entrada da banda do oriente para os que vinham a elas do átrio exterior."},{text:"10 Na largura do âmbito do átrio, que estava defronte da parte oriental da fachada do edifício separado, havia ainda umas câmaras defronte dêste edifício."},{text:"11 Havia também um passadiço diante da sua fachada segundo a forma das câmaras, que estavam da banda do norte: Segundo era o seu comprimento, assim também era a sua largura, e tôda a entrada delas, e as suas figuras, e"},{text:"as suas portas:"},{text:"12 Tais como eram as portas das câmaras do Tesouro, que estavam situadas no lado em que olhava para o meio-dia: Tal era também a porta que se via no tôpo do passadiço: O qual passadiço estava diante do vestíbulo"},{text:"separado, para servir aos que entravam pela parte do oriente."},{text:"13 E o homem me disse: Estas câmaras do Tesouro, que ficam ao setentrião, e as que ficam ao meio-dia, que estão diante do edifício separado, são umas câmaras santas: Aqui é onde comem os sacerdotes, que se aproximam ao"},{text:"Senhor no Santuário: Aqui é que êles porão o Santo dos Santos, e a oblação que se faz pelo pecado, e pelo delito: Porque êste lugar é santo."},{text:"14 Quando os sacerdotes porém tiverem entrado, não sairão do lugar santo para o átrio exterior: E deixarão ali as suas vestimentas, com que exercem o seu ministério, porque são santas: E vestir-se-ão de outras"},{text:"vestimentas, e assim irão ter com o povo."},{text:"15 E tendo o homem acabado de tomar as medidas da casa interior, êle me fêz sair pelo caminho da porta, que olhava para a parte do oriente: E mediu por todos os lados em circuito."},{text:"16 Mediu pois pela banda do oriente com a cana de medir, que tinha quinhentas medidas desta cana por todo o arredor."},{text:"17 E mediu pela banda do setentrião, quinhentas medidas da mesma cana por todo o arredor."},{text:"18 E mediu pela banda do meio-dia, quinhentas medidas da mesma cana por todo o arredor."},{text:"19 E mediu pela banda do ocidente, quinhentas medidas da mesma cana."},{text:"20 Mediu o seu muro de tôdas as partes, segundo os quatro ventos, andando à roda, achando ter o comprimento de quinhentos côvados, e a largura de quinhentos côvados que era o espaço que havia entre o Santuário e o lugar"},{text:"do povo."},{text:"Ezequiel — capítulo 43."},{text:"1 Depois me levou êle à porta, que olhava para o caminho do oriente."},{text:"2 E eis-que entrava a glória do Deus de Israel pela banda do oriente: E o ruído que ela fazia era semelhante ao ruído das grandes águas, e a terra estava resplandecente pela presença da sua majestade."},{text:"3 tools — see the cookie policy for details"},{text:"4 E a majestade do Senhor entrou no templo pela banda da porta, que olhava para o oriente."},{text:"5 E o espírito me levantou, e êle me introduziu no átrio interior: E eis-que a casa estava cheia da glória do Senhor."},{text:"6 Então o ouvi eu falando-me de dentro da casa, e o homem que estava ao pé de mim,"},{text:"7 me disse: Filho do homem, êste é o lugar do meu trono, e o lugar das plantas dos meus pés, onde eu habito para sempre no meio dos filhos de Israel: E os da casa de Israel não profanarão mais para o futuro o meu santo"},{text:"nome, nem êles, nem os seus reis, pelas suas fornicações, e pelos sepulcros dos seus reis, e pelos seus altos."},{text:"8 Êles fizeram a sua porta ao pé da minha porta, e os postes da entrada da sua casa ao pé dos meus postes: E havia um muro entre mim e êles: E profanaram o meu santo nome pelas abominações que cometeram: Por isso eu os"},{text:"consumi na minha ira."},{text:"9 Agora pois deitem êles para longe de si a sua fornicação, e para longe de mim os sepulcros dos seus reis: E eu habitarei sempre no meio dêles."},{text:"10 Tu porém, filho do homem, mostra o templo à casa de Israel, para que êles se confundam das suas iniqüidades, e meçam tôda a sua fábrica:"},{text:"11 E se envergonhem de tudo o que fizeram: Mostra-lhes a figura da casa, e as saídas, e entradas da sua fábrica, e tôda a sua traça, e todos os preceitos acêrca dela, e tôda a sua ordem, e tôdas as suas leis, e tudo isto"},{text:"escreverás diante dos seus olhos: Para que guardem todos os seus desenhos, e os seus preceitos, e os cumpram."},{text:"12 Esta é a lei que se deve guardar no edificar da casa sôbre o cume do monte: Todo o seu têrmo em roda é santíssimo: Esta é pois a lei que se deve observar no edificar desta casa."},{text:"13 Ora estas são as medidas do altar medindo-o com um verdadeiríssimo côvado, que tinha um côvado e um palmo: O seu seio era de um côvado, e de um côvado era também a sua largura, e o seu remate até à sua borda, e por"},{text:"todo o circuito, era de um palmo: Esta era também a cova do altar."},{text:"14 E do seio da terra até à última margem havia dois côvados de altura, e a largura era de um côvado: E desta margem que era a mais pequena, até à outra margem que era a maior, havia quatro côvados, e a sua largura era"},{text:"também de um côvado."},{text:"15 O Ariel mesmo porém tinha quatro côvados: E do Ariel até acima se levantavam quatro cornos."},{text:"16 E o Ariel tinha doze côvados de comprido, e doze côvados de largo: Assim êle era quadrangular, tendo os seus lados iguais."},{text:"17 E a sua margem era de catorze côvados de comprido, e de catorze côvados de largo, medindo os seus quatro lados de um ângulo a outro: E a coroa que dominava tudo em roda dêle, saía fora meio côvado, e o seu seio era de"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 35",author:"Pe. A. P. de Figueiredo",pages:[{text:"um côvado em roda: Os seus degraus porém estavam virados para o oriente."},{text:"18 E o homem me disse: Filho do homem, isto diz o Senhor Deus: Estas são as cerimônias que se devem observar a respeito do altar sempre que êle fôr edificado: Para que sôbre êle se ofereça o holocausto, e se derrame o"},{text:"sangue."},{text:"19 E tu darás as vítimas aos sacerdotes, e aos levitas, que são da linhagem de Sadoc, que se chegam ao meu altar, diz o Senhor Deus, para que êles me sacrifiquem um novilho da manada pelo pecado."},{text:"20 E tomando do sangue dêsse novilho, pô-lo-ás sôbre os quatro cornos do altar, e sôbre os quatro cantos da sua margem, e sôbre a coroa por tôda a roda: E purificá-lo-ás, e expiarás."},{text:"21 Depois tomarás o novilho, que tiver sido oferecido pelo pecado: E queimá-lo-ás num lugar da casa todo separado, fora do santuário."},{text:"22 E no segundo dia oferecerás pelo pecado um bode novo que não tenha mancha: E purificarão o altar, como já o purificaram com o novilho."},{text:"23 E depois que tiveres acabado de o purificar, oferecerás um novilho da manada que não tenha mancha, e um carneiro do rebanho que também não tenha mancha."},{text:"24 E oferecê-los-ás na presença do Senhor: E os sacerdotes deitarão sal sôbre êles, e os oferecerão em holocausto ao Senhor."},{text:"25 Sete dias a fio oferecerás cada dia um bode pelo pecado: E da mesma sorte oferecerão um novilho da manada, e um carneiro dos rebanhos, que não tenham mancha."},{text:"26 Por sete dias expiarão o altar, e o purificarão: E encherão as suas mãos."},{text:"27 E cumpridos que fôrem os sete dias, ao oitavo dia e nos seguintes, oferecerão os sacerdotes os vossos holocaustos sôbre o altar, e as hóstias que oferecem pela paz: E eu me reconciliarei convosco, diz o Senhor Deus."},{text:"Ezequiel — capítulo 44."},{text:"1 O homem me fêz voltar depois para o caminho 