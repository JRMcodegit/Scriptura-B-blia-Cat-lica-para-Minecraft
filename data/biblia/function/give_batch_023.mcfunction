give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 Nadab porém filho de Jeroboão, reinou sôbre Israel no segundo ano de Asa rei de Judá: E reinou sôbre Israel dois anos."},{text:"26 E êle fêz o mal diante do Senhor, e andou nos caminhos de seu pai, e nos pecados, que êle tinha feito cometer a Israel."},{text:"27 Mas Baasa filho de Aías da casa de Issacar armou-lhe uma traição, e o matou em Gebeton, que é uma cidade dos filisteus: Porque Nadab e todo o Israel sitiavam Gebeton"},{text:"28 Baasa pois no terceiro ano de Asa, rei de Judá, matou a Nadab, e reinou em lugar dêle."},{text:"29 E tanto que reinou, matou tôda a casa de Jeroboão: Não deixou com vida nem sequer um da sua linhagem, até acabar inteiramente com ela, conforme a palavra que o Senhor tinha dito por bôca de seu servo Aías de Silo,"},{text:"30 por causa dos pecados de Jeroboão, que êle cometera, e pelos que fizera cometer a Israel: E por causa do delito com que tinha irritado o Senhor Deus de Israel."},{text:"31 O resto das ações de Nadab, e tudo o que êle fêz está escrito no Livro dos Anais dos reis de Israel."},{text:"32 E houve guerra entre Asa, e Baasa rei de Israel, todo o tempo de sua vida."},{text:"33 No terceiro ano de Asa, rei de Judá, reinou Baasa, filho de Aías, sôbre todo o Israel em Tersa vinte e quatro anos."},{text:"34 E êle fêz o mal diante do Senhor, e andou no caminho de Jeroboão, e nos pecados, que tinha feito cometer a Israel."},{text:"1 Reis — capítulo 16."},{text:"1 Dirigiu pois o Senhor a sua palavra a Jeú, filho de Hanani, contra Baasa, dizendo:"},{text:"2 Porquanto eu te levantei do pó, e te constitui chefe sôbre o meu povo de Israel, e tu andaste no caminho de Jeroboão, e fizeste pecar o meu povo de Israel, provocando-me a ira com os seus pecados:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Aquêle da linhagem de Baasa que morrer na cidade, comê-lo-ão os cães: E o que morrer no campo, comê-lo-ão as aves do céu."},{text:"5 O resto porém das ações de Baasa, e todos os seus feitos, e batalhas estão escritos no Livro dos Anais dos reis de Israel."},{text:"6 Adormeceu pois Baasa com seus pais, e foi enterrado em Tersa: E reinou por êle seu filho Ela."},{text:"7 Mas tendo o profeta Jeú, filho de Hanani, declarado o que o Senhor pronunciara contra Baasa, e contra a sua casa, e contra todos os males, que êle tinha feito aos olhos do Senhor, irritando-o com as obras das suas"},{text:"mãos, para o Senhor tratar a sua casa como a de Jeroboão: Por esta razão o matou êle, isto é, a Jeú profeta, filho de Hanani."},{text:"8 No ano vigésimo sexto de Asa, rei de Judá, reinou Ela, filho de Baasa, sôbre Israel em Tersa dois anos."},{text:"9 E rebelou-se contra êle seu servo Zambri, comandante de metade da sua cavalaria: E achava-se Ela em Tersa bebendo, e embriagado em casa de Arsa governador de Tersa."},{text:"10 Caindo pois Zambri sôbre êle, o feriu, e matou no ano vigésimo sétimo de Asa rei de Judá, e reinou em seu lugar."},{text:"11 E logo que êle reinou, e subiu ao seu trono, extinguiu tôda a casa de Baasa, e não deixou dela resto algum, assim parentes seus, como amigos."},{text:"12 E destruiu Zambri tôda a casa de Baasa, conforme a palavra que o Senhor tinha feito dizer a Baasa pela bôca do profeta Jeú,"},{text:"13 por causa de todos os pecados de Baasa, e dos pecados de seu filho Ela, que tinham pecado, e fizeram pecar a Israel irritando o Senhor Deus de Israel com as suas vaidades."},{text:"14 O mais das ações de Ela, e tudo o que êle fêz, está escrito no Livro dos Anais dos reis de Israel."},{text:"15 No ano vinte e sete de Asa, rei de Judá, reinou Zambri em Tersa sete dias: E o exército sitiava a Gebeton cidade dos filisteus."},{text:"16 E tendo ouvido que Zambri se tinha rebelado, e havia morto o rei, todo o Israel constituiu seu rei a Amri, o qual era general do exército de Israel que estava então em campanha."},{text:"17 Retirou-se pois Amri, e todo o Israel com êle de Gebeton, e vieram sitiar a Tersa."},{text:"18 E vendo Zambri que a cidade estava a ponto de ser tomada, entrou no palácio e se queimou a si juntamente com a casa real: E morreu."},{text:"19 nos seus pecados, que tinha cometido, obrando o mal diante do Senhor, e andando pelo caminho de Jeroboão, e no seu pecado, com que êle fêz pecar a Israel."},{text:"20 O mais das ações de Zambri, e da sua conjuração, e da sua tirania, está escrito no Livro dos Anais dos reis de Israel."},{text:"21 Então se dividiu o povo de Israel em dois partidos: Metade do povo seguia a Tebni, filho de Ginet, para o constituir rei: E a outra metade seguia Amri."},{text:"22 Mas o povo, que estava com Amri, prevaleceu contra o povo que seguia Tebni, filho de Ginet: E morreu Tebni, e reinou Amri."},{text:"23 No ano trinta e um de Asa, rei de Judá, reinou Amri sôbre Israel doze anos: Em Tersa reinou seis anos."},{text:"24 E comprou o monte de Samaria a Somer por dois talentos de prata: E edificou-o, e chamou a cidade que êle tinha edificado Samaria do nome de Semer, senhor do monte."},{text:"25 Amri porém fêz o mal diante do Senhor: E cometeu mais crimes do que todos os seus predecessores."},{text:"26 E andou em todo o caminho de Jeroboão, filho de Nabat, e nos seus pecados com que êle tinha feito pecar a Israel: Para irritar o Senhor Deus de Israel com as suas vaidades."},{text:"27 O resto das ações de Amri, e as suas batalhas, que êle deu, acham-se escritas nos Livros dos Anais dos reis de Israel."},{text:"28 E Amri dormiu com seus pais, e foi sepultado em Samaria: E em seu lugar reinou seu filho Acab."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"29 Acab pois, filho de Amri, reinou sôbre Israel no ano trinta e oito de Asa, rei de Judá. E reinou Acab, filho de Amri, sôbre Israel em Samaria vinte e dois anos."},{text:"30 E Acab, filho de Amri, fêz o mal diante do Senhor mais que todos os que tinha havido antes dêle."},{text:"31 Nem se contentou com andar nos pecados de Jeroboão filho de Nabat: Ainda mais tomou por mulher a Jezabel filha de Etbaal, rei dos sidônios. E foi, e serviu a Baal, e o adorou."},{text:"32 E pôs um altar a Baal no templo de Baal, que tinha edificado em Samaria,"},{text:"33 e plantou um bosque: E acumulou Acab seus crimes, irritando o Senhor Deus de Israel mais do que todos os reis de Israel, que o tinham precedido."},{text:"34 Durante o seu reinado fundou Hiel de Betel, a Jericó: Lançando os seus alicerces lhe morreu Abirão, seu primogênito, e quando lhe pôs as portas, lhe morreu Segub, seu último filho: Conforme o que o Senhor tinha"},{text:"predito por bôca de Josué, filho de Nun."},{text:"1 Reis — capítulo 17."},{text:"1 E Elias tesbita, dos habitantes de Galaad, disse a Acab: Viva o Senhor Deus de Israel, em cuja presença estou, que nestes anos não cairá nem orvalho nem chuva, senão conforme as palavras da minha bôca."},{text:"2 E dirigiu o Senhor a sua palavra a Elias, dizendo:"},{text:"3 tools — see the cookie policy for details"},{text:"4 e lá beberás da torrente: E eu mandei aos corvos que te sustentem ali mesmo."},{text:"5 Partiu pois, e obrou em conformidade da ordem do Senhor, e tendo-se retirado, se alojou ao pé da torrente de Carit, que é defronte do Jordão."},{text:"6 E os corvos lhe traziam pela manhã pão e carne, e êle bebia da torrente."},{text:"7 Mas passados dias secou-se a torrente: Porque não tinha chovido sôbre a terra."},{text:"8 Falou-lhe pois o Senhor, dizendo:"},{text:"9 Levanta-te, e vai para Sarepta dos sidônios e ali estarás: Porque eu ordenei a uma mulher viúva que te sustente."},{text:"10 Levantou-se, e foi para Sarepta. E quando êle tinha chegado à porta da cidade, lhe apareceu uma mulher viúva apanhando lenha, e êle a chamou, e lhe disse: Dá-me num vaso uma pouca d'água para beber."},{text:"11 E quando ela lha ia buscar, gritou Elias após ela, dizendo: Traze-me também, te peço, um bocado de pão na tua mão."},{text:"12 Ela lhe respondeu: Viva o Senhor teu Deus, que eu não tenho pão, senão sòmente obra de um punhado de farinha numa panela, e um pouco de azeite na almotolia: Eis-aqui ando eu ajuntando uns pauzinhos para ir prepará-lo"},{text:"para mim, e para meu filho para comermos, e depois morrer."},{text:"13 E Elias lhe disse: Não temas, mas vai, e faze como disseste: Contudo faze primeiro para mim dessa pouca de farinha um pãozinho cozido debaixo do rescaldo, e traze-mo: Para ti e para teu filho o farás depois."},{text:"14 Porque eis-aqui o que diz o Senhor Deus de Israel: A farinha que está na panela não faltará, nem se diminuirá na almotolia o azeite até o dia em que o Senhor faça cair chuva sôbre a terra."},{text:"15 Foi pois a mulher, e fêz como Elias tinha dito: E comeu êle, e ela e tôda a sua casa: E desde aquêle dia"},{text:"16 não faltou a farinha da panela, nem se diminuiu o azeite da almotolia, conforme o que o Senhor tinha predito por Elias."},{text:"17 Depois aconteceu o adoecer o filho desta viúva, mãe de família, e a doença era tão forte, que já não respirava."},{text:"18 Disse ela pois a Elias: Que te fiz eu, ó homem de Deus? Acaso vieste tu a minha casa, para excitares em mim a memória de meus pecados, e me matares meu filho?"},{text:"19 E Elias lhe disse: Dá-me cá o teu filho. E tomou-o do seu regaço e o levou à câmara onde êle mesmo assistia, e o pôs em cima do seu leito."},{text:"20 E clamou ao Senhor, e disse: Senhor meu Deus, que até a uma viúva, que me sustenta como pode, afligiste matando-lhe seu filho?"},{text:"21 E estendeu-se depois, e se mediu três vêzes sôbre o menino, e gritou ao Senhor, e disse: Senhor meu Deus, faze, te rogo, que a alma dêste menino torne às suas entranhas."},{text:"22 E o Senhor ouviu a voz de Elias, e a alma do menino tornou a entrar nêle e êle recobrou a vida."},{text:"23 E Elias tomou o menino, e o desceu da sua câmara à casa de baixo, e o entregou a sua mãe, e lhe disse: Eis-aí tens vivo a teu filho."},{text:"24 E a mulher respondeu a Elias: Agora nisto conheço eu que tu és um homem de Deus, e que a palavra do Senhor é verdadeira na tua bôca."},{text:"1 Reis — capítulo 18."},{text:"1 Muito tempo depois dirigiu o Senhor a sua palavra a Elias, no terceiro ano, dizendo: Vai, e apresenta-te diante de Acab, para eu dar chuva sôbre a terra."},{text:"2 Partiu pois Elias, para se mostrar a Acab: E a fome era extrema em Samaria."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque quando Jezabel matava os profetas do Senhor, êle Abdias tomou cem profetas, e os escondeu numas cavernas, cinqüenta numa e cinqüenta noutra, e os sustentou de pão e água."},{text:"5 Disse pois Acab a Abdias: Vai por estas terras tôdas às fontes de águas, e a todos os vales, a ver se podemos achar erva e salvar a vida aos cavalos, e aos machos e não pereçam de todo os animais."},{text:"6 E repartiram entre si as terras, para discorrerem por elas: Acab ia por um caminho, e Abdias separadamente ia por outro."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 E quando Abdias estava em caminho, Elias se encontrou com êle: E Abdias tendo-o conhecido, se prostrou com o rosto em terra, e disse: És tu, Elias meu senhor?"},{text:"8 Êle lhe respondeu: Sou eu. Vai, e dize a teu amo: Eis-aqui está Elias."},{text:"9 E êle disse: Que pecado cometi eu, para me entregares nas mãos de Acab a mim teu servo, para êle me matar?"},{text:"10 Viva o Senhor, teu Deus, que não há nação, nem reino, onde meu amo te não tenha mandado buscar: E dizendo-lhe todos: Não está aqui: Tem êle conjurado um por um a todos os reis e povos, por te não acharem."},{text:"11 E agora me dizes tu: Vai, e dize a teu amo: Eis-aqui está Elias."},{text:"12 E quando eu me apartar de ti, te levará o espírito do Senhor para um lugar que eu ignoro: E entrando a Acab lho direi, e não te achando, êle me matará: Mas teu servo teme o Senhor desde a sua infância."},{text:"13 Acaso não se te disse a ti meu Senhor, o que eu fiz, quando Jezabel matava os profetas do Senhor, que escondi cem dêstes profetas do Senhor numas cavernas cinqüenta numa e cinqüenta noutra, e os sustentei de pão e"},{text:"água?"},{text:"14 E agora dizes tu: Vai, e dize a teu amo: Eis-aqui está Elias: Para êle me matar."},{text:"15 E Elias disse: Viva o Senhor dos exércitos, em cuja presença estou, que eu me apresentarei hoje diante dêle."},{text:"16 Foi pois Abdias ter com Acab, e o avisou: E Acab saiu a encontrar-se com Elias."},{text:"17 E vendo-o, disse: Acaso és tu aquêle que trazes perturbado a Israel?"},{text:"18 E Elias respondeu: Não sou eu o que perturbei a Israel, mas és tu, e a casa de teu pai, por terdes deixado os mandamentos do Senhor, e por terdes seguido a Baal."},{text:"19 Mas, não obstante, manda agora, e faze ajuntar todo o povo de Israel no monte Carmelo, e os quatrocentos e cinqüenta profetas de Baal, e os quatrocentos profetas dos bosques, que comem da mesa de Jezabel."},{text:"20 Mandou pois Acab buscar todos os filhos de Israel, e ajuntou os profetas no monte Carmelo."},{text:"21 E Elias chegando-se a todo o povo disse: Até quando claudicareis vós para duas partes? Se o Senhor é o Deus, segui-o: Se porém o é Baal, segui-o. E o povo lhe não respondeu uma só palavra."},{text:"22 E tornou a dizer Elias ao povo: Eu sou o único que fiquei dos profetas do Senhor: Mas os profetas de Baal chegam a quatrocentos e cinqüenta homens."},{text:"23 Dêem-se-nos dois bois, e êles escolham para si um boi, e fazendo-o em quartos, o ponham sôbre a lenha, mas não lhe metam fogo por baixo: E eu tomarei o outro boi, e o porei sôbre a lenha, mas não lhe meterei fogo por"},{text:"baixo."},{text:"24 Invocai vós os nomes dos vossos deuses, e eu invocarei o nome do meu Senhor: E o Deus que ouvir mandando fogo, êsse seja o Deus. Todo o povo respondendo, disse: Ótima proposição."},{text:"25 Disse pois Elias aos profetas de Baal: Escolhei para vós um boi, e começai vós primeiro, porque sois em maior número: E invocai os nomes dos vossos deuses, e não ponhais fogo por baixo."},{text:"26 Êles tendo tomado o boi, que lhes foi dado, o sacrificaram: e invocavam o nome de Baal, desde a manhã até ao meio-dia, dizendo: Baal ouve-nos. Mas não se percebia voz, nem quem respondesse: E passavam saltando da"},{text:"outra parte do altar que tinham feito."},{text:"27 E sendo já meio-dia, Elias os motejava, dizendo: Gritai mais alto: Porque êsse deus, ou está talvez falando a alguém; ou está em alguma estalagem, ou no caminho, ou talvez dorme, e necessita que o acordem."},{text:"28 Êles pois gritavam ainda mais de rijo, e se retalhavam segundo o seu costume com canivetes e lancêtas, até se cobrirem de sangue."},{text:"29 Mas passado o meio-dia, e enquanto êles profetizavam chegou o tempo em que era costume oferecer-se o sacrifício, e não se ouvia voz, nem havia quem respondesse, nem ouvisse seus rogos."},{text:"30 Disse Elias a todo o povo: Chegai-vos a mim. E chegando-se o povo a êle, refez Elias o altar do Senhor, que tinha sido destruído."},{text:"31 E tomou doze pedras conforme o número das tribos dos filhos de Jacó, a quem o Senhor dirigira a sua palavra, dizendo: Israel será o teu nome."},{text:"32 E destas pedras edificou um altar em nome do Senhor: E fêz um regueiro, como de dois pequenos regos ao redor do altar,"},{text:"33 e consertou a lenha: E dividido o boi em quartos, o pôs sôbre a lenha,"},{text:"34 e disse: Enchei de água quatro talhas, e entornai-as sôbre o holocausto, e sôbre a lenha. E disse outra vez: Fazei isto ainda segunda vez. E tendo-o êles feito segunda vez, disse: Fazei ainda terceira vez isto mesmo."},{text:"E êles o fizeram terceira vez,"},{text:"35 e as águas corriam ao redor do altar, e o regueiro se encheu."},{text:"36 E sendo já o tempo de se oferecer o holocausto, chegando-se o profeta Elias, disse: Senhor Deus de Abraão, e de Isaac, e de Israel, mostra hoje que tu és o Deus de Israel, e que eu sou teu servo, e que por tua ordem"},{text:"eu fiz tôdas estas coisas."},{text:"37 Ouve-me, Senhor, ouve-me: Para que êste povo aprenda que tu és o Senhor Deus, e que tu converteste novamente o seu coração."},{text:"38 Caiu pois fogo do Senhor, e devorou o holocausto, e a lenha, e as pedras, lambendo o mesmo pó, e a água, que estava no regueiro."},{text:"39 O que tendo visto todo o povo, prostrou-se com o rosto em terra, e disse: O Senhor é o Deus, o Senhor é o Deus."},{text:"40 E Elias lhes disse: Apanhai os profetas de Baal, e não escape dêles nem um só. E, tendo-os o povo agarrado, Elias os levou à torrente de Cison, e ali os matou."},{text:"41 E disse Elias a Acab: Vai, come, e bebe: Porque se ouve o ruído duma grande chuva."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"42 Acab se retirou a comer e beber: Elias porém subiu ao alto do Carmelo, e inclinado por terra meteu o seu rosto entre os seus joelhos."},{text:"43 e disse ao seu criado: Vai, e olha para a banda do mar: Tendo êste ido, e tendo olhado disse: Não há nada. E Elias lhe disse segunda vez: Torna a ir sete vêzes."},{text:"44 E à sétima vez, eis-que uma pequena nuvem se levantava do mar, bem como a pegada de homem. Disse-lhe Elias: Vai, e dize a Acab: Faze meter os cavalos no teu coche e corre, não te apanhe a chuva."},{text:"45 E quando êle se voltava para uma e para outra parte, eis que se cobriu o céu de trevas, e vieram nuvens, e vento, e caiu uma grande chuva. Acab pois subindo ao coche foi para Jezrael:"},{text:"46 E a mão do Senhor foi sôbre Elias, e tendo-se cingido os rins, corria adiante de Acab, até chegar a Jezrael."},{text:"1 Reis — capítulo 19."},{text:"1 Referiu pois Acab a Jezabel tudo o que Elias havia feito, e como êle matara à espada todos os profetas."},{text:"2 E Jezabel enviou um mensageiro a Elias, dizendo: Os deuses me tratem com tôda a sua severidade, se eu amanhã a esta mesma hora te não fizer perder a vida, como tu fizeste perder a cada um dêles."},{text:"3 tools — see the cookie policy for details"},{text:"4 e andou pelo deserto, o caminho dum dia. E tendo chegado, e assentando-se debaixo dum junípero, desejou para si a morte, e disse: Basta-me de vida, Senhor, tira a minha alma: Porque eu não sou melhor do que meus pais."},{text:"5 E lançou-se em terra, e adormeceu à sombra do junípero: E eis que um anjo do Senhor o tocou, e lhe disse: Levanta-te, e come."},{text:"6 Olhou êle, e viu junto à sua cabeça um pão cozido debaixo da cinza, e um vaso de água, comeu pois, e bebeu, e tornou a adormecer."},{text:"7 E voltou segunda vez o anjo do Senhor, e o tocou, e lhe disse: Levanta-te, e come: Porque te resta um grande caminho."},{text:"8 Tendo-se êle levantado, comeu e bebeu, e com o vigor daquela comida caminhou quarenta dias, e quarenta noites, até o monte de Deus, Horeb."},{text:"9 E tendo chegado ali, ficou numa caverna: E eis-que o Senhor lhe dirigiu a sua palavra, e lhe disse: Que fazes aqui, Elias?"},{text:"10 E êle respondeu: Eu me consumo de zêlo pelo Senhor Deus dos exércitos, porque os filhos de Israel deixaram o teu pacto: Destruíram os teus altares, mataram os teus profetas à espada: e eu fiquei só, e êles me procuram"},{text:"para me tirarem a vida."},{text:"11 E disse-lhe: Sai e tem-te no monte diante do Senhor, e eis que passa o Senhor e um vento impetuoso e rijo, que transtorna os montes, e esmigalha as pedras diante do Senhor. O Senhor não estará no vento, e depois do"},{text:"vento haverá tremor: E o Senhor não estará no tremor,"},{text:"12 e depois do tremor acender-se-á um fogo: O Senhor não estará no fogo, e depois do fogo ouvir-se-á o assôpro duma branda viração."},{text:"13 Tendo Elias ouvido isto, cobriu o seu rosto com a capa, e tendo saído, pôs-se à entrada da caverna, e eis que sai uma voz que lhe dizia: Que fazes aqui, Elias? E êle respondeu:"},{text:"14 Eu me consumo de zêlo pelo Senhor Deus dos exércitos, porque os filhos de Israel deixaram o teu pacto: Destruíram os teus altares, mataram os teus profetas à espada, e eu fiquei só, e êles me procuram para tirar-me a"},{text:"vida."},{text:"15 E o Senhor lhe disse: Vai, e torna ao teu caminho pelo deserto para Damasco: E quando lá tiveres chegado, ungirás a Hazael em rei da Síria,"},{text:"16 e a Jeú, filho de Namsi, ungirás em rei sôbre Israel: E a Eliseu, filho de Safat, que é de Abelmeula, o ungirás profeta em teu lugar."},{text:"17 E acontecerá que todo o que escapar à espada de Hazael, Jeú o matará: E todo o que escapar à espada de Jeú, Eliseu o matará."},{text:"18 E eu me reservarei para mim em Israel sete mil homens, que não dobraram os joelhos diante de Baal, e não beijaram as mãos com a bôca para o adorar."},{text:"19 Tendo pois Elias partido dali, achou a Eliseu, filho de Safat, lavrando com doze juntas de bois: E êle mesmo conduzia um dos arados das doze juntas de bois: E chegando Elias a Eliseu, pôs a sua capa sôbre êle."},{text:"20 Êle imediatamente deixando os bois correu após Elias, e disse: Permite-me, te rogo, que vá beijar meu pai, e minha mãe, e assim seguir-te-ei. E Elias lhe respondeu: Vai, e volta: Porque eu fiz por ti o que era da"},{text:"minha parte."},{text:"21 E tendo Eliseu deixado a Elias, tomou uma junta de bois, e os matou, e com o arado dos bois cozeu as carnes, e as deu ao povo, e comeram: E levantando-se partiu, e seguiu a Elias, e o servia."},{text:"1 Reis — capítulo 20."},{text:"1 Benadad porém, rei da Síria, ajuntou todo o seu exército, e com êle trinta e dois reis, e cavalos e carroças: E subindo pelejou contra Samaria, e a sitiou."},{text:"2 E enviando à cidade mensageiros a Acab, rei de Israel,"},{text:"3 tools — see the cookie policy for details"},{text:"4 E o rei de Israel respondeu: Como tu dizes, ó rei meu senhor, eu sou teu, e tôdas as minhas coisas."},{text:"5 E voltando os mensageiros, disseram: Eis-aqui o que diz Benadad, que nos enviou a ti: Tu me hás de dar a tua prata, e o teu ouro, e as tuas mulheres, e os teus filhos."},{text:"6 Amanhã pois a esta mesma hora te enviarei os meus servos, e esquadrinharão tua casa, e a casa de teus servos: E êles tomarão com as suas mãos tudo o de que gostarem e o levarão."},{text:"7 Chamou pois o rei de Israel todos os anciãos do povo, e disse: Considerai, e vêde, que êle nos arma algum laço: Porque me mandou mensageiros a pedir minhas mulheres, e filhos, e a prata, e o ouro, e eu não disse que"},{text:"não."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 E todos os anciãos, e todo o povo lhe responderam: Não lhe dês ouvidos, nem condescendas com êle."},{text:"9 E assim respondeu aos mensageiros de Benadad: Dizei ao rei meu senhor: Eu farei tôdas as coisas que tu me enviaste a pedir no princípio a mim teu servo: Mas esta coisa não a posso fazer."},{text:"10 E voltando os mensageiros, lhe referiram a resposta. O qual os tornou a enviar e disse: Os deuses me tratem com a sua última severidade, se o pó de Samaria bastar para encher os punhados de todo o povo que me segue."},{text:"11 E o rei de Israel respondendo, disse: Dizei-lhe: Não se vanglorie o que toma as armas do mesmo modo como o que as larga."},{text:"12 Sucedeu pois que, quando Benadad ouviu esta resposta, êle estava bebendo nas suas tendas com os reis, e disse aos seus servos: Cercai a cidade. E êles a cercaram."},{text:"13 E eis que chegando-se um profeta a Acab rei de Israel, lhe disse: Eis-aqui o que diz o Senhor: Viste tôda esta inumerável multidão? Pois eu te declaro, que hoje ta entregarei nas tuas mãos: Para que tu saibas, que eu"},{text:"sou o Senhor."},{text:"14 E disse Acab: Por quem? E êle lhe respondeu: Eis-aqui o que diz o Senhor: Pelos criados de pé dos príncipes das províncias. E disse Acab: Quem começará a pelejar? E o profeta lhe disse: Tu."},{text:"15 Fêz Acab pois revista dos criados dos príncipes das províncias, e achou que eram duzentos e trinta e dois: E depois dêles fêz revista do povo, de todos os filhos de Israel, e achou que eram sete mil:"},{text:"16 E saíram ao meio-dia. Benadad porém já embriagado estava bebendo na sua tenda, e com êle os trinta e dois reis, que tinham vindo em seu socorro."},{text:"17 Os criados pois dos príncipes das províncias marchavam na primeira frente. E Benadad mandou espias. Os quais lhe vieram dizer: É gente que saiu de Samaria."},{text:"18 E êle disse: Ou êles venham tratar de paz, tomai-os vivos: Ou venham a pelejar, prendei-os vivos."},{text:"19 Avançaram-se pois os criados dos príncipes das províncias, e o resto do exército os seguia:"},{text:"20 E cada um dêles matou os que se lhe puseram diante: E logo os siros fugiram, e Israel os perseguiu. Benadad, rei da Síria, também fugiu a cavalo com os seus cavaleiros."},{text:"21 E o rei de Israel tendo também saído matou os cavalos, e destruiu as carroças, e maltratou a Síria com um grande estrago."},{text:"22 (Vindo pois um profeta ter com o rei de Israel, disse-lhe: Vai, e cobra ânimo, e sabe, e vê o que tens para fazer: Porque no ano seguinte virá o rei da Síria contra ti.)"},{text:"23 Os servos porém do rei da Síria lhe disseram: Os deuses dos montes são seus deuses, e por isso êles nos venceram: Mas é melhor que pelejemos com êles em campo raso, e vencê-los-emos."},{text:"24 Tu pois faze isto: Aparta do teu exército todos os reis, e põe em seu lugar os primeiros oficiais:"},{text:"25 E restabelece o número dos soldados, que morreram dos teus, e os cavalos conforme eram antes, e as carroças segundo o número das que tinhas antes: E nós pelejaremos contra êles em campo raso, e tu verás que os"},{text:"desbarataremos. Creu êle no conselho dêles, e assim o fêz."},{text:"26 Portanto tendo passado um ano, fêz Benadad revista dos siros, e veio a Afec, para combater contra Israel."},{text:"27 E fêz-se também revista dos filhos de Israel, e providos de víveres marcharam contra os siros: E se acamparam em frente dêles, como dois pequenos rebanhos de cabras: Os siros porém cobriam a terra."},{text:"28 (E vindo um homem de Deus disse ao rei de Israel: Eis-aqui o que diz o Senhor: Porque os siros disseram: O Deus dos montes é o Senhor e não é o Deus dos vales: Eu te entregarei nas mãos tôda esta grande multidão, e"},{text:"sabereis que eu sou o Senhor.)"},{text:"29 E estiveram os exércitos ordenados em batalha sete dias, êstes em frente daqueles, e ao sétimo dia se deu batalha: E os filhos de Israel mataram num dia cem mil homens de pé dos siros."},{text:"30 Os que escaparam, fugiram para a cidade de Afec: E caiu o muro sôbre vinte e sete mil homens, que tinham restado. Mas Benadad fugindo entrou na cidade, e retirou-se ao lugar mais secreto duma câmara."},{text:"31 E disseram-lhe os seus servos: Atende, nós temos ouvido dizer que os reis da casa de Israel são clementes: Ponhamos pois sacos sôbre os nossos rins, e cordas à roda das nossas cabeças, e vamos buscar o rei de Israel:"},{text:"Talvez que êle nos salve as vidas."},{text:"32 Pelo que êles se cingiram com sacos pelos rins, e puseram cordas nas suas cabeças, e vieram ter com o rei de Israel, e lhe disseram: O teu servo Benadad diz: Concede-me, eu te peço, a vida. E êle respondeu: Se êle"},{text:"ainda vive êle é meu irmão."},{text:"33 O que tomaram os homens por bom presságio: E tomaram logo a palavra da sua bôca, e disseram: Teu irmão Benadad. E êle lhes disse: Ide, e trazei-mo. Veio pois Benadad à presença de Acab, e êste o fêz montar sôbre a sua"},{text:"carroça."},{text:"34 E Benadad lhe disse: Eu te restituirei as cidades, que meu pai tomou a teu pai: E faze para ti praças em Damasco, assim como meu pai as fêz em Samaria, e eu me retirarei de ti depois de feita a aliança. Fêz pois a"},{text:"aliança e o deixou ir."},{text:"35 Então um dos filhos dos profetas disse da parte do Senhor a um seu companheiro: Fere-me. Mas êle o não quis ferir."},{text:"36 E êle lhe disse: Porque tu não quiseste ouvir a voz do Senhor, logo que te apartares de mim te matará um leão. E tendo-se êle apartado um pouco dêle, um leão o encontrou, e o matou."},{text:"37 Mas encontrando também outro homem, disse-lhe: Fere-me. Êste homem lhe deu e o feriu."},{text:"38 Retirou-se pois o profeta, e encontrou o rei no caminho, e disfarçou-se cobrindo de pó o seu rosto e os seus olhos."},{text:"39 E passando o rei, gritou ao rei, e disse-lhe: O teu servo saiu a pelejar de perto: E como fugisse um homem, outro mo trouxe, e me disse: Guarda-me êste homem: Se êle se escapar, a tua vida responderá pela vida dêle,"},{text:"ou tu pagarás um talento de prata."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"40 E quando eu todo turbado andava às voltas duma parte para a outra, de repente desapareceu. E o rei de Israel lhe disse: Esta é a tua sentença que tu mesmo pronunciaste."},{text:"41 Mas logo limpou o pó do seu rosto, e o rei de Israel conheceu que era um dos profetas."},{text:"42 E êle lhe disse: Eis-aqui o que diz o Senhor: Porque tu deixaste escapar das tuas mãos um homem digno de morte, a tua vida responderá pela vida dêle, e o teu povo pelo seu povo."},{text:"43 O rei de Israel porém voltou para sua casa, não fazendo caso de ouvir, e enfurecido veio para Samaria."},{text:"1 Reis — capítulo 21."},{text:"1 Passadas pois estas coisas, tinha naquele tempo Nabot de Jezrael, que estava em Jezrael, uma vinha ao pé do palácio de Acab, rei de Samaria."},{text:"2 E Acab falou a Nabot, dizendo: Dá-me a tua vinha, para fazer para mim uma horta, porque está vizinha, e ao pé de minha casa, e dar-te-ei por ela uma vinha melhor: Ou, se te faz mais conta, o dinheiro pelo preço que ela"},{text:"vale."},{text:"3 tools — see the cookie policy for details"},{text:"4 Veio pois Acab para sua casa agastado e encolerizado por causa da palavra, que Nabot jezraelita lhe dera, dizendo: Eu te não darei a herança de meus pais. E deitando-se na sua cama, voltou o rosto para a parede, e não"},{text:"comeu pão."},{text:"5 E Jezabel, sua mulher, veio ter com êle, e disse-lhe: Que é isto, de onde te vem esta tristeza? E por que não comes pão?"},{text:"6 Êle lhe respondeu: Falei a Nabot de Jezrael, e lhe disse: Dá-me a tua vinha recebendo o dinheiro, ou se te faz mais conta, dar-te-ei por ela outra vinha melhor. E êle me respondeu: Eu te não darei a minha vinha."},{text:"7 Disse-lhe pois Jezabel, sua mulher: Grande autoridade é a tua, e bem governas tu a Israel. Levanta-te, e come, e sossega o teu espírito, eu te darei a vinha de Nabot de Jezrael."},{text:"8 Logo escreveu ela uma carta em nome de Acab e a selou com o sêlo do rei, e a enviou aos anciãos, e aos príncipes, que havia na sua cidade, e habitavam com Nabot."},{text:"9 E o teor da carta era êste: Publicai um jejum, e fazei assentar Nabot entre os primeiros do povo,"},{text:"10 e ganhai contra êle dois homens filhos de Belial, e profiram um falso testemunho: Nabot blasfemou contra Deus e contra o rei: E trazei-o fora da cidade, e o apedrejai, e assim morra."},{text:"11 E os seus cidadãos mais velhos, e os primeiros, que viviam com êle na cidade, o fizeram como Jezabel lhes havia mandado, e como se continha na carta que ela lhes enviara:"},{text:"12 Publicaram o jejum, e fizeram assentar Nabot entre os primeiros do povo."},{text:"13 E tendo feito vir dois homens filhos do diabo, os fizeram assentar defronte dêle: E êles, como homens diabólicos, deram testemunho contra Nabot diante do ajuntamento, dizendo: Nabot blasfemou contra Deus e contra o"},{text:"rei: Pelo que o fizeram levar fora da cidade, e o mataram às pedradas."},{text:"14 E mandaram dizer a Jezabel: Nabot foi apedrejado, e morreu."},{text:"15 Sucedeu pois que tendo Jezabel ouvido que Nabot fôra apedrejado, e morrera, foi dizer a Acab: Vai, e faze-te senhor da vinha de Nabot de Jezrael, que te não quis fazer a vontade, nem dar-ta por dinheiro de contado:"},{text:"Porque Nabot já não vive, mas é morto."},{text:"16 Acab, tendo ouvido que Nabot era morto, levantou-se, e ia para a vinha de Nabot de Jezrael, para se apossar dela."},{text:"17 A êste tempo dirigiu o Senhor a sua palavra a Elias tesbita, dizendo:"},{text:"18 Levanta-te, e vai encontrar-te com Acab, rei de Israel, que está em Samaria: Porque eis-aí vai êle à vinha de Nabot, para tomar posse dela:"},{text:"19 E tu lhe falarás dizendo: Eis-aqui o que te diz o Senhor: Tu o mataste, e em cima te senhoreaste. E depois acrescentarás: Isto é o que diz o Senhor: Neste lugar em que os cães lamberam o sangue de Nabot, lamberão êles"},{text:"também o teu sangue."},{text:"20 E Acab disse a Elias: Porventura achaste que eu fôsse teu inimigo? Elias lhe respondeu: Eu o achei em tu sêres vendido, para fazerdes o mal aos olhos do Senhor."},{text:"21 Eis-aí farei eu cair o mal sôbre ti, e arrancarei a tua posteridade, e matarei da casa de Acab até o que urina à parede, e o encerrado e o último filho de Israel:"},{text:"22 E eu darei a tua casa como a casa de Jeroboão, filho de Nabat, e como a casa de Baasa filho de Aía: Porque obraste de modo que me provocaste à ira, e fizeste pecar a Israel."},{text:"23 E também de Jezabel falou o Senhor, dizendo: Os cães comerão a Jezabel no campo de Jezrael."},{text:"24 Se Acab morrer na cidade, comê-lo-ão os cães: Mas se morrer no campo comê-lo-ão as aves do céu."},{text:"25 Não houve pois outro tal como Acab, que se vendeu para fazer o mal aos olhos do Senhor: Porque Jezabel, sua mulher, o incitou,"},{text:"26 e êle se tornou tão abominável, que seguia os ídolos dos amorreus, que o Senhor tinha exterminado à face dos filhos de Israel."},{text:"27 Portanto tendo Acab ouvido estas palavras, rasgou os seus vestidos, e cobriu a sua carne dum cilício, e jejuou e dormiu com o saco, e andou de cabeça baixa."},{text:"28 E o Senhor dirigiu a sua palavra a Elias tesbita, dizendo:"},{text:"29 Não viste a Acab humilhado diante de mim? Porque êle pois se humilhou por minha causa, não farei eu cair o mal enquanto êle viver, mas em tempo de seu filho farei cair o mal sôbre a sua casa."},{text:"1 Reis — capítulo 22."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Passaram-se pois três anos sem haver guerra alguma entre a Síria e Israel."},{text:"2 Mas ao terceiro ano, veio Josafat, rei de Judá, ter com o rei de Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 E disse a Josafat: Virás tu comigo à guerra contra Ramot de Galaad?"},{text:"5 E Josafat respondeu ao rei de Israel: Tu podes dispor de mim, como de ti mesmo: O meu povo, e o teu povo são um mesmo: E a minha cavalaria é a tua cavalaria. E disse Josafat ao rei de Israel: Consulta hoje, te peço, a"},{text:"vontade do Senhor."},{text:"6 O rei de Israel pois ajuntou os seus profetas, perto de quatrocentos homens, e disse-lhes: Devo eu ir a pelejar contra Ramot de Galaad, ou deixar-me estar quieto? Êles lhe responderam: Vai, e o Senhor a entregará nas"},{text:"mãos do rei."},{text:"7 Mas Josafat disse: Não há aqui nenhum profeta do Senhor, para nós o consultarmos por êle?"},{text:"8 E o rei de Israel respondeu a Josafat: Ficou um homem, por quem nós podemos consultar o Senhor: Mas eu o aborreço porque êle me não profetiza o bem, mas o mal, Miquéias, filho de Jemla. E Josafat lhe disse: Ó rei, não"},{text:"fales assim."},{text:"9 Chamou pois o rei de Israel um eunuco, e lhe disse: Traze-me aqui depressa a Miquéias, filho de Jemla."},{text:"10 E o rei de Israel, e Josafat, rei de Judá, estavam assentados cada um no seu trono, vestidos com magnificência real, numa eira junto à porta de Samaria, e todos os profetas profetizavam diante dêles."},{text:"11 Fêz também para si Sedecias, filho de Canaana, umas pontas de ferro, e disse: Eis-aqui o que diz o Senhor: Com estas armas agitarás a Síria, até a destruíres."},{text:"12 E todos os profetas profetizavam da mesma maneira, dizendo: Vai contra Ramot de Galaad, e marcha felizmente, e o Senhor a entregará nas mãos do rei."},{text:"13 O mensageiro porém que tinha ido a chamar a Miquéias, lhe falou, dizendo: Eis-aí todos os profetas a uma voz predizem bom sucesso ao rei: Sejam pois as tuas palavras semelhantes às dêles, e anuncia novas favoráveis."},{text:"14 Miquéias lhe respondeu: Viva o Senhor, que eu não direi senão o que o Senhor me disser."},{text:"15 Apresentou-se pois diante do rei, e o rei lhe disse: Miquéias, devemos nós ir pelejar contra Ramot de Galaad, ou ficarmos quedos? Miquéias lhe respondeu: Vai, e marcha felizmente, e o Senhor a entregará nas mãos do"},{text:"rei."},{text:"16 Mas o rei lhe disse: Eu te conjuro uma e outra vez em nome do Senhor, que me não fales senão a verdade."},{text:"17 E êle lhe disse: Eu vi todo o Israel disperso pelos montes, como ovelhas que não têm pastor: E o Senhor disse: Êles não têm condutor: Torne cada um em paz para sua casa."},{text:"18 (Disse pois o rei de Israel para Josafat: Não te disse eu, que êste homem nunca me profetiza o bem, mas sempre o mal?)"},{text:"19 Miquéias porém acrescentando, disse: Por isso ouve a palavra do Senhor: Eu vi o Senhor assentado sôbre o seu trono, e todo o exército do Céu ao redor dêle, à direita e à esquerda,"},{text:"20 e o Senhor disse: Quem enganará a Acab rei de Israel, para que êle marche, e pereça em Ramot de Galaad? E um disse uma coisa, e outro outra."},{text:"21 Mas o espírito maligno se adiantou, e se apresentou diante do Senhor, e disse: Eu o enganarei. E o Senhor lhe disse: De que modo?"},{text:"22 E êle respondeu: Eu sairei, e serei um espírito mentiroso na bôca de todos os seus profetas. E o Senhor disse: Tu o enganarás, e prevalecerás: Sai, e faze-o assim."},{text:"23 Eis-aqui pois agora pôs o Senhor um espírito de mentira na bôca de todos os teus profetas, que aqui estão, e o Senhor pronunciou o mal contra ti."},{text:"24 Chegou-se pois Sedecias, filho de Canaana, e deu uma bofetada em Miquéias na maçã do rosto, e disse: Logo a mim me largou o espírito do Senhor, e te falou a ti."},{text:"25 E Miquéias disse: Tu o verás naquele dia, quando entrares de câmara em câmara para te esconderes."},{text:"26 E disse o rei de Israel: Tomai a Miquéias, e fique em poder de Amon, governador da cidade, e de Joás, filho de Amelec,"},{text:"27 e dizei-lhes: Eis-aqui o que o rei ordena: Metei êste homem na cadeia e sustentai-o com pão de tribulação, e água de angústia, até que eu volte em paz."},{text:"28 E Miquéias disse: Se tu voltares em paz, não falou o Senhor por mim. E prosseguiu: Ouvi, povos todos."},{text:"29 Com isto marchou o rei de Israel, e Josafat, rei de Judá, contra Ramot de Galaad."},{text:"30 Disse pois o rei de Israel a Josafat, rei de Judá: Toma as armas e entra no combate, e veste os teus vestidos. Mas o rei de Israel mudou de trajo, e entrou na batalha."},{text:"31 O rei da Síria porém tinha ordenado aos trinta e dois capitães das suas carroças, dizendo: Não pelejareis contra algum pequeno ou grande, mas sòmente contra o rei de Israel."},{text:"32 Os capitães das carroças pois tendo visto a Josafat, imaginaram que êle era o rei de Israel, e caindo com ímpeto pelejavam contra êle: E Josafat exclamou."},{text:"33 E os capitães das carroças conheceram que não era o rei de Israel, e cessaram de o investir."},{text:"34 Um homem porém armou o seu arco, apontando a seta à ventura, e por acaso feriu o rei de Israel entre o bofe e o estômago. Mas êle disse ao seu cocheiro: Toma a volta, e tira-me do exército, porque estou gravemente"},{text:"ferido."},{text:"35 Deu-se pois a batalha naquele dia, e o rei de Israel estava na sua carroça voltado para os siros: E corria o sangue da ferida sôbre tôda a carroça, e êle morreu de tarde,"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"36 e antes que o sol se pusesse, tocou um pregoeiro a trombeta por todo o exército, dizendo: Cada um volte para a sua cidade, e para a sua terra."},{text:"37 Morreu pois o rei, e foi levado a Samaria: E enterraram o rei em Samaria,"},{text:"38 e lavaram a sua carroça na piscina de Samaria, e os cães lamberam o seu sangue, e lavaram as rédeas conforme a palavra que o Senhor tinha pronunciado"},{text:"39 O resto pois das ações de Acab, e tudo o que êle fêz, a casa de marfim, que fabricou e tôdas as cidades, que fundou, estão escritas no Livro dos Anais dos Reis de Israel."},{text:"40 Dormiu pois Acab com seus pais, e reinou em seu lugar Ocozias, seu filho."},{text:"41 E Josafat, filho de Asa, tinha começado a reinar sôbre Judá no quarto ano de Acab, rei de Israel."},{text:"42 Tinha trinta e cinco anos quando começou a reinar, e reinou vinte e cinco anos em Jerusalém: Sua mãe chamava-se Azuba, filha de Salai."},{text:"43 E andou em todos os caminhos de Asa, seu pai, e não se desviou dêles: E fêz o que era reto diante do Senhor."},{text:"44 Não destruiu contudo os altos: Porque ainda o povo sacrificava, e queimava incenso nos altos."},{text:"45 E Josafat teve paz com o rei de Israel."},{text:"46 O mais das ações de Josafat, e os seus feitos, e as suas guerras, estão tôdas escritas no Livro dos Anais dos reis de Judá."},{text:"47 Extirpou também da terra os restos dos afeminados, que tinham ficado do tempo de seu pai Asa."},{text:"48 E então não havia rei constituído em Edom."},{text:"49 E o rei Josafat tinha preparado frotas no mar, que navegassem para Ofir por causa do ouro: Mas não puderam ir, porque se destroçaram em Asiongaber."},{text:"50 Então disse Ocozias, filho de Acab, a Josafat: Vão os meus servos embarcados com os teus. Mas Josafat não quis."},{text:"51 E dormiu Josafat com seus pais, e foi sepultado com êles na cidade de Davi, seu pai: E Jorão, seu filho, reinou em seu lugar."},{text:"52 Ocozias porém filho de Acab começou a reinar sôbre Israel em Samaria, no ano dezessete de Josafat rei de Judá, e reinou sôbre Israel dois anos."},{text:"53 E êle obrou o mal diante do Senhor, e andou no caminho de seu pai, e de sua mãe, e no caminho de Jeroboão filho de Nabat, que tinha feito pecar a Israel."},{text:"54 Serviu também a Baal, e o adorou, e irritou o Senhor Deus de Israel conforme tudo o que seu pai tinha feito."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Reis Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Reis — capítulo 1."},{text:"1 Depois da morte de Acab, sacudiu Moab o jugo de Israel."},{text:"2 E Ocozias caiu pelas grades dum quarto alto, que tinha em Samaria, e adoeceu: E enviou mensageiros, dizendo-lhes: Ide, consultai a Belzebu, deus de Acaron, se poderei eu convalescer desta minha moléstia."},{text:"3 tools — see the cookie policy for details"},{text:"4 Por isso eis-aqui o que diz o Senhor: Tu te não levantarás da cama, em que jazes mas certissimamente morrerás. E Elias partiu."},{text:"5 E os mensageiros voltaram para Ocozias, o qual lhes disse: Por que voltastes?"},{text:"6 Êles porém lhe responderam: Um homem nos saiu ao encontro, e nos disse: Ide, e tornai para o vosso rei, que vos mandou, e lhe direis: Eis-aqui o que diz o Senhor: Acaso, porque não há um Deus em Israel, mandas a"},{text:"consultar a Belzebu, deus de Acaron? Pois por isso te não levantarás tu da cama em que jazes, mas certissimamente morrerás."},{text:"7 E êle lhes disse: Que figura, e que hábito é o dêsse homem, que se encontrou convosco, e vos disse essas palavras?"},{text:"8 E êles responderam: É um homem coberto de cabelos, e que anda cingido sôbre os rins com uma cinta de couro. Êle disse: É Elias tesbita."},{text:"9 E logo lhe enviou um capitão de cinqüenta homens, e os cinqüenta soldados que estavam debaixo do seu mando. O qual foi ter com Elias: E estando êle assentado no cume dum monte, lhe disse: Homem de Deus, o rei mandou"},{text:"que venhas."},{text:"10 E respondendo Elias, disse ao capitão dos cinqüenta soldados: Se eu sou homem de Deus, desça fogo do céu, e te devore a ti, e aos teus cinqüenta homens. Desceu pois fogo do céu, e o devorou, e aos cinqüenta homens que"},{text:"estavam com êle."},{text:"11 E enviou outra vez Ocozias segundo capitão de cinqüenta soldados, e os seus cinqüenta com êle. O qual lhe disse: Homem de Deus, o rei diz isto: Apressa-te, e vem."},{text:"12 Respondendo Elias, disse: Se eu sou homem de Deus, desça fogo do céu, e te devore a ti, e os teus cinqüenta homens. Desceu pois fogo do céu, e o devorou e os seus cinqüenta homens."},{text:"13 Enviou outra vez Ocozias terceiro capitão de cinqüenta homens, e os cinqüenta homens, que estavam com êle. O qual tendo chegado, se pôs de joelhos diante de Elias e lhe suplicou, e disse: Homem de Deus, não desprezes"},{text:"a minha alma, nem as almas dos teus servos que estão comigo."},{text:"14 Eis-aí desceu o fogo do céu, e devorou os dois primeiros capitães dos cinqüenta homens, e os cinqüenta que estavam com êles: Mas agora eu te suplico que te compadeças da minha alma."},{text:"15 E o anjo do Senhor falou a Elias, dizendo: Desce com êle, não temas. Levantou-se pois, e desceu com êste capitão a buscar o rei,"},{text:"16 e lhe disse: Eis-aqui o que diz o Senhor: Porque tu enviaste mensageiros a consultar a Belzebu, deus de Acaron, como se não houvesse um Deus em Israel, que tu pudesses consultar, por isso tu te não levantarás da cama,"},{text:"em que jazes, mas certissimamente morrerás."},{text:"17 Morreu pois Ocozias conforme a palavra do Senhor, que pronunciou Elias, e em seu lugar reinou Jorão, seu irmão, no segundo ano de Jorão, filho de Josafat rei de Judá: Porque Ocozias não tinha filho."},{text:"18 O resto porém das ações de Ocozias está escrito no Livro dos Anais dos reis de Israel."},{text:"2 Reis — capítulo 2."},{text:"1 Aconteceu pois que quando o Senhor quis arrebatar Elias ao Céu por um remoinho, vinham Elias e Eliseu de Galgala."},{text:"2 E Elias disse a Eliseu: Fica aqui, porque o Senhor me mandou a Betel. Eliseu lhe respondeu: Viva o Senhor, e viva a tua alma, que eu não te deixarei. E indo para Betel,"},{text:"3 tools — see the cookie policy for details"},{text:"4 E disse pois Elias a Eliseu: Fica aqui, porque o Senhor me mandou a Jericó. E êle respondeu: Viva o Senhor, e viva a tua alma, que eu te não hei de deixar. E tendo chegado a Jericó,"},{text:"5 vieram os filhos dos profetas, que estavam em Jericó, ter com Eliseu, e disseram-lhe: Acaso sabes tu que o Senhor te há de tirar hoje teu amo? E êle disse: Eu também o sei: Calai-vos."},{text:"6 Disse-lhe pois Elias: Fica aqui, porque o Senhor me mandou até ao Jordão. E êle respondeu: Viva o Senhor, e viva a tua alma, que eu te não hei de deixar. Foram pois ambos juntos,"},{text:"7 e cinqüenta dos filhos dos profetas os seguiram, os quais também pararam defronte dêle, de longe: E êles ambos se puseram à borda do Jordão."},{text:"8 E tomou Elias a sua capa, e dobrou-a, e feriu as águas, as quais se dividiram para as duas bandas, e passaram ambos a pé enxuto."},{text:"9 E tendo passado, disse Elias a Eliseu: Pede-me o que queres que eu te alcance, antes que eu seja arrebatado de ti. E Eliseu respondeu: Peço que seja dobrado em mim o teu espírito."},{text:"10 Elias respondeu: Dificultosa coisa pediste: Todavia se tu me vires, quando me arrebatarem de ti, terás o que pediste: Mas se me não vires, não o terás."},{text:"11 E continuando o seu caminho, e caminhando a conversar entre si, eis-que um carro de fogo, e uns cavalos de fogo os separaram um do outro: E Elias subiu ao céu por meio de um remoinho,"},{text:"12 E Eliseu o via, e clamava: Meu pai, meu pai, carro de Israel, e seu condutor. E não o viu mais: E tomou os seus vestidos e os rasgou em duas partes."},{text:"13 E levantou do chão a capa, que Elias lhe tinha deixado cair: E voltando parou à borda do Jordão,"},{text:"14 e pegando na capa, que Elias lhe tinha deixado cair, feriu as águas, e elas não se dividiram: E disse: Onde está ainda agora o Deus de Elias? E feriu as águas, e elas se dividiram duma, e doutra parte, e Eliseu as"},{text:"passou."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Reis Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Vendo pois os filhos dos profetas, que estavam em Jericó defronte, disseram: O espírito de Elias repousou sôbre Eliseu. E vindo sair-lhe ao encontro, se prostraram por terra a seus pés com profundo respeito."},{text:"16 e disseram-lhe: Sabe que entre os teus servos há cinqüenta homens fortes, que podem ir a buscar teu amo, porque talvez que o espírito do Senhor o levasse, e atirasse com êle para algum monte, ou para algum vale:"},{text:"Eliseu respondeu: Não mandeis."},{text:"17 E o constrangeram, até que êle lhe condescendeu, e disse: Mandai. Mandaram êles pois cinqüenta homens, os quais tendo-o buscado três dias, o não acharam."},{text:"18 E voltaram para Eliseu: E êle estava em Jericó, e lhes disse: Não vos disse eu: Não mandeis?"},{text:"19 Disseram também a Eliseu os habitantes desta cidade: A habitação desta cidade é muito cômoda, como tu mesmo, Senhor, vês: Mas as águas são péssimas, e a terra estéril."},{text:"20 E êle respondeu: Trazei-me um vaso novo, e deitai-lhe sal. Como lho tivessem trazido,"},{text:"21 saiu êle à fonte das águas, e deitou o sal nela: E disse: Eis-aqui o que diz o Senhor: Eu sarei estas águas, e elas não causarão mais nem morte, nem esterilidade."},{text:"22 Tornaram-se pois sadias as águas até ao dia de hoje conforme a palavra que disse Eliseu."},{text:"23 E dali veio para Betel: e indo pelo caminho, uns meninos pequenos saíram da cidade, e zombavam dêle, dizendo: Sobe, calvo, sobe, calvo."},{text:"24 E Eliseu virando-se para êles, os viu, e os amaldiçoou em nome do Senhor: E saíram dois ursos do bosque, e despedaçaram dêles quarenta e dois meninos."},{text:"25 Retirou-se pois dali para o monte Carmelo, e de lá voltou para Samaria."},{text:"2 Reis — capítulo 3."},{text:"1 Jorão porém, filho de Acab, reinou sôbre Israel em Samaria no décimo oitavo ano de Josafat rei de Judá. E reinou doze anos."},{text:"2 E êle obrou o mal diante do Senhor, mas não tanto como seu pai, e sua mãe: Porque tirou as estátuas de Baal, que seu pai tinha feito."},{text:"3 tools — see the cookie policy for details"},{text:"4 Ora Mesa, rei de Moab, sustentava muitos gados, e pagava ao rei de Israel cem mil cordeiros, e cem mil carneiros com os seus velos."},{text:"5 Porém depois da morte de Acab, quebrou o ajuste que tinha feito com o rei de Israel."},{text:"6 Por isso o rei Jorão saiu naquele dia de Samaria, e fêz revista de todo o Israel."},{text:"7 E mandou dizer a Josafat, rei de Judá: O rei de Moab se sublevou contra mim, vem tu comigo a pelejar contra êle. Josafat respondeu: Eu irei. O que é meu é teu: O meu povo é teu povo: E os meus cavalos são teus cavalos."},{text:"8 E disse: Por que caminho iremos? E Jorão respondeu: Pelo deserto da Iduméia."},{text:"9 Marcharam pois o rei de Israel, e o rei de Judá, e o rei de Edom, e andaram rodeando com uma marcha de sete dias, e não havia água para o exército, nem para as bêstas, que os seguiam."},{text:"10 E disse o rei de Israel: Ai, ai, ai! O Senhor nos ajuntou três reis, para nos entregar nas mãos de Moab."},{text:"11 E disse Josafat: Aqui não há nenhum profeta do Senhor, para implorarmos por êle o Senhor? E um dos servos do rei de Israel respondeu: Aqui está Eliseu, filho de Safat, que dava água às mãos a Elias."},{text:"12 E disse Josafat: A palavra do Senhor está nêle. E foram ter com êle o rei de Israel, e Josafat, rei de Judá, e o rei de Edom."},{text:"13 E Eliseu disse ao rei de Israel: Que tenho eu contigo? Vai ter com os profetas de teu pai, e de tua mãe. E o rei de Israel lhe disse: Por que ajuntou o Senhor êstes três reis, para os entregar nas mãos de Moab?"},{text:"14 E Eliseu lhe respondeu: Viva o Senhor dos exércitos em cuja presença estou, que se não fôsse por respeitar a pessoa de Josafat rei de Judá, eu sem dúvida te não atenderia, nem poria em ti os olhos."},{text:"15 Mas agora mandai-me cá um harpista. E quando êste cantava ao som da harpa, foi a mão do Senhor sôbre Eliseu, e disse:"},{text:"16 Eis-aqui o que diz o Senhor: Fazei várias poças pela madre desta torrente."},{text:"17 Porque eis-aqui o que diz o Senhor: Vós não vereis vento, nem chuva: Mas esta madre se encherá de água, e bebereis vós e os vossos servos, e as vossas bêstas."},{text:"18 E isto é pouco na presença do Senhor: Ainda mais êle entregará também Moab nas vossas mãos."},{text:"19 E vós destruireis tôdas as cidades fortes, e tôdas as praças as mais importantes, e cortareis pelo pé tôdas as árvores frutíferas, e entupireis tôdas as fontes de água, e cobrireis de pedras todos os campos mais"},{text:"férteis."},{text:"20 Sucedeu pois pela manhã, quando se costuma oferecer o sacrifício, e eis que desceram as águas pelo caminho de Edom, e a terra se encheu de água."},{text:"21 Todos os moabitas porém sabendo que eram vindos os reis para pelejarem contra êles, ajuntaram todos os que pegavam em armas, e os esperaram nas fronteiras."},{text:"22 E levantando-se ao romper da manhã, e raiando já o sol sôbre as águas, viram os moabitas defronte de si as águas vermelhas como sangue,"},{text:"23 e disseram: É sangue derramado pela espada: Os reis pelejaram contra si, e de parte a parte se mataram: Marcha agora, ó Moab, à prêsa."},{text:"24 E vieram ao campo de Israel: Mas os israelitas levantando-se atacaram os moabitas: Êstes fugiram à sua vista. Os vencedores vieram em seu alcance, e mataram os moabitas,"},{text:"25 e destruíram as cidades: E encheram todos os campos os mais férteis de pedras, que cada um lançou: E entupiram tôdas as fontes de água: Deitaram abaixo tôdas as árvores frutíferas de modo que ficaram só em pé os muros"},{text:"feitos de barro: E a cidade foi cercada pelos que atiravam com funda, e em uma grande parte ficou demolida."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Reis Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 Vendo o rei de Moab que os inimigos prevaleciam, tomou consigo setecentos homens de guerra, que investissem o rei de Edom: Mas êles não puderam."},{text:"27 E pegando em seu filho primogênito, que havia de reinar depois dêle, o ofereceu em holocausto sôbre o muro, e os israelitas se indignaram em extremo, e logo se retiraram dêle, e voltaram para o seu país."},{text:"2 Reis — capítulo 4."},{text:"1 Mas uma mulher que o era de um dos profetas gritou a Eliseu, dizendo: Teu servo meu marido morreu, e tu sabes que teu servo era temente ao Senhor: E agora eis vem o credor levar-me os meus dois filhos para serem seus"},{text:"escravos."},{text:"2 Eliseu lhe disse: Que queres que eu te faça? Dize-me, que tens em tua casa? E ela respondeu: Eu tua serva não tenho em minha casa outra coisa senão um pouco de azeite, para me ungir."},{text:"3 tools — see the cookie policy for details"},{text:"4 E entra, e fecha a tua porta, depois que estiveres de dentro tu, e teus filhos: E deita do azeite em tôdas estas vasilhas: E estando cheias, tirá-las-ás."},{text:"5 Foi pois a mulher, e fechou a porta sôbre si, e sôbre seus filhos: Os filhos lhe chegavam as vasilhas, e ela as enchia."},{text:"6 Cheias que foram as vasilhas, disse ela a um de seus filhos: Chega-me cá ainda alguma outra vasilha. E êle lhe respondeu: Não a tenho. E o azeite parou."},{text:"7 Veio pois ela, e o declarou ao homem de Deus. E êle disse: Vai, vende o azeite, e paga ao teu credor: E tu, e teus filhos vivei do resto."},{text:"8 Aconteceu também que Eliseu um dia passava por Sunam: E havia ali uma mulher grave, a qual teve mão nêle para comer o pão: E como êle passava freqüentemente por ali, ia pousar em sua casa para tomar a sua refeição."},{text:"9 A qual disse a seu marido: Tenho observado que êste homem, que passa tantas vêzes por nossa casa, é um homem de Deus, e um santo."},{text:"10 Façamos-lhe pois um pequeno quarto, e ponhamos nêle uma cama, e uma mesa, e uma cadeira, e um candeeiro, para que quando vier a nossa casa, se acomode ali."},{text:"11 Aconteceu pois que um dia veio, e se alojou no quarto, e descansou nêle."},{text:"12 E disse a Giezi, seu criado: Chama esta sunamita. E tendo-a êle chamado, e estando ela em pé diante dêle,"},{text:"13 disse ao seu criado: Dize-lhe: Tu nos tens tratado com todo o desvêlo, que queres que eu te faça? Acaso tens algum negócio, e queres que fale ao rei, ou ao general dos seus exércitos? Ela respondeu: Eu vivo no meio do"},{text:"meu povo."},{text:"14 E disse: Que quer pois que eu lhe faça? E Giezi respondeu: É escusado perguntar-lho: Porque ela não tem filhos, e seu marido é já velho."},{text:"15 Mandou-lhe pois que a chamasse: E chamada que ela foi, e tendo-se pôsto diante da porta,"},{text:"16 Eliseu lhe disse: Neste tempo e nesta mesma hora, se Deus te conservar com vida, terás um filho no teu ventre. E ela respondeu: Não meu senhor, homem de Deus, não enganes, te peço, a tua escrava."},{text:"17 E a mulher concebeu, e pariu um filho no mesmo tempo, e à mesma hora, que Eliseu lhe dissera."},{text:"18 E o menino cresceu. E tendo ido um dia buscar a seu pai, que estava com os ceifeiros,"},{text:"19 disse a seu pai: Dói-me a cabeça, dói-me a cabeça. E êle disse a um servo: Toma êste menino e leva-o a sua mãe."},{text:"20 E tendo o servo pegado nêle, e levado a sua mãe, ela o pôs sôbre os seus joelhos, até o meio-dia, e morreu."},{text:"21 Mas a mãe subiu, e pôs o menino em cima da cama do homem de Deus, e fechou a porta: E saindo,"},{text:"22 chamou a seu marido, e lhe disse: Manda comigo, te peço, um dos teus servos, e uma jumenta, para eu ir à pressa até o homem de Deus, e voltarei."},{text:"23 O marido lhe disse: Por que vais ter com êle? Hoje não são Calendas, nem Sábado. Ela respondeu: Eu irei."},{text:"24 E fêz aparelhar a jumenta, e disse ao servo: Guia-me, e apressa-te, não me demores no caminho: E faze o que te ordeno."},{text:"25 Partiu pois, e foi ter com o homem de Deus ao monte Carmelo: E o homem de Deus tendo-a visto vir para êle, disse para o seu criado Giezi: Eis-aí vem aquela sunamita."},{text:"26 Vai pois a recebê-la, e dize-lhe: Vai-te bem a ti, e a teu marido e a teu filho? Respondeu-lhe ela: Muito bem."},{text:"27 E tendo vindo ter com o homem de Deus ao monte, se deitou a seu pés: E Giezi se chegou para a retirar. Mas o homem de Deus lhe disse: Deixa-a: Porque a sua alma está em amargura, e o Senhor mo encobriu, e não mo"},{text:"manifestou."},{text:"28 Ela lhe disse: Acaso pedi-te eu algum filho, meu senhor? Não te disse eu: Não me enganes?"},{text:"29 E Eliseu disse a Giezi: Cinge os teus rins, e toma o meu bordão na mão, e parte. Se encontrares alguém não o saúdes: E se alguém te saudar, não lhe respondas: E porás o meu bordão sôbre o rosto do menino."},{text:"30 Porém a mãe do menino disse: Viva o Senhor, e viva a tua alma, que eu não te largarei. Partiu êle pois e a seguiu."},{text:"31 Giezi porém tinha ido adiante dêles, e tinha pôsto o bordão de Eliseu sôbre o rosto do menino, mas êle não tinha nem fala, nem sentidos: E voltou a encontrar-se com êle, e lho noticiou, dizendo: O menino não"},{text:"ressuscitou."},{text:"32 Entrou pois Eliseu na casa, e o menino estava morto em cima da sua cama:"},{text:"33 E tendo entrado cerrou a porta sôbre si, e sôbre o menino: E fêz oração ao Senhor."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Reis Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"34 E subiu à cama, e deitou-se sôbre o menino: E pôs a sua bôca sôbre a bôca dêle, e os seus olhos sôbre os olhos dêle, e as suas mãos sôbre as mãos dêle: E encurvou-se sôbre êle, e cobrou calor a carne do menino."},{text:"35 E êle descendo deu duas voltas pela casa: E subiu e estendeu-se sôbre êle: E o menino bocejou sete vêzes, e abriu os olhos."},{text:"36 Então êle chamou a Giezi, e lhe disse: Chama essa sunamita: A qual sendo chamada entrou no quarto onde êle estava. E Eliseu lhe disse: Toma o teu filho."},{text:"37 Chegou-se ela, lançou-se a seus pés, e o adorou prostrada em terra: E tomou seu filho, e saiu,"},{text:"38 e Eliseu voltou para Galgala. E neste país havia fome, e os filhos dos profetas habitavam com êle: E disse a um dos seus criados: Pega numa panela grande, e faze de comer para os filhos dos profetas."},{text:"39 E saiu um ao campo para apanhar umas ervas bravas: E achou uma como parra silvestre, e colheu dela as coloquíntidas do campo, e encheu a sua capa, e tendo voltado, as cortou em pedaços dentro da panela das papas mas"},{text:"não conhecia o que era."},{text:"40 Deram pois delas aos companheiros para comerem: E tendo provado do guisado, gritaram, dizendo: Homem de Deus, a panela tem coisa mortífera. E não puderam comer."},{text:"41 Mas êle lhes disse: Trazei-me farinha. E tendo-lha trazido, a lançou na panela, e disse: Deita à gente, para que coma. E não houve mais amargor algum na panela."},{text:"42 Veio também um homem de Baalsalisa que trazia ao homem de Deus uns pães das primícias, vinte pães de cevada, e trigo novo no seu alforje. E Eliseu disse: Dá ao povo para que coma."},{text:"43 E o seu criado lhe respondeu: Que é isto, para eu o pôr diante a cem pessoas? Êle disse outra vez: Dá ao povo para que coma: Porque eis-aqui o que diz o Senhor: Comerão e sobejará."},{text:"44 Pôs-lhos pois diante: Comeram, e ainda sobrou, conforme a palavra do Senhor."},{text:"2 Reis — capítulo 5."},{text:"1 Naaman, general do exército do rei da Síria, era um homem poderoso, e de grande privança junto a seu amo: Porque por êle salvou o Senhor a Síria: E era um homem valente e rico, mas leproso."},{text:"2 Ora uns ladrões haviam saído da Síria, e tinham levado cativa do país de Israel uma rapariga pequena, que estava ao serviço da mulher de Naaman,"},{text:"3 tools — see the cookie policy for details"},{text:"4 Sôbre isto foi Naaman ter com seu amo, e declarou-lhe, dizendo: Uma rapariga do país de Israel disse isto e isto."},{text:"5 E o rei da Síria lhe respondeu: Vai, eu enviarei uma carta ao rei de Israel. Partindo pois Naaman, e levando consigo dez talentos de prata, e seis mil escudos de ouro, e dez vestidos para mudar,"},{text:"6 levou ao rei de Israel a carta concebida nestes têrmos: Quando tu tiveres recebido esta carta, saberás que eu te enviei Naaman meu servo, para o curares da sua lepra."},{text:"7 E tendo o rei de Israel lido a carta, rasgou os seus vestidos, e disse: Acaso sou eu Deus, para poder tirar, e dar vida, como assim êste me enviou um homem, para eu o curar da sua lepra? Adverti, e vêde que anda"},{text:"buscando ocasião de romper comigo."},{text:"8 O que tendo ouvido Eliseu, homem de Deus, a saber, que o rei de Israel rasgara os seus vestidos, mandou-lhe dizer: Por que rasgaste os teus vestidos? Venha ter comigo, e saiba que há um profeta em Israel."},{text:"9 Veio pois Naaman com os seus cavalos, e carroças, e parou à porta da casa de Eliseu,"},{text:"10 e Eliseu lhe enviou um mensageiro, dizendo: Vai, lava-te sete vêzes no Jordão, e a tua carne será curada, e ficarás limpo."},{text:"11 Naaman agastado se retirava, dizendo: Eu cuidava que êle sairia a buscar-me, e que pôsto em pé invocaria o nome do Senhor seu Deus, e que me tocaria com a sua mão o lugar da lepra, e que me curaria."},{text:"12 Acaso Abana, e Farfar, rios de Damasco, não são melhores do que tôdas as águas de Israel, para eu me lavar nelas e ficar limpo? Como êle pois voltasse, e se retirasse enfadado."},{text:"13 chegaram-se a êle os seus servos, e lhe disseram: Pai, ainda quando o profeta te houvesse ordenado uma coisa muito difícil, deveras tu sem dúvida fazê-la: Quanto mais agora que êle te disse: Lava-te e ficarás limpo."},{text:"14 Foi êle pois, e lavou-se sete vêzes no Jordão conforme a palavra do homem de Deus, e a sua carne se tornou, bem como a carne dum menino muito tenro, e ficou limpo."},{text:"15 E voltando para o homem de Deus com tôda a sua comitiva, veio, e se apresentou diante dêle: E disse: Eu sei certamente que não há outro Deus em tôda a terra, senão o que há em Israel. Rogo-te pois que recebas de teu"},{text:"servo alguma oferta."},{text:"16 Mas êle respondeu: Viva o Senhor, em cuja presença estou, que eu a não receberei. E por mais que instasse, absolutamente lhe não condescendeu."},{text:"17 E disse Naaman: Seja como tu queres: Mas peço-te que me permitas levar dois machos carregados da terra dêste país: Porque o teu servo não sacrificará mais holocaustos, ou vítimas aos deuses estrangeiros, senão ao Deus"},{text:"de Israel."},{text:"18 Esta só coisa porém há pela qual rogues ao Senhor pelo teu servo, quando meu amo entrar no templo de Remon, para adorar: E segurando-se êle no meu braço, se eu adorar no templo de Remon, adorando no mesmo lugar, que o"},{text:"Senhor me perdoe a mim teu servo por esta causa."},{text:"19 Eliseu lhe respondeu: Vai-te em paz. Retirou-se pois êle no melhor tempo do ano."},{text:"20 E Giezi criado do homem de Deus disse: Meu amo perdoou a êste Naaman siro, não querendo receber nada do que êle lhe trouxera: Viva o Senhor, que eu correrei atrás dêle, e receberei dêle alguma coisa."},{text:"21 E Giezi foi em alcance de Naaman: O qual, vendo-o vir correndo para êle, saltou do coche a recebê-lo, e disse: Está tudo bom?"},{text:"22 E êle respondeu: Muito bom: Meu amo me enviou a dizer-te: A esta hora chegaram do monte de Efraim dois moços dos filhos dos profetas: Dá-lhes um talento de prata, e dois vestidos para mudarem."},{text:"23 E disse Naaman: Melhor é que aceites dois talentos. E obrigou-o a isso, e atou os dois talentos de prata, e os dois vestidos em dois sacos, e carregou com êles dois dos seus servos, que os levaram diante de Giezi."}]}] 1
