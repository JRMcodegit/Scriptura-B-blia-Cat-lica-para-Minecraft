give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 64",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 Mas para mim têm sido singularmente honrados os teus amigos, ó Deus: Muito se tem fortificado o principado dêles."},{text:"18 Contá-los-ei, e mais que a areia se multiplicarão: Despertei, e ainda estou contigo."},{text:"19 Se matares, ó Deus, os pecadores: Homens sangüinários, retirai-vos de mim:"},{text:"20 Porque dizeis no vosso pensamento: Tomarão em vão as tuas cidades."},{text:"21 Porventura não aborrecia eu, Senhor, aos que te aborreceram: E não me consumia por causa dos teus inimigos?"},{text:"22 Com ódio consumado eu os aborrecia: E êles se tornaram meus inimigos."},{text:"23 Prova-me, ó Deus, e sonda o meu coração: Pergunta-me, e conhece as minhas veredas."},{text:"24 E vê, se há em mim caminho de iniqüidade: E conduze-me pelo caminho da eternidade."},{text:"Salmos — capítulo 139."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 Livra-me, Senhor, do homem malvado: Livra-me do homem perverso."},{text:"3 tools — see the cookie policy for details"},{text:"4 Aguçaram as suas línguas como a de serpente: Veneno de áspides têm debaixo de seus lábios."},{text:"5 Guarda-me, Senhor, da mão do pecador: E livra-me de homens iníquos. Os que cogitaram derribar os meus passos:"},{text:"6 Êles soberbos me esconderam o laço: E estenderam cordas para me surpreender: Junto do meu caminho me puseram tropeço."},{text:"7 Eu disse ao Senhor: Tu és o meu Deus: Atende, Senhor, a voz da minha deprecação."},{text:"8 Senhor, Senhor, que és a fortaleza da minha salvação: Tu puseste reparo sôbre a minha cabeça no dia da batalha:"},{text:"9 Não me entregues, Senhor, contra o meu desejo ao pecador, êles maquinaram contra mim, não me desampares, para que não suceda ficarem exaltados:"},{text:"10 A cabeça daqueles que me cercam: O trabalho dos seus lábios os envolverá."},{text:"11 Cairão sôbre êles carvões, ao fogo os arrojarás: Entre as misérias não subsistirão."},{text:"12 O varão maldizente não prosperará na terra: Do varão injusto se apoderarão os males da morte."},{text:"13 Sei que o Senhor fará o juízo do desvalido: E que vingará aos pobres."},{text:"14 Mas contudo os justos darão glória ao teu Nome: E os retos habitarão em a tua presença."},{text:"Salmos — capítulo 140."},{text:"1 Salmo de Davi. Senhor, a ti clamei, escuta-me: Atende à minha voz, quando clamar a ti."},{text:"2 Suba direita a minha oração como incenso na tua presença: Seja a elevação das minhas mãos sacrifício da tarde."},{text:"3 tools — see the cookie policy for details"},{text:"4 Não torças o meu coração a palavras de malícia para buscar escusas nos pecados. Como fazem os homens que obram iniqüidade: E não terei parte nas coisas que êles estimam."},{text:"5 O justo me corrigirá, e me increpará com misericórdia: Mas o azeite do pecador não chegue a ungir a minha cabeça. Porque ainda até a minha oração será contra o que lhes apraz a êles:"},{text:"6 Têm perecido os seus juízes lançados à pedra. Ouvirão que as minhas palavras foram eficazes:"},{text:"7 Bem como grossa gleba se desfez sempre sôbre a terra. Assim têm sido espalhados os nossos ossos perto da sepultura:"},{text:"8 Porque os meus olhos a ti, Senhor, ó Senhor, se levantaram: Em ti tenho esperado, não me tires a vida."},{text:"9 Guarda-me do laço, que têm preparado contra mim: E dos precipícios dos que obram iniqüidade."},{text:"10 Cairão na sua rêde os pecadores: Só estou eu até que seja o meu trânsito."},{text:"Salmos — capítulo 141."},{text:"1 Inteligência de Davi, quando estava na cova, oração."},{text:"2 Com a minha voz clamei ao Senhor: Com a minha voz fiz deprecação ao Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Enquanto me vai desfalecendo o meu espírito, e tu conheceste as minhas veredas. Neste caminho, por onde eu andava, esconderam-me o laço."},{text:"5 Considerava para a minha direita, e olhava: E não havia quem me conhecesse. Não me ficou lugar de fugida e não há quem se lhe dê da minha alma."}]}] 1
