give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Embriagar-se-ão da abundância da tua casa: E os farás beber na torrente das tuas delícias."},{text:"10 Porque em ti está a fonte da vida: E no teu lume veremos o lume."},{text:"11 Estende antes a tua misericórdia sôbre os que te conhecem, e a tua justiça sôbre aquêles que têm o coração reto."},{text:"12 Não venha sôbre mim pé de soberba: E mão de pecador não me comova."},{text:"13 Ali caíram os que obram a iniqüidade: Foram empurrados, e não se puderam levantar."},{text:"Salmos — capítulo 36."},{text:"1 Salmo do mesmo Davi. Não queiras imitar aos malignos: Nem invejes aos que obram iniqüidade."},{text:"2 Porque êles como feno se secarão velozmente: E como verduras de ervas logo se murcharão."},{text:"3 tools — see the cookie policy for details"},{text:"4 Deleita-te no Senhor: E te outorgará as petições do teu coração."},{text:"5 Descobre ao Senhor o teu caminho, e espera nêle; e êle fará."},{text:"6 E fará brilhar como lume a tua justiça: e o teu juízo como o meio-dia:"},{text:"7 Está obediente ao Senhor, e roga-lhe. Não queiras invejar ao que tem prosperidade no seu caminho: Ao homem que faz injustiça."},{text:"8 Guarda-te da ira, e deixa o furor: Não te mova a emulação para te fazeres mau."},{text:"9 Porque os que fazem maldade, serão exterminados: Mas os que esperam o Senhor, êles herdarão a terra."},{text:"10 E ainda um pouco, e não existirá o pecador: E buscarás o lugar dêle e não o acharás."},{text:"11 Mas os mansos herdarão a terra, e deleitar-se-ão em abundância de paz."},{text:"12 O pecador espreitará ao justo: E rangerá com os dentes contra êle."},{text:"13 Mas o Senhor zombará dêle: Porque vê que há de chegar o seu dia."},{text:"14 Os pecadores desembainharam a espada: Estenderam o seu arco. Para arruinarem o pobre e o indigente: Para assassinarem os retos do coração."},{text:"15 A espada dêles traspasse o seu coração: E o arco dêles seja quebrado."},{text:"16 Mais vale o pouco a um justo, que as muitas riquezas aos pecadores."},{text:"17 Porque os braços dos pecadores serão quebrados: Aos justos porém fortalece-os o Senhor."},{text:"18 O Senhor conhece os dias dos que são imaculados: A herança dêles será eterna."},{text:"19 Êles não serão confundidos no tempo mau, e serão fartos nos dias da fome:"},{text:"20 Porque os pecadores perecerão. Mas os inimigos do Senhor tanto que tiverem sido honrados e exaltados, faltarão, e se desvanecerão como o fumo."},{text:"21 O pecador pedirá emprestado, e não pagará: O justo porém tem compaixão e dará."},{text:"22 Porque os que o bendizem herdarão a terra: mas os que o maldizem perecerão."},{text:"23 Os passos do homem serão dirigidos pelo Senhor: E o seu caminho será aprovado por êle."},{text:"24 Quando cair, não se ferirá: Porque o Senhor lhe põe a mão por baixo."},{text:"25 Mancebo fui, e já sou velho: E não vi o justo desamparado, nem a sua descendência mendigando pão."},{text:"26 Todo o dia exercita a misericórdia, e dá emprestado: E a sua descendência será abençoada."},{text:"27 Desvia-te do mal, e faze o bem: E terás uma morada eterna."},{text:"28 Porque o Senhor ama a eqüidade, e não desamparará os seus santos: Serão eternamente conservados. Os injustos serão punidos: E a descendência dos ímpios perecerá."},{text:"29 Mas os justos herdarão a terra: E morarão sôbre ela por todos os séculos."},{text:"30 A bôca do justo meditará sabedoria, e a sua língua falará prudência."},{text:"31 A lei do seu Deus está no seu coração: E não se armará ardil enganoso aos seus passos."},{text:"32 Espreita o pecador ao justo: E procura como há de dar-lhe a morte."},{text:"33 Mas o Senhor não o deixará nas suas mãos: Nem o condenará quando fôr dêle julgado."},{text:"34 Espera no Senhor, e guarda o seu caminho: E te exaltará para que tomes em herança a terra: Quando perecerem os pecadores então verás."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"35 Vi ao ímpio sumamente exaltado, e elevado como os cedros do Líbano."},{text:"36 E passei, e eis-que não era: E o busquei, e não foi achado o lugar dêle."},{text:"37 Guarda a inocência, e atende à eqüidade: Porque há resíduos para o homem pacífico."},{text:"38 Mas os injustos perecerão igualmente: As relíquias dos ímpios serão destruídas."},{text:"39 Mas a salvação dos justos vem do Senhor: E êle é o seu protetor no tempo da aflição."},{text:"40 E o Senhor os ajudará, e os livrará: E os tirará da mão dos pecadores, e os salvará: Porque esperaram nêle."},{text:"Salmos — capítulo 37."},{text:"1 Salmo de Davi, em memória do sábado."},{text:"2 Senhor, não me repreendas no teu furor, nem me castigues na tua ira."},{text:"3 tools — see the cookie policy for details"},{text:"4 Não há parte sã na minha carne na face da tua ira: Não há paz nos meus ossos à vista dos meus pecados."},{text:"5 Porque as minhas iniqüidades se elevaram por cima da minha cabeça: E como carga pesada se agravaram sôbre mim."},{text:"6 Apodreceram e corromperam-se as minhas cicatrizes, à vista da minha estultícia."},{text:"7 Eu me tornei miserável, e todo encurvado: Todo o dia andava oprimido de tristeza."},{text:"8 Porque os meus lombos estão cheios de ilusões: E não há parte alguma sã na minha carne."},{text:"9 Estou aflito, e grandemente abatido: Rugia pela fôrça do gemido do meu coração."},{text:"10 Senhor, diante de ti está todo o meu desejo: E o meu gemido te não é oculto."},{text:"11 O meu coração está conturbado, a minha fôrça me desamparou: E ainda o mesmo lume dos meus olhos não está já comigo."},{text:"12 Os meus amigos, e os meus propínquos se chegaram, e se puseram contra mim. E os que estavam perto de mim, se puseram de longe:"},{text:"13 E faziam seus esforços os que buscavam a minha alma. E os que me procuravam males, falaram coisas vãs: E todo o dia maquinavam enganos."},{text:"14 Mas eu como um surdo não ouvia: E como um mudo que não abre a sua bôca."},{text:"15 E tornei-me como homem que não ouve; e que não tem na sua bôca palavras com que se defenda."},{text:"16 Porque em ti, Senhor, esperei: Tu me ouvirás, Senhor Deus meu."},{text:"17 Porque disse: Nunca triunfem de mim meus inimigos: E enquanto meus pés estão vacilantes, falaram com orgulho contra mim."},{text:"18 Porque aparelhado estou para os açoites: E a minha dor está sempre diante de mim."},{text:"19 Porque eu publicarei a minha iniqüidade: E meditarei sôbre o meu pecado."},{text:"20 Mas os meus inimigos vivem, e se têm fortificado sôbre mim: E se têm multiplicado os que me aborrecem injustamente."},{text:"21 Os que tornam males por bens, murmuravam de mim, porque eu seguia o que era bom."},{text:"22 Não me desampares, Senhor Deus meu: Não te apartes de mim."},{text:"23 Acode prontamente em meu socorro, Senhor Deus da minha salvação."},{text:"Salmos — capítulo 38."},{text:"1 Para o fim, ao mesmo Iditun, Cântico de Davi."},{text:"2 Disse: Guardarei os meus caminhos: Para não delinqüir com a minha língua. Pus guarda à minha bôca, quando o pecador estava em frente contra mim."},{text:"3 tools — see the cookie policy for details"},{text:"4 O meu coração se escandeceu dentro de mim: E na minha meditação se incenderá fogo."},{text:"5 Falei com a minha língua: Faze-me conhecer, Senhor, o meu fim. E o número dos meus dias qual é: Para que eu saiba o que me resta."},{text:"6 Eis-aqui puseste os meus dias em medida: E a minha subsistência é como nada diante de ti. Todavia é pura vaidade todo o homem que vive."},{text:"7 Pois certamente o homem passa como em sombra: E assim em vão se conturba. Entesoura, e não sabe para quem ajunta aquelas coisas."},{text:"8 E agora qual é a minha esperança? porventura não é o Senhor? pois em ti está a minha subsistência."},{text:"9 Livra-me de tôdas as minhas iniqüidades: Tu me fizeste um objeto de opróbrio para o insensato."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 Emudeci, e não abri a minha bôca, porque tu o fizeste:"},{text:"11 Aparta de mim os teus flagelos."},{text:"12 Debaixo da fôrça da tua mão eu desfaleci quando me repreendeste: Tu por causa da iniqüidade castigaste ao homem. E fizeste que a sua alma se consumisse como aranha: Certamente em vão se conturba todo o homem."},{text:"13 Ouve, Senhor, a minha oração e a minha súplica: Recebe em teus ouvidos as minhas lágrimas. Não te cales: Porque adventício sou diante de ti, e peregrino como todos os meus pais."},{text:"14 Deixa que tome algum alento, antes que me vá, e não exista mais."},{text:"Salmos — capítulo 39."},{text:"1 Para o fim, Salmo do mesmo Davi."},{text:"2 Aguardei com expectação ao Senhor, e me atendeu."},{text:"3 tools — see the cookie policy for details"},{text:"4 E pôs um novo cântico na minha bôca, canção ao nosso Deus. Muitos o verão e temerão: E esperarão no Senhor."},{text:"5 Bem-aventurado o varão cuja esperança é o nome do Senhor: E não voltou os olhos para as vaidades e necedades enganosas."},{text:"6 Senhor Deus meu, tu tens feito muitas obras maravilhosas: E não há quem te seja semelhante nos teus conselhos. Eu os anunciei e falei: Tem-se multiplicado inumeràvelmente."},{text:"7 Sacrifício e oferenda não quiseste: deste-me ouvidos perfeitos. Holocausto pelo pecado não pediste:"},{text:"8 Então disse: Eis-aqui venho. Na cabeceira do livro está escrito de mim:"},{text:"9 Para fazer a tua vontade: Deus meu, eu o quis, e no íntimo do meu coração desejei se cumprisse tua lei."},{text:"10 Anunciei a tua justiça na Igreja grande, eis-aqui não demorarei os meus lábios: Senhor, tu o sabes."},{text:"11 Não escondi a tua justiça no meu coração: Mostrei a tua verdade e o teu Salvador. Não escondi a tua misericórdia, e a tua verdade a uma congregação numerosa."},{text:"12 Mas tu, Senhor, não alongues de mim as tuas misericórdias: A tua misericórdia e a tua verdade sempre me ampararam."},{text:"13 Porquanto me cercaram males, que não têm número: Senhorearam-me as minhas iniqüidades, e eu não pude vê-las. Multiplicaram-se mais do que os cabelos da minha cabeça: E o meu coração me desamparou."},{text:"14 Seja do teu agrado, Senhor, o livrares-me: Senhor, volta os olhos para me socorreres."},{text:"15 Sejam confundidos e envergonhados a um tempo aquêles que buscam a minha vida, para tirar-ma. Voltem atrás, e fiquem confundidos os que me desejam males."},{text:"16 Sofram incontinenti a sua confusão, os que me dizem: Bem, bem."},{text:"17 Regozijem-se e alegrem-se sôbre ti todos os que te buscam: Os que amam teu Salvador, digam sempre: Engrandecido seja o Senhor."},{text:"18 Mas eu sou mendigo, e pobre: O Senhor está cuidadoso de mim. Favorecedor meu, e protetor meu és tu: Deus meu, não tardes."},{text:"Salmos — capítulo 40."},{text:"1 Para o fim, Salmo do mesmo Davi."},{text:"2 Bem-aventurado o que cuida sôbre o necessitado, e o pobre: O Senhor o livrará no dia mau."},{text:"3 tools — see the cookie policy for details"},{text:"4 O Senhor lhe dê auxílio sôbre o leito da sua dor: Tôda a sua cama revolveste na sua enfermidade."},{text:"5 Eu disse: Senhor, compadece-te de mim: Sara a minha alma, porque pequei contra ti."},{text:"6 Os meus inimigos falaram contra mim dizendo: Quando morrerá, e perecerá o seu nome?"},{text:"7 E se algum entrava a ver-me, falava coisas vãs: O seu coração recolheu em si iniqüidade. Êle saía fora, e falava sôbre isso mesmo."},{text:"8 Contra mim murmuravam todos os meus inimigos: Contra mim urdiam males."},{text:"9 Palavra injusta decretaram contra mim: Porventura o que dorme não se poderá outra vez levantar?"},{text:"10 Ainda o homem da minha paz, em quem eu confiei: O que comia o meu pão, engrandeceu sôbre mim a sua traição."},{text:"11 Tu pois, Senhor, tem compaixão de mim, e ressuscita-me: E eu lhes retribuirei."},{text:"12 Nisto conheci eu que tu me querias bem: Em que o meu inimigo se não alegrará sôbre mim."},{text:"13 Porque tu me tomaste na tua proteção por causa da minha inocência: E tu me fortificaste diante de ti para sempre."},{text:"14 O Senhor Deus de Israel seja bendito por todos os séculos: Assim seja, assim seja."},{text:"Salmos — capítulo 41."}]}] 1
