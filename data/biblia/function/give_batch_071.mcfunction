give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"24 E levantando-se dali, foi Jesus para os confins de Tiro e de Sidônia: E tendo entrado numa casa, quis que ninguém o soubesse mas não pôde ocultar-se."},{text:"25 Porque uma mulher, cuja filha estava possessa do espírito imundo, tanto que ouviu que êle lá estava, entrou, e lançou-se-lhe aos pés."},{text:"26 Era pois uma mulher gentia, de nação siro-fenícia, e rogava-lhe que expelisse de sua filha o demônio."},{text:"27 Disse-lhe Jesus: Deixa que primeiro sejam fartos os filhos, porque não é bom tomar o pão dos filhos, e lançá-lo aos cães."},{text:"28 Mas ela respondeu, e disse-lhe: Assim é, Senhor, mas também os cachorrinhos comem debaixo da mesa, das migalhas que caem dos meninos."},{text:"29 Então lhe disse Jesus: Por esta palavra que disseste, vai, que já o demônio saiu de tua filha."},{text:"30 E tendo vindo para sua casa, achou que a menina estava deitada sôbre a cama, e que o demônio a deixara."},{text:"31 E Jesus, tornando a sair do têrmo de Tiro, veio por Sidônia ao mar de Galiléia, passando pelo meio do território de Decápolis."},{text:"32 E lhe trouxeram um surdo e mudo, e lhe rogavam que pusesse a mão sôbre êle."},{text:"33 Então Jesus, tirando-o de entre o povo e tomando-o de parte, meteu-lhe os seus dedos nos ouvidos: E cuspindo, pôs-lhe da sua saliva sôbre a língua:"},{text:"34 E levantando os olhos ao Céu, deu um suspiro, e disse-lhe: Ephphetha, que quer dizer, abre-te."},{text:"35 E no mesmo instante se lhe abriram os ouvidos, e se lhe soltou a prisão da língua, de sorte que entrou a falar expeditamente."},{text:"36 E mandou-lhes que a ninguém o dissessem. Porém quanto mais Jesus lho defendia, tanto mais êles o publicavam."},{text:"37 E tanto mais se admiravam, dizendo: Êle tudo tem feito bem: Fêz não só que ouvissem os surdos, mas que falassem os mudos."},{text:"Marcos — capítulo 8."},{text:"1 Naqueles dias, como o povo houvesse concorrido outra vez em grande número, e não tivessem que comer, tendo chamado Jesus aos seus discípulos, lhes disse:"},{text:"2 Tenho compaixão dêste povo, porque, olhai, há já três dias que andam aturadamente comigo, e não têm que comer:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E seus discípulos lhe responderam: De donde poderá alguém fartá-los de pão aqui nesta solidão?"},{text:"5 E Jesus lhes perguntou: Quantos pães tendes vós? Responderam êles: Sete."},{text:"6 E mandou à gente que se recostasse sôbre a terra. E tomando os sete pães, dando graças, os partiu, e deu a seus discípulos, para que os distribuissem, e êles os distribuiram pelo povo."},{text:"7 Tinham também uns poucos de peixinhos, e êle os abençoou, e mandou que lhos pusessem:"},{text:"8 Comeram pois, e ficaram fartos, e dos pedaços que tinham sobejado, levantaram sete cêstos."},{text:"9 Eram porém os que comeram perto de quatro mil, e Jesus os despediu."},{text:"10 E entrando logo na barca em companhia de seus discípulos, passou ao território de Dalmanuta."},{text:"11 E saíram os fariseus, e se puseram a disputar com êle, pedindo-lhe que lhes fizesse ver algum prodígio do Céu, tudo para o tentarem."},{text:"12 Porém Jesus arrancando do íntimo do coração um suspiro, disse: Por que pede esta geração um prodígio? Em verdade vos digo, que a esta geração se não concederá prodígio."},{text:"13 E deixando-os, tornou outra vez a embarcar, e passou à outra banda."},{text:"14 Ora, os discípulos esqueceram-se de tomar pão, e não tinham consigo na barca senão um único."},{text:"15 E pôs-lhes Jesus um preceito, em que dizia: Vêde bem, e acautelai-vos do fermento dos fariseus, e do fermento de Herodes."},{text:"16 E discorriam entre si, dizendo: É porque não temos pão."},{text:"17 O que conhecendo Jesus, disse-lhes: Que estais vós considerando que não tendes pão? é possível que ainda não no conheçais nem compreendais? ainda tendes cego o vosso coração?"},{text:"18 Tendo olhos não vêdes? e tendo ouvidos não ouvis? e não vos lembrais,"},{text:"19 quando parti cinco pães para cinco mil, quantos cêstos levantastes cheios de pedaços? Responderam êles: Doze."},{text:"20 E quando eu parti sete pães para quatro mil, quantos cêstos levantastes de pedaços? E êles lhe responderam: Sete."},{text:"21 E Jesus lhes dizia: Pois como não entendeis ainda?"},{text:"22 E vieram a Betsaida, e lhe trouxeram um cego, e lhe rogavam que o tocasse."},{text:"23 E tomando ao cego pela mão, o tirou para fora da aldeia, e cuspindo-lhe nos olhos, tendo-lhe imposto as suas mãos, lhe perguntou se via alguma coisa."},{text:"24 E levantando êle os olhos, disse: Vejo os homens como árvores que andam."},{text:"25 Depois tornou-lhe Jesus a pôr as mãos sôbre os olhos, e começou êle a ver, e ficou de todo curado, de sorte que via distintamente todos os objetos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 E Jesus o despediu para sua casa, dizendo-lhe: Vai para tua casa: E se entrares na aldeia não o digas a pessoa alguma."},{text:"27 E saiu Jesus com os seus discípulos pelas aldeias de Cesaréia de Filipe: E perguntava pelo caminho a seus discípulos, dizendo-lhes: Quem dizem os homens que sou eu?"},{text:"28 Êles lhe responderam, dizendo: Uns dizem que João Batista, outros que Elias, e outros como um dos profetas."},{text:"29 Então lhes disse Jesus: E vós outros quem dizeis que sou eu? Respondendo Pedro, lhe disse: Tu és o Cristo."},{text:"30 E Jesus lhes proibiu com ameaças, que a ninguém dissessem isto dêle."},{text:"31 E começou a declarar-lhes que importava que o Filho do homem padecesse muito, e que fôsse rejeitado pelos anciãos, e pelos príncipes dos sacerdotes, e pelos escribas, e que fôsse entregue à morte: E que ressuscitasse"},{text:"depois de três dias."},{text:"32 E tudo isto lhes declarava êle abertamente. Sôbre o que Pedro, tomando-o de parte, começou a repreendê-lo."},{text:"33 Mas Jesus, virando-se, e olhando para seus discípulos, ameaçou a Pedro, dizendo: Tira-te de diante de mim, satanás, que não tens gôsto das coisas de Deus, mas sim das dos homens."},{text:"34 E chamando assim o povo com seus discípulos, disse-lhes: Se alguém me quer seguir, negue-se a si mesmo: E tome a sua cruz, e siga-me."},{text:"35 Porque o que quiser salvar a sua vida, perdê-la-á: Mas o que perder a sua vida por amor de mim, e do Evangelho, salvá-la-á."},{text:"36 Pois de que aproveitará ao homem, se ganhar o mundo inteiro e perder a sua alma?"},{text:"37 Ou que dará o homem em trôco pela sua alma?"},{text:"38 Porque se nesta geração adúltera, e pecadora, se envergonhar alguém de mim, e das minhas palavras: Também o Filho do homem se envergonhará dêle, quando vier na glória de seu Pai acompanhado dos santos anjos."},{text:"39 Dizia-lhes mais: Em verdade vos afirmo que dos que aqui se acham, alguns há que não hão de gostar a morte, enquanto não virem chegar o reino de Deus no seu poder."},{text:"Marcos — capítulo 9."},{text:"1 E seis dias depois tomou Jesus consigo a Pedro, e a Tiago, e a João: E os levou sós a um alto monte em lugar apartado, e transfigurou-se ante êles."},{text:"2 E os seus vestidos se tornaram resplandecentes, e em extremo brancos como a neve, tanto que nenhum lavandeiro sôbre a terra os poderia fazer tão brancos."},{text:"3 tools — see the cookie policy for details"},{text:"4 E respondendo Pedro, disse a Jesus: Mestre, bom será que nós estejamos aqui: E façamos três tendas, para ti uma, e para Moisés outra, e para Elias outra."},{text:"5 Porque não sabia o que diziam: Pois estavam atônitos de mêdo:"},{text:"6 E formou-se uma nuvem que lhes fêz sombra: E saiu uma voz da nuvem, que dizia: Êste é meu Filho diletíssimo: Ouvi-o."},{text:"7 E olhando logo em roda, não viram ali mais ninguém, senão sòmente a Jesus que estava com êles:"},{text:"8 E ao descerem êles do monte, mandou-lhes que a ninguém contassem o que tinham visto: Até que o Filho do homem houvesse ressurgido dos mortos."},{text:"9 E êles guardaram segrêdo, disputando entre si, sôbre que queria dizer aquela palavra: Até que houvesse ressurgido dos mortos."},{text:"10 E lhe perguntaram, dizendo: Pois como dizem os fariseus, e os escribas, que Elias deve vir primeiro?"},{text:"11 Êle respondendo, lhes disse: Elias quando vier primeiro, reformará tôdas as coisas: E como está escrito acêrca do Filho do homem, deve padecer muito, e ser desprezado."},{text:"12 Mas digo-vos que Elias já veio (e fizeram dêle quanto quiseram) como está escrito dêle."},{text:"13 E vindo a seus discípulos, viu perto dêles uma grande multidão de gente, e que os escribas estavam disputando com êles."},{text:"14 E logo todo o povo vendo a Jesus, ficou espantado, e todos se encheram de temor, e correndo a êle o saudavam."},{text:"15 E êle perguntou-lhes: Que é o que estais disputando entre vós outros?"},{text:"16 E respondendo um dentre a gente, disse: Mestre, eu te trouxe meu filho, possuído de um espírito mudo:"},{text:"17 O qual onde quer que o apanha, o lança por terra, e o moço deita escuma pela bôca e range os dentes, e vai-se mirrando: E roguei a teus discípulos que o expelissem, e êles não puderam."},{text:"18 Respondendo-lhes Jesus, disse: Ó geração incrédula, até quando hei de eu estar convosco? Até quando vos hei de sofrer? Trazei-mo cá."},{text:"19 Trouxeram-lho então. E ainda bem êle não tinha visto a Jesus, quando logo o espírito imundo o começou a agitar com violência: Até que caiu por terra, onde se revolvia babando-se todo."},{text:"20 E perguntou Jesus ao pai dêle: Quanto tempo há que lhe sucede isto? E êle disse: Desde a infância:"},{text:"21 E o demônio o tem lançado muitas vêzes no fogo, e muitas na água, para o matar: Porém se tu podes alguma coisa, ajuda-nos, tem compaixão de nós."},{text:"22 Disse-lhe pois Jesus: Se tu podes crer, tudo é possível ao que crê."},{text:"23 E imediatamente o pai do moço gritando, dizia com lágrimas: Sim, Senhor, eu creio: Ajuda-tu a minha incredulidade."},{text:"24 E Jesus vendo que o povo concorria, ameaçou o espírito imundo, dizendo-lhe: Espírito surdo, e mudo, eu te mando, sai dêsse moço: E não tornes a entrar nêle."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 Então dando grandes gritos, e maltratando-o muito, saiu dêle, e ficou como morto, de sorte que muitos diziam: Está morto."},{text:"26 Porém tomando-o Jesus pela mão, o levantou, e êle se ergueu."},{text:"27 E depois que entrou em casa, perguntaram-lhe seus discípulos particularmente: Por que o não pudemos nós expelir?"},{text:"28 E êle lhes disse: Esta casta de demônios não se pode fazer sair, senão à fôrça de oração, e de jejum."},{text:"29 E tendo partido dali, caminharam mais além de Galiléia: E não queria que ninguém o soubesse."},{text:"30 Entretanto ensinava a seus discípulos, e dizia-lhes: O Filho do homem será entregue às mãos dos homens, que lhe tirarão a vida, e êle ressurgirá ao terceiro dia, depois da sua morte."},{text:"31 Mas êles não entendiam o discurso: E tinham mêdo de lho perguntar."},{text:"32 Vieram depois a Cafarnaum. Quando êles estavam já em casa, lhes perguntou Jesus: De que vínheis vós tratando pelo caminho?"},{text:"33 Mas êles calaram-se: Porque no caminho haviam disputado entre si qual dêles era o maior."},{text:"34 E sentando-se chamou aos doze, e lhes disse: Se algum quer ser o primeiro, será o último de todos, e o servo de todos."},{text:"35 E tomando a si um menino, pô-lo no meio dêles: Depois de o abraçar, disse-lhes:"},{text:"36 Todo que receber um dêstes meninos em meu nome a mim me recebe: E todo o que me receber a mim, não me recebe a mim, mas recebe àquele que me enviou."},{text:"37 Respondeu-lhe João, dizendo: Mestre, vimos a um que lançava fora demônios em teu nome, que nos não segue, e lho proibimos."},{text:"38 E disse Jesus: Não lho proibais: Porque não há nenhum que faça milagre em meu nome, e que possa logo dizer mal de mim:"},{text:"39 Porque quem não é contra vós, é por vós."},{text:"40 E qualquer que vos der a beber um copo d'água em meu nome, em atenção a que sois coisa de Cristo: Digo-vos em verdade que não perderá a sua recompensa."},{text:"41 E todo o que escandalizar a um dêstes pequenos que crêem em mim: Melhor lhe fôra que lhe atassem a roda do pescoço uma mó de atafona, e que o lançassem no mar."},{text:"42 E se a tua mão te escandalizar, corta-a: Melhor te é entrar na vida eterna manco, do que tendo duas mãos, ir para o inferno, para o fogo que nunca jamais se apaga:"},{text:"43 Onde o bicho que os rói nunca morre, e onde o fogo nunca se apaga."},{text:"44 E se o teu pé te escandaliza, corta-o: Melhor te é entrar na vida eterna coxo, do que tendo dois pés ser lançado no fogo do inferno, que nunca jamais se apaga:"},{text:"45 Onde o bicho que os rói nunca morre, e onde o fogo nunca se apaga."},{text:"46 E se o teu ôlho te escandaliza, lança-o fora: Melhor te é entrar no reino de Deus sem um ôlho, do que tendo dois ser lançado no fogo do inferno:"},{text:"47 Onde o bicho que os rói nunca morre, e onde o fogo nunca se apaga."},{text:"48 Porque todos êles serão salgados no fogo, e tôda a vítima será salgada com sal."},{text:"49 O sal é bom: Porém se êle se fizer insípido, com que o haveis de temperar? Tende sal em vós, e guardai paz entre vós."},{text:"Marcos — capítulo 10."},{text:"1 E saindo dali, foi Jesus para os confins da Judéia, na banda dalém do Jordão: E voltaram as gentes a ajuntar-se com êle: E de novo os ensinava, como sempre costumara."},{text:"2 E chegando os fariseus, lhe perguntavam: É lícito ao marido repudiar a sua mulher? o que êles diziam para o tentarem."},{text:"3 tools — see the cookie policy for details"},{text:"4 Responderam êles: Moisés permitiu escrever libelo de repúdio e reenviá-la."},{text:"5 Aos quais respondendo Jesus, disse: Pela dureza de vosso coração é que êle vos deixou escrito êsse mandamento:"},{text:"6 Porém ao princípio da criação, fê-los Deus macho e fêmea."},{text:"7 Por isto deixará o homem a seu pai, e a sua mãe, e se ajuntará a sua mulher."},{text:"8 E serão dois numa só carne. Assim que êles já não são dois, mas uma só carne."},{text:"9 O que Deus pois ajuntou, não o separe o homem."},{text:"10 E tornaram a fazer-lhe seus discípulos em casa perguntas sôbre a mesma matéria."},{text:"11 E êle lhes disse: Qualquer que repudiar a sua mulher, e se casar com outra, comete adultério contra a sua primeira mulher."},{text:"12 E se a mulher repudiar a seu marido, e se casar com outro, comete adultério."},{text:"13 Então lhe apresentavam uns meninos para que os tocasse. Mas os discípulos ameaçavam aos que lhos apresentavam."},{text:"14 O que vendo Jesus, levou-o muito a mal e disse-lhes: Deixai vir a mim os pequeninos, e não os embaraceis: Porque dos tais é o reino de Deus."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 11",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Em verdade vos digo: Que todo o que não receber o reino de Deus como pequenino não entrará nêle."},{text:"16 E abraçando-os, e pondo sôbre êles as mãos, os abençoava."},{text:"17 E tendo saído Jesus para se pôr a caminho, veio correndo um homem, e com o joelho em terra diante dêle, lhe fêz esta súplica: Bom Mestre, que devo eu fazer para alcançar a vida eterna?"},{text:"18 E Jesus lhe disse: Por que me chamas tu bom? Ninguém é bom senão só Deus."},{text:"19 Tu sabes os mandamentos: Não cometas adultério, não mates, não furtes, não digas falso testemunho, não cometas fraudes, honra a teu pai e a tua mãe."},{text:"20 Então êle respondendo, lhe disse: Mestre, todos êstes mandamentos tenho eu observado desde a minha mocidade."},{text:"21 E Jesus, pondo nêle os olhos, lhe mostrou agrado, e lhe disse: Uma coisa só te falta: Vai, vende quanto tens, dá-o aos pobres, e terás um tesouro no Céu: E vem, segue-me."},{text:"22 O homem desgostoso das palavras que ouvira, foi-se todo triste: Porque era muito afazendado."},{text:"23 E Jesus, olhando em roda, disse a seus discípulos: Com quanta dificuldade entrarão no reino de Deus os que têm riquezas!"},{text:"24 E os discípulos se assombravam das suas palavras. Mas Jesus continuando por diante lhes disse: Filhinhos, quão difícil coisa é entrarem no reino de Deus os que confiam nas riquezas!"},{text:"25 Mais fácil é passar um camelo pelo fundo duma agulha, do que entrar no reino de Deus um rico."},{text:"26 Êles ainda ficaram muito mais cheios de espanto, e diziam uns para os outros: Quem pode logo salvar-se?"},{text:"27 Então Jesus olhando para êles, disse: Para os homens coisa é esta que não pode ser, mas não para Deus: Porque para Deus tôdas as coisas são possíveis."},{text:"28 E começou Pedro a dizer-lhes: Eis aqui estamos nós que largamos tudo, e te seguimos."},{text:"29 Respondendo Jesus, disse: Na verdade vos digo: Que não há nenhum que haja deixado casa, ou irmãos, ou irmãs, ou pai, ou mãe, ou filhos, ou terras por amor de mim, e por amor do Evangelho,"},{text:"30 que não venha a receber, já de presente neste mesmo século, a cento por um: Das casas, e dos irmãos, e das irmãs, e das mães, e dos filhos, e das terras, com as perseguições, e no século futuro a vida eterna."},{text:"31 Porém haverá muitos que, sendo os primeiros, serão os últimos, e muitos que, sendo os últimos, serão os primeiros."},{text:"32 E estavam no caminho para subir a Jerusalém: E Jesus ia adiante dêles, do que os mesmos se espantavam: E o seguiam com mêdo. E tornando a tomar de parte aos doze, começou a declarar-lhes as coisas que tinham de lhe"},{text:"acontecer."},{text:"33 Eis aqui está que nós subimos a Jerusalém, e o Filho do homem será entregue aos príncipes dos sacerdotes, e aos escribas, e aos anciãos, e sentenciá-lo-ão à morte, e o entregarão aos gentios:"},{text:"34 E o escarnecerão, e lhe cuspirão no rosto, e o açoutarão, e lhe tirarão a vida: E ao terceiro dia ressurgirá:"},{text:"35 Então se chegaram a êle Tiago e João, filhos de Zebedeu, dizendo-lhe: Mestre, queremos que nos concedas tudo o que te pedirmos."},{text:"36 E êle lhes disse: Que quereis vós que eu vos faça?"},{text:"37 E êles responderam: Concede-nos que nos sentemos na tua glória, um à tua direita e outro à tua esquerda."},{text:"38 Mas Jesus lhes disse: Não sabeis o que pedis: Podeis vós beber o cálice que eu estou para beber? Ou ser batizados no batismo em que eu estou para ser batizado?"},{text:"39 E êles lhe disseram: Podemos. E Jesus lhes disse: Vós com efeito haveis de beber o cálice que eu estou para beber: E haveis de ser batizados no batismo em que eu estou para ser batizado."},{text:"40 Mas pelo que toca a terdes assento à minha destra, ou à minha esquerda, não me pertence a mim o conceder-vo-lo, porém, essa honra é para aqueles para quem ela está preparada."},{text:"41 E ouvindo isto os outros dez começaram a indignar-se contra Tiago e João."},{text:"42 Mas Jesus, chamando-os, lhes disse: Vós sabeis que os que têm autoridade entre os povos, êsses são os que os dominam, e que os seus príncipes têm poder sôbre êles."},{text:"43 Porém entre vós não deve ser assim, mas todo o que quiser ser o maior, êsse deve ser o que vos ministre:"},{text:"44 E todo o que entre vós quiser ser o primeiro, êsse deve fazer-se servo de todos."},{text:"45 Porque o mesmo Filho do homem não veio a ser servido, mas a servir, e a dar a sua vida para redenção de muitos."},{text:"46 Depois foram a Jericó; e ao sair de Jericó êle, e os seus discípulos, e muitíssimo povo com êles, Bartimeu, que era cego, filho de Timeu, estava assentado junto ao caminho pedindo esmola."},{text:"47 O qual, como ouviu que passava Jesus Nazareno, começou a gritar, e a dizer: Jesus, filho de Davi, tem misericórdia de mim."},{text:"48 E ameaçavam-no muitos, para que se calasse. Mas êle cada vez gritava muito mais: Filho de Davi, tem misericórdia de mim."},{text:"49 Parando então Jesus mandou que lho chamassem. E chamaram o cego, dizendo-lhe: Tem boas esperanças, levanta-te, que êle te chama."},{text:"50 Êle, deitando fora de si a capa, saltando, veio ter com êle."},{text:"51 E falando Jesus, lhe disse: Que queres tu que eu te faça? O cego pois lhe respondeu: Mestre, que eu tenha vista."},{text:"52 Então lhe disse Jesus: Vai, a tua fé te sarou. E no mesmo ponto viu, e o foi seguindo pelo caminho."},{text:"Marcos — capítulo 11."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 E quando êles se iam aproximando a Jerusalém, e a Betânia, perto do monte das Oliveiras, enviou dois dos seus discípulos,"},{text:"2 e lhes disse: Ide a essa aldeia que está defronte de vós, e logo que entrardes nela, achareis prêso um asninho, em que ainda não montou homem algum: Soltai-o e trazei-o."},{text:"3 tools — see the cookie policy for details"},{text:"4 E saindo êles acharam o jumentinho atado de fora da porta na encruzilhada, e desprenderam-no."},{text:"5 E alguns dos que estavam ali lhes diziam: Que fazeis, desprendendo o jumentinho?"},{text:"6 Êles responderam como Jesus lhes havia mandado, e os homens lho deixaram levar."},{text:"7 E trouxeram o jumentinho a Jesus, e acobertaram-no com os seus vestidos, e Jesus montou em cima dêle."},{text:"8 E muitos estenderam os seus vestidos pelo caminho: E outros cortavam ramos das árvores e juncavam com êles o caminho."},{text:"9 E tanto os que iam adiante, como os que o seguiam atrás davam os vivas a Jesus, dizendo: Hosana."},{text:"10 Bendito seja o que vem em nome do Senhor, e bendito seja o reino que vemos chegar do nosso pai Davi: Hosana nas alturas."},{text:"11 E entrou em Jerusalém no Templo: E depois de ter observado tudo quanto nêle havia, como fôsse já tarde, saiu a Betânia com os doze."},{text:"12 E ao outro dia como saíssem de Betânia teve fome."},{text:"13 E tendo visto ao longe uma figueira que tinha folhas, foi lá a ver se acharia nela alguma coisa: E quando chegou a ela, nada achou senão folhas: Porque não era tempo de figos."},{text:"14 E falando lhe disse: Nunca jamais coma alguém fruto de ti para sempre. E ouviram-no os seus discípulos."},{text:"15 Chegaram pois a Jerusalém. E havendo entrado no Templo, começou a lançar fora os que vendiam e compravam no Templo, e derribou as mesas dos banqueiros, e as cadeiras dos que vendiam pombas."},{text:"16 E não consentia que qualquer transportasse móvel algum pelo Templo:"},{text:"17 E êle os ensinava, dizendo-lhes: Porventura não está escrito: Que a minha Casa será chamada Casa de Oração entre tôdas as gentes? E vós tendes feito dela um covil de ladrões."},{text:"18 O que ouvindo os príncipes dos sacerdotes e os escribas, andavam excogitando de que modo o haviam de perder, porque como todo o povo admirava a sua doutrina, tinham mêdo dêle."},{text:"19 Quando era já pela tarde, saiu da cidade."},{text:"20 E no outro dia pela manhã, ao passarem pela figueira, viram que ela estava sêca até às raízes."},{text:"21 Então lembrado Pedro, disse para Jesus: Olha, Mestre, como se secou a figueira que tu amaldiçoaste."},{text:"22 E respondendo, Jesus lhe disse: Tende a fé de Deus."},{text:"23 Em verdade vos afirmo, que todo o que disser a êste monte: Tira-te, e lança-te no mar, e isto sem hesitar no seu coração, mas tendo fé de que tudo o que disser sucederá, êle o verá cumprir assim."},{text:"24 Por isso vos digo, tôdas as coisas que vós pedirdes orando, crêde que as haveis de haver, e que assim vos sucederão."},{text:"25 Mas quando vos puserdes em oração, se tendes alguma coisa contra alguém, perdoai-lha, para que também vosso Pai, que está nos Céus, vos perdoe vossos pecados."},{text:"26 Porque se vós não perdoardes, também vosso Pai, que está nos Céus, vos não há de perdoar vossos pecados."},{text:"27 E voltaram outra vez a Jerusalém. E andando Jesus pelo Templo, se chegaram a êle os príncipes dos sacerdotes, e os escribas, e os anciãos:"},{text:"28 E lhe disseram: Com que autoridade fazes tu estas coisas? e quem te deu êste poder de fazer essas coisas?"},{text:"29 E respondendo, Jesus lhes disse: Eu também vos farei uma pergunta, e respondei-me a ela: E eu então vos direi com que autoridade faço estas coisas."},{text:"30 O batismo de João era do Céu, ou dos homens? Respondei-me."},{text:"31 Mas êles faziam lá consigo êste juízo, discorrendo: Se nós dissermos que era do Céu, dir-nos-á êle: Por que razão logo não crestes nêle?"},{text:"32 Se dissermos que dos homens, temos mêdo do povo: Porque todos tinham a João em conta de um profeta."},{text:"33 E respondendo, disseram a Jesus: Não sabemos. E respondendo Jesus, lhes disse: Pois nem eu tampouco vos direi com que autoridade vos faço estas coisas."},{text:"Marcos — capítulo 12."},{text:"1 Começou depois Jesus a falar-lhes por parábolas: Um homem plantou uma vinha e cercou-a com uma sebe, e cavando fêz um lagar, e edificou uma tôrre, e arrendou-a a uns lavradores; depois ausentou-se para longe."},{text:"2 E chegado o tempo enviou aos lavradores um servo, que fôsse receber dos mesmos lavradores o que lhe deviam do fruto da sua vinha."},{text:"3 tools — see the cookie policy for details"},{text:"4 E enviou-lhes de novo outro servo: E também a êste o feriram na cabeça, e o carregaram de afrontas."},{text:"5 E de novo enviou outro, e o mataram: E outros muitos: Dos quais feriram a uns, e mataram a outros."},{text:"6 Mas como tivesse ainda um filho, a quem êle muito amava: Também lho enviou por último, dizendo: Terão respeito a meu filho."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Porém os lavradores disseram uns para os outros: Êste é o herdeiro: Vinde, mate-mo-lo: E será nossa a herança."},{text:"8 E pegando nêle mataram-no: E lançaram-no fora da vinha."},{text:"9 Que fará pois o Senhor da vinha? Virá, e acabará de todo com êstes lavradores: E dará a sua vinha a outros."},{text:"10 Vós nunca lestes êste lugar da Escritura: A pedra, que fôra rejeitada pelos que edificavam, essa veio a ser a principal da esquina:"},{text:"11 Pelo Senhor é que foi feito isto, e é coisa maravilhosa nos nossos olhos?"},{text:"12 E buscavam meios para o prenderem: Mas temeram o povo: Porque entenderam que contra êles havia dito esta parábola. E deixando-o se retiraram."},{text:"13 E lhe enviaram alguns dos fariseus, e dos herodianos, para que o apanhassem no que falasse."},{text:"14 Êles vindo lhe dizem: Mestre, sabemos que és homem verdadeiro, e que não atendes a respeitos humanos: Porque não olhas os homens pela aparência, mas ensinas o caminho de Deus segundo a verdade: É-nos permitido dar o"},{text:"tributo a César, ou não lho devemos dar?"},{text:"15 Jesus, conhecendo a sua hipocrisia, respondeu-lhes: Por que me tentais? Dai-me cá um dinheiro para o ver."},{text:"16 E êles lho trouxeram. Então lhes perguntou Jesus: De quem é esta imagem e inscrição? Responderam-lhe êles: De César."},{text:"17 E, respondendo, Jesus lhes disse: Pois dai a César o que é de César: E a Deus o que é de Deus. E desta resposta ficaram admirados."},{text:"18 E vieram a êle os saduceus, que negam a Ressurreição: E lhe perguntavam, dizendo:"},{text:"19 Mestre, Moisés nos deixou escrito que, se morrer o irmão de algum, e deixar mulher, e não tiver filhos, que tome seu irmão a mulher dêle, e que dê sucessão a seu irmão."},{text:"20 Eram pois sete irmãos: E o maior tomou mulher, e morreu sem deixar sucessão."},{text:"21 E o segundo a tomou, e morreu: E nem êste deixou filhos. E da mesma sorte o terceiro."},{text:"22 E assim mesmo a tomaram os sete: E não deixaram filhos. E sendo já a última de todos, morreu também a mulher."},{text:"23 Ao tempo pois da ressurreição, quando tornarem a viver, de qual dêstes será a mulher? Porque todos sete a tiveram por mulher."},{text:"24 E, respondendo, Jesus lhes disse: Não vêdes que por isso errais, porque não compreendeis as Escrituras, nem o poder de Deus?"},{text:"25 Porque quando ressuscitarem dentre os mortos, não hão de os homens ter mulheres, nem as mulheres homens, mas todos serão como os anjos nos Céus."},{text:"26 E dos mortos que têm de ressuscitar, não haveis lido no livro de Moisés, como Deus lhe falou sôbre a sarça, dizendo: Eu sou o Deus de Abraão, e o Deus de Isaac, e o Deus de Jacó?"},{text:"27 Êle não é Deus de mortos, senão de vivos, logo estais vós num grande êrro."},{text:"28 Então se chegou um dos escribas, que os tinha ouvido disputar, e vendo que Jesus lhes havia respondido bem, lhe perguntou qual era o primeiro de todos os mandamentos."},{text:"29 E Jesus lhe respondeu: Que de todos o primeiro mandamento era êste: Ouve, Israel, o Senhor teu Deus é só o que é Deus:"},{text:"30 E amarás o Senhor teu Deus de todo o teu coração, e de tôda a tua alma, e de todo o teu entendimento, e de tôdas as tuas fôrças. Êste é o primeiro mandamento."},{text:"31 E o segundo semelhante ao primeiro é: Amarás ao teu próximo como a ti mesmo. Nenhum outro mandamento há que seja maior do que êstes."},{text:"32 Disse-lhe então o escriba: Mestre, na verdade disseste bem, que Deus é um só e que não há outro fora êle."},{text:"33 E que o amá-lo cada um de todo o seu coração, e de todo o seu entendimento, e de tôda a sua alma, e de tôdas as suas fôrças: E o amar ao próximo como a si mesmo, é uma coisa que excede todos os holocaustos, e"},{text:"sacrifícios."},{text:"34 E vendo Jesus que o escriba tinha respondido sàbiamente, lhe disse: Não estás longe do reino de Deus. E desde então ninguém mais se atreveu a fazer-lhe perguntas."},{text:"35 E falando Jesus dizia ensinando no Templo: Como dizem os escribas que o Cristo é Filho de Davi?"},{text:"36 Porque o mesmo Davi por bôca do Espírito Santo diz: Disse o Senhor ao meu Senhor, senta-te à minha direita, até que eu ponha os teus inimigos por estrado de teus pés."},{text:"37 Pois se o mesmo Davi lhe chama Senhor, como é êle logo seu Filho? E uma grande multidão de povo o ouvia com gôsto."},{text:"38 E êle lhes dizia segundo o seu modo de ensinar: Guardai-vos dos escribas, que gostam de andar com roupas largas, e de que os cumprimentem nas praças,"},{text:"39 e de ocupar nas sinagogas as primeiras cadeiras, e nos banquetes os primeiros lugares."},{text:"40 Que devoram as casas das viúvas debaixo do pretexto de longas orações: Êstes serão julgados com maior rigor."},{text:"41 E estando Jesus assentado defronte donde era o gazofilácio, observava êle de que modo deitava o povo ali o dinheiro, e muitos que eram ricos deitavam com mão larga."},{text:"42 E tendo chegado uma pobre viúva, lançou duas pequenas moedas, que importavam um real."},{text:"43 E convocando a seus discípulos, lhes disse: Na verdade vos digo, que mais deitou esta pobre viúva, que todos os outros que lançaram no gazofilácio."},{text:"44 Porque todos os outros deitaram do que tinham na sua abundância: Porém esta deitou da sua mesma indigência tudo o que tinha, e tudo o que lhe restava para seu sustento."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"Marcos — capítulo 13."},{text:"1 E ao sair Jesus do Templo, disse-lhe um de seus discípulos: Olha, Mestre, que pedras, e que fábricas."},{text:"2 E respondendo Jesus, lhe disse: Vês todos êstes grandes edifícios? Não ficará pedra sôbre pedra, que não seja derribada."},{text:"3 tools — see the cookie policy for details"},{text:"4 Dize-nos, quando hão de suceder estas coisas? e que sinal haverá de quando tôdas elas se começarem a cumprir?"},{text:"5 Então em resposta a isto começou Jesus a dizer-lhes: Guardai-vos, não vos engane alguém:"},{text:"6 Porque muitos virão em meu nome dizendo: Sou eu: E enganarão a muitos."},{text:"7 Quando vós porém ouvirdes falar de guerras, e de rumores de guerras, não temais; porque importa que estas coisas sucedam: Mas êste não será ainda o fim."},{text:"8 Porque se levantará nação contra nação e reino contra reino, e haverá terremotos por diversas partes, e fomes. Estas cousas não serão mais do que o princípio das dores."},{text:"9 Tende pois sentido convosco. Porque vos hão de entregar nos juízos, e vos hão de açoutar nas sinagogas, e fazer comparecer por meu respeito diante dos governadores, e dos reis, a fim de que perante êles deis testemunho"},{text:"de mim."},{text:"10 Mas primeiro importa que o Evangelho seja pregado a tôdas as nações."},{text:"11 Quando pois vos levarem para vos entregarem, não premediteis no que haveis de dizer: Mas dizei o que vos fôr inspirado naquela hora: Porque não sois vós os que falais, mas sim o Espírito Santo."},{text:"12 Então um irmão entregará à morte outro irmão, e o pai ao filho: E os filhos se levantarão contra os pais, e lhes darão a morte."},{text:"13 E vós sereis aborrecidos de todos por amor do meu nome. Mas o que perseverar até o fim, êsse será salvo."},{text:"14 Quando porém vós virdes estar a abominação da desolação, onde não deve estar, o que lê, entenda: Então os que estiverem em Judéia, fujam para os montes:"},{text:"15 E o que estiver sôbre o telhado, não desça a casa nem entre para levar dela coisa alguma."},{text:"16 E o que se achar no campo, não volte atrás a buscar o seu vestido."},{text:"17 Mas ai das que naquele tempo estiverem pejadas, e criarem."},{text:"18 Rogai pois que não sucedam estas coisas no inverno."},{text:"19 Porque naqueles dias haverá tribulações tais, quais não houve desde o princípio das criaturas, que Deus fêz até agora, nem haverá."},{text:"20 De sorte que se o Senhor não abreviasse aqueles dias, nenhuma pessoa se salvaria: Mas êle os abreviou em atenção aos escolhidos, de que fêz escolha."},{text:"21 E se então vos disser alguém: Reparai, aqui está o Cristo, ou, ei-lo acolá está, não lhe deis crédito."},{text:"22 Porque se levantarão falsos Cristos, e falsos profetas, que farão prodígios, e portentos para enganarem, se possível fôra, até os mesmos escolhidos."},{text:"23 Estai vós pois de sobreaviso; olhai que eu vos preveni de tudo."},{text:"24 Mas naqueles dias, depois daquela tribulação, o sol se escurecerá, e a lua não dará o seu resplendor:"},{text:"25 E cairão as estrêlas do Céu, e se comoverão as virtudes que estão nos Céus."},{text:"26 E então verão o Filho do homem que virá sôbre as nuvens, com grande poder e majestade."},{text:"27 E então enviará os seus Anjos, e ajuntará os seus escolhidos de todos os quatro ventos, desde a extremidade da terra até à extremidade do Céu."},{text:"28 Aprendei pois o que vos digo, de uma comparação tirada da figueira. Quando os seus ramos estão já tenros, e nascidas as folhas, conheceis que está perto o estio:"},{text:"29 Assim também quando vós virdes que acontecem estas coisas, sabei que está perto e já à porta."},{text:"30 Na verdade vos digo, que não passará esta geração sem que tudo isto seja cumprido."},{text:"31 Passará o Céu e a terra, mas não passarão as minhas palavras."},{text:"32 A respeito porém dêste dia, ou desta hora, ninguém sabe quando há de ser, nem os Anjos no Céu, nem o Filho, mas só o Pai:"},{text:"33 Estai de sobreaviso, vigiai, e orai: Porque não sabeis quando chegará êsse tempo."},{text:"34 Assim como um homem que, ausentando-se para longe, deixou a sua casa, e designou a cada um de seus servos a obra que devia fazer, e mandou ao porteiro que estivesse de vigia."},{text:"35 Vigiai pois, (visto que não sabeis quando virá o Senhor da casa: se de tarde, se à meia-noite, se ao cantar do galo, se pela manhã),"},{text:"36 para que não suceda que quando vier de repente, vos ache dormindo."},{text:"37 O que eu porém vos digo a vós, isto digo a todos: Vigiai."},{text:"Marcos — capítulo 14."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Faltavam pois dois dias para chegar a Páscoa, em que se começava a comer os pães asmos: E os príncipes dos sacerdotes, e os escribas andavam buscando modo como prenderiam por traição a Jesus, para o matarem."},{text:"2 Mas êles diziam: Não convém que isto se faça no dia da festa, por não suceder que no povo se excite algum motim."},{text:"3 tools — see the cookie policy for details"},{text:"4 E alguns dos que estavam presentes indignaram-se lá entre si do que viam e disseram: Para que foi êste desperdício de bálsamo?"},{text:"5 Pois podia êle vender-se por mais de trezentos dinheiros, e dar-se êste produto aos pobres. E murmuravam fortemente contra ela."},{text:"6 Mas Jesus lhes disse: Deixai-a; por que a molestais? ela fêz-me uma boa obra."},{text:"7 Porque vós sempre tendes convosco os pobres: Para que quando lhes queirais fazer bem, lho possais fazer: Porém a mim não me tendes sempre."},{text:"8 Ela fêz o que cabia nas suas fôrças: Foi isto embalsamar-me antecipadamente o corpo para a sepultura."},{text:"9 Em verdade vos digo: Onde quer que fôr pregado êste Evangelho, que será em todo o mundo, será também contado para sua memória, o que esta obrou."},{text:"10 Então se retirou Judas Iscariotes, que era um dos doze, a buscar os príncipes dos sacerdotes, para lhes entregar a Jesus."},{text:"11 Êles ouvindo isto se alegraram, e prometeram dar-lhe dinheiro. E buscava Judas ocasião oportuna para o entregar."},{text:"12 E no primeiro dia em que se comiam os pães asmos, quando se imolava o Cordeiro Pascal, disseram-lhe seus discípulos: Onde queres tu que nós vamos preparar-te o que é necessário para comeres a Páscoa?"},{text:"13 Enviou êle pois a dois de seus discípulos, e disse-lhes: Ide à cidade, e lá vos sairá ao encontro um homem que levará uma bilha de água; ide atrás dêle:"},{text:"14 E onde quer que êle entrar: Dizei ao dono da casa que o Mestre diz: Onde é o aposento em que eu poderei comer a Páscoa com meus discípulos?"},{text:"15 E êle vos mostrará um cenáculo, todo mobilado, e preparai-nos lá o que é necessário."},{text:"16 E partiram seus discípulos, e chegaram à cidade, e acharam tudo como êle lhes havia dito, e prepararam a Páscoa."},{text:"17 E chegada a tarde, foi Jesus com os doze."},{text:"18 E quando êles estavam à mesa e ceavam, disse-lhes Jesus: Em verdade vos digo, que um de vós que comigo come, me há de entregar."},{text:"19 Então se começaram êles a entristecer, e cada um de per si lhe perguntava: Sou eu?"},{text:"20 Respondeu-lhes Jesus: É um dos doze que mete comigo a mão no prato."},{text:"21 E quanto ao Filho do homem, êle vai segundo o que dêle está escrito: Mas ai daquele homem, por meio do qual será entregue o Filho do homem: Melhor lhe fôra, se êsse homem não houvera nascido."},{text:"22 E quando êles estavam comendo, tomou Jesus o pão, e depois de o benzer, partiu-o e deu-lho, e disse: Tomai, êste é o meu Corpo."},{text:"23 E tendo tomado o cálice, depois que deu graças, lho deu: E todos beberam dêle."},{text:"24 E Jesus lhes disse: Êste é o meu sangue do Novo Testamento, que será derramado por muitos."},{text:"25 Em verdade vos digo, que eu não beberei jamais dêste fruto da vide até chegar aquêle dia em que o beba novo no reino de Deus."},{text:"26 E depois de cantado o hino, saíram para o Monte das Oliveiras."},{text:"27 Então lhes disse Jesus: A todos vós serei eu esta noite uma ocasião de escândalo: Pois está escrito: Eu ferirei o pastor, e as ovelhas se porão em desarranjo."},{text:"28 Mas depois que eu ressurgir, ir-vos-ei esperar em Galiléia."},{text:"29 Disse-lhe então Pedro: Ainda quando todos se escandalizarem a teu respeito, eu contudo me não hei de escandalizar."},{text:"30 E Jesus lhe respondeu: Em verdade te digo, que hoje, nesta mesma noite, antes que o galo cante a segunda vez, me hás de tu negar três vêzes."},{text:"31 Mas Pedro, insistindo no mesmo, acrescentava: Ainda no caso de eu me ver precisado a morrer contigo, não te hei eu de negar. E o mesmo disseram também todos os mais."},{text:"32 Vieram depois para uma herdade chamada Getsêmane. Então Jesus disse a seus discípulos: Assentai-vos aqui, enquanto eu oro."},{text:"33 E levou consigo a Pedro, e a Tiago, e a João: E começou a ter pavor, e angustiar-se em extremo."},{text:"34 Então lhes disse: A minha alma se acha numa tristeza mortal: Detende-vos aqui, e vigiai."},{text:"35 E tendo-se adiantado alguns passos, prostrou-se em terra: E orava que, se era possível, passasse dêle aquela hora:"},{text:"36 E disse: Abba, Pai, tôdas as coisas te são possíveis; traspassa de mim êste cálice, porém não se faça o que eu quero senão o que tu queres."},{text:"37 Depois veio, e achou-os dormindo. Então disse a Pedro: Simão, dormes? não pudeste vigiar uma hora?"},{text:"38 Vigiai, e orai, para que não entreis em tentação. O espírito na verdade está pronto, mas a carne é fraca."},{text:"39 E foi outra vez a orar, dizendo as mesmas palavras."},{text:"40 E tornando a vir, achou-os outra vez dormindo, (porque tinham carregados os olhos) e não sabiam que lhe respondessem."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"41 E veio terceira vez, e disse-lhes: Dormi agora, e descansai. Basta: É chegada a hora: Eis aqui vai o Filho do homem a ser entregue em mãos de pecadores."},{text:"42 Levantai-vos, vamos: Eis aí vem chegando quem me há de entregar."},{text:"43 Ainda bem Jesus não tinha acabado de falar, quando chega Judas Iscariotes, um dos doze, e com êle uma grande tropa de gente armada de espadas e de varapaus, da parte dos príncipes dos sacerdotes, e dos escribas, e dos"},{text:"anciãos."},{text:"44 Ora, o traidor tinha-lhes dado uma senha, dizendo: Àquele a quem eu der um ósculo, êsse é que é, prendei-o e levai-o com cuidado."},{text:"45 E tanto que chegou, indo logo ter com Jesus, lhe disse: Deus te salve, Mestre: E deu-lhe um ósculo."},{text:"46 Então êles lhe lançaram as mãos, e o prenderam."},{text:"47 E um certo dos circunstantes, tirando da espada, feriu a um servo do sumo sacerdote, e lhe cortou uma orelha."},{text:"48 E respondendo Jesus lhes disse: Como se eu fôra algum ladrão viestes com espadas, e varapaus a prender-me?"},{text:"49 Todos os dias estava eu convosco ensinando no templo e não me prendestes. Mas isto acontece para que se cumpram as Escrituras."},{text:"50 Então desamparando-o os seus discípulos, fugiram todos."},{text:"51 Ia-o, porém, seguindo um mancebo, coberto com um lençol sôbre o corpo nu: E o prenderam."},{text:"52 Mas êle, largando o lençol, lhes escapou nu."},{text:"53 E levaram Jesus à casa do sumo sacerdote. E se ajuntaram todos os sacerdotes, e os escribas, e os anciãos."},{text:"54 Mas Pedro o foi seguindo de longe até dentro do pátio do sumo sacerdote: E estava assentado ao fogo com os oficiais, e ali se aquentava."},{text:"55 E os príncipes dos sacerdotes, e todo o conselho buscavam algum testemunho contra Jesus, para o fazerem morrer, e não o achavam."},{text:"56 Porque muitos, sim, depunham falsamente contra êle: Mas não concordavam os seus depoimentos."},{text:"57 E levantando-se uns, atestavam falsamente contra êle, dizendo:"},{text:"58 Nós outros lhe ouvimos dizer: Eu destruirei êste templo, obra de mãos, e em três dias edificarei outro, que não será obra de mãos."},{text:"59 Mas esta sua mesma deposição não era coerente."},{text:"60 Então levantando-se no meio do conselho o sumo sacerdote, perguntou a Jesus, dizendo: Não respondes alguma coisa ao que êstes atestam contra ti?"},{text:"61 Mas êle estava em silêncio, e nada respondeu. Tornou a perguntar-lhe o sumo sacerdote, e lhe disse: És tu o Cristo, Filho de Deus bendito?"},{text:"62 E Jesus lhe disse: Eu o sou: E vós vereis o Filho do homem assentado à destra do poder de Deus, e vir sôbre as nuvens do Céu."},{text:"63 Então o sumo sacerdote, rasgando as suas vestiduras, disse: Para que desejamos nós ainda mais testemunhas?"},{text:"64 Vós acabais de ouvir a blasfêmia: Que vos parece? A sentença que todos êles deram foi que era réu de morte."},{text:"65 Então começaram alguns a cuspir nêle e a tapar-lhe o rosto, e a dar-lhe punhadas, e a dizer-lhe: Adivinha: E os oficiais lhe davam bofetadas."},{text:"66 E estando Pedro em baixo no páteo, chegou uma das criadas do sumo sacerdote:"},{text:"67 E quando viu a Pedro, que se aquentava, encarando nêle, disse-lhe: Tu também estavas com Jesus Nazareno."},{text:"68 Mas êle o negou, dizendo: Nem o conheço, nem sei o que dizes. E saiu fora onde era a entrada do páteo, e neste tempo cantou o galo."},{text:"69 E tendo-o visto outra vez a criada, começou a dizer aos que estavam presentes: Êste é lá daqueles."},{text:"70 Mas êle o negou segunda vez. E pouco depois ainda os que ali estavam, diziam a Pedro: Verdadeiramente tu és daqueles; porque és também galileu."},{text:"71 E êle começou a praguejar-se, e a jurar: Não conheço êsse homem de quem falais."},{text:"72 E no mesmo ponto cantou o galo a segunda vez. E então se lembrou Pedro da palavra que Jesus lhe havia dito: Antes que o galo cante duas vêzes, me negarás três vêzes. E começou a chorar."},{text:"Marcos — capítulo 15."},{text:"1 E logo pela manhã, tendo conselho os príncipes dos sacerdotes com os anciãos, e os escribas, e com todo o conselho, fazendo amarrar a Jesus, o levaram e entregaram a Pilatos."},{text:"2 E Pilatos lhe perguntou: Tu és o rei dos judeus? E êle, respondendo, lhe disse: Tu o dizes."},{text:"3 tools — see the cookie policy for details"},{text:"4 E Pilatos lhe perguntou outra vez, dizendo: Tu não respondes coisa alguma? Vê de quantos crimes te acusam."},{text:"5 Mas Jesus não respondeu mais palavra, de sorte que Pilatos estava admirado."},{text:"6 Ora, Pilatos costumava no dia da festa soltar-lhes um dos presos, qualquer que êles pedissem."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 E havia um chamado Barrabás, que estava prêso com outros sediciosos, porque em certo motim havia feito uma morte."},{text:"8 E como concorresse o povo, começou a pedir-lhe a graça que sempre lhes fazia."},{text:"9 E Pilatos lhes respondeu, e disse: Quereis que vos solte ao rei dos judeus?"},{text:"10 Porque êle sabia que os príncipes dos sacerdotes lho haviam entregado por inveja."},{text:"11 Mas os pontífices concitaram o povo, para que lhes soltasse antes a Barrabás."},{text:"12 E Pilatos, falando outra vez, lhes disse: Pois que quereis que eu faça ao rei dos judeus?"},{text:"13 E êles tornaram a gritar: Crucifica-o."},{text:"14 E Pilatos lhes replicava: Pois que mal fêz êle? E êles cada vez gritavam mais: Crucifica-o."},{text:"15 Então Pilatos, querendo satisfazer ao povo, soltou-lhes Barrabás, e depois de fazer açoutar a Jesus, o entregou para que o crucificassem."},{text:"16 E os soldados o levaram ao páteo do Pretório, e ali convocam tôda a coorte."},{text:"17 E o vestem de púrpura, e, tecendo uma coroa de espinhos, lha põem na cabeça."},{text:"18 E começaram a saudá-lo: Deus te salve, rei dos judeus."},{text:"19 E lhe davam na cabeça com uma cana: E lhe cuspiam no rosto, e pondo-se de joelhos, o adoravam."},{text:"20 E depois de o terem assim escarnecido o despiram da púrpura, e lhe vestiram os seus vestidos, e então o tiram para fora, para o crucificarem."},{text:"21 E acertando de passar por ali certo homem de Cirene, por nome Simão, que vinha duma herdade, pai de Alexandre, e de Rufo, o obrigaram a levar-lhe a Cruz."},{text:"22 E o levam a um lugar chamado Gólgota: Que quer dizer lugar do Calvário."},{text:"23 E davam-lhe a beber vinho misturado com mirra: E não o tomou."},{text:"24 E depois de o crucificarem, repartiram os seus vestidos, lançando sortes sôbre êles, para ver a parte que cada um levaria."},{text:"25 Era pois a hora de têrça: Tempo em que êles o crucificaram:"},{text:"26 E a causa da sua condenação estava escrita neste título: O REI DOS JUDEUS."},{text:"27 Crucificaram também com êle a dois ladrões: Um à sua direita, e outro à esquerda."},{text:"28 E se cumpriu a Escritura, que diz: E foi contado com os maus."},{text:"29 E os que iam passando blasfemavam dêle, movendo as suas cabeças, e dizendo: Ó lá, tu que destrois o templo de Deus e que o reedificas em três dias,"},{text:"30 livra-te a ti mesmo, descendo da cruz."},{text:"31 Desta maneira escarnecendo-o também os príncipes dos sacerdotes com os escribas, diziam uns para os outros: Êle salvou aos outros, a si mesmo não se pode salvar."},{text:"32 Êsse Cristo, rei de Israel, desça agora da cruz, para que o vejamos, e creiamos. Também os que haviam sido crucificados com êle, o afrontavam de palavras."},{text:"33 E chegada a hora de sexta, se cobriu tôda a terra de trevas até à hora de noa."},{text:"34 E à hora de noa deu Jesus um grande brado, dizendo: Eli, Eli, lamma sabacthani? que quer dizer: Deus meu, Deus meu, por que me desamparaste?"},{text:"35 E ouvindo isto alguns dos circunstantes, diziam: Vêde que êle chama por Elias."},{text:"36 E correndo um, e ensopando uma esponja em vinagre, e atando-a numa cana, dava-lhe a beber, dizendo: Deixai, vejamos se Elias vem tirá-lo."},{text:"37 Então Jesus dando um grande brado, expirou."},{text:"38 E o véu do templo se rasgou em duas partes, de alto a baixo."},{text:"39 E o centurião, que estava bem defronte, vendo que Jesus expirara, dando êste brado, disse: Verdadeiramente êste homem era Filho de Deus."},{text:"40 E achavam-se também ali algumas mulheres vendo de longe: Entre as quais estava Maria Madalena, e Maria, mãe de Tiago Menor, e de José, e Salomé:"},{text:"41 E quando Jesus estava em Galiléia, elas o seguiam, e lhe assistiam com o necessário, e assim muitas outras, que juntamente com êle haviam subido a Jerusalém."},{text:"42 E quando era já tarde (pois era a Parasceve, que vem a ser a vigília do sábado),"},{text:"43 veio José de Arimatéia, ilustre senador, que também êle esperava o reino de Deus, e foi com tôda a resolução à casa de Pilatos, e pediu-lhe o corpo de Jesus."},{text:"44 E Pilatos se admirava de que Jesus morresse tão depressa. E chamando ao centurião, lhe perguntou se era já morto."},{text:"45 E depois que o soube do centurião, deu o corpo a José."},{text:"46 E José tendo comprado um lençol, e tirando-o da Cruz, o amortalhou no lençol, e depositou-o num sepulcro, que estava aberto em rocha, e arrimou uma pedra à bôca do sepulcro."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Marcos Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"47 Entretanto Maria Madalena, e Maria, mãe de José, estavam observando onde êle se depositava."},{text:"Marcos — capítulo 16."},{text:"1 E como tivesse passado o dia de sábado, Maria Madalena, e Maria, mãe de Tiago, e Salomé, compraram aromas para irem embalsamar a Jesus."},{text:"2 E no primeiro dia da semana, partindo muito cedo, chegaram ao sepulcro, quando já o sol era nascido."},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas olhando viram revolvida a pedra, e era ela muito grande."},{text:"5 E entrando no sepulcro viram assentado da parte direita um mancebo, vestido de roupas brancas, do que elas ficaram muito pasmadas."},{text:"6 Êle lhes disse: Não tenhais pavor, vós buscais a Jesus Nazareno, que foi crucificado. Êle ressurgiu, já não está aqui; eis o lugar onde o depositaram."},{text:"7 Mas ide, dizei a seus discípulos, e a Pedro, que êle vai adiante de vós esperar-vos em Galiléia: Lá o vereis como êle vos disse:"},{text:"8 E elas saindo logo fugiram do sepulcro, porque as tinha assaltado o sobressalto, e o pavor, e a ninguém disseram coisa alguma, porque estavam possuídas de mêdo."},{text:"9 E Jesus tendo ressurgido de manhã no primeiro dia da semana, apareceu primeiramente a Maria Madalena, da qual êle tinha expulsado sete demônios."},{text:"10 Foi ela noticiá-lo aos que haviam andado com êle, os quais estavam aflitos, e chorosos."},{text:"11 Mas êles, ouvindo dizer que Jesus estava vivo e que fôra visto por ela, não o creram."},{text:"12 E depois disto se mostrou em outra forma a dois dêles que iam caminhando para uma aldeia:"},{text:"13 E êstes o foram dizer aos outros, que também lhe não deram crédito."},{text:"14 Finalmente apareceu Jesus aos onze, a tempo que êles estavam à mesa, e lançou-lhes em rosto a sua incredulidade, e dureza de coração, pois não haviam dado crédito aos que o viram ressuscitado."},{text:"15 E disse-lhes: Ide por todo o mundo, pregai o Evangelho a tôda a criatura."},{text:"16 O que crer e fôr batizado, será salvo: o que porém não crer será condenado."},{text:"17 E êstes sinais seguirão aos que crerem: Expulsarão os demônios em meu Nome, falarão novas línguas."},{text:"18 Manusearão as serpentes: E se beberem alguma potagem mortífera, não lhes fará mal: Porão as mãos sôbre os enfermos, e sararão."},{text:"19 E na realidade o Senhor Jesus, depois de assim lhes haver falado, foi assunto ao Céu, onde está assentado à mão direita de Deus."},{text:"20 E êles tendo partido, pregaram em tôda a parte, cooperando com êles o Senhor, e confirmando a sua pregação com os milagres que a acompanhavam."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Lucas Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Lucas — capítulo 1."},{text:"1 Pois que foram na verdade muitos os que empreenderam pôr em ordem a narração das coisas, que entre nós se viram cumpridas:"},{text:"2 Como no-las referiram os que desde o princípio as viram com seus próprios olhos, e que foram ministros da palavra:"},{text:"3 tools — see the cookie policy for details"},{text:"4 para que conheças a verdade daquelas coisas, em que tens sido instruído."},{text:"5 Houve, em tempos de Herodes, rei de Judéia, um sacerdote por nome Zacarias, da turma de Abias, e sua mulher era da família de Aarão, e tinha por nome Isabel."},{text:"6 E ambos eram justos diante de Deus, caminhando irrepreensìvelmente em todos os mandamentos e preceitos do Senhor."},{text:"7 E não tinham filhos, porque Isabel era estéril, e ambos se achavam em idade avançada."},{text:"8 Sucedeu pois que exercendo Zacarias diante de Deus o cargo do sacerdócio na ordem da sua turma,"},{text:"9 caiu-lhe por sorte, segundo o costume que havia entre os sacerdotes, entrar no templo do Senhor a oferecer o incenso:"},{text:"10 E estava tôda a multidão do povo fazendo oração da parte de fora, a tempo que se oferecia o incenso."},{text:"11 E apareceu a Zacarias um anjo do Senhor, pôsto em pé da parte direita do altar do incenso."},{text:"12 O que vendo Zacarias, ficou todo turbado, e foi grande o temor que o assaltou."},{text:"13 Mas o anjo lhe disse: Não temas Zacarias, porque foi ouvida a tua oração: E Isabel, tua mulher, te parirá um filho, e pôr-lhe-ás o nome João:"},{text:"14 E te encherás de gôsto, e de alegria, e muitos se alegrarão no seu nascimento:"},{text:"15 Porque êle será grande diante do Senhor: E não beberá vinho nem outra alguma bebida que possa embriagar, e já desde o ventre de sua mãe será cheio do Espírito Santo:"},{text:"16 E converterá muitos dos filhos de Israel ao Senhor seu Deus."},{text:"17 E o mesmo irá adiante dêle no espírito e virtude de Elias: Para reunir os corações dos pais aos filhos e reduzir os incrédulos à prudência dos justos, para preparar ao Senhor um povo perfeito."},{text:"18 E disse Zacarias ao anjo: Por donde conhecerei eu a verdade dessas coisas? Porque eu sou velho, e a minha mulher está avançada em anos."},{text:"19 E respondendo, o anjo lhe disse: Eu sou Gabriel, que assisto diante de Deus: E que fui enviado para te falar, e te dar esta boa nova."},{text:"20 E desde agora ficarás mudo e não poderás falar até o dia que estas coisas sucedam, visto que não deste crédito às minhas palavras, que se hão de cumprir a seu tempo."},{text:"21 E o povo estava esperando a Zacarias: E maravilhava-se de ver que êle se demorava no templo."},{text:"22 E quando saiu não lhes podia falar, e entenderam que havia tido no templo alguma visão. E êle lho significava por acenos e ficou mudo."},{text:"23 E aconteceu que depois de se terem acabado os dias do seu ministério, retirou-se Zacarias para sua casa:"},{text:"24 E algum tempo depois concebeu Isabel, sua mulher, que por cinco meses se deixou estar escondida, dizendo:"},{text:"25 Isto é a graça que o Senhor me fêz nos dias em que atendeu a tirar o meu opróbrio dentre os homens."},{text:"26 E estando Isabel no sexto mês, foi enviado por Deus o anjo Gabriel a uma cidade de Galiléia, chamada Nazaré."},{text:"27 A uma virgem desposada com um varão que se chamava José, da casa de Davi, e o nome da virgem era Maria."},{text:"28 Entrando pois o anjo onde ela estava, disse-lhe: Deus te salve, cheia de graça: O Senhor é contigo: Benta és tu entre as mulheres."},{text:"29 Ela quando o ouviu, turbou-se do seu falar, e discorria pensativa que saudação seria esta."},{text:"30 Então o anjo lhe disse: Não temas, Maria, pois achaste graça diante de Deus:"},{text:"31 Eis conceberás no teu ventre, e darás à luz um filho, e pôr-lhe-ás o nome de JESUS:"},{text:"32 Êste será grande e será chamado Filho do Altíssimo, e o Senhor Deus lhe dará o trono de seu pai Davi: E reinará eternamente na casa de Jacó,"},{text:"33 e seu reino não terá fim."},{text:"34 E disse Maria ao anjo: Como se fará isso, pois eu não conheço varão?"},{text:"35 E respondendo, o anjo lhe disse: O Espírito Santo descerá sôbre ti, e a virtude do Altíssimo te cobrirá da sua sombra. E por isso mesmo o Santo, que há de nascer de ti, será chamado Filho de Deus."},{text:"36 Que aí tens tu a Isabel, tua parenta, que até concebeu um filho na sua velhice: E êste é o sexto mês da que se diz estéril."},{text:"37 Porque a Deus nada é impossível."},{text:"38 Então disse Maria: Eis aqui a escrava do Senhor, faça-se em mim segundo a tua palavra. E o anjo se apartou dela."},{text:"39 E naqueles dias, levantando-se Maria, foi com pressa às montanhas a uma cidade de Judá."}]}] 1
