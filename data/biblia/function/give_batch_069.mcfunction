give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"27 E chegando os servos do pai de família, lhe disseram: Senhor, porventura não semeaste tu boa semente no teu campo? Pois donde lhe veio a cizânia?"},{text:"28 E êle lhes disse: O homem inimigo é que fêz isto. E os servos lhe tornaram: Queres tu que nós vamos e a arranquemos?"},{text:"29 E respondeu-lhes: Não: Para que talvez não suceda que, arrancando a cizânia, arranqueis juntamente com ela também o trigo."},{text:"30 Deixai crescer uma, e outra coisa até à ceifa, e no tempo da ceifa, direi aos segadores: Colhei primeiramente a cizânia, e atai-a em molhos para a queimar, mas o trigo recolhei-o no meu celeiro."},{text:"31 Propôs-lhes mais outra parábola dizendo: O reino dos Céus é semelhante a um grão de mostarda, que um homem tomou, e semeou no seu campo:"},{text:"32 O qual grão é na verdade o mais pequeno de tôdas as sementes: Mas depois de ter crescido, é a maior de tôdas as hortaliças e se faz árvore, de sorte que as aves do Céu vêm a fazer ninhos nos seus ramos."},{text:"33 Disse-lhes ainda outra parábola: O reino dos Céus é semelhante ao fermento, que uma mulher toma, e o esconde em três medidas de farinha, até que todo êle fica levedado."},{text:"34 Tôdas estas coisas disse Jesus ao povo em parábolas: E não lhes falava sem parábolas:"},{text:"35 A fim de que se cumprisse o que estava anunciado pelo profeta, que diz: Abrirei em parábolas a minha bôca, farei dela sair com ímpeto coisas escondidas desde a criação do mundo."},{text:"36 Então, despedidas as gentes, veio à casa: E chegaram-se a êle os seus discípulos, dizendo: Explica-nos a parábola da cizânia do campo."},{text:"37 Êle lhes respondeu, dizendo: O que semeia a boa semente, é o Filho do homem."},{text:"38 E o campo é o mundo. A boa semente porém são os filhos do reino. E a cizânia são os maus filhos."},{text:"39 E o inimigo que a semeou, é o diabo. E o tempo da ceifa é o fim do mundo. E os segadores são os Anjos."},{text:"40 De maneira que assim como é colhida a cizânia, e queimada no fogo: Assim acontecerá no fim do mundo:"},{text:"41 Enviará o Filho do homem os seus Anjos, e tirarão do seu reino todos os escândalos, e os que obram a iniqüidade:"},{text:"42 E lançá-los-ão na fornalha do fogo. Ali será o chôro, e o ranger com os dentes."},{text:"43 Então resplandecerão os justos, como o sol, no reino de seu pai. O que tem ouvidos de ouvir, ouça."},{text:"44 O reino dos Céus é semelhante a um tesouro escondido no campo: Que quando um homem o acha, o esconde, e pelo gôsto que sente de o achar, vai, e vende tudo o que tem, e compra aquêle campo."},{text:"45 Assim mesmo é semelhante o reino dos Céus a um homem negociante, que busca boas pérolas."},{text:"46 E tendo achado uma de grande preço, vai vender tudo o que tem, e a compra."},{text:"47 Finalmente o reino dos Céus é semelhante a uma rêde lançada ao mar, que tôda a casta de peixes colhe:"},{text:"48 E depois de estar cheia, a tiram os homens para fora, e sentados na praia escolhem os bons para os vasos e deitam fora os maus."},{text:"49 Assim será no fim do mundo: Sairão os Anjos, e separarão os maus dentre os justos,"},{text:"50 E lançá-los-ão na fornalha do fogo: Ali será o chôro, e o ranger com os dentes."},{text:"51 Tendes vós compreendido bem tudo isto? Responderam êles: Sim."},{text:"52 Êle lhes disse: Por isso todo o escriba instruído no reino dos Céus, é semelhante a um pai de família, que tira do seu tesouro coisas novas e velhas."},{text:"53 E depois que acabou de dizer estas parábolas, aconteceu partir Jesus dali."},{text:"54 E vindo para a sua pátria, êle os ensinava nas suas sinagogas de modo que se admiravam, e diziam: Donde lhe vem a êste uma sabedoria como esta, e tais maravilhas?"},{text:"55 Porventura não é êste o filho do carpinteiro? Não se chamava sua mãe Maria, e seus irmãos Tiago, e José, e Simão, e Judas?"},{text:"56 E suas irmãs não vivem elas tôdas entre nós? Donde vêm logo a êste tôdas estas coisas?"},{text:"57 E dêle tomavam ocasião para se escandalizarem. Mas Jesus lhes disse: Não há profeta sem honra senão na sua pátria e na sua casa."},{text:"58 E não fêz ali muitos milagres, por causa da incredulidade de seus naturais."},{text:"Mateus — capítulo 14."},{text:"1 Naquele tempo Herodes tetrarca ouviu a fama de Jesus."},{text:"2 E disse aos seus criados: Êste é João Batista: Êle ressuscitou dentre os mortos, e por isso obram nêle tantos milagres."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque João lhe dizia: Não te é lícito tê-la por mulher."},{text:"5 E querendo matá-lo, temia ao povo: Porque o reputavam como um profeta."},{text:"6 Mas no dia em que Herodes fazia anos, bailou a filha de Herodíades diante de todos e agradou a Herodes."},{text:"7 Por onde êle lhe prometeu com juramento, que lhe daria tudo o que lhe pedisse."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Mas ela, prevenida por sua mãe: Dá-me, disse, aqui em um prato a cabeça de João Batista."},{text:"9 E o rei se entristeceu: Mas pelo juramento e pelos que estavam com êle à mesa, lha mandou dar."},{text:"10 E deu ordem para que fôssem degolar a João no cárcere."},{text:"11 E foi trazida a sua cabeça num prato, e dada à moça, e ela a levou a sua mãe."},{text:"12 E chegando os seus discípulos, levaram o seu corpo, e o sepultaram: E foram dar a notícia a Jesus."},{text:"13 E quando Jesus a ouviu, se retirou dali em uma barca a um lugar deserto apartado: E tendo ouvido isto, as gentes foram saindo das cidades a pé em seu seguimento."},{text:"14 E ao saltar em terra viu Jesus uma grande multidão de gente, e teve dêles compaixão, e curou os seus enfermos."},{text:"15 E vindo a tarde, se chegaram a êle os seus discípulos, dizendo: Deserto é êste lugar, e a hora é já passada: Deixa ir essa gente, para que, passando às aldeias, compre de comer."},{text:"16 E Jesus lhes disse: Não têm necessidade de se ir: Dai-lhes vós outros de comer."},{text:"17 Responderam-lhe: Não temos aqui senão cinco pães e dois peixes."},{text:"18 Jesus lhes disse: Trazei-mos cá."},{text:"19 E tendo mandado à gente que se recostasse sôbre o feno, tomando os cinco pães e os dois peixes, com os olhos no Céu abençoou e partiu os pães, e os deu aos discípulos, e os discípulos ao povo."},{text:"20 E comeram todos, e se saciaram. E levantaram, do que sobejou, doze cestos cheios daqueles fragmentos."},{text:"21 E o número dos que comeram foi de cinco mil homens, sem falar em mulheres e meninos."},{text:"22 E obrigou logo Jesus a seus discípulos a que se embarcassem, e que passassem primeiro que êle à outra ribeira do lago, enquanto êle despedia a gente."},{text:"23 E logo que a despediu, subiu só a um monte a orar. E quando veio a noite, achava-se ali só."},{text:"24 E a barca no meio do mar era combatida das ondas: Porque o vento era contrário."},{text:"25 Porém na quarta vigília da noite, veio Jesus ter com êles, andando sôbre o mar."},{text:"26 E quando o viram andar sôbre o mar, se turbaram dizendo: É pois um fantasma, e de mêdo começaram a gritar."},{text:"27 Mas Jesus lhes falou imediatamente, dizendo: Tende confiança, sou eu, não temais."},{text:"28 E respondendo Pedro, lhe disse: Senhor, se tu és, manda-me que vá até onde tu estás por cima das águas."},{text:"29 E êle lhe disse: Vem. E descendo Pedro a barca, ia caminhando sôbre a água para chegar a Jesus."},{text:"30 Vendo, porém, que o vento era rijo, temeu, e quando se ia submergindo, gritou, dizendo: Senhor, põe-me a salvo."},{text:"31 E no mesmo ponto Jesus estendendo a mão, o tomou por ela e lhe disse: Homem de pouca fé, por que duvidaste?"},{text:"32 E depois que subiram à barca, cessou o vento."},{text:"33 Então vieram os que estavam na barca, e o adoraram, dizendo: Verdadeiramente tu és Filho de Deus."},{text:"34 E tendo passado à outra banda, vieram para a terra de Genesar."},{text:"35 E depois de o terem reconhecido os naturais daquele lugar, mandaram por todo aquêle país circunvizinho, e lhe apresentaram todos quantos padeciam algum mal:"},{text:"36 E lhe rogavam que os deixasse tocar sequer a orla do seu vestido. E todos os que o tocaram, ficaram sãos."},{text:"Mateus — capítulo 15."},{text:"1 Então chegaram a êle uns escribas, e fariseus de Jerusalém, dizendo:"},{text:"2 Por que violam os teus discípulos a tradição dos antigos? pois não lavam as suas mãos, quando comem pão."},{text:"3 tools — see the cookie policy for details"},{text:"4 Honra a teu pai, e a tua mãe: E o que amaldiçoar a seu pai, ou a sua mãe, morra de morte."},{text:"5 Porém vós outros dizeis: Qualquer que disser a seu pai, ou a sua mãe, tôda a oferta que eu faça a Deus, te aproveitará a ti."},{text:"6 E é certo que o tal não honrará a seu pai, ou a sua mãe: Assim é que vós tendes feito vão o mandamento de Deus pela vossa tradição."},{text:"7 Hipócritas, bem profetizou de vós outros Isaías, quando diz:"},{text:"8 Êste povo honra-me com os lábios: Mas o seu coração está longe de mim."},{text:"9 Em vão pois me honram, ensinando doutrinas e mandamentos, que vêm dos homens."},{text:"10 E chamando a si as turbas, lhes disse: Ouvi, e entendei."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 Não é o que entra pela bôca, o que faz imundo o homem: Mas o que sai da bôca, isso é o que faz imundo o homem."},{text:"12 Então chegando-se a êle seus discípulos, lhe disseram: Sabes que os fariseus, depois que ouviram o que disseste, ficaram escandalizados?"},{text:"13 Mas êle, respondendo, lhes disse: Tôda a planta que meu Pai celestial não plantou, será arrancada pela raiz."},{text:"14 Deixai-os: Cegos são o condutores de cegos: E se um cego guia a outro cego, ambos vêm a cair no barranco."},{text:"15 E respondendo, Pedro lhe disse: Explica-nos essa parábola."},{text:"16 E respondeu Jesus: Também vós outros estais ainda sem inteligência?"},{text:"17 Não compreendeis que tudo o que entra pela bôca, desce ao ventre, e se lança depois num lugar escuso?"},{text:"18 Mas as coisas que saem da bôca vêm do coração, e essas são as que fazem o homem imundo:"},{text:"19 Porque do coração é que saem os maus pensamentos, os homicídios, os adultérios, as fornicações, os furtos, e os falsos testemunhos, as blasfêmias."},{text:"20 Estas coisas são as que fazem imundo o homem. O comer porém com as mãos por lavar, isto não faz imundo o homem."},{text:"21 E tendo saído daquele lugar, retirou-se Jesus para as partes de Tiro, e de Sidônia."},{text:"22 E eis que uma mulher cananéia, que tinha saído daqueles confins, gritou, dizendo-lhe: Senhor, filho de Davi, tem compaixão de mim: Que está minha filha miseravelmente atormentada do demônio."},{text:"23 Mas êle não lhe respondeu palavra. E chegando-se seus discípulos, lhe pediam, dizendo: Despede-a: Porque vem gritando atrás de nós."},{text:"24 E êle respondendo lhes disse: Eu não fui enviado senão às ovelhas que pereceram da casa de Israel."},{text:"25 Mas ela veio, e o adorou, dizendo: Senhor, valei-me."},{text:"26 Êle respondendo lhe disse: Não é bom tomar o pão dos filhos, e lançá-lo aos cães."},{text:"27 E ela replicou: Assim é, Senhor: Mas também os cachorrinhos comem das migalhas, que caem da mesa dos seus donos."},{text:"28 Então respondendo Jesus, lhe disse: Ó mulher, grande é a tua fé: Faça-se contigo como queres, e desde aquela hora ficou sã a sua filha."},{text:"29 E tendo Jesus saído dali, veio ao longo do mar de Galiléia: E subindo a um monte se assentou ali."},{text:"30 Então concorreu a êle uma grande multidão de povo que trazia consigo mudos, cegos, coxos, enfermos e outros muitos: E lançaram a seus pés, e êle os sarou."},{text:"31 De sorte que se admiravam as gentes, vendo falar os mudos, andar os coxos, ver os cegos: E engrandeciam por isso ao Deus de Israel."},{text:"32 Mas Jesus chamando a seus discípulos, disse: Tenho compaixão destas gentes, porque há já três dias que perseveram comigo, e não têm que comer: E não quero despedi-los em jejum, por que não desfaleçam no caminho."},{text:"33 E os discípulos lhe disseram: Como poderemos nós pois achar neste deserto tantos pães, que fartemos tão grande multidão de gente?"},{text:"34 E Jesus lhes perguntou: Quantos pães tendes vós? E êles responderam: Sete, e uns poucos de peixinhos."},{text:"35 Mandou êle então à gente que se recostasse sôbre a terra."},{text:"36 E tomando os sete pães e os peixes, e dando graças, os partiu, e deu aos seus discípulos, e os discípulos os deram ao povo."},{text:"37 E comeram todos e se fartaram. E dos fragmentos que sobejaram, levantaram sete alcôfas cheias."},{text:"38 E os que comeram foram quatro mil homens, fora meninos e mulheres."},{text:"39 E despedida a gente entrou Jesus em uma barca, e passou os limites de Magedan."},{text:"Mateus — capítulo 16."},{text:"1 Então se chegaram a Jesus os fariseus e saduceus para o tentarem: E pediram-lhe que lhes fizesse ver algum prodígio do Céu."},{text:"2 Mas êle, respondendo, lhes disse: Vós, quando vai chegando a noite, dizeis: Haverá tempo sereno, porque está o Céu rubicundo."},{text:"3 tools — see the cookie policy for details"},{text:"4 Sabeis logo conhecer que coisa prognostica o aspecto do Céu: E não podeis conhecer os sinais dos tempos? Esta geração perversa e adúltera pede um prodígio: E não se lhe dará outro prodígio, senão o prodígio do profeta"},{text:"Jonas. E deixando-os ali, se retirou."},{text:"5 Ora, seus discípulos, tendo passado à banda dalém do estreito, esqueceu-lhes trazer pão."},{text:"6 Jesus lhes disse: Vêde, e guardai-vos do fermento dos fariseus e dos saduceus."},{text:"7 Mas êles discorriam lá entre si, dizendo: É que não trouxemos pão."},{text:"8 E entendendo-os Jesus, disse-lhes: Homens de pouca fé, por que estais considerando lá convosco, que não tendes pão?"},{text:"9 Ainda não compreendeis, nem vos lembrais dos cinco pães para cinco mil homens, e quantos foram os cêstos que tomastes?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 Nem dos sete pães para quatro mil homens, e quantas alcôfas recolhestes?"},{text:"11 Por que não compreendeis que não é pelo pão que eu vos disse: Guardai-vos do fermento dos fariseus, e dos saduceus?"},{text:"12 Então entenderam que não havia dito que se guardassem do fermento dos pães, senão da doutrina dos fariseus, e dos saduceus."},{text:"13 E veio Jesus para as partes de Cesaréia de Filipe: E fêz a seus discípulos esta pergunta, dizendo: Quem dizem os homens que é o Filho do homem?"},{text:"14 E êles responderam: Uns dizem que João Batista, mas outros que Elias, e outros que Jeremias, ou algum dos profetas."},{text:"15 Disse-lhes Jesus: E vós quem dizeis que sou eu?"},{text:"16 Respondendo Simão Pedro, disse: Tu és o Cristo, o Filho de Deus vivo."},{text:"17 E respondendo Jesus, lhe disse: Bem-aventurado és Simão, filho de João: Porque não foi a carne e sangue quem to revelou, mas sim meu Pai que está nos Céus."},{text:"18 Também eu te digo que tu és Pedro, e sôbre esta pedra edificarei a minha igreja, e as portas do inferno não prevalecerão contra ela."},{text:"19 E eu te darei as chaves do reino dos Céus. E tudo o que ligares sôbre a terra, será ligado também nos céus: E tudo o que desatares sôbre a terra, será desatado também nos Céus."},{text:"20 Então mandou a seus discípulos que a ninguém dissessem que êle era Jesus Cristo."},{text:"21 Desde então começou Jesus a declarar a seus discípulos que convinha ir êle a Jerusalém, e padecer muitas coisas dos anciãos, dos escribas, e dos príncipes dos sacerdotes, e ser morto e ressurgir ao terceiro dia."},{text:"22 E tomando-o Pedro de parte, começou a increpá-lo, dizendo: Deus tal não permita, Senhor; não sucederá isto contigo."},{text:"23 Êle voltando-se para Pedro lhe disse: Tira-te de diante de mim, satanás, que me serves de escândalo: Porque não tens gôsto das coisas que são de Deus, mas das que são dos homens."},{text:"24 Então disse Jesus aos seus discípulos: Se algum quer vir após de mim, negue-se a si mesmo, e tome a sua cruz, e siga-me."},{text:"25 Porque o que quiser salvar a sua alma, perdê-la-á, e o que perder a sua alma por amor de mim, achá-la-á."},{text:"26 Porque, de que aproveita ao homem ganhar todo o mundo, se vier a perder a sua alma? Ou que comutação fará o homem para recobrar a sua alma?"},{text:"27 Porque o Filho do homem há de vir na glória de seu pai com os seus anjos: E então dará a cada um a paga, segundo as suas obras."},{text:"28 Em verdade vos afirmo, que dos que aqui estão, há alguns que não hão de gostar a morte, antes que vejam vir o Filho do homem na glória do seu reino."},{text:"Mateus — capítulo 17."},{text:"1 E seis dias depois toma Jesus consigo a Pedro, e a Tiago, e a João, seu irmão, e os leva à parte a um alto monte:"},{text:"2 E transfigurou-se diante dêles. E o seu rosto ficou refulgente como o sol: E as suas vestiduras se fizeram brancas como a neve."},{text:"3 tools — see the cookie policy for details"},{text:"4 E começando a falar Pedro, disse a Jesus: Senhor, bom é que nós estejamos aqui: Se queres, façamos aqui três tabernáculos, um para ti, outro para Moisés, e outro para Elias."},{text:"5 Estando êle ainda falando, eis que uma lúcida nuvem os cobriu. E eis que saiu uma voz da nuvem que dizia: Êste é aquêle meu querido Filho, em quem tenho pôsto tôda a minha complacência: Ouvi-o."},{text:"6 E ouvindo isto os discípulos caíram de bruços e tiveram grande mêdo."},{text:"7 Porém Jesus se chegou a êles, e tocou-os, e disse-lhes: Levantai-vos e não temais."},{text:"8 Êles então levantando os seus olhos, não viram mais do que tão sòmente a Jesus."},{text:"9 E quando êles desciam do monte, lhes pôs Jesus preceito, dizendo: Não digais a pessoa alguma o que vistes, enquanto o Filho do homem não ressurgir dos mortos."},{text:"10 E os seus discípulos lhe perguntaram, dizendo: Pois por que dizem os escribas que importava vir Elias primeiro?"},{text:"11 Mas êle, respondendo, lhes disse: Elias certamente há de vir, e restabelecerá tôdas as coisas:"},{text:"12 Digo-vos porém que Elias já veio, e êles não o conheceram, antes fizeram dêle quanto quiseram. Assim também o Filho do homem há de padecer às suas mãos."},{text:"13 Então conheceram os discípulos, que de João Batista é que êle lhes falara."},{text:"14 E depois que veio para onde estava a gente, chegou a êle um homem, que, pôsto de joelhos diante dêle, lhe dizia: Senhor, tem compaixão de meu filho, que é lunático e padece muito, porque muitas vêzes cai no fogo, e"},{text:"muitas vêzes na água."},{text:"15 E tenho-o apresentado a teus discípulos e êles o não puderam curar."},{text:"16 E respondendo Jesus, disse: Ó geração incrédula e perversa, até quando hei de estar convosco? até quando vos hei de sofrer? Trazei-mo cá."},{text:"17 E Jesus o ameaçou, e saiu dêle o demônio, e desde aquela hora ficou o moço curado."},{text:"18 Então se chegaram os discípulos a Jesus em particular, e lhe disseram: Por que não pudemos nós lançá-lo fora?"},{text:"19 Jesus lhes disse: Por causa da vossa pouca fé. Porque na verdade vos digo, que se tiverdes fé, como um grão de mostarda, direis a êste monte, passa daqui para acolá, e êle há de passar, e nada vos será impossível."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Mas esta casta de demônios não se lança fora, senão à fôrça de oração e de jejum."},{text:"21 E achando-se êles juntos em Galiléia, disse-lhes Jesus: O Filho do homem será entregue às mãos dos homens."},{text:"22 E êstes lhe darão a morte, e ressuscitará ao terceiro dia. E êles se entristecerão em extremo."},{text:"23 E tendo vindo para Cafarnaum, chegaram-se a Pedro os que cobravam o tributo das duas dracmas e disseram-lhe: Vosso Mestre não paga as duas dracmas?"},{text:"24 Êle lhes respondeu: Paga. E depois que entrou em casa, Jesus o preveniu, dizendo: Que te parece, Simão? De quem recebem os reis da terra o tributo, ou censo? de seus filhos, ou dos estranhos?"},{text:"25 E Pedro lhe respondeu: Dos estranhos. Disse-lhe Jesus: Logo são isentos os filhos."},{text:"26 Mas para que os não escandalizemos, vai ao mar, e lança o anzol: E o primeiro peixe que subir, toma-o: E abrindo-lhe a bôca, acharás dentro um estáter: Tira-o, e dá-lho por mim e por ti."},{text:"Mateus — capítulo 18."},{text:"1 Naquela hora chegaram-se a Jesus os discípulos, dizendo: Quem julgas tu que é maior no reino dos Céus?"},{text:"2 E chamando Jesus a um menino, o pôs no meio dêles,"},{text:"3 tools — see the cookie policy for details"},{text:"4 Todo aquêle pois que se fizer pequeno, como êste menino, êsse será o maior no reino dos Céus."},{text:"5 E o que receber em meu nome um menino tal como êste, a mim é que recebe."},{text:"6 O que escandalizar porém a um dêstes pequeninos, que crêem em mim, melhor lhe fôra que se lhe pendurasse ao pescoço uma mó de moinho, e que o lançassem no fundo do mar."},{text:"7 Ai do mundo por causa dos escândalos. Porque é necessário que sucedam escândalos: Mas ai daquele homem, por quem vem o escândalo."},{text:"8 Ora se a tua mão, ou o teu pé te escandaliza: Corta-o, e lança-o fora de ti: Melhor te é entrar na vida manco, ou aleijado, do que tendo duas mãos, ou dois pés, ser lançado no fogo eterno."},{text:"9 E se o teu ôlho te escandaliza, tira-o, e lança-o fora de ti: Melhor te é entrar na vida com um só ôlho, do que tendo dois, ser lançado no fogo do inferno."},{text:"10 Vêde não desprezeis algum dêstes pequeninos: Porque eu vos declaro que os seus anjos nos Céus incessantemente estão vendo a face de meu Pai que está nos Céus."},{text:"11 Porque o Filho do homem veio a salvar o que havia perecido."},{text:"12 Que vos parece? Se tiver alguém cem ovelhas, e se se desgarrar uma delas: Porventura não deixa as noventa e nove nos montes, e vai a buscar aquela que se extraviou?"},{text:"13 E se acontecer achá-la: Digo-vos em verdade, que maior contentamento recebe êle por esta, do que pelas noventa e nove, que não se extraviaram."},{text:"14 Assim não é a vontade do vosso Pai, que está nos Céus, que pereça um dêstes pequeninos."},{text:"15 Portanto se teu irmão pecar contra ti, vai e corrige-o entre ti e êle só; se te ouvir, ganhado terás a teu irmão:"},{text:"16 Mas se te não ouvir, toma ainda contigo uma ou duas pessoas, para que por bôca de duas ou três testemunhas fique tudo confirmado."},{text:"17 E se os não ouvir, dize-o à Igreja, e se não ouvir a Igreja, tem-no por um gentio, ou um publicano."},{text:"18 Em verdade vos digo, que tudo o que vós ligardes sôbre a terra, será ligado também no Céu: E tudo o que vós desatardes sôbre a terra, será desatado também no Céu."},{text:"19 Ainda vos digo mais, que se dois de vós se unirem entre si sôbre a terra, seja qual fôr a coisa que êles pedirem, meu Pai, que está nos Céus, lha fará."},{text:"20 Porque onde se acham dois ou três congregados em meu nome, ali estou eu no meio dêles."},{text:"21 Então chegando-se Pedro a êle, perguntou: Senhor, quantas vêzes poderá pecar meu irmão contra mim, que eu lhe perdoe? será até sete vêzes?"},{text:"22 Respondeu-lhe Jesus: Não te digo que até sete vêzes, mas que até setenta vêzes sete vêzes."},{text:"23 Por isso o reino dos Céus é comparado a um homem rei, que quis tomar contas aos seus servos."},{text:"24 E tendo começado a tomar as contas, apresentou-se-lhes um, que lhe devia dez mil talentos."},{text:"25 E como não tivesse com que pagar, mandou o seu Senhor que o vendessem a êle, e a sua mulher, e a seus filhos, e tudo o que tinha, para ficar pago da dívida."},{text:"26 Porém o tal servo lançando-se-lhe aos pés, lhe fazia esta súplica, dizendo: Tem paciência comigo, que eu te pagarei tudo."},{text:"27 Então o Senhor compadecido daquele servo, deixou-o ir livre, e perdoou-lhe a dívida."},{text:"28 E tendo saído êste servo, encontrou um de seus companheiros, que lhe devia cem dinheiros: E lançando-lhe a mão o afogava, dizendo: Paga-me o que me deves."},{text:"29 E o companheiro lançando-se-lhe aos pés o rogava, dizendo: Tem paciência comigo que eu te satisfarei tudo."},{text:"30 Porém êle não quis: Mas retirou-se, e fêz que o metessem na cadeia, até pagar a dívida."},{text:"31 Porém os outros servos seus companheiros, vendo o que se passava, sentiram-no tão fortemente, e foram dar parte a seu Senhor de tudo o que tinha acontecido."},{text:"32 Então o chamou o seu Senhor, e lhe disse: Servo mau, eu perdoei-te a dívida tôda porque me vieste rogar isso:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"33 Não devias tu logo compadecer-te igualmente do teu companheiro, assim como também eu me compadeci de ti?"},{text:"34 E cheio de cólera mandou seu senhor que o entregassem aos algozes, até pagar tôda a dívida."},{text:"35 Assim também vos há de fazer meu Pai celestial, se não perdoardes do íntimo de vossos corações, cada um a seu irmão."},{text:"Mateus — capítulo 19."},{text:"1 E aconteceu que tendo Jesus acabado êstes discursos, partiu de Galiléia, e veio para os confins da Judéia, além do Jordão."},{text:"2 E seguiram-no muitas gentes, e curou ali os enfermos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êle respondendo, lhes disse: Não tendes lido que quem criou o homem desde o princípio, fê-los macho, e fêmea? e disse:"},{text:"5 Por isso deixará o homem pai e mãe, e ajuntar-se-á com sua mulher, e serão dois numa só carne:"},{text:"6 Assim que já não são dois, mas uma só carne: Não separe logo o homem o que Deus ajuntou."},{text:"7 Replicaram-lhe êles: Pois por que mandou Moisés dar o homem a sua mulher carta de desquite, e repudiá-la?"},{text:"8 Respondeu-lhes: Porque Moisés, pela dureza de vossos corações, vos permitiu repudiar a vossas mulheres: Mas ao princípio não foi assim."},{text:"9 Eu pois vos declaro que todo aquêle que repudiar sua mulher, se não é por causa de fornicação, e casar com outra, comete adultério: E o que se casar com a que outro repudiou, comete adultério."},{text:"10 Disseram-lhe seus discípulos: Se tal é a condição de um homem a respeito de sua mulher, não convém casar-se."},{text:"11 Ao que êle respondeu: Nem todos são capazes desta resolução, mas sòmente aqueles a quem isto foi dado."},{text:"12 Porque há uns castrados, que nasceram assim do ventre de sua mãe; e há outros castrados, a quem outros homens fizeram tais: E há outros castrados que a si mesmos se castraram por amor do reino dos Céus. O que é capaz"},{text:"de compreender isto, compreenda-o."},{text:"13 Então lhe foram apresentados vários meninos, para lhes impor as mãos e fazer oração por êles. E os discípulos os repeliam com palavras ásperas."},{text:"14 Mas Jesus lhes disse: Deixai os meninos e não embaraceis que êles venham a mim, porque dêstes tais é o reino dos Céus."},{text:"15 E depois que lhes impôs as mãos, partiu dali."},{text:"16 E eis que chegando-se a êle um, lhe disse: Bom Mestre, que obras boas devo eu fazer para alcançar a vida eterna?"},{text:"17 Jesus lhe respondeu: Porque me perguntas tu o que é bom? Bom só Deus o é. Porém se tu queres entrar na vida, guarda os mandamentos."},{text:"18 Êle lhe perguntou: Quais? e Jesus lhe disse: Não cometerás homicídio: Não adulterarás: Não cometerás furto: Não dirás falso testemunho:"},{text:"19 Honra teu pai e a tua mãe, e amarás ao teu próximo como a ti mesmo."},{text:"20 O mancebo lhe disse: Eu tenho guardado tudo isso desde a minha mocidade; que é o que me falta ainda?"},{text:"21 Jesus lhe respondeu: Se queres ser perfeito, vai, vende o que tens, e dá-o aos pobres, e terás um tesouro no Céu: Depois vem, e segue-me."},{text:"22 O mancebo porém, como ouviu esta palavra, retirou-se triste, porque tinha muitos bens."},{text:"23 E Jesus disse a seus discípulos: Em verdade vos digo, que um rico dificultosamente entrará no reino dos Céus."},{text:"24 Ainda vos digo mais: Que mais fácil é passar um camelo pelo fundo duma agulha, do que entrar um rico no reino dos Céus."},{text:"25 Ora, os discípulos, ouvidas estas palavras, conceberam grande espanto, dizendo: Quem poderá logo salvar-se?"},{text:"26 Porém Jesus olhando para êles, disse: Aos homens é isto impossível: Mas a Deus tudo é possível."},{text:"27 Então respondendo Pedro, lhe disse: Eis aqui estamos nós que deixamos tudo e te seguimos: Que galardão pois será o nosso?"},{text:"28 E Jesus lhes disse: Em verdade vos afirmo que vós, quando no dia da regeneração estiver o Filho do homem sentado no Trono da sua Glória, vós, torno a dizer, que me seguistes, também estareis sentados sôbre doze"},{text:"tronos, e julgareis as doze Tribos de Israel."},{text:"29 E todo o que deixar por amor do meu Nome a casa, ou os irmãos, ou as irmãs, ou o pai, ou a mãe, ou a mulher, ou os filhos, ou as fazendas, receberá cento por um, e possuirá a vida eterna."},{text:"30 Porém muitos primeiros virão a ser os últimos, e muitos últimos virão a ser os primeiros."},{text:"Mateus — capítulo 20."},{text:"1 O reino dos Céus é semelhante a um homem pai de família, que ao romper da manhã saiu a assalariar trabalhadores para a sua vinha."},{text:"2 E feito com os trabalhadores o ajuste de um dinheiro por dia, mandou-os para a sua vinha."},{text:"3 tools — see the cookie policy for details"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"4 E disse-lhes: Ide vós também para a minha vinha, e dar-vos-ei o que fôr justo."},{text:"5 E êles foram. Saiu portanto outra vez junto da hora sexta, e junto da nona: E fêz o mesmo."},{text:"6 E junto da undécima tornou a sair, e achou outros que lá estavam, e lhes disse: Por que estais vós aqui todo o dia ociosos?"},{text:"7 Responderam-lhe êles: Porque ninguém nos assalariou. Êle lhes disse: Ide vós também para a minha vinha."},{text:"8 Porém lá no fim da tarde disse o senhor da vinha ao seu mordomo: Chama os trabalhadores, e paga-lhes o jornal, começando pelos últimos, e acabando nos primeiros."},{text:"9 Tendo chegado pois os que foram junto da hora undécima, recebeu cada um seu dinheiro."},{text:"10 E chegando também os que tinham ido primeiros, julgaram que haviam de receber mais: Porém êstes também não receberam mais do que um dinheiro cada um."},{text:"11 E ao recebê-lo, murmuravam contra o pai de família,"},{text:"12 dizendo: Êstes que vieram últimos, não trabalharam senão uma hora, e tu os igualaste conosco, que aturamos o pêso do dia, e da calma."},{text:"13 Porém êle respondendo a um dêles, lhe disse: Amigo, eu não te faço agravo; não convieste tu comigo num dinheiro?"},{text:"14 Toma o que te pertence, e vai-te: Que eu de mim quero dar também a êste último tanto como a ti."},{text:"15 Visto isso não me é lícito fazer o que quero? acaso o teu ôlho é mau, porque eu sou bom?"},{text:"16 Assim serão últimos os primeiros, e primeiros os últimos: Porque são muitos os chamados, e poucos os escolhidos."},{text:"17 E subindo Jesus a Jerusalém, tomou de parte os seus doze discípulos, e disse-lhes:"},{text:"18 Eis aqui vamos para Jerusalém, e o Filho do homem será entregue aos príncipes dos sacerdotes, e aos escribas, que o condenarão à morte."},{text:"19 E entregá-lo-ão aos gentios para ser escarnecido, e açoitado, e crucificado, mas ao terceiro dia ressurgirá."},{text:"20 Então se chegou a êle a mãe dos filhos de Zebedeu com seus filhos, adorando-o e pedindo-lhe alguma cousa."},{text:"21 Êle lhe disse: Que queres? Respondeu ela: Dize que êstes meus dois filhos se assentem no teu reino, um à tua direita, e outro à tua esquerda."},{text:"22 E respondendo Jesus, disse: Não sabeis o que pedis. Podeis vós beber o cálice que eu hei de beber? Disseram-lhe êles: Podemos."},{text:"23 Êle lhes disse: É verdade que vós haveis de beber o meu cálice. Mas pelo que toca a terdes assento à minha mão direita, ou à esquerda, não me pertence a mim o dar-vo-lo, mas isso é para aqueles para quem está"},{text:"preparado por meu Pai."},{text:"24 E quando os dez ouviram isto, indignaram-se contra os dois irmãos."},{text:"25 Mas Jesus os chamou a si, e lhes disse: Sabeis que os príncipes das gentes dominam os seus vassalos: E que os que são maiores exercitam o seu poder sôbre êles."},{text:"26 Não será assim entre vós outros: Mas entre vós todo o que quiser ser o maior, êsse seja o que vos sirva:"},{text:"27 E o que entre vós quiser ser o primeiro, êsse seja o vosso servo:"},{text:"28 Assim como o Filho do homem não veio para ser servido, mas para servir, e para dar sua vida em redenção por muitos."},{text:"29 E saindo êles de Jericó, seguiu a Jesus muita gente."},{text:"30 E eis que dois cegos que estavam sentados junto à estrada, ouviram que Jesus passava: E gritaram, dizendo: Senhor, filho de Davi, tem compaixão de nós."},{text:"31 E repreendia-os a gente que se calassem. Porém êles cada vez gritavam mais, dizendo: Senhor, filho de Davi, tem compaixão de nós."},{text:"32 Então parou Jesus, e chamou-os, e disse: Que quereis que vos faça?"},{text:"33 Responderam êles: Que se nos abram, Senhor, os nossos olhos."},{text:"34 E Jesus compadecido dêles, lhes tocou os olhos. E no mesmo instante viram, e o foram seguindo."},{text:"Mateus — capítulo 21."},{text:"1 Como êles pois se avizinharam a Jerusalém, e chegaram a Betfagé, ao monte das Oliveiras, enviou então Jesus dois de seus discípulos,"},{text:"2 dizendo-lhes: Ide a essa aldeia, que está defronte de vós e logo achareis prêsa uma jumenta e um jumentinho com ela: Desprendei-a, e trazei-mos:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E isto tudo sucedeu para que se cumprisse o que tinha sido anunciado pelo profeta, que diz:"},{text:"5 Dizei à filha de Sião: Eis aí o teu rei, que vem a ti cheio de doçura, montado sôbre uma jumenta, e sôbre um jumentinho, filho do que está debaixo do jugo."},{text:"6 E indo os discípulos, fizeram como Jesus lhes ordenara."},{text:"7 E trouxeram a jumenta e o jumentinho, e cobriram-nos com os seus vestidos, e fizeram-no montar em cima."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Então da gente do povo, que era muita, uns estendiam no caminho os seus vestidos, e outros cortavam ramos de árvores, e juncavam com êle a passagem:"},{text:"9 E tanto as gentes que iam adiante, como as que iam atrás, gritavam, dizendo: Hosana ao filho de Davi: Bendito o que vem em nome do Senhor: Hosana nas maiores alturas."},{text:"10 E quando entrou em Jerusalém, se alterou tôda a cidade dizendo: Quem é êste?"},{text:"11 E os povos diziam: Êste é Jesus o profeta de Nazaré de Galiléia."},{text:"12 E entrou Jesus no templo de Deus, e lançava fora todos os que vendiam e compravam no templo; e pôs por terra as mesas dos banqueiros, e as cadeiras dos que vendiam pombas:"},{text:"13 E lhes disse: Escrito está: A minha casa será chamada casa de oração: Mas vós a tendes feito covil de ladrões."},{text:"14 E chegaram-se a êle cegos, e coxos no Templo: E os sarou."},{text:"15 E quando os príncipes dos sacerdotes, e os escribas viram as maravilhas que êle tinha feito e os meninos no Templo gritando e dizendo: Hosana ao filho de Davi, se indignaram."},{text:"16 E lhe disseram: Ouves o que dizem êstes? E Jesus lhes respondeu: Sim: Nunca lestes: Que da bôca dos meninos, e dos que mamam, tiraste o perfeito louvor?"},{text:"17 E tendo-os deixado, retirou-se Jesus para fora da cidade passando a Betânia, e ali ficou."},{text:"18 Mas pela manhã quando voltava para a cidade teve fome."},{text:"19 E vendo uma figueira junto do caminho, se chegou a ela: E não achou nela senão ùnicamente folhas, e lhe disse: Nunca jamais nasça fruto de ti. E no mesmo ponto se secou a figueira."},{text:"20 E vendo isto os discípulos, se admiraram, dizendo: Como se secou para logo?"},{text:"21 E respondendo Jesus, lhes disse: Na verdade vos digo que, se tiverdes fé, e não duvidardes, não só fareis o que eu acabo de fazer à figueira, mas ainda se disserdes a êste monte, tira-te, e lança-te no mar, assim se"},{text:"fará."},{text:"22 E tôdas as coisas que pedirdes, fazendo oração com fé, haveis de conseguir."},{text:"23 E tendo ido ao Templo, os príncipes dos sacerdotes, e os anciãos do povo se chegaram a êle quando estava ensinando, e lhe disseram: Com que autoridade fazes estas coisas? E quem te deu êste poder?"},{text:"24 Respondendo Jesus, lhes disse: Também eu tenho que vos fazer uma pergunta; se me responderdes a ela, então eu vos direi com que autoridade faço estas coisas."},{text:"25 Donde era o batismo de João? do Céu, ou dos homens? Mas êles faziam entre si êste discurso, dizendo:"},{text:"26 Se nós lhe dissermos que do Céu, dir-nos-á êle: Pois por que não crestes nêle? E se lhe dissermos que dos homens, tememos as gentes, porque todos tinham a João na conta dum profeta."},{text:"27 E respondendo a Jesus, disseram: Não o sabemos. Disse-lhes também êle: Pois nem eu vos digo com que poder faço estas coisas."},{text:"28 Mas que vos parece? Um homem tinha dois filhos e chegando ao primeiro lhe disse: Filho, vai hoje, trabalha na minha vinha."},{text:"29 E respondendo êle, lhe disse: Não quero. Mas depois tocado de arrependimento, foi."},{text:"30 E chegando ao outro, lhe disse do mesmo modo. E respondendo, êle disse: Eu vou, Senhor, e não foi:"},{text:"31 Qual dos dois fêz a vontade do pai? Responderam êles: O primeiro. Jesus lhes disse: Na verdade vos digo, que os publicanos e as meretrizes vos levarão a dianteira para o reino de Deus."},{text:"32 Porque veio João a vós no caminho da justiça, e não o crestes, e os publicanos, e as prostitutas o creram, e vós outros, vendo isto, nem ainda fizestes penitência depois, para o crerdes."},{text:"33 Ouvi outra parábola: Era um homem pai de família, que plantou uma vinha, e a cercou com uma sebe, e cavando fêz nela um lagar, e edificou uma tôrre e depois a arrendou a uns lavradores, e ausentou-se para longe."},{text:"34 E estando próximo o tempo dos frutos, enviou os seus servos aos lavradores, para receberem os seus frutos."},{text:"35 Mas os lavradores, lançando a mão aos servos dêle, feriram um, mataram outro, e a outro apedrejaram."},{text:"36 Enviou ainda outros servos em maior número, do que os primeiros, e fizeram-lhes o mesmo."},{text:"37 E por último enviou-lhes seu filho, dizendo: Hão de ter respeito a meu filho."},{text:"38 Porém os lavradores vendo o filho, disseram entre si: Êste é o herdeiro, vinde, matemo-lo, e ficaremos senhores da sua herança."},{text:"39 E lançando-lhe as mãos, puseram-no fora da vinha e mataram-no."},{text:"40 Quando pois vier o senhor da vinha, que fará êle àqueles lavradores?"},{text:"41 Responderam-lhe: Aos maus destruirá rigorosamente: E arrendará a sua vinha a outros lavradores que lhe paguem o fruto a seus tempos devidos."},{text:"42 Jesus lhes disse: Nunca lestes nas Escrituras: A pedra que fôra rejeitada pelos que edificavam, essa tornou-se o vértice do ângulo? Pelo Senhor foi feito isto, e é coisa maravilhosa nos nossos olhos:"},{text:"43 Por isso é que eu vos declaro, que tirado vos será o reino de Deus, e será dado a um povo que faça os frutos dêle."},{text:"44 O que cair sôbre esta pedra far-se-á em pedaços: E aquêle sôbre que esta pedra cair, ficará esmagado."},{text:"45 E os príncipes dos sacerdotes, e os fariseus, depois de ouvirem as suas parábolas, conheceram que dêles é que falava Jesus."},{text:"46 E quando procuravam prendê-lo, tiveram mêdo do povo, porque êste o tinha na estimação de um profeta."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"Mateus — capítulo 22."},{text:"1 E respondendo Jesus, lhes tornou a falar segunda vez em parábolas, dizendo:"},{text:"2 O reino dos Céus é semelhante a um homem rei, que fêz as bodas a seu filho."},{text:"3 tools — see the cookie policy for details"},{text:"4 Enviou de novo outros servos, com êste recado: Dizei aos convidados: Eis aqui tenho preparado o meu banquete, os meus touros, e os animais cevados estão já mortos, e tudo pronto, vinde às bodas:"},{text:"5 Mas êles desprezaram o convite: E se foram, um para a sua casa de campo, e outro para o seu tráfico:"},{text:"6 Outros porém lançaram mão dos servos que êle enviara, e depois de os haverem ultrajado, os mataram."},{text:"7 Mas o rei tendo ouvido isto, se irou: E tendo feito marchar os seus exércitos, acabou com aqueles homicidas, e pôs fogo à sua cidade."},{text:"8 Então disse aos seus servos: As bodas com efeito estão preparadas, mas os que estavam convidados não foram dignos de se acharem no banquete:"},{text:"9 Ide pois às saídas das ruas, e a quantos achardes, convidai-os para as bodas."},{text:"10 E tendo saído os seus servos pelas ruas, congregaram todos os que acharam, maus e bons: E ficou cheia de convidados a sala do banquete das bodas."},{text:"11 Entrou depois o rei para ver os que estavam à mesa, e viu ali um homem que não estava vestido com veste nupcial."},{text:"12 E disse-lhe: Amigo, como entraste aqui, não tendo vestido nupcial? Mas êle emudeceu."},{text:"13 Então disse o rei aos seus ministros: Atai-o de pés e mãos, e lançai-o nas trevas exteriores: Aí haverá chôro e ranger dos dentes."},{text:"14 Porque são muitos os chamados e poucos os escolhidos."},{text:"15 Então retirando-se os fariseus, consultaram entre si como o surpreenderiam no que falasse."},{text:"16 E enviaram-lhe seus discípulos juntamente com os herodianos, que lhe disseram: Mestre, nós sabemos que és verdadeiro, e que ensinas o caminho de Deus pela verdade, e não se te dá de ninguém: Porque não fazes acepção"},{text:"de pessoas:"},{text:"17 Dize-nos pois qual é o teu sentimento: É lícito dar o tributo a César, ou não?"},{text:"18 Porém Jesus conhecendo a sua malícia, disse-lhes: Por que me tentais, hipócritas?"},{text:"19 Mostrai-me cá a moeda do censo. E êles lhe apresentaram um dinheiro."},{text:"20 E Jesus lhes disse: De quem é esta imagem e inscrição?"},{text:"21 Responderam-lhe êles: De César. Então lhes disse Jesus: Pois dai a César o que é de César, e a Deus o que é de Deus."},{text:"22 E quando isto ouviram se admiraram, e deixando-o se retiraram."},{text:"23 Naquele dia vieram a êle os saduceus, que dizem não haver ressurreição: E lhe fizeram esta pergunta,"},{text:"24 dizendo: Mestre, Moisés disse: Que se morrer algum que não tenha filho, seu irmão se case com sua mulher, e dê sucessão a seu irmão."},{text:"25 Ora entre nós havia sete irmãos: Depois de casado faleceu o primeiro: E porque não teve filho, deixou sua mulher a seu irmão."},{text:"26 O mesmo sucedeu ao segundo, ao terceiro, até ao sétimo."},{text:"27 E ùltimamente, depois de todos, faleceu também a mulher."},{text:"28 A qual dos sete logo pertencerá a mulher na ressurreição? porque todos foram casados com ela."},{text:"29 E respondendo Jesus, lhes disse: Errais não sabendo as Escrituras, nem o poder de Deus."},{text:"30 Porque depois da ressurreição, nem as mulheres terão maridos, nem os maridos mulheres: Mas serão como os Anjos de Deus no Céu."},{text:"31 E sôbre a ressurreição dos mortos, vós não tendes lido o que Deus disse, falando convosco:"},{text:"32 Eu sou o Deus de Abraão, e o Deus de Isaac, e o Deus de Jacó? ora Deus não o é de mortos, mas de vivos."},{text:"33 E a gente do povo ouvindo isto, estava admirada da sua doutrina."},{text:"34 Mas os fariseus, quando ouviram que Jesus tinha feito calar a bôca aos saduceus, se ajuntaram em conselho:"},{text:"35 E um dêles, que era doutor da lei, tentando-o, lhe perguntou:"},{text:"36 Mestre, qual é o grande mandamento da lei?"},{text:"37 Jesus lhe disse: Amarás ao Senhor teu Deus de todo o teu coração, e de tôda a tua alma, e de todo o teu entendimento,"},{text:"38 Êste é o máximo, e o primeiro mandamento."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"39 E o segundo semelhante a êste é: Amarás a teu próximo, como a ti mesmo."},{text:"40 Dêstes dois mandamentos depende tôda a lei e os profetas."},{text:"41 E estando juntos os fariseus, lhes fêz Jesus esta pergunta,"},{text:"42 dizendo: Que vos parece a vós do Cristo? de quem é êle filho? Responderam-lhe: De Davi."},{text:"43 Jesus lhes replicou: Pois como lhe chama Davi em espírito, Senhor, dizendo:"},{text:"44 Disse o Senhor ao meu Senhor, senta-te à minha mão direita até que eu reduza os teus inimigos a servirem de escabêlo a teus pés?"},{text:"45 Se pois Davi o chama o seu Senhor, como é êle seu filho?"},{text:"46 E não houve quem lhe pudesse responder uma só palavra: E daquele dia em diante ninguém mais ousou fazer-lhe perguntas."},{text:"Mateus — capítulo 23."},{text:"1 Então falou Jesus às turbas, e aos seus discípulos,"},{text:"2 dizendo: Sôbre a cadeira de Moisés se assentaram os escribas, e os fariseus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque atam cargas pesadas, e incomportáveis, e as põem sôbre os ombros dos homens: Mas nem com seu dedo as querem mover."},{text:"5 E fazem tôdas as suas obras, para serem vistos dos homens: Por isso trazem as suas largas tiras de pergaminho, e grandes franjas."},{text:"6 E gostam de ter nos banquetes os primeiros lugares, e nas sinagogas as primeiras cadeiras."},{text:"7 E que os saúdem na praça, e que os homens os chamem mestres."},{text:"8 Mas vós não queirais ser chamados mestres: Porque um só é vosso Mestre, e vós todos sois irmãos."},{text:"9 E a ninguém chameis pai vosso sôbre a terra: Porque um só é o vosso Pai, que está nos Céus."},{text:"10 Nem vos intituleis mestres: Porque um só é vosso Mestre, o Cristo."},{text:"11 O que de entre vós é o maior, será o vosso servo."},{text:"12 Porque aquêle que se exaltar, será humilhado: E o que se humilhar, será exaltado."},{text:"13 Mas ai de vós, escribas, e fariseus hipócritas: Que fechais o reino dos Céus diante dos homens: Pois nem vós entrais, nem aos que entrariam deixais entrar."},{text:"14 Ai de vós, escribas, e fariseus hipócritas: Porque devorais as casas das viúvas, fazendo largas orações: Por isto levareis um juízo mais rigoroso."},{text:"15 Ai de vós, escribas, e fariseus hipócritas: Porque rodeais o mar e a terra por fazerdes um prosélito: E depois de o terdes feito, o fazeis em dôbro mais digno do inferno do que vós."},{text:"16 Ai de vós, condutores cegos, que dizeis: Todo o que jurar pelo Templo, isso não é nada: Mas o que jurar pelo ouro do Templo, fica obrigado ao que jurou."},{text:"17 Estultos, e cegos: Pois qual é mais: o ouro ou o Templo que santifica o ouro?"},{text:"18 E todo o que jurar pelo Altar, isso não é nada; mas qualquer que jurar pela oferenda, que está sôbre êle, está obrigado ao que jurou."},{text:"19 Cegos: pois qual é mais, a oferenda ou o Altar, que santifica a oferenda?"},{text:"20 Aquêle pois que jura pelo Altar, jura por êle, e por tudo quanto sôbre êle está:"},{text:"21 E todo o que jurar pelo Templo, jura por êle, e pelo que habita nêle:"},{text:"22 E o que jura pelo Céu, jura pelo trono de Deus e por aquêle que está sentado nêle."},{text:"23 Ai de vós, escribas, e fariseus hipócritas, que pagais o dízimo da hortelã, e do endro, e do cominho, e haveis deixado as coisas, que são mais importantes da lei, a justiça, e a misericórdia, e a fé; estas coisas eram"},{text:"as que vós devíeis praticar, sem que entretanto omitísseis aquelas outras."},{text:"24 Condutores cegos, que coais um mosquito, e engulis um camelo."},{text:"25 Ai de vós, escribas e fariseus hipócritas, porque limpais o que está por fora do copo, e do prato, e por dentro estais cheios de rapinas e imundícies."},{text:"26 Fariseu cego, purifica primeiro o interior do copo e do prato, para que também o exterior fique limpo."},{text:"27 Ai de vós, escribas, e fariseus hipócritas: Porque sois semelhantes aos sepulcros branqueados, que parecem por fora formosos aos homens, e por dentro estão cheios de ossos de mortos, e de tôda a asquerosidade:"},{text:"28 Assim também vós outros por fora vos mostrais na verdade justos aos homens: Mas por dentro estais cheios de hipocrisia, e iniqüidade."},{text:"29 Ai de vós, escribas, e fariseus hipócritas, que edificais os sepulcros dos profetas, e adornais os monumentos dos justos,"},{text:"30 e dizeis: Se nós houvéramos vivido nos dias de nossos pais, não teríamos sido seus companheiros no sangue dos profetas."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 E assim dais testemunho contra vós mesmos, de que sois filhos daqueles que mataram os profetas."},{text:"32 Acabai vós pois de encher a medida de vossos pais."},{text:"33 Serpentes, raça de víboras, como escapareis vós de serdes condenados ao inferno?"},{text:"34 Por isso eis aqui estou eu que vos envio profetas, e sábios, e escribas, e dêles matareis, e crucificareis a uns, e dêles açoutareis a outros nas vossas sinagogas, e os perseguireis de cidade em cidade."},{text:"35 Para que venha sôbre vós todo o sangue dos justos, que se tem derramado sôbre a terra, desde o sangue do justo Abel, até o sangue de Zacarias, filho de Baraquias, a quem vós destes a morte entre o Templo e o Altar."},{text:"36 Em verdade vos digo, que tôdas estas coisas virão a cair sôbre esta geração."},{text:"37 Jerusalém, Jerusalém, que matas os profetas, e apedrejas os que te são enviados, quantas vêzes quis eu ajuntar teus filhos, do modo que uma galinha recolhe debaixo das asas os seus pintos, e tu o não quiseste?"},{text:"38 Eis aí vos ficará deserta a vossa casa."},{text:"39 Porque eu vos declaro que desde agora não me tornareis a ver até que digais: Bendito seja o que vem em nome do Senhor."},{text:"Mateus — capítulo 24."},{text:"1 E tendo saído Jesus do Templo, se ia retirando. E chegaram a êle os seus discípulos, para lhe mostrarem a fábrica do Templo."},{text:"2 Mas êle respondendo, lhes disse: Vêdes tudo isto? Na verdade vos digo, que não ficará aqui pedra sôbre pedra, que não seja derribada."},{text:"3 tools — see the cookie policy for details"},{text:"4 E respondendo Jesus, lhes disse: Vêde, não vos engane alguém."},{text:"5 Porque virão muitos em meu nome, dizendo: Eu sou Cristo: E enganarão a muitos."},{text:"6 Haveis pois de ouvir guerras, e rumores de guerras. Olhai não vos turbeis: Porque importa que assim aconteça, mas não é êste ainda o fim:"},{text:"7 Porque se levantará nação contra nação, e reino contra reino, e haverá pestilência, e fomes, e terremotos em diversos lugares:"},{text:"8 E tôdas estas coisas são princípios das dores."},{text:"9 Então vos entregarão à tribulação, e vos matarão: E sereis aborrecidos de tôdas as gentes por causa do meu nome."},{text:"10 E muitos então serão escandalizados, e se entregarão de parte a parte, e se aborrecerão uns aos outros."},{text:"11 E levantar-se-ão muitos falsos profetas, e enganarão a muitos."},{text:"12 E porquanto multiplicar-se-á a iniqüidade, e se resfriará a caridade de muitos:"},{text:"13 Mas o que perseverar até o fim, êsse será salvo."},{text:"14 E será pregado êste Evangelho do reino por todo o mundo, em testemunho a tôdas as gentes: E então chegará o fim."},{text:"15 Quando vós pois virdes que a abominação da desolação, que foi predita pelo profeta Daniel, está no lugar santo: (o que lê, entenda)."},{text:"16 Então os que se acham em Judéia, fujam para os montes:"},{text:"17 E o que se acha no telhado, não desça a levar coisa alguma de sua casa:"},{text:"18 E o que se acha no campo, não volte a tomar a sua túnica."},{text:"19 Mas ai das que estiverem pejadas, e das que criarem naqueles dias."},{text:"20 Rogai pois que não seja a vossa fuga em tempo de inverno, ou em dia de sábado:"},{text:"21 Porque será então a aflição tão grande que, desde que há mundo até agora, não houve nem haverá outra semelhante."},{text:"22 E se não se abreviassem aqueles dias, não se salvaria pessoa alguma: Porém abreviar-se-ão aqueles dias em atenção aos escolhidos."},{text:"23 Então se alguém vos disser: Olhai, aqui está o Cristo, ou ei-lo acolá: Não lhe deis crédito."},{text:"24 Porque se levantarão falsos Cristos, e falsos profetas: Que farão grandes prodígios, e maravilhas tais, que (se fôra possível) até os escolhidos se enganariam."},{text:"25 Vêde que eu vo-lo adverti antes."},{text:"26 Se pois vos disserem: Ei-lo lá está no deserto, não saiais: Ei-lo cá mais retirado da casa, não lhes deis crédito."},{text:"27 Porque de modo que um relâmpago sai do Oriente, e se mostra até o Ocidente: Assim há de ser também a vinda do Filho do homem."},{text:"28 Em qualquer lugar em que estiver o corpo, aí se hão de ajuntar também as águias."},{text:"29 E logo depois da aflição daqueles dias, escurecer-se-á o sol, e a lua não dará a sua claridade, e as estrêlas cairão do Céu, e as virtudes dos Céus se comoverão:"},{text:"30 E então aparecerá o sinal do Filho do homem no Céu: E então todos os povos da terra chorarão: E verão ao Filho do homem, que virá sôbre as nuvens do Céu com grande poder, e majestade."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Mateus Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 E enviará os seus anjos com trombetas, e com grande voz: E ajuntarão os seus escolhidos desde os quatro ventos, do mais remontado dos Céus até às extremidades dêles."},{text:"32 Aprendei pois o que vos digo, por uma comparação tirada da figueira: Quando os seus ramos estão já tenros, e as folhas têm brotado, sabeis que está perto o estio:"},{text:"33 Assim também quando vós virdes tudo isto, sabei que está perto, às portas."},{text:"34 Na verdade vos digo, que não passará esta geração sem que se cumpram tôdas estas coisas."},{text:"35 Passará o Céu, e a terra, mas não passarão as minhas palavras."},{text:"36 Mas daquele dia, nem daquela hora, ninguém sabe, nem os anjos dos Céus, senão só o Padre."},{text:"37 E assim como foi nos dias de Noé, assim será também a vinda do Filho do homem."},{text:"38 Porque assim como nos dias antes do dilúvio estavam comendo e bebendo, casando-se e dando-se em casamento, até ao dia que Noé entrou na arca,"},{text:"39 e não o entenderam enquanto não veio o dilúvio e os levou a todos: Assim será também a vinda do Filho do homem."},{text:"40 Então de dois que estiverem no campo: Um será tomado, e outro será deixado."},{text:"41 De duas mulheres que estiverem moendo em um moinho: Uma será tomada, e outra será deixada."},{text:"42 Velai pois, porque não sabeis a que hora há de vir vosso Senhor."},{text:"43 Mas sabei que se o pai de família soubesse a que hora havia de vir o ladrão, vigiaria sem dúvida, e não deixaria minar a sua casa."},{text:"44 Por isso estai vós também preparados: Porque não sabeis em que hora tem de vir o Filho do homem."},{text:"45 Quem crês que é o servo fiel, e prudente, a quem seu Senhor pôs sôbre a sua família, para que lhes dê de comer a tempo?"},{text:"46 Bem-aventurado aquêle servo, a quem seu Senhor achar nisso ocupado quando vier."},{text:"47 Na verdade vos digo, que êle o constituirá administrador de todos os seus bens."},{text:"48 Mas se aquêle servo sendo mau disser no seu coração: Meu Senhor tarda em vir:"},{text:"49 E começar a maltratar aos seus companheiros, a comer, e beber com os que se embriagam:"},{text:"50 Virá o Senhor daquele servo no dia em que êle o não espera, e na hora em que êle não sabe:"},{text:"51 E removê-lo-á, e porá a sua parte com os hipócritas: Ali haverá chôro, e ranger de dentes."},{text:"Mateus — capítulo 25."},{text:"1 Então será semelhante o reino dos Céus a dez virgens: Que tomando as suas lâmpadas, saíram a receber o espôso e a espôsa."},{text:"2 Mas cinco de entre elas eram loucas, e cinco prudentes."},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas as prudentes levaram azeite nas suas vasilhas juntamente com as lâmpadas."},{text:"5 E tardando o espôso, começaram a tosquenejar tôdas, e assim vieram a dormir."},{text:"6 Quando à meia-noite se ouviu gritar: Eis aí vem o espôso, saí a recebê-lo."},{text:"7 Então se levantaram tôdas aquelas virgens, e prepararam as suas lâmpadas."},{text:"8 E disseram as fátuas às prudentes: Dai-nos do vosso azeite, porque as nossas lâmpadas se apagam."},{text:"9 Responderam as prudentes, dizendo: Para que não suceda talvez faltar-nos êle, a nós e a vós, ide antes aos que o vendem, e comprai o que haveis mister."},{text:"10 E enquanto elas foram a comprá-lo, veio o espôso, e as que estavam apercebidas entraram com êle a celebrar as bodas, e fechou-se a porta."},{text:"11 E por fim vieram também as outras virgens, dizendo: Senhor, Senhor, abre-nos."},{text:"12 Mas êle respondendo, lhes disse: Na verdade vos digo, que vos não conheço."},{text:"13 Vigiai pois, porque não sabeis o dia, nem a hora."},{text:"14 Porque assim é como um homem que, ao ausentar-se para longe, chamou aos seus servos, e lhes entregou os seus bens."},{text:"15 E deu a um cinco talentos, e a outro dois, e a outro deu um, a cada um segundo a sua capacidade, e partiu logo."},{text:"16 O que recebera pois cinco talentos, foi-se e entrou a negociar com êles, e ganhou outros cinco."},{text:"17 Da mesma sorte também o que recebera dois, ganhou outros dois."},{text:"18 Mas o que havia recebido um, indo-se com êle cavou na terra, e escondeu ali o dinheiro de seu senhor."}]}] 1
