give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"do homem."},{text:"21 Se o teu inimigo tiver fome, dá-lhe de comer: Se tiver sêde, dá-lhe água para beber:"},{text:"22 Porque assim amontoarás brasas vivas sôbre a sua cabeça, e o Senhor te dará a paga."},{text:"23 O vento do Aquilão dissipa as chuvas: E o rosto triste a língua maldizente."},{text:"24 É melhor estar assentado a um canto do eirado, do que habitar com uma mulher litigiosa, e numa casa comum."},{text:"25 Tão saborosa é a água fria à alma que tem sêde como é uma boa nova que vem de um país remoto."},{text:"26 O justo que cai diante do ímpio, é como uma fonte que turvaram com o pé, e como uma veia de água que corromperam."},{text:"27 Assim como não é bom o mel para aquêle que o come em demasia: Assim o que é esquadrinhador da majestade será oprimido da glória."},{text:"28 Assim como é uma cidade tôda aberta, e que não está cercada de muros, assim é o homem, que quando fala não pode conter o seu espírito."},{text:"Provérbios — capítulo 26."},{text:"1 Assim como a neve é imprópria no estio, e as chuvas no tempo da ceifa: Assim a glória está mal a um insensato."},{text:"2 Como um pássaro que voa de uma parte para outra, e um pardal que vai para onde quer: Assim a maldição proferida sem motivo cairá sôbre o que a profere."},{text:"3 tools — see the cookie policy for details"},{text:"4 Não respondas ao louco segundo a sua loucura, para não vires a ser seu semelhante."},{text:"5 Responde ao louco segundo a sua loucura, para que êle não fique entendendo que é sábio."},{text:"6 Aquêle que envia as suas palavras por intervenção de um mensageiro insensato, fica manco dos pés, e bebendo a iniqüidade."},{text:"7 Bem como ao coxo não serve de nada ter as pernas bem feitas: Assim não diz bem a parábola na bôca dos insensatos."},{text:"8 Assim como obra o que lança uma pedra no montão de Mercúrio: Assim também se porta o que dá honra ao insensato."},{text:"9 A parábola na bôca dos insensatos é como se nascesse um espinheiro na mão dum homem embriagado."},{text:"10 A sentença do juiz decide as causas: E aquêle que impõe silêncio a um insensato, apazigua as contendas."},{text:"11 O imprudente, que repete a sua loucura, é como o cão que torna outra vez ao que tinha vomitado."},{text:"12 Tens visto a um homem, que crê de si que é sábio? maior esperança terá do que êle um ignorante."},{text:"13 O preguiçoso diz: O leão está no caminho, e a leoa nas passagens:"},{text:"14 Bem como a porta volta sôbre a sua couceira, assim se revolve o preguiçoso no seu leito."},{text:"15 O preguiçoso esconde a mão debaixo do seu sovaco, e dá-lhe muito trabalho, quando a tiver de levar à bôca."},{text:"16 O preguiçoso parece-lhe que é mais sábio do que sete homens que não dizem coisa que não seja acertada."},{text:"17 Assim como está em perigo aquêle que toma a um cão pelas orelhas, do mesmo modo o que passando se impacienta, e se mete numa bulha que é com outrem."},{text:"18 Assim como é culpável o que atira frechadas, e lançadas para matar:"},{text:"19 Do mesmo modo o é aquêle homem, que usando de fraude prejudica ao seu amigo: E depois de ter sido apanhado, diz: Eu o fazia por brinco."},{text:"20 Quando não houver mais lenha apagar-se-á o fogo, e desterrado que seja o mexeriqueiro, apaziguar-se-ão as contendas."},{text:"21 Assim como os carvões são para as brasas, e a lenha para o fogo, do mesmo modo é o homem iracundo para excitar disputas."},{text:"22 As palavras dos mexeriqueiros parecem singelas, mas elas penetram até o íntimo das entranhas."},{text:"23 Os lábios inchados juntos a um coração péssimo, são tanto monta como se quiseras adornar com prata baixa um vaso de barro."},{text:"24 Pelos seus lábios se dá a conhecer o inimigo, quando no coração tramar enganos."},{text:"25 Quando êle te falar num tom humilde, não te fies nêle, porque tem sete malícias no seu coração."},{text:"26 Aquêle que oculta o seu ódio debaixo duma aparência fingida, será descoberta a sua malícia na assembléia pública."},{text:"27 Aquêle que abre a cova, cairá nela: E a pedra virá rolando sôbre aquêle que boliu nela."},{text:"28 A língua enganadora não ama a verdade: E a bôca lúbrica é causa de ruínas."},{text:"Provérbios — capítulo 27."},{text:"1 Não te glories pelo dia de amanhã, não sabendo que coisa dará de si o dia seguinte."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Seja outro o que te louve, e não a tua bôca: Seja um estranho, e não os teus próprios lábios."},{text:"3 tools — see the cookie policy for details"},{text:"4 A ira não tem misericórdia, nem o furor que rompe: Mas quem poderá suportar o ímpeto dum homem arrebatado?"},{text:"5 Melhor é a correção manifesta, do que o amor escondido."},{text:"6 Melhores são as feridas feitas pelo que ama, do que os ósculos fraudulentos do que quer mal."},{text:"7 A alma farta pisará o favo do mel: E a alma faminta até o amargo tomará por doce."},{text:"8 Assim como periga a ave que passa do seu ninho a outra parte, do mesmo modo o homem que deixa o seu lugar."},{text:"9 Com o perfume e variedade de cheiros se deleita o coração: E com os bons conselhos do amigo se banha a alma em doçura."},{text:"10 Não largues o teu amigo, nem o amigo de teu pai: E não entres na casa de teu irmão no dia em que estiveres aflito. Melhor é o vizinho ao pé, do que o irmão ao longe."},{text:"11 Trabalha, meu filho, por adquirir a sabedoria, e alegra o meu coração, a fim de poderes responder ao que te impropera."},{text:"12 O astuto vendo o mal, se escondeu: Os símplices passando adiante suportaram os danos."},{text:"13 Tira o vestido àquele que ficou por fiador dum estranho: E leva-lhe de casa os penhores, que êle obrigou pelos outros."},{text:"14 Aquêle que louva o seu vizinho a grandes vozes, levantando-se de noite, será semelhante ao que diz mal dêle."},{text:"15 Os telhados que gotejam em tempo de inverno, e a mulher litigiosa estão em igual paralelo:"},{text:"16 Aquêle que a pretende reter, é como se quisesse fazer parar o vento, e êle trabalhará por que o azeite não escorra da sua mão."},{text:"17 O ferro aguça-se com o ferro, e o homem aguça a face do seu amigo."},{text:"18 Aquêle que guarda a figueira, comerá de seu fruto: E o que é guarda do seu Senhor, será glorificado."},{text:"19 Assim como na água resplandece o rosto dos que se estão vendo nela, assim os corações dos homens são descobertos aos prudentes."},{text:"20 O inferno e a perdição nunca se enchem: Assim também os olhos dos homens são insaciáveis."},{text:"21 Do modo que a prata é provada no vaso de derreter e o ouro na fornalha: Assim o homem é provado pela bôca do que o louva. O coração do iníquo busca o mal: E o coração reto busca a ciência."},{text:"22 Se tu pisares o imprudente num gral, como se pisam os grãos de cevada, ferindo-os de cima a mão do mesmo gral, não se lhe tirará a sua estultícia."},{text:"23 Conhece diligentemente de vista o teu gado, e considera os teus rebanhos."},{text:"24 Porque nem sempre terás poder sôbre êles: Mas ser-te-á dada uma coroa em geração e geração."},{text:"25 Abriram-se os prados e apareceram as verdes ervas, e recolheu-se o feno dos montes."},{text:"26 Os cordeiros são para te vestires: E os cabritos para o preço do campo."},{text:"27 Baste-te o leite das cabras para o teu sustento, e para o que a tua casa houver mister: E para o sustento de tuas escravas."},{text:"Provérbios — capítulo 28."},{text:"1 O ímpio foge, sem que ninguém o persiga: O justo porém, como leão afoito, estará sem terror."},{text:"2 Por causa dos pecados da terra são muitos os príncipes dela: E por causa da sabedoria do homem, e pela ciência das coisas que se dizem, será mais dilatada a vida do príncipe."},{text:"3 tools — see the cookie policy for details"},{text:"4 Aquêles que deixam a lei, louvam o ímpio: Os que a guardam irritam-se contra êle."},{text:"5 Os homens maus não cuidam no que é justo: Mas os que buscam o Senhor advertem em tudo."},{text:"6 Melhor é o pobre que anda na sua simplicidade, do que o rico que anda por caminhos perversos."},{text:"7 Aquêle que guarda a lei, é filho sábio: Mas o que sustenta comilões, confunde a seu pai."},{text:"8 Aquêle que amontoa riquezas por meio de usuras, e interêsses injustos, ajunta-as para o que há de ser liberal com os pobres."},{text:"9 Daquele que desvia os seus ouvidos para não ouvir a lei, a mesma oração será execrável."},{text:"10 Aquêle que seduz os justos, levando-os a um mau caminho, cairá no fôsso que êle mesmo abriu: E os símplices possuirão os seus bens."},{text:"11 O homem rico parece-lhe que é sábio: Mas o pobre que é prudente sondá-lo-á."},{text:"12 Na exaltação dos justos há muita glória: Reinando os ímpios, acontecem as ruínas dos homens."},{text:"13 Aquêle que esconde as suas maldades não será bem sucedido: Aquêle, porém, que as confessar, e se retirar delas, alcançará misericórdia."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 Bem-aventurado o homem que sempre está com temor: Mas o que é de coração duro, cairá no mal."},{text:"15 Um príncipe ímpio sôbre um povo pobre é um leão que ruge, e um urso que tem fome."},{text:"16 Um príncipe falto de prudência oprimirá a muitos pelas suas calúnias: Mas os dias do que aborrece a avareza, serão prolongados."},{text:"17 Se o homem que por calúnia derrama o sangue de qualquer pessoa, fugir até se arremessar no fôsso, ninguém o sustém."},{text:"18 Aquêle que anda em simplicidade, será salvo: O que anda por caminhos perversos, cairá por uma vez."},{text:"19 Aquêle que lavra a sua terra, terá fartura de pão: Mas o que ama a ociosidade, estará cheio de indigência."},{text:"20 O homem fiel será muito louvado: Mas o que dá pressa a se enriquecer, não será inocente."},{text:"21 Aquêle que quando julga guarda respeito à pessoa, não faz bem: Um tal homem até desampara a verdade por um bocado de pão."},{text:"22 O homem que se apressa por enriquecer, e tem inveja aos outros, não sabe que há de vir sôbre êle a pobreza."},{text:"23 Aquêle que repreende a um homem, achará depois graça para com êle, muito mais do que aquêle outro que o engana com as lisonjas da sua língua."},{text:"24 Aquêle que tira alguma coisa a seu pai, e a sua mãe, e diz que isto não é pecado, tem parte no crime dos homicidas."},{text:"25 Aquêle que se jacta, e que se incha de soberba, excita contendas: Mas o que espera no Senhor, será curado."},{text:"26 Aquêle que confia no seu coração é um insensato: Mas o que anda sàbiamente, será com efeito salvo."},{text:"27 Aquêle que dá ao pobre, não terá necessidade: Aquêle que o despreza quando lhe pede, cairá em penúria."},{text:"28 Quando os ímpios fôrem elevados, esconder-se-ão os homens: Quando êles perecerem, multiplicar-se-ão os justos."},{text:"Provérbios — capítulo 29."},{text:"1 Sôbre aquêle homem, que despreza com uma cerviz dura a quem o repreende, virá de repente a sua total ruína: E não terá mais remédio."},{text:"2 Na multiplicação dos justos se alegrará o vulgo: Quando os ímpios tomarem o govêrno, gemerá o povo."},{text:"3 tools — see the cookie policy for details"},{text:"4 O rei justo faz florescer o seu estado: O homem avarento destrui-lo-á."},{text:"5 O homem que, quando fala ao seu amigo, usa de uma linguagem lisonjeira, e fingida, arma uma rêde aos seus passos."},{text:"6 Ao homem pecador iníquo envolverá o laço: E o justo louvará e se regozijará."},{text:"7 O justo toma conhecimento da causa dos pobres: O ímpio ignora a ciência."},{text:"8 Os homens pestilentes destroem a cidade: Os sábios, porém, apartam o furor."},{text:"9 Se o homem sábio disputar com o insensato, ou êle se agaste, ou se ria, não achará descanso."},{text:"10 Os homens sangüinários aborrecem o simples: Mas os justos procuram conservar-lhe a vida."},{text:"11 O insensato produz logo tudo o que tem no seu espírito: O sábio não se apressa, mas reserva-se para o depois."},{text:"12 O príncipe, que ouve de boamente as palavras da mentira, só os ímpios tem por ministros."},{text:"13 O pobre e o credor se encontraram: O Senhor é que alumia um e outro."},{text:"14 Quando o rei julga os pobres conforme a verdade, o seu trono será firmado para sempre."},{text:"15 A vara e a correção dão sabedoria: O menino porém, que é deixado à sua vontade, serve de confusão a sua mãe."},{text:"16 Com a multiplicação dos ímpios se multiplicarão as maldades e os justos verão a sua ruína."},{text:"17 Cria bem a teu filho, e consolar-te-á, e servirá de delícias à tua alma."},{text:"18 Quando faltar a profecia, dissipar-se-á o povo: Aquêle porém que guarda a lei, é bem-aventurado."},{text:"19 O escravo não pode ser ensinado por palavras: Porque êle entende o que tu dizes, e despreza responder."},{text:"20 Viste um homem precipitado no falar? mais se devem dêle esperar loucuras, do que emenda."},{text:"21 Aquêle que cria delicadamente o seu criado desde a infância, ao depois experimentá-lo-á contumaz."},{text:"22 O homem iracundo excita reixas: E o que fàcilmente se indigna será mais propenso a pecar."},{text:"23 Ao soberbo segue a humilhação: E o humilde de espírito receberá a glória."},{text:"24 Aquêle que se associa com o ladrão, aborrece a sua própria alma: Ouve ao que o toma para juramento, e nada denuncia."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 Aquêle que teme ao homem, depressa cairá: O que espera no Senhor será levantado."},{text:"26 São muitos os que buscam a face do príncipe: Mas do Senhor sai o juízo de cada um."},{text:"27 Os justos abominam o homem ímpio: E os ímpios abominam aquêles que se acham no caminho direito."},{text:"Provérbios — capítulo 30."},{text:"1 Palavras do que congrega, filho do que arrevesa sabedoria. Visão que expôs um varão, com quem está Deus, e que tendo sido confortado pela assistência de Deus que reside nêle, disse:"},{text:"2 Eu sou o mais insensato dos homens, e a sabedoria dos homens não está comigo."},{text:"3 tools — see the cookie policy for details"},{text:"4 Quem subiu ao céu, e desceu dêle? quem reteve o vento nas suas mãos? quem atou as águas como num vestido? quem firmou tôda a extensão da terra? qual é o seu nome, e qual é o nome de seu filho, se é que o sabes?"},{text:"5 Tôda a palavra de Deus é purificada ao fogo: Êle é um escudo para os que esperam nêle:"},{text:"6 Não acrescentes nada às suas palavras, para não sêres por isso repreendido, e achado mentiroso."},{text:"7 Duas coisas são as que te pedi: Não mas negues antes que morra."},{text:"8 Alonga de mim a vaidade, e as palavras de mentira: Não me dês nem a pobreza, nem as riquezas: Dá-me sòmente o que fôr necessário para viver:"},{text:"9 Para que não suceda que, estando farto, seja eu tentado a te renunciar, e a dizer: Quem é o Senhor? Ou que, constrangido da indigência, me ponha a furtar, e viole por um juramento o nome de meu Deus."},{text:"10 Não acuses o servo diante de seu Senhor, para que não suceda amaldiçoar-te êle, e caíres tu."},{text:"11 Há uma progênie, que amaldiçoa a seu pai, e que não abençoa a sua mãe."},{text:"12 Há uma progênie, que crê de si que é pura, e contudo ela não está limpa das suas manchas."},{text:"13 Há uma progênie, cujos olhos são altivos, e as suas pálpebras levantadas para cima."},{text:"14 Há uma progênie, que em lugar de dentes tem espadas, e mastiga com os seus queixais, para devorar os que não têm nada na terra, e que são pobres entre os homens."},{text:"15 Duas são as filhas da sanguessuga, que dizem: Traze, traze. Há três coisas, que são insaciáveis, e uma quarta que nunca diz: Basta."},{text:"16 O inferno, e a bôca da madre, e a terra, que se não farta de água: Do mesmo modo o fogo nunca diz: Basta:"},{text:"17 Quanto ao ôlho do que escarnece de seu pai, e do que despreza a paridura de sua mãe, arranquem-no os corvos, que andam à borda das torrentes, e comam-no os filhos da águia."},{text:"18 Três coisas me são dificultosas de entender, e uma quarta eu a ignoro inteiramente:"},{text:"19 O caminho da águia no ar, o caminho da cobra sôbre a pedra, o caminho da nau no meio do mar, e o caminho do homem na sua mocidade."},{text:"20 Tal é também o caminho da mulher adúltera, a qual come, e alimpando a sua bôca, diz: Eu não fiz mal nenhum."},{text:"21 A terra estremece com três coisas, e a quarta não a pôde ela suportar:"},{text:"22 Com um escravo, quando êste reinar: Com um insensato, quando estiver farto de comer:"},{text:"23 Com uma mulher odiosa, quando um homem a receber: E com uma escrava, quando esta vier a ficar herdeira de sua senhora."},{text:"24 Quatro coisas há na terra, que são muito pequenas, e que são mais sábias do que os mesmos sábios."},{text:"25 As formigas, aquêle fraco povo, que faz o seu provimento durante a messe:"},{text:"26 Os coelhos, aquela débil tropa, que faz a sua habitação nos rochedos:"},{text:"27 Os gafanhotos, que não têm rei, e que todavia saem todos ordenados em seus esquadrões:"},{text:"28 O lagarto, que se sustém nas suas mãos, e que mora no palácio dos reis."},{text:"29 Há três coisas, que andam bem, e uma quarta que nada magnìficamente:"},{text:"30 O leão, o mais forte dos animais, de nada que encontre terá mêdo:"},{text:"31 O galo, que anda mui senhor de si: E o carneiro: E um rei, a quem nada resiste."},{text:"32 Tal homem há que pareceu um insensato, depois que foi elevado a uma sublime ordem: Porque se êle tivesse tido inteligência, teria pôsto a mão na sua bôca."},{text:"33 Aquêle que com fôrça espreme a têta para tirar leite, faz sair dela um suco crasso: E aquêle que excita a ira produz discórdias."},{text:"Provérbios — capítulo 31."},{text:"1 Palavras do rei Lamuel. Visão, pela qual o instruiu sua mãe."},{text:"2 Que te direi eu, meu amado filho, que te direi eu, amado fruto das minhas entranhas, que te direi eu, querido objeto dos meus desejos?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"3 tools — see the cookie policy for details"},{text:"4 Não dês aos reis, ó Lamuel, não dês vinho aos reis: Porque não há segrêdo onde reina a bebedice:"},{text:"5 E para que não suceda que êles bebam, e se esqueçam da justiça, e transtornem a eqüidade na causa dos filhos do pobre."},{text:"6 Mas dá aos que estão aflitos um licor capaz de os embriagar, e vinho aos que estão em amargura de coração:"},{text:"7 Para que êles bebam, e se esqueçam da sua pobreza, e não se lembrem mais da sua dor."},{text:"8 Abre a tua bôca a favor do mudo, e para defenderes as causas de todos os filhos que passam:"},{text:"9 Abre a tua bôca, ordena o que é justo, e faze justiça ao necessitado e ao pobre."},{text:"10 Quem achará uma mulher forte? Seu preço excede a tudo o que vem de remontadas distâncias, e dos últimos confins da terra."},{text:"11 O coração de seu marido põe nela a sua confiança, e êle não necessitará de despojos."},{text:"12 Ela lhe tornará o bem, e não o mal, em todos os dias da sua vida."},{text:"13 Buscou lã e linho, e o trabalhou com a indústria de suas mãos."},{text:"14 Fêz-se como a nau do negociante, que traz de longe o seu pão."},{text:"15 E levantou-se de noite, e repartiu a prêsa aos seus domésticos, e o sustento às suas escravas."},{text:"16 Considerou um campo, e comprou-o: Plantou uma vinha do fruto das suas mãos."},{text:"17 Cingiu os seus rins de fortaleza e corroborou o seu braço."},{text:"18 Tomou-lhe o gôsto, e viu que a sua negociação é boa: A sua candeia não se apagará de noite."},{text:"19 Ela meteu a sua mão a coisas fortes, e os seus dedos pegaram no fuso."},{text:"20 Abriu a sua mão para o necessitado, e estendeu os seus braços para o pobre."},{text:"21 Não temerá que venham sôbre a sua família os rigores da neve: Porque todos os seus domésticos trazem vestidos forrados."},{text:"22 Ela fêz para si móveis de tapeçaria: Ela