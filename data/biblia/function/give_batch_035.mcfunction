give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"46 Agora pois clamai ao céu, para que sejais livres da mão de vossos inimigos. E travou-se a batalha:"},{text:"47 E Jônatas estendeu a sua mão para ferir a Baquides, mas êle evitou o golpe, retirando-se para trás:"},{text:"48 Enfim, Jônatas e os que eram com êle, deitaram-se ao Jordão, e o passaram a nado, à vista dêles:"},{text:"49 E da parte de Baquides ficaram mortos naquele dia mil homens: E êle com a sua gente voltou para Jerusalém."},{text:"50 E edificaram cidades fortes na Judéia, e fortificaram de altos muros, e de portas, e de fechaduras, as cidadelas que havia em Jericó, e em Amaus, e em Betoron, e em Betel, e em Tamnata, em Fara, e em Topo."},{text:"51 E nelas pôs Baquides guarnições, para que fizessem suas correrias contra Israel:"},{text:"52 Fortificou também a cidade de Betsura, e Gazara, e a fortaleza, e pôs nelas gentes de guarda, e provisão de mantimentos:"},{text:"53 E tomou para reféns os filhos das primeiras personagens da terra, e pô-los em custódia na fortaleza de Jerusalém."},{text:"54 E no ano cento e cinqüenta e três, no segundo mês, mandou Alcimo demolir as paredes da parte interior do templo, e destruir as obras dos profetas: E começou a deitá-las a baixo."},{text:"55 Naquele tempo foi Alcimo ferido da mão de Deus: E se atalharam as suas obras e a bôca se lhe fechou, e êle ficou tolhido de uma paralisia, nem pôde mais falar palavra, nem fazer disposição alguma tocante à sua casa."},{text:"56 Desta sorte morreu Alcimo naquele tempo atormentado de grandes dores."},{text:"57 E viu Baquides que Alcimo era morto: E voltou para o rei, e a terra estêve calada por dois anos."},{text:"58 Ao cabo dêste tempo todos os maus formaram entre si êste desígnio, dizendo: Reparai Jônatas, e os que com êle estão, vivem desassustadamente com descanso: Pois agora façamos vir a Baquides, e êle os apanhará a todos"},{text:"numa noite."},{text:"59 Pelo que êles o foram buscar, e lhe deram êste conselho."},{text:"60 Baquides pois se deu pressa a vir com um grande exército: E mandou em segrêdo cartas aos do seu partido, que estavam na Judéia, em que lhes advertia prendessem a Jônatas, e aos que eram com êle: Mas êles não o puderam"},{text:"fazer, porque chegou à notícia dêstes o seu desígnio."},{text:"61 E dentre as pessoas da terra prendeu Jônatas cinqüenta homens, que eram os capatazes da velhacaria, e os mandou matar:"},{text:"62 E retirou-se Jônatas, e Simão, e os que com êle estavam a Betbessen, que é no deserto: E reparou as suas ruínas, e fizeram dela uma forte praça."},{text:"63 E quando Baquides o soube, ajuntou logo tôdas as suas tropas: E do que passava fêz aviso àqueles que estavam na Judéia."},{text:"64 E veio acampar-se acima de Betbessen: E a combateu por muitos dias, e fêz construir diversas máquinas de guerra."},{text:"65 Porém Jônatas deixou a Simão seu irmão na cidade, e saiu à campanha, e marchou com um reforçado corpo de tropas."},{text:"66 E desfez a Odaren, e a seus irmãos, e aos filhos de Faseron, dentro das suas mesmas tendas, e começou a dar rijo nos inimigos, e a fazer-se célebre pelos seus grandes feitos."},{text:"67 Porém Simão, e os que com êle estavam, saíram da cidade, e queimaram os aproches."},{text:"68 E pelejaram contra Baquides, e o desbarataram: E lhe causaram grande pesar, vendo que tinham saído frustrados os seus desígnios, e a sua emprêsa."},{text:"69 E encolerizado contra aquêles homens iníquos, que lhe haviam dado o conselho de que viesse para a sua terra, matou a muitos dêles: E resolveu êle mesmo tornar para o seu país com todo o resto do exército."},{text:"70 E soube isto Jônatas, e lhe mandou embaixadores para fazer pazes com êle, e oferecer-lhe que restituiria os prisioneiros."},{text:"71 E aceitou Baquides de boa vontade a oferta, e consentiu no que Jônatas queria, e jurou que em todos os dias da sua vida lhe não faria mal algum."},{text:"72 E restituiu-lhe os prisioneiros, que antes fizera cativos na terra de Judá: E se foi na volta do seu país, e não quis mais tornar à terra de Judá."},{text:"73 Assim a guerra cessou em Israel: E Jônatas assistiu em Macmas, e ali começou o mesmo Jônatas a julgar o povo, e exterminou os ímpios do meio de Israel."},{text:"1 Macabeus — capítulo 10."},{text:"1 No ano pois cento e sessenta, Alexandre, filho de Antíoco, que teve o sobrenome de Ilustre, subiu: E se senhoreou de Ptolemaida: E o receberam os habitantes, e reinou ali."},{text:"2 E soube isto o rei Demétrio, e levantou um exército em extremo numeroso, e saiu a encontrar-se com êle para lhe dar batalha."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque dizia Demétrio: Antecipemo-nos a fazer a paz com êle, antes que êle a faça com Alexandre em dano nosso:"},{text:"5 Porque êle Jônatas se lembrará de todos os males que nós lhe fizemos a êle, e a seu irmão, e à sua gente."},{text:"6 Demétrio pois lhe deu poder de levantar um exército, e de mandar fazer armas, e quis que êle fôsse seu aliado: E mandou que se lhe entregassem os reféns, que estavam na fortaleza."},{text:"7 E veio Jônatas a Jerusalém, e leu as cartas, ouvindo-o todo o povo, e os que estavam na fortaleza."},{text:"8 E êles ficaram tomados de um grande mêdo, depois que ouviram que o rei lhe tinha dado poder de ajuntar um exército."},{text:"9 Foram pois entregues a Jônatas os reféns, e êle os restituiu a seus pais:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 E Jônatas ficou habitando em Jerusalém, e começou a edificar e a renovar a cidade."},{text:"11 E mandou aos arquitetos que levantassem os muros, e cercassem de pedras de silharia o monte Sião todo em tôrno para a sua fortificação: E êles assim o fizeram."},{text:"12 Então os estrangeiros, que estavam nas fortalezas que Baquides tinha edificado, fugiram:"},{text:"13 E cada um deixou o seu lugar, e se foi para a sua terra:"},{text:"14 Ficaram sòmente em Betsura alguns daqueles que tinham abandonado a lei, e os preceitos de Deus: Porque esta cidade era a que lhes servia de acolheita."},{text:"15 Entretanto ouviu o rei Alexandre as promessas que Demétrio tinha feito a Jônatas: Recontaram-lhe também as batalhas, e provas de valor, que êle, e seus irmãos tinham dado, e os trabalhos que tinham padecido:"},{text:"16 E disse êle: Acaso poderemos nós achar outro algum homem tal como êste? pois vejamos como o faremos agora nosso amigo, e aliado."},{text:"17 E escreveu uma carta, e lha enviou concebida nestes têrmos, dizendo:"},{text:"18 O rei Alexandre a seu irmão Jônatas, saúde."},{text:"19 Nós temos ouvido dizer de ti, que és um homem poderoso em fôrças, e azado para seres nosso amigo:"},{text:"20 E agora te constituímos hoje Sumo Pontífice da tua nação, e queremos que sejas chamado amigo do rei (e mandou-lhe uma púrpura, e uma coroa de ouro), e que te conformes conosco em tôdas as coisas que são dos nossos"},{text:"interêsses, e nos conserves a amizade."},{text:"21 E no ano cento e sessenta, no sétimo mês, se vestiu Jônatas da Santa Opa, no dia da solene festa dos Tabernáculos: E levantou um exército, e mandou fazer quantidade de armas."},{text:"22 E Demétrio tanto que ouviu estas coisas, logo se contristou em extremo, e disse:"},{text:"23 Como temos nós dado lugar a que Alexandre nos haja prevenido em conciliar a amizade dos judeus para fortificar o seu partido?"},{text:"24 Eu pois lhes escreverei também exortando-os a isso com rogativas, e oferecendo-lhes dignidades, e dádivas: Para êles serem comigo em minha ajuda."},{text:"25 Êle pois lhes escreveu nestes têrmos: O rei Demétrio à nação dos judeus, saúde:"},{text:"26 Ouvimos que vós tendes guardado a aliança que fizestes conosco, e que perseverastes firmes na nossa amizade, e que vos não acostastes ao partido de nossos inimigos, e disto nos alegramos."},{text:"27 Perseverai pois agora como até aqui em nos conservar a mesma fidelidade, e nós vos pagaremos avantajadamente o que obrastes conosco:"},{text:"28 E nós vos remeteremos muitas das prestações que vos estavam impostas, e vos faremos grandes doações."},{text:"29 E desde agora eu vos remito a vós, e a todos os judeus os tributos que costumáveis pagar, e vos perdôo os impostos do sal, e vos dou por isentos das coroas, e da têrça da semente:"},{text:"30 E do que eu tinha direito de levar pela metade dos frutos das árvores, eu vos alívio de tudo isso desde o dia de hoje em diante, não querendo que se cobre mais do país de Judá, nem das três cidades, que lhe foram"},{text:"anexadas, da Samaria e da Galiléia, começando de hoje e pelo decurso do tempo para sempre:"},{text:"31 Quero outrossim que Jerusalém seja santa, e livre com todo o seu território: E que os dízimos e os tributos sejam seus."},{text:"32 Também abro mão do senhorio da fortaleza, que está em Jerusalém: E a dou ao sumo sacerdote, a fim de que êle ponha nela quaisquer homens que êle mesmo escolher, para que a guardem."},{text:"33 Dou mais sem resgate algum a liberdade a todos os judeus, que foram cativos do país de Judá, e se acharem em todo o meu reino, isentando-os a todos de pagarem tributos por si, e ainda pelos seus gados."},{text:"34 Quero da mesma sorte que tôdas as festas solenes, e os dias de sábado, e as luas novas, e as festas decretadas, e os três dias antes de cada festa solene, e os três depois dela, sejam todos uns dias de imunidade, e de"},{text:"franqueza para todos os judeus que estão no meu reino:"},{text:"35 E ninguém terá poder de andar em litígio, nem mover demanda contra algum dêles em qualquer negócio que fôr."},{text:"36 Item, ordeno que dos judeus se alistem nas tropas do rei até trinta mil homens: E se lhes subministrará o necessário como convém a tôdas as tropas do rei, e dêles se escolherão os que houverem de ser postos nas"},{text:"fortalezas do grande rei:"},{text:"37 Item, dêstes se elegerão alguns para o manejo dos negócios do reino, que pedem fidelidade, e sejam dêles mesmos tirados os cabeceiras do govêrno, e vivam conforme as suas leis, como o rei ordenou para o país de Judá."},{text:"38 E que as três cidades do país de Samaria, que foram anexadas à Judéia sejam havidas como da Judéia: Para que não dependam senão de um governador, nem obedeçam a nenhuma outra potestade, que não seja a do sumo"},{text:"pontífice."},{text:"39 Quanto a Ptolemaida, e a todo o seu território, tenho feito doação dela ao santuário de Jerusalém, para daqui se acudir às despesas necessárias das coisas santas."},{text:"40 Afora isto darei eu todos os anos quinze mil siclos de prata, que se tomarão dos direitos reais, que me pertencem:"},{text:"41 E os que administravam a minha fazenda os anos passados, darão desde hoje para as obras da casa tudo o que restar daqueles anos, que êles ainda não pagaram."},{text:"42 E além disto cinco mil siclos de prata, que todos os anos cobravam das rendas do santuário: Também êstes pertencem aos sacerdotes, que fazem as funções do seu ministério."},{text:"43 Item quero que todos aquêles que, sendo devedores ao rei por qualquer negócio que ser possa, se refugiarem no templo de Jerusalém, e em todo o seu couto, fiquem seguros, e gozem livremente de tudo o que têm no meu"},{text:"reino."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"44 Item para edificar ou reparar as obras do santuário, sairão as despesas do bolsinho do rei:"},{text:"45 Também para reedificar os muros de Jerusalém, e para os fortificar ao redor, fár-se-ão os gastos do mesmo bolsinho do rei, e para fazer muros por tôda a Judéia."},{text:"46 Mas Jônatas, e o povo quando ouviram estas proposições de Demétrio, não as tiveram por sinceras, nem as aceitaram: Porque se lembraram dos grandes males que êle tinha feito a Israel, e quanto os tinha atribulado."},{text:"47 Êles pois se declararam a favor de Alexandre, visto ter êle sido o primeiro que lhes falara de paz, e êles o auxiliaram sempre dali por diante."},{text:"48 Negociado isto, levantou o rei Alexandre um grande exército, e marchou com as suas tropas contra Demétrio."},{text:"49 E deram batalha os dois reis, e fugiu o exército de Demétrio, e foi Alexandre em seu alcance, e deu sôbre êles."},{text:"50 E foi mui renhida a peleja, até que se pôs o sol: E acabou Demétrio naquele dia."},{text:"51 E depois destas coisas enviou Alexandre embaixadores a Ptolomeu, rei do Egito, dizendo:"},{text:"52 Já que sou entrado no meu reino e me assentei no trono de meus pais, e recobrei o meu império, e desfiz a Demétrio, e entrei na posse de meus domínios,"},{text:"53 e vim com êle às mãos, e o derrotei a êle e às suas tropas, e me assentei no trono do seu reino:"},{text:"54 Portanto façamos agora amizade um com outro: E dá-me tua filha por mulher, e eu serei teu genro, e assim a ti, como a ela, eu farei presentes dignos de ti."},{text:"55 E o rei Ptolomeu lhe respondeu, dizendo: Venturoso o dia em que tornaste a ocupar a terra de teus pais, e te assentaste no trono do seu reino."},{text:"56 E agora te farei o que me pediste por escrito: Mas vem ter comigo a Ptolemaida, para que ambos ali nos vejamos, e dar-te-ei a minha filha como disseste."},{text:"57 Saiu pois Ptolomeu do Egito, e êle, e sua filha Cleópatra, e veio a Ptolemaida no ano cento e sessenta e dois."},{text:"58 E foi ali encontrar-se com êle o rei Alexandre, a quem Ptolomeu deu sua filha Cleópatra: E celebrou as suas núpcias em Ptolemaida com grande magnificência, segundo o costume dos reis."},{text:"59 O rei Alexandre também escreveu a Jônatas, para que viesse avistar-se com êle."},{text:"60 E foi Jônatas com grande pompa a Ptolemaida, e ali saiu ao encontro aos dois reis, e lhes deu muita prata, e ouro, e presentes: E achou um entranhável acolhimento em ambos êles."},{text:"61 E conspiraram-se contra êle certos homens pestilenciais de Israel, homens iníquos, para darem contra êle capítulos de acusação: Mas o rei os não quis atender."},{text:"62 Antes mandou que se tirassem a Jônatas os seus vestidos, e que o vestissem de púrpura: E assim o fizeram. E o rei o fêz assentar a par de si."},{text:"63 E disse aos grandes de sua côrte: Ide com êle pelo meio da cidade, e fazei publicar em voz alta, que ninguém se atreva a formar contra êle queixa por título algum, e que ninguém lhe seja molesto por qualquer coisa que"},{text:"fôr."},{text:"64 Aquêles pois que tinham vindo com tenção de o acusar, quando o viram sublimado ao auge de glória, que se apregoava dêle, e a êle vestido de púrpura, fugiram todos:"},{text:"65 E o rei o elevou a grande honra, e pô-lo no número dos seus primeiros amigos, e constituiu-o chefe, e príncipe junto à sua pessoa."},{text:"66 E Jônatas voltou para Jerusalém em paz, e com alegria."},{text:"67 No ano cento e sessenta e cinco, Demétrio, filho de Demétrio, veio de Creta à terra de seus pais."},{text:"68 Tanto que o rei Alexandre teve notícia disto, logo se contristou em extremo, e voltou para Antióquia."},{text:"69 E o rei Demétrio fêz general das suas tropas a Apolônio, que era governador da Celesíria: e êste levantou um grande exército, e chegou a Jamnia: E enviou um mensageiro a Jônatas sumo sacerdote,"},{text:"70 dizendo: Tu és único que nos resistes: E eu estou feito um objeto de riso, e de opróbrio, porque tu te vales contra nós da vantagem que tens nos montes."},{text:"71 Se pois agora confias nas tuas tropas, desce a nós ao campo, e façamos lá prova das nossas fôrças: Porque o valor militar me acompanha sempre."},{text:"72 Pergunta, e saberás quem eu sou, e os outros que me dão socorro, os quais também dizem que os vossos pés se não podem manter firmes diante da nossa face, porque teus pais duas vêzes foram postos em fugida na sua"},{text:"própria terra:"},{text:"73 Como poderás tu logo agora aturar a fôrça da minha cavalaria, e a de um tão grande exército num campo, onde não há nem pedra, nem penedo, nem lugar para fugir?"},{text:"74 E Jônatas assim que ouviu estas palavras de Apolônio, alterou-se no fundo do seu coração: E escolheu dez mil homens, e partiu de Jerusalém, e Simão seu irmão se foi incorporar com êle para o socorrer:"},{text:"75 E vieram acampar-se ao pé de Jope, e os da cidade lhes fecharam as portas: Porque dentro de Jope havia uma guarnição de Apolônio, e Jônatas a combateu."},{text:"76 E espantados os que estavam dentro da cidade, abriram-lhe as portas, e Jônatas se apoderou de Jope."},{text:"77 E tanto que ouviu isto, Apolônio fêz logo avançar consigo três mil cavalos, e um grande corpo de tropas."},{text:"78 E marchou como quem ia para Azot, e logo de improviso se lançou na campina, porque tinha muita cavalaria, e nela se fiava. Seguiu-o pois Jônatas para a parte de Azot, e ali deram batalha um ao outro."},{text:"79 Mas Apolônio tinha deixado de emboscada no seu arraial mil cavalos por detrás dos inimigos."},{text:"80 E teve notícia Jônatas de que ficava por detrás dêle uma emboscada, e os inimigos rodearam o seu arraial, e desde a manhã até à tarde não cessaram de despedir tiros missivos contra a sua gente."},{text:"81 Mas ela se tinha firme, conforme a ordem que Jônatas lhe havia dado: Entretanto os cavalos dos inimigos se fatigaram muito."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"82 Então fêz Simão avançar as suas tropas, e atacou a infantaria: Porque a cavalaria estava já cansada, de sorte que foi rôta por êle e fugiu."},{text:"83 E os que se tinham espalhado pelo campo, se acolheram a Azot, e entraram pelo templo de Dagon, seu ídolo, para ficarem salvos."},{text:"84 Porém Jônatas queimou a Azot, e as cidades que estavam nos seus contornos, e tomou os seus despojos, e pôs fogo ao templo de Dagon, queimando-o com todos os que nêle se tinham refugiado."},{text:"85 E foram perto de oito mil homens os que morreram passados à espada, entrando nesta conta os que ficaram consumidos do fogo."},{text:"86 E Jônatas fêz abalar o campo dêste lugar, e marchou contra Ascalon: E os paisanos saíram fora da cidade a recebê-lo com grandes honras."},{text:"87 Depois se recolheu Jônatas a Jerusalém com a sua gente carregada de muitos despojos."},{text:"88 E aconteceu isto: O rei Alexandre como ouviu êstes felizes sucessos elevou ainda Jônatas a maior glória."},{text:"89 Mandou-lhe pois uma fivela de ouro, daquelas que se costumam dar aos príncipes de sangue real. E deu-lhe a propriedade de Acaron com todo o seu território."},{text:"1 Macabeus — capítulo 11."},{text:"1 Passado isto, o rei do Egito ajuntou um exército, como a areia que está na ourela do mar, e um grande número de naus: E êle andava vendo, como se faria senhor do reino de Alexandre por surprêsa, e o ajuntaria ao seu"},{text:"reino."},{text:"2 Marchou pois para a Síria em tom de paz, e os habitantes das cidades lhe abriam as portas, e o vinham receber: Porque o rei Alexandre tinha mandado que saíssem a recebê-lo, pelo motivo de que o rei do Egito era seu"},{text:"sogro."},{text:"3 tools — see the cookie policy for details"},{text:"4 E quando chegou perto de Azot, mostraram-lhe o templo de Dagon queimado, e Azot, e os seus subúrbios demolidos, e os cadáveres por terra, e ao longo do caminho os montões que tinham feito daqueles que haviam sido"},{text:"mortos na batalha."},{text:"5 E disseram ao rei, que Jônatas era quem tinha feito todos êstes estragos, para lho fazerem odioso: Mas o rei a tudo isto se calou."},{text:"6 E Jônatas veio com grande pompa encontrar-se com o rei em Jope, e se cumprimentaram um ao outro, e passaram ali a noite."},{text:"7 E Jônatas acompanhou o rei até ao rio, que se chama Eleutero: E voltou para Jerusalém."},{text:"8 Mas o rei Ptolomeu se levantou com o domínio de tôdas as cidades até Selêucia que está sôbre o mar, e trazia maus intentos contra Alexandre."},{text:"9 E enviou embaixadores a Demétrio, dizendo: Vem, façamos aliança um com outro, e eu te darei minha filha que Alexandre tem por mulher, e tu reinarás no reino de teu pai:"},{text:"10 Porque eu estou arrependido de lhe ter dado minha filha em matrimônio: Visto que êle procurou matar-me."},{text:"11 E acusava dêste modo Ptolomeu a Alexandre, pelo desejo que tinha de lhe tirar o seu reino."},{text:"12 E lhe tirou sua filha, e a deu a Demétrio, e se descartou inteiramente de Alexandre, e então se fêz pública a sua inimizade."},{text:"13 Ptolomeu entrou pois em Antióquia, e pôs na sua cabeça dois diademas, um do Egito, e outro da Ásia."},{text:"14 E o rei Alexandre naquele tempo achava-se em Cilícia: Porque os que estavam naquelas províncias se tinham rebelado contra êle."},{text:"15 E quando Alexandre ouviu esta notícia, veio logo ter com êle para o combate: E o rei Ptolomeu fêz sair a campo o seu exército, e lhe saiu ao encontro com um grande poder, e o pôs em fugida."},{text:"16 E Alexandre fugiu para a Arábia, a ver se achava ali alguma proteção: E o rei Ptolomeu foi exaltado a grande glória."},{text:"17 Mas Zabdiel, príncipe dos árabes, fêz cortar a cabeça a Alexandre: E a mandou a Ptolomeu."},{text:"18 Mas a cabo de três dias morreu o rei Ptolomeu: E os da sua gente, que estavam nas fortalezas, foram mortos pelos que se achavam no arraial."},{text:"19 Entrou pois Demétrio a reinar no ano cento e sessenta e sete."},{text:"20 Naqueles dias ajuntou Jônatas os que estavam na Judéia, para combaterem a fortaleza, que havia em Jerusalém: E aplicaram muitas máquinas de guerra para a tomar."},{text:"21 Mas certos homens iníquos que aborreciam a sua gente, foram ter com o rei Demétrio, e lhe contaram que Jônatas tinha de cêrco a fortaleza."},{text:"22 E Demétrio, quando tal ouviu, ficou irritado: E veio logo para Ptolemaida, e escreveu a Jônatas que não sitiasse a fortaleza, mas que viesse sem demora ver-se com êle, para terem uma conferência."},{text:"23 Mas Jônatas logo que recebeu esta carta, mandou que se continuasse o cêrco: E escolheu alguns dos anciãos de Israel, e dos sacerdotes, e foi com êles expor-se ao perigo."},{text:"24 E tomou quantidade de ouro, e de prata, e de vestidos, e outros presentes, e deu consigo em Ptolemaida, a ver-se com o rei, e achou graça diante dêle."},{text:"25 Ainda alguns homens perdidos da sua nação formavam queixas contra êle."},{text:"26 Mas o rei o tratou como o tinham tratado os príncipes seus predecessores: E o elevou a grande honra à vista de todos os seus amigos."},{text:"27 E confirmou-o no sumo sacerdócio, e em todos os outros distintivos de honra, que antes tinha, e fê-lo o primeiro dos seus amigos."},{text:"28 E Jônatas suplicou ao rei que concedesse imunidade de tributos à Judéia, e às três toparquias, e à Samaria, e ao seu território: E prometeu-lhe trezentos talentos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"29 E conveio nisso o rei: E fêz expedir a Jônatas sôbre tôdas estas coisas cartas patentes, que eram concebidas nestes têrmos:"},{text:"30 O rei Demétrio a seu irmão Jônatas, e à gente dos judeus, saúde."},{text:"31 Nós vos mandamos entregar uma cópia da carta, que a vosso respeito escrevemos a Lastenes, nosso pai, para serdes informados de tudo."},{text:"32 O rei Demétrio a Lastenes seu pai, saúde."},{text:"33 Temos resolvido fazer bem à nação dos judeus, que são nossos amigos, e nos conservam a fidelidade que lhes cumpre, por causa da sua boa vontade, que tem para conosco."},{text:"34 Temos pois decretado em benefício dêles que todos os têrmos da Judéia, e que as três cidades de Lida, e Ramata, as quais foram anexadas à Judéia da província da Samaria, e todos os seus territórios, sejam destinados"},{text:"para todos os sacerdotes de Jerusalém, em lugar dos impostos que o rei cobrava já dêles cada ano, e em lugar do que lhe rendiam os frutos da terra, e dos pomares."},{text:"35 Remitimos-lhes também desde agora as outras coisas, que nos pertenciam de dízimos, e de tributos: Da mesma sorte as lagoas das marinhas, e as coroas que se nos costumavam trazer:"},{text:"36 Tôdas estas coisas lhes damos: E nada disto será anulado desde agora, e para sempre."},{text:"37 Cuidai pois de tirar agora uma cópia desta ordenação, e ela se entregue a Jônatas, e seja posta no monte santo em lugar público."},{text:"38 E o rei Demétrio vendo que a terra estava sossegada diante dêle, e que nada lhe resistia, licenciou todo o seu exército, mandando cada um para sua casa, exceto as tropas estrangeiras, que tinha levantado das ilhas das"},{text:"gentes: E isto excitou contra êle o ódio de tôdas as tropas, que tinham servido a seus pais."},{text:"39 Havia então um certo Trifão, que antes tinha sido do partido de Alexandre: Quando viu que tôdas as gentes de guerra murmuravam contra Demétrio, foi logo ter com Emalcuel Árabe, que criava ao pé de si a Antíoco, filho"},{text:"de Alexandre."},{text:"40 E por muitos tempos apertou com êle, que lhe desse aquêle moço príncipe, para o fazer reinar em lugar de seu pai: E contou-lhe tudo o que Demétrio tinha feito, e o ódio que tôdas as gentes de guerra haviam concebido"},{text:"contra êle. E lá se demorou muitos dias."},{text:"41 Entretanto Jônatas enviou embaixadores ao rei Demétrio, suplicando-lhe que deitasse fora os que estavam na fortaleza de Jerusalém, e os que havia nos outros presídios: Porque faziam muitos danos a Israel."},{text:"42 E Demétrio mandou dizer a Jônatas: Não só farei por ti, e pela tua gente o que me pedes, mas elevar-te-ei em glória a ti, e ao teu povo, tanto que o tempo me der lugar."},{text:"43 Agora pois farás tu uma ação de justiça, se mandares tropas em meu socorro: Porque todo o meu exército me desamparou."},{text:"44 E então lhe mandou Jônatas para Antióquia três mil homens esforçados, que vieram ter com o rei, e o rei se alegrou muito com a sua chegada."},{text:"45 Ao mesmo tempo ajuntaram-se dos habitantes da cidade cento e vinte mil homens, que queriam matar o rei."},{text:"46 E fugiu o rei para o seu palácio: E os da cidade se fizeram senhores de tôdas as ruas dela, e começaram a atacá-lo."},{text:"47 E o rei chamou os judeus em seu socorro, e êles se ajuntaram todos ao pé dêle, e fizeram todos suas correrias pela cidade:"},{text:"48 E mataram naquele dia cem mil homens, e puseram fogo à cidade, e tomaram naquele mesmo dia muitos despojos, e livraram o rei."},{text:"49 Quando porém os da cidade viram que os judeus se tinham apoderado dela como desejavam: Logo perderam o ânimo, e com deprecações gritaram misericórdia ao rei, dizendo:"},{text:"50 Dá-nos a tua destra, e cessem os judeus de nos atacar a nós, e à cidade."},{text:"51 Ao mesmo tempo largaram as suas armas, e fizeram a paz, e os judeus adquiriram grande glória no conceito do rei, e no conceito de todos os que se achavam no seu reino, e ficaram afamados em todo o reino: E voltaram"},{text:"para Jerusalém carregados de muitos despojos."},{text:"52 E o rei Demétrio se assentou no trono do seu reino: E o país ficou apaziguado diante dêle."},{text:"53 Mas êste príncipe faltou a tudo que tinha prometido, e se alienou de Jônatas, e não lhe correspondeu segundo os benefícios, que lhe havia feito, antes em grande maneira o molestava."},{text:"54 E depois disto voltou Trifão, e com êle Antíoco mui moço, que reinou, e se pôs o diadema na cabeça."},{text:"55 E tôdas as tropas, que Demétrio tinha despedido, se ajuntaram logo ao pé de Antíoco, e batalharam contra Demétrio: O qual fugiu, e voltou as costas."},{text:"56 Trifão se apoderou então dos elefantes, e se fêz senhor de Antióquia:"},{text:"57 E escreveu o moço Antíoco a Jônatas, nestes têrmos: Eu te confirmo no sumo pontificado, e eu te constituo sôbre as quatro cidades, para que tu sejas dos amigos do rei."},{text:"58 Mandou-lhe também vasos de ouro para o seu serviço, e lhe deu poder de beber por copo de ouro, e de se vestir de púrpura, e de trazer fivela de ouro."},{text:"59 E a seu irmão Simão nomeou-o governador das terras, que vão desde a costa de Tiro até a fronteira do Egito."},{text:"60 E saiu Jônatas, e andava visitando as cidades de além do rio: E se lhe ajuntou em seu socorro todo o exército da Síria, e marchou para Ascalon e os da cidade saíram a recebê-lo com grandes honras."},{text:"61 E daqui passou êle a Gaza: E os de Gaza lhe fecharam as portas: E êle a sitiou, e queimou tudo quanto havia ao redor da cidade, e fêz saque do que achou."},{text:"62 Então mandaram os de Gaza dizer a Jônatas, que queriam capitular, e êle lhes deu a sua mão direita: E tomou seus filhos em reféns, e os remeteu a Jerusalém: Depois correu todo o país até Damasco."},{text:"63 Mas depois que Jônatas ouviu dizer que os generais de Demétrio tinham vindo com um poderoso exército a sublevar os de Cadés, que é na Galiléia, com o fim de o apartar do manejo dos negócios do reino:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"64 Logo lhes foi ao encontro, e deixou na província seu irmão Simão."},{text:"65 E Simão pôs cêrco a Betsura, e a atacou por muitos dias, e teve bloqueados os de dentro."},{text:"66 E lhe pediram que lhes desse a sua mão direita, e êle lha concedeu: E os lançou fora dali, e se apoderou da cidade, e pôs nela guarnição."},{text:"67 Jônatas porém, e as suas tropas se avizinharam até à borda d'água de Genesar, e antes de amanhecer deram consigo na campina de Asor."},{text:"68 E eis-que acham lá o exército dos estrangeiros, que vinham a encontrar-se com êles na campina, e que lhe armavam emboscadas nos montes: E êle mesmo marchou direito a êles."},{text:"69 E neste comenos os que estavam escondidos saíram dos lugares da sua emboscada, e travaram a batalha."},{text:"70 E todos os que eram da parte de Jônatas fugiram, sem ficar nem só um dêles, senão Matatias, filho de Absolomi, e Judas, filho de Calfi, general do seu exército."},{text:"71 Então rasgou Jônatas os seus vestidos, e pôs terra sôbre a sua cabeça, e orou."},{text:"72 Feito isto, tornou Jônatas sôbre êles para os combater, e os fêz voltar as costas e pelejaram."},{text:"73 E os do seu partido que fugiram, quando o viram pelejar tornaram logo a vir-se ajuntar com êle, e todos perseguiram com êle os inimigos até Cadés, onde tinham o arraial, e chegaram só até ali:"},{text:"74 E ficaram naquele dia mortos três mil homens do exército estrangeiro: E Jônatas se recolheu a Jerusalém."},{text:"1 Macabeus — capítulo 12."},{text:"1 Viu pois Jônatas que o tempo lhe corria favorável, e escolheu certos homens, e enviou-os a Roma a confirmar, e renovar a amizade com os romanos:"},{text:"2 Mandou também aos lacedemônios, e a outros lugares cartas do mesmo teor:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E os romanos lhes deram cartas dirigidas aos seus oficiais em cada província, para êles os fazerem conduzir em paz até a Judéia."},{text:"5 E a cópia das cartas, que Jônatas escreveu aos lacedemônios, é como se segue:"},{text:"6 JÔNATAS, sumo sacerdote, e os anciãos da nação e os sacerdotes, e o resto do povo judeu, aos lacedemônios seus irmãos, saúde."},{text:"7 Muito tempo há que foram enviadas cartas ao sumo sacerdote Onias por Ário, que reinava entre vós, que testemunharam que vós éreis nossos irmãos, como se contém no seu transunto, que vai junto."},{text:"8 E Onias recebeu com grande honra o mensageiro, que tinha sido enviado: E aceitou as cartas, onde êle lhe falava desta aliança, e amizade."},{text:"9 Nós, pôsto que não tivéssemos necessidade alguma destas coisas, tendo para nossa consolação os santos livros, que estão entre nossas mãos,"},{text:"10 todavia quisemos antes contudo enviar-vos mensageiros para renovarmos esta confraternidade, e amizade, temendo não viéssemos a ficar como estranhos a vosso respeito: visto ter já passado muito tempo, desde que vós cá"},{text:"mandastes."},{text:"11 Nós pois em todo o tempo sem interrupção, nos dias solenes, e nos outros, em que convém, nos lembramos de vós nos sacrifícios, que oferecemos, e nas nossas santas cerimônias, como é justo, e pede a decência que nos"},{text:"lembremos dos irmãos."},{text:"12 Nós portanto nos regozijamos da vossa glória."},{text:"13 Mas a nós outros nos têm cercado grandes tribulações, e várias guerras, e nos têm invadido os reis que estão em nossos contornos."},{text:"14 Entretanto não quisemos ser pesados nem a vós, nem aos outros aliados, e nossos amigos, em todos êstes combates:"},{text:"15 Porque temos tido o socorro do céu, e nós fomos livres, e os nossos inimigos se viram humilhados."},{text:"16 Portanto escolhemos a Numenio, filho de Antíoco, e a Antípatro, filho de Jasão, e os enviamos aos romanos a renovar a antiga aliança, e amizade, que temos com êles."},{text:"17 Assim que nós lhes demos ordem, que fôssem também a vós, e que vos cumprimentassem da nossa parte: E que vos entregassem as nossas cartas, sôbre a renovação da nossa confraternidade."},{text:"18 E agora fareis bem se nos responderdes a isto."},{text:"19 E êste é o traslado das cartas, que Ário tinha enviado a Onias:"},{text:"20 Ário, rei dos lacedemônios, ao sumo sacerdote Onias, saúde."},{text:"21 Achou-se aqui numa escritura sôbre os lacedemônios, e os judeus, que êles são irmãos, e que todos vêm da linhagem de Abraão."},{text:"22 E agora pois desde que nós soubemos isto, fazeis bem de nos escrever acêrca da vossa paz:"},{text:"23 E também nós vos respondemos: Os nossos gados e todos os nossos bens são vossos: E os vossos são nossos: E isto é o que nós ordenamos que se vos declarasse da nossa parte."},{text:"24 Entretanto ouviu dizer Jônatas, que os generais de Demétrio tinham voltado com um exército muito maior que o de antes, para pelejar contra êle:"},{text:"25 E partiu Jônatas de Jerusalém, e se foi encontrar com êles no país de Amatite: Porque não queria dar-lhes tempo de entrarem pelas suas terras."},{text:"26 E mandou espias ao arraial dos inimigos: E depois de voltarem os avisaram de que êles tinham resolvido vir sôbre êles de noite."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"27 Tanto pois que se pôs o sol, mandou Jônatas aos seus que vigiassem, e estivessem tôda a noite sôbre as armas, apercebidos para a peleja, e pôs guardas em tôrno do arraial."},{text:"28 E ouviram os inimigos que Jônatas com a sua gente se conservava prestes para o combate: E tiveram mêdo, e perderam o alento sobressaltados de pavor: E acenderam fogos no seu campo."},{text:"29 Mas Jônatas, e os que com êle estavam, não deram fé da sua retirada até pela manhã: E estavam vendo as fogueiras acesas."},{text:"30 E Jônatas foi atrás dêles mas não os pôde apanhar: Porque já tinham passado o rio Eleutero."},{text:"31 Dali marchou Jônatas na volta dos árabes que se chamam zabadeus, e desbaratou-os, e tomou os seus despojos."},{text:"32 Depois reuniu a sua gente, e veio a Damasco, e fazia correrias por tôda aquela província."},{text:"33 Ao mesmo tempo saiu Simão, e foi até Ascalon, e até às fortalezas vizinhas: E de lá partiu para Jope e a tomou."},{text:"34 (Porque tinha sabido que êles queriam entregar a praça aos do partido de Demétrio) e pôs ali guarnição que guardasse a cidade."},{text:"35 E voltou Jônatas, e convocou os anciãos do povo, e assentou com êles levantar fortalezas na Judéia,"},{text:"36 e edificar muros em Jerusalém, e levantar um muro de grande altura entre a fortaleza e a cidade para a separar da cidade, de sorte que ficasse ela sem comunicação, e os de dentro não pudessem comprar nem vender."},{text:"37 Êles pois se ajuntaram, para edificarem a cidade; e havia caído o muro, que estava sôbre o ribeiro da banda do nascente, e Jônatas reparou aquêle que se chama Caféteta:"},{text:"38 Simão da mesma sorte edificou Adiada em Séfela, e a fortificou, e lhe pôs portas e fechaduras."},{text:"39 Mas Trifão tendo resolvido fazer-se rei da Ásia, e tomar o diadema, e matar o rei Antíoco:"},{text:"40 Temendo não lho tolhesse Jônatas, e não lhe declarasse guerra, buscava meios de se apoderar da sua pessoa, e de o matar. E levantando o seu campo se foi para Betsan."},{text:"41 E marchou Jônatas em seu encontro com quarenta mil homens escolhidos para lhe dar batalha, e veio para Betsan."},{text:"42 E quando Trifão viu que Jônatas era chegado com um grande exército para o combater, ficou cheio de mêdo:"},{text:"43 E recebeu-o com grande honra, e recomendou-o a todos os seus amigos, e fêz-lhe presentes: E mandou a todo o seu exército que lhe obedecessem, como a êle mesmo."},{text:"44 Depois disse a Jônatas: Porque fatigaste tu inùtilmente todo êste povo, quando nós não temos guerra um com outro?"},{text:"45 Manda-os pois agora para suas casas, e escolhe dentre êles alguns poucos, que fiquem contigo e vem comigo para Ptolemaida, que eu ta entregarei com as outras fortalezas, e com as tropas, e com todos os que têm a"},{text:"intendência dos negócios: E feito isto eu me retirarei: Porque a isto é que eu vim."},{text:"46 E creu-o Jônatas, e fêz o que êle lhe disse: E despediu as suas tropas, as quais se tornaram para a terra de Judá."},{text:"47 E êle não reteve consigo senão três mil homens: Dos quais mandou ainda dois mil para Galiléia, e mil se foram com êles."},{text:"48 E tanto que Jônatas entrou em Ptolemaida, fecharam as portas da cidade os ptolemenses: E o apanharam e passaram ao fio da espada todos os que tinham entrado com êle."},{text:"49 E Trifão enviou as suas tropas, e a sua cavalaria para Galiléia e para o campo grande para matarem todos os companheiros de Jônatas."},{text:"50 Mas êstes, tendo sabido que Jônatas tinha sido prêso, e tinha perecido com todos os que com êle estavam, uns aos outros se animaram, e saíram apercebidos para combater."},{text:"51 Os que os tinham perseguido porém, vendo-os de todos resolutos a vender bem caro as suas vidas, tornaram para trás:"},{text:"52 Assim êles vieram todos em paz para a terra de Judá. E choraram muito a Jônatas, e aos que com êle tinham estado: E Israel tomou apertado nojo."},{text:"53 Então todos os povos, que estavam ao redor dêles, procuraram perdê-los: Porque disseram:"},{text:"54 Êles não têm chefe, nem pessoa que os auxilie: Ataquemo-los pois agora: E apaguemos o seu nome da memória dos homens."},{text:"1 Macabeus — capítulo 13."},{text:"1 Entretanto ouviu dizer Simão, que Trifão tinha levantado um grande exército, para vir à terra de Judá, e assolá-la."},{text:"2 Vendo que o povo estava todo amedrontado, e espavorido, subiu a Jerusalém, e fêz ajuntar o povo:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Por esta causa são mortos todos os meus irmãos, por quererem salvar a Israel, e fiquei eu só."},{text:"5 Mas não permita Deus agora que queira eu perdoar à minha vida, enquanto durarem as nossas tribulações: Porque eu não sou melhor do que meus irmãos."},{text:"6 Eu pois vingarei a minha gente, e o Santuário: Também os nossos filhos, e mulheres: Porque tôdas as nações se têm ajuntado para nos oprimir, sòmente pelo ódio que nos têm."},{text:"7 E o espírito do povo, assim que ouviu estas palavras, ficou todo inflamado."},{text:"8 E responderam em alta voz, dizendo: Tu és o nosso capitão em lugar de Judas e de Jônatas teu irmão:"},{text:"9 Dirige as nossas batalhas: E nós faremos tudo o que nos disseres."},{text:"10 E ajuntando todos os homens de guerra, fêz acabar com presteza todos os muros de Jerusalém, e fortificou-a tôda em roda."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 E enviou a Jônatas, filho de Absalomi, e com êle um novo exército a Jope, e tendo deitado fora os que estavam dentro dela, êle se deixou lá ficar."},{text:"12 Trifão, entretanto, abalou de Ptolemaida com um grande exército, para vir para a terra de Judá, e trazia consigo a Jônatas, que êle tinha retido prisioneiro."},{text:"13 E Simão acampou-se perto de Adus, defronte da planície."},{text:"14 E Trifão tanto que soube que Simão entrara em lugar de seu irmão Jônatas: E que se dispunha a lhe dar batalha, mandou-lhe embaixadores,"},{text:"15 dizendo: Pelo dinheiro que teu irmão Jônatas devia à fazenda real, por causa dos negócios que manejou, nós o temos retido."},{text:"16 Mas envia-me tu agora cem talentos de prata, e os seus dois filhos em reféns, para que êle, sendo pôsto em liberdade, não fuja do nosso partido, e nós to remeteremos."},{text:"17 Simão, ainda que conheceu que Trifão lhe falava assim para o enganar, mandou todavia que se lhe levasse o dinheiro com os meninos: Temendo não mover contra si o ódio do povo de Israel, que poderia dizer:"},{text:"18 Porque não lhe enviou o dinheiro, e os meninos, por isso é que Jônatas pereceu."},{text:"19 Êle pois lhe mandou os meninos, e os cem talentos: E Trifão faltou à palavra, e não remeteu a Jônatas."},{text:"20 E depois disto veio Trifão à terra para a assolar: E deram volta pelo caminho que vai a Ador: Mas Simão e o seu exército marchavam para tôda a parte, para onde quer que êles iam."},{text:"21 Então os que estavam na fortaleza, mandaram por uns mensageiros dizer a Trifão, que se desse pressa em vir pelo deserto, e que lhes enviasse víveres."},{text:"22 E pôs Trifão tôda a cavalaria pronta, para partir aquela mesma noite: Mas tinha caído muita neve em grande cópia, e não pôde ir ao território de Galaad."},{text:"23 E estando perto de Bascaman, matou ali a Jônatas, e a seus filhos."},{text:"24 Depois voltou Trifão, e foi para a sua terra."},{text:"25 Então mandou Simão buscar os ossos de seu irmão Jônatas, e os sepultou em Modin, que era a cidade de seus pais."},{text:"26 E todo Israel tomou grande dó da sua morte, e o pranteou por muitos dias."},{text:"27 E Simão levantou sôbre o sepulcro de seu pai e de seus irmãos um alto edifício, que se via de longe, cujas pedras eram polidas por detrás e por diante."},{text:"28 E pôs sete pirâmides em correspondência umas das outras, uma a seu pai, outra a sua mãe, e quatro a seus irmãos:"},{text:"29 E pôs-lhe à roda umas grandes colunas: E sôbre estas colunas armas, que servissem de um monumento eterno, e ao pé das armas navios de escultura, que fôssem vistos de longe por todos os que navegavam pelo mar."},{text:"30 Êste é o sepulcro, que êle fêz em Modin, que até o presente ainda dura."},{text:"31 Ora Trifão indo em jornada com o moço rei Antíoco, matou-o à traição."},{text:"32 E reinou em lugar dêle, e pôs sôbre a cabeça o diadema da Ásia, e fêz grande estragos na terra."},{text:"33 Simão entretanto reparou as praças da Judéia, fortificando-as de altas tôrres, e de grandes muros e de portas, e fechaduras: E meteu víveres nas praças fortes."},{text:"34 Escolheu também Simão certos homens, e os enviou ao rei Demétrio, pedindo-lhe que restabelecesse a Judéia nas suas liberdades: Porque todo o procedimento de Trifão tinha sido fundado em rapina."},{text:"35 E veio o rei Demétrio no que êle lhe tinha pedido, e lhe respondeu por escrito nestes têrmos:"},{text:"36 O rei Demétrio a Simão, sumo sacerdote, e amigo dos reis, e aos anciãos, e ao povo dos judeus, saúde."},{text:"37 Nós recebemos a coroa, e a palma de ouro, que vós nos mandastes: E estamos prontos a fazer convosco uma paz sólida, e a escrever aos governadores do rei que vos remitam o que nós vos temos concedido."},{text:"38 Porque tudo o que nós temos ordenado a nosso favor, fica para vós valioso. As praças, que edificastes, sejam vossas."},{text:"39 Também vos perdoamos as ignorâncias, e as faltas, em que podeis ter caído até o dia de hoje, e a coroa que devíeis: E se acaso se nos pagava qualquer outro impôsto em Jerusalém, não se torne êle mais a pagar."},{text:"40 E se entre vós alguns há que sejam capazes de se alistarem nas nossas tropas, alistem-se e haja entre nós paz."},{text:"41 No ano cento e setenta foi tirado o jugo dos gentios a Israel."},{text:"42 E o povo de Israel começou a pôr nas Tábuas e registros públicos a Era desde o primeiro ano sob Simão, sumo pontífice, grande capitão, e príncipe dos judeus."},{text:"43 Naqueles dias foi Simão sitiar Gaza, e bloqueou-a com o seu exército, e fêz máquinas, e chegou-se à cidade, e atacou uma das suas tôrres, e a levou."},{text:"44 E os que estavam numa destas máquinas haviam já entrado de golpe na cidade: E levantou-se um grande motim na cidade."},{text:"45 E os que estavam na cidade subiram acima dos muros com suas mulheres e filhos, rasgados os seus vestidos, e clamaram a grandes gritos, pedindo a Simão que lhes desse a sua mão direita."},{text:"46 E disseram: Não nos trates segundo a nossa muita malícia, mas segundo a tua grande clemência."},{text:"47 E ainda que movido Simão de piedade, lhes não fêz sentir o rigor da guerra: Contudo lançou-os fora da cidade, e purificou as casas em que tinham estado os ídolos, e então é que entrou nela bendizendo com hinos ao"},{text:"Senhor."},{text:"48 E depois de tiradas da cidade tôdas as imundícies, pôs nela homens que observassem a lei: E fortificou-a, e fêz nela habitação para si."},{text:"49 Os que porém estavam na fortaleza de Jerusalém não podiam, tolhidos disso, nem sair dela nem entrar pelo país, nem comprar nada, ou vender: E viram-se reduzidos a uma grande fome, e muitos dêles morreram à míngua."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"50 E gritaram a Simão, pedindo-lhe composição: E êle lha outorgou: E lançou-os fora da fortaleza, e limpou-a de tôdas as contaminações."},{text:"51 E entraram depois nela no dia vinte e três do segundo mês, ano cento e setenta e um, entoando louvores, e levando ramos de palmas na mão, e ao toque de harpas e de tímbales, e de liras, e cantando hinos, e cânticos,"},{text:"por ter sido exterminado de Israel um grande inimigo."},{text:"52 E ordenou Simão que todos os anos se celebrassem êstes dias com alegria."},{text:"53 Fortificou outrossim o monte do templo, que era perto da fortaleza, e habitou ali êle mesmo, e os que com êle estavam."},{text:"54 Ao depois viu Simão que João, seu filho, era um homem de guerra mui valente: E fê-lo general de tôdas as tropas: E João habitou em Gazara."},{text:"1 Macabeus — capítulo 14."},{text:"1 No ano cento e setenta e dois ajuntou o rei Demétrio o seu exército, e foi para a Média, para tirar dali socorros, e fazer guerra a Trifão."},{text:"2 Ora Arsaces, rei da Pérsia, e da Média, como ouviu que Demétrio tinha entrado nas suas terras, despachou logo um dos seus generais para que o tomasse vivo, e lho levasse."},{text:"3 tools — see the cookie policy for details"},{text:"4 E todo o país de Judá estêve sossegado por todo o tempo que Simão governou, e procurou fazer bem à sua nação: E o seu poder e a sua glória foram do agrado dos judeus enquanto êle viveu."},{text:"5 E além de tôdas as outras ações gloriosas que fêz, tomou a Jope para lhe servir de pôrto, e fêz que ela fôsse uma passagem para as ilhas do mar."},{text:"6 E estendeu os limites da sua nação, e se fêz senhor de todo o país."},{text:"7 E ajuntou um grande número de prisioneiros, e apoderou-se de Gazara, e de Betsura, e da fortaleza: E tirou dela tôdas as imundícies, e não havia quem lhe resistisse."},{text:"8 E cada um cultivava a sua fazenda em paz: E a terra de Judá produzia as suas novidades, e as árvores do campo os seus frutos."},{text:"9 Os velhos estavam todos assentados pelas praças e se entretinham na abundância dos bens da terra, e os moços se enfeitavam com vestidos magníficos, e com hábitos de guerra."},{text:"10 E êle distribuía mantimentos às cidades, e as ordenava em forma que ficassem sendo praças de armas, de maneira que a nomeada da sua glória se fêz célebre até às extremidades da terra."},{text:"11 Êle firmou a paz nos seus estados, e Israel se regozijou com grande alegria."},{text:"12 E cada um se punha assentado debaixo da sua parreira, e debaixo da sua figueira: E não havia quem lhes fizesse o menor mêdo."},{text:"13 Não se achou sôbre a terra quem os atacasse: Os reis ficaram abatidos por aquêles dias:"},{text:"14 E protegeu todos os pobres do seu povo, e zelou a observância da lei, e exterminou todos os iníquos, e todos os maus:"},{text:"15 Restabeleceu a glória do santuário, e multiplicou os vasos santos."},{text:"16 E soou em Roma a notícia de que Jônatas era falecido: E chegou ela até aos lacedemônios: E todos o sentiram em extremo."},{text:"17 Mas quando ouviram dizer que Simão, seu irmão, tinha sido feito sumo pontífice em seu lugar, e que êle estava senhor de todo o país, e de tôdas as cidades dêle:"},{text:"18 Escreveram-lhe em tábuas de metal, para renovarem a amizade, e a aliança que haviam feito com Judas, e com Jônatas seus irmãos."},{text:"19 Estas cartas pois foram lidas em Jerusalém diante de todo o povo. E êste é o teor das cartas que mandaram os lacedemônios:"},{text:"20 OS PRÍNCIPES, e as cidades dos lacedemônios, a Simão, sumo sacerdote, e aos anciãos, e aos sacerdotes, e a todo o povo dos judeus, seus irmãos, saúde."},{text:"21 Os embaixadores, que foram enviados ao nosso povo, nos informaram da glória, e da honra, e da alegria, em que vós presentemente vos achais: E nós nos regozijamos com a sua chegada."},{text:"22 E o que êles nos disseram nas juntas do povo escrevemos nós nos registros públicos, pelo teor seguinte: Numenio, filho de Antíoco, e Antípatro, filho de Jasão, deputados dos judeus, vieram ter conosco, para renovar a"},{text:"nossa antiga amizade."},{text:"23 E pareceu bem ao povo receber a êstes homens honorìficamente, e pôr o treslado de suas palavras nos livros reservados do povo, para que ficasse em lembrança ao povo dos lacedemônios. Ora nós mandamos uma cópia de tudo"},{text:"isto a Simão, sumo pontífice."},{text:"24 E depois disto enviou Simão a Roma a Numenio com um grande escudo de ouro, que pesava mil minas, a fim de renovar a aliança com êles: E tendo ouvido os do povo romano"},{text:"25 estas razões, disseram: Que ação de graças renderemos nós a Simão, e a seus filhos?"},{text:"26 Porque êle restabeleceu seus irmãos, e exterminou no meio de Israel os seus inimigos, e êles lhe deram o privilégio de uma inteira liberdade, e gravaram isto numas tábuas de metal, e o puseram numa inscrição pública"},{text:"sôbre o monte Sião."},{text:"27 E isto é o que continha a inscrição: AOS DEZOITO dias do mês de Elul, ano cento e setenta e dois, o terceiro ano sob Simão, sumo sacerdote em Asaramel."},{text:"28 Foi feita esta declaração no grande ajuntamento dos sacerdotes, e do povo, e dos príncipes da nação, e dos anciãos do país. Todos sabem que no nosso país têm havido freqüentes guerras."},{text:"29 E Simão, filho de Matatias, da prosápia de Jarib, e seus irmãos se expuseram ao perigo, e resistiram aos inimigos da sua nação, para susterem o seu santo templo, e a sua lei: E levaram o seu povo a uma grande glória."},{text:"30 E Jônatas congregou os da sua nação, e foi feito sumo sacerdote dêles: E foi-se unir aos seus povos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 E os inimigos dos judeus quiseram espezinhar, e destruir o seu país e alçar as mãos contra o seu santo templo."},{text:"32 Então lhes resistiu Simão, e pelejou pelo seu povo, e distribuiu muito dinheiro, e armou os mais valentes da sua nação, e lhes deu sôldo:"},{text:"33 E fortificou as cidades da Judéia e a de Betsura, que era nas suas fronteiras, onde seus inimigos tinham feito antes sua praça de armas: E pôs nela uma guarnição de judeus."},{text:"34 E fortificou a Jope, que estava sôbre a costa do mar: E a Gazara, que está na fronteira de Azot, onde antes habitavam os inimigos: E pôs nelas judeus que as guardassem: E as proveu de tôdas as coisas necessárias para"},{text:"a sua defensa."},{text:"35 E viu o povo os feitos de Simão, e o que êle fazia por exaltar a glória da sua nação, e êles o constituíram seu chefe, e príncipe dos sacerdotes, pelo motivo de ter êle obrado tudo isto, e pela justiça, e fidelidade,"},{text:"que tinha guardado à sua nação, e por ter procurado por todos os meios exaltar a sua gente."},{text:"36 E em seus dias tudo foi próspero nas suas mãos, de maneira que os estrangeiros foram banidos do seu país, e também os que estavam em Jerusalém, na cidade de Davi na fortaleza, da qual faziam as suas sortidas, e"},{text:"profanavam tudo o que há no contôrno do Santuário, e faziam um grande ultraje a sua santidade:"},{text:"37 E pôs ali soldados judeus para segurança do país, e da cidade, e levantou os muros de Jerusalém."},{text:"38 E o rei Demétrio o confirmou no sumo pontificado."},{text:"39 Depois disto lhe deu o título de seu amigo, e o elevou a uma grande glória."},{text:"40 Porque ouviu dizer que os romanos tinham chamado aos judeus seus amigos, e aliados, e irmãos, e que tinham recebido os embaixadores de Simão com grande honra:"},{text:"41 E que os judeus, e os seus sacerdotes tinham consentido que êle fôsse seu chefe, e sumo sacerdote para sempre, até que se levantasse um profeta fiel:"},{text:"42 E que tivesse sôbre êles autoridade de chefe, e que tomasse sôbre si o cuidado das coisas santas, e que designasse quais haviam de ter a intendência sôbre as obras públicas, e sôbre a província, e sôbre as armas, e"},{text:"sôbre os presídios:"},{text:"43 Vigiasse outrossim na guarda dos santos lugares: E que a êle obedecessem todos, e em nome dêle fôssem escritos todos os instrumentos públicos do país: E que andasse vestido de púrpura, e ouro."},{text:"44 E que a nenhum do povo, nem dos sacerdotes fôsse permitido violar alguma destas coisas, nem contradizer a nada do que êle ordenasse, nem colocar junta alguma na província sem a sua autoridade, nem vestir púrpura, nem"},{text:"usar fivela de ouro:"},{text:"45 E o que obrasse contra esta ordenança, ou violasse qualquer parte dela, ficaria réu."},{text:"46 Aprouve pois a todo o povo constituir a Simão nesta grande autoridade, e executar todo o conteúdo nesta declaração."},{text:"47 E aceitou Simão o govêrno, e consentiu em fazer as funções do sumo pontificado e em ser chefe, e príncipe da nação dos judeus, e dos sacerdotes, e em ter o comando de tôdas as coisas."},{text:"48 E acordaram pôr esta declaração em pranchas de metal, e colocá-las na galeria do santuário, em lugar público:"},{text:"49 E guardar no erário uma cópia de tudo isto, para que tivessem ali êste título Simão, e seus filhos."},{text:"1 Macabeus — capítulo 15."},{text:"1 Então o rei Antíoco, filho de Demétrio, remeteu das ilhas do mar cartas a Simão, sumo sacerdote, e príncipe do povo dos judeus, e a tôda a sua nação:"},{text:"2 E o seu conteúdo era desta maneira: O rei Antíoco a Simão, sumo sacerdote e à nação dos judeus, saúde:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E assim faço tenção de entrar nos meus estados para me vingar daqueles que têm danificado as minhas províncias, e que têm assolado muitas cidades no meu reino."},{text:"5 Eu pois te remito agora todos os impostos, que todos os reis meus predecessores te remitiram e te confirmo em tôdas as imunidades que êles te concederam:"},{text:"6 E eu te dou licença que batas moeda do teu cunho no teu país:"},{text:"7 E que Jerusalém seja uma cidade santa, e livre: E que tôdas as armas que mandaste fazer, e tôdas as praças fortes, as quais tu construíste, e tens em teu poder, fiquem para ti."},{text:"8 E tôdas as dívidas do rei: E as regalias que o rei devia haver, desde agora e para sempre, te são perdoadas."},{text:"9 E quando nós tivermos entrado na posse do nosso reino, te faremos a ti, e à tua nação, e ao templo, grandes honras, de maneira que fique manifesta a vossa glória em tôda a terra."},{text:"10 No ano cento e setenta e quatro entrou Antíoco no reino de seus país, e tôdas as tropas vieram logo oferecer-se a êle, de sorte que poucas ficaram com Trifão."},{text:"11 E o rei Antíoco o perseguiu, e êle Trifão veio para Dora, fugindo pela costa do mar."},{text:"12 Porque sabia que sôbre êle estavam os males iminentes, e que o exército o desamparara:"},{text:"13 E Antíoco caiu sôbre Dora com cento e vinte mil homens de guerra, e oito mil cavalos:"},{text:"14 E pôs cêrco à cidade, e os navios a bloquearam pela parte do mar: E a tinham em apêrto por mar, e por terra, sem deixarem entrar nem sair pessoa alguma."},{text:"15 Entretanto chegaram de Roma Numenio, e os que tinham ido com êle, trazendo cartas escritas aos reis, e a diversos povos, nas quais se continha o seguinte:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"16 LÚCIO, cônsul dos romanos, ao rei Ptolomeu, saúde."},{text:"17 Os embaixadores dos judeus, que são nossos amigos, vieram ter conosco, enviados por Simão, príncipe dos sacerdotes, e pelo povo dos judeus, a fim de renovarem a antiga aliança, e amizade que há entre nós."},{text:"18 E êles trouxeram também um escudo de ouro de mil minas."},{text:"19 Nós pois resolvemos escrever aos reis e aos povos, que lhes não façam mal nenhum, que não acometam nem a êles, nem as suas cidades, nem as suas províncias: E que não dêem socorro aos que pelejarem contra êles."},{text:"20 Ora nós julgamos que devíamos aceitar o escudo que êles nos trouxeram."},{text:"21 Se pois alguns homens corrompidos saíram do país dêles para se refugiarem entre vós, remetei-os a Simão, príncipe dos sacerdotes, para que êle os faça castigar conforme a sua lei."},{text:"22 Estas mesmas coisas escreveram ao rei Demétrio, e a Atalo, e a Ariarates, e a Arsaces:"},{text:"23 E a tôdas as terras: E a Lâmpsaco, e aos lacedemônios, e a Delos, e a Mindo, e a Sicionia, e a Caria, e a Samos, e a Panfília, e a Lícia, e a Halicarnasso, e a Cós, e a Siden, e a Arado, e a Rodes, e a Faselida, e a"},{text:"Gortina, e a Gnido, e a Chipre, e a Cirene."},{text:"24 E destas cartas mandaram os romanos uma cópia a Simão, príncipe dos sacerdotes, e ao povo dos judeus."},{text:"25 O rei Antíoco, porém, pôs um segundo cêrco a Dora, sem nunca levantar mão do seu combate, e aplicando máquinas: E ali teve de tal sorte fechado a Trifão, que não podia sair:"},{text:"26 Então lhe mandou Simão um socorro de dois mil homens escolhidos, com dinheiro e ouro, e muitos vasos:"},{text:"27 Mas Antíoco os não quis receber, e rompeu todos os tratados, que tinha feito com êle antes, e se alienou dêle."},{text:"28 Depois enviou-lhe a Atenóbio, um dos seus confidentes, para tratar com Simão, dizendo-lhe da sua parte: Vós tendes entre vossas mãos a Jope, e a Gazara, e a fortaleza que está em Jerusalém, que são cidades do meu"},{text:"reino."},{text:"29 Tendes assolado os seus têrmos, e fizestes grande destrôço no país, e levantastes-vos com o senhorio de muitos lugares no meu reino."},{text:"30 Agora pois dai para cá as cidades que tomastes, e os tributos de diferentes lugares, em que vós dominastes fora das fronteiras da Judéia:"},{text:"31 E senão, pagai pelas cidades que retendes, quinhentos talentos de prata, e pelos estragos que fizestes, e tributos das cidades, outros quinhentos talentos: De outra sorte, nós iremos, e vos faremos guerra."},{text:"32 Veio pois Atenóbio, amigo do rei, a Jerusalém, e viu a glória de Simão, e as suas peças de ouro, e prata que brilhavam, e o seu grande aparato: E ficou maravilhado: Depois lhe referiu as palavras do rei."},{text:"33 E Simão lhe respondeu, e lhe disse: Nós não temos usurpado o país de ninguém, nem retemos os bens de outrem: Mas temos sòmente recuperado a herança de nossos país, que de certos tempos a esta parte estava injustamente"},{text:"possuída pelos nossos inimigos."},{text:"34 Assim que, tendo-nos sido favorável o tempo, nós nos tornamos a meter de posse da herança de nossos país."},{text:"35 Pelo que toca às queixas que nos fazes acêrca de Jope, e de Gazara, êles eram os que causavam muitos males entre o povo, e no nosso país: Entretanto nós estamos prontos a dar por estas cidades cem talentos. E Atenóbio"},{text:"não lhe respondeu uma só palavra."},{text:"36 Mas êle cheio de ira, tendo voltado para o rei, lhe deu parte destas razões, e da glória de Simão, e de tudo o que tinha visto, do que o rei ficou em grande extremo irritado."},{text:"37 Neste comenos fugiu Trifão numa nau para Ortosiada."},{text:"38 E o rei Antíoco deu a Cendebeu o comando de tôda a costa marítima, e lhe entregou um exército composto de infantaria, e cavalaria."},{text:"39 E ordenou-lhe que fizesse abalar o seu campo contra a fronteira da Judéia: E lhe mandou que reedificasse a Gedor, e tapasse as portas da cidade, e reduzisse o povo à fôrça das suas armas. Entretanto o rei perseguia a"},{text:"Trifão."},{text:"40 E Cendebeu chegou a Jamnia, e começou a vexar o povo, e a espezinhar a Judéia, e a fazer um grande número de prisioneiros, e a matar gente, e a reedificar Gedor."},{text:"41 E pôs ali cavalaria, e gente de pé: Para que saindo fizessem correrias pelas terras da Judéia, em conformidade do que lhe tinha mandado o rei."},{text:"1 Macabeus — capítulo 16."},{text:"1 Veio João de Gazara, e contou a Simão, seu pai, tudo o que Cendebeu fizera contra o seu povo."},{text:"2 E Simão fêz vir a seus dois filhos mais velhos, Judas e João, e lhes disse: Eu, e meus irmãos, e a casa de meu pai temos desbaratado os inimigos de Israel desde a nossa mocidade até o dia de hoje: E neste nosso manejo"},{text:"temos tido a ventura de livrar a Israel, por várias vêzes."},{text:"3 tools — see the cookie policy for details"},{text:"4 Depois disto escolheu de todo o país vinte mil homens de guerra, e soldados de cavalo; e os dois marcharam contra Cendebeu: E pernoitaram em Modin."},{text:"5 E levantaram-se ao romper da manhã, e marcharam para o campo: E eis-que vinha em demanda dêles um grosso exército de infantaria, e cavalaria, e em meio dêles havia uma impetuosa torrente."},{text:"6 E abalou êle com a sua gente para os atacar, e como viu que as suas tropas estavam receosas de passar a torrente, por essa causa a passou êle primeiro: e quando os outros o viram fazer esta ação, logo passaram atrás"},{text:"dêle."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Macabeus Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 E dividiu a sua gente em dois corpos, e pôs no meio da infantaria a cavalaria: Porque a cavalaria dos inimigos era muito numerosa."},{text:"8 E assim que fizeram soar as sagradas trombetas, logo Cendebeu fugiu com as suas tropas: E caíram mortos das feridas muitos dêles: E o resto se recolheu precipitadamente à fortaleza."},{text:"9 Nesta ocasião foi ferido Judas, irmão de João: E João perseguiu os inimigos até chegar a Cedron, que Cendebeu tinha reedificado:"},{text:"10 E muitos fugiram para as tôrres que havia na campina de Azot, e João as fêz queimar. E morreram dêles dois mil homens, e João voltou em paz para a Judéia:"},{text:"11 E Ptolomeu, filho de Abóbo, tinha sido feito governador da campina de Jericó, e tinha muita prata, e muito ouro:"},{text:"12 Porque era genro do sumo sacerdote."},{text:"13 E o seu coração se elevou de soberba, e queria fazer-se senhor do país, e andava maquinando alguma aleivosia contra Simão, e seus filhos para os matar."},{text:"14 Simão porém, correndo as cidades, que havia no país da Judéia, e tratando cuidadosamente de as pôr em ordem, baixou a Jericó êle, e Matatias, seu filho, e Judas, ano cento e setenta e sete, no undécimo mês: Que é o"},{text:"mês Sabat."},{text:"15 E o filho de Abóbo os recebeu com má tenção num pequeno forte, que tinha edificado, o qual se chamava Doc: e mandou-lhes fazer um grande banquete, e escondeu ali homens."},{text:"16 Quando pois Simão, e seus filhos tinham bebido bem, levantou-se Ptolomeu com a sua gente, e tomaram as suas armas, e entraram na sala do banquete, e mataram a Simão, e a seus dois filhos, e alguns dos seus criados:"},{text:"17 Dêste modo executou Ptolomeu em Israel uma grande perfídia, e tornou mal por bem."},{text:"18 E escreveu Ptolomeu isto ao rei, e lhe mandou pedir que lhe enviasse um exército em seu socorro, e êle lhe entregaria o país e cidades dêles, e os tributos."},{text:"19 Ao mesmo tempo mandou outros a Gazara para matarem a João: E enviou cartas aos tribunos para que viessem unir-se com êle, prometendo que lhes daria ouro, e prata, e presentes."},{text:"20 E mandou outros a fazerem-se senhores de Jerusalém, e do monte do templo."},{text:"21 Mas prevenindo-os certo homem, foi avisar a João em Gazara, que seu pai, e seus irmãos tinham sido mortos, e que Ptolomeu tinha também enviado gente para o matarem a êle."},{text:"22 Êle porém assim que ouviu isto, ficou espavorido em extremo: E fêz apanhar os que vinham matá-lo, e mandou-lhes tirar a vida: Porque conheceu que êles vinham com tenção de o matar."},{text:"23 O resto porém da vida de João, e das suas guerras, e das gloriosas facções, em que valorosamente se portou, e da reedificação dos muros, que construiu, e das ações que obrou:"},{text:"24 Eis-aí que tudo isto está escrito no livro dos anais do seu pontificado, começando desde o tempo em que êle foi constituído príncipe dos sacerdotes em lugar de seu pai."}]}] 1
