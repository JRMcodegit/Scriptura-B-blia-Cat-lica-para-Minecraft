give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 31",author:"Pe. A. P. de Figueiredo",pages:[{text:"18 Bendito o Senhor Deus de Israel, que faz maravilhas só:"},{text:"19 E bendito o nome da sua majestade para sempre: E encher-se-á da sua majestade tôda a terra: Assim seja, assim seja."},{text:"20 Acabaram-se os louvores de Davi filho de Jesse."},{text:"Salmos — capítulo 72."},{text:"1 Salmo de Asaf. Quão bom é Deus para Israel! Para os que são retos de coração."},{text:"2 Os meus pés por pouco não vacilaram: Por pouco se não transtornaram os meus passos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque êles não atendem à sua morte: E não há firmeza na sua ferida."},{text:"5 Não participam dos trabalhos dos homens, nem com os homens serão flagelados:"},{text:"6 Portanto os possui a soberba, cobertos estão da sua iniqüidade, e impiedade."},{text:"7 Como da gordura nasceu a sua maldade: Se transformaram segundo o afeto do seu coração."},{text:"8 Cogitaram, e falaram maldade: Iniqüidade falaram em alto."},{text:"9 Puseram no céu a sua bôca: E a língua dêles foi discorrendo pela terra."},{text:"10 Por isto se voltará aqui o meu povo: E serão achados nêles os dias cheios."},{text:"11 E disseram: Acaso Deus sabe isto, e tem disto notícia o Altíssimo?"},{text:"12 Eis-aqui os mesmos pecadores, e os que abundam no século têm adquirido riquezas."},{text:"13 E disse: Logo em vão justifiquei o meu coração, e lavei entre os inocentes as minhas mãos:"},{text:"14 Pois tenho sido afligido todo o dia, e castigado desde a manhã."},{text:"15 Se dizia: Contá-lo-ei assim: Via que condenava a nação de teus filhos."},{text:"16 Pensava para entender isto, trabalho é êste aos meus olhos:"},{text:"17 Até que eu entre no santuário de Deus: E aprenda qual será o fim dêles."},{text:"18 Certamente por causa dos seus enganos lhes mandaste males: Derribaste-os quando se elevavam."},{text:"19 Como os que são postos em desolação, repentinamente feneceram. Pereceram pela sua maldade."},{text:"20 Como sonho dos que despertam, tornarás, Senhor, em nada a imagem dêles, na tua cidade."},{text:"21 Porque se inflamou o meu coração, as minhas entranhas se comoveram:"},{text:"22 Também eu fui reduzido ao nada, e não o entendi."},{text:"23 Como jumento me tenho feito diante de ti: E eu estarei sempre contigo."},{text:"24 Tomaste-me pela minha mão direita: E me conduziste segundo a tua vontade, e com glória me acolheste."},{text:"25 Pois que tenho eu no céu? E fora de ti, que desejei eu sôbre a terra?"},{text:"26 Desfaleceu a minha carne, e o meu coração: Deus do meu coração, e minha porção, Deus para sempre."},{text:"27 Pois eis-aqui, os que se apartam de ti perecerão: Acabaste com todos os que te quebrantam a fé."},{text:"28 Mas para mim me é bom unir-me a Deus: E pôr no Senhor Deus a minha esperança: Para anunciar todos os teus louvores nas portas da filha de Sião."},{text:"Salmos — capítulo 73."},{text:"1 De inteligência de Asaf. Por que razão, ó Deus, nos hás desamparado para sempre? Incendido está o teu furor sôbre as ovelhas do teu pasto?"},{text:"2 Lembra-te da tua congregação, que possuíste desde o princípio. Tu redimiste a porção da tua herança: O monte de Sião em que te aprouve habitar."},{text:"3 tools — see the cookie policy for details"},{text:"4 E os que te aborreceram, gloriaram-se: No meio da tua solenidade. Puseram os seus estandartes, em grande número,"},{text:"5 e não os conheceram, bem como nas portas sôbre o mais alto. Como em um bosque de árvores com machados,"},{text:"6 destroçaram à uma as suas portas: Com machado e camartelo a derribaram."},{text:"7 Abrasaram em fogo ao teu Santuário: Na terra profanaram o tabernáculo do teu nome."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 32",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Disseram no seu coração os das suas parentelas todos juntamente: Façamos cessar da terra tôdas as festas de Deus."},{text:"9 Não temos visto os nossos sinais: Já não há profeta: E não nos conhecerá daqui em diante."},{text:"10 Até quando, ó Deus, nos afrontará o inimigo: Blasfemará o adversário o teu nome até ao fim?"},{text:"11 Por que retrais a tua mão, e a tua direita do meio do teu seio até ao fim?"},{text:"12 Mas o Deus Rei nosso antes dos séculos: Obrou a salvação no meio da terra."},{text:"13 Tu com o teu poder deste solidez ao mar: Moeste as cabeças dos dragões nas águas."},{text:"14 Tu quebraste as cabeças do dragão: Deste-o por comida aos povos da Etiópia."},{text:"15 Tu abriste as fontes, e os ribeiros: Tu secaste os rios de Etan."},{text:"16 Teu é o dia, e tua é a noite: Tu fabricaste a aurora e o sol."},{text:"17 Tu fizeste todos os limites da terra: o estio e a primavera tu os formaste."},{text:"18 Lembra-te disto: O inimigo improperou ao Senhor: E um povo néscio irritou o teu nome."},{text:"19 Não entregues às feras as almas que te louvam, e não ponhas em esquecimento para sempre as almas dos teus pobres."},{text:"20 Olha para o teu testamento: Porque os obscurecidos da terra são os que estão cheios de casas de iniqüidade."},{text:"21 Não se volte confundido o humilde: O pobre, e o desvalido louvarão o teu Nome."},{text:"22 Levanta-te, ó Deus, julga a tua causa: Lembra-te dos impropérios feitos contra ti, daqueles com que um povo néscio te injuria todo o dia."},{text:"23 Não te esqueças das vozes de teus inimigos: A soberba daqueles que te aborrecem, sobe continuamente."},{text:"Salmos — capítulo 74."},{text:"1 Para o fim, não destruas, Salmo de Cântico de Asaf."},{text:"2 Nós te glorificaremos, ó Deus: Confessaremos, e invocaremos o teu Nome. Cantaremos as tuas maravilhas:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Tem-se liqüidado a terra, e todos os que a habitam: Eu fortaleci as suas colunas."},{text:"5 Disse aos malvados: Não cometais maldade: E aos que pecam: Não vos glorieis do poder."},{text:"6 Não queirais levantar ao alto vosso poder: Não queirais falar iniquamente contra Deus."},{text:"7 Porque nem do Oriente, nem do Ocidente, nem dos montes desertos:"},{text:"8 Porque Deus é o Juiz. A êste humilha, e àquele exalta:"},{text:"9 Porque na mão do Senhor está o cálice de vinho puro cheio duma mistura. E deitou dêste naquele: Certamente as suas fezes não se apuraram: Delas beberão todos os pecadores da terra."},{text:"10 Mas eu anunciarei pelo século: Cantarei ao Deus de Jacó."},{text:"11 E quebrarei tôdas as fôrças dos pecadores: E será exaltada a glória do justo."},{text:"Salmos — capítulo 75."},{text:"1 Para o fim, para louvar, Salmo de Asaf, Cântico aos assírios."},{text:"2 Conhecido é Deus na Judéia; em Israel grande é o seu nome."},{text:"3 tools — see the cookie policy for details"},{text:"4 Ali quebrou as fôrças dos arcos, o escudo, a espada, e a guerra."},{text:"5 Fazendo brilhar a tua luz maravilhosa desde os montes eternos."},{text:"6 Todos os néscios de coração ficaram perturbados. Dormiram o seu sono: E nada acharam nas suas mãos todos êstes homens de riquezas."},{text:"7 À tua ameaça, ó Deus de Jacó, adormeceram os que montam em cavalos."},{text:"8 Tu és terrível, e quem te resistirá? desde que aparece a tua ira."},{text:"9 Desde o céu fizeste ouvir o teu juízo: A terra tremeu e ficou em sossêgo."},{text:"10 Quando se levantou Deus a juízo, para salvar a todos os humildes da terra."},{text:"11 Porque o homem que considere te louvará: E as memórias que hão de ficar te farão dia festivo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 33",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 Fazei votos ao Senhor vosso Deus, e cumpri-os todos os que ao redor dêle lhe trazeis oferendas. Ao terrível,"},{text:"13 e ao que tira o espírito aos príncipes, ao que é terrível aos reis da terra."},{text:"Salmos — capítulo 76."},{text:"1 Para o fim, para Iditun, Salmo de Asaf."},{text:"2 Com a minha voz clamei ao Senhor: Levantei a minha voz a Deus, e êle me atendeu."},{text:"3 tools — see the cookie policy for details"},{text:"4 Lembrei-me de Deus, e me deleitei, e me exercitei: E desmaiou o meu espírito."},{text:"5 Adiantaram-se às vigílias os meus olhos: Fiquei perturbado, e não falei."},{text:"6 Pensei nos dias antigos: E tive na mente os anos eternos."},{text:"7 E meditei de noite no meu coração, e me exercitava, e purificava o meu espírito."},{text:"8 Porventura nos desamparará Deus para sempre: E não se mostrará ainda inclinado a aplacar-se?"},{text:"9 Ou cortará para sempre a sua misericórdia, de geração em geração?"},{text:"10 Ou se esquecerá Deus de usar clemência? Ou demorará com a sua ira as suas misericórdias?"},{text:"11 E disse: Agora começo! Esta mudança vem da destra do Altíssimo."},{text:"12 Lembrei-me das obras do Senhor: Porque me lembrei das tuas maravilhas desde o princípio."},{text:"13 E meditarei em tôdas as tuas obras: E considerarei em todos os teus conselhos."},{text:"14 O teu caminho, ó Deus, é em santidade: Que Deus há grande como o nosso Deus?"},{text:"15 Tu és o Deus que obras maravilhas. Fizeste conhecer nos povos o teu poder:"},{text:"16 Redimiste com teu braço ao teu povo, aos filhos de Jacó e de José."},{text:"17 Viram-te as águas, ó Deus, viram-te as águas: E temeram, e foram turbados os abismos."},{text:"18 Com grandíssimo estrondo caíram as águas: As nuvens fizeram soar a voz. Porque as tuas setas traspassam:"},{text:"19 A voz do teu trovão fuzilou sôbre as rodas. Fulguraram os teus relâmpagos pela redondeza da terra: Estremeceu e tremeu a terra."},{text:"20 No mar abriste o teu caminho, e os teus atalhos no meio das muitas águas: E não serão conhecidos os teus vestígios."},{text:"21 Conduziste o teu povo como ovelhas, pela mão de Moisés e de Aarão."},{text:"Salmos — capítulo 77."},{text:"1 De inteligência a Asaf. Escutai a minha lei, povo meu, inclinai os vossos ouvidos às palavras da minha bôca."},{text:"2 Abrirei em parábolas a minha bôca: Falarei coisas ocultas desde o princípio."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êles não as ocultaram a seus filhos, nem à seguinte geração. Contando os louvores do Senhor, e o seu poder, e as maravilhas que êle obrou."},{text:"5 Estabeleceu testemunho em Jacó: E pôs lei em Israel. As quais coisas mandou êle a nossos pais que fizessem conhecer a seus filhos:"},{text:"6 Para que as soubesse a geração seguinte. Os filhos que hão de nascer, e se hão de levantar, o contarão também a seus filhos,"},{text:"7 para que ponham em Deus a sua esperança, e não se esqueçam das obras de Deus: E busquem com cuidado os seus mandamentos."},{text:"8 Não se façam como seus pais, geração má e rebelde. Geração que não encaminhou reto o seu coração: Nem o seu espírito foi leal com Deus."},{text:"9 Os filhos de Efraim, destros em entesar o arco e em despedir dêle as flechas, voltaram as costas no dia da batalha."},{text:"10 Não guardaram a aliança feita com Deus: E não quiseram andar na sua lei."},{text:"11 E se esqueceram dos seus benefícios, e das suas maravilhas que obrou à vista dêles."},{text:"12 Diante de seus pais fêz maravilhas na terra do Egito, no campo de Tanis."},{text:"13 Dividiu o mar, e por êle os fêz passar: E recolheu as águas como em odre."},{text:"14 E os conduziu de dia, por uma nuvem: E tôda a noite com resplendor de fogo."},{text:"15 Fendeu a pedra no ermo: E deu-lhes a beber águas como em um grande abismo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 34",author:"Pe. A. P. de Figueiredo",pages:[{text:"16 E tirou água da pedra: E fêz correr as águas como rios."},{text:"17 E tornaram ainda a pecar contra êle: Moveram a ira do Altíssimo num lugar sem água."},{text:"18 E tentaram a Deus nos seus corações: Pedindo iguarias que fôssem do seu gôsto."},{text:"19 E falaram mal de Deus. Disseram: Porventura poderá Deus preparar uma mesa no deserto?"},{text:"20 Porque feriu a pedra, e correram águas, e as torrentes inundaram. Porventura poderá também dar pão, ou aparelhar mesa para o seu povo?"},{text:"21 Portanto ouviu o Senhor, e deferiu: E um fogo se incendeu contra Jacó, e cresceu a ira contra Israel."},{text:"22 Porque não creram em Deus, nem esperaram na salvação dêle."},{text:"23 E mandou às nuvens de cima, e abriu as portas do céu."},{text:"24 E lhes choveu o maná para comer, e lhes deu pão do céu."},{text:"25 Pão dos anjos comeu o homem: E lhes enviou manjares em abundância."},{text:"26 Retirou do céu o Austro: E pela sua virtude fêz mover o Áfrico."},{text:"27 E choveu sôbre êles carnes como pó: e as aves de asas como as areias do mar."},{text:"28 E caíram no meio dos seus alojamentos: Em roda das suas tendas."},{text:"29 E comeram e fartaram-se muito, e cumpriu-lhes o seu desejo."},{text:"30 Não ficaram defraudados do que apeteceram. Ainda estavam as suas iguarias na bôca dêles:"},{text:"31 Quando a ira de Deus se elevou sôbre êles. E matou os poderosos dêles, e derribou os escolhidos de Israel."},{text:"32 Sôbre tudo isto pecaram ainda: E não creram nas suas maravilhas."},{text:"33 E passaram os seus dias em coisas vãs: E os seus anos com grande fadiga."},{text:"34 Quando os fazia morrer, o buscavam: E se convertiam, e ao amanhecer vinham a êle."},{text:"35 Lembraram-se que Deus é seu ajudador: E que o Deus excelso é seu Redentor."},{text:"36 Amaram-no com a sua bôca, e com a sua língua lhe mentiram:"},{text:"37 Mas o seu coração não era reto com êle: Nem se mantiveram leais na sua aliança."},{text:"38 Mas êle é misericordioso, e perdoará os seus pecados: E não os destruirá. E êle deteve muitas vêzes a sua ira: E não acendeu contra êles todo o seu furor."},{text:"39 E lembrou-se que são carne: Sôpro que passa, e não torna."},{text:"40 Quantas vêzes o irritaram no deserto, o moveram à ira no lugar sem água?"},{text:"41 E voltaram, e tentaram a Deus: E exacerbaram ao Santo de Israel."},{text:"42 Não se lembraram do seu poder, no dia que os redimiu do jugo do opressor."},{text:"43 De como fêz resplandecer no Egito os seus sinais, e os seus prodígios no campo de Tanis."},{text:"44 E converteu em sangue os seus rios, e as suas águas, para que não bebessem delas."},{text:"45 Enviou sôbre êles todo o gênero de moscas, que os comeram: E rãs, que os destruíram."},{text:"46 E entregou os seus frutos à alforra: E as suas searas aos gafanhotos."},{text:"47 E destruiu com saraiva as vinhas dêles: E os seus amoreirais com geada."},{text:"48 E entregou à saraiva os seus animais: E as suas possessões ao fogo."},{text:"49 Enviou sôbre êles a ira da sua indignação: Indignação, e ira, e tribulação: Por ministério dos anjos maus."},{text:"50 Abriu caminho ao atalho da sua ira, não perdoou a vida às suas almas: E envolveu na mortandade aos seus animais."},{text:"51 E feriu a todo o primogênito na terra do Egito: As primícias de todo o trabalho dêles nas tendas de Cam."},{text:"52 E fêz sair o seu povo como ovelhas: E guiou-os como um rebanho no deserto."},{text:"53 E tirou-os fora esperançados, e não temeram: E sepultou no mar a seus inimigos."},{text:"54 E os introduziu depois no monte da sua santificação, monte que êle adquiriu com a sua destra. E expulsou da face dêles as gentes: E repartiu-lhes por sorte a terra distribuída com cordas:"},{text:"55 E deu as tendas dêles por morada às tribos de Israel."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 35",author:"Pe. A. P. de Figueiredo",pages:[{text:"56 E tentaram, e irritaram de novo ao Deus excelso: E não guardaram os seus preceitos."},{text:"57 E lhe voltaram as costas, e não observaram a aliança: Assim como os pais dêles se voltaram em arco atravessado."},{text:"58 Êles o incitaram à ira nos seus outeiros: E com os seus ídolos que esculpiram lhe inflamaram o seu zêlo."},{text:"59 Ouviu-os Deus, e os desprezou: E reduziu a Israel ao extremo abatimento."},{text:"60 E rejeitou o tabernáculo de Silo, seu próprio tabernáculo, onde morou entre os homens,"},{text:"61 e entregou a cativeiro a fôrça dêles: E a sua formosura nas mãos do inimigo."},{text:"62 E encerrou com espada ao seu povo: E desprezou a sua própria herança."},{text:"63 O fogo devorou aos seus mancebos: E as suas virgens não foram choradas."},{text:"64 Os seus sacerdotes pereceram à espada: E as suas viúvas não eram choradas."},{text:"65 E despertou-se o Senhor como quem dorme, como um valente embriagado do vinho."},{text:"66 E feriu a seus inimigos abaixo das espáduas: Eterna ignomínia lhes deu."},{text:"67 E rejeitou o tabernáculo de José: E não escolheu a tribo de Efraim:"},{text:"68 Mas escolheu a tribo de Judá, o monte de Sião a quem amou."},{text:"69 E edificou como o unicórnio o seu Santuário na terra, que fundou pelos séculos."},{text:"70 E escolheu a Davi seu servo e o tomou dos apriscos das ovelhas: E o tirou do cuidado das fecundas."},{text:"71 Para que apascentasse a Jacó seu servo, e a Israel sua herança:"},{text:"72 E apascentou-os segundo a inocência do seu coração: E com suas mãos hábeis os conduziu."},{text:"Salmos — capítulo 78."},{text:"1 Salmo de Asaf. Ó Deus, vieram as nações à tua herança, contaminaram o teu santo templo: Tornaram Jerusalém como cabana de guardar frutas."},{text:"2 Deram os cadáveres dos teus servos por comida às aves do céu: As carnes dos teus santos aos animais da terra."},{text:"3 tools — see the cookie policy for details"},{text:"4 Temos chegado a ser o opróbrio de nossos vizinhos: O escárnio e a mofa daqueles que estão em roda de nós."},{text:"5 Até quando, Senhor, te hás de irar sem aplacar-te: Até quando se acenderá como fogo o teu zêlo?"},{text:"6 Derrama a tua ira sôbre as nações, que te não conhecem: E sôbre os reinos que não invocaram o teu nome."},{text:"7 Porque êle tem devorado a Jacó: E tem assolado a sua casa."},{text:"8 Não te lembres de nossas antigas maldades, antecipem-se logo as tuas misericórdias: Porque temos sido reduzidos a extrema miséria."},{text:"9 Ajuda-nos, ó Deus, Salvador nosso: E pela glória do teu nome, Senhor, livra-nos: E perdoa os nossos pecados, por amor do teu nome."},{text:"10 Para que não digam talvez as gentes: Onde está o Deus dêles? e se divulgue tal blasfêmia entre as nações ante os nossos olhos. A vingança do sangue dos teus servos, que foi derramado:"},{text:"11 Os gemidos dos que estão em cadeias cheguem à tua presença. Segundo a grandeza do teu braço, conserva os filhos dos que foram mortos."},{text:"12 E dá a nossos vizinhos sete tantos no seio dêles: Seja opróbrio dos mesmos aquilo com que, Senhor, te improperavam."},{text:"13 Mas nós que somos povo teu, e ovelhas do teu pasto, te glorificaremos para sempre: De geração em geração publicaremos o teu louvor."},{text:"Salmos — capítulo 79."},{text:"1 Para o fim, para aquêles que hão de ser mudados, testemunho de Asaf, Salmo."},{text:"2 Tu que governas a Israel, atende: Tu que conduzes a José como uma ovelha. Tu que estás sentado sôbre os querubins, manifesta-te"},{text:"3 tools — see the cookie policy for details"},{text:"4 Ó Deus, converte-nos: E mostra-nos o teu rosto, e seremos salvos."},{text:"5 Senhor Deus dos exércitos, até quando estarás irado, sem ouvir a oração do teu servo?"},{text:"6 Sustentar-nos-ás com pão de lágrimas: E nos darás bebida de lágrimas com abundância?"},{text:"7 Puseste-nos em contradição a nossos vizinhos: E nossos inimigos fizeram escárnio de nós."},{text:"8 Deus das virtudes, converte-nos: Mostra-nos o teu rosto, e seremos salvos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 36",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Trasladaste a tua vinha do Egito: Lançaste fora as gentes, e plantaste-a em seu lugar."},{text:"10 Guia fôste no caminho diante dela: Fizeste-a arraigar, e ela tem enchido a terra."},{text:"11 A sombra dela cobriu os montes: E as suas ramas excederam os cedros de Deus."},{text:"12 Estendeu as suas vides até ao mar: E até ao rio os seus mergulhões."},{text:"13 Para que destruíste o seu muro: E a vindimam todos os que passam pelo caminho?"},{text:"14 O javali da selva a destruiu: E a fera solitária a devorou."},{text:"15 Deus dos exércitos, volta-te: Olha desde o céu, atende, e visita esta vinha."},{text:"16 E acaba de aperfeiçoar a que plantou a tua destra: E olha para o filho do homem, que confirmaste para ti."},{text:"17 Ela foi queimada a fogo, e escavada: às ameaças de teu rosto perecerão."},{text:"18 Seja a tua mão sôbre o varão da tua destra: E sôbre o filho do homem que confirmaste para ti."},{text:"19 E não nos apartamos de ti, tu nos darás vida: E invocaremos o teu nome."},{text:"20 Senhor Deus dos exércitos, converte-nos: E mostra-nos o teu rosto, seremos salvos."},{text:"Salmos — capítulo 80."},{text:"1 Para o fim, para os lagares, Salmo para o mesmo Asaf."},{text:"2 Regozijai-vos louvando a Deus nosso ajudador: Celebrai ao Deus de Jacó."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tocai a trombeta na Neomênia, no dia sinalado da vossa solenidade:"},{text:"5 Porque está mandado em Israel: E é estatuto em honra do Deus de Jacó."},{text:"6 Ordenou-o por testemunho a José, quando saía da terra do Egito: quando ouviu uma língua, que não entendia."},{text:"7 Descarregou do pêso ao seu ombro: E as suas mãos que haviam servido de acarretar com cêsto."},{text:"8 Na tribulação me invocaste, e te livrei: Eu te ouvi no escondido da tempestade: Fiz prova de ti junto à água da contradição."},{text:"9 Ouve, povo meu, e eu te declararei a minha vontade, Israel, se me ouvires,"},{text:"10 não haverá em ti Deus novo, nem adorarás Deus estranho."},{text:"11 Porque eu sou o Senhor teu Deus, que te tirei da terra do Egito: Abre bem a tua bôca, e eu ta encherei."},{text:"12 E não ouviu o meu povo a minha voz: E Israel não me atendeu."},{text:"13 E os abandonei segundo os desejos do seu coração, êles irão caminhando atrás das invenções da sua fantasia."},{text:"14 Se o meu povo me houvera ouvido: Se Israel tivera andado nos meus caminhos:"},{text:"15 Em nada teria o haver sem dúvida humilhado a seus inimigos: E houvera descarregado a minha mão sôbre os que os atribulavam."},{text:"16 Os inimigos do Senhor mentiram-lhe: E durará o tempo dêles por todos os séculos."},{text:"17 E deu-lhes a comer da gordura do trigo: E os fartou de mel da pedra."},{text:"Salmos — capítulo 81."},{text:"1 Salmo de Asaf. Deus assistiu sempre no conselho dos deuses: No meio dêles julga os mesmos deuses."},{text:"2 Até quando julgareis injustamente: E tereis respeito às faces dos pecadores?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Tirai ao pobre: E livrai o desvalido da mão do pecador."},{text:"5 Não souberam, nem entenderam, andam em trevas: Serão abalados todos os fundamentos da terra."},{text:"6 Eu disse: Sois deuses, e todos filhos do Excelso."},{text:"7 Mas vós como homens morrereis: E caireis como um dos príncipes."},{text:"8 Levanta-te, ó Deus, julga a terra: Porque tu herdarás em tôdas as gentes."},{text:"Salmos — capítulo 82."}]}] 1
