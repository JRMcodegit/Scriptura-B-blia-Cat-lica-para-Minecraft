give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 27",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 Visitaste a terra, e embriagaste-a: Enriqueceste-a de muitas maneiras. O rio de Deus se encheu de águas, preparaste a comida de seus habitantes: Porque tal é a disposição dela."},{text:"11 Embriaga os seus ribeiros, multiplica as suas produções: Nas chuvas que se distilam alegrar-se-á a terra dando frutos."},{text:"12 Bendirás a coroa do ano da tua bondade: E os teus campos se encherão de abundância."},{text:"13 As selvas amenas se engrossarão: E se cingirão de regozijo os outeiros."},{text:"14 Vestidos estão os carneiros dos rebanhos, e os vales abundarão de trigo: Gritarão, porque dirão hinos."},{text:"Salmos — capítulo 65."},{text:"1 Para o fim, Cântico do Salmo da Ressurreição. Celebrai a Deus todos os da terra,"},{text:"2 dizei salmo ao seu nome: Dai a glória ao seu louvor."},{text:"3 tools — see the cookie policy for details"},{text:"4 A terra tôda te adore, e te cante a ti salmo: Diga salmo ao teu nome."},{text:"5 Vinde, e vêde as obras de Deus: Terrível nos conselhos sôbre os filhos dos homens."},{text:"6 Êle tornou o mar em sêco, pelo rio passarão a pé enxuto: Ali nos alegraremos com êle."},{text:"7 Êle domina pelo seu poder para sempre, os olhos dêle estão olhando sôbre as gentes: Os que o irritam não se ensoberbeçam dentro de si mesmos."},{text:"8 Bendizei, ó Gentes, o nosso Deus: E fazei que se ouça a voz do seu louvor."},{text:"9 O qual tornou a minha alma em vida: E não permitiu que vacilassem os meus pés."},{text:"10 Porquanto nos provaste, ó Deus: Com fogo nos afinaste, como se afina a prata."},{text:"11 Puseste-nos em cadeias, carregaste tribulações sôbre nossas costas:"},{text:"12 Puseste homens sôbre as nossas cabeças. Passamos pelo fogo e pela água: E nos tiraste para o lugar do refrigério."},{text:"13 Entrarei na tua casa com holocaustos: Pagar-te-ei os meus votos,"},{text:"14 que pronunciaram os meus lábios. E proferiu a minha bôca na minha tribulação."},{text:"15 Oferecer-te-ei holocaustos pingues com perfumes de carneiros: Oferecer-te-ei bois com cabritos."},{text:"16 Vinde, ouvi todos os que temeis a Deus, e vos referirei quão grandes coisas tem feito à minha alma."},{text:"17 A êle pela minha bôca clamei, e o exaltei com a minha língua."},{text:"18 Se eu visse iniqüidade pegada no meu coração, não me ouviria o Senhor."},{text:"19 Por isso ouviu Deus, e atendeu à voz da minha deprecação."},{text:"20 Bendito Deus que não rejeitou a minha oração, nem apartou a sua misericórdia de mim."},{text:"Salmos — capítulo 66."},{text:"1 Para o fim, sôbre os hinos, Salmo de Cântico de Davi."},{text:"2 Deus tenha piedade de nós, e nos abençoe: Faça resplandecer seu rosto sôbre nós, e tenha piedade de nós."},{text:"3 tools — see the cookie policy for details"},{text:"4 Glorifiquem-te a ti, ó Deus, os povos: glorifiquem-te os povos todos."},{text:"5 Alegrem-se e regozijem-se as gentes: Porquanto julgas os povos em eqüidade, e governas as gentes sôbre a terra."},{text:"6 Glorifiquem-te a ti, ó Deus, os povos: Glorifiquem-te os povos todos:"},{text:"7 A terra deu o seu fruto. Abençoe-nos Deus, o nosso Deus,"},{text:"8 abençoe-nos Deus: E temam-no todos os limites da terra."},{text:"Salmos — capítulo 67."},{text:"1 Para o fim, Salmo de Cântico do mesmo Davi."},{text:"2 Levante-se Deus, e sejam dispersos os seus inimigos, e fujam da sua presença os que o aborrecem."},{text:"3 tools — see the cookie policy for details"},{text:"4 E os justos banqueteiem-se, e regozijem-se na presença de Deus: E gozem-se em alegria."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 28",author:"Pe. A. P. de Figueiredo",pages:[{text:"5 Cantai a Deus, dizei salmo ao seu Nome: Preparai o caminho àquele que sobe sôbre o Ocidente: O Senhor é o seu Nome. Regozijai-vos diante dêle, turbados ficarão seus inimigos pela presença daquele que é"},{text:"6 pai de órfãos, e juiz de viúvas. Deus está no seu lugar santo."},{text:"7 Deus que faz morar os de uns costumes em casa: Que tira os presos com fortaleza, como também àqueles que o irritam, os quais moram em sepulcros."},{text:"8 Ó Deus, quando saías à vista do teu povo, quando passavas pelo deserto."},{text:"9 A terra foi comovida, e os céus distilaram águas ante a face do Deus de Sinai, ante a face do Deus de Israel."},{text:"10 Chuva voluntária porás à parte, ó Deus, para a tua herança: A que tem estado debilitada, mas tu a aperfeiçoaste."},{text:"11 Nela morarão os da tua grei: Está, ó Deus, preparado o sustento para o pobre na tua doçura."},{text:"12 O Senhor dará palavra aos que com grande virtude dão boas novas."},{text:"13 O rei dos exércitos será do amado, do amado: E a formosura da casa é o repartir os despojos."},{text:"14 Se dormirdes entre o meio das sortes, sereis como as penas da pomba argentadas, e os remates do lombo dela em amarelidão de ouro."},{text:"15 Enquanto o rei do céu faz juízo dos reis sôbre a nossa terra, os seus habitantes tornar-se-ão brancos como a neve no Selmon:"},{text:"16 O monte de Deus, monte pingue. Monte coagulado, monte pingue:"},{text:"17 Mas por que pensais em montes coagulados? Monte é êste, em que se agradou Deus de morar: Porque o Senhor morará nêle até ao fim."},{text:"18 O carro de Deus vai rodeado com muitas dezenas de milhares, milhares são os que se alegram: O Senhor está entre êles no seu santuário, como estivera no Sinai."},{text:"19 Subiste ao alto, fizeste escrava a escravidão: Tomaste dons para distribuíres aos homens: Ainda aos que não criam, que habitava o Senhor Deus entre êle