give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 E o teu coração se elevou no teu esplendor: Tu perdeste a tua sabedoria na tua formosura, eu te lancei por terra: Eu te expus diante da face dos reis, para que êles te vissem."},{text:"18 Tu violaste a tua santidade pela multidão das tuas iniqüidades, e pelas injustiças do teu comércio: Eu pois farei sair do meio de ti um fogo que te devore, e te reduzirei em cinza sôbre a terra, aos olhos de todos os"},{text:"que te virem."},{text:"19 Todos os que te virem entre as nações ficarão espantados de ti: Tu fôste aniquilado, e não tornarás mais a ser."},{text:"20 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"21 Filho do homem, vira o teu rosto para Sidônia: E profetizarás sôbre ela."},{text:"22 E dirás: Isto diz o Senhor Deus: Eis-aqui venho eu a ti, ó Sidônia, e eu serei glorificado no meio de ti: E saberão que eu sou o Senhor quando tiver nela excitado os meus juízos, e nela fôr santificado."},{text:"23 E farei atear nela peste, e correr o sangue pelas suas ruas: E cairão no meio dela mortos à espada por todos os seus contornos: E saberão que eu sou o Senhor."},{text:"24 E Sidônia não será mais para a casa de Israel um tropêço de amargura, e uma espinha que cause dor de tôdas as partes ao redor daqueles que lhe são contrários: E saberão que eu sou o Senhor Deus."},{text:"25 Isto diz o Senhor Deus: Quando eu tiver ajuntado a casa de Israel de entre os povos, em que têm andado dispersos, serei eu santificado nêles aos olhos das gentes: E êles habitarão na sua terra, que eu dei a meu servo"},{text:"Jacó."},{text:"26 E habitarão nela sem temor algum: E edificarão casas e plantarão vinhas, e viverão numa inteira segurança, quando eu tiver exercitado os meus juízos sôbre todos os que são seus adversários em contôrno: E saberão que"},{text:"eu sou o Senhor Deus dêles."},{text:"Ezequiel — capítulo 29."},{text:"1 No dia onze do décimo mês do ano décimo, me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, põe o teu rosto contra Faraó, rei do Egito, e profetizar-lhe-ás tudo o que está para acontecer a êle, e ao Egito:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E te porei nos queixos um freio: E prenderei os peixes dos teus rios às tuas escamas: E eu te tirarei para fora do meio dos teus rios, e todos os teus peixes estarão pegados às tuas escamas:"},{text:"5 E te lançarei para o deserto, e a todos os peixes do teu rio: Tu cairás sôbre a face da terra, não te levantarão nem te sepultarão: Eu te dei por pasto às alimárias da terra, e às aves do céu:"},{text:"6 E todos os habitantes do Egito saberão que eu sou o Senhor: Pois que tu fôste para a casa de Israel um bordão de cana."},{text:"7 Quando êles te tomaram na mão, e tu te quebraste, e lhes rasgaste todo o ombro, e quando êles cuidavam que se seguravam em ti, tu te fizeste em pedaços, e lhes fizeste arrebentar todos os seus rins."},{text:"8 Por esta causa isto diz o Senhor Deus: Eis-aí vou eu a fazer cair a espada sôbre ti: E eu matarei dentre vós os homens e as alimárias."},{text:"9 E a terra do Egito será reduzida a um deserto, e uma solidão: E êles saberão que eu sou o Senhor: Porque tu disseste: O rio é meu, e eu é que o fiz."},{text:"10 Por isso eis-me aqui contra ti, e contra os teus rios: E mudarei a terra do Egito numas solidões, depois que a guerra a tiver assolado, desde a tôrre de Siene até os confins da Etiópia."},{text:"11 Não passará por ela pé de homem, nem andará nela pé de alimária: E não será habitada quarenta anos:"},{text:"12 E porei a terra do Egito já deserta na classe dos países desertos, e as suas cidades na classe das cidades destruídas, e elas estarão desoladas quarenta anos: E espalharei para diversas nações aos egípcios, e os"},{text:"deitarei ao vento para várias terras."},{text:"13 Porque isto diz o Senhor Deus: Depois de findos quarenta anos, eu tornarei a ajuntar os egípcios do meio dos povos, para onde êles tinham sido espalhados:"},{text:"14 E tornarei a trazer os cativos do Egito, e os estabelecerei na terra de Fatures, na terra da sua nascença: E êles ficarão sendo ali um reino humilde:"},{text:"15 O Egito será o mais humilde de todos os reinos, e se não tornará mais a levantar por cima das nações, e eu os diminuirei, para que não dominem sôbre as gentes."},{text:"16 E não serão mais a confiança da casa de Israel, ensinando-lhes a iniqüidade, para que fujam de mim, e os sigam: E saberão que eu sou o Senhor Deus."},{text:"17 E no ano vinte e sete, no primeiro dia do primeiro mês, aconteceu isto: Foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"18 Filho do homem, Nabucodonosor, rei de Babilônia, me rendeu com o seu exército um grande serviço no cêrco de Tiro: Tôdas as cabeças ficaram calvas, e todos os ombros ficaram pelados: E contudo nem a êle, nem ao seu"},{text:"exército se deu alguma recompensa em atenção de Tiro, pelo serviço que me fêz na tomada dela."},{text:"19 Por cuja causa isto diz o Senhor Deus: Eis-aí vou eu pôr a Nabucodonosor, rei de Babilônia, na terra do Egito: E lhe tomará todo o povo, e fará dêle a sua prêsa, e repartirá os seus despojos: E esta será a recompensa"},{text:"que terá o seu exército."},{text:"20 E assim será pago do serviço que me fêz no cêrco desta cidade: E eu lhe entregarei a terra do Egito, porque êle trabalhou para mim, diz o Senhor Deus."},{text:"21 Naquele dia reflorescerá o poder da casa de Israel, e eu te abrirei a bôca no meio dêles: E saberão que eu sou o Senhor."},{text:"Ezequiel — capítulo 30."},{text:"1 E foi-me dirigida a palavra do Senhor, a qual dizia:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Filho do homem, profetiza e dize: Isto diz o Senhor Deus: Dai urros, ai, ai do dia:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E a espada virá ao Egito: E o pavor se apossará da Etiópia, quando êles caírem feridos no Egito, e fôr tirada a sua multidão, e destruídos os seus fundamentos."},{text:"5 A Etiópia, e a Líbia, e os lídios, e todos os outros povos, e Cub, e os filhos da terra do concêrto, cairão com êles debaixo do gume da espada."},{text:"6 Isto diz o Senhor Deus: E os que sustinham o Egito cairão, e a soberba do seu império será destruída: Êles cairão aos golpes da espada no Egito desde Siene, diz o Senhor Deus dos exércitos:"},{text:"7 E ficarão dispersos no meio de terras desoladas, e as suas cidades serão postas na classe das cidades desertas."},{text:"8 E êles saberão que eu sou o Senhor: Quando eu tiver pôsto fogo ao Egito, e fôrem desfeitos todos os que lhe davam auxílio."},{text:"9 Naquele dia sairão de diante da minha face mensageiros embarcados em galés para quebrar a ousadia da Etiópia, e haverá espanto entre êles no dia do Egito, porque êste dia chegará sem dúvida."},{text:"10 Isto diz o Senhor Deus: Eu farei cessar a multidão do Egito pela mão de Nabucodonosor, rei de Babilônia."},{text:"11 Êle mesmo, e o seu povo com êle, os mais fortes das gentes serão levados para perderem a terra: E desembainharão as suas espadas sôbre o Egito: E encherão a terra de mortos."},{text:"12 E secarei as madres dos rios, e entregarei a terra nas mãos dos péssimos: E destruirei esta terra, e tudo o que ela contém pela mão dos estrangeiros, eu, o Senhor, é que falei."},{text:"13 Isto diz o Senhor Deus: E exterminarei as estátuas, e farei cessar os ídolos de Mênfis: E não tornará mais a haver príncipe da terra do Egito: E eu espalharei o terror pela terra do Egito."},{text:"14 E arruinarei o país de Fatures, e meterei fogo em Tafnis, e exercitarei os meus juízos em Alexandria."},{text:"15 E derramarei a minha indignação sôbre Pelúsio, que é a fôrça do Egito, e farei morrer essa multidão de Alexandria."},{text:"16 E meterei fogo no Egito: Pelúsio sentirá dores como a mulher que está para parir, e Alexandria será destruída, e em Mênfis haverá quotidianos apertos."},{text:"17 Os mancebos de Heliópole e de Bubasto cairão mortos ao fio da espada, e as mulheres serão levadas cativas."},{text:"18 E o dia se fará negro em Tafnis, quando eu quebrar ali os ceptros do Egito, e faltar nêle a soberba do seu poder: Cobri-lo-á um nublado: E as suas filhas serão levadas para o cativeiro."},{text:"19 E exercitarei no Egito os meus juízos: E êles saberão que eu sou o Senhor."},{text:"20 E aconteceu no ano undécimo, no primeiro mês, aos sete do mês, que me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"21 Filho do homem, eu quebrei o braço de Faraó, rei do Egito: E eis-aí está que êle não foi envolvido, para se lhe restituir a saúde, para se atar com tiras, e se embrulhar em toalhas, para que, tendo recobrado a fôrça,"},{text:"pudesse menear a espada."},{text:"22 Portanto isto diz o Senhor Deus: Eis-me aqui contra Faraó, rei do Egito, e esmigalharei o seu braço forte, mas quebrado: E farei cair a espada da sua mão:"},{text:"23 E porei dispersos aos do Egito entre as gentes, e os lançarei ao vento por diversas terras."},{text:"24 Ao mesmo tempo eu fortificarei os braços do rei de Babilônia, e meter-lhe-ei a minha espada na sua mão: E quebrarei os braços de Faraó, e darão grandes gemidos os que fôrem mortos diante de seus olhos."},{text:"25 E fortificarei os braços do rei de Babilônia, e os braços de Faraó ficarão sem fôrça alguma: E êles saberão que eu sou o Senhor, quando eu meter a minha espada na mão do rei de Babilônia, e êle a estender sôbre a"},{text:"terra do Egito."},{text:"26 E porei dispersos aos do Egito entre as nações, e lançá-los-ei ao vento para diversas terras, e êles saberão que eu sou o Senhor."},{text:"Ezequiel — capítulo 31."},{text:"1 E aconteceu no ano undécimo, no terceiro mês, ao primeiro do mês, que me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, dize a Faraó, rei do Egito, e ao seu povo: A quem te tens tu assemelhado na tua grandeza?"},{text:"3 tools — see the cookie policy for details"},{text:"4 As chuvas o criaram, um grande conjunto de águas o fêz levantar-se muito alto: Os seus rios corriam em tôrno das suas raízes, e êle mandou os seus regatos a tôdas as árvores da circunvizinhança."},{text:"5 Por isso a sua altura se elevou sôbre tôdas as árvores do país: E se multiplicaram os seus braços, e se elevaram os seus ramos por causa das muitas águas."},{text:"6 E como êle atirava com a sua sombra a muito longe, tôdas as aves do céu fizeram os seus ninhos sôbre os seus ramos, e tôdas as alimárias dos bosques fizeram criação debaixo da sua copa, e um grande número de gentes"},{text:"habitava debaixo da sombra de suas fôlhas."},{text:"7 E era êle formosíssimo pela sua grandeza, e pela dilatada extensão de seus braços: Porque a sua raiz estava perto de grandes águas."},{text:"8 No jardim de Deus não havia cedros alguns mais altos do que êle; as faias não igualavam a sua altura, nem os plátanos lhe eram iguais na sua ramagem: Nenhuma árvore do jardim de Deus se assemelhou a êle, nem à sua"},{text:"formosura."},{text:"9 Porquanto eu o fiz vistoso, e de muitos, e espessos ramos: E tiveram dêle emulação tôdas as árvores deliciosas, que havia no jardim de Deus."},{text:"10 Por essa causa isto diz o Senhor Deus: Porque êste cedro se elevou na sua altura, e lançou tão alta a ponta dos seus verdes e copados ramos, e porque o seu coração se elevou na sua grandeza:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 Eu o entreguei nas mãos do mais forte das gentes, êle o tratará como me der na vontade: Eu o rejeitei, como a sua impiedade o merecia."},{text:"12 E uns estrangeiros, e os mais cruéis de todos os povos o cortarão pelo pé, e o lançarão sôbre os montes, e os seus ramos cairão de tôdas as partes ao longo dos vales, e os seus braços serão quebrados sôbre todos os"},{text:"rochedos da terra: E todos os povos do mundo se retirarão de estar debaixo da sua sombra, e o deixarão."},{text:"13 Tôdas as aves do céu habitaram nas suas ruínas, e tôdas as alimárias da terra se acolheram para debaixo da sua ramada."},{text:"14 Por isso tôdas as árvores plantadas sôbre as águas, não se elevarão na sua altura, nem estenderão o seu cume por entre a reboleira dos bosques e suas ramadas, nem essas árvores tôdas, que têm o regadio das águas, se"},{text:"susterão na sua elevação: Porque todos foram entregues à morte, lançados no fundo da terra, no meio dos filhos dos homens, entre aquêles que descem ao lago."},{text:"15 Isto diz o Senhor Deus: No dia em que êle desceu aos infernos, fiz eu que houvesse um grande luto, eu o cobri do abismo: E detive os rios que o regavam, e coibi as grandes águas: O Líbano se entristeceu com a sua"},{text:"caída, e tôdas as árvores do campo estremeceram."},{text:"16 Eu comovi as gentes ao estampido da sua ruína, quando eu o conduzia ao inferno, com os que descem ao lago: E se consolaram no fundo da terra tôdas as árvores de deleite, egrégias, e preclaras do Líbano, tôdas as que"},{text:"eram regadas com as águas."},{text:"17 Porque também êsses mesmos com êle descerão ao inferno entre os que foram mortos pela espada: E o braço de cada um se assentará à sua sombra no meio das nações."},{text:"18 A quem te assemelhaste tu, ó ínclito e sublime entre as árvores das delícias? Eis-aí fôste precipitado com tôdas essas árvores deliciosas no fundo da terra: Tu dormirás no meio dos incircuncidados, com os que foram"},{text:"mortos pela espada. Tal é a sorte de Faraó, e de todo o seu povo, diz o Senhor Deus."},{text:"Ezequiel — capítulo 32."},{text:"1 E aconteceu que, no ano duodécimo, no mês duodécimo, ao primeiro do mês, me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, faze pranto sôbre Faraó, rei do Egito, e dir-lhe-ás: Tu te assemelhaste ao leão das gentes, e ao dragão, que está no mar: E tu ferias com as pontas tudo o que estava nos teus rios, e turbavas as águas"},{text:"com os teus pés, e pisavas as correntes delas."},{text:"3 tools — see the cookie policy for details"},{text:"4 E te arrojarei em terra, lançar-te-ei sôbre a face do campo: E farei pousar sôbre ti tôdas as aves do céu, e fartarei do teu corpo as alimárias de tôda a terra."},{text:"5 E espalharei as tuas carnes por cima dos montes e encherei os teus outeiros do teu sangue podre."},{text:"6 E regarei a terra por cima dos montes com o cheiro insuportável do teu sangue, e os vales ficarão cheios do que tiver saído de ti."},{text:"7 E enlutarei o céu, quando fôres morto, e farei enegrecer as suas estrêlas: Encobrirei o sol com uma nuvem, e a lua não dará a sua luz."},{text:"8 Eu farei que todos os lumiares do céu se entristeçam sôbre a tua perda: E espalharei as trevas sôbre a tua terra, diz o Senhor Deus, quando os teus feridos caírem no meio da terra, diz o Senhor Deus."},{text:"9 E farei bramir o coração de muitos povos, quando tiver espalhado a nova da tua ruína entre as gentes sôbre uns países que tu não conheces."},{text:"10 E farei com que muitos povos fiquem atônitos à vista da tua perda: E deixar-se-ão por causa dela os seus reis possuir em extremo de um formidável horror, quando a minha espada começar a voar sôbre os rostos dêles: E"},{text:"se espantará repentinamente cada um, desconfiando da sua própria vida no dia da tua ruína."},{text:"11 Porque isto diz o Senhor Deus: A espada do rei de Babilônia virá sôbre ti."},{text:"12 Eu pelas espadas dos fortes desfarei as tuas numerosas tropas: Todos êstes povos são inexpugnáveis: E êles destruirão a soberba do Egito e tôda a sua multidão será dissipada."},{text:"13 E farei perecer tôdas as suas alimárias, que se criavam ao longo das muitas águas: E não nas turvará jamais pé de homem, nem unha de alimárias as enlodará."},{text:"14 Então tornarei eu puríssimas as suas águas, e farei correr os seus rios como o azeite, diz o Senhor Deus:"},{text:"15 Quando eu tiver desolado a terra do Egito: Será porém despojada a terra de quanto nela há, quando eu ferir a todos os seus habitadores: E êles saberão que eu sou o Senhor."},{text:"16 Êste é o pranto que tu deves fazer, e desta sorte é que hão de chorar a Faraó: As filhas das gentes os lamentarão: Sôbre o Egito e sôbre a sua multidão, o chorarão, diz o Senhor Deus."},{text:"17 E aconteceu que no ano duodécimo, aos quinze do mês, me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"18 Filho do homem, canta um cântico lúgubre sôbre todo o povo do Egito: E precipita-o a êle mesmo, e às filhas das gentes fortes na terra mais baixa com aquêles que descem ao lago."},{text:"19 Em que és mais estimável? Desce, e dorme com os incircuncidados."},{text:"20 Êles cairão todos no meio daqueles que foram mortos à espada: Foi dada a espada, precipitaram-no a êle, e a todos os seus povos."},{text:"21 Do meio do inferno virão falar-lhe os mais poderosos dentre os fortes, que lá desceram com os que tinham vindo no seu socorro e que, tendo passado pelo fio da espada, morreram incircuncidados."},{text:"22 Ali está Assur, e tôda a sua multidão de povo: Os seus sepulcros estão ao redor dêle: Todos êles foram mortos, e os mesmos que caíram a golpes da espada,"},{text:"23 cujos sepulcros foram postos no mais profundo do lago: E todo o seu povo foi sepultado ao redor do seu sepulcro, tôda esta turbamulta de mortos, e que pereceram à espada, os quais noutro tempo tinham causado terror na"},{text:"terra dos viventes."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"24 Ali está Elam, e todo o seu povo ao redor do seu sepulcro: Todos êstes são os que foram mortos, e passados ao fio da espada: Os que desceram incircuncidados aos mais baixos lugares da terra: Os que difundiram o seu"},{text:"terror na terra dos viventes, e que levaram sôbre si a ignomínia com os que descem ao lago."},{text:"25 Êles puseram o leito dêle entre todos os seus povos no meio dos quais foram postos mortos: Os seus sepulcros estão ao redor dêle: Todos êstes são uns incircuncidados e foram passados ao fio da espada: Porque"},{text:"infundiram o seu terror na terra dos viventes, e levaram sôbre si a ignomínia com os que descem ao lago: Êles foram postos no meio dos que tinham sido mortos."},{text:"26 Ali se acha Mosoc e Tubal, e todo o seu povo: Os seus sepulcros estão ao redor dêle: Todos êstes são uns incircuncidados e foram mortos, e caíram debaixo da espada: Porque difundiram o seu terror na terra dos"},{text:"viventes."},{text:"27 E não dormiram com os valentes, e que caíram mortos, e com os incircuncidados, que desceram ao inferno com as suas armas, e que puseram as suas espadas debaixo das suas cabeças, e as suas iniqüidades penetraram até os"},{text:"seus ossos: Porque êles se fizeram o terror dos fortes na terra dos viventes."},{text:"28 Tu pois serás também reduzido em pó no meio dos incircuncidados, e dormirás com os que foram passados ao fio da espada."},{text:"29 Ali a Iduméia, e os seus reis, e todos os seus capitães, que com o seu exército foram postos entre aquêles que foram mortos à espada: E que dormiram com os incircuncidados, e com os que descem ao lago."},{text:"30 Ali todos os príncipes do Aquilão, e todos os caçadores: Que foram conduzidos com os que tinham sido mortos, todos tremendo, e todos confusos, apesar da sua ferocidade: Que morreram incircuncidados, com os que tinham"},{text:"perecido a golpes da espada, também êles levaram sôbre si a sua confusão com os que descem ao lago."},{text:"31 Faraó os viu, e êle se consolou sôbre tôda a sua multidão, que foi morta pelo gume da espada, Faraó os viu, e todo o seu exército, diz o Senhor Deus:"},{text:"32 Porque eu espalhei o meu terror pela terra dos viventes, e dormi no meio dos incircuncidados, com os que tinham sido mortos pela espada: Faraó, e todo o seu povo, diz o Senhor Deus."},{text:"Ezequiel — capítulo 33."},{text:"1 Foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, fala aos filhos do teu povo, e tu lhes dirás: Quando eu tiver feito vir a espada sôbre uma terra, e o povo desta terra tomar um homem dos ínfimos dentre êles, e o constituir por Atalaia para vigiar"},{text:"sôbre êle."},{text:"3 tools — see the cookie policy for details"},{text:"4 E se ouvindo algum, seja êle quem quer que fôr, o som da trombeta, e não se guardar, e sobrevier a espada, e o matar: O seu sangue cairá sôbre a sua cabeça."},{text:"5 Êle ouviu o som da trombeta, e não se guardou, cairá sôbre êle o seu sangue: Mas se êle se guardar, salvará a sua alma."},{text:"6 Se ao contrário o Atalaia vir que vem a espada, e não tocar a trombeta: E o povo se não guardar, e vier a espada, e levar uma alma dentre êles: Êste tal foi por certo apanhado na sua iniqüidade, mas eu demandarei o seu"},{text:"sangue da mão do Atalaia."},{text:"7 Ora tu, filho do homem, tu és aquêle a quem eu constituí por Atalaia à casa de Israel: Tu pois, ouvindo as palavras da minha bôca, lhas anunciarás a êles da minha parte."},{text:"8 Se dizendo eu ao ímpio: ímpio, tu infalìvelmente morrerás: Não falares tu ao ímpio, para êle se guardar do seu caminho: Morrerá êsse ímpio na sua iniqüidade, mas eu requererei da tua mão o seu sangue."},{text:"9 Se advertindo tu porém o ímpio que se converta dos seus caminhos, êle se não converter do seu caminho: Morrerá êle na sua iniqüidade: Porém tu livraste a tua alma."},{text:"10 Tu pois, filho do homem, dize à casa de Israel: Assim falastes vós, dizendo: As nossas iniqüidades, e os nossos pecados estão sôbre nós, e nós apodrecemos nêles: Como poderemos nós logo viver?"},{text:"11 Responde-lhes assim: Eu juro por minha vida, diz o Senhor Deus: Que eu não quero a morte do ímpio, mas sim que o ímpio se converta do seu caminho, e viva. Convertei-vos, convertei-vos, deixando os vossos péssimos"},{text:"caminhos: E por que haveis vós de morrer, casa de Israel?"},{text:"12 Tu pois, filho do homem, dize aos filhos do teu povo: Em qualquer dia que o justo pecar, a sua justiça não no livrará: E em qualquer dia que o ímpio se converter da sua impiedade, a impiedade lhe não fará mal: E em"},{text:"qualquer dia que o justo venha a pecar, êle não poderá viver na sua justiça."},{text:"13 Ainda quando eu disser ao justo que terá vida, e êle confiado na sua justiça cometer a iniqüidade: Tôdas as suas obras de justiça serão entregues ao esquecimento, e êle, na sua iniqüidade que cometeu, nessa mesma"},{text:"morrerá."},{text:"14 Se porém depois que eu tiver dito ao ímpio: Tu certissimamente morrerás: E êle fizer penitência do seu pecado, e obrar conforme a retidão e a justiça,"},{text:"15 E se êsse ímpio restituir o penhor que lhe foi confiado, e se tornar a seu dono os bens que furtou, se andar nos mandamentos da vida, e não fizer nada de injusto: Êle viverá certissimamente, e não morrerá:"},{text:"16 Nenhum dos pecados que cometeu lhe será imputado: Êle fêz o que era reto e justo, assim certissimamente viverá."},{text:"17 Depois disto replicaram os filhos do teu povo: O caminho do Senhor não é justo, e o caminho dêles é injusto."},{text:"18 Porque quando o justo se apartar da sua justiça, e cometer obras de iniqüidade, êle morrerá nelas."},{text:"19 Pelo contrário, quando o ímpio deixar a sua impiedade, e fizer obras de retidão e justiça, êle viverá por elas."},{text:"20 Ainda assim dizeis vós: O caminho do Senhor não é reto. Casa de Israel, eu hei de julgar a cada um de vós segundo os seus próprios caminhos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 E aconteceu no ano duodécimo, no décimo mês, aos cinco do mês da nossa transmigração, que um homem que tinha fugido de Jerusalém, me veio buscar, dizendo: A cidade foi devastada."},{text:"22 Ora a mão do Senhor se me tinha dado a sentir na tarde do dia antecedente ao em que tinha chegado o homem que fugira: E abriu a minha bôca antes que o tal homem viesse ter comigo pela manhã, e tendo-me sido aberta a"},{text:"bôca, não fiquei mais em silêncio."},{text:"23 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"24 Filho do homem, os que habitam nessas casas arruinadas sôbre a terra de Israel, falando assim dizem: Abraão era um só homem, e êle possuiu esta terra por herança: Nós outros, porém, somos muitos, a nós é que foi dada"},{text:"esta terra para a possuirmos."},{text:"25 Dir-lhes-ás portanto: Isto diz o Senhor Deus: Vós que comeis as vossas viandas com sangue, e levantais os vossos olhos para as vossas imundícias, e que derramais o sangue alheio: Porventura possuireis esta terra como"},{text:"vossa herança?"},{text:"26 Vós sempre estivestes prontos para puxar pela espada, vós cometestes abominações, e cada um de vós tem violado a mulher de seu próximo: E então possuireis vós esta terra como herança?"},{text:"27 Tu lhes dirás isto: Assim diz o Senhor Deus: Eu juro por minha vida, que os que habitam nesses lugares arruinados, perecerão à espada: E os que estão nos campos, serão entregues às feras para que os devorem: E os que"},{text:"se acolheram aos lugares fortes, e às cavernas, morrerão de peste."},{text:"28 E reduzirei esta terra a uma solidão, e a um deserto, e desfalecerá a sua altiva fortaleza: E os montes de Israel serão desolados, sem que haja pessoa alguma que por êles passe."},{text:"29 E êles saberão que eu sou o Senhor, quando eu tiver assim tornado desolada e deserta a terra dêles por causa de tôdas as suas abominações, que êles têm cometido."},{text:"30 Quanto a ti, filho do homem: Os filhos do teu povo, que falam de ti junto dos muros, e às portas de suas casas, e dizem uns para os outros, cada um falando com o seu vizinho: Vinde, e ouçamos qual seja a palavra que"},{text:"sai da bôca do Senhor."},{text:"31 Pelo que êles vêm a ti, como um povo que se ajunta em bandos, e êles se assentam diante de ti como sendo meu povo: Mas êles ouvem as tuas palavras, e não fazem nada do que lhes dizes: Porque êles as mudam em cânticos"},{text:"que repassam pela sua bôca, entretanto que o seu coração segue a sua avareza."},{text:"32 E tu a seu respeito és como uma ária de música, que se canta por um modo doce e agradável: Assim é que êles ouvem as tuas palavras com gôsto, sem contudo fazerem o que tu lhes dizes."},{text:"33 Mas quando vier o que foi predito (como está a ponto de vir), então é que êles saberão que houve um profeta entre êles."},{text:"Ezequiel — capítulo 34."},{text:"1 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, profetiza sôbre os pastôres de Israel: Profetiza e dirás aos tais pastôres: Isto diz o Senhor Deus: Ai dos pastôres de Israel que se apascentavam a si mesmos: Não são os rebanhos os que são apascentados"},{text:"pelos pastôres?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Vós não fortalecíeis as que estavam fracas, e não curastes as que estavam enfermas, não ligastes os membros às que tinham algum quebrado, e não fizestes voltar as que andavam desgarradas, nem buscastes as que se tinham"},{text:"perdido: Mas vós domináveis sôbre elas com aspereza, e com império."},{text:"5 Assim as minhas ovelhas se espalharam, por não terem pastor: E elas se tornaram em prêsa de tôdas as alimárias do campo e se desgarraram."},{text:"6 Os meus rebanhos andaram erradios por todos os montes, e por todos os outeiros elevados: E os meus rebanhos se espalharam por tôda a face da terra, sem haver ninguém que os buscasse, sem haver ninguém, digo, que"},{text:"tomasse o trabalho de os buscar."},{text:"7 Por isso, ó pastôres, ouvi a palavra do Senhor:"},{text:"8 Eu juro por minha vida, diz o Senhor Deus: Que porque os meus rebanhos foram entregues à rapina, e as minhas ovelhas expostas a serem devoradas por tôdas as alimárias do campo, como quem não tinha pastor: Pois que os"},{text:"meus pastôres não buscaram o meu rebanho, mas só cuidavam êsses pastôres em se apascentarem a si mesmos e não davam pasto aos meus rebanhos:"},{text:"9 Ouvi portanto, ó pastôres, a palavra do Senhor:"},{text:"10 Isto diz o Senhor Deus: Eis-aí vou eu mesmo sôbre êstes pastôres a demandar o meu rebanho das mãos dêles, e fá-los-ei cessar, para que nunca mais apascentem rebanho, nem os tais pastôres se apascentem jamais a si"},{text:"mesmos: E livrarei o meu rebanho da sua bôca, e êle lhes não servirá mais para sua comida."},{text:"11 Porque isto diz o Senhor Deus: Eis-aí eu mesmo irei buscar as minhas ovelhas, e eu as visitarei."},{text:"12 Bem assim como um pastor visita o seu rebanho, no dia em que se acha no meio das suas ovelhas dispersas: Assim visitarei eu as minhas ovelhas, e eu as livrarei de todos os lugares por onde elas tinham andado dispersas"},{text:"no dia do nublado e da escuridade."},{text:"13 E eu as tirarei para fora dos povos, e as ajuntarei de diversos países, e as introduzirei na sua terra: E apascentá-las-ei sôbre os montes de Israel, ao longo das ribeiras, e em todos os lugares habitáveis do país."},{text:"14 Eu as levarei a pastar nas pastagens as mais férteis, e nos altos montes de Israel será o lugar da sua pastagem: Elas lá repousarão sôbre as verdes relvas, e pastarão sôbre os montes de Israel em pingues pastagens."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 27",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 E apascentarei as minhas ovelhas: E eu as farei repousar, diz o Senhor Deus:"},{text:"16 Eu irei buscar as que se tinham perdido, e farei voltar as que andavam desgarradas, e ligarei os membros às que tinham algum quebrado, e fortalecerei as que estavam fracas, e conservarei as que estavam gordas e"},{text:"fortes: E eu as apascentarei em justiça."},{text:"17 Mas vós, rebanhos meus, isto diz o Senhor Deus: Eis-aí julgo eu entre rez e rez, entre os carneiros e os bodes."},{text:"18 Acaso não vos bastava a vós nutrir-vos numas pastagens excelentes? Senão que sôbre isto ainda pisastes aos vossos pés o resto dos vossos pastos: E depois de terdes bebido uma água muito clara, turvareis com os vossos"},{text:"pés o resto."},{text:"19 Assim as minhas ovelhas vinham a apascentar-se do que tinha sido pisado com os vossos pés: E vinham a beber do que os vossos pés tinham turvado."},{text:"20 Por cuja causa isto diz o Senhor Deus a vós outros: Eis-aqui venho eu mesmo a julgar entre as rezes gordas, e as rezes magras:"},{text:"21 Pelo motivo de que vós com os vossos costados e ombros lhes dáveis encontrões, e com os jactos das vossas pontas lançáveis por êsses ares a tôdas as ovelhas magras, até serem com dispersão expulsadas fora:"},{text:"22 Eu salvarei o meu rebanho, e êle não servirá mais de prêsa, e eu julgarei entre ovelhas e ovelhas."},{text:"23 E suscitarei sôbre elas um único pastor, que as apascente, meu servo Davi: Êle mesmo as apascentará, e êste mesmo terá o lugar de seu pastor."},{text:"24 Eu porém, o Senhor, serei para elas o seu Deus: E meu servo Davi será no meio delas como o seu príncipe, eu o Senhor é que falei."},{text:"25 E farei com as minhas ovelhas um pacto de paz, e farei exterminar da terra as alimárias mais cruéis: E os que habitam no deserto, dormirão seguros no meio dos bosques."},{text:"26 E pô-los-ei ao redor do meu outeiro para bênção: E farei cair as chuvas a seu tempo: Elas serão umas chuvas de bênção."},{text:"27 E as árvores do campo darão o seu fruto, e a terra dará o seu gérmen, e as minhas ovelhas habitarão sem temor no seu país: E elas saberão que eu sou o Senhor, quando eu tiver quebrado as cadeias de seu jugo, e as"},{text:"tiver arrancado dentre as mãos dos que as dominavam com império."},{text:"28 E elas não serão mais a rapina das nações, nem as alimárias da terra as devorarão: Mas elas habitarão com tôda a segurança, sem terem nada que temer."},{text:"29 E eu lhes suscitarei um gérmen de grande nomeada: E êles não tornarão a ser consumidos pela fome sôbre a terra, nem trarão sôbre si mais o opróbrio das gentes."},{text:"30 E saberão que eu, o Senhor seu Deus, serei com êles, e êles, casa de Israel, serão o meu povo, diz o Senhor Deus."},{text:"31 Vós porém, rebanhos meus, vós rebanhos da minha pastagem, sois homens: E eu sou o Senhor vosso Deus, diz o Senhor Deus."},{text:"Ezequiel — capítulo 35."},{text:"1 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, põe a tua face contra o monte de Seir, e profetizarás acêrca dêle, e lhe dirás:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Eu demolirei as tuas cidades, e tu ficarás deserto: E saberás que eu sou o Senhor."},{text:"5 Porque tu fôste um inimigo eterno dos filhos de Israel, e os entregaste ao poder da espada no tempo da sua aflição quando a sua iniqüidade tinha chegado ao sumo."},{text:"6 Por isso eu juro por minha vida, diz o Senhor Deus: Que eu te entregarei ao sangue, e o sangue te perseguirá: E porque tu aborreceste o sangue, perseguir-te-á o sangue."},{text:"7 E eu tornarei o monte de Seir desolado e deserto: E desviarei dêle a todos os que por êle passarem, e tornarem a passar."},{text:"8 E encherei os seus cabeços dos seus mortos: Êles cairão passados a golpes de espada ao longo dos teus outeiros, e dos teus vales, e das tuas torrentes."},{text:"9 Eu te reduzirei a umas solidões eternas, e as tuas cidades não serão mais habitadas: E vós sabereis que eu sou o Senhor Deus."},{text:"10 Porque tu disseste: Duas nações, e dois países serão meus, e eu os possuirei como minha herança: Sendo que o Senhor estava presente em Israel:"},{text:"11 Por essa razão, eu juro por minha vida, diz o Senhor Deus, que eu te tratarei conforme a tua ira, e conforme o teu ciúme, que tu sempre mostraste cheio de ódio contra os israelitas: E que eu me farei conhecer por meio"},{text:"dêles, quando eu te julgar."},{text:"12 E saberás que eu, o Senhor, ouvi todos os teus opróbrios, que tu proferiste contra os montes de Israel dizendo: Êstes são uns montes desertos, que nos foram dados para nós os devorarmos."},{text:"13 E contra mim vos levantastes com a vossa bôca, e vibrastes contra mim as vossas palavras: Eu as ouvi."},{text:"14 Isto diz o Senhor Deus: Quando tôda a terra se alegrar, eu te reduzirei a uma solidão."},{text:"15 Bem como tu folgaste acêrca da herança da casa de Israel, porque foi destruída, assim me haverei eu contigo: Tu serás arruinado, monte de Seir, e tôda a Iduméia: E êles saberão que eu sou o Senhor."},{text:"Ezequiel — capítulo 36."},{text:"1 Tu porém, filho do homem, profetiza aos montes de Israel, e dir-lhes-ás: Montes de Israel, ouvi a palavra do Senhor:"},{text:"2 Isto diz o Senhor Deus: Porque o inimigo disse de vós: Bem feito, estas alturas eternas nos foram dadas para nossa herança."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 28",author:"Pe. A. P. de Figueiredo",pages:[{text:"3 tools — see the cookie policy for details"},{text:"4 Por esta causa ouvi, montes de Israel, a palavra do Senhor Deus: Isto diz o Senhor Deus aos montes, e aos outeiros, às torrentes, e aos vales, e aos desertos, aos pardieiros, e às cidades desamparadas, que foram"},{text:"despovoadas e insultadas pelas outras gentes ao redor."},{text:"5 Por cuja causa isto diz o Senhor Deus: Porquanto eu tenho falado no ardor do meu zêlo contra as outras gentes, e contra tôda a Iduméia, que se apropriaram a si a minha terra por herança com gôzo, e de todo o coração, e"},{text:"vontade: E lançaram fora dela os habitantes para a saquearem:"},{text:"6 Portanto profetiza sôbre a terra de Israel, e dirás aos montes e outeiros, aos cabeços e aos vales: Isto diz o Senhor Deus: Eis-aí falei eu no meu zêlo, e no meu furor, pelo motivo de terdes sofrido os opróbrios das"},{text:"gentes."},{text:"7 Pelo que isto diz o Senhor Deus: Eu levantei a minha mão, para que as gentes, que estão em tôrno de vós, essas mesmas tragam sôbre si a sua confusão."},{text:"8 E vós, montes de Israel, produzi os vossos ramos, e dai o vosso fruto ao meu povo de Israel: porque o tempo dêle vir está perto:"},{text:"9 Eis-aí que eu mesmo venho a vós, e eu me voltarei para vós, e vós sereis lavrados, e recebereis a semente."},{text:"10 E multiplicarei aos homens em vós e a tôda a casa de Israel: E as cidades serão habitadas, e os lugares arruinados serão restabelecidos."},{text:"11 E vos encherei de homens, e de alimárias: E êles se multiplicarão, e crescerão: E eu vos farei habitar como dantes, e vos darei uns bens ainda maiores, que os que vós tivestes desde o princípio: E vós sabereis que eu"},{text:"sou o Senhor."},{text:"12 E conduzirei sôbre vós uns homens, o meu povo de Israel, e êles te possuirão como sua herança: E tu serás a sua herança, e para o futuro te não acharás mais sem êles."},{text:"13 Isto diz o Senhor Deus: Já que dizem de vós outros: Tu és uma terra devoradora de homens, e sufocadora da tua gente:"},{text:"14 Por isso tu não comerás mais os homens, nem matarás mais a tua gente, diz o Senhor Deus:"},{text:"15 Eu farei que se não ouça mais em ti a confusão das gentes e tu não trarás mais sôbre ti o opróbrio dos povos e nem perderás mais a tua gente, isto diz o Senhor Deus."},{text:"16 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"17 Filho do homem, os da casa de Israel habitaram na sua terra, e êles a contaminaram com as suas obras, e com os seus afetos o caminho dêles se tornou diante de mim numa tal imundícia, como a da mulher menstruada."},{text:"18 E eu derramei a minha indignação sôbre êles por causa do sangue, que êles derramaram sôbre a terra, e dos seus ídolos com que a desonraram."},{text:"19 E eu os espalhei por diversas gentes, e êles foram enxotados para várias terras: Eu os julguei segundo os seus caminhos, e segundo as invenções do seu capricho."},{text:"20 E entraram no país das gentes, para onde foram, e lá desonraram o meu santo nome, quando se dizia dêles: Êste é o povo do Senhor e êstes os que saíram da sua terra."},{text:"21 E eu lhes perdoei por amor do meu santo nome, ao qual a casa de Israel tinha desonrado entre as gentes, para onde foram."},{text:"22 Por isso tu dirás à casa de Israel: Isto diz o Senhor Deus: Não é por amor de vós, casa de Israel, que eu farei o que estou para fazer, mas é por atenção ao meu santo nome, que vós tendes desonrado entre as gentes,"},{text:"para onde fôstes."},{text:"23 E eu santificarei o meu grande nome, que foi manchado entre as gentes, o qual vós desonrastes no meio delas: A fim de que as gentes saibam que eu sou o Senhor, diz o Senhor dos exércitos, quando eu tiver sido"},{text:"santificado a seus olhos no meio de vós."},{text:"24 Porque eu vos tirarei dentre as gentes, e vos congregarei de todos os países, e vos trarei para a vossa terra."},{text:"25 E derramarei sôbre vós uma água pura, e vós sereis purificados de tôdas as vossas imundícias, e eu vos purificarei de todos os vossos ídolos."},{text:"26 E dar-vos-ei um coração novo, e porei um novo espírito no meio de vós: E tirarei da vossa carne o coração de pedra, e dar-vos-ei um coração de carne."},{text:"27 E porei o meu espírito no meio de vós: E farei que vós andeis nos meus preceitos, e que guardeis as minhas ordenanças, e que as pratiqueis."},{text:"28 E vós habitareis na terra que eu dei a vossos pais: E vós sereis para mim o meu povo, e eu serei para vós o vosso Deus."},{text:"29 E eu vos salvarei de tôdas as vossas impuridades: E chamarei o trigo, e o multiplicarei, e não trarei fome sôbre vós."},{text:"30 E multiplicarei o fruto das árvores, e as produções dos campos, para que não tragais mais sôbre vós o opróbrio da fome entre as gentes."},{text:"31 E vós vos recordareis dos vossos péssimos caminhos, e dos vossos afetos não bons: E as vossas iniqüidades e os vossos crimes vos desagradarão."},{text:"32 Não é por amor de vós que eu farei isto, diz o Senhor Deus, tende-o assim entendido: Confundi-vos, e envergonhai-vos sôbre os excessos da vossa vida, casa de Israel."},{text:"33 Isto diz o Senhor Deus: No dia em que eu vos tiver purificado de tôdas as vossas iniqüidades, e tiver feito povoar as vossas cidades, e restabelecer os lugares arruinados."},{text:"34 E quando a terra deserta, que noutro tempo estava desolada aos olhos de todo o viandante, fôr cultivada,"},{text:"35 dirão: Esta terra, que estava inculta, tornou-se um como jardim de delícias: E as cidades que estavam desertas, e abandonadas, e arruinadas, ficaram com tôda a segurança fortificadas."},{text:"36 E tôdas as gentes, que tiverem ficado à roda de vós, saberão que eu, o Senhor, restabeleci os lugares arruinados, e cultivei os incultos, que eu o Senhor o tenho falado, e executado."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 29",author:"Pe. A. P. de Figueiredo",pages:[{text:"37 Isto diz o Senhor Deus: Ainda nisto me acharão favorável os da casa de Israel, para que eu lhes faça esta mercê: Eu os multiplicarei como um rebanho de homens."},{text:"38 Como um rebanho santo, como o rebanho de Jerusalém nas suas festas: Assim é que as cidades que estavam desertas, serão cheias de rebanhos de homens, e êles saberão que eu sou o Senhor."},{text:"Ezequiel — capítulo 37."},{text:"1 A mão do Senhor veio sôbre mim, e me tirou para fora pelo espírito do Senhor: E ela me deixou no meio de um campo, que estava cheio de ossos."},{text:"2 E ela me levou por tôda a roda dêles: Eram porém muitos em grande número os que se viam sôbre a face do campo, e todos sobremaneira secos."},{text:"3 tools — see the cookie policy for details"},{text:"4 E êle me disse: Vaticina acêrca dêstes ossos: E dir-lhes-ás: Ossos secos, ouvi a palavra do Senhor."},{text:"5 Isto diz o Senhor Deus a êstes ossos: Eis-aí vou eu a introduzir em vós o espírito, e vós vivereis."},{text:"6 E porei sôbre vós nervos, e farei crescer carnes sôbre vós, e sôbre vós estenderei pele: E dar-vos-ei o espírito, e vós vivereis e sabereis que eu sou o Senhor."},{text:"7 Eu pois vaticinei, como o Senhor me tinha mandado: E ao tempo que eu vaticinava, se ouviu um estrondo, e eis-aí se fêz um reboliço: E os ossos se chegaram uns para os outros, pondo-se cada um na sua juntura."},{text:"8 E olhei, e eis-que vieram sôbre tais ossos nervos, e carnes para os revestir: E nêles foi estendida a pele por cima, mas êles ainda não tinham o espírito."},{text:"9 Então me disse o Senhor: Vaticina ao espírito, vaticina, filho do homem, e dirás ao espírito: Isto diz o Senhor Deus: Espírito, vem dos quatro ventos, e assopra sôbre êstes mortos, e revivam."},{text:"10 Eu profetizei pois, como o Senhor me tinha ordenado: E entrou o espírito naqueles ossos, e viveram: E se levantaram sôbre seus pés feitos um exército numeroso em grande extremo."},{text:"11 Então me disse o Senhor: Filho do homem, todos êstes ossos são a casa de Israel: Êles dizem: Os nossos ossos se tornaram secos, e a nossa esperança se perdeu, e nós fomos cortados."},{text:"12 Por cuja causa vaticina, e dir-lhes-ás: Isto diz o Senhor Deus: Povo meu, eis-aí vou eu a abrir os vossos túmulos, tirar-vos-ei dos vossos sepulcros: E eu vos introduzirei na terra de Israel."},{text:"13 E vós sabereis, povo meu, que eu sou o Senhor, quando eu tiver aberto os vossos sepulcros, e vos tiver tirado dos vossos túmulos:"},{text:"14 E tiver infundido o meu espírito em vós e vós tiverdes recobrado a vida, e eu vos farei repousar sôbre a vossa terra: E vós sabereis que eu sou o Senhor que falei, e o fiz, diz o Senhor Deus."},{text:"15 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"16 Filho do homem, toma também tu um pedaço de tábua: E escreve sôbre êle: A favor de Judá, e a favor dos filhos de Israel seus sócios: E toma outro pedaço de tábua, e escreve nela: Por José lenho de Efraim, e por tôda a"},{text:"casa de Israel, e de seus sócios."},{text:"17 Depois ajunta êstes dois pedaços de tábua um ao outro para os unir: E êles ficarão sendo na tua mão um só pedaço de tábua."},{text:"18 E quando os filhos do teu povo te falarem, dizendo: Não nos descobrirás que é o que tu nos queres significar nisto?"},{text:"19 Tu lhes responderás: Isto diz o Senhor Deus: Eis-aí vou eu a tomar o lenho de José que está na mão de Efraim, e as tribos de Israel, que lhe estão unidas: Pô-las-ei juntas com o lenho de Judá, e fá-las-ei ajuntar num"},{text:"só lenho: E êles serão um só na sua mão."},{text:"20 E terás na tua mão diante de seus olhos êstes dois pedaços de tábua, sôbre que escreveres."},{text:"21 E lhes dirás: Isto diz o Senhor Deus: Eis-aí vou eu a tomar os filhos de Israel do meio das nações, para onde êles foram, e os ajuntarei de tôdas as partes e os tornarei a trazer para a sua terra."},{text:"22 E não farei dêles mais que um só povo na terra sôbre os montes de Israel, e será um só o Rei, que os comande a todos, e nunca mais serão duas nações, nem se dividirão para o futuro em dois reinos."},{text:"23 Êles se não mancharão mais nos seus ídolos, nem nas suas abominações, nem em tôdas as suas iniqüidades, e eu os tirarei salvos de todos os lugares, em que pecaram, e os purificarei: E êles serão para mim o meu povo, e"},{text:"eu serei para êles o seu Deus."},{text:"24 E o meu servo Davi reinará sôbre êles, e de todos êles será um só o pastor; êles andarão nas minhas ordenanças, e guardarão os meus preceitos, e praticá-los-ão."},{text:"25 E habitarão sôbre a terra que eu dei a meu servo Jacó, na qual vossos pais habitaram, e êles mesmos habitarão nela, êles e seus filhos, e os filhos de seus filhos para sempre: E meu servo Davi será para sempre o seu"},{text:"príncipe."},{text:"26 E farei com êles um concêrto de paz, o meu pacto com êles será eterno: E eu os estabelecerei sôbre um firme fundamento, e os multiplicarei, e porei para sempre o meu Santuário no meio dêles."},{text:"27 E o meu Tabernáculo estará entre êles: E eu serei o seu Deus, êles serão o meu povo."},{text:"28 E as nações saberão que eu sou o Senhor, o Santificador de Israel, quando o meu Santuário se conservar para sempre no meio dêles."},{text:"Ezequiel — capítulo 38."},{text:"1 E foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Filho do homem, firma bem a tua face contra Gog, contra a terra de Magog, contra êsse príncipe, e chefe de Mosoc, e de Tubal: E vaticina acêrca dêle."},{text:"3 tools — see the cookie policy for details"},{text:"4 E eu te farei andar à roda de uma para outra parte, e te porei um freio nos queixos: E te tirarei para fora a ti, e a todo o teu exército, aos cavalos e aos cavaleiros todos cobertos de couraças, um grande golpe de"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 30",author:"Pe. A. P. de Figueiredo",pages:[{text:"tropas brandindo lanças, e embraçando escudos, e empunhando espadas."},{text:"5 Os persas, os etíopes, e os da Líbia serão com êles, cobertos todos de escudos e de capacetes."},{text:"6 Gomer, e tôdas as suas tropas, a Casa de Togorma, que fica para o Aquilão, e tôdas as suas fôrças, e muitos cutros povos serão contigo."},{text:"7 Prepara-te, e dispõe-te com tôda essa numerosa multidão, que se ajuntou ao pé de ti: E sê-lhes o chefe de quem êles recebam as ordens."},{text:"8 Tu depois de um longo tempo serás visitado: No fim dos anos virás a esta terra, que foi salva da espada, e que sendo tirada de entre muitos povos, foi congregada para os montes de Israel, que têm perenemente estado"},{text:"desertos: Terra cujos habitantes foram tirados de entre os povos, e todos habitarão nela sem receio."},{text:"9 E avançando-te virás a ela como uma tempestade, e como uma nuvem, para cobrir a terra, tu, e todos os teus esquadrões, e muitos povos contigo."},{text:"10 Isto diz o Senhor Deus: Naquele dia subirão sôbre o teu coração certos projetos, e maquinarás péssimos desígnios:"},{text:"11 E dirás: Eu virei sôbre uma terra, que está sem muros: Atacarei umas gentes que estão em paz, e se acham estabelecidas com segurança: Tôdas estas habitam numas cidades sem muros, não têm ferrolhos nem portas."},{text:"12 Para saqueares os despojos, e te lançares sôbre a prêsa, para carregares a tua mão sôbre aquêles que tinham sido abandonados, e ao depois restabelecidos, e sôbre um povo que foi congregado do meio das gentes, que"},{text:"começou a estar de posse, e a ser habitador da eminência da terra."},{text:"13 Sabá, e Dedan, e os negociantes de Tarsis, e todos os seus leões te dirão: Acaso vens tu a tomar os despojos? eis-aí ajuntaste tu essa tua multidão para arrebatar a prêsa, para levares a prata, e o ouro, e para"},{text:"tirares os móveis, e a fazenda, e para furtares despojos infinitos."},{text:"14 Por isso tu, filho do homem, vaticina, e dirás a Gog, isto diz o Senhor Deus: Acaso naquele dia, quando o meu povo de Israel habitar com tôda a segurança, não o saberás tu?"},{text:"15 Virás pois do teu país, lá dos climas do Aquilão, tu, e muitos povos contigo, montados todos a cavalo, formados em grandes tropas, e num pujante exército."},{text:"16 E virás dar em cima do meu povo de Israel, como uma nuvem, de sorte que cubras a terra. Tu serás sôbre êle nos últimos dias, e eu te farei vir sôbre a minha terra: Para que as gentes me conheçam, quando eu fôr"},{text:"santificado em ti a seus olhos, ó Gog."},{text:"17 Isto diz o Senhor Deus: Tu pois és aquêle de quem eu falei nos séculos passados, por mão de meus servos os profetas de Israel, que profetaram nos dias daqueles tempos, que eu te faria vir sôbre êles."},{text:"18 E acontecerá naquele dia, no dia da chegada de Gog sôbre a terra de Israel, diz o Senhor Deus, que a minha indignação passará a ser o meu furor."},{text:"19 E falei no meu zêlo, no fogo da minha ira. Porque naquele dia haverá uma grande comoção sôbre a terra de Israel:"},{text:"20 E os peixes do mar, e as aves do céu, e as alimárias do campo, e todos os reptis, que se movem sôbre a terra, e todos os homens, que há sôbre a face da terra, tremerão diante da minha face: E os montes serão deitados"},{text:"abaixo, e cairão as sebes, e todos os muros virão à terra."},{text:"21 E chamarei contra êle a espada para cima de todos os meus montes, diz o Senhor Deus: A espada de cada um se voltará contra seu irmão."},{text:"22 E exercitarei os meus juízos sôbre êle pela peste e pelo sangue, e pelas chuvas veementes, e pelas pedras de extraordinária grossura: Eu derramarei chuvas de fogo, e de enxôfre sôbre êle, e sôbre o seu exército, e"},{text:"sôbre os muitos povos, que estão com êle."},{text:"23 E serei engrandecido e santificado: E serei conhecido aos olhos de muitas nações e saberão que eu sou o Senhor."},{text:"Ezequiel — capítulo 39."},{text:"1 Tu pois, filho do homem, vaticina contra Gog, e dir-lhe-ás: Isto diz o Senhor Deus: Eis-me aqui sôbre ti, Gog, príncipe e chefe de Mosoc e de Tubal:"},{text:"2 E eu te farei andar à roda de uma parte para a outra, e te tirarei para fora, e te farei vir das bandas do Aquilão: E eu te levarei para sôbre os montes de Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 Cairás sôbre os montes de Israel tu, e todos os teus esquadrões, e os teus povos, que são contigo: Eu te entregarei às feras, às aves, e a todo o animal volátil, e às alimárias da terra, para que te devorem."},{text:"5 Tu cairás sôbre a face do campo: Porque eu sou o que falei, diz o Senhor Deus."},{text:"6 E meterei o fogo em Magog, e nos que habitam confiadamente nas ilhas: E êles saberão que eu sou o Senhor."},{text:"7 E farei conhecido o meu santo nome no meio do meu povo de Israel, e não deixarei profanar mais o meu santo nome: E as gentes saberão que eu sou o Senhor, o Santo de Israel."},{text:"8 Eis-aí veio o tempo, e assim sucedeu diz o Senhor Deus: Êste é o dia de que falei."},{text:"9 E os habitantes das cidades de Israel sairão delas, e queimarão, e reduzirão em cinzas as armas, os escudos, e as lanças, os arcos, e as flechas, e os bordões que traziam nas mãos, e os piques: E êles as consumirão no"},{text:"fogo sete anos."},{text:"10 E não trarão lenha dos campos, nem a cortarão das matas: Porque êles farão fogo das suas armas, e farão prêsa daqueles de quem tinham sido prêsa, e roubarão aquêles que o tinham roubado, diz o Senhor Deus."},{text:"11 E acontecerá isto naquele dia: Eu darei a Gog em Israel um lugar célebre por sepulcro: O vale dos passageiros ao oriente do mar, que fará pasmar os que por êle passarem: E lá sepultarão a Gog, e a tôdas as suas"},{text:"tropas, e êste vale se chamará o vale das tropas de Gog."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 31",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 E os da casa de Israel os sepultarão por sete meses, para purgarem a terra."},{text:"13 E todo o povo da terra o sepultará, e será para êles célebre o dia em que eu fui glorificado, diz o Senhor Deus."},{text:"14 E êles constituirão homens, que incessantemente visitem a terra, para sepultarem e buscarem aquêles que tinham ficado sôbre a face da terra, a fim de a purificarem: Êles porém começarão a fazer esta busca depois de"},{text:"sete meses."},{text:"15 E girando correrão tôda a terra, e quando tiverem achado o osso de um homem, pôr-lhe-ão ao pé um sinal, até que os enterradores dos mortos o sepultem no vale das tropas de Gog."},{text:"16 E o nome da cidade será Amona e êles purificarão a terra."},{text:"17 Quanto a ti, filho do homem, isto diz o Senhor Deus: Dize a todo o animal volátil, e a tôdas as aves, e a tôdas as alimárias do campo: Vinde tôdas juntas, apressai-vos, concorrei de tôdas as partes à minha vítima, que"},{text:"eu vos sacrifico, a esta grande vítima degolada sôbre os montes de Israel, para que vós lhe comais a carne, e bebais o sangue."},{text:"18 Vós comereis as carnes dos fortes, e bebereis o sangue dos príncipes da terra: Dos carneiros, e dos cordeiros, e dos bodes, e dos touros, e das aves domésticas, e de tudo quanto é pingue."},{text:"19 E comereis a grossura até vos fartardes, e bebereis o sangue até que fiqueis embriagados, da vítima que eu vos sacrificarei:"},{text:"20 E vós vos fartareis sôbre a minha mesa da carne dos cavalos, e da carne dos cavaleiros valentes, e de todos os homens de guerra, diz o Senhor Deus."},{text:"21 E eu estabelecerei a minha glória entre as gentes: E tôdas as gentes verão o juízo, que eu tiver exercitado, e a minha mão, que eu sôbre êles tiver descarregado."},{text:"22 E os da casa de Israel saberão que eu sou o Senhor seu Deus, desde aquêle dia e dali em diante."},{text:"23 E saberão as gentes que a casa de Israel veio a ser cativa, por causa da sua iniqüidade, porque êles me abandonaram, e eu escondi dêles a minha face: E os entreguei nas mãos de seus inimigos, e todos êles caíram"},{text:"mortos ao fio da espada."},{text:"24 Eu me houve com êles segundo a sua impureza, e maldade, e escondi dêles a minha face."},{text:"25 Por cuja causa isto diz o Senhor Deus: Agora tornarei eu a trazer os cativos de Jacó, e me compadecerei de tôda a casa de Israel: E me revestirei de zêlo pela honra do meu santo nome."},{text:"26 E trarão sôbre si a sua confusão e tôda a prevaricação, com que prevaricaram contra mim, quando habitarem na sua terra com grande confiança, sem ter mêdo de ninguém:"},{text:"27 E quando eu os tiver trazido de entre povos, e os tiver ajuntado das terras de seus inimigos, e tiver sido santificado no meio dêles aos olhos de muitíssimas nações."},{text:"28 E saberão que eu sou o Senhor seu Deus vendo que eu os transportei para entre as nações: E os fiz tornar todos juntos para a sua terra, e que não deixei lá nenhum dêles."},{text:"29 E eu lhes não esconderei mais a minha face, porque tenho derramado o meu espírito sôbre tôda a casa de Israel, diz o Senhor Deus."},{text:"Ezequiel — capítulo 40."},{text:"1 No ano vinte e cinco da nossa transmigração, no princípio do ano, no décimo dia do mês, no ano catorze depois que a cidade foi ferida: Neste mesmo dia veio a mão do Senhor sôbre mim, e me levou lá."},{text:"2 Em visões de Deus me levou à terra de Israel, e me deixou sôbre um monte muito alto: Sôbre o qual estava um como edifício de cidade que vergava para o meiodia."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êste homem pois me disse: Filho do homem, vê com os teus olhos, e ouve com os teus ouvidos, e põe no teu coração tôdas as coisas que eu vou mostrar-te: Porque para elas te serem mostradas, fôste tu aqui trazido:"},{text:"Anuncia à casa de Israel tôdas as coisas que tu estás presenciando."},{text:"5 Ao mesmo tempo eis-que vi um muro por fora, que de tôdas as partes rodeava a casa, e achava-se na mão daquele homem uma cana de medir, que tinha seis côvados e um palmo: E êle mediu a largura do muro, que era de uma"},{text:"cana, e a altura que era também de uma cana."},{text:"6 Depois veio à porta, que olhava para o caminho oriental, e subiu pelos seus degraus: E mediu o limiar da porta, que tinha uma cana de largo, isto é, que o limiar tinha de largura uma cana:"},{text:"7 E mediu as câmaras, as quais tinham uma cana de comprido, e uma cana de largo: E entre as câmaras havia cinco côvados:"},{text:"8 E o limiar da porta, ao pé do vestíbulo da porta por dentro, tinha uma cana."},{text:"9 E mediu o vestíbulo da porta, o qual tinha oito côvados, e a sua fachada que tinha dois: O vestíbulo da porta porém estava da parte de dentro."},{text:"10 Ora as câmaras da porta que olhava para o caminho oriental, eram três de uma parte, e três de outra: Uma mesma medida era a das três câmaras, e uma mesma medida era a das três fachadas de ambas as partes."},{text:"11 E mediu a largura do limiar da porta, dez côvados: E o comprimento da porta, treze côvados."},{text:"12 E a margem que havia diante das câmaras, que era de um côvado: E um côvado rematava estas margens, que se correspondiam: E as câmaras de uma parte e da outra eram de seis côvados."},{text:"13 E mediu a porta desde o teto de uma câmara até o teto da outra, largura de vinte e cinco côvados: As portas estavam defronte uma da outra."},{text:"14 E fêz os frontispícios de sessenta côvados: E ajuntou aos frontispícios o átrio da porta, que dominava tudo em roda."},{text:"15 E diante da face da porta, a qual se estendia até à face do vestíbulo da porta interior, havia cinqüenta côvados."},{text:"16 Também fêz janelas oblíquas nas câmaras, e nos seus frontispícios, que estavam dentro da porta ao redor de uma e outra banda: E da mesma sorte havia tanto nos vestíbulos umas janelas à roda pela parte de dentro, como"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 32",author:"Pe. A. P. de Figueiredo",pages:[{text:"diante das fachadas uma pintura de palmas."},{text:"17 E êle me levou ao átrio de fora, e ali vi diversos gazofilácios, e o pavimento do átrio de tôdas as partes estava calçado de pedra: Ao redor do pavimento havia trinta gazofilácios."},{text:"18 E o pavimento no frontispício das portas era mais baixo, segundo o comprimento das portas."},{text:"19 E êle mediu a largura desde a face da porta debaixo até o frontispício do átrio interior por fora, cem côvados ao oriente, e ao Aquilão."},{text:"20 Mediu também a porta que olhava para o caminho do Aquilão do átrio exterior, tanto no comprimento como na largura."},{text:"21 E as suas câmaras, que eram três de uma parte, e três da outra: E o seu frontispício, e o seu vestíbulo, que eram, segundo a medida da primeira porta, cinqüenta côvados o seu comprimento, e vinte e cinco a sua"},{text:"largura."},{text:"22 E as suas janelas, e o vestíbulo, e as esculturas, eram da mesma medida que a da porta que olhava para o oriente: E era de sete degraus a sua subida, e diante dela estava um vestíbulo."},{text:"23 E a porta do átrio interior estava defronte da porta do Aquilão, e da Oriental: E mediu de uma porta à outra porta cem côvados."},{text:"24 E êle me levou daqui ao caminho do meio-dia, e eis uma porta, que olhava para o meio-dia: E êle mediu o seu frontispício e o seu vestíbulo, que eram conforme as medidas acima."},{text:"25 E as suas janelas, e os vestíbulos ao redor, assim como as outras janelas: Cinqüenta côvados de comprido, e vinte e cinco côvados de largo."},{text:"26 E subia-se a ela por sete degraus: E diante da sua porta estava um vestíbulo: E no seu frontispício havia umas palmas de escultura, uma duma parte e outra da outra."},{text:"27 E a porta do átrio interior estava no caminho do meio-dia: E mediu de uma porta até à outra porta do caminho do meio-dia, cem côvados."},{text:"28 E êle me introduziu no átrio interior, que estava junto da porta do meio-dia: E mediu a porta, que era da medida das outras."},{text:"29 A sua câmara, e a sua fachada, e o seu vestíbulo com as mesmas medidas: E as suas janelas, e o seu vestíbulo ao redor, cinqüenta côvados de comprimento, e vinte e cinco côvados de largura."},{text:"30 E o vestíbulo que dominava tudo em roda, tinha vinte e cinco côvados de comprido, e cinco côvados de largo."},{text:"31 E o seu vestíbulo chegava ao átrio exterior, e viam-se as suas palmas no frontispício: E havia oito degraus, por onde se subia para êle."},{text:"32 Depois me introduziu êle no átrio interior pelo caminho que olha para o oriente: E mediu a porta conforme as medidas acima."},{text:"33 Mediu também a sua câmara, e o seu frontispício, e o seu vestíbulo, como acima: E as suas janelas, e os seus vestíbulos em roda, cinqüenta côvados de comprido, e vinte e cinco côvados de largo."},{text:"34 E mediu o seu vestíbulo, isto é, o do átrio exterior: E no seu frontispício havia umas palmas entalhadas de uma e de outra parte: E a sua subida era por oito degraus."},{text:"35 E daqui me conduziu à porta que olhava para o Aquilão: E êle a mediu segundo as mesmas medidas que as precedentes."},{text:"36 Mediu outrossim a sua câmara, e o seu frontispício, e o seu vestíbulo, e as suas janelas em roda, cinqüenta côvados de comprido, e vinte e cinco côvados de largo."},{text:"37 E o seu vestíbulo olhava para o átrio exterior: E no seu frontispício havia umas palmas entalhadas de uma e outra parte: E subia-se a êle por oito degraus."},{text:"38 E em cada gazofilácio havia um postigo nos frontispícios das portas: Ali lavavam êles o holocausto."},{text:"39 E no vestíbulo da porta havia duas mesas de uma parte, e duas mesas da outra: Para nelas se imolarem os holocaustos, assim pelo pecado, como pelo delito."},{text:"40 E no lado de fora, que sobe ao postigo da porta, que vai ao Aquilão, havia duas mesas: E do outro lado diante do vestíbulo da porta, havia também duas mesas."},{text:"41 Quatro mesas de uma parte, e quatro mesas da outra: Aos lados da porta havia oito mesas, sôbre as quais imolavam."},{text:"42 E as quatro mesas para o holocausto eram feitas de pedras de silharia: De um côvado e meio de comprido: E de um côvado e meio de largo: E de um côvado de altura: Para porém sôbre elas os vasos de que se usava na"},{text:"imolação do holocausto, e da vítima."},{text:"43 E elas tinham umas bordas de um palmo, reviradas para dentro por tôda a roda: E sôbre as três mesas se punham as carnes da oblação."},{text:"44 E fora da porta interior estavam as câmaras dos cantores no átrio interior, que era ao lado da porta que olhava para o Aquilão: E as suas faces estavam voltadas para a parte do meio-dia; uma destas estava ao lado da"},{text:"porta oriental, que olhava para o caminho do Aquilão."},{text:"45 E o homem me disse: Esta é a câmara que olha para a parte do meio-dia; ela será para os sacerdotes que vigiam sôbre a guarda do templo."},{text:"46 E esta outra câmara, que olha para o caminho do Aquilão, será para os sacerdotes que vigiam sôbre o ministério do altar: Êstes são os filhos de Sadoc, que se chegam ao Senhor dentre os filhos de Levi para ministrarem"},{text:"diante dêle."},{text:"47 E mediu o átrio, que tinha cem côvados de comprido, e cem côvados de largo em quadro: E o altar que está diante da face do templo."},{text:"48 E me fêz entrar no vestíbulo do templo: E lhe mediu a entrada, que tinha cinco côvados de uma parte, e cinco côvados de outra: E a largura da porta, que tinha três côvados de uma parte, e três côvados da outra."},{text:"49 E o comprimento do vestíbulo que tinha vinte côvados, e a largura que era de onze côvados, e subia-se a êle por oito degraus. E nos frontispícios havia duas colunas: Uma de uma parte, e outra da outra."},{text:"Ezequiel — capítulo 41."},{text:"1 Depois me introduziu êle no templo, e mediu os postes, seis côvados de largura de uma parte, e seis da outra, segundo a largura do tabernáculo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Ezequiel Vol. 33",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 E a largura da porta era de dez côvados: E os lados da porta, cinco côvados de uma parte, e cinco côvados da outra: Mediu também o comprimento do templo, que era de quarenta côvados, e a sua largura de vinte côvados."},{text:"3 tools — see the cookie policy for details"},{text:"4 Depois mediu diante da face do templo um comprimento de vinte côvados, e uma largura também de vinte côvados: E me disse: Êste é o Santo dos Santos."},{text:"5 Depois mediu a parede do templo, que era de seis côvados: E a largura das câmaras que era de quatro côvados, postas de tôdas as partes à roda do templo."},{text:"6 E estas câmaras eram câmara sôbre câmara, trinta e três em cada andar: E havia uns cachorros que entravam na parede da casa, pelos lados ao redor, para a susterem firme, e para que não tocassem na parede do templo."},{text:"7 Havia também um espaço feito em redondo, que subia acima por um caracol, e levava à câmara mais alta do templo, indo sempre rodeando: Por isso o templo era mais largo em cima: E assim do andar mais baixo se subia pelo"},{text:"do meio até o mais alto."},{text:"8 E vi neste edifício a altura que estava ao redor dêle, as câmaras que tinham por fundamento a medida de uma cana de seis côvados de espaço."},{text:"9 E a grossura da parede do lado de fora de cinco côvados: E a casa interior estava contida nos lados do edifício."},{text:"10 E entre as câmaras vinte côvados de largo ao redor do edifício por tôdas as partes."},{text:"11 E as portas de tôdas estas câmaras estavam voltadas para o lugar da oração: Uma porta para a banda do Aquilão, e outra porta para a banda do meio-dia: E a largura do lugar para a oração, que era de cinco côvados em"},{text:"circuito."},{text:"12 E o edifício que estava separado, e voltado para o caminho que olha para o mar, tinha setenta côvados de largura: Mas a parede que incluía todo o edifício, tinha cinco côvados de grossura ao redor, e o seu comprimento"},{text:"era de noventa côvados."},{text:"13 E mediu o comprimento da casa, que achou ser de cem côvados: E o edifício que estava dela separado, e as suas paredes, que eram de cem côvados de comprido."},{text:"14 E a praça que estava diante da face do templo, e do edifício que estava separado dêle para o oriente, era de cem côvados."},{text:"15 Mediu outrossim o comprimento do edifício que se achava defronte do templo, que dêle estava separado por detrás: As galerias de uma e de outra parte que tinham cem côvados: E o templo interior, e os vestíbulos do"},{text:"átrio."},{text:"16 Mediu mais as portas, e as janelas oblíquas, e os pórticos que estavam ao redor por três partes, defronte do limiar de cada porta, e o assoalhado de madeira por todo o chão em circuito: A terra porém chegava até às"},{text:"janelas, e as janelas estavam fechadas por cima das portas."},{text:"17 E havia-as até à casa interior, e pela parte de fora, por tôda a parede em roda, por dentro e por fora, tudo com proporção."},{text:"18 Havia também uns querubins feitos de escultura, e umas palmeiras: E entre querubim e querubim estava uma palmeira, e cada querubim tinha duas faces."},{text:"19 A face de homem ao pé de uma palmeira de uma parte, e a face de leão ao pé de outra palmeira da outra parte: Feito de relêvo por tôda a casa ao redor."},{text:"20 Êstes querubins e estas palmeiras de escultura viam-se sôbre a parede do templo, desde o chão até ao cimo da porta."},{text:"21 A porta do templo era quadrada, e a face do santuário correspondia à do templo, olhando uma para outra."},{text:"22 A altura do altar de madeira era de três côvados: E os seus cantos, e o seu comprimento, e as suas paredes eram de madeira. E o homem me disse: Esta é a mesa que deve estar diante do Senhor."},{text:"23 Tanto o templo, como o santuário, tinham sua porta dobrada."},{text:"24 E nestas duas batentes, de uma e de outra parte havia ainda sua portinha de dois batentes, que se fechavam um sôbre o outro: Porque eram duas as fôlhas de uma e de outra parte das portas."},{text:"25 E nas portas mesmas do templo havia uns querubins entalhados, e umas esculturas de palmas, assim como se viam também de relêvo nas suas paredes: Pela qual razão havia também grossos madeiros no frontispício do"},{text:"vestíbulo por fora."},{text:"26 Sôbre os quais estavam janelas oblíquas, e figuras de palmas de uma e outra banda nos capitéis do vestíbulo: Segundo os lados da casa, e a largura das paredes."},{text:"Ezequiel — capítulo 42."},{text:"1 Depois me tirou o homem para fora ao átrio exterior, pelo caminho que guia para o Aquilão, e me introduziu nas câmaras do Tesouro, que estavam ao oposto do edifício separado, e defronte da casa que olhava para o norte."},{text:"2 Sendo êste edifício na fachada de cem côvados de comprimento desde a porta setentrional: E de largura de cinqüenta côvados."},{text:"3 tools — see the cookie policy for details"},{text:"4 E diante das câmaras do Tesouro havia um passeio de dez côvados de largo, que olhava para os interiores de uma veredazinha de um côvado. E as suas portas estavam ao Aquilão:"},{text:"5 Onde estas câmaras do Tesouro eram mais baixas no plano superior: Porque estavam sustentadas sôbre as galerias, que delas saíam fora, na parte ínfima e média do edifício."},{text:"6 Porque havia três andares, e as colunas que tinham não eram como as colunas dos átrios: Porque elas se elevavam desde a terra cinqüenta côvados, passando pelo andar debaixo, e pelo meio do edifício."},{text:"7 E o âmbito exterior ao largo das câmaras do Tesouro, as quais ficavam no caminho do átrio exterior, por diante das outras câmaras: Tinha cinqüenta côvados de comprido."},{text:"8 Porque o comprimento das câmaras do átrio exterior era de cinqüenta côvados: E a largura defronte da face do templo era de cem côvados."}]}] 1
