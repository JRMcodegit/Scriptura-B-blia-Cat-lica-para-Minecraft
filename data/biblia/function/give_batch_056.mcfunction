give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Jeremias — capítulo 1."},{text:"1 Palavras de Jeremias, filho de Helcias: Um dos sacerdotes, que viviam em Anatot, na terra de Benjamim."},{text:"2 É esta a palavra do Senhor que lhe foi revelada a êle nos dias de Josias, filho de Amon, rei de Judá, aos treze anos do seu reinado."},{text:"3 tools — see the cookie policy for details"},{text:"4 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"5 Antes que eu te formasse no ventre de tua mãe, te conheci: E antes que tu saísses da clausura do ventre materno, te santifiquei, e te estabeleci Profeta entre as gentes."},{text:"6 E eu lhe disse: Ah, ah, ah, Senhor Deus: Tu bem vês que eu não sei falar, porque eu sou um menino."},{text:"7 E o Senhor me disse: Não digas: Sou um menino, porquanto a tudo o que te enviar irás: E tudo quanto eu te mandar, falarás."},{text:"8 Não temas diante dêles: Porque eu sou contigo para te livrar, diz o Senhor."},{text:"9 E estendeu o Senhor a sua mão, e me tocou na bôca: E me disse a mim o Senhor: Eis-aí te pus na tua bôca as minhas palavras:"},{text:"10 Eis-aí te constituí eu hoje sôbre as gentes, e sôbre os reinos, para arrancares, e destruíres, e para arruinares, e dissipares, e para edificares, e plantares."},{text:"11 E me foi inspirada a palavra do Senhor, a qual dizia: Que vês tu, Jeremias? E lhe respondi: Eu vejo uma vara vigilante."},{text:"12 E o Senhor me disse: Viste bem, porque eu vigiarei sôbre a minha palavra para a cumprir."},{text:"13 E segunda vez me foi dirigida a palavra do Senhor, a qual dizia: Que vês tu? E lhe respondi: Eu vejo uma marmita incendiada, que vem ela do lado do Aquilão."},{text:"14 E o Senhor me disse: Do Aquilão se estenderá o mal sôbre todos os habitadores da terra."},{text:"15 Porque eis-aqui estou eu que convocarei tôdas as famílias dos reinos do Aquilão, diz o Senhor: Virão e porão cada um o seu trono à entrada das portas de Jerusalém e sôbre todos os seus muros em roda, e sôbre tôdas as"},{text:"cidades de Judá."},{text:"16 E eu pronunciarei com êles os meus juízos contra tôda a malícia daqueles que me deixaram e que ofereceram libações aos deuses estranhos, e adoraram as obras de suas mãos."},{text:"17 Tu pois cinge os teus rins, e levanta-te, e dize-lhes tudo o que eu te mando. Não temas diante dêles: Porque eu farei que tu não temas a sua presença."},{text:"18 Porquanto eu te pus hoje como uma cidade fortificada, e como uma coluna de ferro, e como um muro de bronze, sôbre tôda a terra, a respeito dos reis de Judá, dos seus príncipes, e sacerdotes, e do seu povo."},{text:"19 E pelejarão contra ti, mas não prevalecerão: Porque eu sou contigo para te livrar, diz o Senhor."},{text:"Jeremias — capítulo 2."},{text:"1 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Vai, e grita aos ouvidos de Jerusalém, dizendo: Isto diz o Senhor: Eu me lembrei de ti, compadecendo-me da tua mocidade, e me lembrei do amor dos teus desposórios, quando tu me seguiste no deserto, numa terra, que se"},{text:"não semeia."},{text:"3 tools — see the cookie policy for details"},{text:"4 Ouvi a palavra do Senhor, casa de Jacó, e tôdas as famílias da casa de Israel:"},{text:"5 Isto diz o Senhor: Que injustiça acharam em mim vossos pais, quando se alongaram de mim, e foram após a vaidade, e se tornaram vãos?"},{text:"6 E não disseram: Onde está o Senhor, que nos fêz sair da terra do Egito: Que nos conduziu pelo deserto por uma terra despovoada e sem caminho, por terra de sêde, e imagem da morte, por terra, na qual não andou varão,"},{text:"nem habitou homem?"},{text:"7 E eu vos introduzi em uma terra que é um Carmelo, para que comêsseis seus frutos, e o melhor dela: E depois de terdes assim entrado profanastes a minha terra e pusestes a minha herança em abominação."},{text:"8 Os sacerdotes não disseram: Onde está o Senhor? E os depositários da lei não me conheceram, e os pastôres prevaricaram contra mim: E os profetas profetizavam em nome de Baal, e seguiram aos ídolos."},{text:"9 Portanto ainda disputarei em juízo convosco, diz o Senhor, e argumentarei com vossos filhos."},{text:"10 Passai às ilhas de Cetim, e vêde: E mandai a Cedar, e considerai bem: E vêde se tem acontecido coisa semelhante."},{text:"11 Se trocou alguma gente a seus deuses, que certamente não são deuses: Mas o meu povo trocou a sua glória por um ídolo."},{text:"12 Pasmai, céus, sôbre isto: E ficai em total desolação, portas dêle, diz o Senhor."},{text:"13 Porque dois males fêz o meu povo: Deixaram-me a mim, fonte de água viva, e cavaram para si cisternas, cisternas rôtas, que não podem reter as águas."},{text:"14 Acaso é Israel algum escravo, ou filho de escrava? Por que razão logo foi êle exposto à prêsa?"},{text:"15 Sôbre êle rugiram os leões, e levantaram a sua voz, reduziram a sua terra a um deserto: As suas cidades foram queimadas, e não há quem habite nelas."},{text:"16 Também os filhos de Mênfis e de Tafnes te afrontaram até ao alto da cabeça."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 Porventura não te tem acontecido isto, porque abandonaste ao Senhor teu Deus naquele tempo, em que te conduzia pelo teu caminho?"},{text:"18 E agora que vais tu buscar no caminho do Egito, para beberes uma água turva? E que tens tu com o caminho dos rios assírios, para beberes a água do rio?"},{text:"19 A tua malícia te argüirá, e a tua apostasia te increpará. Sabe, e vê que mal e amarga coisa é o haveres tu deixado ao Senhor teu Deus, e o não haver em ti temor de mim, diz o Senhor Deus dos exércitos."},{text:"20 Tu desde o princípio quebraste o meu jugo, rompeste os meus laços, e disseste: Não servirei. Porque semelhante a uma mulher impudica, te prostituías em todo o outeiro elevado, e debaixo de tôda a árvore frondosa."},{text:"21 Quanto a mim porém eu te plantei como vinha escolhida, tôda a semente da verdade. Como pois te me hás tornado em mal, vinha estrangeira?"},{text:"22 Ainda que tu te laves em água de nitro, e amontoes erva de borit sôbre ti, maculada estás na tua iniqüidade diante de mim, diz o Senhor Deus."},{text:"23 Como dizes tu: Eu não estou manchada, eu não andei após de Baalim. Vê os rastos de teus pés no vale, considera o que ali fizeste. Eras como dromedária ligeira, que freqüênta os seus caminhos."},{text:"24 Como asna silvestre acostumada ao deserto, que, abrasada no seu apetite, correu sempre ao cheiro do que ama: Ninguém a apartará: Todos os que a buscam não se fatigarão: Achá-la-ão nos seus mênstruos."},{text:"25 Guarda o teu pé da desnudez, e a tua garganta da sêde. E disseste: Não me fica esperança, de nenhuma maneira o farei: Porque amei os estranhos, e após dêles andarei."},{text:"26 Como fica confundido o ladrão quando o apanham, assim têm sido confundidos os da casa de Israel, êles e os seus reis, os príncipes, e sacerdotes, e os seus profetas,"},{text:"27 os quais dizem a um pau: Tu és meu pai: E a uma pedra: Tu me geraste: Voltaram-me as costas, e não a cara, e dirão no tempo da sua aflição: Levanta-te, e livra-nos."},{text:"28 Onde estão os teus deuses, que fabricaste para ti? Levantem-se e livrem-te no tempo da tua aflição: Porque os teus deuses, ó Judá, eram tantos em número como as tuas cidades."},{text:"29 Por que quereis vós logo contender comigo em juízo? Todos vós me abandonastes, diz o Senhor."},{text:"30 Em vão castiguei os vossos filhos, êles não receberam a correção: A vossa espada devorou os vossos profetas; como um leão destruidor"},{text:"31 é a vossa geração. Atendei à palavra do Senhor. Porventura tenho eu sido para Israel um deserto ou terra tardia? Pois porque tem dito o meu povo: Nós nos temos retirado, não tornaremos mais para ti?"},{text:"32 Porventura esquecer-se-á a donzela do seu ornato, ou a espôsa da faixa que lhe cinge o peito? Mas o meu povo esqueceu-se de mim por dias que não têm número."},{text:"33 Por que forcejas tu por justificar o teu procedimento, a fim de eu me pôr bem contigo, se em cima de fazeres o mal, o ensinaste também aos outros,"},{text:"34 e nas orlas dos teus vestidos se achou o sangue das almas pobres e inocentes? Eu os achei não em algumas covas, mas em todos os lugares, de que acima falei."},{text:"35 E disseste: Eu estou sem pecado, e inocente: E por esta causa aparte-se de mim o teu furor. Eis-aí pois entrarei eu em juízo contigo, por teres dito: Eu não pequei."},{text:"36 Que desprezível te fizeste com tanto excesso, recaindo nos teus primeiros extravios! E assim serás confundida pelo Egito, bem como o fôste já por Assur."},{text:"37 Porque não só daquele sairás, mas também as tuas mãos serão postas sôbre a tua cabeça, e porque o Senhor quebrantou a tua confiança, nada favorável acharás nêle."},{text:"Jeremias — capítulo 3."},{text:"1 Vulgarmente se diz: Se um espôso repudiar a sua espôsa, e separando-se ela dêle, tomar outro marido: Porventura tornará mais êste a ela? Acaso não será considerada aquela mulher por êle como contaminada, e impura? Tu"},{text:"porém tens prostituído a muitos amantes: Ainda assim torna para mim, diz o Senhor, e eu te receberei."},{text:"2 Levanta os teus olhos ao alto, e vê onde não te prostituíste: Tu estavas assentada nos caminhos, esperando-os como um ladrão em lugar solitário: E manchaste a terra com as tuas fornicações, e com as tuas maldades."},{text:"3 tools — see the cookie policy for details"},{text:"4 Logo ao menos chama-me agora dizendo: Tu és meu pai, tu o guia da minha virgindade."},{text:"5 Porventura, anojar-te-ás para sempre, ou perseverarás até ao fim? Eis-aí está que falaste, e fizeste males, e saíste com a tua."},{text:"6 E o Senhor me disse nos dias do rei Josias: Acaso não viste tu o que fêz a rebelde Israel? Ela se foi para seu próprio mal acima de todos os altos montes, e por baixo de tôdas as árvores frondosas, e ali se deu às suas"},{text:"infames fornicações."},{text:"7 E eu depois que ela fêz tôdas estas coisas, lhe disse: Volta para mim: E não voltou. E viu a prevaricadora Judá sua irmã,"},{text:"8 que porque havia adulterado a pérfida Israel, a tinha eu desamparado, e lhe havia dado libelo de divórcio: E não teve temor a prevaricadora Judá sua irmã, mas foi-se, e ela também se prostituiu."},{text:"9 E pela facilidade da sua prostituição contaminou ela tôda a terra, e adulterou com a pedra e com o pau."},{text:"10 E com tôdas estas coisas não se voltou a mim sua irmã a prevaricadora Judá de todo o seu coração, mas só fingidamente, diz o Senhor."},{text:"11 E o Senhor me disse: Justificou a sua alma a pérfida Israel em comparação de Judá a prevaricadora."},{text:"12 Vai e profere a vozes estas palavras contra o Aquilão, e dirás: Torna, pérfida Israel, diz o Senhor e não apartarei a minha face de vós: Porque eu sou santo, diz o Senhor, e a minha ira não durará eternamente."},{text:"13 Mas contudo reconhece a tua maldade, porque contra o Senhor teu Deus prevaricaste: E tens pervertido os teus caminhos aos estranhos, debaixo de tôdas as árvores frondosas, e não ouviste a minha voz, diz o Senhor."},{text:"14 Convertei-vos a mim, filhos apóstatas, diz o Senhor: Porque eu sou vosso espôso: E eu vos tomarei um de cada cidade, e dois de cada família, e vos introduzirei em Sião."},{text:"15 E vos darei pastôres segundo o meu coração, os quais vos apascentarão com a ciência e com a doutrina."},{text:"16 E depois que vos multiplicardes, e crescerdes na terra naqueles dias, diz o Senhor: Não dirão mais: A arca do testamento do Senhor: Nem lhes virá ao pensamento, nem se lembrarão dela: Nem será visitada, nem mais se"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"restabelecerá."},{text:"17 Naquele tempo chamarão a Jerusalém trono do Senhor: E se reunirão nela tôdas as gentes em nome do Senhor em Jerusalém, e não andarão após da maldade do seu péssimo coração."},{text:"18 Naqueles dias a casa de Judá irá à casa de Israel, e virão juntamente da terra do Aquilão para a terra, que eu dei a vossos pais."},{text:"19 E eu disse: Como te contarei entre os filhos, e te darei a terra desejável, a excelente herança dos exércitos das gentes? E disse: Chamar-me-ás pai, e não cessarás de ir após de mim."},{text:"20 Mas do modo que uma mulher despreza ao seu amante, assim me desprezou a mim a casa de Israel, diz o Senhor."},{text:"21 Uma voz se ouviu nos caminhos, um pranto e alarido dos filhos de Israel: Porque fizeram mau o seu caminho, esqueceram-se do Senhor seu Deus."},{text:"22 Convertei-vos, filhos apóstatas, e eu sararei os vossos extravios. Aqui estamos que vimos a ti: Porque tu és o Senhor nosso Deus."},{text:"23 Na verdade eram mentira os outeiros, e a multidão dos montes: Em verdade no Senhor nosso Deus está a salvação de Israel."},{text:"24 A confusão consumiu o trabalho de nossos pais desde a nossa mocidade, os seus rebanhos e as suas vacadas, os seus filhos, e as suas filhas."},{text:"25 Dormiremos na nossa confusão, e viveremos cobertos da nossa ignomínia: Porque pecamos contra o Senhor nosso Deus, nós e nossos pais desde a nossa mocidade até êste dia: E porque não ouvimos a voz do Senhor nosso Deus."},{text:"Jeremias — capítulo 4."},{text:"1 Se tu, Israel, voltares, diz o Senhor, converter-te-ás a mim: Se tu tirares de diante da minha face os teus tropeços, não experimentarás abalo."},{text:"2 E jurarás: Vive o Senhor, em verdade, e em juízo, e em justiça: E o bendirão as gentes, e lhe darão louvor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Circuncidai-vos ao Senhor, e tirai os prepúcios de vossos corações, varões de Judá e habitadores de Jerusalém: Para que não suceda que de repente saia como fogo a minha indignação, e se acenda e não haja quem a apague,"},{text:"tudo por causa da malignidade dos vossos pensamentos."},{text:"5 Anunciai em Judá e fazei ouvir em Jerusalém: Falai e publicai ao som da trombeta na terra, gritai em alta voz e dizei: Ajuntai-vos todos e entremos nas cidades fortificadas,"},{text:"6 levantai o estandarte em Sião. Esforçai-vos, não estejais parados, porque eu faço vir do Aquilão um mal e uma grande assolação."},{text:"7 Saiu o leão do seu covil, e levantou-se o roubador das gentes: Saiu do seu país, para reduzir a tua terra a um deserto: As tuas cidades serão destruídas, sem que nelas fique algum habitador."},{text:"8 Pelo que cobri-vos de cilícios, chorai, e pranteai: Porque se não apartou de nós a ira do furor do Senhor."},{text:"9 E acontecerá isto naquele dia, diz o Senhor: Desfalecerá o coração do rei e o coração dos príncipes: E pasmarão os sacerdotes e os profetas serão consternados."},{text:"10 E eu disse: Ai, ai, ai, Senhor Deus. É possível que enganastes a êste povo e a Jerusalém, dizendo-lhes: Vós tereis paz: E eis agora lhes chega a espada até à alma."},{text:"11 Naquele tempo dir-se-á a êste povo e a Jerusalém: Um vento abrasador assopra nos caminhos que do deserto conduzem à filha do meu povo, não para aventar, nem para limpar."},{text:"12 Dêstes me virá um vento impetuoso: E eu agora falarei os meus juízos com êles."},{text:"13 Eis-aí subirá como uma nuvem e como tempestade o seu carro: Mais velozes que águias os seus cavalos: Ai de nós porque somos destruídos."},{text:"14 Lava, ó Jerusalém, o teu coração de tôda a maldade para que sejas salva: Até quando permanecerão em ti pensamentos pecaminosos?"},{text:"15 Porque uma voz vinda de Dan nos anuncia e faz saber que é chegado o ídolo, que vem do monte de Efraim."},{text:"16 Dizei às nações: Eis-aí se ouviu dizer em Jerusalém, virem gentes de guerra duma terra remota e darem o seu brado sôbre as cidades de Judá."},{text:"17 Puseram-se sôbre ela ao redor, como guardas de campo: Porquanto ela me provocou a ira, diz o Senhor."},{text:"18 Os teus caminhos e os teus pensamentos te trouxeram estas coisas: Essa tua malícia, porque é amarga, pois chegou até o teu coração."},{text:"19 Em minhas entranhas, em minhas entranhas sinto dor, os afetos do meu coração se têm turbado em mim: Não me calarei porque a minha alma ouviu a voz da trombeta, um alarido de batalha."},{text:"20 Tormento sôbre tormento foi chamado e assolada foi tôda a terra: De improviso têm sido destruídas as minhas tendas, sùbitamente as minhas peles."},{text:"21 Até quando o verei fugir, ouvirei a voz da buzina?"},{text:"22 Porque o meu povo néscio não me conheceu: Filhos insensatos são, e sem prudência: Sábios são para fazer o mal: Mas não souberam fazer o bem."},{text:"23 Olhei para a terra, e eis-que estava vazia, e era nada: E para os céus, e não havia nêles luz."},{text:"24 Vi os montes, e eis-que se moviam: E todos os outeiros tremiam."},{text:"25 Olhei, e não havia homem: E tôdas as aves do céu se haviam retirado."},{text:"26 Olhei, e eis-que estava deserto o Carmelo: E tôdas as suas cidades foram destruídas na presença do Senhor, e na presença da ira do seu furor."},{text:"27 Porque isto diz o Senhor: Deserta ficará tôda a terra, porém contudo eu a não destruirei de todo."},{text:"28 Chorará a terra, e entristecer-se-ão os céus de cima: Porque falei, considerei e não me arrependi nem desisti disso."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"29 À voz do cavaleiro e do que despede a seta fugiu tôda a cidade: Entraram pelas asperezas e subiram pelos rochedos: Tôdas as cidades foram geralmente desamparadas e nelas não habita nem um homem."},{text:"30 E tu devastada que farás? Quando te vestires de púrpura, quando te adornares de colares de ouro e pintares os teus olhos com o antimônio, em vão te enfeitarás: Desprezaram-te os teus amantes, buscaram a tua morte."},{text:"31 Porque ouvi uma como voz de mulher que está de parto, angústias como de puérpera: Voz da filha de Sião que está moribunda, estendendo as suas mãos: Ai de mim que desmaiou a minha alma por causa dos mortos."},{text:"Jeremias — capítulo 5."},{text:"1 Dai volta às ruas de Jerusalém, e vêde, e considerai, e andai procurando nas suas praças, a ver se achais um homem, que faça justiça, e busque a verdade: E eu lhe perdoarei a ela."},{text:"2 E se até disserem, vive o Senhor: Ainda assim jurarão falso."},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas eu disse: Talvez são os pobres e insensatos os que ignoram o caminho do Senhor, o juízo do seu Deus."},{text:"5 Irei ter pois com os grandes, e falar-lhes-ei: Porque êstes conheceram o caminho do Senhor, o juízo do seu Deus: E eis-aqui está que êstes juntos quebraram mais o jugo, romperam as prisões."},{text:"6 Por isso o leão do bosque os feriu, o lôbo de noite os destruiu, o leopardo andou vigilante sôbre as suas cidades: Todo aquêle, que dêles sair, será prêso: Porque se têm multiplicado as suas prevaricações, têm-se"},{text:"endurecido nas suas apostasias."},{text:"7 Sôbre que te poderei eu ser propício? teus filhos me abandonaram, e juram por aquêles que não são deuses: Fartei-os, e adulteraram, e satisfaziam a sua paixão em casa de meretriz."},{text:"8 Tornaram-se cavalos de lançamento, quando estão no maior ardor: Cada um rinchava à mulher do seu próximo."},{text:"9 Pois não hei de castigar eu estas coisas? diz o Senhor, e numa gente como esta não se há de vingar a minha alma?"},{text:"10 Escalai os seus muros e derribai-os, mas não a acabeis de todo: Extingüi-lhes os troncos das suas famílias, porque não são do Senhor."},{text:"11 Porque tem com prevaricação prevaricado contra mim a casa de Israel, e a casa de Judá, diz o Senhor."},{text:"12 Negaram ao Senhor, e disseram: Não é êle: Nem virá mal sôbre nós: Não veremos a espada, nem a fome."},{text:"13 Os profetas falaram ao vento, e não lhes foi dada resposta: Estas coisas pois lhes virão."},{text:"14 Isto diz o Senhor Deus dos exércitos: Porque haveis proferido esta palavra: Eis-aqui dou eu as minhas palavras na tua bôca por fogo, e a êste povo por lenha, e aquêle os devorará."},{text:"15 Eis-aqui está que eu trarei sôbre vós uma gente de longe, casa de Israel, diz o Senhor: Uma gente robusta, uma gente antiga, uma gente, cuja língua não saberás, nem entenderás o que ela fala."},{text:"16 A sua aljava será como um sepulcro aberto, todos êles geralmente serão fortes."},{text:"17 E ela comerá as tuas searas, e o teu pão: Devorará os teus filhos, e as tuas filhas: Nutrir-se-á dos teus rebanhos, e das tuas vacadas: Comerá as tuas vinhas e as tuas figueiras: E destruirá com o ferro as tuas"},{text:"cidades fortificadas, nas quais tu tens a confiança."},{text:"18 Com tudo isso, naqueles dias, diz o Senhor, não acabarei duma vez convosco."},{text:"19 E se disserdes: Por que nos fêz o Senhor nosso Deus tôdas estas coisas? lhes dirás a êles: Assim como me haveis abandonado e haveis servido a um Deus estranho na vossa terra, assim servireis aos estrangeiros em terra"},{text:"não vossa."},{text:"20 Anunciai isto à casa de Jacó, e fazei-o ouvir em Judá, dizendo:"},{text:"21 Ouve, povo insensato, que não tens coração: Vós, que tendes olhos não vêdes: E que tendes ouvidos, e não escutais."},{text:"22 Pois que, não me temereis a mim, diz o Senhor: E na minha presença não vos arrependereis? Eu que pus a areia por limite do mar, mandamento perdurável, que não acabará: E levantar-se-ão as suas ondas, e não"},{text:"prevalecerão: E empolar-se-ão e não passarão fora das suas balizas:"},{text:"23 Mas a êste povo se lhe tem feito o seu coração incrédulo e rebelde, êles se apartaram e apostataram."},{text:"24 E não disseram no seu coração: temamos o Senhor nosso Deus, que nos dá a seus tempos a chuva do cedo e do tarde: Conservando-nos a fértil abundância duma anual colheita."},{text:"25 As vossas iniqüidades desviaram estas coisas: E os vossos pecados apartaram de vós o bem:"},{text:"26 Porque no meu povo se acharam ímpios, que armavam ciladas, como os caçadores de aves, pondo laços e rêdes, para apanhar os homens."},{text:"27 Como gaiola cheia de aves, assim são as suas casas cheias de dolo: Por isso se têm engrandecido e enriquecido."},{text:"28 Engordaram e engrossaram: E transgrediram as minhas palavras perversíssimamente. Não julgaram a causa da viúva, não encaminharam a causa do órfão, nem fizeram justiça aos pobres."},{text:"29 Acaso não punirei eu êstes excessos? diz o Senhor, ou duma gente como esta não se vingará a minha alma?"},{text:"30 Coisas espantosas e estranhas se têm feito na terra:"},{text:"31 Os profetas profetizavam a mentira, e os sacerdotes os aplaudiam com as suas mãos: E o meu povo amou essas coisas: Que castigo não virá pois sôbre esta gente no seu último fim?"},{text:"Jeremias — capítulo 6."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 05",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Armai-vos de fortaleza, filhos de Benjamim, no meio de Jerusalém, e fazei soar a trombeta em Técua, e levantai o estandarte sôbre Betacarem: Porque da banda do Aquilão apareceu um mal, e uma grande ruína."},{text:"2 A uma formosa e delicada assemelhei a filha de Sião."},{text:"3 tools — see the cookie policy for details"},{text:"4 Preparai-vos a lhe declarar a guerra: Levantai-vos, e subamos ao meio-dia: Ai de nós, que declinou o dia, porque as sombras se fizeram mais compridas pela tarde."},{text:"5 Levantai-vos e subamos de noite e deitemos abaixo tôdas as suas casas."},{text:"6 Porque isto diz o Senhor dos exércitos: Cortai as árvores do contôrno, e fazei um marachão à roda de Jerusalém: Esta é a cidade destinada à minha vingança, porque todo o gênero de calúnia reina no meio dela."},{text:"7 Como a cisterna tornou fria a água que em si recebeu, assim esta cidade tornou fria a sua malícia: A iniqüidade e a desolação se ouvirá nela; diante de mim estão sem cessar a miséria e o açoite."},{text:"8 Escarmenta, Jerusalém, para que não suceda que a minha alma se aparte de ti, não suceda que eu te torne em terra deserta e despovoada."},{text:"9 Eis-aqui o que diz o Senhor dos exércitos: Até ao último cacho, como em vindima, se rabiscarão os restos de Israel. Volta a tua mão como o vindimador ao cêsto."},{text:"10 A quem falarei eu? E a quem admoestarei que me ouça? Eis-que os seus ouvidos estão incircuncidados, e não podem ouvir: Eis-que a palavra do Senhor foi para êles um motivo de opróbrio: E não a receberão."},{text:"11 Por isso é que eu estou cheio do furor do Senhor: Cansado estou de sofrer: Derrama a indignação sôbre o menino que anda pela rua, e juntamente sôbre o congresso dos mancebos: Porque o marido será prêso com a mulher, o"},{text:"velho com o decrépito."},{text:"12 E as suas casas passarão a estranhos, os campos e igualmente as mulheres: Porque eu estenderei a minha mão sôbre os habitantes da terra, diz o Senhor."},{text:"13 Porquanto desde o mais pequeno até ao maior todos estão entregues à avareza: E desde o profeta até o sacerdote todos procedem com dolo."},{text:"14 E curam as chagas da filha do meu povo com ignomínia dizendo: Paz, paz: Quando não havia paz."},{text:"15 Confundiram-se porque fizeram abominação: Ou por melhor dizer, nem a mesma confusão os pôde confundir, nem souberam que coisa era envergonhar-se: Por isso cairão entre a turba dos mortos: No tempo da sua visitação"},{text:"cairão, diz o Senhor."},{text:"16 Eis-aqui o que diz o Senhor: Tende-vos sôbre os caminhos, e vêde, e perguntai, quais são as antigas veredas, para conhecerdes o bom caminho, e andai por êle: E achareis refrigério para as vossas almas. E êles"},{text:"responderam: Não andaremos por certo."},{text:"17 E constituí umas sentinelas sôbre vós. Ouvi a voz da trombeta. E êles responderam: Não ouviremos por certo."},{text:"18 Portanto ouvi, ó gentes, e tu, ó congregação, vê com quanto rigor os tratarei eu a êles."},{text:"19 Ouve terra: Eis-aí farei eu vir calamidades sôbre êste povo, fruto dos seus pensamentos: Porque não ouviram as minhas palavras, e rejeitaram a minha lei."},{text:"20 Para que me trazeis vós incenso de Sabá, e cana de suave cheiro de terra longínqua? os vossos holocaustos não me são aceitos, nem as vossas vítimas me agradaram."},{text:"21 Portanto isto diz o Senhor: Eis-aqui estou eu que trarei a ruína sôbre êste povo, e cairão entre êles juntamente os pais e os filhos, o vizinho, e o próximo perecerão."},{text:"22 Isto diz o Senhor: Eis-aqui vem um povo da terra do Aquilão, e uma nação grande se levantará dos fins da terra."},{text:"23 Tomará seta e escudo: Ela é cruel, e não terá piedade: A sua voz soará como o mar: E montarão em cavalos, dispostos como um homem valente, a pelejar contra ti, filha de Sião."},{text:"24 Ouvimos a sua fama, afrouxaram-se as nossas mãos: Alcançou-nos a tribulação, as dores como a que está de parto:"},{text:"25 Não saiais aos campos, e não andeis pelo caminho: Porque a espada do inimigo é o espanto ao redor."},{text:"26 Filho do meu povo, veste-te de cilício, e revolve-te na cinza: Toma luto como por um filho único, pranto amargo, porque de repente virá sôbre nós o destruidor."},{text:"27 Por averiguador forte te tenho pôsto sôbre o meu povo: E saberás, e examinarás o caminho dêles."},{text:"28 Todos êstes príncipes que estão fora de caminho, que andam com engano, são cobre e ferro: Todos se têm corrompido."},{text:"29 Faltou o fole, o chumbo foi consumido no fogo, debalde o meteu o fundidor na forja: Porque as suas malícias não se consumiram."},{text:"30 Chamai-os uma prata falsa, porque o Senhor os rejeitou."},{text:"Jeremias — capítulo 7."},{text:"1 Palavra que pelo Senhor foi dirigida a Jeremias, a qual dizia:"},{text:"2 Põe-te em pé à porta da casa do Senhor, e prega aí estas palavras e dize: Ouvi a palavra do Senhor todo Judá, que entrais por estas portas, para adorardes ao Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Não ponhais a vossa confiança em palavras de mentira, dizendo: Templo do Senhor, templo do Senhor, êste templo é do Senhor."},{text:"5 Porque se dirigirdes bem os vossos caminhos e os vossos afetos: Se fizerdes justiça aos que pleiteiam entre si,"},{text:"6 se não oprimirdes o estrangeiro, e o pupilo, e a viúva, nem derramardes o sangue inocente neste lugar, e se não andardes após dos deuses alheios para vossa própria desgraça:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 06",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Habitarei convosco neste lugar: Na terra que dei a vossos pais desde o século e até o século."},{text:"8 Eis-aí está que vós confiais para vosso mal em palavras de mentira, que vos não servirão para nada:"},{text:"9 Para furtar, matar, adulterar, jurar falso, sacrificar aos ídolos, e ir após dos deuses estranhos, que não conheceis."},{text:"10 E viestes e vos presentastes diante de mim nesta casa, onde o meu nome foi invocado, e dissestes: Estamos livres ainda que tenhamos cometido tôdas estas abominações."},{text:"11 Logo esta minha casa, onde foi invocado o meu nome diante de vossos olhos, não é assim que está feita um covil de ladrões? Eu, eu sou: Eu o vi, diz o Senhor."},{text:"12 Ide ao meu lugar em Silo, onde habitou o meu nome desde o princípio: E vêde o que lhe eu fiz por causa da malícia do meu povo de Israel:"},{text:"13 E agora porque tendes feito tôdas estas obras, diz o Senhor: Eu vos falei levantando-me de manhã e falando eu, ainda assim me não ouvistes: E vos chamei, e não respondestes:"},{text:"14 Farei eu a esta casa onde o meu nome foi invocado e na qual vós pondes a vossa confiança: E êste lugar que eu vos dei a vós e a vossos pais assim como fiz a Silo."},{text:"15 E eu vos lançarei bem longe da minha face como lancei a todos os vossos irmãos, a tôda a linhagem de Efraim."},{text:"16 Tu pois não rogues por êste povo, nem empreendas por êle louvor nem oração, e não te me oponhas: Porque te não escutarei."},{text:"17 Acaso não vês tu o que êstes fazem nas cidades de Judá e nas praças de Jerusalém?"},{text:"18 Os filhos ajuntam a lenha e os pais acendem o fogo, e as mulheres misturam a manteiga com os mais adjuntos necessários para fazerem tortas à rainha do céu, e para sacrificarem a deuses estranhos, e para me provocarem"},{text:"a ira."},{text:"19 Acaso êles a mim é que me provocam a ira? diz o Senhor, ou não é antes a si mesmos que fazem mal para confusão do seu rosto?"},{text:"20 Portanto isto diz o Senhor Deus: Eis-aí está que o meu furor, e a minha indignação se anda forjando sôbre êste lugar, sôbre os homens, e sôbre os animais, e sôbre as árvores do campo, e sôbre os frutos da terra, e se"},{text:"acenderá, e não se apagará."},{text:"21 Isto diz o Senhor dos exércitos, o Deus de Israel: Ajuntai os vossos holocaustos às vossas vítimas, e comei dessas carnes."},{text:"22 Porque eu não falei com vossos pais, nem lhes mandei, no dia em que os tirei da terra do Egito, coisa alguma acêrca dos holocaustos e das vítimas."},{text:"23 Mas eis-aqui o que lhes mandei, dizendo: Ouvi a minha voz, e eu serei o vosso Deus, e vós sereis o meu povo: E andai por todo o caminho que eu vos prescrevi, para serdes bem sucedidos."},{text:"24 E não me ouviram, nem me aplicaram os seus ouvidos: Mas foram-se após os seus apetites, e da pravidade do seu malvado coração; e tornaram para trás, em vez de irem para diante,"},{text:"25 desde o dia em que seus pais saíram da terra do Egito, até ao dia de hoje. E eu vos enviei a vós todos os meus servos os profetas, levantando-me cada dia, muito cedo, e prevenindo-vos em vo-los mandar."},{text:"26 E não me ouviram, nem me aplicaram os seus ouvidos: Mas endureceram a sua cerviz: E obraram pior que seus pais."},{text:"27 E tu lhes dirás a êles tôdas estas palavras, e não te escutarão: E chamá-los-ás e não te responderão:"},{text:"28 E tu lhes dirás a êles: Esta é uma gente, que não ouviu a voz do Senhor seu Deus, nem recebeu as suas instruções: Acabou-se a fé, e ela se exterminou da bôca dêles."},{text:"29 Corta os teus cabelos, e lança-os fora e levanta o teu pranto ao alto: Porque o Senhor arrojou de si, e abandonou a geração do seu furor."},{text:"30 Porque os filhos de Judá cometeram o mal diante dos meus olhos, diz o Senhor. Êles puseram os seus tropeços na casa em que foi invocado o meu nome, para a profanarem:"},{text:"31 E edificaram os altos de Tofet, que está no Vale do filho de Enon: Para queimarem no fogo a seus filhos, e a suas filhas, o que eu não mandei, nem pensei no meu coração."},{text:"32 Portanto eis-aí virão dias, diz o Senhor, e não se dirá mais Tofet, nem Vale do filho de Enon: senão Vale da matança: E enterrarão em Tofet, porque não haverá mais lugar."},{text:"33 E os corpos mortos dêste povo servirão de pasto às aves do céu, e às alimárias da terra, e não haverá quem dali as enxote."},{text:"34 E farei que se não ouça nas cidades de Judá, e nas praças de Jerusalém voz de gôzo, e voz de alegria, voz de espôso, e voz de espôsa: Porque a terra será posta em desolação."},{text:"Jeremias — capítulo 8."},{text:"1 Naquele tempo, disse o Senhor: Lançarão fora das suas sepulturas os ossos dos reis de Judá, e os ossos dos seus príncipes, e os ossos dos sacerdotes, e os ossos dos profetas, e os ossos daqueles que em Jerusalém têm"},{text:"habitado:"},{text:"2 E expô-los-ão ao sol, e à lua e a tôda a milícia do céu, que êles amaram, e a quem serviram, e após de quem andaram, e a quem buscaram, e adoraram: Não serão recolhidos, nem sepultados: Ficarão sôbre a face da terra"},{text:"como um muladar."},{text:"3 tools — see the cookie policy for details"},{text:"4 E tu lhes dirás a êles: Isto diz o Senhor: Porventura o que cai não se levantará? e o que se desviou não tornará?"},{text:"5 Pois por que se tem desviado êste povo em Jerusalém com uma obstinada apostasia? Tem abraçado a mentira, e não quiseram voltar."},{text:"6 Atendi, e escutei: Ninguém fala o que é bom, nenhum há que faça penitência do seu pecado, dizendo: Que fiz eu? todos voltam para onde a sua paixão os leva, como cavalo que corre a tôda a brida para o combate."},{text:"7 O milhafre no céu conheceu a sua estação: A rôla e a andorinha, e a cegonha observaram a conjuntura da sua arribação: Mas o meu povo não conheceu o juízo do Senhor."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 07",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Como assim dizeis: Sábios somos nós, e a lei do Senhor está conosco? Verdadeiramente o ponteiro mentiroso dos escribas gravou a mentira."},{text:"9 Confundidos foram os sábios, aterrados têm sido e presos: Porque desprezaram a palavra do Senhor, e nenhuma sabedoria há nêles."},{text:"10 Pelo que darei suas mulheres a estranhos, seus campos a outros herdeiros: Porque desde o mais pequeno até ao maior todos seguem a avareza: Desde o profeta até ao sacerdote todos forjam a mentira."},{text:"11 E curavam as chagas da filha do meu povo, para sua ignomínia, dizendo: Paz, paz: Quando não havia paz."},{text:"12 Ficaram confundidos porque cometeram a abominação: Ou antes não foram confundidos pela confusão, nem souberam que era envergonhar-se: Portanto cairão entre os que perecerem, no tempo da sua vingança cairão, diz o"},{text:"Senhor."},{text:"13 Eu os congregarei juntos, diz o Senhor: Não há uva nas vides, nem há figos na figueira, a fôlha caiu: E eu lhes dei o que lhes escapou."},{text:"14 Por que estamos nós quietos? ajuntai-vos, e entremos na cidade fortificada, e guardemos aí silêncio: Porque o Senhor nosso Deus nos fêz calar, e nos deu a beber água de fel: Porque pecamos contra o Senhor."},{text:"15 Esperamos a paz, e êste bem não chegava: O tempo da medicina, e eis-que só havia temor."},{text:"16 O estrépito da cavalaria inimiga se percebeu já desde Dan, à voz dos rinchos dos guerreiros dêle estremeceu tôda a terra: E vieram e devoraram a terra, e quanto havia nela: A cidade e os seus habitadores."},{text:"17 Porque eis vos enviarei eu uns serpentes régulos, contra os quais não podem nada os encantamentos: E vos morderão, diz o Senhor:"},{text:"18 A minha dor é sôbre tôda a dor, o meu coração está melancolizado dentro de mim."},{text:"19 Eis-aí a voz do clamor da filha do meu povo desde uma terra longínqua: Porventura não está o Senhor em Sião, ou não está o seu rei no meio dela? Por que razão logo me provocaram êles a ira com os seus ídolos, e com"},{text:"estranhas vaidades?"},{text:"20 O tempo da ceifa é passado, o estio findou-se, e nós não fomos salvos."},{text:"21 Quebrantado estou, e entristecido pela dor da filha do meu povo; o espanto se apoderou de mim."},{text:"22 Acaso não há resina em Galaad? ou não se acha lá médico? Por que razão logo não tem encourado a cicatriz da filha do meu povo?"},{text:"Jeremias — capítulo 9."},{text:"1 Quem dará água à minha cabeça, e uma fonte de lágrimas a meus olhos? e eu chorarei de dia e de noite os mortos da filha do meu povo."},{text:"2 Quem me dará no deserto um albergue de passageiros, e eu deixarei o meu povo, e me apartarei dêles? Porque todos são uns adúlteros, um congresso de prevaricadores."},{text:"3 tools — see the cookie policy for details"},{text:"4 Cada um se guarde do seu próximo, e não se fie de nenhum de seus irmãos: Porque todo o irmão armando cambapé dará sancadilha, e todo o amigo andará com falsidade."},{text:"5 E cada um dêles se rirá de seu irmão, e não falarão a verdade: Porque ensinaram a sua língua a proferir a mentira: Estudaram como haviam de fazer injustiças."},{text:"6 A tua habitação é no meio do engano: Por amor do engano recusaram conhecer-me, diz o Senhor."},{text:"7 Portanto isto diz o Senhor dos exércitos: Eis-aqui estou eu que os fundirei, e ensaiarei ao fogo: Porque que outra coisa farei eu à vista da filha do meu povo?"},{text:"8 A língua dêles é uma seta que fere, ela falou o engano: Na sua bôca fala paz com o seu amigo, e ocultamente lhe arma ciladas."},{text:"9 Acaso não punirei eu êstes excessos? diz o Senhor, ou numa gente como esta não se vingará a minha alma?"},{text:"10 Sôbre os montes romperei em chôro e lamento, e sôbre os lugares amenos do deserto desafogarei em pranto: Porque têm sido incendiados de maneira que não há homem que passe por ali: E não ouviram a voz de quem os"},{text:"possuía: Desde a ave do céu até aos animais mudaram de sítio e se retiraram."},{text:"11 E reduzirei Jerusalém a montões de areia, e a covis de dragões: E entregarei as cidades de Judá à desolação, sem que fique ali morador."},{text:"12 Quem é o varão sábio que entenda isto, e a quem se dirija a palavra da bôca do Senhor, para que publique isto, por que causa tem perecido a terra, e tem sido abrasada como um deserto, de maneira que não há quem passe"},{text:"por ela?"},{text:"13 E disse o Senhor: Porque êles abandonaram a minha lei, que eu lhes dei, e não ouviram a minha voz, e não andaram nela:"},{text:"14 E se foram atrás da pravidade do seu coração, e após de Baal: Como êles aprenderam de seus pais."},{text:"15 Portanto isto diz o Senhor dos exércitos, o Deus de Israel: Eis-aqui estou eu que alimentarei a êste povo com losna, e dar-lhes-ei por bebida água de fel:"},{text:"16 E enviá-los-ei dispersos para entre umas gentes, que êles e seus pais não conheceram: E enviarei após êles a espada, até serem consumidos."},{text:"17 Isto diz o Senhor dos exércitos, o Deus de Israel: Considerai atentamente, e chamai carpideiras e venham: E enviai por aquelas que são hábeis, e se apressem:"},{text:"18 Dêem-se pressa, principiem o lamento sôbre nós; distilem lágrimas os nossos olhos, e as nossas pálpebras se alaguem de rios de águas."},{text:"19 Porque esta voz de lamentação se ouviu em Sião: Como havemos sido destruídos e cheios de tão grande confusão? Porque abandonamos a terra, por haverem sido derribadas as nossas casas."},{text:"20 Ouvi pois, mulheres, a palavra do Senhor, e recebam os vossos ouvidos o discurso da sua bôca: E ensinai a vossas filhas o lamento: E cada uma à sua vizinha o pranto:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 Porque a morte subiu pelas nossas janelas, ela entrou nas nossas casas para perder as nossas crianças nas ruas, os nossos mancebos nas praças."},{text:"22 Fala: Isto diz o Senhor: E cairão os cadáveres dos homens como estêrco sôbre a face de um campo, e como feno para detrás do segador, e não há quem os recolha."},{text:"23 Isto diz o Senhor: Não se glorie o sábio no seu saber, nem se glorie o forte na sua fôrça, e não se glorie o rico nas suas riquezas:"},{text:"24 Porém nisto se glorie aquêle que se gloria, em conhecer-me e em saber que eu sou o Senhor que faço misericórdia, e juízo e justiça sôbre a terra: Porque estas coisas me agradam, diz o Senhor."},{text:"25 Eis-aí vêm dias, diz o Senhor, e visitarei todo aquêle que é circuncidado,"},{text:"26 sôbre o Egito, e sôbre Judá, e sôbre Edom, e sôbre os filhos de Amon, e sôbre Moab, e sôbre todos os que se acham com o cabelo cortado em redondo, que moram no deserto: Porque tôdas as gentes têm prepúcio, mas tôda a"},{text:"casa de Israel vem a ser uns incircuncisos de coração."},{text:"Jeremias — capítulo 10."},{text:"1 Ouvi a palavra que falou o Senhor acêrca de vós, casa de Israel."},{text:"2 Isto diz o Senhor: Não aprendais segundo os caminhos das gentes: E não temais os sinais do céu, como temem as gentes:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Adornou-o com prata, e com ouro: Com pregos e a marteladas, o uniu para se não desconjuntar."},{text:"5 À semelhança de palmeira foram feitas, e não falarão: Andarão com elas de uma parte a outra, porque não podem dar passo: Não as temais pois, porque nem podem fazer mal nem fazer bem."},{text:"6 Ninguém há semelhante a ti, Senhor: Grande és tu, e grande o teu nome em fortaleza."},{text:"7 Quem te não temerá, ó rei das gentes? Porque tua é a honra: Entre todos os sábios das gentes, e em todos os seus reinos nenhum há semelhante a ti."},{text:"8 Êles serão igualmente convencidos por uns insipientes e fátuos: Doutrina é de vaidade o madeiro dêles."},{text:"9 A prata enrolada se traz de Tarsis, e o ouro de Ofaz, obra de mestre, e mão de fundidor: De jacinto e de púrpura é a vestidura dêles: Obras de mestres são tôdas estas coisas."},{text:"10 Mas o Senhor êsse é o Deus verdadeiro: Êle o Deus vivo, e o rei sempiterno: À sua indignação se abalará a terra: E as gentes não suportarão as suas ameaças."},{text:"11 Vós pois lhes direis assim: Os deuses que não fizeram os céus e a terra, pereçam da terra, e do que está debaixo do céu."},{text:"12 O que fêz a terra com o seu poder, pôs em ordem o mundo com a sua sabedoria, e estendeu os céus com a sua prudência."},{text:"13 À sua voz dá êle uma multidão de águas no céu, e eleva as nuvens dos extremos da terra: Resolve em chuva os relâmpagos, e faz sair o vento dos seus tesouros."},{text:"14 Todos êstes homens se tornaram néscios pela sua ciência, confundido ficou todo o artífice no seu simulacro: Porque coisa falsa é a que fundiu, e não há espírito nêles."},{text:"15 Elas são coisas vãs, e obra digna de riso: No tempo da sua visitação perecerão."},{text:"16 Não é semelhante a êstes o que é a porção de Jacó: Pois êle é o que formou tôdas as coisas: E Israel é vara da sua herança: O Senhor dos exércitos é o seu Nome."},{text:"17 Ajunta da terra a tua confusão, tu que moras em lugar cercado:"},{text:"18 Porque isto diz o Senhor: Eis-aqui estou eu que atirarei desta vez para bem longe com os habitadores desta terra, e eu os atribularei de modo que todos sejam achados."},{text:"19 Ai de mim pela minha dilacerante dor, a minha chaga é muito maligna. Mas eu disse: Certamente enfermidade minha é esta, e eu a suportarei."},{text:"20 A minha tenda foi destruída, tôdas as minhas cordas se romperam, os meus filhos saíram de mim e não subsistem: Daqui em diante não há quem estenda o meu pavilhão, e levante as minhas peles."},{text:"21 Porque os pastôres obraram loucamente, e não buscaram o Senhor: Por isso não entenderam, e todo o seu rebanho se desarranjou."},{text:"22 Eis-aí vem uma voz perceptível, e um grande tumulto da terra do Aquilão: Para reduzir as cidades de Judá a um deserto, e a morada de dragões."},{text:"23 Eu sei, Senhor, que não é do homem o seu caminho; nem é do varão o andar, e o dirigir os seus passos."},{text:"24 Castiga-me, Senhor, porém seja isto segundo o teu juízo: E não no teu furor, para que não suceda que tu me reduzas a um nada."},{text:"25 Derrama a tua indignação sôbre as gentes que te não conheceram, e sôbre as províncias, que não invocaram o teu nome, porque tragaram a Jacó, e o devoraram, e o consumiram, e dissiparam a sua glória."},{text:"Jeremias — capítulo 11."},{text:"1 Palavra que foi dirigida pelo Senhor a Jeremias, a qual dizia:"},{text:"2 Ouvi as palavras desta aliança, e falai aos varões de Judá, e aos moradores de Jerusalém,"},{text:"3 tools — see the cookie policy for details"},{text:"4 a qual eu fiz com vossos pais no dia em que os tirei da terra do Egito, da fornalha de ferro, dizendo: Ouvi a minha voz, e fazei tôdas as coisas que vos mando, e vós sereis o meu povo, e eu serei o vosso Deus:"},{text:"5 Para que eu renove o juramento, que jurei a vossos pais, que eu lhes daria uma terra que manasse leite, e mel, assim como é o dia de hoje. E respondi, e disse: Amém, Senhor."},{text:"6 E o Senhor me disse: Dize a vozes tôdas estas palavras nas cidades de Judá, e fora de Jerusalém, dizendo: Ouvi as palavras desta aliança, e observai-as:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Porque eu conjurei com instância a vossos pais no dia em que os tirei da terra do Egito até hoje em dia: Levantando-me de manhã os conjurei e disse: Ouvi a minha voz:"},{text:"8 E não ouviram, nem inclinaram o seu ouvido: Mas seguiu cada um a pravidade do seu coração maligno: E fiz vir sôbre êles tôdas as palavras desta aliança, que lhes mandei observar, e não as observaram."},{text:"9 E o Senhor me disse: Uma conjuração se achou nos varões de Judá, e nos moradores de Jerusalém."},{text:"10 Tornaram às primeiras maldades de seus pais, que não quiseram ouvir as minhas palavras: E êstes também foram após de deuses estranhos para os servir: A casa de Israel, e a casa de Judá romperam a minha aliança, que eu"},{text:"fiz com seus pais."},{text:"11 Pelo que isto diz o Senhor: Eis-aqui estou eu que farei vir sôbre êles calamidades, das quais não poderão sair: E clamarão a mim, e eu os não ouvirei."},{text:"12 E irão as cidades de Judá, e os moradores de Jerusalém, e clamarão aos deuses a quem oferecem libações, e não os livrarão no tempo da sua aflição."},{text:"13 Porque os teus deuses, ó Judá, eram segundo o número das tuas cidades: E segundo o número das tuas ruas, ó Jerusalém, puseste aras de confusão, aras para ofereceres libações a Baal."},{text:"14 Tu pois não queiras orar por êste povo, e não empreendas por êles louvor algum nem oração: Porque eu os não ouvirei no tempo em que êles clamarem a mim, no tempo da sua aflição."},{text:"15 De onde vem, que aquêle que eu amo cometeu tantas maldades na minha casa? acaso as carnes santas apartarão de ti as tuas malícias em que te gloriaste?"},{text:"16 O Senhor te pôs o nome de oliveira fecunda, formosa, fértil, vistosa: À voz da sua palavra se acendeu nela um grande fogo, e se queimaram as suas ramas."},{text:"17 E o Senhor dos exércitos que te plantou, pronunciou calamidades contra ti: Por causa dos males da casa de Israel, e da casa de Judá, que êles fizeram em seu dano para me irritar, oferecendo libações a Baal."},{text:"18 Mas tu, Senhor, assim mo mostraste, e eu o conheci: Tu então me descobriste os intentos dêles."},{text:"19 E eu era como um manso cordeiro, que é levado a ser vítima: E não soube que êles formaram desígnios contra mim, dizendo: Ponhamos o pau no seu pão, e exterminemo-lo da terra dos viventes, e não haja mais memória do"},{text:"seu nome."},{text:"20 Mas tu, Senhor dos exércitos, que julgas segundo a eqüidade, e que sondas os afetos e os corações, faze que eu veja as vinganças que tomarás dêles: Pois a ti descobri a minha causa."},{text:"21 Portanto isto diz o Senhor, aos varões de Anatot, que buscam a tua alma, e dizem: Não profetarás em nome do Senhor, e não morrerás às nossas mãos."},{text:"22 Portanto isto diz o Senhor dos exércitos: Eis-aqui estou eu que irei com a minha visita sôbre êles: Os mancebos morrerão à espada, os filhos dêles, e as suas filhas morrerão de fome."},{text:"23 E não ficarão relíquias dêles: Porque enviarei castigo sôbre os varões de Anatot, ano de visitação para êles."},{text:"Jeremias — capítulo 12."},{text:"1 Justo na verdade és tu, Senhor, se eu disputar contigo: Portanto coisas justas te falarei a ti: Por que motivo é prosperado o caminho dos ímpios? Sucede bem a todos os que prevaricam, e fazem mal?"},{text:"2 Plantaste-os, e lançaram raízes, medram e fazem fruto: Perto estás tu da bôca dêles, e longe das suas entranhas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Até quando chorará a terra, e se secará a erva de todo o campo pela maldade dos que moram nela? Consumidos têm sido os animais, e as aves, porque disseram: Não verá êle os nossos novíssimos."},{text:"5 Se te fatigaste em seguir correndo aos que iam a pé: Como poderás competir com os que vão a cavalo? e se tiveres estado quieto em terra de paz, que farás na soberba do Jordão?"},{text:"6 Porque assim os teus irmãos, como os da casa de teu pai, ainda êsses mesmos pelejaram contra ti, e clamaram após de ti a grandes vozes: Não te fies dêles quando te falarem com agrado."},{text:"7 Deixei a minha casa, e abandonei a minha herança: Dei a minha amada alma em mãos de seus inimigos."},{text:"8 Tal se me tem tornado a minha herança como leão em selva: Tem dado voz contra mim, por isso eu a aborreci."},{text:"9 Acaso é para mim a minha herança como uma ave de várias côres? acaso é como a ave pintada por todo o corpo? vinde, congregai-vos tôdas as alimárias da terra, apressai-vos a devorá-la."},{text:"10 Muitos pastôres destruíram a minha vinha, pisaram a minha porção: Trocaram a minha apetecível herança em deserto de solidão."},{text:"11 Tornaram-na em desolação, e chorou sôbre mim: Tem sido inteiramente desolada tôda a terra. Porque não há nenhum que considere no seu coração."},{text:"12 Por todos os caminhos do deserto vieram destruidores, porque a espada do Senhor devorará desde um extremo da terra até outro extremo: Não há paz para nenhum vivente."},{text:"13 Semearam trigo, e segaram espinhos: Receberam a herança mas não lhes aproveitará: Envergonhados sereis de vossos frutos pela ira do furor do Senhor."},{text:"14 Isto diz o Senhor contra todos os meus vizinhos péssimos que tocam a herança, que reparti pelo meu povo de Israel: Eis-aqui estou eu que os arrancarei a êles da sua terra, e arrancarei a casa de Judá do meio dêles."},{text:"15 E quando os houver arrancado, voltar-me-ei, e haverei piedade dêles: E os farei voltar cada um à sua herança e cada um à sua terra."},{text:"16 E acontecerá isto: Se escarmentados aprenderem os caminhos do meu povo, de maneira que jurem no meu nome: Vive o Senhor, assim como ensinaram o meu povo a jurar por Baal: Serão edificados no meio do meu povo."},{text:"17 Porém se não ouvirem, arrancarei pela raiz e com extermínio aquela gente, diz o Senhor."},{text:"Jeremias — capítulo 13."},{text:"1 Isto me disse a mim o Senhor: Vai, e compra para ti um cinto de linho, e pô-lo-ás sôbre os teus lombos, e não o metas na água."},{text:"2 E comprei um cinto conforme a palavra do Senhor e o pus à roda dos meus lombos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"3 tools — see the cookie policy for details"},{text:"4 Toma o cinto que compraste, que tens à roda dos teus lombos, e levantando-te vai ao Eufrates e esconde-o ali no buraco de uma pedra."},{text:"5 E fui, e escondi-o no Eufrates, como o Senhor mo havia mandado."},{text:"6 E sucedeu que passados muitos dias me disse o Senhor: Levanta-te, vai ao Eufrates: E toma dali o cinto, que te mandei que o escondesses ali."},{text:"7 E fui ao Eufrates e cavei, e tomei o cinto do lugar onde o havia escondido: E eis-que já tinha apodrecido o cinto, de tal sorte que não servia para uso algum."},{text:"8 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"9 Isto diz o Senhor: Assim farei apodrecer a soberba de Judá, e a muita soberba de Jerusalém."},{text:"10 A êstes povos perversíssimos que não querem ouvir as minhas palavras, e andam na pravidade do seu coração: E foram após dos deuses estranhos, para os servir e os adorar: E serão como êsse cinto, que para nenhum uso é"},{text:"bom."},{text:"11 Porque assim como se une o cinto aos lombos de um homem, assim eu uni estreitamente comigo tôda a casa de Israel, e tôda a casa de Judá, diz o Senhor: Para que fôssem o meu povo, e do meu nome, e para meu louvor, e"},{text:"para minha glória: E não ouviram."},{text:"12 Pelo que lhes dirás a êles estas palavras: Isto diz o Senhor Deus de Israel: Tôda a vasilha se encherá de vinho. E êles te dirão a ti: Acaso ignoramos que tôda a vasilha se encherá de vinho?"},{text:"13 E tu lhes dirás a êles: Isto diz o Senhor: Eis-aqui estou eu que encherei de embriaguez a todos os moradores desta terra, e aos reis da estirpe de Davi que se assentam sôbre o seu trono, e aos sacerdotes, e aos"},{text:"profetas, e a todos os moradores de Jerusalém:"},{text:"14 E pô-los-ei a cada um dispersos de seu irmão, e igualmente aos pais e aos filhos, diz o Senhor: Não perdoarei, e não me aplacarei: Nem usarei de clemência para que os não destrua."},{text:"15 Ouvi, e percebei nos vossos ouvidos: Não vos ensoberbeçais, porque o Senhor falou."},{text:"16 Dai glória ao Senhor vosso Deus, antes que sobrevenham as trevas, e antes que tropecem vossos pés nos montes tenebrosos: Esperareis luz, e mudá-la-á em sombra de morte, e em escuridão."},{text:"17 Porque se isto não ouvirdes, chorará a minha alma em segrêdo à vista da vossa soberba: Pranteando chorará, e os meus olhos verterão lágrimas, porque foi cativo o rebanho do Senhor."},{text:"18 Dize ao rei, e à rainha: Humilhai-vos, assentai-vos no chão, porque a coroa da vossa glória caiu da vossa cabeça."},{text:"19 As cidades do Meio-dia estão fechadas, e não há quem as abra: Todo Judá foi transferido na transmigração geral."},{text:"20 Levantai os vossos olhos, e vêde os que vêm do Aquilão: Onde está o rebanho, que te foi confiado, êsse teu gado famoso?"},{text:"21 Que dirás quando Deus te visitar? porque tu os ensinaste contra ti, e os instruíste para tua ruína: Acaso não te tomarão dores, como a mulher que está de parto?"},{text:"22 E se disseres no teu coração: Por que me vieram êstes males? Pela multidão das tuas iniqüidades tem sido descoberto o mais vergonhoso que em ti há: Têm-se contaminado as tuas plantas."},{text:"23 Se um etíope pode mudar a sua pele, ou um leopardo as suas malhas: Podereis vós também fazer o bem, vós que não aprendestes senão a fazer o mal."},{text:"24 E eu os espalharei como a moinha, que pelo vento é arrebatada no deserto."},{text:"25 Esta é a tua sorte, e a parte da tua medida que terás de mim, diz o Senhor, porque te esqueceste de mim, e tens confiado na mentira:"},{text:"26 Por isso eu também descobri as tuas coxas das pernas contra a tua face, e apareceu a tua ignomínia,"},{text:"27 os teus adultérios, e os teus rinchos, a maldade da tua fornicação: E eu vi as abominações que tu fizeste sôbre os outeiros no meio do campo. Ai de ti, Jerusalém, não serás tu jamais limpa, resolvendo-te a me"},{text:"seguires: Até quando ainda?"},{text:"Jeremias — capítulo 14."},{text:"1 Palavra do Senhor, que foi dirigida a Jeremias, pelo que diz respeito a uma sêca."},{text:"2 Chorou a Judéia, e caíram as suas portas, e ficaram obscurecidas por terra, e subiu o clamor de Jerusalém."},{text:"3 tools — see the cookie policy for details"},{text:"4 Pela desolação da terra, porque não veio chuva sôbre a terra, se confundiram os lavradores, cobriram as suas cabeças."},{text:"5 Porquanto a cerva também pariu no campo a sua cria, e a abandonou: Porque não havia erva."},{text:"6 E os asnos monteses puseram-se nos rochedos, enguliram vento como os dragões, desfaleceram os seus olhos, porque não havia erva."},{text:"7 Se as nossas iniqüidades houverem dado testemunho contra nós: Tu, Senhor, usa conosco de clemência por amor do teu nome, porque muitas são as nossas rebeldias, contra ti temos pecado."},{text:"8 Ó esperança de Israel, Salvador seu no tempo da tribulação: Por que hás de ser nesta terra como um estranho, e como um viandante que toma o seu caminho para albergar na estalagem por pouco tempo?"},{text:"9 Por que hás de ser como um homem vagabundo, como um homem forte que não pode salvar? mas tu, Senhor, entre nós estás, e o teu nome tem sido invocado sôbre nós, não nos desampares."},{text:"10 Isto diz o Senhor a êste povo, que gostou de mover os seus pés, e não repousou, nem agradou ao Senhor: Agora se lembrará das maldades dêles, e visitará os seus pecados."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 11",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 Outrossim me disse o Senhor: Não me peças que eu perdoe a êste povo."},{text:"12 Quando êles jejuarem, eu não escutarei as suas rogativas: E se êles me oferecerem holocaustos, ou vítimas, eu os não aceitarei: Porque os consumirei pela espada, e pela fome, e pela peste."},{text:"13 E disse eu A, a, a, Senhor Deus, os profetas lhes dizem: Não vereis espada, e não haverá fome entre vós, mas êle vos dará paz verdadeira neste lugar."},{text:"14 E me disse o Senhor: Os profetas falsamente vaticinam em meu nome: Não os enviei, nem lho mandei, nem lhes falei: Tudo o que vos profetizam é uma visão mentirosa, e uma adivinhação, e impostura, e engano do seu"},{text:"coração."},{text:"15 Portanto isto diz o Senhor acêrca dos profetas, que profetizam em meu nome, ainda que eu os não tenha enviado, dizendo: A espada, e a fome não afligirão esta terra: Êstes mesmos profetas hão de ser consumidos à espada"},{text:"e à fome."},{text:"16 E os povos, a quem profetizam, serão lançados nas ruas de Jerusalém com a fome e a espada, e não haverá quem os sepulte, êles mesmos, e suas mulheres, seus filhos e filhas, e derramarei o seu mal sôbre êles."},{text:"17 E lhes dirás a êles esta palavra: Derramem os meus olhos lágrimas de noite e de dia, e não cessem: Porque de grande ruína ficou maltratada a virgem filha do meu povo, de chaga muito maligna em extremo."},{text:"18 Se eu sair aos campos, eis-ali se vêem mortos à espada: E se entrar na cidade, eis-ali se acham extenuados de fome. Até o profeta, e o sacerdote foram a uma terra, que não conheciam."},{text:"19 Porventura rejeitaste de todo a Judá? ou aborreceu a tua alma a Sião? logo por que nos tens ferido, sem que nos reste melhora alguma? esperamos a paz, e não há bem: E o tempo da cura, e eis nós todos em perturbação."},{text:"20 Nós reconhecemos, Senhor, as nossas impiedades, as iniqüidades de nossos pais, porque pecamos contra ti."},{text:"21 Não nos entregues ao opróbrio por amor do teu nome, nem permitas que sejamos a afronta do sólio da tua glória: Lembra-te, não anules a tua aliança conosco."},{text:"22 Acaso há entre os simulacros das gentes alguns que façam chover? ou podem os céus dar chuvas? não és tu o Senhor nosso Deus, a quem esperamos? pois tu tens feito tôdas essas coisas."},{text:"Jeremias — capítulo 15."},{text:"1 E o Senhor me disse: Ainda que Moisés, e Samuel se puserem diante de mim, não está a minha alma com êste povo: Tira-os diante da minha face, e saiam."},{text:"2 E se te disserem a ti: Para onde sairemos? lhes dirás a êles: Isto diz o Senhor: O que para a morte, para a morte: E o que para a espada, para a espada: E o que para a fome, para a fome: E o que para o cativeiro, para"},{text:"o cativeiro."},{text:"3 tools — see the cookie policy for details"},{text:"4 E eu os porei à furiosa perseguição de todos os reinos da terra: Por causa de Manassés, filho de Ezequias, rei de Judá, por tudo o que fêz em Jerusalém."},{text:"5 Quem se compadecerá logo de ti, ó Jerusalém? Ou quem se entristecerá por ti? Ou quem irá a rogar pela tua paz?"},{text:"6 Tu me deixaste, diz o Senhor, tu voltaste para trás: Por isso eu estenderei a minha mão sôbre ti, e te matarei: Porque estou cansado de rogar."},{text:"7 E espalhá-los-ei com a pá nas portas da terra: Matei e destruí o meu povo, e ainda com tudo isso não se tem deixado dos seus caminhos."},{text:"8 Multiplicadas foram por mim as suas viúvas, mais que as areias do mar: Enviei contra êles um Exterminador que ao meio-dia matasse o menino nos braços da mãe: Espalhei pelas cidades um repentino terror."},{text:"9 A que pariu sete enfraqueceu, a sua alma caiu em desfalecimento: O sol se pôs para ela, quando ainda era dia: Ela ficou coberta de confusão, e de vergonha: E os que ficarem dela, dá-los-ei à espada à vista de seus"},{text:"inimigos, diz o Senhor."},{text:"10 Ai de mim, minha mãe: Por que me geraste varão de contenda, varão de discórdia em tôda a terra? Nunca lhes dei dinheiro a usura, nem a mim mo deu ninguém: Todos me amaldiçoam."},{text:"11 O Senhor diz: Juro que o teu fim irá em bem, que eu te assisti no tempo da aflição, e no tempo da tribulação contra o inimigo."},{text:"12 Acaso ligar-se-á o ferro com o ferro da parte do Aquilão, e o bronze?"},{text:"13 Eu darei sem preço ao saque as tuas riquezas e os teus tesouros por todos os teus pecados, e em todos os teus limites."},{text:"14 E trarei os teus inimigos duma terra, que não sabes: Porque o fogo se tem ateado no meu furor, sôbre vós arderá."},{text:"15 Tu o sabes, Senhor, lembra-te de mim, e visita-me, e defende-me daqueles que me perseguem, não tardes em amparar-me: Sabe que por amor de ti tenho sofrido afronta."},{text:"16 Acharam-se os teus discursos, e eu os comi, e a tua palavra foi para mim o prazer e a alegria do meu coração: Porque invocado foi o teu nome sôbre mim, Senhor Deus dos exércitos."},{text:"17 Não me assentei no congresso dos escarnecedores, nem me gloriei à face da tua mão: Eu estava sentado só, porquanto me encheste de ameaças."},{text:"18 Por que se tem feito perpétua a minha dor, e a minha chaga maligna recusou ser curada? tem-se tornado para mim como engano de águas que não são fiéis."},{text:"19 Por esta causa o Senhor diz isto: Se te converteres, eu te converterei, e estarás diante da minha face: E se apartares o precioso do vil, serás como a minha bôca: Voltar-se-ão êles para ti, e tu não voltarás para"},{text:"êles."},{text:"20 E dar-te-ei eu a êste povo por um muro de bronze, por um muro forte: E pelejarão contra ti, e não poderão mais do que tu: Porque eu contigo sou para te salvar, e te livrar, diz o Senhor."},{text:"21 E livrar-te-ei da mão dos malvadíssimos, e redimir-te-ei da mão dos fortes."},{text:"Jeremias — capítulo 16."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"2 Tu não tomarás mulher, nem terás filhos, nem filhas neste lugar."},{text:"3 tools — see the cookie policy for details"},{text:"4 De mortes causadas de enfermidades morrerão: Não serão chorados, nem enterrados, em um muladar, sôbre a face da terra estarão: E a cutelo, e de fome serão consumidos: E o cadáver dêles servirá de pasto às aves do céu,"},{text:"e às alimárias da terra."},{text:"5 Porque isto diz o Senhor: Não entres na casa do convite, nem vás à casa onde se chora, nem os consoles: Porque eu retirei dêste povo a minha paz, diz o Senhor, a minha misericórdia, e as minhas comiserações."},{text:"6 E morrerão grandes e pequenos nesta terra: Não serão sepultados nem chorados, e não se farão por êles incisões, nem por êles se raparão os cabelos."},{text:"7 E não partirão entre êles pão para consolar ao que chora sôbre um morto: E não lhes darão a beber um vaso d'água para os consolar sôbre seu pai e mãe."},{text:"8 Não entres na casa do banquete, para te assentares tanto a comer como a beber com êles:"},{text:"9 Porque isto diz o Senhor dos exércitos, o Deus de Israel: Eis-aqui estou eu que desterrarei dêste lugar a vossos olhos, e em vossos dias a voz de júbilo, e a voz de alegria, a voz de espôso, a voz de espôsa."},{text:"10 E quando anunciares a êste povo tôdas estas coisas, e te disserem: Por que falou o Senhor sôbre nós todo êste grande mal? Que iniqüidade é a nossa? E que pecado é o nosso que nós cometemos contra o Senhor nosso Deus?"},{text:"11 Tu lhes dirás: É porque vossos pais me abandonaram, diz o Senhor: E foram após dos deuses estranhos, e os serviram, e os adoraram: E a mim me abandonaram, e não guardaram a minha lei."},{text:"12 E vós mesmos ainda fizestes pior do que vossos pais: Porque eis-aí está que cada um vai atrás da pravidade do seu mau coração, para me não dar ouvidos:"},{text:"13 E lançar-vos-ei desta terra para uma terra, que não conheceis vós, nem vossos pais: E servireis ali a deuses estranhos de dia e de noite, os quais vos não darão descanso."},{text:"14 Portanto eis-aí vêm os dias, diz o Senhor, e não se dirá daqui em diante: Vive o Senhor, que tirou aos filhos de Israel da terra do Egito,"},{text:"15 mas sim, vive o Senhor, que tirou os filhos de Israel da terra do Aquilão, e de tôdas as terras, para onde os lancei: E fá-los-ei voltar a esta sua terra que eu dei a seus pais."},{text:"16 Eis-aí mandarei eu muitos pescadores, diz o Senhor, e êles os pescarão: E depois disto lhes enviarei muitos caçadores, e caçá-los-ão de todo o monte, e de todo o outeiro, e das cavernas dos penhascos."},{text:"17 Porque os meus olhos estão postos sôbre todos os caminhos dêles: Não se me tem escondido da minha presença, e não se encobriu aos meus olhos a sua iniqüidade."},{text:"18 E primeiramente pagarei em dôbro as suas maldades e pecados: Porque contaminaram a minha terra com os corpos mortos sacrificados aos seus ídolos, e encheram das suas abominações a minha herança."},{text:"19 Senhor, fortaleza minha, e amparo meu, e o meu refúgio no dia da tribulação: A ti virão as gentes desde as extremidades da terra, e dirão: Verdadeiramente possuíram nossos pais a mentira, a vaidade, que lhes não"},{text:"aproveitou."},{text:"20 Acaso fará um homem deuses para si, quando êles não são deuses?"},{text:"21 Pelo que eis-aqui estou eu que lhes mostrarei por esta vez, mostrar-lhes-ei a minha mão, e o meu poder: E saberão que o meu nome é o do Senhor."},{text:"Jeremias — capítulo 17."},{text:"1 O pecado de Judá está escrito com um ponteiro de ferro numa unha de diamante, gravado sôbre a largura do coração dêles, e nos ângulos das suas aras."},{text:"2 Quando os seus filhos se lembrarem das suas aras, e dos seus bosques, e das árvores frondosas nos montes altos,"},{text:"3 tools — see the cookie policy for details"},{text:"4 E ficarás só despojada da tua herança, que te dei: E te farei servir aos teus inimigos na terra, que não conheces: Porquanto ateaste um fogo na minha sanha, que para sempre arderá."},{text:"5 Isto diz o Senhor: Maldito o homem que confia no homem e põe a carne por seu arrimo, e cujo coração se retira do Senhor."},{text:"6 Porque será como as tamargueiras no deserto, e não verá quando vier o bem: Mas habitará em secura no deserto, numa terra de salsugem e inabitável."},{text:"7 Bem-aventurado o varão, que confia no Senhor, e de quem o Senhor fôr a esperança."},{text:"8 E será como a árvore, que é transplantada sôbre as águas, que estende as suas raízes para a umidade: E não temerá quando vier o calor. E será verde a sua fôlha, e em tempo de sêca não terá míngua, nem jamais deixará de"},{text:"fazer fruto."},{text:"9 Depravado é o coração de todos, e impenetrável: Quem o conhecerá?"},{text:"10 Eu sou o Senhor que esquadrinho o coração, e que sondo os afetos: Que dou a cada um segundo o seu caminho, e segundo o fruto das invenções do seu capricho."},{text:"11 A perdiz chocou os ovos que não pôs: Assim o injusto ajuntou riquezas, e não com direito: No meio de seus dias as deixará, e no seu fim será insipiente."},{text:"12 O trono da glória do Altíssimo é desde o princípio, lugar da nossa santificação."},{text:"13 Senhor, tu és a esperança de Israel: Todos os que te deixam, serão confundidos: Os que se apartam de ti, serão escritos sôbre a terra: Porque deixaram o Senhor, que é a fonte das águas vivas."},{text:"14 Cura-me, Senhor, e eu serei curado: Salva-me, e serei salvo: Porque tu és o meu louvor."},{text:"15 Eis-aí me estão êles dizendo: Onde está a palavra do Senhor? Venha."}]}] 1
