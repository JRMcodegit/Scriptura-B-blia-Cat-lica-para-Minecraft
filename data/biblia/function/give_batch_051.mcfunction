give @p minecraft:written_book[written_book_content={title:"Eclesiástico Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Bem-aventurado o homem, a quem foi conferido o dom de ter o temor de Deus: Com quem se comparará aquêle que o possui?"},{text:"16 O temor de Deus é o princípio do seu amor: Mas inseparàvelmente se lhe deve ajuntar um princípio de fé."},{text:"17 A tristeza do coração é uma praga universal: E a maldade da mulher é uma consumada malícia."},{text:"18 E sofrerá qualquer tôda a chaga, porém não a chaga do coração:"},{text:"19 E tôda a malícia, porém não a malícia da mulher."},{text:"20 E tôda a calamidade, porém não a calamidade dos que nos têm ódio:"},{text:"21 E tôda a vingança, porém não a vingança que vem dos inimigos."},{text:"22 Não há cabeça pior do que a cabeça da cobra:"},{text:"23 E não há ira sôbre a ira da mulher. Será melhor expediente viver com um leão e com um dragão, do que habitar com uma mulher má."},{text:"24 A malignidade da mulher a faz de todo mudar de rosto: E a reveste dum ar ferozmente sombrio como um urso: E a mostra tal como um cilício. No meio de seus vizinhos,"},{text:"25 gemeu o seu marido, e ouvindo suspirou um pouco."},{text:"26 Tôda a malícia é leve em comparação da malícia da mulher: Sôbre ela caia a sorte dos pecadores."},{text:"27 Assim como é para os pés dum velho a subida por areia, do mesmo modo é para o homem quieto a mulher desbocada."},{text:"28 Não olhes para a formosura da mulher, e não desejes uma mulher pela sua formosura."},{text:"29 A ira da mulher, e a sua audácia, e a confusão que a segue é grande."},{text:"30 Se a mulher tem o primeiro lugar no mando, ela se levanta contra seu marido."},{text:"31 A mulher má é o abatimento do coração, e a tristeza do rosto, e a chaga do interior."},{text:"32 Mulher que não faz ditoso a seu marido, é o enfraquecimento das suas mãos, e a debilitação dos seus joelhos."},{text:"33 Da mulher nasceu o princípio do pecado, e por ela é que todos morremos."},{text:"34 Não dês saída à tua água, nem por uma imperceptível abertura: Nem à mulher má liberdade de sair a público."},{text:"35 Se não andar sempre debaixo da tua mão, ela te cobrirá de confusão à vista de teus inimigos."},{text:"36 Separa-te dela quanto ao corpo, a fim de que não abuse sempre de ti."},{text:"Eclesiástico — capítulo 26."},{text:"1 Bem-aventurado o homem que tem uma virtuosa mulher: Porque dobrado será o número dos seus anos."},{text:"2 A mulher forte é a alegria de seu marido, e ela lhe fará encher em paz a carreira dos anos da sua vida."},{text:"3 tools — see the cookie policy for details"},{text:"4 E estará satisfeito o coração dum e de outro, seja rico ou pobre; o seu rosto ver-se-á alegre em todo o tempo."},{text:"5 De três coisas se receou o meu coração, e com a quarta esmoreceu o meu semblante:"},{text:"6 Da delação duma cidade: E do levantamento dum povo mancomunado:"},{text:"7 Da calúnia mentirosa, coisas tôdas mais incomportáveis do que a morte:"},{text:"8 Mas a mulher ciosa é a dor, e o triste pranto do coração."},{text:"9 Na mulher ciosa se acha o flagelo da língua, o qual a todos se comunica."},{text:"10 Assim como é o jugo dos bois, que está largo, assim também é a mulher má: O que a toma, é como quem toma um escorpião."},{text:"11 A mulher dada ao vinho é uma grande irritação: E a sua ignomínia, e infâmia não será oculta."},{text:"12 A prostituição da mulher reconhecer-se-á na altiveza dos olhos, e nas suas pálpebras."},{text:"13 Dobra a tua vigilância a respeito da filha, que não tem recolhimento: Para que não abuse de si, achada que seja a ocasião."},{text:"14 Vigia sôbre todo o desavergonhamento dos seus olhos, e não estranhes se ela te desprezar."},{text:"15 Ela bem como o viandante sequioso abrirá a bôca para se saciar na fonte, e beberá de tôda a água que tiver à mão, e sôbre tôda a estaca se assentará, e a tôda a seta abrirá a aljava até mais não poder."},{text:"16 A graça duma mulher cuidadosa deleitará a seu marido, e lhe infundirá vigor até aos ossos."},{text:"17 A boa criação dela é um dom de Deus."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Eclesiástico Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"18 Sendo uma mulher sensata e amiga do silêncio, não admite comutação a sua alma instruída."},{text:"19 A mulher santa, e cheia de pudor, é uma graça sôbre outra graça."},{text:"20 Pois todo o preço é nada em comparação duma alma continente."},{text:"21 Tal qual é o sol para o mundo quando nasce nas alturas de Deus, assim é a gentileza duma mulher boa para ornamento da sua casa."},{text:"22 Também a graciosidade do rosto numa idade madura é como um resplandecente lume sôbre o candeeiro santo."},{text:"23 Do mesmo modo os pés que se firmam sôbre as plantas da mulher constante são como umas colunas de ouro sôbre bases de prata."},{text:"24 Os mandamentos de Deus são no coração da mulher santa, como uns fundamentos eternos sôbre a pedra sólida."},{text:"25 Com duas coisas se entristeceu o meu coração, e pela terceira veio a atear-se em mim a ira:"},{text:"26 Um homem de guerra que perece à míngua: E um homem sábio que é desprezado:"},{text:"27 E aquêle que passa da justiça ao pecado, a êste último tem Deus reservado para os fios da espada."},{text:"28 Duas sortes de coisas me pareceram difíceis, e perigosas: Dificultosamente se despe da negligência o que negocia: E o estalajadeiro não se isentará dos pecados de seus lábios."},{text:"Eclesiástico — capítulo 27."},{text:"1 Por causa da pobreza muitos delinqüiram: E aquêle que procura enriquecer-se, aparta a sua mira."},{text:"2 Bem como se finca um pau no meio da juntura de duas pedras, assim também entre a venda e a compra mediará o pecado com uma união mui estreita."},{text:"3 tools — see the cookie policy for details"},{text:"4 Se te não mantiveres firmemente no temor do Senhor, depressa a tua casa será arruinada."},{text:"5 Bem como na sacudidura do crivo ficará o pó, assim a perplexidade do homem se acha no seu pensamento."},{text:"6 O forno prova os vasos do oleiro, e aos homens justos a tentativa da tribulação."},{text:"7 Bem como o cuidado que se tem da árvore se dá a conhecer pelo seu fruto, assim descobre ao homem a palavra nascida do modo de pensar do seu coração."},{text:"8 Não louves ao homem antes dêle falar: Porque esta é a prova dos homens."},{text:"9 Se seguires a justiça, apanhá-la-ás: E dela te revestirás como duma vestidura talar de honra, e com ela habitarás, e ela te protegerá para sempre, e no dia do reconhecimento acharás firmeza."},{text:"10 As aves chegam-se para os seus semelhantes: E a verdade tornará para aquêles que prezam o trato dela."},{text:"11 O leão está sempre à espreita da preia: Assim os pecados aos que obram iniqüidades."},{text:"12 O homem santo permanece na sabedoria como o sol: O insensato porém muda-se como a lua."},{text:"13 No meio dos insensatos guarda a palavra para seu tempo: Mas acha-te de contínuo entre os que pensam."},{text:"14 A conversação dos pecadores se faz odiosa, e o seu riso é sôbre as delícias do pecado."},{text:"15 A língua que muito jura fará arripiar os cabelos da cabeça: E a sua irreverência fará tapar os ouvidos."},{text:"16 Na bulha dos soberbos há efusão de sangue: E é coisa pesada ouvir as suas maldições."},{text:"17 Aquêle que descobre os segredos do amigo, perde o crédito, e não achará amigo à sua satisfação."},{text:"18 Ama a teu próximo, e une-te a êle com lealdade."},{text:"19 Mas se descobrires os seus segredos, não vás após dêle."},{text:"20 Porque assim como se porta o homem que arruína ao seu amigo, assim também o que destrói a amizade do seu próximo."},{text:"21 E assim como aquêle, que deixa ir da sua mão o pássaro, assim tu abandonaste ao teu próximo, e não o conciliarás mais:"},{text:"22 Não o sigas, porque já está muito distante: Fugiu pois do laço como uma cabra montesa: Porquanto ficou ferida a sua alma."},{text:"23 Não poderás atar-lhe já daí por diante a ferida. E da má palavra há reconciliação:"},{text:"24 Mas o revelar os segredos do amigo, é desesperação duma alma infeliz."},{text:"25 O que acena com o ôlho forja maus desígnios, e ninguém o lançará de si:"},{text:"26 À vista de teus olhos adoçará a sua bôca, e fará admirações sôbre os teus discursos: Ùltimamente porém mudará de linguagem, e nas tuas palavras porá tropêço."},{text:"27 Muitas coisas aborreço, mas nenhuma igualei na aversão a êste tal, e o Senhor o aborrecerá também."},{text:"28 Quando qualquer lança uma pedra ao alto, ela cairá sôbre a sua cabeça: E a ferida à traição abrirá as feridas do traidor."}]}] 1
