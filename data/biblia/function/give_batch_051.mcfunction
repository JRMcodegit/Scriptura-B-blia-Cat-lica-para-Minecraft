give @p minecraft:written_book[written_book_content={title:"Eclesiástico Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Um cavalo indómito faz-se intratável, e um filho deixado à sua vontade sairá precipitado."},{text:"9 Anima a teu filho, e te fará andar assustado: Brinca tu com êle, e êle te entristecerá."},{text:"10 Não te ponhas a rir com êle, para que lhe não sintas as dores, e não te desbotem no fim os dentes."},{text:"11 Não lhe dês largas na sua mocidade, e não desprezes as suas intenções."},{text:"12 Encurva-lhe a cerviz na mocidade, e zurze-lhe as suas ilhargas enquanto é menino, para que não suceda talvez endurecer-se e não te obedeça, e venha a ser pelo tempo adiante a dor da tua alma."},{text:"13 Ensina a teu filho, e trabalha pelo formar, para que não tropeces na sua afronta."},{text:"14 Um pobre são, e alentado de fôrças, vale mais do que um rico fraco, e atormentado de doenças."},{text:"15 A saúde da alma em santidade de justiça é melhor do que todo o ouro e prata: E o corpo robusto vale mais do que imensos bens."},{text:"16 Não há riquezas maiores do que as da saúde do corpo: Nem contentamento que seja igual à alegria do coração."},{text:"17 Melhor é a morte do que a vida amargurada: E o descanso eterno do que um achaque perseverante."},{text:"18 Os bens escondidos na bôca cerrada são como as cobertas de um banquete postas em tôrno de um sepulcro."},{text:"19 De que servirá ao ídolo a oblação? Pois que êle nem a comerá, nem lhe tomará o cheiro:"},{text:"20 Assim acontece ao que é perseguido pelo Senhor, levando o pago da sua iniqüidade:"},{text:"21 Vendo com seus olhos, e gemendo como um eunuco que abraça a donzela e suspira."},{text:"22 Não dês tristeza à tua alma, e não te aflijas a ti mesmo no teu conselho."},{text:"23 O júbilo do coração êsse é a vida do homem, e um tesouro inexaurível de santidade: E o regozijo do homem é a longura da sua vida."},{text:"24 Tem piedade com a tua alma fazendo-te agradável a Deus, e contém-te: Reúne o teu coração na santidade do mesmo Deus, e afugenta para longe de ti a tristeza."},{text:"25 Porque a tristeza tem morto a muitos, e não há utilidade nela."},{text:"26 A inveja e a ira abreviam os dias, e o cuidado fará chegar a velhice antes do tempo."},{text:"27 Um coração desassombrado, e bom, está em banquetes: Porque as suas iguarias se lhe preparam com diligência."},{text:"Eclesiástico — capítulo 31."},{text:"1 A vigília que se tem para ajuntar bens definhará as carnes e a aplicação a isto tirará o sono."},{text:"2 O pensamento inquieto sôbre o que há de suceder traz alienado o sentido, e a enfermidade grave faz a alma sóbria."},{text:"3 tools — see the cookie policy for details"},{text:"4 Trabalhou o pobre defraudando-se do sustento, e no fim acha-se necessitado."},{text:"5 Aquêle que ama o ouro, não será justificado: E aquêle que vai no alcance da corrupção, será cheio dela."},{text:"6 Muitos deram quedas por causa do ouro, e na vista refulgente dêste consistiu a perdição daqueles."},{text:"7 Lenho de tropêço é o ouro dos que lhe fazem sacrifícios: Ai daqueles que vão após dêle, e todo o imprudente perecerá por êle."},{text:"8 Bem-aventurado o rico, que foi achado sem mancha e que se não deixou ir após o ouro, nem esperou no dinheiro, nem nos tesouros."},{text:"9 Quem é êste, e nós o louvaremos? Porque fêz coisas maravilhosas em sua vida."},{text:"10 Ao que foi provado no ouro, e se achou ser perfeito, isto lhe servirá de glória eterna: O que pôde transgredir a lei de Deus, e não a transgrediu: O que pôde fazer mal e não o fêz;"},{text:"11 Por isso os seus bens foram assegurados no Senhor, e tôda a igreja dos Santos celebrará as suas esmolas."},{text:"12 Sentaste-te a uma grande mesa? Não sejas o primeiro que sôbre ela abras a tua garganta."},{text:"13 Não digas assim: Muitas são as iguarias que há sôbre ela:"},{text:"14 Lembra-te que é má coisa um ôlho maligno:"},{text:"15 Que coisa há entre as criaturas pior do que o ôlho? Por isso êle banhará de lágrimas todo o seu rosto: Quando olhar,"},{text:"16 não sejas o primeiro que estendas a tua mão, e notado pela inveja te venhas a cobrir de rubor."},{text:"17 Não te portes com desatenta sofreguidão no banquete."},{text:"18 Por ti mesmo entende o que convém a teu próximo:"},{text:"19 Usa como um homem temperado, do que se te puser diante: Não suceda que por comeres muito te faças odioso."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Eclesiástico Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Cessa de comer primeiro que todos em sinal da tua boa criação: E não te desmandes, para que não suceda vires a cair em falta."},{text:"21 E se te assentaste entre muitas pessoas não estendas a tua mão antes delas, nem sejas o primeiro que peças de beber."},{text:"22 Assaz bastante é para qualquer homem regrado uma pequena porção de vinho, e quando dormires não terás o sono inquieto, por seu respeito, nem sentirás dor."},{text:"23 Vigília, cólera, e ânsias terá o homem intemperante:"},{text:"24 No homem parco se achará um sono de saúde, dormirá até pela manhã e a sua alma se deleitará com êle."},{text:"25 E se fôres obrigado a comer muito levanta-te do meio, vai despejar o teu estômago: E esta descarga te aliviará, e não meterás no teu corpo uma doença."},{text:"26 Ouve-me, filho, e não me desprezes: E no fim reconhecerás a verdade das minhas palavras."},{text:"27 Sê pronto em tôdas as tuas ações e não te virá nenhuma enfermidade."},{text:"28 Os lábios de muitos bendirão àquele que dá de comer liberalmente, e o testemunho da sua verdade é fiel."},{text:"29 Contra o malvadíssimo em dar pão murmurará a cidade, e o testemunho da sua malignidade é verdadeiro."},{text:"30 Não provoques a beber àqueles que são amigos do vinho: Porque o vinho perdeu a muitos."},{text:"31 O fogo prova o duro ferro: Assim o vinho bebido até embriagar dará a conhecer os corações dos soberbos."},{text:"32 O vinho bebido com sobriedade é uma segunda vida para os homens: Se tu o beberes moderadamente, serás sóbrio."},{text:"33 Que vida é a daquele que se deixa vencer do vinho?"},{text:"34 Que coisa é a que nos priva da vida? A morte."},{text:"35 O vinho desde o princípio foi criado para regozijo, e não para embriaguez."},{text:"36 O vinho bebido moderadamente é o júbilo da alma e do coração."},{text:"37 A bebida sóbria é a saúde da alma e do corpo."},{text:"38 O vinh