give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"3 Veio pois Moisés referir ao povo tôdas as palavras, e tôdas as ordenações do Senhor: e todo o povo respondeu a uma voz: Nós faremos tudo o que o Senhor disse."},{text:"4 Escreveu Moisés tôdas as ordenações do Senhor: e tendo-se levantado de manhã, erigiu um altar ao sopé do monte, e doze padrões, conforme era o número das doze tribos de Israel."},{text:"5 E tendo enviado alguns mancebos dentre os filhos de Israel, êstes ofereceram seus holocaustos, e imolaram suas vítimas pacíficas, que foram touros."},{text:"6 Moisés tomou metade do sangue, e lançou-a numas taças: e derramou a outra sôbre o altar."},{text:"7 Depois pegou no livro, onde estava escrito o concêrto, e leu-o diante do povo, o qual, depois de o ter ouvido, disse: Tudo o que o Senhor disse faremos, e em tudo lhe seremos obedientes."},{text:"8 Então tomando o sangue, êle o derramou sôbre o povo, e disse: Eis-aqui o sangue do concêrto, que o Senhor celebrou convosco, debaixo das condições, que eu vos propus."},{text:"9 Moisés, Aarão, Nadab, Abiu, e os setenta anciãos de Israel, tendo subido,"},{text:"10 viram o Senhor de Israel, e debaixo dos seus pés uma obra feita de safira, que se parecia com o céu quando está sereno."},{text:"11 O Senhor não estendeu a sua mão para ferir êstes príncipes dos filhos de Israel, que se tinham adiantado até ficarem longe do campo; e, depois de terem visto a Deus, comeram, e beberam."},{text:"12 E o Senhor disse a Moisés: Sobe ao alto do monte onde eu estou, e ficarás aí. Eu te darei umas tábuas de pedra, e a lei, e os mandamentos, que eu escrevi, para que instruas nêles o povo."},{text:"13 Depois se levantou Moisés, e com êle Josué seu ministro; e subindo ao monte de Deus, disse Moisés aos anciãos:"},{text:"14 Esperai-nos aqui até que nós venhamos, vós tendes convosco a Aarão, e a Hur: se sobrevier alguma dificuldade, dar-lhe-eis conta dela."},{text:"15 Tendo subido Moisés, cobriu a nuvem o monte;"},{text:"16 e a glória do Senhor descansou sôbre o Sinai, e cobriu-o de uma nuvem seis dias: e ao sétimo dia chamou Deus a Moisés do meio desta escuridade."},{text:"17 O que aparecia desta glória do Senhor era como um fogo ardente no mais alto do monte, que se deixava ver de todos os filhos de Israel."},{text:"18 E Moisés, atravessando a nuvem, subiu ao monte e ficou quarenta dias, e quarenta noites."},{text:"Êxodo — capítulo 25."},{text:"1 Falou pois o Senhor a Moisés, e lhe disse:"},{text:"2 Ordena aos filhos de Israel, que me ponham à parte os presentes, que me hão de fazer: Vós os recebereis de todos aquêles que mos oferecerem instantâneamente."},{text:"3 Eis-aqui as coisas, que vós deveis receber: ouro, prata, bronze,"},{text:"4 jacintos, púrpura, escarlata tinta duas vêzes, linho fino, peles de cabra,"},{text:"5 peles de carneiro tintas de vermelho, e outras roxas, e paus de cetim:"},{text:"6 azeite para conservar as lâmpadas, aromas para confeccionar os óleos, e perfumes do mais suave cheiro:"},{text:"7 pedras cornalinas, e outras pedras preciosas para se ornar o efod, e o racional."},{text:"8 Êles me farão um santuário, para que eu habite no meio dêles,"},{text:"9 o qual santuário será conforme a exatíssima planta, que eu te hei-de mostrar do tabernáculo; como também o será o modêlo dos vasos, que nêle hão de servir. Eis-aqui como vós fareis êste santuário."},{text:"10 Fareis uma arca de pau de cetim, que tenha dois côvados e meio de comprido, côvado e meio de largo, e côvado e meio de alto."},{text:"11 Tu a dourarás de ouro puríssimo por dentro, e por fora, e pôr-lhe-ás em cima uma coroa de ouro, que apanhe tudo em roda."},{text:"12 Porás quatro argolas de ouro nos quatro cantos da arca, duas duma banda, e duas da outra."},{text:"13 Farás também uns varais de pau de cetim, que cobrirás de ouro."},{text:"14 e os meterás nas argolas, que estão aos lados da arca, para ela ser levada por êles."},{text:"15 Êstes varais estarão sempre metidos nas argolas, e nunca se tirarão delas."},{text:"16 Meterás na arca as tábuas da lei, que te hei de dar."},{text:"17 Farás outrossim um propiciatório de finíssimo ouro, que terá dois côvados e meio de comprido, e côvado e meio de largo."},{text:"18 Porás nas duas extremidades do oráculo dois querubins de ouro batido:"},{text:"19 Um querubim duma parte, outro doutra."},{text:"20 Êles com as suas asas estendidas cobrirão ambos os lados do propiciatório, e o oráculo, e estarão olhando um para o outro com os rostos virados para o propiciatório que cobre a arca,"},{text:"21 na qual tu meterás as tábuas da lei, que eu te hei de dar."},{text:"22 Daí é que eu te darei as minhas ordens. Eu te falarei de cima do propiciatório, do meio dos dois querubins, que estarão sôbre a arca do testemunho, dizendo-te tudo o que eu quiser que tu intimes aos filhos de Israel."},{text:"23 Farás também uma mesa de madeira de cetim, que terá dois côvados de comprido, um côvado de largo, e côvado e meio de alto."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"24 Cobri-la-ás de ouro puríssimo, e guarnecê-la-ás tôda em roda de um friso de ouro."},{text:"25 Porás sôbre esse friso uma coroa de quatro dedos de alto, com seus ornatos de escultura, e sôbre esta outra pequena coroa de ouro."},{text:"26 Farás também quatro argolas de ouro, as quais porás nos quatro cantos da mesma mesa, uma em cada pé."},{text:"27 As argolas de ouro estarão por baixo da coroa, para por elas passarem os varais, quando se quiser levar a mesa."},{text:"28 Farás também de pau de cetim êstes varais, sôbre que se leve a mesa, e cobri-los-ás de ouro."},{text:"29 Farás outrossim de puríssimo ouro pratos, copos, turíbulos e taças, em que se hajam de lançar os licores, que se oferecerem."},{text:"30 E porás sôbre esta mesa os pães da proposição, que estarão sempre expostos na minha presença."},{text:"31 Farás também um candieiro de ouro finíssimo, batido ao martelo, com seu tronco, suas hastes, e seus ornatos em forma de copos, seus pomos, e suas açucenas, que sairão dêle."},{text:"32 Sairão dos lados do tronco seis hastes, três duma parte, três da outra."},{text:"33 Uma haste terá três copos do feitio de nozes, cada um com seu pomo, e sua açucena: outra haste terá da mesma sorte três copos do feitio de nozes, cada um com seu pomo, e sua açucena; e tôdas as seis hastes, que sairão"},{text:"do tronco, serão da mesma sorte."},{text:"34 Mas o tronco do candieiro terá quatro copos do feitio de nozes, acompanhados cada um de seu pomo, e de sua açucena."},{text:"35 Afora isto, haverá três pomos em três lugares do tronco, e de cada pomo sairão duas hastes, que farão ao todo seis hastes, nascendo dum mesmo tronco."},{text:"36 Do candieiro pois sairão êstes pomos, e estas hastes, tudo de puríssimo ouro, batido ao martelo."},{text:"37 Farás outrossim sete lâmpadas, que porás em cima do candieiro, para esclarecerem o que estiver defronte."},{text:"38 Farás também seus espevitadores, e suas caldeirinhas, onde se apague o murrão, que se tiver tirado das lâmpadas, tudo de puríssimo ouro."},{text:"39 O candieiro com tôdas as suas peças terá de pêso um talento de ouro puríssimo."},{text:"40 Toma bem sentido, e faze tudo conforme o modêlo, que te foi mostrado no monte."},{text:"Êxodo — capítulo 26."},{text:"1 O tabernáculo fá-lo-ás assim. Haverá dez cortinas de linho fino retorcido, de côr de jacinto, de púrpura, e de escarlata tingida duas vêzes: e elas serão brincadas de vários bordados."},{text:"2 Cada cortina terá vinte e oito côvados de comprido, e quatro de largo. Tôdas as cortinas terão uma mesma medida."},{text:"3 Cinco cortinas estarão juntadas a uma banda, e outras cinco à outra."},{text:"4 Porás nas ourelas das cortinas dum, e doutro lado uns cordões de jacinto, para que elas se possam chegar umas às outras."},{text:"5 Cada cortina terá cinquenta cordões de cada lado, postos de tal sorte, que quando as cortinas se houverem de chegar, respondam os cordões duma aos da outra, e elas possam prender umas nas outras."},{text:"6 Farás também cinquenta argolas de ouro, que sirvam para ajuntar entre si os dois véus, compostos cada um de cinco cortinas, para que assim pareça ser um só véu o que cobre o tabernáculo."},{text:"7 Farás outrossim onze cobertas de peles de cabra para cobrirem o teto do tabernáculo."},{text:"8 Cada uma destas cobertas terá trinta côvados de comprido, e quatro de largo, e serão tôdas duma mesma medida."},{text:"9 Destas cobertas porás cinco juntas a uma banda e seis juntas à outra, de sorte que dobres a sexta no frontespício do tabernáculo."},{text:"10 Porás também cinquenta cordões na ourela duma destas cobertas, para que ela se possa ajuntar com a outra; e cinquenta cordões na ourela da outra coberta, para esta prender com aquela."},{text:"11 Farás também cinquenta fivelas de metal, pelas quais passem os cordões, a fim de que tôdas estas cobertas pareçam uma só coberta."},{text:"12 E porque destas cobertas, destinadas a cobrir o teto, haverá uma de mais; tu empregarás metade dela em cobrir as costas do tabernáculo."},{text:"13 E como estas cobertas, por serem mais compridas do que as cortinas, descerão mais abaixo um côvado de cada parte; isto, que nelas pende de mais servirá de cobrir os dois lados do tabernáculo."},{text:"14 Farás também uma terceira coberta para o teto, que será de peles de carneiro tintas de vermelho; e outra quarta coberta de peles tintas de roxo."},{text:"15 Farás outrossim umas tábuas de pau de cetim, que estarão levantadas ao redor do tabernáculo."},{text:"16 Cada uma delas terá dez côvados de alto e côvado e meio de largo."},{text:"17 Cada uma terá duma, e outra parte seus encaixes, por onde uma se meta na outra; e tôdas as tábuas estarão dispostas desta mesma maneira."},{text:"18 Vinte estarão do lado meridional, que olha para o Austro."},{text:"19 Farás fundir quarenta bases de prata, para que cada tábua assente sôbre duas bases, que lhe sustentem os dois ângulos."},{text:"20 Estarão também outras vinte tábuas ao outro lado do tabernáculo, que olha para o Aquilão,"},{text:"21 as quais assentarão sôbre outras quarenta bases de prata, tendo cada tábua duas bases, que a sustentem."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 Mas para o lado ocidental do tabernáculo farás seis tábuas,"},{text:"23 e além destas mais duas, que se levantarão nos ângulos das costas do tabernáculo."},{text:"24 Estas tábuas estarão juntas de baixo até cima, e estarão tôdas encaixadas umas nas outras. E da mesma maneira estarão elas unidas às duas tábuas, que estiverem nos ângulos."},{text:"25 Serão pois ao todo oito estas tábuas, que terão dezesseis bases de prata, dando-se duas a cada tábua."},{text:"26 Farás também uns barrotes de pau de cetim: cinco para conterem as tábuas a um lado do tabernáculo,"},{text:"27 e outros cinco para o outro lado, e outros cinco para o lado ocidental."},{text:"28 Êstes barrotes estarão atravessados pelo meio das tábuas duma parte à outra."},{text:"29 Chapearás de ouro estas tábuas, e pôr-lhes-ás umas argolas de ouro, pelas quais passem os barrotes, que hão de segurar o madeiramento; e êstes barrotes serão também chapeados de ouro."},{text:"30 Dêste modo levantarás tu o tabernáculo, conforme o modêlo, que te foi mostrado no monte."},{text:"31 Farás também um véu de côr de jacinto, de púrpura, e de escarlata tingida duas vêzes, e de linho fino retorcido, que tenha que ver pela agradável variedade dos bordados."},{text:"32 Suspendê-lo-ás de quatro colunas de pau de cetim, que serão douradas, e terão os capitéis de ouro, e as bases de prata."},{text:"33 Êste véu estará preso às colunas por umas argolas. Dentro do véu porás a arca do testemunho; e êste véu separará o Santuário do Santo dos Santos."},{text:"34 Porás também o propiciatório sôbre a arca do testemunho no Santo dos Santos."},{text:"35 Mas a mesa pô-la-ás de fora do véu, e defronte da mesa o candieiro, ao lado do tabernáculo, que olha para o meio-dia: porque a mesa deve ser posta no lado setentrional."},{text:"36 Farás também um véu para a entrada do tabernáculo, que será de jacinto, de púrpura, de escarlata tingida duas vêzes, e de linho fino retorcido, sôbre o qual porás alguma obra de bordadura."},{text:"37 Êste véu estará suspenso de cinco colunas de pau de cetim douradas, cujos capitéis serão de ouro, e as bases de metal."},{text:"Êxodo — capítulo 27."},{text:"1 Farás também um altar de pau de cetim, que terá cinco côvados de comprido, e outros tantos de largo, isto é, que será quadrado, e terá três côvados de alto."},{text:"2 Das quatro hastes do altar levantar-se-ão quatro hastes, e tu o cobrirás de bronze."},{text:"3 Farás para o uso do altar umas caldeiras, que servirão para se receberem as cinzas: farás tenazes, forquilhas, e braseiros: tôdas as quais coisas serão de metal."},{text:"4 Farás também uma grelha de metal em forma de rêde, em cujos quatro cantos haverá quatro argolas de metal,"},{text:"5 as quais tu porás debaixo do fogão do altar; e a grelha descerá até o meio da sua altura."},{text:"6 Farás outrossim para o altar dois varais de pau de cetim, os quais chapearás de metal,"},{text:"7 e fá-los-ás passar pelas argolas duma, e outra banda do altar, para servirem a levá-lo."},{text:"8 Não farás o altar maciço, mas oco, e côncavo por dentro, segundo o modêlo que te foi mostrado no monte."},{text:"9 Farás também o átrio do tabernáculo. Êle terá da banda do meio-dia umas cortinas de linho fino retorcido, êste lado terá cem côvados de comprido."},{text:"10 Porás nêle vinte colunas com outras tantas bases de metal: os capitéis, e ornatos das colunas serão de prata."},{text:"11 Da mesma sorte haverá no lado do Aquilão cortinas de cem côvados de comprido, e vinte colunas cada uma com suas bases de metal, seus capitéis, e seus ornatos de prata."},{text:"12 A largura do átrio, que olha para o poente, terá cinquenta côvados, ao longo da qual porás umas cortinas, e dez colunas com outras tantas bases."},{text:"13 A largura do átrio, que olha para o nascente, terá também cinquenta côvados."},{text:"14 Aqui a um lado porás cortinas pelo espaço de quinze côvados, e três colunas com outras tantas bases."},{text:"15 Ao outro lado porás cortinas pelo mesmo espaço de quinze côvados, três colunas, e outras tantas bases."},{text:"16 À entrada do átrio pelo espaço de vinte côvados, porás cortinas de jacinto, de púrpura, de escarlata tingida duas vêzes, e de linho fino retorcido, que serão brincadas de vários bordados. Esta entrada terá quatro"},{text:"colunas com outras tantas bases."},{text:"17 Tôdas as colunas postas à roda do átrio serão forradas de lâminas de prata. Terão capitéis de prata, e bases de metal."},{text:"18 O átrio terá cem côvados de comprido, cinquenta de largo, e cinco de alto. As suas cortinas far-se-ão de linho fino retorcido, e as bases serão de metal."},{text:"19 Todos os vasos, que houverem de servir para qualquer uso, e para qualquer cerimónia do tabernáculo, como também tôdas as estacas, que se empregarem, tanto no tabernáculo, como no átrio, serão de metal."},{text:"20 Ordena aos filhos de Israel, que te tragam do mais puro azeite de oliveira, espremido no gral, para que as lâmpadas luzam sempre"},{text:"21 no tabernáculo do testemunho fora do véu, que está suspenso diante da arca. Aarão, e seus filhos porão as lâmpadas, para que elas luzam até pela manhã diante do Senhor. Êste culto se continuará sempre, e passará de"},{text:"geração em geração entre os filhos de Israel."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"Êxodo — capítulo 28."},{text:"1 Faze também que se cheguem a ti Aarão, teu irmão, com seus filhos, separados do meio dos filhos de Israel, para que êles exercitem diante de mim as funções do sacerdócio: Aarão, Nadab, Abiu, Eleazar, e Itamar."},{text:"2 Farás um vestido santo, e sagrado a Aarão, teu irmão, para glória, e ornamento."},{text:"3 Falarás a todos os que têm o coração cheio de sabedoria, aos quais eu dei um espírito de inteligência, para que façam um vestido a Aarão, e para que êle sendo santificado me sirva no seu ministério."},{text:"4 Eis-aqui os vestidos que êles hão de fazer. O racional, o efod, a túnica, a camisa de linho, que será mais estreita, a mitra, e o cíngulo. Êstes são os vestidos santos, que êles devem fazer a Aarão, teu irmão, e a seus"},{text:"filhos, para exercitarem diante de mim as funções do sacerdócio."},{text:"5 Nisto empregarão êles o ouro, o jacinto, a púrpura, a escarlata tinta duas vêzes, e o linho fino."},{text:"6 Farão o efod de ouro, de jacinto, de púrpura, de escarlata tinta duas vêzes, de linho fino retorcido, cuja obra será tecida da mistura destas côres."},{text:"7 O efod em cima terá duas aberturas nos ombros, que correspondam uma à outra: e estas aberturas estendendo-se para êle se pôr, se tornarão a juntar depois de pôsto."},{text:"8 Tôda a obra será com agradável variedade tecida de ouro, de jacinto, de púrpura, de escarlata tinta duas vêzes, e de linho fino retorcido."},{text:"9 Tomarás também duas ágatas, onde gravarás os nomes dos filhos de Israel."},{text:"10 Uma pedra terá seis nomes, outra outros seis, segundo a ordem do seu nascimento."},{text:"11 Nisto empregarás tu a arte do escultor, e do lapidário: porque hás de gravar nas duas pedras os nomes dos filhos de Israel depois de os teres engastado em ouro."},{text:"12 Pô-las-ás no efod de uma, e outra parte, para servirem de monumento aos filhos de Israel. Aarão trará os seus nomes diante do Senhor, gravados nas duas pedras sôbre os ombros para lembrança."},{text:"13 Farás também uns ganchos de ouro,"},{text:"14 e duas pequenas cadeias de ouro o mais puro, cujos fuzis estejam enlaçados uns aos outros, e prendê-las-ás a êstes ganchos."},{text:"15 Farás outrossim o racional, que será como o efod tecido de ouro, de jacinto, de púrpura, de escarlata tinta duas vêzes, e de linho fino retorcido."},{text:"16 Êle será quadrado e dobrado: terá um palmo tanto de comprido, como de largo."},{text:"17 Porás nêle quatro ordens de pedras preciosas. Na primeira haverá o sardônio, o topázio, a esmeralda:"},{text:"18 Na segunda o carbúnculo, a safira, e o jaspe:"},{text:"19 Na terceira o ligúrio, a ágata, e a ametista:"},{text:"20 Na quarta a crisólita, a cornalina, e o berilo, encastoadas em ouro, conforme a sua ordem."},{text:"21 Porás nelas os nomes dos filhos de Israel: Os seus nomes serão nelas gravados, cada um em sua pedra; conforme a ordem das doze tribos."},{text:"22 Farás para o racional duas pequenas cadeias de ouro o mais puro, cujos fuzis estejam enlaçados uns nos outros:"},{text:"23 e duas argolinhas de ouro, que tu porás no alto do racional a um e outro lado."},{text:"24 Enfiarás as duas cadeias pelas duas argolinhas, que estarão em cima nas duas extremidades do racional;"},{text:"25 e prenderás as extremidades das duas cadeias aos dois ganchos de ouro, que estarão nos dois lados do efod, que corresponde ao racional."},{text:"26 Farás outras duas argolinhas de ouro, que porás nos dois lados inferiores do racional, nas ourelas, que correspondem ao efod pela parte detrás."},{text:"27 Farás mais outras duas argolinhas do efod, que correspondam às duas argolinhas de ouro em baixo no racional, para que assim possa o racional prender-se ao efod,"},{text:"28 por meio duma fita de côr de jacinto, que passará pelas argolinhas do efod, e pelas argolinhas do racional; para que êles fiquem bem ao próprio atados um no outro, e para que o efod e o racional se não possam separar."},{text:"29 Aarão trará os nomes dos filhos de Israel no racional do juízo, que êle terá sôbre o peito, quando entrar no santuário, para servir dum eterno monumento diante do Senhor."},{text:"30 Gravarás no racional do juízo estas duas palavras: Doutrina e Verdade, as quais estarão sôbre o peito de Aarão, quando êle entrar à presença do Senhor; e êle trará sempre sôbre o seu peito o juízo dos filhos de Israel"},{text:"diante do Senhor."},{text:"31 Farás também a túnica do efod, que será tôda de côr de jacinto."},{text:"32 Em cima no meio dela haverá uma abertura, e ao redor desta abertura um ponteado, como o que se costuma fazer nas extremidades dos vestidos para se não romperem."},{text:"33 Por baixo ao redor da mesma túnica porás tu umas como pequenas romãs feitas de jacinto, de púrpura, e de escarlata tinta duas vêzes; e pelo meio delas entressachadas umas campainhas."},{text:"34 de sorte, que esteja uma campainha de ouro, e uma granada; outra campainha de ouro, e outra granada."},{text:"35 Desta túnica estará vestido Aarão, quando fizer as funções do seu ministério, para que se ouça o som destas campainhas, quando êle entrar no santuário à presença do Senhor, ou quando dêle sair, para que não morra."},{text:"36 Farás também uma lâmina do mais puro ouro, na qual farás gravar por algum bom artífice estas palavras: Santidade ao Senhor."},{text:"37 E atá-la-ás à mitra com uma fita de côr de jacinto sôbre a testa do pontífice."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"38 E Aarão trará sôbre si tôdas as iniquidades, que os filhos de Israel cometerem em todos os donativos, e em todos os presentes, que oferecerem, e consagrarem ao Senhor. Êle trará sempre esta lâmina por diante da testa,"},{text:"para que o Senhor lhes seja propício."},{text:"39 Farás outrossim uma camisa de linho fino, e uma mitra do mesmo linho, e um cíngulo todo bordado."},{text:"40 Farás também camisas de linho para os filhos de Aarão, cíngulos, e mitras para glória e ornamento."},{text:"41 De todos êstes paramentos vestirás tu a Aarão, teu irmão, e a seus filhos com êle. A todos sagrarás as mãos, e a todos santificarás, para que êles exercitem as funções do meu sacerdócio."},{text:"42 Far-lhe-ás também calções de linho para cobrirem as suas partes, desde os rins até as coxas."},{text:"43 Aarão, e seus filhos usarão dêles, quando entrarem no tabernáculo do testemunho, ou quando se chegarem ao altar para servirem no santuário; para que não suceda fazerem-se culpáveis de iniquidade, e morrerem. Esta"},{text:"ordenação será estável, e perpétua para Aarão, e para a sua posteridade depois dêle."},{text:"Êxodo — capítulo 29."},{text:"1 Eis-aqui o que tu deves fazer, para me sagrares em sacerdotes a Aarão, e seus filhos. Toma do rebanho um novilho, e dois carneiros, que não sejam malhados:"},{text:"2 uns pães asmos; uns bolos também asmos borrifados de azeite; umas tortas da mesma sorte asmas, sôbre que se tenha deitado algum azeite: Tôdas as quais coisas tu farás da mais pura farinha."},{text:"3 E depois de as teres pôsto num cêsto, oferecer-mas-ás, e trar-me-ás também o novilho, e os dois carneiros."},{text:"4 Ao mesmo tempo farás chegar Aarão, e seus filhos à entrada do tabernáculo do testemunho. E depois que tiveres lavado com água o pai, e os filhos,"},{text:"5 vestirás Aarão dos seus vestidos, isto é, da camisa, da túnica, do efod, do racional, que tu atarás com o cíngulo."},{text:"6 E pôr-lhe-ás a mitra na cabeça, e sôbre a mitra a lâmina santa."},{text:"7 Depois derramarás sôbre a sua cabeça o óleo da sagração: E com êste rito ficará êle sagrado."},{text:"8 Farás também chegar seus filhos: Vestir-lhes-ás as suas túnicas de linho, e cingi-los-ás com os seus cíngulos."},{text:"9 Isto é o que tu deves fazer a Aarão, e a seus filhos. Pôr-lhes-ás as mitras nas cabeças, e êles ficarão sendo meus sacerdotes, para me darem um culto perpétuo. Depois que lhes tiveres sagrado as mãos,"},{text:"10 trarás o novilho à entrada do tabernáculo do testemunho: e Aarão e seus filhos porão as suas mãos sôbre a cabeça dêle,"},{text:"11 e tu o sacrificarás diante do Senhor, à entrada do tabernáculo do testemunho."},{text:"12 Tomarás do sangue do novilho, e com o teu dedo o porás sôbre os cornos do altar, e o resto do sangue derramá-lo-ás ao pé do mesmo altar."},{text:"13 Tomarás também tôda a gordura, que cobre os intestinos; o redenho do fígado, e os dois rins, e a gordura que os cobre: oferecer-me-ás tudo, queimando-o sôbre o altar."},{text:"14 Mas a carne do novilho, o seu couro, e sua bosta queimá-la-ás fora do âmbito do campo, por ser esta uma hóstia pelo pecado."},{text:"15 Tomarás também um dos carneiros, e Aarão, e seus filhos lhe porão as mãos sôbre a cabeça:"},{text:"16 E depois que o tiveres imolado, tomarás do seu sangue, e derramá-lo-ás em tôrno do altar."},{text:"17 Depois farás o carneiro em pedaços: e lavados os intestinos, e os pés, pô-los-ás sôbre êstes pedaços cortados da sua carne, e sôbre a sua cabeça,"},{text:"18 e oferecerás o carneiro, queimando-o todo sôbre o altar: Porque esta é a oblação do Senhor, e uma hóstia para êle de suavíssimo cheiro."},{text:"19 Tomarás também o outro carneiro, sôbre cuja cabeça porão as suas mãos Aarão, e seus filhos."},{text:"20 E depois de o teres imolado, tomarás do seu sangue, e pô-lo-ás na extremidade da orelha de Aarão, e a seus filhos, e sôbre os dedos polegares das suas mãos, e dos seus pés direitos; e o resto do sangue derramá-lo-ás"},{text:"ao redor do altar."},{text:"21 Tomarás outrossim do sangue, que está sôbre o altar, e do óleo da sagração: e com êles farás aspersão sôbre Aarão, e sôbre os seus vestidos, sôbre seus filhos, e sôbre os vestidos dêstes: e depois de os teres sagrado"},{text:"a êles, e aos seus vestidos,"},{text:"22 tomarás a gordura do carneiro, a sua cauda, a gordura que cobre as entranhas, o redenho do fígado, os dois rins, e a gordura, que está por cima, e a espádua direita: Porque êste é o carneiro da sagração."},{text:"23 Tomarás outrossim parte de um pão, um dos bolos borrifados de azeite, uma torta do cêsto dos asmos, que tenha estado exposta diante do Senhor."},{text:"24 E porás tôdas estas coisas nas mãos a Aarão, e a seus filhos, e santificá-los-ás, elevando estas ofertas diante do Senhor."},{text:"25 Depois tornarás a tomar das suas mãos tôdas estas coisas, e queimá-las-ás sôbre o altar em holocausto, para elas espalharem um suavíssimo cheiro diante do Senhor, porque esta é a sua oblação."},{text:"26 Tomarás também o peito do carneiro que tiver servido para a sagração de Aarão, e santificá-lo-ás, elevando-o diante do Senhor, e esta parte do sacrifício ficará para ti."},{text:"27 Santificarás também o peito, que foi sagrado, e a espádua, que tu separaste do carneiro,"},{text:"28 com a qual Aarão e seus filhos foram sagrados: e estas são as partes, que ficarão reservadas para Aarão, e seus filhos, das oblações dos filhos de Israel por um direito perpétuo: Porque estas são como as primícias, e"},{text:"as primeiras partes das vítimas pacíficas, que êles oferecem ao Senhor."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"29 Os filhos de Aarão depois da morte dêste trarão as vestimentas, que lhe tiverem servido; para que revestidos delas, recebam a unção santa, e as suas mãos fiquem sagradas."},{text:"30 Aquêle dentre seus filhos que fôr constituído pontífice em seu lugar, e entrar no tabernáculo do testemunho, para exercitar as suas funções no santuário, trará estas vestimentas sete dias."},{text:"31 Tomarás outrossim o carneiro, que foi oferecido para a sagração do pontífice, e farás cozer a sua carne no santo lugar;"},{text:"32 da qual carne comerá Aarão, e seus filhos. Comerão também à entrada do tabernáculo do testemunho os pães, que estiveram postos no cêsto,"},{text:"33 para que êste seja um sacrifício, que lhes torne favorável a Deus, e para que as mãos dos que lho oferecem fiquem santificadas. O estrangeiro não comerá dêstes pães, porque são santos."},{text:"34 Se remanescer alguma coisa desta carne consagrada, ou dêstes pães até pela manhã, queimarás no fogo tôdas estas sobras: elas se não comerão, porque estão santificadas."},{text:"35 Terás cuidado de fazeres tudo isto, que te mando, tocante a Aarão, e a seus filhos. Sagrarás as suas mãos sete dias:"},{text:"36 e oferecerás cada dia um novilho pela expiação do pecado. Depois que tu tiveres imolado a hóstia da expiação purificarás o altar, e farás nêle as unções santas."},{text:"37 Purificarás, e santificarás o altar sete dias, e êle será santíssimo. Todo o que o tocar, será santificado."},{text:"38 Eis-aqui o que tu farás sôbre o altar. Sacrificarás cada dia sem falta dois cordeiros dum ano:"},{text:"39 um de manhã, outro de tarde."},{text:"40 Oferecerás com o primeiro cordeiro a décima parte dum efi da mais pura farinha de trigo, misturada com a quarta parte dum hin de azeite de azeitonas pisadas, e com outro tanto de vinho para libações."},{text:"41 Oferecerás de tarde o segundo cordeiro, como um sacrifício de cheiro suavíssimo, da mesma maneira que nós dissemos que se devia fazer a oblação da manhã."},{text:"42 Êste é o sacrifício, que com um culto continuado de geração em geração, se deve oferecer ao Senhor à entrada do tabernáculo do testemunho diante do Senhor, que é onde eu tenho resolvido falar-te."},{text:"43 Dali darei eu as minhas ordens aos filhos de Israel, e o altar será santificado com a minha glória."},{text:"44 Eu santificarei também o tabernáculo do testemunho com o altar, e Aarão com os seus filhos, para que êles exercitem as funções do meu sacerdócio."},{text:"45 Eu habitarei no meio dos filhos de Israel, e serei o seu Deus."},{text:"46 E êles saberão, que eu sou o Senhor seu Deus, que os tirei da terra do Egito, para ficar entre êles, eu, que sou o Senhor seu Deus."},{text:"Êxodo — capítulo 30."},{text:"1 Farás também um altar de pau de cetim para queimar os perfumes."},{text:"2 Êle terá um côvado de comprido, e outro de largo para ser quadrado. Terá dois côvados de alto, e dos seus ângulos sairão umas pontas."},{text:"3 Cobrirás de finíssimo ouro a mesa dêste altar, e os quatro lados com os seus cornos. E farás uma coroa de ouro, que o apanhe todo em roda,"},{text:"4 e duas argolas de ouro de cada banda debaixo da coroa, para se meterem por elas os varais, que hão de servir para o levarem."},{text:"5 Farás também êstes varais de pau de cetim, e cobri-los-ás de ouro."},{text:"6 Porás êste altar defronte do véu, que pende diante da arca do testemunho, e diante do propiciatório, que cobre a arca do testemunho, onde eu te falarei."},{text:"7 E Aarão queimará sôbre êle um incenso de suave cheiro. Êle o queimará de manhã, quando preparar as lâmpadas."},{text:"8 E quando êle as acender de tarde, tornará a queimar do incenso diante do Senhor: o que se observará continuamente entre vós pelo decurso de tôdas as idades."},{text:"9 Não oferecereis sôbre êste altar perfume doutra composição; nem poreis nêle oblação alguma, nem vítima; nem fareis nêle algum sacrifício de libações."},{text:"10 Aarão deprecará uma vez no ano sôbre os cornos dêste altar, pondo nêles do sangue da vítima, que tiver sido oferecida pelo pecado: e esta expiação continuará sempre a fazer-se entre vós de geração em geração. Isto"},{text:"será para o Senhor uma coisa santíssima."},{text:"11 Falou também o Senhor a Moisés, e lhe disse:"},{text:"12 Quando tu fizeres o arrolamento dos filhos de Israel, cada um dará um tanto ao Senhor em preço da sua alma; e êles não serão feridos de praga alguma, depois que êste arrolamento se tiver feito."},{text:"13 Todos os que se compreenderem neste arrolamento, darão meio siclo, segundo a medida do templo. O siclo tem vinte óbolos. Oferecer-se-á pois ao Senhor meio siclo."},{text:"14 O que entrar neste arrolamento, isto é, o que tiver vinte anos, daí para cima, dará êste preço."},{text:"15 O rico não dará mais de meio siclo, e o pobre não dará menos."},{text:"16 E depois que tiveres recebido o dinheiro que os filhos de Israel terão dado, empregá-lo-ás nos usos do tabernáculo do testemunho para que isto seja um monumento diante do Senhor, e sirva para expiação das suas almas."},{text:"17 Falou mais o Senhor a Moisés, e lhe disse:"},{text:"18 Farás outrossim uma bacia de metal, e de lavar, com sua base, e pô-la-ás entre o tabernáculo do testemunho, e o altar."},{text:"19 E lançada água, Aarão, e seus filhos lavarão nela as suas mãos, e os seus pés,"},{text:"20 quando estiverem para entrar no tabernáculo do testemunho, ou quando se deverem chegar ao altar a oferecer perfumes ao Senhor, para que não suceda serem punidos de morte."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 Esta ordenação será eterna para Aarão, e para todos os da sua posteridade, que lhe houverem de suceder."},{text:"22 Falou mais o Senhor a Moisés, e lhe disse:"},{text:"23 Toma de aromas quinhentos siclos de mirra da primeira, e da mais excelente; de cinamomo metade desta quantidade, isto é, duzentos e cinquenta siclos, de cana aromática outros duzentos e cinquenta siclos."},{text:"24 De cássia quinhentos siclos do peso do santuário; e de azeite de oliveiras a medida dum hin."},{text:"25 De tôdas estas espécies farás um óleo santo para as unções, uma composição odorífera, feita segundo a arte dos que nisto trabalham."},{text:"26 Com isto ungirás o tabernáculo do testemunho; a arca do testamento;"},{text:"27 a mesa com os seus vasos; o candieiro, e tudo o que nêle serve; o altar dos perfumes,"},{text:"28 e o dos holocaustos, e tudo o que é necessário para o serviço, e culto, que nêles se faz."},{text:"29 Tu santificarás tôdas estas coisas, e elas ficarão santas, e sagradas. Aquêle, que as tocar, será santificado."},{text:"30 Com o mesmo ungirás a Aarão, e a seus filhos, e os santificarás para exercitarem as funções do meu sacerdócio."},{text:"31 Dirás outrossim aos filhos de Israel: Êste óleo para as unções ser-me-á consagrado entre vós, e entre os que de vós nascerem."},{text:"32 Não se ungirá com êle a carne do homem, nem vós fareis outro da mesma composição; porque êste é santificado, e vós o devereis considerar como santo."},{text:"33 Todo o que fizer algum semelhante, e o der a algum estrangeiro, será exterminado do meio do seu povo."},{text:"34 Disse mais o Senhor a Moisés: Toma dos aromas, isto é, de estacte, de onix, de gálbano bem cheiroso, e de incenso o mais luzido, tudo em igual peso."},{text:"35 Farás uma caçoula, composta de tôdas estas drogas, segundo a arte dos que nisto trabalham. Misturá-las-ás com tal cuidado, que elas saiam puríssimas, e digníssimas de se me oferecerem."},{text:"36 Depois de tudo muito bem pisado, e moído, até se reduzir a um pó finíssimo, pô-lo-ás diante do tabernáculo do testemunho, que é o lugar onde eu te aparecerei. Esta caçoula ficará sendo para vós uma coisa sagrada, e"},{text:"inviolável."},{text:"37 Não fareis outra composição semelhante para vosso uso, porque é consagrada ao Senhor."},{text:"38 O homem, qualquer que êle seja, que tal composição fizer para se regalar com o seu cheiro, perecerá do meio do seu povo."},{text:"Êxodo — capítulo 31."},{text:"1 Falou mais o Senhor a Moisés, e lhe disse:"},{text:"2 Eu chamei nomeadamente a Beseleel filho de Uri, filho de Hur da tribo de Judá,"},{text:"3 e eu o enchi do espírito de Deus, eu o enchi de sabedoria, de inteligência, e de ciência para tôda a casta de obras,"},{text:"4 para inventar tudo o que a arte pode fazer de ouro, de prata, de bronze,"},{text:"5 de mármores, de pedras preciosas, e de tôda a diversidade de paus."},{text:"6 Eu lhe dei por companheiro Ooliab, filho de Aquisamec da tribo de Dan. E eu pus a sabedoria no coração de todos os artífices hábeis, para fazerem tudo o que te tenho ordenado que se faça."},{text:"7 O tabernáculo da aliança, a arca do testemunho, o propiciatório, que está por cima dela, e tudo o que deve servir no tabernáculo:"},{text:"8 a mesa com os seus vasos, o candieiro puríssimo com os seus vasos, o altar dos perfumes,"},{text:"9 e o altar dos holocaustos com todos os seus vasos, e a bacia com a sua base:"},{text:"10 as santas vestimentas destinadas para o ministério do sacerdote Aarão, e de seus filhos, para que êles exercitem as funções do seu ofício revestidos de ornamentos sagrados:"},{text:"11 o óleo da unção, e o perfume aromático, que deve servir no santuário. Numa palavra, êles farão tudo o que eu te mandei que se fizesse."},{text:"12 Falou mais o Senhor a Moisés, e lhe disse:"},{text:"13 Fala aos filhos de Israel, e dize-lhes: Tende grande cuidado de observar o meu sábado, porque êste é o sinal que eu estabeleci entre mim, e vós, e que deve passar depois de vós a vossos filhos; para que vós saibais"},{text:"que eu é que sou o Senhor, que vos santifico."},{text:"14 Guardai o meu sábado, porque êle deve ser santo para vós. Aquêle que o violar, será castigado com a morte. Se algum trabalhar neste dia, perecerá do meio do seu povo."},{text:"15 Vós trabalhareis seis dias; mas o dia sétimo é o sábado e o descanso consagrado ao Senhor. Todo o que trabalhar neste dia morrerá."},{text:"16 Os filhos de Israel guardem o sábado, e celebrem-no de idade em idade. Êste é um pacto sempiterno"},{text:"17 entre mim, e os filhos de Israel, e um sinal, que durará sempre. Porque o Senhor fêz em seis dias o céu, a terra, e no dia sétimo cessou de obrar."},{text:"18 Tendo o Senhor acabado de falar desta sorte no monte Sinai, deu a Moisés as duas tábuas do testemunho feitas de pedra, e escritas pelo dedo de Deus."},{text:"Êxodo — capítulo 32."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Mas o povo, vendo que Moisés não acabava de descer do monte, se ajuntou contra Aarão, e lhe disse: Vem fazer-nos deuses, que vão adiante de nós: porque pelo que toca a Moisés, a êste homem, que nos tirou do Egito, nós"},{text:"não sabemos o que lhe aconteceu."},{text:"2 Aarão lhes disse: Tirai as arrecadas de ouro, que vossas mulheres, filhos, e filhas trazem nas orelhas, e trazei-mas."},{text:"3 Fêz o povo o que Aarão lhe mandara, e trouxe-lhe as arrecadas."},{text:"4 Aarão depois que as recebeu, fundiu-as, e formou delas um bezerro. Então disseram os israelitas: Eis-aqui, ó Israel, os teus deuses, que te tiraram do Egito."},{text:"5 O que tendo visto Aarão, erigiu um altar diante do bezerro, e à voz do pregoeiro clamou: Amanhã é a solenidade do Senhor."},{text:"6 E êles, tendo-se levantado pela manhã, ofereceram holocaustos, e hóstias pacíficas. Todo o povo se assentou a comer e beber, e depois se levantaram a brincar."},{text:"7 Então falou o Senhor a Moisés, e lhe disse: Vai, desce: porque o teu povo, que tu tiraste do Egito, pecou."},{text:"8 Êles se apartaram bem depressa do caminho que tu lhes havias mostrado. Fizeram para si um bezerro fundido, adoraram-no, e imolando-lhe vítimas, disseram: Êstes são, ó Israel, os teus Deuses, que te tiraram do Egito."},{text:"9 Ainda disse mais o Senhor a Moisés: Eu vejo que êste povo é de cerviz dura."},{text:"10 Deixa, que o furor da minha indignação se acenda contra êles, e que eu os consuma, e eu te farei a ti chefe de um grande povo."},{text:"11 Porém Moisés conjurava o Senhor seu Deus, dizendo-lhe: Por que se acende o teu furor contra um povo teu, que tu tiraste do Egito com uma grande fôrça, e com uma poderosa mão?"},{text:"12 Não permitas, te rogo, que digam os egípcios: Êle os tirou do Egito astutamente para os matar nos montes, e para os extinguir da terra. Aplaque-se a tua ira, e deixa-te dobrar para perdoares ao teu povo a sua"},{text:"iniquidade."},{text:"13 Lembra-te de Abraão, de Isaac, e de Israel teus servos, aos quais tu juraste por ti mesmo, dizendo: Eu multiplicarei a vossa descendência, como as estrêlas do céu; e eu darei à vossa posteridade tôda esta terra, de"},{text:"que eu falei, e vós a possuireis para sempre."},{text:"14 Então se apaziguou o Senhor, para não fazer contra o seu povo o mal, que tinha dito."},{text:"15 Voltou Moisés pois de cima do monte, trazendo na sua mão as duas tábuas do testemunho, escritas de ambas as partes."},{text:"16 Elas eram obra de Deus, como o era a escritura, que estava gravada nelas."},{text:"17 Ora Josué ouvindo o tumulto, e a vozeria do povo, disse para Moisés: No campo ouve-se alarido de quem peleja."},{text:"18 Ao que respondeu Moisés: Isto não é gritar de pessoas, que se exortam para combater; nem vozeria de gente, que obriga o seu inimigo a fugir: mas o que eu ouço são vozes de pessoas, que cantam."},{text:"19 E tendo-se aproximado ao campo, viu o bezerro, e as danças. Então irado na última diferença, atirou as tábuas que trazia na mão em terra, e as quebrou na falda do monte."},{text:"20 E pegando no bezerro, que êles tinham feito, lançou-o no fogo, e o reduziu em cinza, que lançou na água, e fêz que dela bebessem os filhos de Israel."},{text:"21 Depois disse Moisés a Aarão: Que te fêz êste povo para tu o carregares com um tão grande pecado?"},{text:"22 Êle lhe respondeu: Não se ire meu Senhor: Porque tu sabes muito bem, quanto êste povo é propenso para o mal."},{text:"23 Êles me disseram: Faz-nos deuses, que vão adiante de nós: Porque nós não sabemos que é o que aconteceu a êste Moisés que nos tirou do Egito."},{text:"24 Eu lhes disse: Qual dentre vós tem ouro? Trouxeram-no, e deram-mo: e eu o lancei no fogo, e saiu êste bezerro."},{text:"25 Moisés pois vendo que o povo tinha ficado nu, (pois Aarão o tinha despojado com esta vergonhosa abominação, e o tinha posto nu no meio de seus inimigos),"},{text:"26 pôs-se à porta do campo, e disse: Se algum é do Senhor, ajunte-se comigo. E tendo-se ajuntado à roda dêle todos os filhos de Levi, lhes disse:"},{text:"27 Eis-aqui o que diz o Senhor Deus de Israel: Cada homem meta a sua espada à cinta: passai, e tornai a passar, atravessando o campo duma porta à outra; e cada um mate seu irmão, seu amigo, e o que lhe fôr mais chegado."},{text:"28 Fizeram os filhos de Levi o que Moisés tinha ordenado, e foram quase vinte e três mil homens, os que caíram mortos aquêle dia."},{text:"29 Então lhes disse Moisés: Cada um de vós consagrou hoje as suas mãos ao Senhor, matando seu filho, e seu irmão, para vos ser dada a bênção."},{text:"30 Ao outro dia disse Moisés ao povo: Vós cometestes um grandíssimo pecado. Eu subirei onde está o Senhor, a ver se de algum modo o posso dobrar, e alcançar dêle perdão do vosso crime."},{text:"31 E tendo voltado para o Senhor, lhe disse: Êste povo cometeu um grandíssimo pecado, e êles fizeram para si deuses de ouro. Mas eu te conjuro, que ou tu lhe perdoes êste delito,"},{text:"32 ou se o não fazes, me apagues do teu livro, que escreveste."},{text:"33 O Senhor lhe respondeu: Eu apagarei do meu livro aquêle, que pecar contra mim."},{text:"34 Tu porém, vai, e conduze o povo ao lugar, que eu te disse. O meu anjo irá adiante de ti: Mas no dia da vingança visitarei eu êste pecado, que êle cometeu."},{text:"35 Feriu pois o Senhor o povo pelo crime do bezerro, que Aarão lhe tinha feito."},{text:"Êxodo — capítulo 33."},{text:"1 Depois falou o Senhor a Moisés, e lhe disse: Vai, sai dêste lugar tu, e o povo, que tu tiraste do Egito, e vai para a terra, que eu prometi com juramento a Abraão, Isaac, e Jacó quando lhe disse: Eu darei esta terra à"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 27",author:"Pe. A. P. de Figueiredo",pages:[{text:"tua posteridade."},{text:"2 E dir-lhe-ás da minha parte: Eu enviarei um anjo, que te sirva de percursor, para que lance fora os cananeus, os amorreus, os heteus, os fereseus, os heveus, os jebuseus;"},{text:"3 e tu entres num país onde correm arroios de leite, e de mel. Porque eu não subirei contigo, para que não suceda exterminar-te eu durante o caminho, visto seres tu um povo de cerviz dura."},{text:"4 O povo, ouvindo estas tremendas palavras pôs-se a chorar; e nenhum dêles vestiu as suas galas costumadas."},{text:"5 Porque o Senhor disse a Moisés: Diz aos filhos de Israel: Vós sois um povo de cerviz dura: se eu fôr uma vez no meio de vós, exterminar-vos-ei. Deixai, pois, desde agora as vossas galas, para eu saber de que modo vos"},{text:"hei de tratar."},{text:"6 Todos os filhos de Israel pois deixaram as suas galas ao pé do monte Horeb."},{text:"7 E Moisés, levantando o tabernáculo, o pôs bem ao longe fora do campo, e o chamou o tabernáculo do concêrto. E todos os do povo, que tinham alguma dificuldade, saíram fora do campo, para irem ao tabernáculo do concêrto."},{text:"8 Quando Moisés saía para o tabernáculo, levantava-se todo o povo, e cada um se deixava estar à porta da sua tenda, e olhava para Moisés pelas costas, até êle entrar no tabernáculo."},{text:"9 Depois que Moisés tinha entrado no tabernáculo do concêrto, descia a coluna de nuvem, e punha-se à porta, e o Senhor falava com Moisés."},{text:"10 Os filhos de Israel, em vendo que a coluna de nuvem se punha à porta do tabernáculo, punham-se também êles todos à porta das suas tendas, e adoravam o Senhor."},{text:"11 Ora o Senhor falava a Moisés face a face, bem como um homem costuma falar ao seu amigo. E quando êle voltava para o campo, o moço Josué, filho de Nun, que o servia, não se alongava do tabernáculo."},{text:"12 Moisés porém disse ao Senhor: Tu mandas-me que leve eu êsse povo, e não me declaras quem hás de enviar comigo, principalmente tendo-me tu dito: Eu conheço-te pelo teu nome, e tu achaste graça de mim."},{text:"13 Se eu pois achei graça diante de ti, mostra-me a tua face, para eu te conhecer, e para achar graça diante dos teus olhos: olha benignamente para esta grande multidão, que é teu povo."},{text:"14 O Senhor lhe disse: Eu irei em pessoa diante de ti, e eu te darei o descanso."},{text:"15 Disse-lhe Moisés: Se tu mesmo não vais adiante de nós, não nos tires dêste lugar."},{text:"16 Porque como poderemos nós saber, eu, e o teu povo, que nós achamos graça diante de ti, se tu não marchares adiante de nós, para sermos atendidos, e respeitados de todos os povos, que habitam sôbre a terra?"},{text:"17 Respondeu o Senhor a Moisés: Eu te farei isto, que tu acabas de me pedir: porque tu achaste graça diante de mim, e eu te conheço pelo teu nome."},{text:"18 Moisés lhe disse: Mostra-me a tua glória."},{text:"19 O Senhor lhe respondeu: Eu te mostrarei todo o bem; e passando adiante de ti, pronunciarei o nome do Senhor. Eu me compadecerei de quem eu quiser, e usarei de clemência com quem fôr do meu agrado usá-la."},{text:"20 Disse mais o Senhor: Tu não poderás ver o meu rosto: porque nenhum homem me verá sem morrer."},{text:"21 Ainda o Senhor disse mais: Eis-aqui o lugar, onde eu costumo estar: e tu pôr-te-ás sôbre a pedra."},{text:"22 E quando passar a minha glória, eu te porei ao buraco da pedra, e te cobrirei com a minha mão, até que eu tenha passado."},{text:"23 Depois tirarei eu a minha mão, e tu me verás pelas costas: mas tu não poderás ver o meu rosto."},{text:"Êxodo — capítulo 34."},{text:"1 Depois disse o Senhor a Moisés: Corta duas tábuas de pedra, que sejam como as primeiras: e eu escreverei nelas as palavras, que estavam nas tábuas, que tu quebraste."},{text:"2 Está pronto pela manhã para subires logo ao monte Sinai, e estarás comigo no pino do monte."},{text:"3 Não suba ninguém contigo, nem apareça nenhum por todo o monte; nem ainda bois, ou ovelhas se apascentem defronte."},{text:"4 Cortou Moisés pois duas tábuas de pedra, tais como as primeiras: e, levantando-se antes de amanhecer, subiu ao monte Sinai, levando consigo as duas tábuas, conforme o Senhor lhe tinha ordenado."},{text:"5 Então tendo descido o Senhor no meio da nuvem, Moisés se pôs na sua presença, invocando o nome do Senhor."},{text:"6 E a tempo que o Senhor passava por diante dêle, disse Moisés: Dominador, e Senhor Deus, que és todo cheio de compaixão, e de clemência, paciente, rico de misericórdia, e de verdade;"},{text:"7 que guardas misericórdia até mil gerações; que apagas a iniquidade, os crimes, e os pecados; diante do qual nenhum é inocente por si mesmo; e que tornas a iniquidade dos pais aos filhos, e aos netos até à terceira, e"},{text:"quarta geração."},{text:"8 Ao mesmo tempo se prostrou Moisés por terra; e adorando, prosseguiu dizendo:"},{text:"9 Senhor, se eu achei graça diante de ti, peço-te que caminhes conosco: (porque êste povo é de cabeça dura) apaga também as nossas iniquidades, e os nossos pecados, e possui-nos."},{text:"10 O Senhor lhe respondeu: Eu farei à vista de todos uma aliança: Farei prodígios, que nunca jamais se viram na terra, nem em alguma nação; para que êste povo, no meio do qual estás, seja testemunha da terrível obra, que"},{text:"o Senhor está para fazer."},{text:"11 Guarda tôdas as coisas, que eu te ordeno hoje: e eu mesmo lançarei fora diante de ti os amorreus, os cananeus, os heteus, os fereseus, os heveus, e os jebuseus."},{text:"12 Vê, não tenhas nunca amizade com os habitantes dêste país o que será a tua ruína."},{text:"13 Mas destrói os seus altares, quebra as suas estátuas, corta os seus bosques sagrados."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 28",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 Não adores deus estrangeiro. O Senhor tem por nome o Zeloso. Deus quer ser amado unicamente."},{text:"15 Não faças pacto algum com os habitantes dêste país: não suceda que quando êles se corromperem com os seus deuses, e adorarem as suas estátuas, te convide algum dêles a comer das viandas imoladas."},{text:"16 Não casarás teus filhos com as suas filhas: não suceda que depois de se corromperem, induzam elas também teus filhos a se corromperem com os seus deuses."},{text:"17 Não farás para ti deuses fundidos."},{text:"18 Observarás a solenidade dos ásmos. Comerás sete dias pães ásmos, no mês dos trigos novos, como eu te ordenei; porque tu saíste do Egito no mês em que começa a primavera."},{text:"19 Todo o macho que fôr primogénito, será meu: os primogénitos de todos os animais, assim de bois como de ovelhas, serão meus."},{text:"20 Remirás o primogénito do jumento por uma ovelha: se não remires, matá-lo-ás. Remirás o primogénito de teus filhos. E não aparecerás na minha presença com as mãos vazias."},{text:"21 Trabalharás seis dias, e ao dia sétimo cessarás de lavrar, e de segar."},{text:"22 Celebrarás a solenidade das semanas, oferecendo as primícias dos frutos da tua messe do trigo: e a outra solenidade no fim do ano, quando se tiver tudo recolhido."},{text:"23 Todos os teus filhos machos se apresentarão três vêzes no ano diante do Todo Poderoso Senhor Deus de Israel."},{text:"24 Porque quando eu tiver expulsado da tua face as nações, e tiver estendido os limites do teu país; se tu subires, e se tu te apresentares diante do Senhor teu Deus, nenhum formará secretamente maus projetos contra o"},{text:"teu país."},{text:"25 Não me imolarás o sangue da minha vítima sôbre fermento: nem da hóstia da solenidade da Páscoa remanescerá nada, até o outro dia pela manhã."},{text:"26 Oferecerás as primícias dos frutos da tua terra na casa do Senhor teu Deus. Não cozerás o cabrito no leite de sua mãe."},{text:"27 Disse mais o Senhor a Moisés: Escreve para ti estas palavras, pelas quais eu fiz concêrto contigo, e com Israel."},{text:"28 Ficou Moisés pois ali com o Senhor quarenta dias, e quarenta noites: não comeu pão, nem bebeu água; e êle escreveu nas tábuas as dez palavras do concêrto."},{text:"29 Depois disto desceu Moisés do monte Sinai, trazendo as duas tábuas do testemunho; e êle não sabia que o seu rosto lançava de si uns raios, que lhe tinham ficado da conversação, que tinha tido com o Senhor."},{text:"30 Mas Aarão, e os filhos de Israel vendo que o rosto de Moisés lançava de si êstes raios, tiveram mêdo de se chegar a êle."},{text:"31 Tendo Moisés pois chamado a Aarão, e aos principais do ajuntamento, vieram êles ter com Moisés. E depois que êle lhes falou,"},{text:"32 vieram também a êle todos os filhos de Israel; e êle lhes expôs tôdas as ordens, que tinha recebido do Senhor no monte Sinai."},{text:"33 Acabado o discurso, pôs Moisés um véu sôbre o seu rosto."},{text:"34 E quando entrava no tabernáculo à presença do Senhor, e falava com êle, tirava o véu até que saía. E então dizia aos filhos de Israel tudo o que o Senhor lhe tinha ordenado que dissesse."},{text:"35 Quando Moisés saía do tabernáculo, viam os israelitas que o seu rosto lançava uns raios: mas êle o cobria de novo tôdas as vêzes, que lhes havia de falar."},{text:"Êxodo — capítulo 35."},{text:"1 Moisés pois tendo ajuntado todos os filhos de Israel, lhes disse: Eis-aqui as coisas, que o Senhor ordenou que se lhe fizessem."},{text:"2 Vós trabalhareis seis dias: e o dia sétimo será para vós santo, como sábado que é, e descanso do Senhor. Aquêle, que trabalhar neste dia, será morto."},{text:"3 Não acendereis lume em tôdas as vossas casas no dia sétimo."},{text:"4 Disse mais Moisés a todo o ajuntamento dos filhos de Israel: Eis-aqui o que o Senhor ordenou. Êle disse:"},{text:"5 Ponde à parte em vossas casas as primícias de todos os vossos bens para o Senhor. Vós lhe oferecereis de boamente, e com uma inteira vontade ouro, prata, bronze;"},{text:"6 jacinto, púrpura, escarlata tinta duas vêzes, linho fino, pêlos de cabra;"},{text:"7 peles de carneiro tintas de vermelho, peles roxas, paus de cetim;"},{text:"8 azeite para conservar as lâmpadas, aromas para a composição das unções, e perfumes de excelente cheiro;"},{text:"9 pedras cornalinas, e outras pedras preciosas para ornar o efod, e o racional."},{text:"10 Todo o que dentre vós é bom artífice, venha fazer o que o Senhor mandou."},{text:"11 A saber: o tabernáculo com o seu teto, e as suas coberturas; as argolas, as tábuas, os barrotes, as estacas, as bases;"},{text:"12 a arca com os seus varais, o propiciatório, e o véu, que deve estar pendente diante dêle."},{text:"13 a mesa com os varais, vasos, e pães da proposição;"},{text:"14 o candieiro, que há de sustentar as lâmpadas, tudo o que é necessário para o seu uso, as lâmpadas e o azeite para alimentar o fogo;"},{text:"15 o altar dos perfumes com os varais, o óleo para as unções, e a caçoula dos cheiros; o véu pendente à entrada do tabernáculo;"},{text:"16 o altar dos holocaustos, a sua grelha de bronze com os seus varais, e com tudo o que é necessário para o seu uso; a bacia com a sua base;"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 29",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 as cortinas do átrio com as suas colunas, e suas bases, e o véu da entrada do vestíbulo;"},{text:"18 as estacas do tabernáculo, e do átrio com os seus cordões;"},{text:"19 as vestimentas, que se devem usar no culto do santuário; os ornamentos destinados para o pontífice Aarão, e seus filhos, a fim de exercitarem as funções do meu sacerdócio."},{text:"20 Depois que todos os filhos de Israel saíram da presença de Moisés,"},{text:"21 tornaram êles a vir oferecer ao Senhor com pronta vontade, e grande devoção, as primícias dos seus bens, para se fazer a obra do tabernáculo do testemunho. Para tudo o que era necessário porém para o culto sagrado, e"},{text:"para os ornamentos sacerdotais,"},{text:"22 deram homens e mulheres os seus braceletes, as suas arrecadas, os seus anéis, e os enfeites, que êles punham no seu braço direito. Todos os vasos de ouro foram postos à parte, para serem apresentados ao Senhor."},{text:"23 Os que tinham jacintos, púrpura, escarlata tinta duas vêzes, linho fino, pêlos de cabra, peles de carneiro tintas de vermelho, peles roxas,"},{text:"24 prata, e bronze, tudo ofereceram ao Senhor com os paus de cetim para qualquer uso."},{text:"25 Houve também mulheres habilidosas, que deram o que tinham fiado de jacinto, de púrpura, de escarlata, de linho fino,"},{text:"26 e de pêlos de cabra; e tudo deram de muito boa vontade."},{text:"27 Os príncipes ofereceram pedras cornalinas, e outras pedras preciosas para o efod, e racional;"},{text:"28 aromas, e azeite para conservar as lâmpadas, e para preparar as unções, e compor o perfume de suavíssimo cheiro."},{text:"29 Todos os homens, e mulheres ofereceram gostosos os seus dons, para se fazerem as obras, que o Senhor tinha ordenado por Moisés. Todos os filhos de Israel fizeram as suas ofertas ao Senhor de muito boa vontade."},{text:"30 Então disse Moisés aos filhos de Israel: O Senhor chamou por seu nome a Beseleel, filho de Uri, que o é de Hur, da Tribo de Judá:"},{text:"31 e o encheu do espírito de Deus, de sabedoria, de inteligência, de ciência, e de todos os conhecimentos;"},{text:"32 para inventar, e para executar tudo o que se pode fazer em ouro, prata, e bronze;"},{text:"33 para cortar, e lavrar pedras, e para tôdas as obras de delicadeza."},{text:"34 Êle lhe pôs no espírito tudo o que a arte pode inventar. E êle deu os mesmos talentos a Ooliab, filho de Aquisamec da tribo de Dan."},{text:"35 A ambos encheu êle de sabedoria para fazerem tôda a casta de obras de pau, de panos de diversas côres, de bordados de jacinto, de púrpuras, de escarlata tinta duas vêzes, e de linho fino; para trabalharem tudo o que"},{text:"se faz ao tear, e para lhe ajuntarem tudo o que puderem inventar de novo."},{text:"Êxodo — capítulo 36."},{text:"1 Trabalhou pois Beseleel com Ooliab em tôdas estas obras, e trabalharam todos os homens hábeis, a quem o Senhor tinha dado sabedoria, e inteligência para saberem fazer excelentemente, o que era necessário para o uso do"},{text:"santuário, e tudo o que o Senhor tinha ordenado."},{text:"2 Porque tendo-os Moisés feito vir com todos os homens hábeis, aos quais o Senhor tinha dado sabedoria, e os que de sua vontade se tinham oferecido para trabalhar nesta obra,"},{text:"3 êle lhes entregou tôdas as ofertas dos filhos de Israel. E quando êles se aplicavam já a adiantar a obra, continuava ainda o povo a oferecer todos os dias pela manhã os seus dons."},{text:"4 Isto obrigou os artífices a virem dizer a Moisés:"},{text:"5 O povo oferece mais do que se há mister."},{text:"6 Mandou pois Moisés que à voz do pregoeiro se fizesse publicamente esta declaração: Nenhum homem, nem mulher ofereça mais nada daqui em diante para as obras do santuário. Assim cessaram todos de oferecer presentes,"},{text:"7 porque o que se tinha já oferecido bastava, e ainda sobejava."},{text:"8 Todos êstes homens pois, cujo coração estava cheio de sabedoria para trabalharem nas obras do tabernáculo, fizeram dez cortinas de linho retorcido, de jacinto, de púrpura, de escarlata tinta duas vêzes, tudo bordado, e"},{text:"de diversas côres."},{text:"9 Cada cortina tinha vinte e oito côvados de comprido, e quatro de largo, e tôdas as cortinas eram duma mesma medida."},{text:"10 Juntou cinco destas cortinas uma à outra, e as outras cinco da mesma sorte entre si."},{text:"11 Uma cortina tinha cordões de jacinto na ourela duma, e outra banda; e a cortina da mesma sorte cordões na ourela;"},{text:"12 para que estando os cordões defronte um do outro, se ajuntassem reciprocamente as cortinas."},{text:"13 Por isso fêz êle fundir também cinquenta argolas de ouro, onde se pudessem prender os cordões das cortinas, para que tudo não parecesse senão um tabernáculo."},{text:"14 Fêz também onze cobertas de pêlos de cabra para cobrir o teto do tabernáculo."},{text:"15 Cada uma destas cobertas tinha trinta côvados de comprido, e quatro de largo, e eram tôdas da mesma medida."},{text:"16 Destas ajuntaram êles cinco a uma banda, e seis à outra."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Êxodo Vol. 30",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 Fêz também cinquenta cordões na ourela duma coberta, e cinquenta cordões na ourela da outra para estarem juntas."},{text:"18 Fêz outrossim cinquenta fivelas de bronze para as ter prêsas, a fim de parecer tudo uma peça."},{text:"19 Fêz além disto uma terceira coberta de peles de carneiro tintas de vermelho, e por cima desta outra quarta coberta de peles roxas."},{text:"20 Fêz também tábuas de pau de cetim para o tabernáculo, que estavam postas ao alto."},{text:"21 Cada uma destas tábuas tinha dez côvados de comprido, e côvado e meio de largo."},{text:"22 Cada tábua tinha sua lingueta, e seu encaixe para entrar uma na outra. Tôdas as tábuas do tabernáculo eram feitas dêste mesmo modo."},{text:"23 E vinte delas estavam da banda meridional olhando para o austro,"},{text:"24 com quarenta bases de prata. Cada tábua assentava sôbre duas bases duma, e outra parte dos ângulos no lugar, onde os encaixes dos lados se terminam nos ângulos."},{text:"25 Fêz outrossim para o lado do tabernáculo, e que olha para o aquilão, vinte tábuas,"},{text:"26 com quarenta bases de prata, a duas para cada tábua."},{text:"27 Mas para o lado do tabernáculo, que fica ao ocidente e que olha para o mar, não fizeram senão seis tábuas,"},{text:"28 e mais duas, que estavam postas nos ângulos por detrás do tabernáculo."},{text:"29 Estas estavam juntas de alto a baixo, fazendo um só corpo. A mesma coisa fizeram êles nos dois ângulos dos dois lados."},{text:"30 Eram por tôdas oito tábuas, as quais tinham dezesseis bases de prata, a duas por tábua."},{text:"31 Fêz também uns grandes barrotes de pau de cetim, cinco para atravessar, e segurar tôdas as tábuas duma banda do tabernáculo,"},{text:"32 e outros cinco para atravessar, e segurar as tábuas da outra; e fora êstes ainda outros cinco para o lado do tabernáculo, que fica ao ocidente, e que olha para o mar."},{text:"33 Fêz mais outro barrote, que passava pelo meio das tábuas dum canto até o outro."},{text:"34 Dourou tôdas estas tábuas, que assentavam em bases de prata fundidas, fêz outrossim umas argolas de ouro, pelas quais entrassem os barrotes de pau, que êles também cobriram de lâminas de ouro."},{text:"35 Fêz um véu de jacinto, de púrpura, de escarlata, de linho fino retorcido, tudo bordado, e tudo matizado."},{text:"36 Fêz quatro colunas de pau de cetim, que cobriram de lâminas de ouro com os seus capitéis; e as suas bases eram de prata."},{text:"37 Fêz mais o véu para a entrada do tabernáculo, que era de jacinto, de púrpura, de escarlata, de linho fino retorcido, tudo obra de bordadura."},{text:"38 Fêz também cinco colunas com seus capitéis, as quais cobriram de ouro e as suas bases fundidas, feitas de metal."},{text:"Êxodo — capítulo 37."},{text:"1 Fêz também Beseleel a arca de pau de cetim, a qual tinha dois côvados e meio de comprido, côvado e meio de largo, e côvado e meio de alto. Êle a cobriu de finíssimo ouro por dentro, e por fora;"},{text:"2 e lhe fêz uma coroa de ouro, que a apanhava tôda em roda."},{text:"3 Fundiu quatro argolas de ouro, que pôs nos quatro cantos da arca, dois duma parte, e dois da outra."},{text:"4 Fêz também uns varais de pau de cetim que cobriu de ouro,"},{text:"5 e que meteu nas argolas, que estavam aos cantos da arca, para ela se poder levar."},{text:"6 Fêz mais o propiciatório, isto é, o oráculo, dum ouro puríssimo, que tinha dois côvados e meio de comprido, e côvado e meio de largo:"},{text:"7 como também os dois querubins de ouro batido, que lhe pôs aos dois lados do propiciatório:"},{text:"8 um querubim na extremidade dum lado, e outro querubim na extremidade do outro. Assim os dois querubins estavam numa e outra extremidade do propiciatório,"},{text:"9 tendo as suas asas estendidas, e cobrindo com elas o propiciatório, virados os rostos um para o outro, como também para o propiciatório."},{text:"10 Fêz outrossim uma mesa de pau de cetim, que tinha dois côvados de comprido, um côvado de largo, e côvado e meio de alto."},{text:"11 Cobriu-a de puríssimo ouro, e lhe pôs à roda um frizo de ouro."},{text:"12 Sôbre o frizo pôs uma coroa de ouro esculturada, de altura de quatro dedos, e sôbre esta outra coroa de ouro."},{text:"13 Fêz fundir também quatro argolas de ouro, que pôs nos quatro cantos da mesa, uma a cada pé,"},{text:"14 por baixo da coroa; e enfiou por elas os varais, que haviam de servir para levar a mesa."},{text:"15 Êstes varais eram também de pau de cetim, e êle os chapeou de lâminas de ouro."},{text:"16 Para os diferentes usos desta mesa fêz de fino ouro pratos, copos, turíbulos, e taças, onde se haviam de oferecer os licores."},{text:"17 Fêz também o candieiro do mais puro ouro batido ao martelo, de cujo tronco saíam umas hastes com seus copos, seus pomos, e suas açucenas."}]}] 1
