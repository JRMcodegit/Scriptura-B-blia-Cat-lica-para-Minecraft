give @p minecraft:written_book[written_book_content={title:"Romanos Vol. 11",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 E que os gentios devem glorificar a Deus pela misericórdia de que usou com êles, como está escrito: Por isso eu te confessarei, Senhor, entre os gentios, e entoarei cânticos de louvor ao teu nome."},{text:"10 E outra vez diz: Alegrai-vos, ó gentios, com o seu povo."},{text:"11 E noutro lugar: Louvai ao Senhor, todos os gentios: E engrandecei-o, todos os povos."},{text:"12 E Isaías também diz: Sairá a raiz de Jessé, e naquele que se levantar a reger os gentios, esperarão os gentios."},{text:"13 O Deus pois de esperança vos encha de todo o gôzo, e de paz na vossa crença: Para que abundeis na esperança, e na virtude do Espírito Santo."},{text:"14 E certo estou, irmãos meus, sim eu mesmo a vosso respeito, que também vós mesmos estais cheios de caridade, cheios de todo o saber, de maneira que vos podeis admoestar uns aos outros."},{text:"15 O que não obstante, eu, irmãos, vos escrevi com mais uma pouca de ousadia, como trazendo-vos isto à memória: Por causa da graça que a mim me foi dada por Deus,"},{text:"16 a fim de que eu seja o ministro de Jesus Cristo entre os gentios: Santificando o evangelho de Deus, para que seja aceita a oblação dos gentios, e santificada pelo Espírito Santo."},{text:"17 Tenho pois glória em Jesus Cristo para com Deus."},{text:"18 Porque não ouso falar coisa alguma daquelas que não faz Cristo por mim, para trazer as gentes à obediência, por palavras e por obras."},{text:"19 Por eficácia de sinais, e de prodígios, em virtude do Espírito Santo: De maneira que desde Jerusalém, e terras comarcãs, até à Ilíria tenho enchido tudo do Evangelho de Cristo."},{text:"20 E assim tenho anunciado êste Evangelho, não onde se havia feito já menção de Cristo, por não edificar sôbre fundamento de outro: Mas como está escrito."},{text:"21 Aquêles a quem não foi pregado dêle, verão: E os que não ouviram, entenderão."},{text:"22 Por cuja causa eu até me havia embargado muitas vêzes para vos ir ver, e tenho sido embaraçado até aqui."},{text:"23 Mas agora não tendo já motivo para demorar-me mais nestas terras, e desejando já muitos anos a esta parte passar a ver-vos:"},{text:"24 Quando me puser a caminho para Espanha, espero que de passagem vos verei, e que por vós seja encaminhado lá, depois de haver gozado primeiro algum tanto da vossa companhia."},{text:"25 Mas agora estou de partida para Jerusalém em serviço dos santos."},{text:"26 Porque a Macedônia e a Acaia tiveram por bem fazer uma coleta para os pobres do número dos santos, que estão em Jerusalém."},{text:"27 Assim pois o tiveram por bem: E disso lhes são devedores. Porque se os gentios têm sido feitos participantes dos seus bens espirituais: Devem também êles assistir-lhes com os temporais."},{text:"28 Quando houver eu pois cumprido isto, e lhes tiver feito entrega dêste fruto: Irei a Espanha passando por onde vós aí estais."},{text:"29 E sei que quando vos fôr ver chegarei com abundância de bênção do Evangelho de Cristo."},{text:"30 Rogo-vos pois, ó irmãos, por nosso Senhor Jesus Cristo, e pelo amor do Espírito Santo, que me ajudeis com as vossas orações por mim a Deus."},{text:"31 Para que eu seja livre dos infiéis, que há na Judéia, e seja grata aos santos de Jerusalém a oferenda do meu serviço."},{text:"32 Para que eu passe a ver-vos com alegria pela vontade de Deus e seja recreado convosco."},{text:"33 Enfim o Deus de paz seja com todos vós. Amém."},{text:"Romanos — capítulo 16."},{text:"1 Recomendo-vos pois a nossa irmã Febe, que está no serviço da Igreja de Cencris."},{text:"2 Para que a recebais no Senhor, como devem fazer os Santos, e a ajudeis em tudo o que de vós houver mister: Porque ela tem assistido também a muitos, e a mim em particular."},{text:"3 tools — see the cookie policy for details"},{text:"4 (Os quais pela minha vida expuseram as suas cabeças, o que não lhes agradeço eu só, mas também tôdas as Igrejas dos Gentios)."},{text:"5 E do mesmo modo a Igreja que está em sua casa. Saudai ao meu querido Epéneto, que é as primícias da Ásia em Cristo."},{text:"6 Saudai a Maria, a qual trabalhou muito entre vós."},{text:"7 Saudai a Andrônico, e a Júnia, meus parentes, e cativos comigo, os quais se assinalaram entre os Apóstolos, e que foram Cristãos primeiro do que eu."},{text:"8 Saudai a Ampliato, a quem mui entranhavelmente amo no Senhor."},{text:"9 Saudai a Urbano, que trabalhou comigo em Jesus Cristo, e ao meu amado Staquis."},{text:"10 Saudai a Apeles, provado em Cristo."},{text:"11 Saudai aqueles que são da casa de Aristóbulo. Saudai a Herodião, meu parente. Saudai aos que são da família de Narciso, que estão no Senhor."},{text:"12 Saudai a Trifena, e a Trifosa, que trabalham no Senhor. Saudai a nossa muito amada Persida, que trabalhou muito no Senhor."},{text:"13 Saudai a Rufo, escolhido no Senhor, e a sua mãe, e minha."},{text:"14 Saudai a Asíncrito, a Flegonte, a Hermas, a Pátrobas, a Hermes, e aos irmãos que estão com êles."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Romanos Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Saudai a Filólogo, e a Júlia, a Nereu, e a sua irmã, e a Olimpíades, e todos os Santos, que com êles estão."},{text:"16 Saudai-vos uns aos outros em ósculo santo. Tôdas as Igrejas de Cristo vos saudam."},{text:"17 Rogo-vos, porém, irmãos, que não percais de vista aqueles que causam dissensões, e escândalos contra a doutrina que vós tendes aprendido, e apartai-vos dêles."},{text:"18 Porque êstes tais não servem a Cristo Senhor nosso, mas ao seu ventre, e com doces palavras, e com bênçãos enganam os corações dos símplices."},{text:"19 Porquanto a vossa obediência tem-se feito por tôda a parte notória. Pelo que eu me alegro em vós. Mas quero que vós sejais sábios no bem e símplices no mal."},{text:"20 E o Deus de paz esmague logo a satanás debaixo de vossos pés. A graça de nosso Senhor Jesus Cristo seja convosco."},{text:"21 Sauda-vos Timóteo, meu coadjutor, e Lúcio, e Jason, e Sosípatro, meus parentes."},{text:"22 Eu, Tércio, que escrevi esta carta vos saudo no Senhor."},{text:"23 Sauda-vos Caio, meu hospedeiro, e tôda a Igreja. Como também Erasto, tesoureiro da cidade, e Quarto, irmão."},{text:"24 A graça de nosso Senhor Jesus Cristo seja com todos vós, Amém."},{text:"25 E ao que é poderoso para vos confirmar, segundo o meu Evangelho, e a pregação de Jesus Cristo segundo a revelação do mistério encoberto desde tempos eternos,"},{text:"26 (O qual agora foi patenteado pelas Escrituras dos profetas segundo o mandamento do eterno Deus, para se dar obediência à fé) entre tôdas as gentes já sabido."},{text:"27 A Deus que só é sábio, a êle por meio de Jesus Cristo seja tributada honra e glória por todos os séculos dos séculos. Amém."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Coríntios Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Coríntios — capítulo 1."},{text:"1 Coríntios 1"},{text:"2 À igreja de Deus, que está em Corinto, aos santificados em Jesus Cristo, chamados santos, com todos os que invocam o nome de nosso Senhor Jesus Cristo, em qualquer lugar que seja, em que nós próprios estejamos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Graças dou incessantemente ao meu Deus por vós, por causa da graça de Deus, que vos foi dada em Jesus Cristo:"},{text:"5 Porque em tôdas as coisas sois enriquecidos nêle em tôda a palavra e em tôda a ciência:"},{text:"6 Assim como tem sido confirmado em vós o testemunho de Cristo:"},{text:"7 De maneira que nada vos falta em graça alguma, esperando vós a manifestação de nosso Senhor Jesus Cristo."},{text:"8 O qual também vos confirmará até ao fim sem crime, no dia da vinda de nosso Senhor Jesus Cristo."},{text:"9 Fiel é Deus: Pelo qual fostes chamados à companhia de seu filho Jesus Cristo nosso Senhor."},{text:"10 Mas, irmãos, rogo-vos, pelo nome de nosso Senhor Jesus Cristo, que todos digais uma mesma coisa, e que não haja entre vós cismas: Antes sejais perfeitos em um mesmo sentimento, e em um mesmo parecer."},{text:"11 Porque de vós, irmãos meus, se me tem significado pelos que são de Cloé, que há contendas entre vós."},{text:"12 E digo isto, porque cada um de vós diz: Eu na verdade sou de Paulo: E eu de Apolo: Pois eu de Cefas: E eu de Cristo."},{text:"13 Está dividido Cristo? Porventura Paulo foi crucificado por vós? Ou haveis sido batizados em nome de Paulo?"},{text:"14 Dou graças a Deus, porque não tenho batizado a nenhum de vós, senão a Crispo, e a Caio."},{text:"15 Para que nenhum diga que fostes batizados em meu nome."},{text:"16 E batizei também a família de Estéfanas: Não sei porém se tenho batizado a algum outro."},{text:"17 Porque não me enviou Cristo a batizar, mas a pregar o Evangelho: Não em sabedoria de palavras, para que não seja feita vã a cruz de Cristo."},{text:"18 Porque a palavra da cruz é na verdade uma estultícia para os que se perdem: Mas para os que se salvam, que somos nós, é ela a virtude de Deus."},{text:"19 Porque escrito está: Destruirei a sabedoria dos sábios, e reprovarei a prudência dos prudentes."},{text:"20 Onde está o sábio? onde o doutor da lei? onde o esquadrinhador dêste século? Porventura não tem Deus convencido de estultícia a sabedoria dêste mundo?"},{text:"21 Porque como na sabedoria de Deus não conheceu o mundo a Deus pela sabedoria: Quis Deus fazer salvos aos que crêssem nêle, pela estultícia da pregação."},{text:"22 Portanto os judeus pedem milagres, como os gregos buscam sabedoria:"},{text:"23 Mas nós pregamos a Cristo crucificado: Que é um escândalo de fato para os judeus, e uma estultícia para os gentios."},{text:"24 Mas para os que têm sido chamados assim judeus, como gregos, pregamos a Cristo, virtude de Deus, e sabedoria de Deus:"},{text:"25 Pois o que parece em Deus uma estultícia, é mais sábio que os homens: E o que parece em Deus uma fraqueza, é mais forte que os homens."},{text:"26 Vêde pois, irmãos, a vossa vocação, porque chamados não foram muitos sábios segundo a carne, não muitos poderosos, não muitos nobres:"},{text:"27 Mas as coisas que há loucas do mundo escolheu Deus para confundir aos sábios: E as coisas fracas do mundo escolheu Deus para confundir as fortes:"},{text:"28 E as coisas vis, e desprezíveis do mundo escolheu Deus, e aquelas que não são, para destruir as que são:"},{text:"29 Para que nenhum homem se glorie na presença dêle."},{text:"30 E do mesmo vem serdes vós o que sois em Jesus Cristo, o qual nos tem sido feito por Deus sabedoria, e justiça, e santificação, e redenção:"},{text:"31 Para que, como está escrito: O que se gloria, glorie-se no Senhor."},{text:"1 Coríntios — capítulo 2."},{text:"1 Coríntios 2"},{text:"2 Porque julguei não saber coisa alguma entre vós, senão a Jesus Cristo, e êste crucificado."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tanto a minha conversação, como a minha pregação não consistiu em palavras persuasivas de humana sabedoria, mas em demonstração de espírito, e de virtude:"},{text:"5 Para que a vossa fé não se funde em sabedoria de homens, mas na virtude de Deus."},{text:"6 Isto não obstante, entre os perfeitos falamos da sabedoria: Não porém da sabedoria dêste século, nem da dos príncipes dêste século, que são destruídos:"},{text:"7 Mas falamos da sabedoria de Deus em mistério que está encoberta, da que Deus predestinou antes dos séculos para nossa glória."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Coríntios Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 A qual nenhum dos príncipes dêste século conheceu: Porque se êles a conheceram, nunca crucificariam ao Senhor da Glória."},{text:"9 Mas assim como está escrito: Que o ôlho não viu, nem o ouvido ouviu, nem jamais veio ao coração do homem, o que Deus tem preparado para aqueles que o amam:"},{text:"10 Porém Deus no-lo revelou a nós pelo seu espírito: Porque o espírito tudo penetra, ainda o que há de mais oculto na profundidade de Deus."},{text:"11 Porque qual dos homens conhece as coisas, que são do homem, senão o espírito do homem, que nêle mesmo reside? assim também as que são de Deus, ninguém as conhece, senão o Espírito de Deus."},{text:"12 Ora nós não recebemos o espírito dêste mundo, mas sim o espírito que vem de Deus, para sabermos as coisas que por Deus nos foram dadas."},{text:"13 O que também anunciamos não com doutas palavras de humana sabedoria, mas com a doutrina do espírito, acomodando o espiritual ao espiritual."},{text:"14 Mas o homem animal não percebe aquelas coisas, que são do espírito de Deus: Porque lhe parecem uma estultícia, e não as pode entender: Porquanto elas se ponderam espiritualmente."},{text:"15 Mas o espiritual julga tôdas as coisas: E êle não é julgado de ninguém."},{text:"16 Porquanto quem conheceu o conselho do Senhor, para que o possa instruir? Porém nós sabemos a mente de Cristo."},{text:"1 Coríntios — capítulo 3."},{text:"1 Coríntios 3"},{text:"2 Leite vos dei a beber, não comida: Porque ainda não podíeis: E nem ainda agora podeis: Porque ainda sois carnais."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque dizendo um: Eu certamente sou de Paulo. E outro: Eu de Apolo: Não se está vendo nisto que sois homens? Que é logo Apolo? e que é Paulo?"},{text:"5 São uns Ministros daquele a quem crestes, e segundo o que o Senhor deu a cada um."},{text:"6 Eu plantei, Apolo regou: Mas Deus é o que