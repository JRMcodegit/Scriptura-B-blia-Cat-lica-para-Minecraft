give @p minecraft:written_book[written_book_content={title:"João Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"61 Muitos pois dos seus discípulos, ouvindo isto, disseram: Duro é êste discurso, e quem o pode ouvir?"},{text:"62 Porém Jesus conhecendo em si mesmo que seus discípulos murmuravam por isso, disse-lhes: Isto escandaliza-vos?"},{text:"63 Pois que será, se vós virdes subir o Filho do homem, onde êle primeiro estava?"},{text:"64 O espírito é o que vivifica: A carne para nada aproveita: As palavras que eu vos disse são espírito e vida."},{text:"65 Mas há alguns de vós outros que não crêem. Porque bem sabia Jesus desde o princípio quem eram os que não criam, e quem o havia de entregar."},{text:"66 E dizia: Por isso eu vos tenho dito, que ninguém pode vir a mim, se por meu Pai lhe não fôr isso concedido."},{text:"67 Desde então se tornaram atrás muitos de seus discípulos: E já não andavam com êle."},{text:"68 Por isso disse Jesus aos doze: Quereis vós outros também retirar-vos?"},{text:"69 E respondeu-lhe Simão Pedro: Senhor, para quem havemos nós de ir? Tu tens palavras da vida eterna."},{text:"70 E nós temos crido e conhecido que tu és o Cristo Filho de Deus."},{text:"71 Disse-lhes Jesus: Não é assim que eu vos escolhi em número de doze, e contudo um de vós é o diabo?"},{text:"72 O que êle dizia por Judas Iscariotes, filho de Simão, porque êle era o que o havia de entregar, sendo que era um dos doze."},{text:"João — capítulo 7."},{text:"1 E depois disto andava Jesus por Galiléia, porque não queria andar por Judéia: Visto que os judeus o queriam matar."},{text:"2 Estava porém a chegar a festa dos judeus, chamada dos Tabernáculos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque ninguém, que deseja ser conhecido em público, obra coisa alguma em secreto: Já que fazes estas coisas, descobre-te ao mundo."},{text:"5 Porque nem ainda seus irmãos criam nêle."},{text:"6 Disse-lhe pois Jesus: Ainda não é chegado o meu tempo, mas o vosso tempo sempre está pronto."},{text:"7 O mundo não vos pode aborrecer: Mas êle me aborrece a mim: Porque eu dou testemunho dêle, que são más as suas obras."},{text:"8 Vós outros subi a esta festa, que eu todavia não vou a esta festa: Porque não é ainda cumprido o meu tempo."},{text:"9 Tendo dito isto, deixou-se ficar êle mesmo em Galiléia."},{text:"10 Mas quando seus irmãos já tinham subido, então subiu êle também à festa não descobertamente, mas como em segrêdo."},{text:"11 Buscavam-no pois os judeus no dia da festa, e diziam: Onde está êle?"},{text:"12 E era grande a murmuração que dêle havia no povo. Porque uns diziam: Êle é bom. Outros porém diziam: Não é, antes engana o povo."},{text:"13 Ninguém contudo ousava falar dêle em público, por mêdo dos judeus."},{text:"14 Ora, estando já os dias da festa no meio, entrou Jesus no Templo, e pôs-se a ensinar."},{text:"15 E admiravam-se os judeus, dizendo: Como sabe êste letras, não as tendo estudado?"},{text:"16 Respondeu-lhes Jesus, e disse: A minha doutrina não é minha, mas é daquele que me enviou."},{text:"17 Se alguém quiser fazer a vontade de Deus: Reconhecerá se a minha doutrina vem dêle, ou se eu falo de mim mesmo."},{text:"18 O que fala de si mesmo, busca a própria glória: Mas aquêle que busca a glória de quem o enviou, êsse é verdadeiro, e não há nêle injustiça."},{text:"19 Não é assim que Moisés vos deu a Lei, e contudo nenhum de vós cumpre com a Lei?"},{text:"20 Por que me procurais vós matar? Respondeu o povo, e disse: Tu estás possesso do demônio; quem é que procura matar-te?"},{text:"21 Respondeu Jesus, e disse-lhes: Eu fiz uma só obra, e todos vós estais por isso maravilhados:"},{text:"22 Vós contudo, porque Moisés vos ordenou a circuncisão (Se bem que ela não vem de Moisés, mas dos patriarcas) no sábado mesmo circuncidais um homem."},{text:"23 Se por não se violar a Lei de Moisés recebe um homem a circuncisão em dia de sábado: Por que vos indignais vós de que eu em dia de sábado curasse a todo um homem?"},{text:"24 Não julgueis segundo a aparência, mas julgai segundo a reta justiça."},{text:"25 Então alguns de Jerusalém diziam: Não é êste o tal a quem procuram matar?"},{text:"26 E contudo ei-lo aí está falando em público, e não lhe dizem coisa alguma. Será que tenham verdadeiramente reconhecido os senadores que êste é o Cristo?"},{text:"27 Mas nós sabemos donde êste é: E do Cristo, quando vier, ninguém saberá donde êle seja."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"28 E Jesus levantava a voz no templo ensinando, e dizendo: Vós outros não só me conheceis, mas sabeis donde eu sou: E eu não vim de mim mesmo, mas é verdadeiro o que me enviou, a quem vós não conheceis:"},{text:"29 Eu sou quem o conheço: Porque dêle sou, e êle me enviou."},{text:"30 Procuravam pois os judeus prendê-lo: Mas ninguém lhe lançou as mãos, porque não era ainda chegada a sua hora."},{text:"31 E muitos do povo creram nêle, e diziam: Quando vier o Cristo, fará êle mais prodígios que os que êste faz?"},{text:"32 Ouviram os fariseus êste murmúrio que dêle fazia o povo: E os príncipes dos sacerdotes, e os fariseus enviaram quadrilheiros para o prenderem."},{text:"33 Mas Jesus lhes disse: Ainda por um pouco de tempo estou convosco: E depois vou para aquêle que me enviou."},{text:"34 Vós me buscareis, e não me achareis: Nem vós podeis vir onde eu estou."},{text:"35 Disseram logo entre si os judeus: Para onde é que irá êste e que o não possamos achar? Será caso que vá para os que se acham dispersos entre as nações, e para instruir os gentios?"},{text:"36 Que quer dizer esta palavra, que êle nos disse: Vós me buscareis, e não me achareis: E onde eu estou, não podeis vós vir?"},{text:"37 E no último dia da festa que era o mais solene, estava ali Jesus, pôsto em pé, e levantava a voz, dizendo: Se alguém tem sêde, venha a mim, e beba."},{text:"38 O que crê em mim, como diz a Escritura, do seu ventre correrão rios d'água viva."},{text:"39 Isto porém dizia êle, falando do Espírito, que haviam de receber os que cressem nêle: Porque ainda o Espírito não fôra dado, por não ter sido ainda glorificado Jesus."},{text:"40 Entretanto alguns daquele povo, tendo ouvido estas suas palavras, diziam: Êste seguramente é profeta."},{text:"41 Outros diziam: Êste é o Cristo. Porém diziam alguns: Pois que de Galiléia é que há de vir o Cristo?"},{text:"42 Não diz a Escritura: Que o Cristo há de vir da geração de Davi, e da vilota de Belém, onde assistia Davi?"},{text:"43 Assim que havia esta dissensão entre o povo acêrca dêle."},{text:"44 E alguns dêles o queriam prender: Mas nenhum lançou as mãos sôbre êle."},{text:"45 Voltaram pois os quadrilheiros para os príncipes dos sacerdotes, e fariseus. E êles lhes perguntaram: Por que o não trouxestes vós prêso?"},{text:"46 Responderam os quadrilheiros: Nunca homem algum falou como êste homem."},{text:"47 Replicaram-lhes então os fariseus: Dar-se-á caso que sejais vós também dos enganados?"},{text:"48 Houve porventura algum dentre os senadores, ou dos fariseus, que crêsse nêle?"},{text:"49 Porque enquanto a esta plebe, que não sabe o que é lei, êles são uns homens amaldiçoados."},{text:"50 Disse-lhes Nicodemos que era um dêles, e o mesmo que viera de noite buscar a Jesus:"},{text:"51 Condena porventura a nossa lei a algum homem antes de o ouvir, e antes de se informar das suas ações?"},{text:"52 Responderam êles, e disseram-lhes: És tu também galileu? Examina as Escrituras, e verás que de Galiléia não se levanta profeta."},{text:"53 E tornaram-se cada um para sua casa."},{text:"João — capítulo 8."},{text:"1 Entretanto foi Jesus para o monte das Oliveiras."},{text:"2 E ao romper da manhã tornou para o templo, e todo o povo veio ter com êle, e assentado os ensinava."},{text:"3 tools — see the cookie policy for details"},{text:"4 E lhe disseram: Mestre, esta mulher foi agora mesmo apanhada em adultério."},{text:"5 E Moisés na lei mandou-nos apedrejar a estas tais. Que dizes tu logo?"},{text:"6 Diziam pois isto os judeus tentando-o, para o poderem acusar. Porém Jesus abaixando-se, pôs-se a escrever com o dedo na terra."},{text:"7 E como êles perseveravam em fazer-lhe as perguntas, ergueu-se Jesus e disse-lhes: O que de vós outros está sem pecado, seja o primeiro que a apedreje."},{text:"8 E tornando a abaixar-se, escrevia na terra."},{text:"9 Mas êles ouvindo-o, foram saindo um a um, sendo os mais velhos os primeiros: E ficou só Jesus, e a mulher, que estava no meio em pé."},{text:"10 Então ergueu-se Jesus, e disse-lhe: Mulher, onde estão os que te acusavam? Ninguém te condenou?"},{text:"11 Respondeu ela: Ninguém, Senhor: Então disse Jesus: Nem eu tão pouco te condenarei: Vai e não peques mais."},{text:"12 E outra vez lhes falou Jesus, dizendo: Eu sou a luz do mundo: O que me segue não anda em trevas, mas terá o lume da vida."},{text:"13 E os fariseus lhe disseram: Tu és o que dás testemunho de ti mesmo: Assim o teu testemunho não é verdadeiro."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 Respondeu Jesus, e disse-lhe: Ainda que eu mesmo sou o que dou testemunho de mim, o meu testemunho é verdadeiro: Porque sei donde vim e para onde vou: Mas vós não sabeis donde eu venho, nem para onde vou."},{text:"15 Vós julgais segundo a carne: Eu a ninguém julgo:"},{text:"16 E se eu julgo a alguém, o meu juízo é verdadeiro, porque eu não sou só: Mas eu e o Pai, que me enviou."},{text:"17 E na vossa mesma lei está escrito que o testemunho de duas pessoas é verdadeiro."},{text:"18 Ora, eu sou o que dou testemunho de mim mesmo: E meu Pai, que me enviou, também dá testemunho de mim."},{text:"19 Perguntaram-lhe êles então: Onde está teu Pai? Respondeu-lhes Jesus: Vós não me conheceis a mim, nem a meu Pai: Se me conhecêsseis a mim, certamente conheceríeis também a meu Pai."},{text:"20 Estas palavras disse Jesus, ensinando no templo no lugar do gazofilácio: E ninguém o prendeu, porque não era ainda chegada a sua hora."},{text:"21 E em outra ocasião lhes disse Jesus: Eu retiro-me, e vós me buscareis e morrereis no vosso pecado. Para onde eu vou não podeis vós vir."},{text:"22 Diziam pois os judeus: Será que êle se mate a si mesmo, pois diz: Para onde eu vou, não podeis vós vir?"},{text:"23 Mas Jesus lhes respondia: Vós sois cá de baixo, e eu sou lá de cima. Vós sois dêste mundo, e eu não sou dêste mundo."},{text:"24 Por isso eu vos disse, que morreríeis nos vossos pecados: Porque se não crerdes em quem eu sou, morrereis no vosso pecado."},{text:"25 Perguntaram-lhe pois êles: Quem és tu? Respondeu-lhes Jesus: Eu sou o princípio, o mesmo que vos falo."},{text:"26 Muitas coisas são as que tenho que vos dizer, e de que vos condenar: Mas o que me enviou é verdadeiro: E eu o que digo no mundo é o que dêle aprendi."},{text:"27 E não conheceram os judeus que êle dizia que Deus era seu Pai."},{text:"28 Disse-lhes pois Jesus: Quando vós tiverdes levantado o Filho do homem, então conhecereis quem eu sou, e que nada faço de mim mesmo, mas que como o Pai me ensinou, assim falo:"},{text:"29 E o que me enviou, está comigo, e não me deixou só: Porque eu sempre faço o que é do seu agrado."},{text:"30 Ao tempo que Jesus dizia estas palavras, creram muitos nêle."},{text:"31 Pelo que dizia Jesus aos judeus que nêle creram: Se vós permanecerdes na minha palavra, sereis verdadeiramente meus discípulos:"},{text:"32 E conhecereis a verdade, e a verdade vos livrará."},{text:"33 Responderam-lhe êles: Nós somos descendentes de Abraão, e em nenhum tempo fomos escravos de alguém; como dizes tu: Que viremos a ser livres?"},{text:"34 Respondeu-lhes Jesus: Em verdade, em verdade vos digo: Que todo o que comete pecado, é escravo do pecado:"},{text:"35 Ora, o escravo não fica para sempre na casa, mas o Filho fica nela para sempre:"},{text:"36 Assim que se o Filho vos livrar, sereis verdadeiramente livres."},{text:"37 Eu bem sei que sois filhos de Abraão, mas vós quereis me dar a morte, porque a minha palavra não cabe em vós."},{text:"38 Eu falo o que vi em meu Pai: E vós fazeis o que vistes em vosso pai."},{text:"39 Responderam êles, e disseram-lhe: Nosso pai é Abraão. Disse-lhes Jesus: Se sois filhos de Abraão, fazei obras de Abraão."},{text:"40 Mas vós atualmente procurais tirar-me a vida, a mim que sou um homem que vos falei a verdade, que ouvi de Deus: Isto é o que Abraão nunca fêz."},{text:"41 Vós fazeis as obras de vosso pai. E êles lhe disseram: Nós não somos nascidos de fornicação; um pai temos que é Deus."},{text:"42 Respondeu-lhes pois Jesus: Se Deus fôsse vosso pai, vós certamente me amaríeis: Porque eu saí de Deus, e vim, porque não vim de mim mesmo, mas êle foi quem me enviou."},{text:"43 Por que não conheceis vós a minha fala? É porque não podeis ouvir a minha palavra."},{text:"44 Vós sois filhos do diabo, e quereis cumprir os desejos de vosso pai; êle era homicida desde o princípio, e não permaneceu na verdade, porque a verdade não está nêle: Quando êle diz a mentira, fala do que lhe é"},{text:"próprio, porque é mentiroso, e pai da mentira."},{text:"45 Mas ainda que eu vos digo a verdade, vós não me credes."},{text:"46 Qual de vós me argüirá de pecado? Se eu vos digo a verdade, por que não me credes?"},{text:"47 O que é de Deus, ouve as palavras de Deus. Por isso vós não as ouvis, porque não sois de Deus."},{text:"48 Responderam então os judeus, e disseram-lhe: Não dizemos nós bem, que tu és um samaritano, e que tens demônio?"},{text:"49 Respondeu-lhes Jesus: Eu não tenho demônio, mas dou honra a meu Pai, e vós a mim desonrastes-me."},{text:"50 E eu não busco a minha glória: Outro é o que a buscará, e que fará justiça."},{text:"51 Em verdade, em verdade vos digo: Que se alguém guardar a minha palavra, não verá a morte eternamente."},{text:"52 Disseram-lhe pois os judeus: Agora é que conhecemos que estás possesso do demônio. Abraão morreu, e os profetas morreram, e tu dizes: Se alguém guardar a minha palavra, não provará a morte eternamente."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 11",author:"Pe. A. P. de Figueiredo",pages:[{text:"53 Acaso és tu maior do que o nosso pai Abraão que morreu? E do que os profetas, que também morreram? Quem te fazes tu ser?"},{text:"54 Respondeu Jesus: Se eu glorifico a mim mesmo, não é nada a minha glória: Meu Pai é que me glorifica, aquêle que vós dizeis que é vosso Deus."},{text:"55 E entretanto vós não o tendes conhecido: Mas eu conheço-o: E se disser que o não conheço, serei como vós mentiroso. Mas eu conheço-o, e guardo a sua palavra."},{text:"56 Vosso pai Abraão desejou ansiosamente ver o meu dia: Viu-o, e ficou cheio de gôzo."},{text:"57 Disseram-lhe por isso os judeus: Tu ainda não tens cinqüenta anos, e viste a Abraão?"},{text:"58 Respondeu-lhes Jesus: Em verdade, em verdade vos digo, que antes que Abraão fôsse feito, sou eu."},{text:"59 Então pegaram os judeus em pedras para lhe atirarem: Mas Jesus encobriu-se, e saiu do Templo."},{text:"João — capítulo 9."},{text:"1 E passando Jesus, viu a um homem que era cego de nascença:"},{text:"2 E seus discípulos lhe perguntaram: Mestre, que pecado fêz êste, ou fizeram seus pais, para nascer cego?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Importa que eu faça as obras daquele que me enviou, enquanto é dia: A noite vem, quando ninguém pode obrar."},{text:"5 Eu entretanto que estou no mundo, sou a luz do mundo."},{text:"6 Dito isto, cuspiu no chão, e fêz lôdo do cuspo, e untou com o lôdo os olhos do cego."},{text:"7 E disse-lhe: Vai, lava-te na piscina de Siloé (que quer dizer o Enviado). Foi êle pois e lavou-se, e veio com vista."},{text:"8 Então os seus vizinhos, e os que o tinham visto antes pedindo esmola diziam: Não é êste aquêle que estava assentado e pedia esmola? Respondiam uns: Êste é."},{text:"9 Outros, pelo contrário: Não é, mas é outro que se parece com êle. Porém êle dizia: Eu é que sou."},{text:"10 Perguntaram-lhe pois: Como te foram abertos os olhos?"},{text:"11 Respondeu êle: Aquêle homem que se chama Jesus fêz lôdo: E untou-me os olhos, e disse-me: Vai ao tanque de Siloé, e lava-te. E fui, lavei-me, e acho-me com vista."},{text:"12 E perguntaram-lhe: Onde está êle? Respondeu: Não sei."},{text:"13 Então levaram o que fôra cego aos fariseus."},{text:"14 E era dia de sábado, quando Jesus fêz o lôdo, e lhe abriu os olhos."},{text:"15 Perguntaram-lhe pois de novo os fariseus, de que modo vira. E êle lhes disse: Pôs-me lôdo sôbre os olhos, e lavei-me, e estou vendo."},{text:"16 Pelo que diziam alguns dos fariseus: Êsse homem, que não guarda o sábado, não é de Deus. Porém outros diziam: Como pode um homem pecador fazer êstes prodígios? e havia dissensão entre êles."},{text:"17 Perguntaram pois ainda ao cego: Tu que dizes daquele que te abriu os olhos? E respondeu êle: Que é um profeta."},{text:"18 Mas os judeus não creram que êle fôsse cego, e visse, enquanto não chamaram os pais do que vira:"},{text:"19 E lhes fizeram esta pergunta, dizendo: É êsse o vosso filho, que vós dizeis que nasceu cego? Pois como vê agora?"},{text:"20 Seus pais lhes responderam, e disseram: O que nós sabemos é que êste é nosso filho, e que êle nasceu cego:"},{text:"21 Mas não sabemos como êle agora vê: Ou quem foi o que lhe abriu os olhos, nós o não sabemos também: Perguntai-lho a êle mesmo: Êle idade tem, que fale êle mesmo de si."},{text:"22 Isto disseram seus pais, por mêdo que tinham dos judeus: Porque já os judeus tinham conspirado em ser expulsado fora da Sinagoga todo o que confessasse que Jesus era o Cristo."},{text:"23 Por isso é que seus pais responderam: Êle idade tem, perguntai-lho."},{text:"24 Tornaram pois a chamar ao homem que fôra cego, e disseram-lhe: Dá glória a Deus: Nós sabemos que êsse homem é um pecador."},{text:"25 Então lhes respondeu êle: Se êle é pecador, não sei: O que só sei, é que sendo eu antes cego, vejo agora."},{text:"26 Perguntaram-lhe pois: Que é o que te fêz êle? como te abriu êle os olhos?"},{text:"27 Respondeu-lhes: Eu já vo-lo disse, e vós já o ouvistes: Por que o quereis vós tornar a ouvir? Quereis vós porventura fazer-vos também seus discípulos?"},{text:"28 Sôbre isto o carregaram êles de injúrias, e lhe disseram: Discípulo dêle sejas tu: Que nós outros somos discípulos de Moisés."},{text:"29 Nós sabemos que Deus falou a Moisés: Mas dêste não sabemos donde é."},{text:"30 Respondeu aquêle homem, e disse-lhes: Por certo que é coisa admirável, que vós não saibais donde êle é, e que êle me abrisse os olhos:"},{text:"31 E nós sabemos que Deus não ouve a pecadores: Mas se alguém lhe dá culto, e faz a sua vontade, a êste escuta Deus."},{text:"32 Desde que há mundo, nunca se ouviu que alguém abrisse os olhos a um cego de nascença."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"33 Se êste não fôsse de Deus, não podia êle obrar coisa alguma."},{text:"34 Responderam êles, e disseram-lhe: Tu desde o ventre de tua mãe todo és pecado, e tu és o que nos queres ensinar? E lançaram-no fora."},{text:"35 Ouviu Jesus dizer que o tinham lançado fora: E havendo-o encontrado disse-lhe: Tu crês no Filho de Deus?"},{text:"36 Respondeu êle, e disse: Quem é êle, Senhor, para eu crer nêle?"},{text:"37 Disse-lhe pois Jesus: Até já tu o viste, e é aquêle mesmo que fala contigo."},{text:"38 Então respondeu êle: Eu creio, Senhor. E prostrando-se, o adorou."},{text:"39 E Jesus lhe disse: Eu vim a êste mundo a exercitar um juízo: A fim de que os que não vêem, vejam, e os que vêem, se façam cegos."},{text:"40 E ouviram alguns dos fariseus, que estavam com êle, e disseram-lhe: Logo também nós somos cegos?"},{text:"41 Respondeu-lhes Jesus: Se vós fôsseis cegos não teríeis culpa: Mas como vós agora mesmo dizeis: Nós vemos, fica subsistindo o vosso pecado."},{text:"João — capítulo 10."},{text:"1 Em verdade, em verdade vos digo: Que o que não entra pela porta no aprisco das ovelhas, mas sobe por outra parte: Êsse é ladrão e roubador."},{text:"2 O que porém entra pela porta, êsse é pastor das ovelhas."},{text:"3 tools — see the cookie policy for details"},{text:"4 E depois que tirou para fora as próprias ovelhas, vai adiante delas: E as ovelhas o seguem, porque conhecem a sua voz."},{text:"5 E não seguem o estranho, antes fogem dêle: Porque não conhecem a voz dos estranhos."},{text:"6 E Jesus lhes disse esta parábola. Mas êles não entenderam que era o que lhes dizia."},{text:"7 Tornou pois Jesus a dizer-lhes: Em verdade, em verdade vos digo, que eu sou a porta das ovelhas."},{text:"8 Todos quantos têm vindo são ladrões e roubadores, e as ovelhas não lhes deram ouvidos."},{text:"9 Eu sou a porta. Se alguém entrar por mim, será salvo: E êle entrará, e sairá, e achará pastagens."},{text:"10 O ladrão não vem senão a furtar, e a matar, e a perder. Mas eu vim para elas terem vida, e para a terem em maior abundância."},{text:"11 Eu sou o bom pastor. O bom pastor dá a própria vida pelas suas ovelhas."},{text:"12 Porém o mercenário, e o que não é pastor, de quem não são próprias as ovelhas, vê vir o lobo, e deixa as ovelhas, e foge: E o lobo arrebata e faz desgarrar as ovelhas:"},{text:"13 E o mercenário foge, porque é mercenário, e porque lhe não tocam as ovelhas."},{text:"14 Eu sou o bom pastor: E eu conheço as minhas ovelhas, e as que são minhas me conhecem a mim."},{text:"15 Assim como meu Pai me conhece, também eu conheço a meu Pai: E ponho a minha vida pelas minhas ovelhas."},{text:"16 Tenho também outras ovelhas, que não são dêste aprisco: E importa que eu as traga, e elas ouvirão a minha voz, e haverá um aprisco e um pastor."},{text:"17 Por isso meu Pai me ama: Porque eu ponho a minha vida, para outra vez a assumir."},{text:"18 Ninguém a tira de mim, mas eu de mim mesmo a ponho, e tenho poder de a pôr, e tenho poder de a reassumir. Êste mandamento recebi de meu Pai."},{text:"19 Originou-se por causa dêstes discursos uma nova dissensão entre os judeus."},{text:"20 Porque muitos dêles diziam: Êle está possesso do demônio, e perdeu o juízo; por que o estais vós ouvindo?"},{text:"21 Diziam outros: Estas palavras não são de quem está possesso do demônio; acaso pode o demônio abrir os olhos aos cegos?"},{text:"22 Ora, em Jerusalém celebrava-se a festa da Dedicação: E era inverno."},{text:"23 E Jesus andava passeando no Templo, no alpendre de Salomão."},{text:"24 Rodearam-no pois os judeus, e disseram-lhe: Até quando nos terás tu perplexos? se tu és o Cristo, dize-no-lo claramente."},{text:"25 Respondeu-lhes Jesus: Eu digo-vo-lo, e vós não me credes: As obras, que eu faço em nome de Meu Pai, elas dão testemunho de mim."},{text:"26 Porém vós não credes, porque não sois das minhas ovelhas."},{text:"27 As minhas ovelhas ouvem a minha voz, e eu conheço-as, e elas me seguem."},{text:"28 E eu lhes dou a vida eterna, e elas nunca jamais hão de perecer, e ninguém as há de arrebatar da minha mão."},{text:"29 O que meu Pai me deu, é maior do que tôdas as coisas, e ninguém as pode arrebatar da mão de meu Pai."},{text:"30 Eu e o Pai somos uma mesma coisa."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 Então pegaram os judeus em pedras para lhe atirarem."},{text:"32 Disse-lhes Jesus: Eu tenho-vos mostrado muitas obras boas, que fiz em virtude de meu Pai: Por qual destas obras me quereis vós apedrejar?"},{text:"33 Responderam-lhe os judeus: Não é por causa de alguma boa obra, que nós te apedrejamos, mas sim porque dizes blasfêmias, e porque sendo tu homem, te fazes Deus a ti mesmo."},{text:"34 Replicou-lhes Jesus: Não é assim que está escrito na vossa Lei: Eu disse, vós sois deuses?"},{text:"35 Se ela chama deuses àqueles a quem a palavra de Deus foi dirigida, e a Escritura não pode falhar,"},{text:"36 a mim, a quem o Pai santificou, e enviou ao mundo, porque dizeis vós: Tu blasfemas, por eu ter dito que sou Filho de Deus?"},{text:"37 Se eu não faço as obras de meu Pai, não me creiais."},{text:"38 Porém se eu as faço: E quando não queirais crer em mim, crede as minhas obras, para que conheçais, e creiais que o Pai está em mim, e eu no Pai."},{text:"39 Então procuravam os judeus prendê-lo: Mas êle se escapou das suas mãos."},{text:"40 E retirou-se outra vez para a banda dalém do Jordão, para o lugar em que João batizava no princípio: E deixou-se lá ficar:"},{text:"41 E vieram a êle muitos, e diziam: Por certo que João não fêz milagre algum."},{text:"42 E tôdas as coisas, que João disse dêste, eram verdadeiras. E muitos creram nêle."},{text:"João — capítulo 11."},{text:"1 Estava pois enfermo um homem, chamado Lázaro, que era da aldeia de Betânia, onde assistiam Maria e Marta, suas irmãs."},{text:"2 (E esta Maria era aquela que ungiu o Senhor com o bálsamo, e lhe limpou os pés com os seus cabelos; cujo irmão Lázaro estava enfermo.)"},{text:"3 tools — see the cookie policy for details"},{text:"4 E ouvindo isto Jesus, disse-lhes: Esta enfermidade não se encaminha a morrer, mas a dar glória a Deus, para o Filho de Deus ser glorificado por ela."},{text:"5 Ora, Jesus amava a Marta, e a sua irmã Maria, e a Lázaro:"},{text:"6 Tanto que ouviu pois que Lázaro estava enfermo, deixou-se então ficar ainda dois dias no mesmo lugar:"},{text:"7 Depois, passado isto, disse a seus discípulos: Tornemos outra vez para Judéia."},{text:"8 Disseram-lhe os discípulos: Mestre, ainda agora te queriam apedrejar os judeus, e tu vais outra vez para lá?"},{text:"9 Respondeu-lhes Jesus: Não são doze as horas do dia? Aquêle que caminhar de dia não tropeça, porque vê a luz dêste mundo:"},{text:"10 Porém o que andar de noite tropeça, porque lhe falta a luz."},{text:"11 Assim falou, e depois disto lhes disse: Nosso amigo Lázaro dorme: Mas eu vou despertá-lo do sono."},{text:"12 Disseram-lhe então seus discípulos: Senhor, se êle dorme estará são."},{text:"13 Mas Jesus tinha falado da sua morte: e êles entenderam que falava do dormir do sono."},{text:"14 Disse-lhes pois Jesus então abertamente: Lázaro é morto."},{text:"15 E eu por amor de vós folgo de me não ter achado lá, para que acrediteis: Mas vamos a êle."},{text:"16 Disse então Tomé, chamado Dídimo, aos outros condiscípulos: Vamos nós também, para morrermos com êle."},{text:"17 Chegou enfim Jesus, e achou que Lázaro estava na sepultura havia já quatro dias."},{text:"18 (Estava pois Betânia em distância de Jerusalém, perto de quinze estádios)."},{text:"19 E muitos dos judeus tinham vindo a Marta e a Maria, para as consolarem na morte de seu irmão."},{text:"20 Marta pois tanto que ouviu que vinha Jesus, saiu a recebê-lo: E Maria ficou em casa."},{text:"21 Disse então Marta a Jesus: Senhor, se tu houveras estado aqui, não morrera meu irmão."},{text:"22 Mas também sei agora que tudo o que pedires a Deus, Deus to concederá."},{text:"23 Respondeu-lhe Jesus: Teu irmão há de ressurgir."},{text:"24 Disse-lhe Marta: Eu sei que êle há de ressurgir na ressurreição, que haverá no último dia."},{text:"25 Disse-lhe Jesus: Eu sou a ressurreição e a vida: O que crê em mim, ainda que esteja morto, viverá."},{text:"26 E todo o que vive e crê em mim, não morrerá eternamente. Crês isto?"},{text:"27 Ela lhe disse: Sim, Senhor, eu já estou na crença de que tu és o Cristo, Filho de Deus vivo, que vieste a êste mundo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"28 E dito isto, retirou-se Marta, e foi chamar em segrêdo a sua irmã Maria, a quem disse: É chegado o Mestre, e êle te chama."},{text:"29 Ela, como ouviu isto, levantou-se logo, e foi buscá-lo."},{text:"30 Porque ainda Jesus não tinha entrado na aldeia: Mas estava ainda naquele mesmo lugar, onde Marta saíra a recebê-lo."},{text:"31 Então os judeus, que estavam com ela em casa, e a consolavam, como viram que Maria se havia levantado tão depressa, e tinha saído, foram nas suas costas dizendo: Ela vai chorar ao sepulcro."},{text:"32 Maria, porém, depois de chegar aonde Jesus estava, tanto que o viu, lançou-se aos seus pés, e disse-lhe: Senhor, se tu houveras estado aqui, não morrera meu irmão."},{text:"33 Jesus, porém, tanto que viu chorar a ela, e chorar os judeus, que tinham vindo com ela, afligira-se em seu espírito, e turbou-se a si mesmo."},{text:"34 E perguntou: Onde o pusestes vós? Responderam-lhe êles: Senhor, vem e vê."},{text:"35 Então chorou Jesus."},{text:"36 O que foi causa de dizerem os judeus: Vejam como êle o amava."},{text:"37 Mas alguns de entre êles disseram: Êste, que abriu os olhos ao que era cego de nascença, não podia fazer que êste outro não morresse?"},{text:"38 Jesus, pois, tornando a bramir em si mesmo, veio ao sepulcro: E era êste uma gruta: E em cima dela se havia pôsto uma campa."},{text:"39 Disse Jesus: Tirai a campa. Respondeu-lhe Marta, irmã do defunto: Senhor, êle já cheira mal, porque é já de quatro dias."},{text:"40 Disse-lhe Jesus: Não te disse eu, que se tu crêres verás a glória de Deus?"},{text:"41 Tiraram pois a campa: E Jesus levantando os olhos ao Céu, disse: Pai, eu te dou graças, porque me tens ouvido:"},{text:"42 Eu pois bem sabia que tu sempre me ouves, mas falei assim por atender a êste povo, que está à roda de mim, para que êles creiam que tu me enviaste."},{text:"43 Tendo dito estas palavras, bradou em alta voz: Lázaro, sai para fora."},{text:"44 E no mesmo instante saiu o que estivera morto, ligados os pés e mãos com as ataduras, e o seu rosto estava envolto num lenço. Disse Jesus aos circunstantes: Desatai-o e deixai-o ir."},{text:"45 Então muitos dentre os judeus, que tinham vindo visitar a Maria e a Marta, e que tinham presenciado o que Jesus fizera, creram nêle."},{text:"46 Porém alguns dêles foram ter com os fariseus, e disseram-lhes o que Jesus tinha feito."},{text:"47 Por cuja causa se ajuntaram os pontífices e os fariseus em conselho, e diziam: Que fazemos nós, que êste homem faz muitos milagres?"},{text:"48 Se o deixamos assim livre, crerão todos nêle: e virão os romanos e tirar-nos-ão o nosso lugar e a nossa gente."},{text:"49 Mas um dêles, por nome Caifás, que era o pontífice daquele ano, disse-lhes: Vós não sabeis nada."},{text:"50 Nem considerais que vos convém que morra um homem pelo povo, e que não pereça tôda a nação."},{text:"51 Ora, êle não disse isto de si mesmo: Mas como era pontífice daquele ano, profetou que Jesus tinha de morrer pela nação."},{text:"52 E não sòmente pela nação, mas também para êle unir num corpo os filhos de Deus que estavam dispersos."},{text:"53 Desde aquêle dia pois cuidavam êles em ver como lhe dariam a morte."},{text:"54 De sorte que já não andava Jesus em público entre os judeus, mas retirou-se para uma terra vizinha do deserto, a uma cidade chamada Efrem, e lá estava com seus discípulos."},{text:"55 E estava próxima a Páscoa dos judeus: E muitos daquela terra subiram a Jerusalém antes da Páscoa, para se purificarem a si mesmos."},{text:"56 E buscavam a Jesus: E diziam uns para os outros estando no Templo: Que julgais vós de não ter vindo a êste dia de festa? Mas os pontífices e fariseus tinham passado ordem, que todo o que soubesse onde Jesus estava, o"},{text:"denunciasse para o prenderem."},{text:"João — capítulo 12."},{text:"1 Seis dias pois antes da Páscoa veio Jesus a Betânia, onde morrera Lázaro, a que Jesus ressuscitou."},{text:"2 E deram-lhe lá uma ceia: Na qual servia Marta, e onde Lázaro era um dos que estavam à mesa com êle."},{text:"3 tools — see the cookie policy for details"},{text:"4 Então Judas Iscariotes, um dos discípulos de Jesus, aquêle que o havia de entregar, disse:"},{text:"5 Por que se não vendeu êste bálsamo por trezentos dinheiros, e se deu aos pobres?"},{text:"6 E disse isto, não porque êle tivesse cuidado dos pobres, mas porque era ladrão, e sendo o que tinha a bolsa, trazia o que se lançava nela."},{text:"7 Mas Jesus respondeu: Deixai-a que ela guarde isto para o dia da minha sepultura."},{text:"8 Porque vós outros sempre tendes convosco os pobres: Mas a mim não me tendes sempre."},{text:"9 Soube pois um crescido número de judeus, que Jesus estava ali: E vieram, não sòmente por causa dêle, senão também para verem a Lázaro, a quem êle havia ressuscitado dentre os mortos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 Porém os príncipes dos sacerdotes assentaram matar também a Lázaro:"},{text:"11 Porque muitos por causa dêle se retiravam dos judeus, e criam em Jesus."},{text:"12 E no dia seguinte uma grande multidão de povo, que tinha vindo à festa, ouvindo dizer que Jesus vinha a Jerusalém:"},{text:"13 Tomaram ramos de palmas, e saíram a recebê-lo, e clamavam: Hosana, bendito seja o Rei de Israel, que vem em nome do Senhor."},{text:"14 E achou Jesus um jumentinho, e montou em cima dêle, segundo o que está escrito:"},{text:"15 Não temas, filha de Sião. Eis aqui o teu rei, que vem montado sôbre o jumentinho, filho da jumenta."},{text:"16 Não fizeram seus discípulos no princípio reflexão nestas coisas: Mas quando Jesus foi glorificado, então se lembraram de que assim estava escrito dêle: E que êles mesmos haviam contribuido para o seu cumprimento."},{text:"17 E o grande número dos, que se achavam com Jesus, quando êste chamou a Lázaro do sepulcro, e o ressuscitou dos mortos, dava testemunho dêle."},{text:"18 E isto foi o que também fêz que o povo o viesse receber: Porque ouviram que êle obrara êste milagre."},{text:"19 De sorte que disseram entre si os fariseus: Vêdes vós que nada aproveitamos? Eis aí vai após êle todo o mundo."},{text:"20 Ora, havia alguns gentios, daqueles que tinham vindo adorar a Deus no dia da festa."},{text:"21 Êstes pois se encaminharam a Filipe, que era de Betsaida de Galiléia, e lhe fizeram esta rogativa, dizendo: Senhor, nós quiséramos ver a Jesus:"},{text:"22 Veio Filipe dizê-lo a André: Então André e Filipe o disseram a Jesus."},{text:"23 E Jesus lhes respondeu, dizendo: É chegada a hora em que o Filho do homem será glorificado."},{text:"24 Em verdade, em verdade vos digo, que se o grão de trigo, que cai na terra, não morrer:"},{text:"25 Fica êle só: Mas se êle morrer, produz muito fruto. O que ama a sua vida, perdê-la-á: E o que aborrece a sua vida neste mundo, conserva-la-á para a vida eterna."},{text:"26 Se alguém me serve, siga-me: E onde eu estiver, estará ali também o que me serve: Se alguém me servir meu Pai o honrará."},{text:"27 Agora presentemente está turbada a minha alma. E que direi eu? Pai, livra-me desta hora. Mas para padecer nesta hora é que eu vim a ela."},{text:"28 Pai, glorifica o teu nome. Então veio esta voz do Céu: Eu não só o tenho já glorificado, mas ainda o glorificarei."},{text:"29 Ora, o povo que ali estava, e ouvira aquela voz, dizia que havia sido um trovão. Outros diziam: Algum Anjo lhe falou."},{text:"30 Respondeu Jesus, e disse: Esta voz não veio por amor de mim, mas veio por amor de vós outros."},{text:"31 Agora é o juízo do mundo: Agora será lançado fora o príncipe dêste mundo."},{text:"32 E eu quando fôr levantado da terra, tôdas as coisas atrairei a mim mesmo:"},{text:"33 (E dizia isto, para designar de que morte havia de morrer.)"},{text:"34 Respondeu-lhe o povo: Nós temos ouvido da lei que o Cristo permanece para sempre: Como dizes tu logo: Importa que o Filho do homem seja levantado? Quem é êste Filho do homem?"},{text:"35 Respondeu-lhes então Jesus: Ainda por um pouco de tempo está a luz convosco. Andai enquanto tendes luz, para que vos não apanhem as trevas, porque quem caminha em trevas, não sabe por onde vai."},{text:"36 Enquanto tendes a luz, crede na luz, para que sejais filhos da luz. Isto disse Jesus, e retirou-se, e escondeu-se dêles."},{text:"37 Mas sendo tantos os milagres que fizera em sua presença, não criam nêle."},{text:"38 Para se cumprir a palavra do profeta Isaías, a qual êle proferiu: Senhor, quem chegou a crer o que ouviu de nós? E a quem foi revelado o braço do Senhor?"},{text:"39 Por isso não podiam crer, porque outra vez disse Isaías:"},{text:"40 Êle obcecou-lhes os olhos, e obdurou-lhes o coração: Para que não vejam com os olhos, e não entendam com o coração: E se convertam, e eu os sare."},{text:"41 Isto disse Isaías, quando viu a sua glória, e falou dêle."},{text:"42 Contudo isto também creram nêle muitos senadores, mas por causa dos fariseus não o confessavam, por não serem expulsos da Sinagoga:"},{text:"43 Porque amaram mais a glória dos homens do que a glória de Deus."},{text:"44 Mas Jesus levantou a voz, e disse: O que crê em mim, não crê em mim, mas naquele que me enviou."},{text:"45 E o que me vê a mim vê aquêle que me enviou."},{text:"46 Eu, que sou a luz, vim ao mundo: Para que todo o que crê em mim, não fique em trevas."},{text:"47 E se alguém ouvir as minhas palavras e não as guardar: Eu não o julgo: Porque não vim a julgar o mundo, mas a salvar o mundo."},{text:"48 O que me despreza, e não recebe as minhas palavras, tem quem no julgue: A palavra, que eu tenho falado, essa o julgará no dia último."},{text:"49 Porque eu não falei de mim mesmo, mas o Pai, que me enviou, é o mesmo que me prescreveu pelo seu mandamento, o que eu devo dizer, e o que devo falar."}]}] 1
give @p minecraft:written_book[written_book_content={title:"João Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"50 E eu sei que o seu mandamento é a vida eterna. Assim que o que eu digo digo-o segundo mo disse o Pai."},{text:"João — capítulo 13."},{text:"1 Antes do dia da festa da Páscoa, sabendo Jesus que era chegada a sua hora, de passar dêste mundo ao Pai: Como tinha amado os seus, que estavam no mundo, amou-os até ao fim."},{text:"2 E acabada a ceia, como já o diabo tinha metido no coração de Judas, filho de Simão Iscariotes, a determinação de o entregar:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Levantou-se da ceia, e dispôs suas vestiduras: E pegando numa toalha, cingiu-se."},{text:"5 Depois lançou água numa bacia, e começou a lavar os pés aos discípulos, e limpar-lhos com a toalha com que estava cingido."},{text:"6 Veio pois a Simão Pedro. E disse-lhe Pedro: Senhor, tu a mim me lavas os pés?"},{text:"7 Respondeu Jesus, e disse-lhe: O que eu faço, tu não o sabes agora, mas sabê-lo-ás depois."},{text:"8 Disse-lhe Pedro: Não me lavarás tu jamais os pés. Respondeu-lhe Jesus: Se eu te não lavar, não terás parte comigo."},{text:"9 Disse-lhe Simão Pedro: Senhor, não sòmente os meus pés, mas também as mãos, e a cabeça."},{text:"10 Disse-lhe Jesus: Aquêle que está lavado, não tem necessidade de lavar senão os pés, e no mais todo êle está limpo. E vós outros estais limpos, mas não todos."},{text:"11 Porque êle sabia qual era o que o havia de entregar, por isso disse: Não estais todos limpos."},{text:"12 E depois que lhes lavou os pés, tomou logo as suas vestiduras, e tendo-se tornado a pôr a mesa, disse-lhes: Sabeis o que vos fiz?"},{text:"13 Vós chamais-me Mestre e Senhor, e dizeis bem: Porque o sou."},{text:"14 Se eu logo sendo vosso Senhor, e Mestre, vos lavei os pés, deveis vós também lavar-vos os pés uns aos outros:"},{text:"15 Porque eu dei-vos o exemplo, para que como eu vos fiz, assim façais vós também."},{text:"16 Em verdade, em 