give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"16 Mas eu não me turbei, seguindo-te como meu pastor: Nem desejei o dia do homem: Tu bem o sabes. O que saiu dos meus lábios, foi reto na tua presença."},{text:"17 Não me sejas tu motivo de mêdo, tu, esperança minha no dia da aflição."},{text:"18 Sejam confundidos os que me perseguem, e não seja eu confundido: Assombrem-se êles, e não me assombre eu: Faze vir sôbre êles o dia da aflição, e com dobrada esmigalhadura os esmigalha:"},{text:"19 Isto me disse a mim o Senhor: Vai, e põe-te à porta dos filhos do povo, pela qual entram e saem os reis de Judá, e vai a tôdas as portas de Jerusalém,"},{text:"20 E dir-lhes-ás: Ouvi a palavra do Senhor, reis de Judá, e tôda Judá, e todos os moradores de Jerusalém, que entrais por estas portas."},{text:"21 Isto diz o Senhor: Guardai as vossas almas, e não queirais trazer cargas no dia do sábado: Nem as introduzais pelas portas de Jerusalém."},{text:"22 E não façais tirar cargas de vossas casas no dia do sábado: Nem façais obra servil alguma: Santificai o dia do sábado, como eu ordenei a vossos pais."},{text:"23 E não o ouviram, nem inclinaram o seu ouvido: Mas endureceram a sua cerviz para me não ouvirem, nem receberem a correção."},{text:"24 E acontecerá isto: Se me escutardes, diz o Senhor, de sorte que não metais cargas pelas portas desta cidade no dia do sábado: E se santificardes o dia do sábado: E sem fazer nêle obra alguma servil:"},{text:"25 Entrarão pelas portas desta cidade reis e príncipes, que se assentarão sôbre o trono de Davi, e subirão sôbre coches e cavalos, êles e os seus príncipes, os varões de Judá, e os moradores de Jerusalém: E será para"},{text:"sempre povoada esta cidade."},{text:"26 E virão das cidades de Judá, e dos contornos de Jerusalém, e da terra de Benjamim, e das planícies, e dos montes, e do Meio-dia, trazendo holocaustos, e vítimas, e sacrifícios, e incenso, e meterão oferendas na Casa"},{text:"do Senhor."},{text:"27 Mas se vós me não escutardes de sorte que santifiqueis o dia do sábado, e não tragais cargas, nem as metais pelas portas de Jerusalém no dia do sábado, acenderei fogo nas portas dela, e devorará as casas de Jerusalém"},{text:"e não se apagará."},{text:"Jeremias — capítulo 18."},{text:"1 Palavra, que foi dirigida pelo Senhor a Jeremias, a qual dizia:"},{text:"2 Levanta-te, e vai à casa do oleiro, e lá ouvirás as minhas palavras."},{text:"3 tools — see the cookie policy for details"},{text:"4 E quebrou-se a vasilha que êle estava fazendo do barro com as suas mãos: E tornando de novo, fêz dêle outra vasilha, como bem lhe tinha parecido em seus olhos fazê-la."},{text:"5 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"6 Acaso não poderei eu fazer de vós, casa de Israel, como êste oleiro? diz o Senhor. Vêde que como o barro está na mão do oleiro, assim vós estais na minha mão, casa de Israel."},{text:"7 De repente falarei contra uma gente e contra um reino, para desarraigá-lo, e destruí-lo, e arruiná-lo."},{text:"8 Se aquela gente se arrepender do seu mal, de que eu a tenho repreendido: Também eu me arrependerei do mal, que tenho pensado fazer contra ela."},{text:"9 E sùbitamente falarei da gente e do reino, para estabelecê-lo e plantá-lo."},{text:"10 Se fizer o mal ante os meus olhos, de maneira que não escute a minha voz: Arrepender-me-ei do bem, que disse lhe faria."},{text:"11 Pois agora fala ao varão de Judá, e aos moradores de Jerusalém, dizendo: Isto diz o Senhor: Eis-aqui estou eu forjando mal contra vós, e concebendo contra vós certo pensamento: Volte cada um do seu mau caminho, e"},{text:"dirigi vós os vossos caminhos, e os vossos afetos."},{text:"12 Os quais disseram: Já disso temos perdido a esperança: E assim iremos após de nossos pensamentos, e seguiremos cada um de nós a pravidade do seu mau coração."},{text:"13 Portanto isto diz o Senhor: Perguntai às nações: Quem ouviu o excesso de coisas tão horríveis, como fêz a virgem de Israel?"},{text:"14 Acaso faltará da pedra do campo a neve do Líbano? Ou podem ser esgotadas as águas que saem frias, e que correm?"},{text:"15 Porque o meu povo se tem esquecido de mim, oferecendo vãs libações, e tropeçando nos seus caminhos, e nas veredas do século, para andarem por elas em caminho não trilhado:"},{text:"16 Para que a terra dêles se tornasse em desolação, e numa vaia perpétua: Todo o que passar por ela ficará espantado, e meneará a sua cabeça."},{text:"17 Porque eu os espalharei diante do seu inimigo, como um vento abrasador. Mostrar-lhes-ei as costas, e não a face no dia do seu estrago."},{text:"18 E disseram: Vinde, e formemos pensamentos contra Jeremias: Porque não perecerá a lei por falta do sacerdote, nem o conselho de sábio, nem a palavra de profeta: Vinde, e firamo-lo com a língua, e não atendamos a nenhum"},{text:"dos seus discursos."},{text:"19 Põe, Senhor, os teus olhos em mim, e ouve a voz dos meus adversários."},{text:"20 Acaso assim se torna mal por bem, pois que já tem aberto cova à minha alma? Lembra-te que eu me apresentei na tua presença para falar bem por êles, e para apartar dêles a tua indignação."},{text:"21 Por isso entrega tu seus filhos à fome, e fá-los passar pelo fio da espada: As suas mulheres fiquem sem filhos, e viúvas: E os maridos delas sejam emprêgo de feridas de morte: Os mancebos dêles sejam atravessados com"},{text:"a espada na peleja."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 Seja ouvido o clamor vindo das casas dêles: Porque trarás de repente sôbre êles o ladrão: Porquanto abriram uma cova para me prenderem, e esconderam laços aos meus pés."},{text:"23 Mas tu, Senhor, sabes todo o desígnio dêles contra mim para matar-me: Não lhes perdoes a sua maldade, e o seu pecado não se apague de diante da tua face: Caiam de repente na tua presença, trata-os com severidade no"},{text:"tempo do teu furor."},{text:"Jeremias — capítulo 19."},{text:"1 Isto diz o Senhor: Vai, e toma uma botija de barro de oleiro, à vista dos anciãos do povo, e dos anciãos dos sacerdotes:"},{text:"2 E sai ao vale do filho de Enon, que está junto à entrada da porta das olarias: E publicarás ali as palavras que eu te vou a dizer."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque me abandonaram a mim, e profanaram êste lugar: E nêle ofereceram libações a deuses estranhos, que não conheceram êles, nem seus pais, nem os reis de Judá: E encheram êste lugar de sangue de inocentes."},{text:"5 E edificaram altos a Baal, para queimarem seus filhos no fogo em holocausto a Baal: O que eu não mandei, jamais nem falei, nem subiu ao meu coração."},{text:"6 Por isso eis-aí vêm os dias, diz o Senhor: E não será chamado êste lugar daqui em diante Tofet, nem o Vale do filho de Enon: Mas o Vale da matança."},{text:"7 E dissiparei o conselho de Judá e de Jerusalém neste lugar: E os exterminarei com espada à vista de seus inimigos, e pela mão dos que procuram as almas dêles: E darei os seus cadáveres para pasto às aves do céu, e às"},{text:"alimárias da terra."},{text:"8 E porei esta cidade em espanto e em ludíbrio: Todo o que passar por ela, ficará pasmado, e dará uma vaia sôbre todos os seus castigos."},{text:"9 E dar-lhes-ei a comer as carnes de seus filhos, e as carnes de suas filhas: E cada um comerá a carne do seu amigo no cêrco, e no apêrto, em que os terão encerrados os seus inimigos e os que buscam as almas dêles."},{text:"10 E quebrarás a botija de barro aos olhos dos varões que fôrem contigo:"},{text:"11 E lhes dirás: Isto diz o Senhor dos exércitos: Assim quebrarei eu a êste povo, e a esta cidade como se quebra uma vasilha de barro, que não pode mais refazer-se: E em Tofet serão enterrados, porque não haverá outro"},{text:"lugar para enterrar."},{text:"12 Assim farei a êste lugar, e aos seus habitadores, diz o Senhor: E porei esta cidade assim como Tofet."},{text:"13 E as casas de Jerusalém, e as casas do rei de Judá serão imundas, como o lugar de Tofet: Tôdas as casas, em cujos terraços sacrificaram tôda a milícia do céu, e ofereceram libações aos deuses estranhos."},{text:"14 Voltou pois Jeremias de Tofet, aonde o tinha enviado o Senhor a profetizar e se pôs em pé no átrio da casa do Senhor, e disse a todo o povo:"},{text:"15 Isto diz o Senhor dos exércitos, o Deus de Israel: Eis-aqui estou eu que farei vir sôbre esta cidade, e sôbre tôdas as cidades dela todos os males, que eu tenho falado contra ela: Porquanto endureceram a sua cerviz,"},{text:"para não ouvirem os meus discursos."},{text:"Jeremias — capítulo 20."},{text:"1 E Fassur, filho de Emer, sacerdote, que havia sido nomeado Prefeito da casa do Senhor, ouviu a Jeremias profetizando estas palavras."},{text:"2 E feriu Fassur ao profeta Jeremias, e o meteu no cepo, que estava na porta de Benjamim, a de cima, na Casa do Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque isto diz o Senhor: Eis-aí te encherei eu de espanto, a ti, e a todos os teus amigos: E cairão à espada de seus inimigos, e os teus olhos o verão: E a todo o Judá porei na mão do rei de Babilônia: E os passará a"},{text:"Babilônia, e matá-los-á à espada."},{text:"5 E entregarei todo o cabedal desta cidade, e todo o seu trabalho, e todo o precioso, e todos os tesouros dos reis de Judá, tudo porei nas mãos de seus inimigos: E os saquearão, e os tomarão, e levá-los-ão a Babilônia."},{text:"6 E tu, Fassur, e todos os moradores da tua casa ireis para o cativeiro: E irás a Babilônia, e ali morrerás, e ali serás enterrado tu, e todos os teus amigos, a quem profetizaste a mentira."},{text:"7 Tu me seduziste, Senhor, e eu fui seduzido: Fôste mais forte do que eu, e pudeste mais: Fiquei sendo um objeto de escárnio todo o dia, todos me insultam."},{text:"8 Porque há já muito tempo que falo, gritando contra a iniqüidade, e anunciam com repetidos clamores a ruína: E tornou-se-me a palavra do Senhor em opróbrio, e em ludíbrio todo o dia."},{text:"9 E disse eu: Não me lembrarei dêle, nem falarei mais em seu nome: E se ateou no meu coração um como fogo abrasador, e reconcentrou-se nos meus ossos: E desfaleci, não o podendo suportar."},{text:"10 Porque ouvi as afrontas de muitos, e ameaças ao redor: Persegui-o, e persigamo-lo: Esta voz saía dentre todos os varões que viviam em paz comigo, e que guardavam o meu lado: A ver se de algum modo se pode surpreender,"},{text:"e prevaleçamos contra êle, e cheguemo-nos a vingar dêle."},{text:"11 Mas o Senhor está comigo como um forte guerreiro: Por isso os que me perseguem, cairão e ficarão desfalecidos: Êles em grande maneira serão confundidos porque não compreenderam o opróbrio eterno que nunca se apagará."},{text:"12 E tu, Senhor dos exércitos, que provas o justo, que penetras os afetos e o coração: Rogo-te que veja eu a tua vingança contra êles: Pois eu te descobri a minha causa."},{text:"13 Cantai cânticos ao Senhor, louvai ao Senhor: Porque livrou a alma do pobre da mão dos malvados."},{text:"14 Maldito seja o dia em que nasci: O dia em que minha mãe me deu à luz não seja bendito."},{text:"15 Maldito seja o homem que levou a nova a meu pai, dizendo: Nasceu-te um filho macho: E que julgou que com isto lhe dava motivo de se alegrar."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"16 Seja êste homem como são as cidades, que o Senhor destruiu, e não se arrependeu: Ouça gritos de manhã, e uivos no tempo do meio-dia:"},{text:"17 Porque êle me não matou antes de sair do ventre materno: A fim de que minha mãe fôsse o meu sepulcro, e nunca houvesse saído do seu ventre."},{text:"18 Por que saí eu do seio materno, para ver trabalho e dor, e consumirem-se os meus dias na confusão?"},{text:"Jeremias — capítulo 21."},{text:"1 Palavra, que foi dirigida pelo Senhor a Jeremias, quando o rei Sedecias lhe enviou a Fassur, filho de Melquias e a Sofonias, filho de Maasias sacerdote, a qual dizia:"},{text:"2 Consulta ao Senhor por nós, porque Nabucodonosor, rei de Babilônia, faz guerra contra nós: Se porventura obrará o Senhor conosco segundo tôdas as suas maravilhas, e se aquêle inimigo se retirará de nós."},{text:"3 tools — see the cookie policy for details"},{text:"4 Isto diz o Senhor Deus de Israel: Eis-aqui estou eu que voltarei os instrumentos de guerra, que tendes nas vossas mãos, e com os quais combateis contra o rei de Babilônia, e contra os caldeus, que vos têm cercados ao"},{text:"redor dos muros: E ajuntá-los-ei no meio desta cidade."},{text:"5 E eu vos debelarei com mão alçada, e com braço forte, e com furor, e com indignação, e com grande ira."},{text:"6 E ferirei aos moradores desta cidade, os homens, e os animais morrerão de uma grande peste."},{text:"7 E depois disto disse o Senhor: Darei Sedecias, rei de Judá, e seus servos, e seu povo, e quantos nesta cidade têm escapado da peste, e da espada, e da fome, na mão de Nabucodonosor, rei de Babilônia, e na mão de seus"},{text:"inimigos, na mão dos que procuram a alma dêles, e passá-los-á ao fio da espada, e não se dobrará, nem perdoará, nem se compadecerá."},{text:"8 E dirás a êste povo: Isto diz o Senhor: Eis-aqui estou eu que ponho diante de vós o caminho da vida, e o caminho da morte."},{text:"9 O que ficar nesta cidade morrerá à espada, e de fome, e de peste: E o que sair dela, e fôr para os caldeus, que vos cercam, viverá, e a sua alma será para êle como um despôjo."},{text:"10 Porque eu encarei para esta cidade para mal, e não para bem, diz o Senhor: Ela será entregue nas mãos do rei de Babilônia, e êste a consumirá pelo fogo."},{text:"11 Dirás também à casa do rei de Judá: Ouvi a palavra do Senhor."},{text:"12 Casa de Davi: Eis-aqui o que diz o Senhor: Fazei justiça desde a manhã, e livrai das mãos do caluniador aquêle que está oprimido pela violência: Para que não suceda sair a minha indignação como um fogo, e acender-se,"},{text:"e não haja quem o apague por causa da malignidade dos vossos desígnios."},{text:"13 Eis-me aqui contra ti, moradora do Vale forte e de campinas, diz o Senhor: Contra os que dizeis: Quem nos ferirá? e quem entrará em nossas casas?"},{text:"14 E irei com a minha visita sôbre vós segundo o fruto dos vossos desígnios, diz o Senhor: E acenderei fogo no bosque dela: E tudo devorará em roda dela."},{text:"Jeremias — capítulo 22."},{text:"1 Isto diz o Senhor: Vai à casa do rei de Judá, e lhe falarás aí por êstes têrmos,"},{text:"2 e dirás: Ouve a palavra do Senhor, ó rei de Judá, que te assentas sôbre o trono de Davi tu, e os teus servos, e o teu povo, que entrais por estas portas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque se verdadeiramente obrardes conforme a isto que vos digo: Entrarão pelas portas desta casa reis da linhagem de Davi, que se assentarão sôbre o seu trono, e montarão em carros e em cavalos, êles e os seus servos,"},{text:"e o povo dêles."},{text:"5 Mas se não ouvirdes estas palavras, por mim mesmo tenho jurado, diz o Senhor, que em ermo será tornada esta casa."},{text:"6 Porque isto diz o Senhor sôbre a casa do rei de Judá: Galaad, tu és para mim a cabeça do Líbano: Juro que te reduzirei a ermo, as tuas cidades inabitáveis."},{text:"7 E consagrarei sôbre ti ao varão matador, e as suas armas: E cortarão os teus cedros escolhidos, e os arrojarão ao fogo,"},{text:"8 E passarão muitas gentes por esta cidade: E dirá cada um ao seu vizinho: Por que se houve Deus assim com esta grande cidade?"},{text:"9 E responderão: É porque abandonaram a aliança do Senhor seu Deus, e adoraram a deuses estranhos, e os serviram."},{text:"10 Não choreis ao morto, nem tomeis dó por êle: Chorai aquêle que sai, porque não voltará mais, nem verá a terra onde nasceu."},{text:"11 Porque isto diz o Senhor a Selum, filho de Josias, rei de Judá, que reinou por seu pai Josias, que saiu dêste lugar: Não tornará cá mais:"},{text:"12 Porém no lugar, para onde o transferi, ali morrerá, e não verá esta terra jamais."},{text:"13 Ai daquele que edifica a sua casa na injustiça: E as suas grandes salas não em eqüidade: Ao seu amigo oprimirá sem causa, e não lhe pagará o seu salário."},{text:"14 Que diz: Edificarei para mim uma casa espaçosa, e magníficos salões: O que se abre janelas, e faz tetos de cedro, e os pinta de sinopla."},{text:"15 Porventura reinarás tu, pois que te comparas ao cedro? Acaso teu pai não comeu e bebeu, e praticou a eqüidade e justiça então quando tudo lhe sucedia bem?"},{text:"16 Julgou a causa do pobre e do indigente para bem seu: E não foi isto por que êle me conheceu? diz o Senhor."},{text:"17 Mas os teus olhos e coração se dirigem à avareza, e a derramar sangue inocente, e à calúnia, e à carreira da obra má."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"18 Porquanto isto diz o Senhor a Joaquim, filho de Josias, rei de Judá: Não o lamentarão: Ai irmão! e ai irmã! Não farão retinir a seu respeito estas vozes: Ai, Senhor! e ai esclarecido!"},{text:"19 A sua sepultura será como a do asno, apodrecerá e será lançado fora das portas de Jerusalém."},{text:"20 Sobe ao Líbano, e clama: E em Basan levanta a tua voz, e grita aos que passam, porque todos os teus amadores estão despedaçados."},{text:"21 Na tua abundância te tenho falado: E disseste: Não ouvirei: Êste é o teu caminho desde a tua mocidade, porque não ouviste a minha voz."},{text:"22 A todos os teus pastôres alimentará o vento, e os teus amadores irão para o cativeiro: E então serás confundida, e te envergonharás de tôda a tua malícia."},{text:"23 Tu que tens o teu assento no Líbano, e fazes o teu ninho nos seus cedros, como gemeste quando te vieram as dores, como dores da que está de parto?"},{text:"24 Vivo eu, diz o Senhor: Que ainda que Jeconias, filho de Joaquim, rei de Judá, fôsse um anel na minha mão direita, eu o arrancaria dela."},{text:"25 E te entregarei na mão dos que procuram a tua alma, e na mão daqueles, cuja vista te causa espanto, e na mão de Nabucodonosor, rei de Babilônia, e na mão dos caldeus."},{text:"26 E enviar-te-ei a ti, e a tua mãe que te gerou, a uma terra estranha, em que não haveis nascido, e ali morrereis:"},{text:"27 E à terra, à qual êles levantam o seu coração para tornarem lá: Não tornarão."},{text:"28 Acaso Jeconias, êste homem tão distinto, é algum vaso de terra já quebrado? Acaso é êle um vaso que a ninguém agrada? Por que têm sido lançados, êle e sua linhagem, e arrojados para uma terra que não conheceram?"},{text:"29 Terra, terra, terra, ouve as palavras do Senhor."},{text:"30 Isto diz o Senhor: Escreve, que êste homem será estéril, homem a quem nos seus dias nada lhe sucederá bem: Pois não sairá da sua linhagem varão que se assente sôbre o trono de Davi, e que daqui em diante tenha poder"},{text:"soberano em Judá."},{text:"Jeremias — capítulo 23."},{text:"1 Ai dos pastôres, que perdem e que despedaçam a grei da minha pastagem, diz o Senhor."},{text:"2 Portanto isto diz o Senhor Deus de Israel aos pastôres que apascentam o meu povo: Vós desarranjastes a minha grei, e os afugentastes, e não os visitastes: Eis-aqui estou eu que irei com a minha visita sôbre vós, para"},{text:"castigar a malícia de vossos desígnios, diz o Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 E levantarei sôbre êles pastôres, que os apascentarão: Dali em diante não terão mêdo, nem se atemorizarão: E do seu número não faltará nenhum, diz o Senhor."},{text:"5 Eis-aí vêm os dias, diz o Senhor: E eu suscitarei a Davi, um germe justo: E reinará um rei, que será sábio: E obrará segundo a eqüidade e justiça na terra."},{text:"6 Naqueles dias será salvo Judá, e Israel habitará sem temor: E êste é o nome que lhe chamarão, o Senhor nosso justo."},{text:"7 Por esta causa eis-aí vêm os dias, diz o Senhor, e não dirão jamais: Vive o Senhor que tirou os filhos de Israel da terra do Egito:"},{text:"8 Mas sim: Vive o Senhor, que tirou e trouxe a linhagem da casa de Israel da terra do Aquilão, e de tôdas as terras, onde eu para ali os tinha lançado: E habitarão na sua terra."},{text:"9 Aos profetas: O meu coração está feito em pedaços dentro de mim mesmo, todos os meus ossos se abalaram: Eu estou feito como um homem ébrio, e como um homem cheio de vinho, contemplando a face do Senhor, e à vista das"},{text:"suas santas palavras."},{text:"10 Porque a terra está cheia de adúlteros, porque a terra chorou à vista da maldição, secaram-se os campos do deserto: A carreira dêles se tem feito má, e a fortaleza dêles dissemelhante."},{text:"11 Porque o Profeta e o sacerdote se corromperam: E na minha casa achei eu os males que êles lá cometeram, diz o Senhor."},{text:"12 Por isso o seu caminho será como um caminho escorregadio nas trevas: Porque serão impelidos, e cairão nêle: Porque farei vir sôbre êles males no ano da sua visitação, diz o Senhor."},{text:"13 E nos profetas de Samaria vi extravagância: Profetizavam em nome de Baal, e seduziam o meu povo de Israel."},{text:"14 E nos profetas de Jerusalém vi semelhança de adúlteros, e caminho de mentira: E fortificaram as mãos dos malvadíssimos, para que se não convertesse cada um da sua malícia: Tem-se tornado todos para mim como Sodoma, e"},{text:"os moradores dela como Gomorra."},{text:"15 Portanto isto diz o Senhor dos exércitos aos profetas: Eis-aqui estou eu que os alimentarei com losna, e lhes darei a beber fel: Porque dos profetas de Jerusalém se derramou a contaminação sôbre tôda a terra."},{text:"16 Isto diz o Senhor dos exércitos: Não queirais ouvir as palavras dos profetas, que vos profetizam, e vos enganam: Falam as visões do seu coração, não da bôca do Senhor."},{text:"17 Dizem àqueles que me blasfemam: O Senhor o disse: Vós tereis paz: E a todos aquêles que andam na pravidade do seu coração, disseram: Não virá sôbre vós mal."},{text:"18 Mas qual dêles assistiu ao conselho do Senhor, e viu e ouviu a sua palavra? Quem considerou a sua palavra e a ouviu?"},{text:"19 Eis-aí sairá fora o redemoinho da indignação do Senhor, e a tempestade que descarrega: Tudo virá sôbre a cabeça dos ímpios."},{text:"20 Não retrocederá o furor do Senhor até que efetue, e até que cumpra o desígnio do seu coração: Nos últimos dias entendereis o seu conselho."},{text:"21 Eu não enviava êstes profetas, e êles corriam: Não lhes falava nada, e êles profetizavam."},{text:"22 Se tivessem assistido ao meu conselho, e tivessem feito saber as minhas palavras ao meu povo: Eu os tivera certamente desviado do seu mau caminho, e dos seus tão depravados pensamentos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 Acaso cuidas que sou eu Deus de perto? diz o Senhor. E não Deus de longe?"},{text:"24 Poderá acaso ocultar-se algum em lugares retirados: E não no verei eu? diz o Senhor. Porventura não encho eu o céu e a terra? diz o Senhor."},{text:"25 Tenho ouvido o que disseram os profetas, que em meu nome profetizam a mentira, e dizem: Sonhei, tenho sonhado."},{text:"26 Até quando se achará isto no coração dos profetas que vaticinam a mentira, e que profetizam as seduções do seu coração?"},{text:"27 Os quais querem fazer que o meu povo se esqueça do meu nome pelos sonhos dêles, que cada um conta ao seu vizinho: Assim como os pais dêles se esqueceram do meu nome por causa de Baal."},{text:"28 O profeta, que tem um sonho, conte o seu sonho: E o que tem a minha palavra, anuncie a minha palavra verdadeiramente: Que comparação há entre a palha e o trigo? diz o Senhor."},{text:"29 Acaso não são as minhas palavras como um fogo, diz o Senhor: E como um martelo que quebra a pedra?"},{text:"30 Por esta causa eis-aqui venho eu aos profetas, diz o Senhor: Que furtam as minhas palavras cada um ao seu vizinho."},{text:"31 Eis-me aqui contra os profetas, diz o Senhor: Que forjam sua linguagem, e pronunciam, diz o Senhor."},{text:"32 Eis-me aqui contra os profetas que sonham a mentira, diz o Senhor: Que as referiram, e enganaram ao meu povo com a sua mentira, e com os seus milagres: Não os havendo eu enviado, nem dado ordem alguma a êsses que nada"},{text:"aproveitaram a êste povo, diz o Senhor."},{text:"33 Pois se te perguntar êste povo, ou o profeta, ou o sacerdote, dizendo: Qual é o pêso do Senhor? lhes dirás: Vós sois o pêso: Porque eu vos hei de arrojar, diz o Senhor."},{text:"34 E o profeta, e o sacerdote, e o povo, que diz: Pêso do Senhor: Eu farei visita sôbre aquêle varão e sôbre a sua casa."},{text:"35 Isto direis cada um a seu vizinho, e a seu irmão: Que respondeu o Senhor? E que falou o Senhor?"},{text:"36 E não se mencionará mais o pêso do Senhor: Porquanto a cada um será pêso a sua palavra: Porque transtornastes as palavras do Deus vivente, do Senhor dos exércitos nosso Deus."},{text:"37 Isso dirás ao profeta: Que te respondeu o Senhor? E que falou o Senhor?"},{text:"38 E se disserdes: Pêso do Senhor: Por isso assim diz o Senhor: Porque dissestes esta palavra: Pêso do Senhor: E vos enviei a dizer: Não digais: Pêso do Senhor."},{text:"39 Portanto eis-aí vos tomarei eu para levar-vos, e vos abandonarei longe da minha presença a vós, e à cidade que vos dei, e a vossos pais."},{text:"40 Entregar-vos-ei a um opróbrio sempiterno e a uma eterna ignomínia, que nunca se apagará da memória."},{text:"Jeremias — capítulo 24."},{text:"1 Mostrou-me o Senhor a seguinte visão: E eis-que estavam ali dois cabazes cheios de figos postos diante do Templo do Senhor, depois que transportou Nabucodonosor, rei de Babilônia, a Jeconias, filho de Joaquim, rei de"},{text:"Judá, e os seus príncipes, e os artífices, e os lapidários de Jerusalém, e os levou a Babilônia."},{text:"2 Um dos cabazes tinha uns figos excelentes em extremo, quais são de ordinário os figos da primeira sazão: E o outro cabaz tinha uns figos muito maus, que se não podiam comer, de maus que eram."},{text:"3 tools — see the cookie policy for details"},{text:"4 E me foi dirigida a palavra do Senhor, a qual dizia:"},{text:"5 Isto diz o Senhor Deus de Israel: Assim como êstes figos são bons: Assim conhecerei eu para bem os desterrados de Judá, que eu mandei para fora dêste lugar para a terra dos caldeus."},{text:"6 E porei sôbre êles favoràvelmente os meus olhos, e restitui-los-ei a êste país: Eu os edificarei, e não os destruirei, e plantá-los-ei, e não os arrancarei."},{text:"7 E dar-lhes-ei coração para que me conheçam, sabendo que eu sou o Senhor: E serão para mim o meu povo, e eu serei para êles o seu Deus: Porque se converterão a mim de todo o seu coração."},{text:"8 E assim como se rejeitam os figos muito maus, que se não podem comer, porque são maus: Isto diz o Senhor; assim desprezarei eu a Sedecias, rei de Judá, e a seus príncipes, e aos restantes de Jerusalém, que ficaram"},{text:"nesta cidade, e aos que moram na terra do Egito."},{text:"9 E entregá-los-ei à vexação, e à aflição em todos os reinos da terra: Em opróbrio, e para exemplo, e provérbio, e maldição em todos os lugares, para onde eu os arrojei."},{text:"10 E enviarei sôbre êles a espada, e a fome, e a peste: Até que sejam consumidos da terra, que lhes dei a êles, e a seus pais."},{text:"Jeremias — capítulo 25."},{text:"1 Palavra, que foi dirigida a Jeremias sôbre todo o povo de Judá, no quarto ano de Joaquim, filho de Josias, rei de Judá, que é o primeiro ano de Nabucodonosor, rei de Babilônia."},{text:"2 A qual o profeta Jeremias anunciou a todo o povo de Judá, e a todos os habitantes de Jerusalém, dizendo:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E o Senhor madrugou para enviar-vos todos os profetas seus servos, e com efeito os enviou: E vós não o escutastes, nem inclinastes os vossos ouvidos para ouvirdes"},{text:"5 quando dizia: Retirai-vos, cada um do seu mau caminho, e dos vossos péssimos desígnios: E habitareis na terra que vos deu o Senhor a vós, e a vossos pais, desde o século em século."},{text:"6 E não queirais ir após uns deuses estrangeiros, para os servirdes, e os adorardes: Nem me provoqueis a ira com as obras de vossas mãos, e eu vos não afligirei."},{text:"7 E não me ouvistes, diz o Senhor, de modo que me haveis provocado a ira com as obras de vossas mãos para vosso mal."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 Pelo que isto diz o Senhor dos exércitos: Porque não ouvistes as minhas palavras:"},{text:"9 Eis-aqui estou eu que enviarei, e tomarei tôdas as famílias do Aquilão, diz o Senhor, e ao meu servo Nabucodonosor, rei de Babilônia: E os trarei sôbre esta terra e sôbre os seus moradores, e sôbre tôdas as nações, que"},{text:"estão em roda dela: E os matarei, e pô-los-ei em espanto e em ludíbrio, e em solidões perduráveis."},{text:"10 E farei cessar entre êles a voz de gôsto e a voz de alegria, a voz do espôso, e a voz da espôsa, a voz da mó, e a luz da candeia."},{text:"11 E tôda esta terra virá a ser um medonho deserto, e um espanto: E tôdas estas gentes servirão ao rei de Babilônia setenta anos."},{text:"12 E completos que fôrem os setenta anos, irei com a minha visita sôbre o rei de Babilônia, e sôbre aquela gente, diz o Senhor, para castigar a sua iniqüidade, e sôbre a terra dos caldeus: E reduzi-la-ei a umas eternas"},{text:"solidões."},{text:"13 E trarei sôbre aquela terra tôdas as minhas palavras, que tenho falado contra ela, tudo o que está escrito neste livro, quanto profetizou Jeremias contra tôdas as gentes:"},{text:"14 Porque estas os serviram a êles, não obstante serem muitas as gentes, e reis grandes: E eu lhes tornarei segundo as suas obras, e segundo os feitos das suas mãos."},{text:"15 Porque o Senhor dos exércitos, o Deus de Israel, diz assim: Toma da minha mão o cálice do vinho dêste furor: E darás a beber dêle a tôdas as gentes, as quais eu te enviarei."},{text:"16 E êles beberão, e ficarão turbados, e sairão fora de si à vista da espada, que eu enviarei entre êles."},{text:"17 E tomei o cálice da mão do Senhor, e dei a beber a tôdas as gentes, as quais o Senhor me enviou:"},{text:"18 A Jerusalém, e às cidades de Judá, e aos seus reis, e aos seus príncipes: Para os reduzir à solidão, e ao espanto, e ao ludíbrio, e à maldição, como já é êste o dia:"},{text:"19 A Faraó, rei do Egito, e aos seus servos: E aos seus príncipes e a todo o seu povo:"},{text:"20 E geralmente a todos: A todos os reis da terra de Ausitide, e a todos os reis da terra dos filisteus, e a Ascalona, e a Gaza, e a Acaron, e ao que resta de Azot,"},{text:"21 e à Iduméia, e a Moab, e aos filhos de Amon:"},{text:"22 E a todos os reis de Tiro, e a todos os reis de Sidônia: E aos reis da terra das ilhas, que estão da banda de além do mar:"},{text:"23 E a Dedan, e a Tema, e a Buz, e a todos os que se fazem cortar os cabelos em redondo."},{text:"24 E a todos os reis da Arábia, e a todos os reis do Ocidente, que habitam no deserto."},{text:"25 E a todos os reis de Zambri, e a todos os reis de Elam, e a todos os reis dos medos:"},{text:"26 Também a todos os reis do Aquilão, aos de perto e aos de longe, a cada um contra seu irmão: E a todos os reinos da terra, que estão sôbre a sua face: E o rei de Sesac beberá depois dêles:"},{text:"27 E lhes dirás: Isto diz o Senhor dos exércitos, o Deus de Israel: Bebei, e embriagai-vos, e arrevezai: E caí, e não vos levanteis à vista da espada, que eu enviarei entre vós."},{text:"28 E se não quiserem receber o cálice da tua mão, para que bebam, lhes dirás: Isto diz o Senhor dos exércitos: Certamente o bebereis:"},{text:"29 Porque eis-aí está que se na cidade, onde o meu nome tem sido invocado, ali começarei eu a trazer aflição, à vista disto ficareis vós sem castigo, como se fôsseis inocentes? Não escapareis: Porque eu envio já a espada"},{text:"sôbre todos os habitadores da terra, diz o Senhor dos exércitos."},{text:"30 E tu lhes profetizarás a êles tôdas estas palavras, e lhes dirás: O Senhor rugirá desde o alto e desde a sua santa morada fará ouvir a sua voz: Rugirá fortemente contra o lugar mesmo da sua glória: O celeuma será"},{text:"cantado como de pisadores de uvas contra todos os habitadores da terra."},{text:"31 Chegou o estrondo até às extremidades da terra: Porque o Senhor entra em juízo com as gentes: Êle mesmo é o que julga a tôda a carne; à espada entreguei os ímpios, diz o Senhor."},{text:"32 Isto diz o Senhor dos exércitos: Eis-aí passará a aflição de gente em gente: E um grande redemoinho sairá das extremidades da terra."},{text:"33 E os que o Senhor entregar à morte naquele dia ficarão estendidos desde um pólo da terra até outro pólo: Não serão chorados, nem recolhidos, nem enterrados: Como uma esterqueira jazerão sôbre a face da terra."},{text:"34 Uivai, pastôres, e gritai: E cobri-vos de cinza, vós que sois os maiorais do rebanho: Porque estão cumpridos os vossos dias, em que haveis de ser mortos: E vós ficareis dispersos, e caireis como vasos preciosos."},{text:"35 E os pastôres não terão escapula, nem salvamento os maiorais da grei."},{text:"36 Ouvir-se-ão a voz dos pastôres, e os uivos dos maiorais do rebanho: Porque o Senhor destruiu os pastos dêles."},{text:"37 E os campos da paz ficarão em silêncio, à vista da ira do furor do Senhor."},{text:"38 Deixou como leão o seu retiro, porque em ermo foi tornada a terra dêles, à vista da ira da pomba, e à vista da ira do furor do Senhor."},{text:"Jeremias — capítulo 26."},{text:"1 No princípio do reinado de Joaquim, filho de Josias, rei de Judá, me foi dirigida pelo Senhor esta palavra, a qual dizia:"},{text:"2 Isto diz o Senhor: Põe-te no átrio da casa do Senhor, e falarás a tôdas as cidades de Judá, de onde vem a gente a adorar na casa do Senhor, tôdas as palavras, que eu te tenho mandado que lhes fales a êles: Não omitas"},{text:"uma só palavra,"},{text:"3 tools — see the cookie policy for details"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"4 E lhes dirás: Isto diz o Senhor: Se me não ouvirdes para andardes na minha lei, que eu vos tenho dado,"},{text:"5 para ouvirdes as palavras dos profetas meus servos, que eu vos tenho enviado, cuidando com tempo nisso, e dirigindo a sua missão, e vós não os ouvistes:"},{text:"6 Eu farei que esta casa seja como Silo, e farei que esta cidade seja objeto de maldição a tôdas as nações da terra."},{text:"7 E os sacerdotes, e os profetas, e todo o povo ouviram a Jeremias proferindo estas palavras na casa do Senhor."},{text:"8 E tendo Jeremias acabado de dizer tudo o que o Senhor lhe havia ordenado que dissesse a todo o povo, os sacerdotes, e os profetas, e todo o povo pegaram nêle, dizendo: É necessário que morra."},{text:"9 Porque profetizou êle em nome do Senhor, dizendo: Esta casa será tratada como Silo: E esta cidade será destruída, sem que fique ninguém que a habite? E todo o povo se ajuntou contra Jeremias na casa do Senhor."},{text:"10 E ouviram os príncipes de Judá estas palavras: E subiram da casa do rei à casa do Senhor, e se assentaram à entrada da porta nova da casa do Senhor."},{text:"11 Então falaram os sacerdotes e os profetas aos príncipes, e a todo o povo, dizendo: Êste homem é réu de morte: Porque profetizou contra esta cidade, como vós o ouvistes com os vossos ouvidos."},{text:"12 E falou Jeremias a todos os príncipes, e a todo o povo, dizendo: O Senhor me enviou, para que profetizasse contra esta casa, e contra esta cidade tôdas as palavras, que me tendes ouvido."},{text:"13 Agora pois fazei bons os vossos caminhos, e os vossos afetos, e ouvi a voz do Senhor vosso Deus: E o Senhor se arrependerá do mal que resolveu fazer contra vós."},{text:"14 E quanto a mim, eis-aqui estou nas vossas mãos: Fazei de mim o que tiverdes por bom e reto nos vossos olhos."},{text:"15 Porém sabei, e tende entendido, que se me matardes, fareis traição a um sangue inocente contra vós mesmos, e contra esta cidade, e seus moradores: Porque na verdade o Senhor me enviou a vós para que falasse aos vossos"},{text:"ouvidos tôdas estas palavras."},{text:"16 Então disseram os príncipes, e todo o povo aos sacerdotes e aos profetas: Êste homem não merece a morte: Porque nos falou em nome do Senhor nosso Deus."},{text:"17 Ao mesmo tempo se levantaram alguns dos mais anciãos da terra: E disseram a todo o ajuntamento do povo as palavras seguintes:"},{text:"18 Miquéias de Morasti foi profeta nos dias de Ezequias, rei de Judá, e falou a todo o povo de Judá desta maneira: Isto diz o Senhor dos exércitos: Sião será lavrado como um campo: E Jerusalém será reduzida a um montão"},{text:"de pedras: E o monte da casa será um bosque mui alto."},{text:"19 Porventura condenou-o à morte Ezequias, rei de Judá, e todo o Judá? Porventura não temeram êle ao Senhor, e fizeram as suas deprecações na presença do Senhor: E o Senhor não se arrependeu do mal, que havia anunciado"},{text:"contra êles? Assim nós fazemos um grande mal contra as nossas almas."},{text:"20 Houve também um homem chamado Urias, filho de Semei de Cariatiarim, que profetizava em nome do Senhor: E que tinha predito contra esta cidade, e contra esta terra, tôdas as mesmas palavras que Jeremias."},{text:"21 E ouviu o rei Joaquim, e todos os magnates, e príncipes dêle estas palavras: E o rei o procurou matar. E ouviu Urias, e temeu, e fugiu, e se meteu no Egito."},{text:"22 E enviou o rei Joaquim certos homens ao Egito a Elnatan, filho de Acobor, e outros com êle ao Egito."},{text:"23 E tiraram a Urias do Egito: E o trouxeram ante o rei Joaquim, e o fêz morrer à espada: E lançou o seu cadáver nas sepulturas do vulgo ignóbil."},{text:"24 A mão pois de Aicam, filho de Safan, foi com Jeremias, para que não fôsse entregue nas mãos do povo, e o matassem."},{text:"Jeremias — capítulo 27."},{text:"1 No princípio do reinado de Joaquim, filho de Josias, rei de Judá, foi dirigida pelo Senhor esta palavra a Jeremias, a qual dizia:"},{text:"2 Isto me diz a mim o Senhor: Faze-te umas prisões, e umas cadeias: E pô-las-ás ao teu pescoço:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E ordenar-lhes-ás que falem assim a seus amos: Isto diz o Senhor dos exércitos, o Deus de Israel: Direis isto a vossos amos:"},{text:"5 Eu fiz a terra, e os homens, e os animais, que estão sôbre a face da terra, com o meu grande poder, e com o meu braço estendido: E a dei àquele que me agradou aos meus olhos."},{text:"6 E eu agora entreguei finalmente tôdas estas terras, nas mãos de Nabucodonosor, rei de Babilônia, meu servo: Além disto dei-lhe também as alimárias do campo, para que o sirvam."},{text:"7 E o servirão tôdas as gentes a êle e a seu filho, e ao filho de seu filho, até que venha o tempo da sua terra, e dêle mesmo: E servi-lo-ão muitas gentes, e grandes reis."},{text:"8 Mas quanto à gente e ao reino, que não servir a Nabucodonosor, rei de Babilônia, e qualquer que não encurvar o seu pescoço debaixo do jugo do rei de Babilônia, eu virei com a minha visita sôbre aquela gente, com"},{text:"espada, e com fome, e com peste, diz o Senhor: Até que eu os consuma pela sua mão."},{text:"9 Vós pois não deis ouvidos aos vossos profetas, nem aos adivinhos, nem aos sonhadores, e agoureiros, e mágicos, que vos dizem: Não servireis ao rei de Babilônia."},{text:"10 Porque êles vos profetizaram a mentira: Para vos mandarem para longe da vossa terra, e vos lançarem dela, e para que assim venhais a perecer."},{text:"11 Mas aquela gente que submeter a sua cerviz ao jugo do rei de Babilônia, e o servir: Eu a deixarei na sua terra, diz o Senhor: E a cultivará, e habitará nela."},{text:"12 E a Sedecias, rei de Judá, tenho falado conforme a tôdas estas palavras, dizendo: Submetei os vossos pescoços ao jugo do rei de Babilônia, e servi-o a êle, e ao seu povo, e vivereis."},{text:"13 Por que causa morrereis tu, e o teu povo à espada e de fome, e de peste, como tem dito o Senhor à gente, que não quiser servir ao rei de Babilônia?"},{text:"14 Não queirais dar ouvidos às palavras dos profetas que vos dizem: Não servireis ao rei de Babilônia: Porque êles vos falam a mentira."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Porque eu não os enviei, diz o Senhor: E êles profetizam falsamente em meu nome: Para que vos lancem fora, e para que venhais a perecer tanto vós, como os profetas, que vos predizem o futuro."},{text:"16 Também falei aos sacerdotes, e a êste povo, dizendo-lhes: Isto diz o Senhor: Não queirais dar ouvidos às palavras dos vossos profetas, que vos profetizam, dizendo: Eis-aí os vasos do Senhor agora cedo voltarão de"},{text:"Babilônia, porque vos profetizam a mentira."},{text:"17 Não queirais pois dar-lhe ouvidos, mas servi ao rei de Babilônia, para que vivais: Por que há de ficar esta cidade reduzida a uma solidão?"},{text:"18 E se são profetas e está nêles a palavra do Senhor: Intercedam para com o Senhor dos exércitos, para que os vasos, que ficaram na casa do Senhor, e na casa do rei de Judá, e em Jerusalém, não sejam transferidos a"},{text:"Babilônia."},{text:"19 Porque isto diz o Senhor dos exércitos às colunas, e ao mar, e às bases, e aos outros vasos, que ficaram nesta cidade:"},{text:"20 Que Nabucodonosor, rei de Babilônia, não levou de Jerusalém para Babilônia, quando transportou a Jeconias, filho de Joaquim, rei de Judá, e a todos os magnates de Judá e de Jerusalém."},{text:"21 Porque isto diz o Senhor dos exércitos, o Deus de Israel, aos vasos que se deixaram ficar na casa do Senhor, e na casa do rei de Judá, e em Jerusalém:"},{text:"22 A Babilônia serão transportados, e ali estarão até o dia da sua visita, diz o Senhor, e os farei trazer, e restituir a êste lugar."},{text:"Jeremias — capítulo 28."},{text:"1 E naquele ano no princípio do reinado de Sedecias, rei de Judá, no quinto mês do seu quarto ano, sucedeu que Hananias, filho de Azur, profeta que era de Gabaon, me disse na casa do Senhor em presença dos sacerdotes, e"},{text:"de todo o povo, as palavras seguintes:"},{text:"2 Isto diz o Senhor dos exércitos, o Deus de Israel: Eu quebrei o jugo do rei de Babilônia."},{text:"3 tools — see the cookie policy for details"},{text:"4 E eu farei que tornem para êste mesmo lugar Jeconias, filho de Joaquim, rei de Judá, e todos os cativos de Judá, que passaram a Babilônia, diz o Senhor: Porque hei de quebrar o jugo do rei de Babilônia."},{text:"5 E o profeta Jeremias respondeu ao profeta Hananias aos olhos dos sacerdotes e aos olhos de todo o povo, que estava na casa do Senhor:"},{text:"6 E disse o profeta Jeremias: Amém, assim o faça o Senhor: Vivifique o Senhor as tuas palavras, que profetizaste: Que sejam restituídos os vasos à casa do Senhor, e todo o cativeiro de Babilônia a êste lugar:"},{text:"7 Porém ouve tu esta palavra, que eu falo aos teus ouvidos, e aos ouvidos de todo o povo."},{text:"8 Os profetas, que foram primeiro que eu, e antes que tu desde o princípio, profetizaram também êles a muitas terras, e a grandes reinos, acêrca de guerra, e de desolação, e de fome."},{text:"9 O profeta que profetizou paz: Quando se cumprir a sua palavra, se saberá que é profeta, que na verdade enviou o Senhor."},{text:"10 E tirou o profeta Hananias a cadeia do pescoço do profeta Jeremias, e a quebrou."},{text:"11 E falou Hananias em presença de todo o povo, dizendo: Isto diz o Senhor: Assim quebrarei eu o jugo de Nabucodonosor, rei de Babilônia, depois de dois anos de dias, tirando-o de cima da cerviz de tôdas as gentes."},{text:"12 E o profeta Jeremias se foi seu caminho. E foi dirigida a palavra do Senhor a Jeremias, depois que Hananias profeta quebrou a cadeia do pescoço do profeta Jeremias, a qual dizia:"},{text:"13 Vai, e dirás a Hananias: Isto diz o Senhor: Quebraste umas cadeias de madeira: Mas em vez delas farás cadeias de ferro."},{text:"14 Porque isto diz o Senhor dos exércitos, o Deus de Israel: Eu tenho pôsto um jugo de ferro sôbre o pescoço de tôdas estas gentes, para que sirvam a Nabucodonosor, rei de Babilônia, e na realidade o servirão: Além disto"},{text:"tenho dado até as alimárias do campo."},{text:"15 E o profeta Jeremias disse ao profeta Hananias: Ouve, Hananias: O Senhor não te enviou, e tu tens feito que êste povo tenha pôsto a sua confiança numa mentira."},{text:"16 Portanto isto diz o Senhor: Eis-aqui estou eu que te exterminarei da face da terra: Êste ano morrerás: Porque falaste contra o Senhor."},{text:"17 E o profeta Hananias morreu àquele ano, no sétimo mês."},{text:"Jeremias — capítulo 29."},{text:"1 E estas são as palavras da carta, que o profeta Jeremias enviou de Jerusalém aos que ficaram dos anciãos do cativeiro, e aos sacerdotes, e aos profetas, e a todo o povo, que Nabucodonosor havia feito passar de"},{text:"Jerusalém a Babilônia:"},{text:"2 Depois que o rei Jeconias, e a senhora, e os eunucos, e os príncipes de Judá, e os de Jerusalém, e os artífices, e os cravadores saíram de Jerusalém:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Isto diz o Senhor dos exércitos, o Deus de Israel, a todos os do cativeiro que fiz transportar de Jerusalém a Babilônia:"},{text:"5 Edificai casas, e habitai-as: E plantai enxidos, e comei os seus frutos."},{text:"6 Tomai mulheres, e gerai filhos e filhas: E dai a vossos filhos mulheres, e dai maridos a vossas filhas, e criem filhos e filhas: e multiplicai-vos aí e não queirais ser poucos em número."},{text:"7 E buscai a paz da cidade, para a qual vos fiz transferir: E orai por ela ao Senhor: Porque na sua paz tereis vós a vossa."},{text:"8 Porque isto diz o Senhor dos exércitos, o Deus de Israel: Não vos seduzam os vossos profetas, que estão no meio de vós, nem os vossos adivinhos: E não façais caso dos vossos sonhos, que vós sonhais:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Porque êles vos profetizam falsamente em meu nome: E eu não os enviei, diz o Senhor."},{text:"10 Porque isto diz o Senhor: Quando se começarem a cumprir os setenta anos em Babilônia, eu vos visitarei: E renovarei a minha palavra favorável sôbre vós, para vos fazer voltar a êste lugar."},{text:"11 Porque eu sei os pensamentos, que eu tenho acêrca de vós, diz o Senhor, pensamentos de paz, e não de aflição, para vos dar o fim e a paciência."},{text:"12 E me invocareis a mim, e ireis: E me rogareis a mim, e eu vos atenderei."},{text:"13 Vós me buscareis, e vós me achareis: Quando me buscardes de todo o vosso coração."},{text:"14 E serei achado de vós, diz o Senhor: E farei voltar os vossos cativos, e recolher-vos-ei de tôdas as gentes, e de todos os lugares, para onde vos lancei, diz o Senhor: E far-vos-ei voltar do lugar para onde vos fiz"},{text:"transmigrar."},{text:"15 Porque vós dissestes: O Senhor nos suscitou profetas em Babilônia."},{text:"16 Porque isto diz o Senhor ao rei, que está assentado sôbre o trono de Davi, e a todo o povo que habita nesta cidade, aos vossos irmãos, que não saíram convosco para o cativeiro."},{text:"17 Isto diz o Senhor dos exércitos: Eis-aqui estou eu que enviarei contra êles a espada, e a fome, e a peste, e os tratarei como figos maus, que se não podem comer, porque são muito maus."},{text:"18 E persegui-los-ei com a espada, e com a fome, e com a peste: E os entregarei para a vexação a todos os reinos da terra: Para maldição, e para espanto, e para escárnio, e para opróbrio a tôdas as gentes, para as quais"},{text:"eu os tiver lançado."},{text:"19 Pelo motivo de que não escutaram as minhas palavras, diz o Senhor: As quais eu lhes dirigi a êles pelos profetas meus servos, levantando-me de noite, e enviando-lhos: E vós não ouvistes, diz o Senhor."},{text:"20 Vós, pois, ouvi a palavra do Senhor, todos os do cativeiro, que enviei de Jerusalém a Babilônia."},{text:"21 Isto diz o Senhor dos exércitos, o Deus de Israel, a Acab, filho de Golias, e a Sedecias, filho de Maasias, que vos profetizam falsamente em meu nome: Eis-aqui estou eu que os entregarei nas mãos de Nabucodonosor, rei"},{text:"de Babilônia: E êle os fará matar diante dos vossos olhos."},{text:"22 E em todo o cativeiro de Judá em Babilônia, tomará dêles certa maneira de maldição, dizendo: O Senhor se haja contigo, como êle se houve com Sedecias, e com Acab, que o rei de Babilônia fêz frigir no fogo:"},{text:"23 Por causa de terem feito loucuras em Israel, e adulteraram com as mulheres de seus amigos, e falaram falsamente em meu nome, palavras que eu lhes não tinha mandado dizer: Eu mesmo sou o juiz e a testemunha, diz o"},{text:"Senhor."},{text:"24 E a Semeias Neelamites dirás:"},{text:"25 Isto diz o Senhor dos exércitos, o Deus de Israel: Porquanto enviaste cartas em teu nome a todo o povo, que está em Jerusalém, e a Sofonias, filho de Maasias, sacerdote, e a todos os sacerdotes, dizendo:"},{text:"26 O Senhor te constituiu sacerdote em lugar de Jojada sacerdote, a fim de que tu sejas chefe na casa do Senhor, para reprimir a todo o varão fanático e que profetiza, para que o metas em um cepo e no cárcere."},{text:"27 Por que não repreendeste tu pois agora a Jeremias de Anatot, que vos profetiza?"},{text:"28 Porque acêrca disto nos enviou a nós a Babilônia, dizendo: Coisa dilatada é: Edificai casas, e habitai-as: E plantai enxidos, e comei os seus frutos."},{text:"29 Leu pois o sacerdote Sofonias esta carta aos ouvidos do profeta Jeremias."},{text:"30 E foi dirigida a palavra do Senhor a Jeremias, a qual dizia:"},{text:"31 Envia a dizer a todos os do cativeiro: Isto diz o Senhor a Semeias Neelamites: Porquanto vos profetizou Semeias, e eu o não enviei: E êle fêz que vós confiásseis na mentira:"},{text:"32 Portanto diz o Senhor: Eis-aqui estou eu que irei com a minha visita sôbre Semeias Neelamites, e sôbre a sua geração: Não haverá dêle varão, que se assente no meio dêste povo, e não verá êle bem que eu faça ao meu"},{text:"povo, diz o Senhor: Porque falou a prevaricação contra o Senhor."},{text:"Jeremias — capítulo 30."},{text:"1 Esta é a palavra, que foi dirigida pelo Senhor a Jeremias, a qual dizia:"},{text:"2 Isto profere o Senhor Deus de Israel, dizendo: Escreve tu em um livro tôdas as palavras que eu te tenho dito."},{text:"3 tools — see the cookie policy for details"},{text:"4 E estas são as palavras que o Senhor disse a Israel e a Judá:"},{text:"5 Porquanto isto diz o Senhor: Nós ouvimos uma voz de terror: Tudo é espanto, e não há paz."},{text:"6 Perguntai, e vêde se pare o varão: Pois por que tenho eu visto a mão de todo o varão sôbre o seu lombo como a que está de parto, e se lhe têm tornado as caras de todos êles em amarelidão?"},{text:"7 Ai, que é grande aquêle dia, nem êle tem semelhante: E tempo é de tribulação para Jacó, mas dêle será livre."},{text:"8 E acontecerá isto naquele dia, diz o Senhor dos exércitos: Quebrarei o jugo dêle do teu pescoço, e romperei as suas prisões, e não o dominarão mais os estranhos:"},{text:"9 Mas servirão ao Senhor seu Deus, e a Davi seu rei, que eu lhes suscitarei."},{text:"10 Tu pois, servo meu Jacó, não temas, diz o Senhor, nem te espantes Israel: Porque eis-aí está que eu te salvarei desta terra longínqua, e tirarei aos teus descendentes da terra do seu cativeiro: E voltará Jacó, e"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"repousará, e abundará em todos os bens, e não haverá de quem se tema:"},{text:"11 Porque eu sou contigo para te salvar, diz o Senhor: Eu destruirei pois tôdas as gentes, para entre as quais eu te arrojei disperso: A ti porém eu te não perderei inteiramente: Mas castigar-te-ei com eqüidade, para que"},{text:"tu te não tenhas por inocente."},{text:"12 Porque isto diz o Senhor: Incurável é a tua fratura, maligníssima a tua chaga:"},{text:"13 Não há quem faça juízo dela para ligá-la: Os remédios são inúteis para ti."},{text:"14 Todos os que te amavam, se esqueceram de ti, e não te buscarão: Porque te tenho ferido de ferida de inimigo com cruel castigo: Pela multidão das tuas maldades se têm endurecido os teus pecados."},{text:"15 Por que gritas sôbre o teu tormento? Incurável é a tua dor: Pela multidão das tuas maldades, e pela obstinação dos teus pecados te fiz isto."},{text:"16 Por cuja causa todos aquêles que te comem, serão devorados: E todos os teus inimigos serão levados para o cativeiro: E os que destroem, serão destruídos, e eu entregarei ao saque todos os que te saqueiam."},{text:"17 Porque eu fecharei a cicatriz da tua chaga, e te curarei das tuas feridas, diz o Senhor. Porquanto êles te chamaram, ó Sião, a repudiada: Esta é a que não tinha quem a buscasse."},{text:"18 Isto diz o Senhor: Eis-aí farei eu voltar os cativos que habitavam nas tendas de Jacó, e terei compaixão das suas casas, e a cidade será edificada na sua altura, e o templo será fundado, segundo a sua dignidade."},{text:"19 E sairá dêles o louvor, e a voz de júbilo: E os multiplicarei, e não serão diminuídos: E os glorificarei, e não serão atenuados."},{text:"20 E os seus filhos serão como eram desde o princípio, e a sua congregação permanecerá diante de mim: E irei com a minha visita contra todos os que o atribulam."},{text:"21 E dêle será o seu chefe: E o seu príncipe sairá do meio dêle: E o aplicarei, e êle se chegará a mim: Quem é pois aquêle que aplique o seu coração para chegar-se a mim? diz o Senhor."},{text:"22 E vós sereis o meu povo, e eu serei o vosso Deus."},{text:"23 Eis-aí o redemoinho do Senhor, e seu furor impetuoso, a sua tempestade a ponto de romper, vai a descansar sôbre a cabeça dos ímpios."},{text:"24 O Senhor não apartará a ira da sua indignação, menos, que êle não tenha executado, e cumprido todos os desígnios de seu coração: No último dos dias entendereis estas coisas."},{text:"Jeremias — capítulo 31."},{text:"1 Naquele tempo, diz o Senhor: Eu serei o Deus de tôdas as famílias de Israel, e êles mesmos serão o meu povo."},{text:"2 Isto diz o Senhor: O povo, que tinha escapado da espada, achou graça no deserto: Israel irá para o seu descanso."},{text:"3 tools — see the cookie policy for details"},{text:"4 E de novo te edificarei, e serás edificada, virgem de Israel: Ainda serás adornada dos teus atabales, e sairás acompanhada dos coros dos que dançam."},{text:"5 Ainda plantarás vinhas nos montes de Samaria: Plantarão os plantadores, e enquanto não chegar o tempo, não vindimarão:"},{text:"6 Porque virá um dia, em que os guardas gritarão no monte de Efraim: Levantai-vos e subamos a Sião ao Senhor nosso Deus."},{text:"7 Porque isto diz o Senhor: Regozijai-vos com júbilo por amor de Jacó, e dai relinchos à frente das gentes: Fazei ressoar tudo, e cantai, e dizei: Salva, Senhor, ao teu povo, as relíquias de Israel."},{text:"8 Eis-aqui estou eu que os trarei da terra do Aquilão, e os congregarei das extremidades da terra: o cego e o coxo, a mulher prenhe e a de parto estarão entre êles em companhia, sendo êste um grande tropel dos que"},{text:"tornarem para aqui."},{text:"9 Com chôro virão: Mas com misericórdia os tornarei a trazer: E os trarei por arroios de águas em caminho direito, e não tropeçarão nêle: Porque eu estou feito pai de Israel, e Efraim é o meu primogênito."},{text:"10 Ouvi, gentes, a palavra do Senhor, e anunciai-a às Ilhas, que estão ao longe, e dizei: O que espalhou a Israel o congregará: E guardá-lo-á como pastor ao seu rebanho."},{text:"11 Porque o Senhor remiu a Jacó, e o livrou da mão do mais poderoso."},{text:"12 E virão, e darão louvor no monte de Sião: E correrão aos bens do Senhor, ao trigo, e ao vinho, e ao azeite, e às crias das ovelhas e das vacas: E será a alma dêles como enxido de regadio e não terão mais fome."},{text:"13 Então se alegrará a virgem na dança, os mancebos e os velhos juntamente: E trocarei o seu pranto em gôzo, e os consolarei, e regozijarei passada a sua dor."},{text:"14 E embriagarei de gordura a alma dos sacerdotes: E o meu povo será cheio dos meus bens, diz o Senhor."},{text:"15 Isto diz o Senhor: Foi ouvida no alto uma voz da lamentação, do pranto, e do chôro de Raquel, que chorava seus filhos, e não queria ser consolada acêrca dêles, porque não existiam."},{text:"16 Isto diz o Senhor: Cesse já do chôro a tua voz, e de verterem lágrimas os teus olhos: Porque recompensa há para a tua obra, diz o Senhor: E êles voltarão da terra do inimigo."},{text:"17 As tuas esperanças enfim serão cumpridas, diz o Senhor: E voltarão teus filhos para os seus limites."},{text:"18 Tenho ouvido atentamente a Efraim, quando ia para o cativeiro, dizendo: Castigaste-me, e tenho sido ensinado, como novilho ainda não domado: Converte-me, e converter-me-ei: Porque tu és o Senhor meu Deus."},{text:"19 Porque depois que me converteste, fiz penitência: E depois que me abriste os olhos, feri a minha coxa. Eu fiquei confuso, e me envergonhei, porque suportei o opróbrio da minha mocidade."},{text:"20 Efraim verdadeiramente é para mim filho honrado, sim filho da minha ternura: Pois desde que falei dêle, ainda me lembrarei dêle. Por isso se comoveram as minhas entranhas por êle: Compadecido eu terei misericórdia"},{text:"dêle, diz o Senhor."},{text:"21 Faze-te uma atalaia, põe diante de ti amarguras: Dirige o teu coração ao caminho direito, em que andaste: Volta, virgem de Israel, volta a essas tuas cidades."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 Até quando te debilitarão as delícias, filha vagabunda? porque o Senhor criou um novo prodígio sôbre a terra: Uma mulher cercará a um varão."},{text:"23 Isto diz o Senhor dos exércitos, o Deus de Israel: Ainda dirão esta palavra na terra de Judá, e nas suas cidades, quando eu tiver feito voltar os cativos dêles: O Senhor te abençoe, ó formosura da justiça, ó monte"},{text:"santo!"},{text:"24 E habitarão nêle Judá, e tôdas as suas cidades juntamente: Os lavradores e os que pastoreiam os rebanhos."},{text:"25 Porque eu embriaguei a alma frouxa, e fartei a tôda a alma faminta."},{text:"26 Por isso eu espertei como dum sono: E vi, e o meu sono foi doce para mim."},{text:"27 Eis-aí vêm os dias, diz o Senhor: E eu semearei a casa de Israel e a casa de Judá de semente de homens, e de semente de animais."},{text:"28 E assim como vigiei sôbre êles para desarraigar, e demolir, e dissipar, e arruinar, e afligir: Do mesmo modo vigiarei sôbre êles para edificar, e plantar, diz o Senhor."},{text:"29 Naqueles dias não dirão mais: Os pais comeram as uvas em agraço, e os dentes dos filhos são os que ficaram botos."},{text:"30 Mas cada um morrerá na sua iniqüidade: Todo o homem, que comer uvas em agraço, a êsse é que lhe ficarão botos os dentes."},{text:"31 Eis-aí, virão os dias, diz o Senhor: E farei nova aliança com a casa de Israel, e com a casa de Judá:"},{text:"32 Não segundo o pacto, que eu fiz com seus pais no dia em que eu os tomei pela mão, para os tirar da terra do Egito: Pacto, que êles invalidaram, e eu mostrei o meu poder sôbre êles, diz o Senhor."},{text:"33 Mas esta será a aliança, que farei com a casa de Israel: Depois daqueles dias, diz o Senhor: Imprimirei a minha lei nas suas entranhas, e a escreverei nos seus corações: E eu lhes serei o seu Deus, e êles me serão o"},{text:"meu povo."},{text:"34 E não ensinará daí em diante varão ao seu próximo, nem varão ao seu irmão, dizendo: Conhece ao Senhor: Porque todos me conhecerão desde o mais pequeno dêles até ao maior, diz o Senhor: Porque perdoarei a maldade"},{text:"dêles, e não me lembrarei mais do seu pecado."},{text:"35 Isto diz o Senhor, que dá o sol para a luz do dia, a ordem da lua e das estrêlas para a luz da noite: O que turba o mar, e logo soam as suas ondas, o Senhor dos exércitos é o seu nome."},{text:"36 Se faltarem estas leis diante de mim, diz o Senhor: Então faltará também a linhagem de Israel, para que não haja gente diante de mim todos os dias."},{text:"37 Isto diz o Senhor: Se puderem ser medidos os céus para cima, e sondarem-se os fundamentos da terra para baixo: Eu também abandonarei a tôda a linhagem de Israel por tôdas as coisas que fizeram, diz o Senhor:"},{text:"38 Eis-aí vêm os dias, diz o Senhor: E será edificada pelo Senhor a cidade desde a tôrre de Hananeel até à porta do ângulo."},{text:"39 E estender-se-á mais adiante o cordel da medida à sua vista sôbre o outeiro de Gareb: E dará volta a Goata,"},{text:"40 e a todo o vale dos cadáveres, e da cinza, e a tôda a região da morte, até à torrente de Cedron, e até ao ângulo da porta dos cavalos, que está ao Oriente, o Santuário do Senhor: Não será arrancado êle, nem destruído"},{text:"dali por diante para sempre."},{text:"Jeremias — capítulo 32."},{text:"1 Palavra que pelo Senhor foi dirigida a Jeremias no décimo ano de Sedecias, rei de Judá: Êste é o ano décimo oitavo de Nabucodonosor."},{text:"2 Cercava então o exército do rei de Babilônia a Jerusalém: E o profeta Jeremias estava recluso no átrio do cárcere, que havia na casa do rei de Judá."},{text:"3 tools — see the cookie policy for details"},{text:"4 E Sedecias, rei de Judá, não escapará da mão dos caldeus: Mas será entregue nas mãos do rei de Babilônia: E falará com êle bôca a bôca, e os seus olhos verão os olhos dêle."},{text:"5 E levará a Sedecias para Babilônia: E ali estará até que eu o visite, diz o Senhor: E se pelejardes contra os caldeus, não tereis bom sucesso."},{text:"6 E disse Jeremias: Foi-me dirigida a palavra do Senhor, a qual dizia:"},{text:"7 Eis-aí está que teu primo Hanameel, filho de Selum, virá a ti, dizendo: Compra para ti o meu campo, que está em Anatot: Porque te compete a ti o comprá-lo por seres o mais próximo parente."},{text:"8 E veio ter comigo Hanameel, filho de meu tio paterno, conforme a palavra do Senhor, ao pátio do cárcere, e me disse: Apossa-te do meu campo, que está em Anatot, em terra de Benjamim: Porque a ti te compete a herança, e"},{text:"tu és o parente mais chegado para possuí-la. E eu entendi que era palavra do Senhor."},{text:"9 E comprei o campo a Hanameel, filho de meu tio paterno, que está em Anatot: E lhe pesei por êle em prata sete estáteres, e dez siclos também de prata."},{text:"10 E fiz uma escritura, e assinei-a, e chamei testemunhas: E pus o dinheiro em uma balança."},{text:"11 E tomei a escritura de aquisição, firmada, e as estipulações do contrato, e a ratificação dêle, com os selos por fora."},{text:"12 E dei a escritura de aquisição a Baruc, filho de Neri, filho de Maasias, à vista de Hanameel, meu primo, à vista das testemunhas, que se haviam assinado na escritura de compra, e à vista de todos os judeus, que"},{text:"estavam assentados no átrio do cárcere."},{text:"13 E dei ordem a Baruc diante dêles, dizendo:"},{text:"14 Isto diz o Senhor dos exércitos, o Deus de Israel: Toma estas escrituras, esta escritura de compra cerrada, e esta outra escritura, que está aberta: E mete-as numa vasilha de barro, para que se possam conservar muitos"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jeremias Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"dias."},{text:"15 Porque eis-aqui o que diz o Senhor dos exércitos, o Deus de Israel: Ainda se comprarão casas e campos, e vinhas nesta terra."},{text:"16 E roguei ao Senhor, depois que entreguei a escritura de aquisição a Baruc, filho de Neri, dizendo:"},{text:"17 Ah! ah! ah! Senhor Deus: Eis-aí está que tu fizeste o céu e a terra com o teu grande poder, e com o teu braço estendido: Não haverá coisa alguma que seja difícil para ti:"},{text:"18 Que fazes misericórdia em milhares, e tornas a iniqüidade dos pais ao seio de seus filhos depois dêles: Ó fortíssimo, grande e poderoso, o Senhor dos exércitos é o teu nome."},{text:"19 Grande em conselho, e incompreensível no pensamento, cujos olhos estão abertos sôbre todos os caminhos dos filhos de Adão, para retribuíres a cada um segundo os seus caminhos, e segundo o fruto das invenções do seu"},{text:"capricho."},{text:"20 Que fizeste sinais e portentos na terra do Egito até o dia de hoje, e em Israel, e entre os homens, e te fizeste um nome qual tu tens neste dia."},{text:"21 E tiraste o teu povo de Israel da terra do Egito com sinais e com portentos, e com uma mão forte, e com um braço estendido e com grande terror."},{text:"22 E lhes deste esta terra, como o juraste aos pais dêles, que lhes darias uma terra, que manasse leite e mel."},{text:"23 E entraram, e tomaram posse dela: E não obedeceram à tua voz, nem andaram na tua lei, não cumpriram nada de quanto lhes mandaste que fizessem: E lhes aconteceram todos êstes males."},{text:"24 Eis-aí levantadas estão as máquinas contra a cidade para ser tomada: E a cidade tem sido entregue nas mãos dos caldeus, que combatem contra ela à vista da espada, e da fome, e da peste: E quanto falaste tudo"},{text:"aconteceu, como tu mesmo o estás presenciando."},{text:"25 E tu, Senhor Deus, me dizes: Compra o campo por dinheiro, e toma testemunhas: havendo sido a cidade entregue nas mãos dos caldeus."},{text:"26 E foi dirigida a palavra do Senhor a Jeremias, a qual dizia:"},{text:"27 Eis-aqui estou eu que sou o Senhor Deus de tôda a carne: Haverá pois alguma coisa que seja difícil para mim?"},{text:"28 Portanto, isto diz o Senhor: Eis-aqui estou eu que entregarei esta cidade nas mãos dos caldeus, e nas mãos do rei de Babilônia, e êles a tomarão."},{text:"29 E virão os caldeus a pelejar contra esta cidade, e lhe porão fogo, e a queimarão, e as casas, em cujos terraços sacrificavam a Baal, e ofereciam a deuses estranhos libações para me irritarem."},{text:"30 Porque os filhos de Israel, e os filhos de Judá estavam fazendo incessantemente o mal diante dos meus olhos desde a sua mocidade: Os filhos de Israel que até agora me irritam com as obras das suas mãos, diz o Senhor."},{text:"31 Porque esta cidade se me tem feito objeto do meu furor e da minha indignação, desde o dia em que a edificaram, até êste dia em que será tirada da minha presença."},{text:"32 Pela maldade dos filhos de Israel, e dos filhos de Judá, que fizeram, provocando-me a ira, êles mesmos e os seus reis, e os seus príncipes, e os seus sacerdotes, e os seus profetas, os varões de Judá e os moradores de"},{text:"Jerusalém."},{text:"33 E voltaram-me as costas e não o rosto: Quando os ensinava de madrugada, e os corrigia, e não queriam ouvir para receberem a admoestação."},{text:"34 E puseram os seus ídolos na casa em que o meu nome foi invocado, para o profanarem."},{text:"35 E edificaram a Baal os altares que estão no vale do filho de Enom para fazerem sacrifícios de seus filhos e de suas filhas a Moloc: O que eu lhes não mandei, nem subiu ao meu coração que fizessem esta abominação, nem"},{text:"induzissem o pecado a Judá."},{text:"36 E agora por amor disto, assim diz o Senhor Deus de Israel a esta cidade, da qual vós dizeis que será entregue nas mãos do rei de Babilônia à espada, e à fome, e à peste:"},{text:"37 Eis-aqui estou eu que os congregarei de tôdas as terras, para onde os lancei no meu furor, e na minha ira, e na minha grande indignação: E os trarei a êste lugar, e farei que habitem nêle sem temor."},{text:"38 E serão para mim o meu povo, e eu serei para êles o seu Deus."},{text:"39 E dar-lhes-ei um coração, e um caminho, para que me temam todos os dias: E lhes vá bem a êles, e a seus filhos depois dêles."},{text:"40 E farei com êles uma aliança sempiterna, e não deixarei de fazer-lhes bem: E porei o meu temor no coração dêles, para que se não apartem de mim."},{text:"41 E alegrar-me-ei sôbre êles, quando lhes fizer bem a êles: E plantá-los-ei nesta terra em verdade, com todo o meu coração, e com tôda a minha alma."},{text:"42 Porque isto diz o Senhor: Assim como fiz vir sôbre êste povo todo êste grande mal, assim farei vir sôbre êles todo o bem, que eu lhes anuncio."},{text:"43 E serão possuídos os campos nesta terra: Da qual vós dizeis que está tôda deserta, por não ter ficado nela nem homem, nem animal, e porque ela foi entregue nas mãos dos caldeus."},{text:"44 Os campos serão comprados por dinheiro, e registrados em escritura, e pôr-se-lhes-á o sêlo, e tomar-se-ão testemunhas: Na terra de Benjamim, e nos contornos de Jerusalém, nas cidades de Judá, e nas cidades das"},{text:"montanhas, e nas cidades das planícies, nas cidades que estão ao meio-dia: Porque farei voltar os cativos dêles, diz o Senhor."},{text:"Jeremias — capítulo 33."},{text:"1 E foi dirigida a palavra do Senhor a Jeremias segunda vez, quando ainda estava recluso no átrio do cárcere, a qual dizia:"},{text:"2 Isto diz o Senhor, o qual há de fazer, e há de formar, e dispor aquilo que disse; o Senhor é o seu nome."},{text:"3 tools — see the cookie policy for details"}]}] 1
