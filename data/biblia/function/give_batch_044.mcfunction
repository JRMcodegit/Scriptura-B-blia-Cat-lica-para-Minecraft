give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 51",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 Não tenha quem o ajude: Nem haja quem se compadeça dos seus órfãos."},{text:"13 Sejam seus filhos para extermínio: Em uma só geração fique apagado o seu nome."},{text:"14 A iniqüidade de seus pais reviva na presença do Senhor ocorrendo à sua lembrança: E o pecado de sua mãe não seja apagado."},{text:"15 Estejam sempre diante do Senhor, e seja riscada da terra a memória dêles."},{text:"16 Porquanto se não lembrou de usar de misericórdia."},{text:"17 E perseguiu ao homem sem amparo, e ao mendigo, e ao quebrantado de coração para o entregar à morte."},{text:"18 E como amou a maldição, ela lhe virá: E como não quis a bênção ela se apartará dêle. E vestiu-se de maldição como dum vestido, e entrou como água nas suas entranhas, e como azeite nos seus ossos."},{text:"19 Seja-lhe como o vestido, com que se cobre: E como a cinta, com que sempre se cinge."},{text:"20 Esta é diante do Senhor a obra daqueles que dizem mal de mim: E que falam males contra a minha alma."},{text:"21 E tu, Senhor, Senhor, toma à tua conta a minha defensa por amor de teu Nome: Porque suave é a tua misericórdia. Livra-me."},{text:"22 Porque eu sou necessitado, e pobre: E o meu coração está turbado dentro de mim."},{text:"23 Tenho desaparecido, como a sombra que vai caindo: E tenho sido arrojado como os gafanhotos."},{text:"24 Os meus joelhos se têm debilitado pelo jejum: E minha carne se tem mudado pelo azeite."},{text:"25 E eu tenho chegado a ser o opróbrio dêles: Viram-me e menearam as suas cabeças."},{text:"26 Assiste-me, Senhor Deus meu: Salva-me segundo a tua misericórdia."},{text:"27 E saibam que isto é um golpe da tua mão: E que tu, Senhor, tens feito estas coisas."},{text:"28 Êles me amaldiçoarão, e tu me abençoarás: Confundidos sejam os que se levantam contra mim: Mas o teu servo se alegrará."},{text:"29 Vestidos sejam de afronta os que me caluniam: E fiquem cobertos da sua confusão como de uma capa dobrada."},{text:"30 Glorificarei altamente ao Senhor com a minha bôca: E no meio de muitos o louvarei."},{text:"31 Porque se pôs à direita do pobre, para salvar a minha alma dos perseguidores."},{text:"Salmos — capítulo 109."},{text:"1 Salmo de Davi. Disse o Senhor ao meu Senhor: Senta-te à minha mão direita: Até que ponha a teus inimigos por escabêlo de teus pés."},{text:"2 De Sião fará sair o Senhor o cetro do teu poder: Reina tu no meio de teus inimigos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Jurou o Senhor, e não se arrependerá: Tu és sacerdote eternamente segundo a ordem de Melquisedec."},{text:"5 O Senhor está à tua direita, quebrantou os reis no dia da sua ira."},{text:"6 Exercerá o seu juízo no meio das nações, meterá tudo em ruína: Esmigalhará as cabeças de muitos sôbre a terra."},{text:"7 Beberá no caminho da torrente das águas: Por cujo motivo levantará a sua cabeça."},{text:"Salmos — capítulo 110."},{text:"1 Aleluia. Louvar-te-ei, Senhor, com todo o meu coração: No conselho dos justos, e na congregação."},{text:"2 Grandes são as obras do Senhor: Apropriadas a tôdas as suas vontades."},{text:"3 tools — see the cookie policy for details"},{text:"4 Deixou memória das suas maravilhas, o Senhor, que é misericordioso e compassivo:"},{text:"5 Deu sustento aos que o temem: Lembrar-se-á eternamente da sua aliança:"},{text:"6 Anunciará ao seu povo a virtude das suas obras."},{text:"7 Para lhes dar a êles a herança das gentes: As obras das suas mãos são verdade, e justiça."},{text:"8 Fiéis são todos os seus mandamentos: Confirmados em todos os séculos, feitos em verdade e em eqüidade."},{text:"9 Redenção enviou ao seu povo: Estabeleceu para sempre a sua aliança. Santo, e terrível é o nome dêle:"},{text:"10 O temor do Senhor é princípio da sabedoria. É bom entendimento o de todos os que obram como êle: O seu louvor permanece para sempre."},{text:"Salmos — capítulo 111."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 52",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Aleluia, da remigração de Ageu, e de Zacarias. Bem-aventurado o varão, que teme ao Senhor: Nos seus mandamentos se comprazerá muito."},{text:"2 Poderosa será a sua posteridade sôbre a terra: Bendita será a geração dos justos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Nas trevas nasceu a luz aos retos: Misericordioso é, e compassivo, e justo."},{text:"5 Ditoso o homem que se compadece e empresta, êle disporá os seus discursos com juízo."},{text:"6 Porque nunca jamais será comovido."},{text:"7 A memória do justo será eterna: Não temerá ouvir palavra má. O seu coração está sempre aparelhado para esperar no Senhor,"},{text:"8 fortalecido está o seu coração: Não será comovido até que veja abatidos a seus inimigos."},{text:"9 Distribuiu, deu aos pobres: A sua justiça permanece por todos os séculos, o seu poder será exaltado na glória."},{text:"10 Vê-lo-á o pecador, e se indignará, rangerá com os seus dentes e se consumirá; o desejo dos pecadores perecerá."},{text:"Salmos — capítulo 112."},{text:"1 Aleluia. Louvai, ó meninos, ao Senhor: Louvai o nome do Senhor."},{text:"2 Seja bendito o nome do Senhor, desde agora para sempre."},{text:"3 tools — see the cookie policy for details"},{text:"4 Excelso é o Senhor sôbre tôdas as gentes, e a sua glória é sôbre os Céus."},{text:"5 Quem há como o Senhor nosso Deus, que habita nas alturas,"},{text:"6 e atende às coisas humildes no Céu e na terra?"},{text:"7 Êle levanta da terra ao desvalido, e tira da abjeção ao pobre:"},{text:"8 Para o colocar com os príncipes, com os príncipes do seu povo."},{text:"9 Êle faz que habite na casa a mulher estéril, alegre de se ver mãe de filhos."},{text:"Salmos — capítulo 113."},{text:"1 Aleluia. Quando Israel saiu do Egito, a casa de Jacó do meio de um povo bárbaro:"},{text:"2 Consagrou Deus a Judéia ao seu serviço, e estabeleceu em Israel o seu império."},{text:"3 tools — see the cookie policy for details"},{text:"4 Os montes saltaram de alegria como carneiros: E as colinas como cordeiros do rebanho."},{text:"5 Que tiveste tu, ó mar, que fugiste: E tu, Jordão, para retrocederes?"},{text:"6 Ó montes, que saltais de prazer como carneiros, e vós colinas como cordeiros de rebanho."},{text:"7 Comoveu-se a terra na presença do Senhor: Perante o Deus de Jacó."},{text:"8 Que converteu as pedras em tanques de águas, e o rochedo em fontes de águas."},{text:"9 Não a nós, Senhor, não a nós: Mas ao teu nome dá a glória."},{text:"10 Para fazeres resplandecer a tua misericórdia, e a tua verdade: Para que nunca digam as nações: Onde está o seu Deus?"},{text:"11 Mas o nosso Deus está no céu: Tudo quanto quis, fêz."},{text:"12 Os ídolos das gentes não são senão prata, e ouro, obras de mãos de homens."},{text:"13 Têm bôca, e não falarão: Têm olhos e não verão."},{text:"14 Têm ouvidos, e não ouvirão: Têm narizes, e não cheirarão."},{text:"15 Têm mãos, e não apalparão: Têm pés, e não andarão: Não clamarão com a sua garganta."},{text:"16 Sejam semelhantes a êles os que os fazem: E todos os que confiam nêles."},{text:"17 A casa de Israel esperou no Senhor: Êle é seu favorecedor e seu protetor."},{text:"18 A casa de Aarão esperou no Senhor: Êle é seu favorecedor e seu protetor."},{text:"19 Os que temem ao Senhor, esperaram no Senhor: Êle é seu favorecedor e seu protetor."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 53",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 O Senhor se lembrou de nós: E nos abençoou. Abençoou a casa de Israel: Abençoou a casa de Aarão."},{text:"21 Abençoou a todos os que temem ao Senhor, aos pequenos como aos grandes."},{text:"22 Acrescente o Senhor bênção sôbre vós: Sôbre vós, e sôbre vossos filhos."},{text:"23 Sêde benditos do Senhor, que fêz o céu e a terra."},{text:"24 O mais alto dos céus é para o Senhor: Mas a terra a deu aos filhos dos homens."},{text:"25 Os mortos, Senhor, não te louvarão: Nem algum dos que descem ao inferno."},{text:"26 Mas nós que vivemos, bendizemos ao Senhor, desde agora e por todos os séculos."},{text:"Salmos — capítulo 114."},{text:"1 Aleluia. Amei, porque o Senhor ouvirá a voz da minha oração."},{text:"2 Porque inclinou para mim o seu ouvido: E eu o invocarei todos os dias da minha vida."},{text:"3 tools — see the cookie policy for details"},{text:"4 E invoquei o nome do Senhor. Ó Senhor, livra a minha alma:"},{text:"5 Misericordioso e justo é o Senhor, e o nosso Deus tem comiseração."},{text:"6 O Senhor é o que guarda os pequeninos: Eu fui humilhado, e êle me livrou."},{text:"7 Volta, ó alma minha, ao teu repouso: Porque o Senhor te fêz bem."},{text:"8 Porque livrou da morte a minha alma: Os meus olhos das lágrimas, os meus pés da queda."},{text:"9 Agradarei ao Senhor na região dos vivos."},{text:"Salmos — capítulo 115."},{text:"1 Aleluia. Acreditei, por isso falei: Mas eu estive na última humilhação."},{text:"2 Eu disse no meu êxtase: Todo homem é mentiroso."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tomarei o cálice da salvação: E invocarei o Nome do Senhor."},{text:"5 Cumprirei os meus votos ao Senhor: Diante de todo o seu povo:"},{text:"6 É preciosa aos olhos do Senhor a morte dos seus santos."},{text:"7 Ó Senhor, porque sou teu servo: Eu sou teu servo, e filho da tua escrava. Rompeste os meus laços:"},{text:"8 E a ti oferecerei sacrifício de louvor, e invocarei o Nome do Senhor."},{text:"9 Cumprirei os meus votos ao Senhor à vista de todo o seu povo:"},{text:"10 Nos átrios da casa do Senhor, no meio de ti, ó Jerusalém."},{text:"Salmos — capítulo 116."},{text:"1 Louvai tôdas as gentes ao Senhor: Louvai-o todos os povos."},{text:"2 Porque sôbre nós foi confirmada a sua misericórdia: E a verdade do Senhor permanece eternamente."},{text:"Salmos — capítulo 117."},{text:"1 Aleluia. Louvai ao Senhor, porque êle é bom: Porque a sua misericórdia se estende a todos os séculos."},{text:"2 Diga agora Israel que o Senhor é bom: Porque a sua misericórdia se estende a todos os séculos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Digam agora os que temem ao Senhor: Que a sua misericórdia se estende a todos os séculos."},{text:"5 No meio da tribulação invoquei ao Senhor: E me atendeu o mesmo Senhor desafrontando-me."},{text:"6 O Senhor é o meu amparo: Não temerei o que me possa fazer o homem."},{text:"7 O Senhor é o meu amparo: E eu desprezarei aos meus inimigos."},{text:"8 Bom é confiar no Senhor, antes que esperar no homem."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 54",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Bom é esperar no Senhor, antes que esperar nos príncipes."},{text:"10 Tôdas as gentes me cercaram: Mas eu tomei vingança delas em Nome do Senhor."},{text:"11 Pondo-se à roda de mim me cercaram: E eu tomei vingança dêles em Nome do Senhor."},{text:"12 Cercaram-me como abelhas, e se incendiaram como fogo em espinhos: E eu tomei vingança dêles em Nome do Senhor."},{text:"13 Tendo sido impelido fui transtornado para cair: Mas o Senhor me susteve."},{text:"14 O Senhor é a minha fortaleza, e o meu louvor: E se tornou para mim em salvação."},{text:"15 Voz de júbilo e de salvação soam nas tendas dos justos."},{text:"16 A destra do Senhor fêz proezas: A destra do Senhor me exaltou, a destra do Senhor fêz proezas."},{text:"17 Não morrerei mas viverei: E referirei as obras do Senhor."},{text:"18 O Senhor me deu castigo severo: Mas não me entregou à morte."},{text:"19 Abri-me as portas da justiça: Depois de entrar por elas, louvarei ao Senhor:"},{text:"20 Esta é a porta do Senhor, os justos entrarão por ela:"},{text:"21 A ti te louvarei porque me ouviste: E te tornaste para mim em salvação."},{text:"22 A pedra, que desprezaram os edificadores: Foi posta por cabeça do ângulo."},{text:"23 Pelo Senhor foi feito isto: E é coisa admirável nos nossos olhos."},{text:"24 Êste é o dia que fêz o Senhor: Regozijemo-nos, e alegremo-nos nêle."},{text:"25 Ó Senhor salva-me, ó Senhor, faze que tenha prosperidade:"},{text:"26 Bendito o que vem em Nome do Senhor. Nós vos bendizemos a vós que sois da casa do Senhor:"},{text:"27 O Senhor é Deus, e nos manifestou a sua luz. Estabelecei dia solene com ramos frondosos, até ao ângulo do altar."},{text:"28 Tu és o meu Deus, e a ti te louvarei: Tu és o meu Deus, e a ti te exaltarei. A ti te louvarei, porque me atendeste: E te tornaste para mim em salvação."},{text:"29 Louvai ao Senhor porque é bom: Porque a sua misericórdia é para sempre."},{text:"Salmos — capítulo 118."},{text:"1 Aleluia. Aleph. Bem-aventurados os que se conservam sem mácula no caminho: Os que andam na lei do Senhor."},{text:"2 Bem-aventurados os que consideram os seus testemunhos: Os que de todo o coração o buscam."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tu ordenaste que os teus mandamentos fôssem guardados à risca."},{text:"5 Oxalá que os meus caminhos sejam dirigidos ao cumprimento das tuas justificações."},{text:"6 Então não serei confundido, quando me empregar atento na observância de todos os teus mandamentos."},{text:"7 Eu te louvarei com retidão de coração: Porque tenho aprendido os juízos da tua justiça."},{text:"8 Guardarei as tuas justificações: Não me desampares jamais."},{text:"9 Beth. De que modo emenda o mancebo o seu caminho? Guardando as tuas palavras."},{text:"10 De todo o meu coração te busquei: Não me deixes sair dos teus mandamentos."},{text:"11 No meu coração escondi as tuas palavras: Para não pecar contra ti."},{text:"12 Bendito és, Senhor: Ensina-me as tuas justificações."},{text:"13 Com os meus lábios pronunciei todos os juízos da tua bôca."},{text:"14 Eu me deleitei no caminho de teus testemunhos, como em tôdas as riquezas."},{text:"15 Nos teus mandamentos me exercitarei: E considerarei os teus caminhos."},{text:"16 Nas tuas justificações meditarei: Não me esquecerei das tuas palavras."},{text:"17 Ghimel. Concede esta graça ao teu servo, dá-me vida: E eu guardarei as tuas palavras."},{text:"18 Tira o véu dos meus olhos: E eu considerarei as maravilhas da tua lei."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 55",author:"Pe. A. P. de Figueiredo",pages:[{text:"19 Eu sou peregrino na terra: Não escondas de mim os teus mandamentos."},{text:"20 A minha alma desejou ansiosa em todo o tempo as tuas justificações."},{text:"21 Increpaste os soberbos: Malditos os que se apartam dos teus mandamentos."},{text:"22 Livra-me do opróbrio, e desprêzo: Porque busquei cuidadoso os teus mandamentos."},{text:"23 Pôsto que se sentaram os príncipes, e falavam contra mim: O teu servo todavia se exercitava nas tuas justificações."},{text:"24 Porque tanto os teus testemunhos são a minha meditação: Como as tuas justificações são o meu conselho."},{text:"25 Daleth. A minha alma estêve pegada com o chão, dá-me vida, segundo a tua palavra."},{text:"26 Eu te expus os meus caminhos, e tu me atendeste: Ensina-me as tuas justificações."},{text:"27 Instrui-me no caminho das tuas justificações: E exercitar-me-ei nas tuas maravilhas."},{text:"28 A minha alma adormeceu de tédio: Fortifica-me com as tuas palavras."},{text:"29 Aparta de mim o caminho da iniqüidade: E tem misericórdia de mim segundo a tua lei."},{text:"30 Eu escolhi o caminho da verdade: Não me esqueci dos teus juízos."},{text:"31 Eu, Senhor, me tenho apoiado nos teus testemunhos: Não me queiras confundir."},{text:"32 Corri pelo caminho dos teus mandamentos, quando dilataste o meu coração."},{text:"33 He. Impõe-me por lei, Senhor, o caminho das tuas justificações: E buscá-lo-ei sempre."},{text:"34 Dá-me inteligência, e estudarei na tua lei: E a guardarei de todo o meu coração."},{text:"35 Guia-me pela vereda dos teus mandamentos: Porque essa mesma desejei."},{text:"36 Inclina o meu coração para os teus testemunhos: E não para a avareza."},{text:"37 Aparta os meus olhos para que não vejam a vaidade: No teu caminho dá-me a vida."},{text:"38 Faze firme ao teu servo a tua palavra mediante o teu temor."},{text:"39 Aparta de mim o opróbrio, que eu temi: Porque os teus juízos são agradáveis."},{text:"40 Tu vês que eu desejei muito os teus mandamentos: Faze que eu viva na tua justiça."},{text:"41 Vau. E venha sôbre mim a tua misericórdia, Senhor: A tua salvação segundo a tua palavra."},{text:"42 E darei em resposta aos que me insultam: Que pus a minha esperança nas tuas palavras."},{text:"43 E não tires jamais da minha bôca a palavra de verdade: Porque nos teus juízos tenho esperado muito."},{text:"44 E guardarei sempre a tua lei: Por séculos e por séculos de séculos."},{text:"45 Caminhava ao largo: Porque busquei cuidadosamente os teus mandamentos."},{text:"46 E falava dos teus testemunhos diante dos reis: E não me envergonhava."},{text:"47 E meditava nos teus mandamentos, que amei."},{text:"48 E levantei as minhas mãos aos teus mandamentos, que amei: E me exercitava nas tuas justificações."},{text:"49 Zain. Lembra-te da tua palavra a favor do teu servo, na qual me tens feito esperar."},{text:"50 Isto me consolou no meu abatimento: Porque a tua palavra me deu vida."},{text:"51 Os soberbos obravam sem cessar inìqüamente: Mas eu não me apartei da tua lei."},{text:"52 Eu me lembrei dos juízos que exerceste em todos os séculos, Senhor: E me consolei."},{text:"53 E desfaleci, vendo aos pecadores que deixavam a tua lei."},{text:"54 As tuas justificações eram dignas de ser cantadas por mim, no lugar da minha peregrinação."},{text:"55 Lembrei-me do teu Nome, Senhor, durante a noite: E guardei a tua lei."},{text:"56 Isto me veio: Porque busquei cuidadoso as tuas justificações."},{text:"57 Heth. Eu disse, Senhor, a minha pertença é guardar a tua lei."},{text:"58 Roguei na tua presença de todo o meu coração: Compadece-te de mim segundo a tua palavra."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 56",author:"Pe. A. P. de Figueiredo",pages:[{text:"59 Considerei os meus caminhos: E voltei os meus pés para os teus testemunhos."},{text:"60 Pronto estou, e em nada me tenho perturbado: Para guardar os teus mandamentos."},{text:"61 Laços de pecadores me cingiram por tôdas as partes: E eu me não esqueci da tua lei."},{text:"62 À meia-noite me levantava para te louvar, sôbre os juízos da tua justificação."},{text:"63 Eu sou participante de todos os que te temem: E dos que guardam os teus mandamentos."},{text:"64 A terra está cheia, Senhor, da tua misericórdia: Ensina-me as tuas justificações."},{text:"65 Teth. De bondade tens usado com o teu servo, Senhor, segundo a tua palavra."},{text:"66 Ensina-me bondade, e doutrina, e ciência: Porque dei crédito aos teus mandamentos."},{text:"67 Antes de ser humilhado eu delinqüi: Por isso guardei a tua palavra."},{text:"68 Tu és bom: E segundo tua bondade ensina-me as tuas justificações."},{text:"69 A iniqüidade dos soberbos se multiplicou sôbre mim: Mas eu de todo o meu coração estudarei os teus mandamentos."},{text:"70 O coração dêles se coalhou como leite: Porém eu me pus a meditar na tua lei."},{text:"71 Para mim foi-me bom que tu me humilhasses: Para eu aprender as tuas justificações."},{text:"72 Para mim foi melhor a lei que saiu da tua bôca, do que milhões de ouro e de prata."},{text:"73 Jod. As tuas mãos me fizeram, e me formaram: Dá-me inteligência, e eu aprenderei os teus mandamentos."},{text:"74 Os que te temem me verão, e se alegrarão: Porque pus tôda a minha esperança nas tuas palavras."},{text:"75 Tenho conhecido, Senhor, que os teus juízos são de eqüidade: E na tua verdade me humilhaste."},{text:"76 Seja a tua misericórdia para consolar-me, segundo a palavra que deste a teu servo."},{text:"77 Venham a mim as tuas misericórdias, e viverei: Porque a tua lei é a minha meditação."},{text:"78 Sejam confundidos os soberbos, pois injustamente maquinaram males contra mim: Mas eu nos teus mandamentos me exercitarei."},{text:"79 Voltem-se para mim os que te temem: E os que conhecem os teus testemunhos."},{text:"80 Seja imaculado o meu coração na prática das tuas justificações, para que eu não seja confundido."},{text:"81 Caph. Desfaleceu a minha alma pela tua salvação: E na tua palavra tenho pôsto tôda a minha esperança."},{text:"82 Os meus olhos se enfraqueceram de atentos à tua palavra, dizendo: Quando me consolarás?"},{text:"83 Porque eu me tornei como ôdre exposto à geada: Mas não me esqueci das tuas justificações."},{text:"84 Quantos são os dias de teu servo? Quando farás juízo dos que me perseguem?"},{text:"85 Contaram-me os ímpios coisas frívolas: Mas não como tua lei."},{text:"86 Todos os teus mandamentos são verdade: Injustamente me têm perseguido, dá-me socorro."},{text:"87 Por pouco não deram cabo de mim na terra: Mas eu não abandonei os teus mandamentos."},{text:"88 Segundo a tua misericórdia vivifica-me: E eu guardarei os testemunhos da tua bôca."},{text:"89 Lamed. Senhor, para sempre no céu permanece a tua palavra."},{text:"90 Por geração e geração subsiste a tua verdade: Tu fundaste a terra, e ela permanece."},{text:"91 Por tua ordem persevera o dia: Porque tôdas as coisas te servem."},{text:"92 Se a tua lei não houvera sido a minha meditação: Então decerto houvera eu perecido na minha aflição."},{text:"93 Nunca jamais me esquecerei das tuas justificações: Porque nelas me vivificaste."},{text:"94 Eu sou teu, salva-me: Porque as tuas justificações busquei ansioso."},{text:"95 Os pecadores me esperaram para me perder: Os teus testemunhos tenho entendido."},{text:"96 Tenho visto o fim de tôda a coisa acabada: O teu mandamento é largo sem medida."},{text:"97 Mem. De que modo tenho eu, Senhor, amado a tua lei? ela é a minha meditação todo o dia."},{text:"98 Mais que os meus inimigos me fizeste prudente no teu mandamento: Porque o tenho perpètuamente diante de meus olhos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 57",author:"Pe. A. P. de Figueiredo",pages:[{text:"99 Mais que todos os que me ensinavam tenho entendido: Porque os teus testemunhos são a minha meditação."},{text:"100 Mais que os anciãos entendi: Porque busquei os teus mandamentos."},{text:"101 De todo o mau caminho retirei os meus pés: Para guardar as tuas palavras."},{text:"102 De teus juízos não me tenho apartado: Porque tu me prescreveste uma lei."},{text:"103 Quão doces são as tuas palavras ao meu paladar, mais que o mel à minha bôca!"},{text:"104 Pelos teus mandamentos tenho adquirido inteligência: Por isso aborreço todo o caminho de iniqüidade."},{text:"105 Nun. Tocha resplandecente para os meus pés é a tua palavra, e luz para os meus caminhos."},{text:"106 Jurei, e determinei guardar os juízos da tua justiça."},{text:"107 Tenho sido humilhado, Senhor, de todos os modos: Faze-me viver segundo a tua palavra."},{text:"108 Faze, Senhor que te seja agradável a homenagem voluntária da minha bôca: E ensina-me os teus juízos."},{text:"109 A minha alma está sempre nas minhas mãos: E não me esqueci da tua lei."},{text:"110 Laço me têm armado os pecadores: E dos teus mandamentos não me apartei."},{text:"111 Por herança tenho adquirido os teus testemunhos para sempre: Porque são a alegria do meu coração."},{text:"112 Inclinei o meu coração a praticar eternamente as tuas justificações, pela retribuição."},{text:"113 Samech. Tenho aborrecido aos iníquos: E tenho amado a tua lei."},{text:"114 Tu és o meu favorecedor, e o meu amparador: E tenho pôsto tôda a minha esperança na tua palavra."},{text:"115 Retirai-vos de mim, malignos: E eu estudarei os mandamentos do meu Deus."},{text:"116 Ampara-me segundo a tua palavra e viverei; E não permitas que eu seja confundido no que espero."},{text:"117 Favorece-me, e serei salvo: E meditarei sempre nas tuas justificações."},{text:"118 Desprezaste a todos os que se desviam dos teus juízos: Porque é injusto o seu