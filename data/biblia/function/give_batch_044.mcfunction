give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 58",author:"Pe. A. P. de Figueiredo",pages:[{text:"139 O meu zêlo me tem feito entisicar: Porque os meus inimigos se esqueceram das tuas palavras."},{text:"140 A tua palavra é ardente em grande maneira: E o teu servo a tem amado."},{text:"141 Eu sou mancebinho, e desprezível: Não estou esquecido das tuas justificações."},{text:"142 A tua justiça é justiça eterna: E a tua lei é a mesma verdade."},{text:"143 A tribulação, e a angústia me surpreenderam: Os teus mandamentos são a minha meditação."},{text:"144 Os teus testemunhos são cheios duma eterna eqüidade: Dá-me inteligência dêles, e viverei."},{text:"145 Coph. Clamei de todo o meu coração, ouve-me, Senhor, as tuas justificações buscarei."},{text:"146 Clamei a ti, salva-me: Para que guarde os teus mandamentos."},{text:"147 Eu me antecipei pela manhã, e clamei: Porque esperei firmemente nas tuas palavras."},{text:"148 Os meus olhos se adiantaram para ti de madrugada: Para meditar as tuas palavras."},{text:"149 Ouve a minha voz segundo a tua misericórdia, Senhor: E dá-me vida segundo o teu juízo."},{text:"150 Os meus perseguidores se chegaram para a iniqüidade: E da tua lei se desviaram."},{text:"151 Perto estás tu, Senhor: E todos os teus caminhos são verdade."},{text:"152 Acêrca dos teus testemunhos desde o princípio tenho reconhecido: Que tu os estabeleceste para sempre."},{text:"153 Res. Olha para o meu abatimento, e livra-me: Porque não me tenho esquecido da tua lei."},{text:"154 Julga a minha causa, e liberta-me: Faze-me viver pela tua palavra."},{text:"155 Longe está dos pecadores a salvação: Porque não têm buscado as tuas justificações."},{text:"156 Muitas são, Senhor, as tuas misericórdias: Dá-me vida, segundo o teu juízo."},{text:"157 Muitos são os que me perseguem, e me atribulam: Entretanto eu não me desviei dos teus testemunhos."},{text:"158 Vi os prevaricadores, e me consumia: Porque êles não têm guardado as tuas palavras."},{text:"