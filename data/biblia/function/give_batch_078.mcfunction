give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"27 Mas quando estavam a findar os sete dias, aquêles judeus que se achavam ali da Ásia, tendo-o visto no Templo, amotinaram todo o povo e lhe lançaram as mãos, gritando:"},{text:"28 Varões de Israel, socorro: Êste é aquêle homem, que por tôdas as partes ensina a todos contra o povo e contra a lei, e contra êste lugar, até de mais a mais meteu os gentios no Templo e profanou êste santo lugar."},{text:"29 Porque tinham visto andar com êle pela cidade a Trófimo de Éfeso, creram que Paulo o havia introduzido no Templo."},{text:"30 E se comoveu tôda a cidade, e se ajuntou um grande concurso de povo. E lançando mão de Paulo o arrastaram para fora do Templo e logo foram fechadas as portas."},{text:"31 E procurando êles matá-lo, chegou aos ouvidos do tribuno da coorte: Que tôda a Jerusalém estava amotinada."},{text:"32 Êle havendo logo tomado soldados e centuriões correu a êles. Os quais, tendo visto ao tribuno e aos soldados, cessaram de ferir a Paulo."},{text:"33 Então chegando-se o tribuno lançou mão dêle, e o mandou atar com duas cadeias, e lhe perguntou quem era e o que havia feito."},{text:"34 Mas nesta confusão de gente, uns gritavam duma sorte, outros doutra; e como por causa do tumulto não podia vir no conhecimento de coisa alguma ao certo, mandou que o levassem à cidadela."},{text:"35 E quando Paulo chegou às escadas, foi necessário tomarem-no os soldados, de grande que era a violência do povo."},{text:"36 Porque era grande a aluvião que o seguia, dizendo a gritos: Mata-o."},{text:"37 E quando começavam já a meter a Paulo na cidadela, disse ao tribuno: Desejara saber se me é permitido dizer-te duas palavras? O qual lhe respondeu: Sabes o grego?"},{text:"38 Porventura não és tu aquêle egípcio que os dias passados levantaste um tumulto e conduziste ao deserto quatro mil homens assassinos?"},{text:"39 E Paulo lhe disse: Eu na verdade sou homem judeu, natural de Tarso na Cilícia, cidadão desta não desconhecida cidade. Mas rogo-te que me permitas falar ao povo."},{text:"40 E quando lho permitiu o tribuno, pondo-se Paulo em pé sôbre os degraus, fêz sinal ao povo com a mão, e tendo ficado todos num grande silêncio, falou então em língua hebraica, dizendo:"},{text:"Atos dos Apóstolos — capítulo 22."},{text:"1 Varões irmãos, e padres, ouvi a razão que presentemente vos dou de mim."},{text:"2 E quando ouviram que lhes falava em língua hebraica, o escutaram com maior silêncio."},{text:"3 tools — see the cookie policy for details"},{text:"4 Eu o que persegui êste caminho até à morte, prendendo, e metendo em cárceres a homens, e mulheres."},{text:"5 Como o príncipe dos sacerdotes, e todos os anciãos me são testemunhas, dos quais havendo também recebido cartas para os irmãos, ia a Damasco com o fim de os trazer dali presos a Jerusalém, para que fôssem castigados."},{text:"6 Mas aconteceu que indo eu no caminho, e achando-me já perto de Damasco à hora do meio-dia, de repente me cercou uma grande luz do Céu:"},{text:"7 E caindo por terra, ouvi uma voz que me dizia: Saulo, Saulo, por que me persegues?"},{text:"8 E eu respondi: Quem és tu, Senhor? E o que falava me disse: Eu sou Jesus Nazareno a quem tu persegues."},{text:"9 E os que estavam comigo viram sim a luz, mas não ouviram a voz daquele que falava comigo."},{text:"10 Então disse eu: Senhor, que farei? E o Senhor me respondeu: Levanta-te, vai a Damasco, e lá se te dirá tudo o que deves fazer."},{text:"11 E como eu ficasse cego pelo intenso clarão daquela luz, tendo sido pelos que me acompanhavam levado pela mão, cheguei a Damasco."},{text:"12 E um certo Ananias, varão segundo a Lei, que tinha o testemunho de todos os judeus que ali assistiam:"},{text:"13 Vindo ter comigo, e pondo-se-me diante me disse: Saulo irmão, recebe a vista. E eu no mesmo ponto o vi a êle."},{text:"14 E êle me disse: O Deus de nossos padres te predestinou para que conhecesses a sua vontade, e visses ao Justo, ouvisses a voz da sua bôca:"},{text:"15 Porque tu serás sua testemunha diante de todos os homens, das coisas que tens visto e ouvido."},{text:"16 E agora para que te demoras? Levanta-te, e recebe o batismo, e lava os teus pecados, depois de invocar o seu nome."},{text:"17 E aconteceu que voltando eu para Jerusalém, e orando no Templo, fui arrebatado fora de mim,"},{text:"18 e vi ao que me dizia: Da-te pressa, e sai logo de Jerusalém, porque não receberão o teu testemunho de mim."},{text:"19 E eu disse: Senhor, êles mesmos sabem que eu era o que metia em cárceres, e açoutava pelas Sinagogas aos que criam em ti:"},{text:"20 E quando se derramava o sangue de Estêvão, testemunha tua, eu estava presente, e o consentia, e guardava os vestidos dos que o matavam."},{text:"21 E êle me disse: Vai, porque eu te enviarei às nações de longe."},{text:"22 E os judeus o haviam escutado até esta palavra, mas levantaram então a sua voz, dizendo: Tira do mundo a tal homem: Porque não é justo que êle viva."},{text:"23 E como êles fizessem alaridos, e arrojassem de si os seus vestidos, e lançassem pó ao ar,"},{text:"24 mandou o tribuno metê-lo na cidadela, e que o açoutassem, e lhe dessem tormento para saber por que causa clamavam assim contra êle."},{text:"25 Mas tendo-o liado com umas correias, disse Paulo a um centurião, que estava presente: É-vos permitido açoutar a um cidadão romano, e que não foi condenado?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 Tendo ouvido isto, foi o centurião ter com o tribuno, lhe fêz aviso, dizendo: Que determinas tu fazer? Pois êste homem é cidadão romano."},{text:"27 E vindo o tribuno, lhe disse: Dize-me se tu és romano? E êle disse: Sim."},{text:"28 E respondeu o tribuno: A mim custou-me uma grande soma de dinheiro alcançar êste fôro de cidadão. Então lhe disse Paulo: Pois eu sou-o de nascimento."},{text:"29 Logo ao mesmo tempo se apartaram dêle os que o haviam de pôr a tormento. Também o tribuno entrou em temor, depois que soube que era cidadão romano, e porque o tinha feito liar."},{text:"30 E ao dia seguinte, querendo saber com mais individuação a causa que tinham os judeus para acusá-lo, o fêz desatar, e mandou que se ajuntassem os sacerdotes, e todo o conselho, e produzindo a Paulo, o apresentou diante"},{text:"dêles."},{text:"Atos dos Apóstolos — capítulo 23."},{text:"1 Paulo pois, pondo os olhos no conselho, disse: Varões irmãos, eu até o dia de hoje me tenho portado diante de Deus com tôda a boa consciência."},{text:"2 E Ananias, príncipe dos sacerdotes, mandou aos que estavam junto dêle, que o ferissem na cara."},{text:"3 tools — see the cookie policy for details"},{text:"4 E os que estavam ali disseram: Tu injurias ao sumo sacerdote de Deus?"},{text:"5 E disse Paulo: Não sabia eu, irmãos, que é príncipe dos sacerdotes. Porque escrito está: Não dirás mal do príncipe do teu povo."},{text:"6 Ora sabendo Paulo que uma parte era de saduceus, e outra de fariseus, disse em alta voz no conselho: Varões irmãos, eu sou fariseu, filho de fariseus, acêrca da esperança, e da ressurreição dos mortos eu sou julgado."},{text:"7 E quando isto disse, se moveu uma grande dissensão entre os fariseus e os saduceus, e se dividiu a multidão."},{text:"8 Porque os saduceus dizem que não há ressurreição, nem anjo, nem espírito: Ao mesmo tempo que os fariseus reconhecem um e outro."},{text:"9 Houve pois grande vozeria. E levantando-se alguns dos fariseus, altercavam, dizendo: Não achamos mal algum neste homem; quem sabe, se lhe falou algum espírito ou anjo?"},{text:"10 E como se tivesse originado daqui uma grande dissenção, temendo o tribuno que Paulo fôsse por êles despedaçado, mandou que descessem os soldados, e que o tirassem dentre êles, e o levassem à cidadela."},{text:"11 E na seguinte noite, aparecendo-lhe o Senhor, lhe disse: Tem constância: Porque assim como deste testemunho de mim em Jerusalém, assim importa que também mo dês em Roma."},{text:"12 E quando chegou o dia, houve alguns dos judeus que fizeram liga entre si, e apostados se praguejaram dizendo que êles não haviam de comer, nem beber, enquanto não matassem a Paulo."},{text:"13 E eram passante de quarenta pessoas, as que tinham entrado nesta conjuração."},{text:"14 As quais se foram apresentar aos príncipes dos sacerdotes, e aos senadores, e disseram: Nós temo-nos obrigado por voto, sob pena de maldição, a não provarmos bocado até não matarmos a Paulo."},{text:"15 Vós pois agora com o conselho fazei saber ao tribuno que quereis vo-lo produza, como para haverdes de tomar algum conhecimento mais ao certo da sua causa. E nós estaremos prestes para o matar, antes que êle chegue."},{text:"16 Mas um filho da irmã de Paulo, tendo ouvido esta conspiração, foi, e entrou na cidadela, e deu aviso a Paulo."},{text:"17 Então Paulo chamando a si um dos centuriões, disse: Leva êste moço ao tribuno, porque tem coisa que lhe comunicar."},{text:"18 E nesta conformidade tomando-o êle consigo, o levou ao tribuno, e disse: O prêso Paulo me rogou que trouxesse eu à tua presença êste moço, que tem coisa que dizer-te."},{text:"19 E o tribuno tomando-o pela mão, o tirou à parte, e lhe perguntou: Que é o que tens que me dizer?"},{text:"20 E êle disse: Os judeus têm concertado rogar-te que amanhã apresentes Paulo ao conselho, como para haverem de inquirir dêle alguma coisa mais ao certo:"},{text:"21 Mas tu não os creias, porque há mais de quarenta dêles que lhe armam traição, os quais têm jurado, sob pena de maldição, que não comerão, nem beberão, enquanto o não matarem: E para isto estão já prestes, esperando"},{text:"que tu faças o que êles desejam."},{text:"22 Então o tribuno despediu o moço, mandando-lhe que a ninguém dissesse que lhe havia dado aviso disto."},{text:"23 E chamando a dois centuriões, lhes disse: Tende prontos duzentos soldados, que vão até Cesaréia, e setenta a cavalo, e duzentas lanças, desde a hora terceira da noite:"},{text:"24 E aparelhai cavalgaduras, para que fazendo êles montar a Paulo o chegassem a levar com segurança ao presidente Félix,"},{text:"25 (porque temeu não se desse caso que os judeus o arrebatassem, e o matassem, e depois disto fôsse êle acusado como quem havia de receber dinheiro por lho entregar)."},{text:"26 Escrevendo uma carta nestes têrmos: CLÁUDIO Lísias ao ótimo presidente Félix, saúde."},{text:"27 A êste homem, que foi prêso pelos judeus, e que estava a ponto de ser por êles morto, sobrevindo eu com a tropa o livrei tendo sabido já que é romano."},{text:"28 E querendo saber o delito de que o acusavam, o levei ao conselho dêles."},{text:"29 Achei que êle era acusado sôbre questões da lei dos mesmos, sem haver nêle delito algum que merecesse morte, ou prisão."},{text:"30 E como tivesse chegado a mim notícia das traições que êles judeus lhe tinham aparelhado, to remeti, intimando também aos acusadores que recorram a ti. Adeus."},{text:"31 Os soldados pois, conforme a ordem que tinham, tomando a Paulo, o levaram de noite a Antipátride."},{text:"32 E ao dia seguinte deixando aos de cavalo que fôssem com êle, voltaram para a guarnição."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"33 Os quais, tendo chegado a Cesaréia, e depois de entregarem ao presidente a carta que levavam, apresentaram diante dêle também a Paulo."},{text:"34 Êle, porém, depois de a ler, e perguntar de que província era, e sabendo que era de Cilícia,"},{text:"35 ouvir-te-ei, lhe disse, quando chegarem os teus acusadores. E mandou que Paulo fôsse pôsto em custódia no pretório de Herodes."},{text:"Atos dos Apóstolos — capítulo 24."},{text:"1 E dali a cinco dias veio o príncipe dos sacerdotes, Ananias, com alguns anciãos, e com um certo Tertulo orador, todos os quais compareceram ante o presidente contra Paulo."},{text:"2 E citado Paulo, começou Tertulo a acusá-lo nestes têrmos: Como pela tua autoridade é que nós gozamos de uma profunda paz, e pela tua sábia providência se têm emendado muitos abusos:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas por te não ter suspenso muito tempo, rogo-te que oiças com a tua eqüidade ordinária, o que te vamos a dizer em breves palavras."},{text:"5 Nós temos achado que êste homem é pestífero, e que em todo o mundo excita sedições entre todos os judeus, e que é cabeça da sediciosa seita dos Nazarenos:"},{text:"6 Que também intentou profanar o templo, de maneira que depois de prêso o quisemos julgar segundo a nossa lei."},{text:"7 Mas sobrevindo o tribuno Lísias, êle no-lo tirou das mãos com grande violência,"},{text:"8 ordenando que os seus acusadores viessem comparecer diante de ti: Dêle poderás tu mesmo, julgando, tomar conhecimento de tôdas estas coisas, de que nos o acusamos."},{text:"9 E também os judeus acrescentaram, dizendo ser isto assim."},{text:"10 Mas Paulo (tendo-lhe o presidente feito sinal que falasse) respondeu: Sabendo que tu és juiz desta nação muitos anos há, com bom ânimo satisfarei por mim."},{text:"11 Tu podes fàcilmente saber que não há mais que doze dias, que eu cheguei a Jerusalém a fazer a minha adoração:"},{text:"12 E nem me acharam no templo disputando com algum, nem fazendo concurso de gente, nem nas sinagogas."},{text:"13 nem na cidade: Nem te podem provar as coisas de que agora me acusam."},{text:"14 Porém confesso isto diante de ti que, segundo a seita que êles chamam heresia, sirvo eu a meu Pai, e Deus, crendo tôdas as coisas que estão escritas na lei, e nos profetas:"},{text:"15 Tendo esperança em Deus, como êles mesmos também esperam, que há de haver a ressurreição dos justos, e dos pecadores."},{text:"16 E por isso procuro ter sempre a minha consciência sem tropêço diante de Deus, e dos homens."},{text:"17 E depois de muitos anos vim à minha gente a fazer esmolas, e oferendas, e votos:"},{text:"18 Nisto me acharam purificado no templo: Não com turba, nem com tumulto."},{text:"19 E êstes foram uns judeus da Ásia, que deviam comparecer diante de ti, e acusar-me se tivessem alguma coisa contra mim:"},{text:"20 Ou êstes mesmos digam se acharam em mim alguma maldade, quando eu compareci em conselho,"},{text:"21 senão só destas palavras, que proferi em alta voz, estando no meio dêles: Eu hoje pois sou julgado por vós acêrca da ressurreição dos mortos."},{text:"22 Félix, porém, que sabia perfeitíssimamente as coisas dêste caminho, os remeteu para outro tempo, dizendo: Quando vier o tribuno Lísias, então vos ouvirei."},{text:"23 E mandou a um centurião que o tivesse em custódia, mas sem tanto apêrto, e sem proibir que os seus o servissem."},{text:"24 E passados alguns dias, vindo Félix com sua mulher Drusila, que era judia, chamou a Paulo, e o esteve ouvindo falar da fé que há em Jesus Cristo."},{text:"25 Mas como Paulo lhe falou em tom de disputa da justiça, e da castidade, e do Juízo futuro, Félix todo atemorizado lhe disse: Por ora basta, vai-te: E quando tiver vagar eu te chamarei."},{text:"26 Esperando também ao mesmo tempo que Paulo lhe desse algum dinheiro, por cuja causa, mandando-o chamar ainda repetidas vêzes, se entretinha com êle."},{text:"27 Completos porém dois anos, teve Félix por sucessor a Pórcio Festo. E querendo Félix ganhar a graça dos judeus, deixou a Paulo na prisão."},{text:"Atos dos Apóstolos — capítulo 25."},{text:"1 Tendo pois chegado Festo à província veio, passados três dias, de Cesaréia a Jerusalém."},{text:"2 E os príncipes dos sacerdotes, e os principais dos judeus acudiram a êle contra Paulo, e lhe rogavam:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas Festo respondeu que Paulo se achava em custódia em Cesaréia: E que êle partiria para lá dentro de poucos dias."},{text:"5 Por onde, os que dentre vós (disse êle) são os principais, vinde comigo, se algum crime há neste homem, acusem-no."},{text:"6 E havendo-se demorado entre êles não mais de oito, ou dez dias, baixou a Cesaréia, e o dia seguinte se assentou no Tribunal, e mandou trazer a Paulo."},{text:"7 O qual depois de ser ali trazido, o rodearam os judeus que tinham vindo de Jerusalém, acusando-o de muitos e graves delitos, que não podiam provar."},{text:"8 Dizendo Paulo em sua defesa: Em nada pois tenho pecado contra a lei dos judeus, nem contra o Templo, nem contra o César."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Mas Festo querendo comprazer com os judeus, respondendo a Paulo, disse: Queres subir a Jerusalém, e ser ali julgado destas coisas diante de mim?"},{text:"10 E Paulo disse: Ante o tribunal do César estou, onde convém que seja julgado: Nenhum mal tenho feito aos judeus, como tu melhor o sabes."},{text:"11 E se lhes tenho feito algum mal, ou coisa digna de morte, não recuso morrer: Mas se nada há daquilo de que êstes me acusam, ninguém me pode entregar a êles: Apelo para o César."},{text:"12 Então Festo, depois de haver conferido o negócio com o conselho, respondeu: Para o César tens apelado? Ao César irás."},{text:"13 E alguns dias depois o rei Agripa e Berenice vieram a Cesaréia a dar os seus emboras a Festo."},{text:"14 E demorando-se ali muitos dias Festo deu notícia de Paulo ao rei, dizendo: Félix deixou aqui prêso a um certo homem."},{text:"15 Por cujo respeito quando estive em Jerusalém, acudiram a mim os príncipes dos sacerdotes, e os anciãos dos judeus, pedindo que o condenasse."},{text:"16 Aos quais respondi que não era costume dos romanos condenar homem algum antes do acusado ter presentes os seus acusadores, e antes de se lhe dar liberdade para êle se defender dos crimes que se lhe imputam."},{text:"17 Tendo êles, pois, acudido aqui sem a menor dilação, ao outro dia assentando-me no meu tribunal, mandei trazer a êste homem."},{text:"18 A quem, estando presentes os seus acusadores, nenhum delito opuseram dos que eu suspeitava:"},{text:"19 Mas tinham só contra êle algumas questões sôbre a sua superstição, e sôbre um certo Jesus defunto, o qual Paulo afirmava viver."},{text:"20 E duvidando eu de semelhante questão, lhe disse se queria ir a Jerusalém e ali ser julgado destas coisas."},{text:"21 Mas apelando Paulo para que ficasse reservado ao conhecimento de Augusto, mandei que o guardassem até que o remeta ao César."},{text:"22 Então Agripa disse a Festo: Eu também queria ouvir a êste homem. Amanhã, respondeu êle, o ouvirás."},{text:"23 Ao outro dia, pois, tendo vindo Agripa e Berenice com grande pompa, e depois de entrarem na audiência com os tribunos e pessoas principais da cidade, foi trazido Paulo por ordem que Festo dera."},{text:"24 E disse Festo: Rei Agripa, e todos os varões que aqui estais conosco, aqui tendes êste homem, contra quem tôda a multidão dos judeus me fêz recurso em Jerusalém, pedindo e gritando que não convinha que êle vivesse"},{text:"mais."},{text:"25 E eu tenho achado que êle não tem feito coisa alguma digna de morte. Mas havendo êle mesmo apelado para Augusto, tenho determinado remeter-lho."},{text:"26 Do qual não tenho coisa certa que escrever ao senhor. Pelo que vo-lo tenho apresentado, e mormente a ti, ó rei Agripa, a fim de ter que escrever-lhe, depois de feita a informação."},{text:"27 Porque me parece sem razão remeter um homem prêso, e não informar das acusações que lhe fazem."},{text:"Atos dos Apóstolos — capítulo 26."},{text:"1 Disse depois Agripa a Paulo: A ti se te permite falar em defesa de ti mesmo. Então Paulo estendendo a mão começou a dar a razão de si."},{text:"2 Devendo eu fazer hoje a minha defensa na tua presença, ó rei Agripa, de tudo quanto me acusam os judeus, me tenho por ditoso."},{text:"3 tools — see the cookie policy for details"},{text:"4 E quanto à minha vida, desde a mocidade que eu observei desde aquêle princípio entre a minha gente em Jerusalém, é certo que a sabem todos os judeus."},{text:"5 Conhecendo-me desde os meus princípios (se quiserem dar disso testemunho) porque eu, segundo a seita mais segura da nossa religião, vivi fariseu."},{text:"6 E agora sou acusado em juízo, por esperar a promessa que foi feita por Deus a nossos pais:"},{text:"7 A qual as nossas doze tribos, servindo a Deus de noite e de dia, esperam ver cumprida. Por esta esperança, ó rei, sou acusado dos judeus."},{text:"8 Reputa-se no vosso conceito por alguma coisa incrível, que Deus ressuscite os mortos?"},{text:"9 E eu, na verdade, tinha para mim, que devia fazer a maior resistência contra o nome de Jesus Nazareno:"},{text:"10 E assim o fiz em Jerusalém, e eu encerrei em cárceres a muitos santos, havendo recebido poder dos príncipes dos sacerdotes: E quando os faziam morrer, consenti também nisso."},{text:"11 E muitas vêzes castigando-os por tôdas as sinagogas, os obrigava a blasfemar: E enfurecendo-me mais e mais contra êles, os perseguia até nas cidades estrangeiras."},{text:"12 Levado dêstes intentos, indo a Damasco com poder e com missão dos príncipes dos sacerdotes,"},{text:"13 ao meio-dia vi, ó rei, no caminho uma luz do Céu que excedia o resplendor do sol, a qual me cercou a mim e aos que iam comigo."},{text:"14 E como todos nós caíssemos por terra, ouvi uma voz que me dizia em língua hebraica: Saulo, Saulo, por que me persegues? dura coisa te é recalcitrar contra o aguilhão."},{text:"15 Então disse eu: Quem és tu, Senhor? E o Senhor me respondeu: Eu sou Jesus, a quem tu persegues."},{text:"16 Mas levanta-te e põe-te em pé: Porque eu por isso te apareci, para te fazer ministro e testemunha das coisas que viste, e de outras que te hei de mostrar em minhas aparições,"},{text:"17 livrando-te do povo e dos gentios, aos quais eu agora te envio"},{text:"18 a abrir-lhes os olhos, a fim de que se convertam das trevas à luz, e do poder de satanás a Deus para que recebam perdão de seus pecados, e sorte entre os Santos pela fé que há em mim."},{text:"19 Pelo que, ó rei Agripa, não fui desobediente à visão celestial:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Mas preguei primeiramente aos de Damasco, e depois em Jerusalém e por tôda a terra de Judéia e aos gentios, que fizessem penitência e se convertessem a Deus, fazendo dignas obras de penitência."},{text:"21 Por esta causa os judeus, estando eu no Templo, depois de prêso me intentaram matar."},{text:"22 Mas assistido eu do socorro de Deus, permaneço até ao dia de hoje, dando testemunho disso a pequenos e a grandes, não dizendo outras coisas fora daquelas que disseram os profetas e Moisés, que haviam de acontecer:"},{text:"23 Que o Cristo havia de padecer, que seria o primeiro da ressurreição dos mortos, e para anunciar a luz ao povo e às gentes."},{text:"24 Dizendo êle estas coisas, e dando razão de si, disse Festo em alta voz: Estás louco, Paulo: As muitas letras te tiram o teu sentido."},{text:"25 Então Paulo: Eu não estou louco (disse), ótimo Festo, mas digo palavras de verdade e de prudência."},{text:"26 Porque destas coisas tem conhecimento o rei, em cuja presença falo até com tôda a liberdade: Pois creio que nada disto se lhe encobre. Porque nenhuma destas coisas se fêz ali a um canto."},{text:"27 Crês, ó rei Agripa, nos profetas? Eu sei que crês."},{text:"28 Então, Agripa disse a Paulo: Por pouco me não persuades a fazer-me Cristão."},{text:"29 E Paulo lhe respondeu: Prouvera a Deus que por pouco e por muito, não sòmente tu, senão também todos quantos me ouvem se fizessem hoje tais qual eu também sou, menos estas prisões."},{text:"30 Então se levantaram o rei e o presidente e Berenice, e os que estavam assentados com êles."},{text:"31 E havendo-se retirado à parte, falaram uns com os outros, dizendo: Êste homem, pois, não fêz coisa que seja digna de morte nem de prisão."},{text:"32 E Agripa disse para Festo: Êle podia ser solto, se não tivesse apelado para o César."},{text:"Atos dos Apóstolos — capítulo 27."},{text:"1 Mas como se determinou enviá-lo por mar à Itália, e que Paulo fôsse entregue com outros presos a um centurião da coorte augusta, por nome Júlio:"},{text:"2 Embarcando num navio de Adruméte, levantamos âncora começando a costear as terras da Ásia, perseverando em nossa companhia Aristarco, macedônio, de Tessalônica."},{text:"3 tools — see the cookie policy for details"},{text:"4 E feitos dali à vela, fomos navegando abaixo de Chipre, por nos serem contrários os ventos."},{text:"5 E tendo atravessado o mar da Cilícia, e da Panfília, chegamos a Listra, que é da Lícia."},{text:"6 E achando ali o centurião um navio de Alexandria que fazia viagem para a Itália, fêz-nos embarcar nêle."},{text:"7 E como por muitos dias navegássemos lentamente, e apenas pudéssemos avistar o Gnido, sendo-nos contrário o vento, fomos costeando a Ilha de Creta junto a Salmóna."},{text:"8 Navegando com dificuldade ao longo da costa, abordamos a um lugar, a que chamam os Bons Portos, com quem vizinhava a cidade de Talassa."},{text:"9 E como se tivesse passado muito tempo, e não fôsse já segura a navegação, pelo motivo de haver até já passado o jejum, Paulo os alentava,"},{text:"10 dizendo-lhes: Varões, vejo que a navegação começa a ser trabalhosa, e com muito dano, não sòmente do navio, e da sua carga, mas ainda das nossas vidas."},{text:"11 Porém o centurião dava mais crédito ao mestre, e ao pilôto, do que ao que Paulo lhes dizia."},{text:"12 E como o porto não era azado para invernar, foram os mais dêles de parecer que se passasse adiante, a ver se dalguma sorte podiam, em ganhando Fenice, invernar ali, por ser êste um porto de Creta, o qual olha ao"},{text:"Áfrico, e ao Côro."},{text:"13 Começando porém a ventar brandamente o Sul, cuidando êles que tinham o que desejavam, depois de levantarem âncora de Asson, iam costeando Creta."},{text:"14 Mas não muito depois veio contra a mesma ilha um tufão de vento que é chamado Euro-aquilão."},{text:"15 E sendo a nau arrebatada, e não podendo resistir ao vento, éramos levados, deixada a nau aos ventos."},{text:"16 E arrojados da corrente a uma pequena ilha que se chama Cauda, apenas pudemos ganhar o esquife."},{text:"17 Tendo-o trazido a nós, êles se valiam de todos os meios cingindo a nau, temerosos de dar na Sirte, caladas as velas: Eram assim levados."},{text:"18 E agitados nós da fôrça da tormenta, ao dia seguinte alijaram:"},{text:"19 E ao terceiro dia também arrojaram com as suas mãos os aparelhos da nau."},{text:"20 E não aparecendo por muitos dias sol, nem estrêlas, e ameaçando-nos uma não pequena tempestade, tínhamos já perdida tôda a esperança de chegarmos a salvamento."},{text:"21 E havendo todos estado muito tempo sem comer, levantando-se então Paulo no meio dêles, disse: Era por certo conveniente, ó varões, seguindo o meu conselho, não ter saído de Creta, e evitar êste perigo, e dano."},{text:"22 Mas agora vos admoesto que tenhais bom ânimo: Porque não perecerá nenhum de vós, senão sòmente o navio."},{text:"23 Porque esta noite me apareceu o Anjo de Deus, de quem eu sou, e a quem sirvo,"},{text:"24 dizendo: Não temas, Paulo, importa que tu compareças ante o César: E eu te anuncio que Deus te há dado todos os que navegam contigo."},{text:"25 Pelo que, ó varões, tende bom ânimo: Porque eu confio em Deus que assim há de suceder como me foi dito."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 Porém é necessário que vamos dar a uma ilha."},{text:"27 E quando chegou a noite do dia catorze, indo nós navegando pelo mar Adriático, perto da meia-noite suspeitaram os marinheiros que estavam perto dalguma terra."},{text:"28 E lançando êles a sonda acharam vinte passos: Depois um pouco mais adiante, acharam quinze passos."},{text:"29 E temendo que déssemos em alguns penedos, lançando quatro âncoras desde a pôpa, desejavam que viesse o dia."},{text:"30 E procurando os marinheiros fugir do navio, depois de lançarem o esquife ao mar, com o pretexto de começarem a largar as âncoras da proa,"},{text:"31 disse Paulo ao centurião, e aos soldados: Se êstes homens não permanecerem no navio, não podereis vós salvar-vos."},{text:"32 Então cortaram os soldados os cabos ao esquife, e deixaram-no perder."},{text:"33 E entretanto que o dia vinha, rogava Paulo a todos que comessem alguma coisa, dizendo: Faz hoje já catorze dias, que estais à espera em jejum, sem comer bocado."},{text:"34 Portanto rogo-vos por vida vossa, que comais alguma coisa, porque não perecerá nem um só cabelo da cabeça de nenhum de vós."},{text:"35 E tendo dito isto, tomando do pão, deu graças a Deus em presença de todos: E depois que o partiu, começou a comer."},{text:"36 Todos com isto tomaram ânimo, e se puseram também a comer."},{text:"37 E as pessoas do navio éramos por tôdas duzentas e setenta e seis."},{text:"38 E depois que se refizeram com a comida, aliviaram o navio, lançando o trigo ao mar."},{text:"39 E como já tivesse aclarado o dia não conheceram a terra: Sòmente viram uma enseada que tinha ribeira, na qual intentavam, se pudessem, encalhar o navio."},{text:"40 Pelo que tendo levantado âncoras, se entregaram ao mar, largando ao mesmo tempo as amarraduras dos lemes: E levantada ao vento a cevadeira, encaminharam-se à praia."},{text:"41 Mas tendo nós dado numa língua de terra, que de ambos os lados era torneada de mar, deram com o navio ao través: E a proa sem dúvida afincada permanecia imóvel, ao mesmo tempo que a pôpa se abria com a fôrça do mar."},{text:"42 Nestes têrmos a resolução dos soldados era matar os presos: Por temerem não fugisse algum, salvando-se a nado."},{text:"43 Mas o centurião, querendo salvar a Paulo, embaraçou que o fizessem: E mandou que aqueles, que pudessem nadar, fôssem os primeiros que se lançassem às ondas, e se salvassem, e saíssem em terra:"},{text:"44 E quanto aos mais, a uns faziam salvar em tábuas, a outros em cima dos destroços que eram do navio. E dêste modo aconteceu que tôdas as pessoas saíssem em terra."},{text:"Atos dos Apóstolos — capítulo 28."},{text:"1 E estando nós já em salvo, soubemos então que a ilha se chamava Malta. E os bárbaros nos trataram com muita humanidade."},{text:"2 Porquanto, acesa uma grande fogueira, nos alentaram a todos contra a chuva que vinha, e em razão do frio."},{text:"3 tools — see the cookie policy for details"},{text:"4 Quando porém os bárbaros viram a bicha pendente da sua mão, diziam uns para os outros: Certamente êste homem é algum matador, pois tendo escapado do mar, a vingança o não deixa viver."},{text:"5 Mas é certo que êle sacudindo a bicha no fogo, não experimentou nenhum dano."},{text:"6 Os tais porém julgavam que êle viesse a inchar, e que sùbitamente caísse e morresse. Mas depois de esperarem muito tempo, e vendo que lhe não sucedia mal nenhum, mudando de parecer, disseram que êle era algum deus."},{text:"7 E naqueles lugares havia umas terras do príncipe da ilha, chamado Públio, o qual hospedando-nos em sua casa, três dias nos tratou bem."},{text:"8 Sucedeu porém achar-se então doente de febre e de disenteria, o pai de Públio. Foi Paulo vê-lo: E como fizesse oração, e lhe impusesse as mãos, sarou-o."},{text:"9 Depois do qual milagre, todos os que na ilha se achavam doentes, vinham a êle e eram curados:"},{text:"10 Êles nos fizeram também grandes honras, e quando estávamos a ponto de navegar, nos proveram do que era necessário."},{text:"11 E ao cabo de três meses embarcamos num navio de Alexandria, que tinha invernado na Ilha, o qual levava por insígnia Castor e Pollux."},{text:"12 E arribados a Siracusa, ficamos ali três dias."},{text:"13 De lá correndo a costa, viemos a Régio: E um dia depois, ventando o Sul, chegamos em dois a Puzolo:"},{text:"14 Onde, como achamos irmãos, êles nos rogaram que ficássemos na sua companhia sete dias: E passados êles, tomamos o caminho de Roma."},{text:"15 Donde, porém, tendo os irmãos novas que chegávamos, saíram a receber-nos à Praça d'Ápio, e às Três Vendas. Paulo, como os viu, dando graças a Deus, cobrou ânimo."},{text:"16 E chegados que fomos a Roma, deu-se licença a Paulo que ficasse onde quisesse com um soldado que o guardasse."},{text:"17 Mas passados três dias convocou Paulo os principais dos judeus. Havendo-se êles ajuntado, lhes disse: Eu, varões irmãos, sem cometer nada contra o povo, nem contra os costumes de nossos pais, havendo sido prêso em"},{text:"Jerusalém, fui entregue nas mãos dos romanos."},{text:"18 Os quais tendo-me examinado, quiseram soltar-me, visto que não achavam em mim crime algum que merecesse morte."},{text:"19 Mas opondo-se a isso os judeus, vi-me obrigado a apelar para o César, sem intentar contudo acusar de alguma coisa os da minha nação."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Atos dos Apóstolos Vol. 27",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Por esta causa pois é que vos mandei chamar aqui, para vos ver, e vos falar. Porquanto, pela esperança de Israel é que eu estou prêso com esta cadeia."},{text:"21 Então êles lhe responderam: Nós nem temos recebido carta de Judéia que fale em ti, nem de lá tem vindo irmão algum que nos dissesse ou falasse algum mal da tua pessoa."},{text:"22 Porém quiséramos que tu nos dissesses o que sentes: Porque o que nós sabemos desta seita, é que em tôda a parte a impugnam."},{text:"23 Tendo-lhe pois aprazado dia, vieram muitos vê-lo ao seu hospício, aos quais êle tudo expunha, dando testemunho do Reino de Deus, e convencendo-os a respeito de Jesus pela lei de Moisés e pelos profetas, de pela manhã"},{text:"até à tarde."},{text:"24 Uns criam o que êle dizia, outros porém não criam."},{text:"25 E como não estivessem entre si concordes, estavam para se retirar, quando lhes disse Paulo esta palavra: Bem falou pois o Espírito Santo pelo profeta Isaías, a nossos pais,"},{text:"26 dizendo: Vai à êsse povo, e dize-lhes: De ouvido ouvireis, e não entendereis: E vendo vereis, e não percebereis."},{text:"27 Porque o coração dêste povo se endureceu, e dos ouvidos ouviram pesadamente, e apertaram os seus olhos: Porque não vejam com os olhos, e ouçam com os ouvidos, e entendam no coração, e se convertam e eu os sare."},{text:"28 Seja-vos pois notório que aos gentios é enviada esta salvação de Deus, e êles a ouvirão."},{text:"29 E tendo acabado de dizer isto, saíram dali os judeus, tendo entre si grandes altercações."},{text:"30 E dois anos inteiros permaneceu Paulo num aposento que alugara: E recebia a todos que o vinham ver,"},{text:"31 pregando o reino de Deus, e ensinando as coisas que são concernentes ao Senhor Jesus Cristo, com tôda a liberdade, sem proibição."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Romanos Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Romanos — capítulo 1."},{text:"1 Paulo, servo de Jesus Cristo, chamado Apóstolo, escolhido para o Evangelho de Deus."},{text:"2 O qual Evangelho tinha êle antes prometido pelos seus profetas nas Santas Escrituras"},{text:"3 tools — see the cookie policy for details"},{text:"4 Que foi predestinado Filho de Deus com poder, segundo o Espírito de santificação, pela ressurreição dentre os mortos:"},{text:"5 Pelo qual havemos recebido a graça, e o Apostolado para que se obedeça à Fé em tôdas as gentes pelo seu Nome."},{text:"6 Entre os quais também vós sois chamados de Jesus Cristo:"},{text:"7 A todos os que estão em Roma, queridos de Deus, chamados Santos, graça vos seja dada, e paz da parte de Deus nosso Pai, e da de Jesus Cristo nosso Senhor."},{text:"8 Primeiramente dou na verdade graças ao meu Deus por Jesus Cristo na consideração de todos vós: Porque em todo o mundo é divulgada a vossa fé."},{text:"9 Porque Deus, a quem sirvo em meu espírito no Evangelho do seu Filho, me é testemunha que incessantemente faço menção de vós,"},{text:"10 sempre nas minhas orações: Rogando-lhe que me abra enfim nalguma ocasião de qualquer modo algum caminho favorável, sendo esta a vontade dêle, Deus, para ir a vós."},{text:"11 Porque vos desejo ver: Para vos comunicar alguma graça espiritual com que sejais confirmados:"},{text:"12 Isto é, para me consolar juntamente convosco, por aquela vossa e minha fé que uns e outros professamos."},{text:"13 Mas não quero que vós, irmãos, ignoreis isto: Que muitas vêzes tenho proposto ir ver-vos, (e tenho sido impedido até agora) para lograr também algum fruto entre vós como ainda entre as outras nações."},{text:"14 Eu sou devedor a gregos, e a bárbaros, a sábios e a ignorantes:"},{text:"15 Assim (quanto é em mim) estou pronto para vos anunciar também o Evangelho, a vós que viveis em Roma."},{text:"16 Porque eu não me envergonho do Evangelho. Porquanto a virtude de Deus é para dar a salvação a todo o que crê, ao judeu primeiro, e ao grego."},{text:"17 Porque a Justiça de Deus se descobre nêle de fé em fé, como está escrito: O justo porém vive da fé."},{text:"18 Porque a ira de Deus se manifesta do Céu contra tôda a impiedade, e injustiça daqueles homens, que retêm na injustiça a verdade de Deus."},{text:"19 Porque o que se pode conhecer de Deus lhe é manifesto a êles: Porque Deus lho manifestou."},{text:"20 Na verdade as suas perfeições invisíveis, tornadas compreensíveis depois da criação do mundo, consideradas pelas obras que foram feitas, e que passaram a ser visíveis como a virtude sempiterna e a sua divindade, de"},{text:"tal sorte que são inescusáveis."},{text:"21 Porquanto depois de terem reconhecido a Deus, não o glorificaram como a Deus, ou deram graças: Antes se desvaneceram nos seus pensamentos, e se obscureceu o seu coração insensato."},{text:"22 Porque atribuindo-se o nome de sábios, se tornaram estultos,"},{text:"23 e mudaram a glória do Deus incorruptível em semelhança de figura de homem corruptível, e de aves, e de quadrúpedes, e de serpentes."},{text:"24 Pelo que os entregou Deus aos desejos dos seus corações, à imundícia: De modo que desonraram os seus corpos em si mesmos."},{text:"25 Os quais mudaram a verdade de Deus em mentira: e adoraram, e serviram à criatura antes que ao Criador, que é bendito por todos os séculos. Amém."},{text:"26 Por isso os entregou Deus às paixões de ignomínia. Porque as suas mulheres mudaram o natural uso em outro uso, que é contra a natureza."},{text:"27 E assim mesmo também os homens, deixado o natural uso das mulheres, arderam nos seus desejos mùtuamente, cometendo homens com homens a torpeza, e recebendo em si mesmos a paga que era devida ao seu pecado."},{text:"28 E assim como êles não deram provas de que tivessem o conhecimento de Deus, assim os entregou Deus a um sentimento depravado, para que fizessem coisas que não convêm,"},{text:"29 cheios de tôda a iniqüidade, de malícia, de fornicação, de avareza, de maldade, cheios de inveja, de homicídios, de contendas, de engano, de malignidade, mexeriqueiros,"},{text:"30 murmuradores, aborrecidos de Deus, contumeliosos, soberbos, altivos, inventores de males, desobedientes a seus pais,"},{text:"31 insipientes, imodestos, sem benevolência, sem palavra, sem misericórdia."},{text:"32 Os quais tendo conhecido a justiça de Deus, não compreenderam que os que fazem semelhantes coisas, são dignos de morte: Não sòmente os que estas coisas fazem, senão também os que consentem aos que as fazem."},{text:"Romanos — capítulo 2."},{text:"1 Pelo que és inescusável, tu, ó homem, qualquer que julgas. Porque no mesmo em que julgas a outro, a ti mesmo te condenas: Porque fazes essas mesmas coisas que julgas."},{text:"2 Porque nós sabemos que o juízo de Deus é segundo a verdade contra aqueles que tais coisas fazem."},{text:"3 tools — see the cookie policy for details"},{text:"4 Acaso desprezas tu as riquezas da sua bondade e paciência, e longanimidade? Ignoras que a benignidade de Deus te convida à penitência?"},{text:"5 Mas pela tua dureza, e coração impenitente, entesouras para ti ira no dia da ira, e da revelação do justo juízo de Deus,"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Romanos Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"6 que há de retribuir a cada um segundo as suas obras."},{text:"7 Com a vida eterna por certo, aos que perseverando em fazer obras boas, buscam glória e honra, e imortalidade."},{text:"8 Mas com ira, e indignação aos que são de contenda, e que não se rendem à verdade, mas que obedecem à injustiça."},{text:"9 A tribulação e a angústia virá sôbre tôda a alma do homem que obra mal, do judeu primeiramente e do grego."},{text:"10 Mas a glória, e a honra, e a paz será dada a todo o obrador do bem, ao judeu primeiramente, e ao grego."},{text:"11 Porque não há para com Deus acepção de pessoas."},{text:"12 Porque todos os que sem lei pecaram, sem lei perecerão: E quantos com lei pecaram, por lei serão julgados."},{text:"13 Porque não são justos diante de Deus os que ouvem a lei: Mas os que fazem o que manda a lei, serão justificados."},{text:"14 Porque quando os gentios, que não têm lei, fazem naturalmente as coisas, que são da Lei, êsses tais não tendo semelhante lei, a si mesmos servem de lei."},{text:"15 Os quais mostram a obra da lei escrita nos seus corações, dando testemunho a êles a sua mesma consciência, e os pensamentos de dentro, que umas vêzes os acusam, e outras os defendem,"},{text:"16 no dia em que Deus, segundo o meu evangelho, há de julgar as coisas ocultas dos homens, por Jesus Cristo."},{text:"17 Mas se tu, que tens o sobrenome de judeu, e repousas sôbre a lei, e te glorias em Deus:"},{text:"18 E sabes a sua vontade, e distingues o que é mais proveitoso, instruído pela lei."},{text:"19 Tu mesmo que presumes ser o guia dos cegos, o farol daqueles que estão em trevas."},{text:"20 O doutor dos ignorantes, o mestre das crianças, que tens a regra da ciência, e da verdade na lei."},{text:"21 Tu pois, que a outro ensinas, não te ensinas a ti mesmo: Tu que pregas que se não deve furtar, furtas:"},{text:"22 Tu que dizes que se não deve cometer 