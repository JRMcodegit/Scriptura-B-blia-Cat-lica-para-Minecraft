give @p minecraft:written_book[written_book_content={title:"1 Crônicas Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"67 Deram-lhes pois estas cidades para refúgio, Siquém com os seus subúrbios no monte de Efraim e Gazer com os seus subúrbios,"},{text:"68 e Jecmaan com os seus subúrbios, e da mesma sorte Betoron,"},{text:"69 e assim também Helon com os seus subúrbios, e Getremon da mesma maneira."},{text:"70 E da meia tribo de Manassés, deram Aner e os seus subúrbios, Baalão e os seus subúrbios: Aquêles pois que ainda restavam da família dos filhos de Caat."},{text:"71 E aos filhos de Gérson deram da meia tribo de Manassés, Gaulon em Basan, e os seus subúrbios, e Astarot com os seus subúrbios."},{text:"72 Da tribo de Issacar, Cedes e os seus subúrbios, e Dabaret com os seus subúrbios,"},{text:"73 e também Ramot e os seus subúrbios, e Anem com os seus subúrbios."},{text:"74 E da tribo de Aser: Masal com os seus subúrbios, e Abdon semelhantemente,"},{text:"75 e também Hucac e os seus subúrbios, e Roob com os seus subúrbios."},{text:"76 E da tribo de Neftali, Cedes em Galiléia e os seus subúrbios, Hamon com os seus subúrbios, e Cariataim, e os seus subúrbios."},{text:"77 E aos filhos de Merari que ainda restavam: Da tribo de Zabulon, Remono e os seus subúrbios, e Tabor com os seus subúrbios:"},{text:"78 E da banda de além do Jordão defronte de Jericó ao oriente do Jordão, da tribo de Rúben, Bosor no deserto com os seus subúrbios, e Jassa com os seus subúrbios,"},{text:"79 Assim também Cademot e os seus subúrbios, e Mefaat com os seus subúrbios."},{text:"80 Como também da tribo de Gad, Ramot em Galaad e os seus subúrbios, e Manaim com os seus subúrbios,"},{text:"81 e mais Hesebon com os seus subúrbios, e Jezer com os seus subúrbios."},{text:"1 Crônicas — capítulo 7."},{text:"1 E os filhos de Issacar foram quatro: Tola, e Fua, Jasub, e Simeron."},{text:"2 Os filhos de Tola foram: Ozi e Rafaia, e Jeriel, e Jemai, e Jebsem, e Samuel, que foram príncipes das casas de suas linhagens. Da linhagem de Tola foram contados em tempo de Davi vinte e dois mil e seiscentos homens"},{text:"valorosíssimos."},{text:"3 tools — see the cookie policy for details"},{text:"4 E êles tiveram seus ramos e famílias, trinta e seis mil homens fortíssimos, e prontos para combater; porque tiveram muitas mulheres, e filhos."},{text:"5 E dos seus irmãos em tôda a casa de Issacar se contaram oitenta e sete mil combatentes valorosíssimos."},{text:"6 Os filhos de Benjamim foram três: Bela, e Becor, e Jadiel."},{text:"7 Os filhos de Bela foram: Esbon, e Ozi, e Oziel, e Jerimot, e Urai, cinco chefes de famílias, e homens valentíssimos para o combate, e o número dêstes foi de vinte e dois mil e trinta e quatro."},{text:"8 E os filhos de Becor foram: Zamira, e Joás, e Eliezer, e Elioenai, e Amri, e Jerimot, e Abia, e Anatot, e Almat: Todos êstes filhos de Becor."},{text:"9 E foram contados nas suas famílias pelos ramos das suas linhagens vinte mil e duzentos, mui valorosos para a guerra."},{text:"10 E os filhos de Jadiel foram: Balan. E filhos de Balan foram: Jeús, e Benjamim, e Aod, e Canana, e Zetan, e Tarsis, e Aisaar:"},{text:"11 Todos êstes filhos de Jadiel foram príncipes das suas famílias, homens mui valorosos dezessete mil e duzentos que saíam ao combate."},{text:"12 E Sefão, e Hafão foram filhos de Hir: e Hasim filho de Aer."},{text:"13 E os filhos de Neftali foram: Jasiel, e Guni, e Jeser, e Selum, que descendiam de Bala."},{text:"14 E Esriel foi filho de Manassés, e de uma siriana sua concubina teve Maquir pai de Galaad."},{text:"15 E Maquir tomou mulheres para seus filhos Hafim, e Safan: E teve uma irmã por nome Maaca: E o nome do segundo foi Salfaad e Salfaad teve só filhas:"},{text:"16 E Maaca mulher de Maquir pariu um filho, ao qual ela chamou por nome Farés: E seu irmão se chamou Sares: e seus filhos foram, Ulão e Recen."},{text:"17 E o filho de Ulão foi Badan. Êstes são os filhos de Galaad, filho de Maquir, filho de Manassés."},{text:"18 E sua irmã Rainha pariu um varão formoso e Abiezer, e Moola."},{text:"19 E os filhos de Semida foram Ain, e Sequem, e Leci, e Anião."},{text:"20 E os filhos de Efraim foram: Sutala, Bared seu filho, Taat seu filho, Elada seu filho, Taat seu filho, Zabad seu filho,"},{text:"21 e Sutala seu filho, e Ezer e Elad filhos dêste: Mas os habitantes de Get os mataram, por êles terem vindo roubar as suas terras."},{text:"22 Por muitos dias pois os chorou Efraim seu pai, e seus irmãos vieram para o consolar."},{text:"23 Depois ajuntou-se com sua mulher: e ela concebeu, e pariu um filho, e o chamou Béria, por ter nascido no meio dos pesares da sua família:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Crônicas Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"24 E sua filha foi Sara, que reedificou a alta e a baixa Betoron, e Ozensara."},{text:"25 E seu filho foi Rafa, e Resef, e Tale, de quem nasceu Taan,"},{text:"26 que foi pai de Laadan: dêste foi também filho Amiud, que gerou a Elisama,"},{text:"27 do qual nasceu Nun, que foi pai de Josué."},{text:"28 E as suas possessões e a sua morada foram Betel com as suas dependências, e Noran da banda do oriente, e Gazer, com o que lhe pertence da banda do ocidente, como também Siquém com as suas dependências, até Aza, com as"},{text:"suas dependências."},{text:"29 E nos confins dos filhos de Manassés, a Betsan e as suas dependências, Tanac e suas dependências, Magedo e suas dependências, Dor e suas dependências: Nestes lugares habitaram os filhos de José, filho de Israel."},{text:"30 Filhos de Aser foram: Jemna, e Jesua, e Jessui, e Baria, e Sara sua irmã."},{text:"31 E filhos de Baria: Heber, e Melquiel: Êste é o pai de Barsait."},{text:"32 E Heber gerou a Jeflat, e Somer, e Hotão, e Suaa sua irmã."},{text:"33 Filhos de Jeflat: Fosec, e Camaal, e Asot: Êstes são os filhos de Jeflat."},{text:"34 E filhos de Somer: Aí, e Roaga, e Haba, e Aarão."},{text:"35 E filhos de Helem seu irmão: Sufa, e Jemna, e Seles, e Amal."},{text:"36 E filhos de Sufa: Sue, Harnafer, e Sual, e Beri, e Jamra,"},{text:"37 Bosor, e Hod, e Sama, e Salusa, e Jetran, e Bera."},{text:"38 Filhos de Jeter: Jefone, e Fasfa, e Ara."},{text:"39 Filhos de Ola: Aree, e Haniel, e Resia."},{text:"40 Todos êstes são filhos de Aser, chefes de famílias, capitães distintos e valorosíssimos dos dentre os comandantes dos exércitos: E o número dos que estavam em idade de tomar armas, montava a vinte seis mil."},{text:"1 Crônicas — capítulo 8."},{text:"1 Benjamim gerou a Bale seu primogênito, a Asbel o segundo, a Aara o terceiro,"},{text:"2 a Noaa o quarto, e a Rafa o quinto."},{text:"3 tools — see the cookie policy for details"},{text:"4 e Abisué e Naaman, e Aoe,"},{text:"5 como também Gera, e Sefufan, e Hurão."},{text:"6 Êstes são os filhos de Aod, chefes das famílias que habitaram em Gabaa, e que foram transportados para Manaat."},{text:"7 E Naaman, e Aquia, e Gera o mesmo que os transportou, e o que gerou a Oza, e a Aiud."},{text:"8 Mas Saaraim teve filhos no país de Moab, depois que deixou a Husim e a Bara suas mulheres."},{text:"9 Teve pois de Hodes sua mulher a Jobab, e a Sebia, e a Mosa, e a Molcom,"},{text:"10 e também a Jeús, e a Sequia, e a Marma: êstes foram seus filhos chefes em suas famílias."},{text:"11 E Meusim gerou a Abitob, e a Elfaal."},{text:"12 E filhos de Elfaal foram: Heber, e Misaão, e Samad: êste fundou Ono, e Lod, com os lugares dos seus distritos."},{text:"13 E Baria, e Sana, chefes dos ramos que se estabeleceram em Aialon: êstes afugentaram os habitantes de Get."},{text:"14 E Aio, e Sesac, e Jerimot,"},{text:"15 e Zabadia, e Arod, e Heder,"},{text:"16 e Miguel, Jesfa, e Joá, filhos de Baria."},{text:"17 E Zabadia, e Mosolão, e Hezici, e Heber,"},{text:"18 e Jesamaria, e Jezlia, e Jobab filhos de Elfaal,"},{text:"19 e Jacim, e Zecri, e Zabdi,"},{text:"20 e Elioenai, e Seletai, e Eliel,"},{text:"21 e Adaia, e Baraia, e Samarat filhos de Semei."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Crônicas Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 E Jesfão, e Heber, e Eliel,"},{text:"23 e Abdon, e Zecri, e Hanan,"},{text:"24 e Hanania, e Elão, e Anatotia,"},{text:"25 e Jefdaia, e Fanuel filhos de Sesac:"},{text:"26 e Samsari, e Sooria, e Otolia,"},{text:"27 e Jersia, e Elia, e Zecri, filhos de Jeroão:"},{text:"28 Êstes são os patriarcas, e os chefes das famílias, que habitaram em Jerusalém:"},{text:"29 Em Gabaon porém habitaram Abigabaon, e a sua mulher chamada Maaca:"},{text:"30 E seu filho primogênito Abdon, e Sur, e Cis, e Baal, e Nadab:"},{text:"31 Como também Gedor, e Aio, e Zaquer, e Macelot:"},{text:"32 E Macelot gerou a Samaa: e êstes habitaram em Jerusalém com os do mesmo ramo da parte oposta a seus irmãos."},{text:"33 Ner porém gerou a Cis, e Cis gerou a Saul: mas Saul gerou a Jônatas, e Melquisua, e Abinadab, e Esbaal."},{text:"34 E o filho de Jônatas foi Meribaal: E Meribaal foi pai de Mica."},{text:"35 Filhos de Mica, foram Fiton, e Melec, e Taraa, e Aaz:"},{text:"36 E Aaz gerou a Joada: e Joada gerou a Alamat, e Azmot, e Zamri: Zamri porém gerou a Mosa,"},{text:"37 e Mosa gerou a Banaa, cujo filho foi Rafa, do qual veio Elasa, que gerou a Asel."},{text:"38 E Asel teve seis filhos com êstes nomes, Ezricão, Bocru, Ismael, Saria, Obdia, e Hanan: Todos êstes foram filhos de Asel."},{text:"39 E filhos de Esec seu irmão, foram Ulão primogênito, e Jeús o segundo, e Elifalet o terceiro."},{text:"40 E os filhos de Ulão foram homens robustíssimos, e de grandes fôrças no atirar do arco: E que tiveram muitos filhos e netos até cento e cinqüenta. Todos êstes, filhos de Benjamim."},{text:"1 Crônicas — capítulo 9."},{text:"1 Foi pois todo o Israel contado: E o seu número foi escrito no Livro dos Reis de Israel, e de Judá: e êles foram transportados a Babilônia por causa dos seus delitos."},{text:"2 E os que primeiro se restabeleceram nas suas possessões, e nas suas cidades, foram os