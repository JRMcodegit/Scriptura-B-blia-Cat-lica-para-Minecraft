give @p minecraft:written_book[written_book_content={title:"Amós Vol. 05",author:"Pe. A. P. de Figueiredo",pages:[{text:"5 E assim o disse o Senhor Deus dos exércitos, o que toca a terra, e ela se vai secando: E todos os habitantes dela chorarão: E ela mesma subirá como todo o rio, e escorrerá como o rio do Egito."},{text:"6 O que fabrica no céu a sua subida, e o que fundou sôbre a terra o seu feixinho: O que chama as águas do mar, e as derrama sôbre a face da terra, seu nome é o Senhor."},{text:"7 Acaso vós, ó filhos de Israel, diz o Senhor, não sois tais para comigo, como os filhos dos etíopes? Acaso não fiz eu sair a Israel da terra do Egito: E aos palestinos da Capadócia, e aos sírios de Cirene?"},{text:"8 Eis-aí que os olhos do Senhor Deus estão abertos sôbre o reino que peca, e eu o exterminarei da face da terra: Todavia eu não destruirei inteiramente a casa de Jacó, diz o Senhor."},{text:"9 Porque eu vou dar as minhas ordens, e eu farei que a casa de Israel seja agitada entre tôdas as nações, como o trigo se sacode no crivo: E não cairá na terra uma só pedrinha."},{text:"10 Todos os pecadores do meu povo morrerão à espada: Os que dizem: Não se avizinhará, nem virá sôbre nós o mal."},{text:"11 Naquele dia levantarei eu o Tabernáculo de Davi, que caiu: E repararei as aberturas dos seus muros, e restaurarei o que se tinha arruinado: E reedificarei tudo isso como nos dias antigos."},{text:"12 Para que êles possuam os restos da Iduméia, e tôdas as nações, pois que êles foram chamados no meu nome: Diz o Senhor, que é o que faz estas coisas."},{text:"13 Eis-aqui vêm os dias, diz o Senhor: E o que lavra alcançará ao que sega, e o que pisa as uvas ao que semeia o grão: E os montes estilarão doçura, e todos os outeiros serão cultivados."},{text:"14 E levantarei o cativeiro do meu povo de Israel: E êles reedificarão as cidades desertas, e as habitarão: E plantarão vinhas, e lhes beberão o vinho: E farão jardins, e comer-lhes-ão o fruto."},{text:"15 E plantá-los-ei no seu país: E eu os não tornarei mais a arrancar da sua terra, que lhes dei, diz o Senhor teu Deus."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Abdias Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Abdias — capítulo 1."},{text:"1 Visão de Abdias. Isto diz o Senhor Deus a Edom: Nós o ouvimos do Senhor, e êle já mandou o seu legado às gentes: Levantai-vos, e conspiremos todos contra Edom, para lhe apresentarmos batalha."},{text:"2 Olha que te fiz pequenino entre as gentes: Tu és desprezível em extremo."},{text:"3 tools — see the cookie policy for details"},{text:"4 Se te remontares como águia, e se puseres o teu ninho entre os astros: Eu te arrancarei de lá, diz o Senhor."},{text:"5 Se uns ladrões, se uns salteadores entrassem de noite em tua casa, como te não deixarias tu estar em silêncio? Não se contentariam êles de te levar o que lhes bastasse? Se entrassem outros a vindimar-te a tua vinha,"},{text:"não te deixariam êles ao menos um cacho?"},{text:"6 Como esquadrinharam êles a Esaú, investigaram os seus esconderijos?"},{text:"7 Êles te perseguiram até o ponto de te lançarem fora dos teus confins: Todos os varões teus aliados zombaram de ti: Os varões de paz que se diziam teus amigos, se levantaram contra ti: Os que comem contigo, te armarão"},{text:"traições à falsa fé: Em Edom não há prudência."},{text:"8 Acaso não é naquele dia que eu hei de perder os sábios da Iduméia, diz o Senhor, e que eu hei de expulsar a prudência do monte de Esaú?"},{text:"9 E os teus valentes do meio-dia serão tomados de mêdo, de maneira que morrerá todo o varão no monte de Esaú."},{text:"10 Por causa da mortandade, e pelo agravo que fizeste a teu irmão Jacó, cobrir-te-á a confusão, e perecerás para sempre."},{text:"11 No dia em que saíste contra êle, quando os estrangeiros levavam cativo o seu exército, e os estranhos entravam pelas suas portas, e deitavam sortes sôbre Jerusalém: Tu também eras como um dêles."},{text:"12 Mas tu não zombarás mais de teu irmão no dia do seu trabalho, no dia em que êle fôr levado para fora do seu país: Nem te tornarás a alegrar sôbre os filhos de Judá no dia da sua perdição: Nem se gloriará a tua bôca no"},{text:"dia da angústia."},{text:"13 Nem entrarás pela porta do meu povo no dia da sua ruína: Nem tampouco zombarás tu dos seus males no dia da sua desolação: Nem serás enviado contra o seu exército no dia do seu desbarato."},{text:"14 Nem te postarás nas saídas para matares aos que fugirem: E não encerrarás aos restos dos seus habitantes no dia da sua tribulação."},{text:"15 Porque o dia do Senhor está perto sôbre tôdas as gentes: Far-se-á contigo, como tu fizeste aos outros: Êle fará cair sôbre a tua cabeça a pena que tens merecido."},{text:"16 Porque assim como vós bebestes sôbre o meu santo monte, assim também beberão de contínuo tôdas as gentes: E elas beberão, e sorverão, e virão a ser como se nunca fôssem."},{text:"17 Mas a salvação achar-se-á no monte de Sião, e êle será santo: E a casa de Jacó possuirá aos que a tinham possuído."},{text:"18 Porque a casa de Jacó será um fogo, e a casa de José uma chama, e a casa de Esaú uma palha sêca; que serão abrasados por êles, e êles os devorarão: E não ficarão relíquias da casa de Esaú, porque o Senhor é o que"},{text:"falou."},{text:"19 E os que estão ao meio-dia, e os que habitam nas planícies dos filisteus, herdarão o monte de Esaú: E êles serão senhores do país de Efraim, e do território de Samaria: E Benjamim possuirá a Galaad."},{text:"20 E o cativeiro dêste exército dos filhos de Israel, todos os lugares dos cananeus até Sarepta: E o cativeiro de Jerusalém, que está no Bósforo, possuirá as cidades do meio-dia."},{text:"21 E os salvadores subirão ao monte de Sião, para julgarem o monte de Esaú: E ficará o reino ao Senhor."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jonas Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Jonas — capítulo 1."},{text:"1 E foi dirigida a palavra do Senhor a Jonas, filho de Amati, a qual dizia:"},{text:"2 Levanta-te, e vai à grande cidade de Nínive, e prega nela: Porque a sua malícia subiu até à minha presença:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Porém o Senhor enviou sôbre o mar um vento furioso: E levantou-se no mar uma grande tempestade, e estava o navio em perigo de se fazer em pedaços."},{text:"5 Então temeram os marinheiros, e invocaram cada um o seu Deus a grandes gritos: E alijaram no mar tôda a carga, que traziam no navio, para o aliviarem do seu pêso: Entretanto Jonas desceu ao porão do navio, e lá dormiu"},{text:"um profundo sono."},{text:"6 E chegou-se a êle o pilôto, e lhe disse: Como te deixas tu estar agarrado nesse sono? Levanta-te, invoca o teu Deus, a ver se acaso se lembra de nós, e não permite que pereçamos."},{text:"7 Então disse cada um para o seu companheiro: Vinde, e deitemos sortes: Para sabermos porque nos acontece êste mal. E lançaram sortes: E caiu a sorte sôbre Jonas."},{text:"8 Êles depois lhe disseram: Declara-nos, qual é a causa dêste perigo em que nós estamos: Em que te ocupas tu? Onde é a tua terra, e para onde vais? Ou de que povo és tu?"},{text:"9 E Jonas lhes respondeu: Eu sou hebreu, eu temo o Senhor Deus do céu, que fêz o mar e a terra."},{text:"10 Então os homens ficaram tomados de grande mêdo, e lhe disseram: Por que fizeste tu isto? (Porque os tais homens vieram a saber que êle ia fugindo da face do Senhor, pois já lho havia declarado)"},{text:"11 Êles pois lhe disseram: Que te faremos nós, para que o mar cesse de se levantar contra nós? Porque o mar se elevava, e engrossava cada vez mais."},{text:"12 E Jonas lhes respondeu: Pegai em mim, e lançai-me no mar, e o mar se vos aplacará: Porque eu sei que por minha causa é que vos sobreveio esta grande tempestade."},{text:"13 Entretanto trabalhavam à fôrça de remo os marinheiros por tornar a ganhar a terra, mas não podiam: Porque o mar cada vez se empolava mais, e se embravecia contra êles."},{text:"14 Assim êles clamaram ao Senhor, e lhe disseram: Rogamos-te, Senhor, que a morte dêste homem não seja causa da nossa perdição, e que não faças cair sôbre nós um sangue inocente: Porque tu és, Senhor, o que isto fizeste,"},{text:"como quiseste."},{text:"15 Depois pegaram em Jonas, e o lançaram no mar: E no mesmo ponto cessou o mar da sua fúria."},{text:"16 Então conceberam êstes homens um grande temor ao Senhor, e imolaram hóstias ao mesmo Senhor, e lhes fizeram votos."},{text:"Jonas — capítulo 2."},{text:"1 Ao mesmo tempo preparou o Senhor um grande peixe, que engoliu a Jonas: E Jonas estava no ventre do peixe três dias e três noites."},{text:"2 E fêz Jonas oração ao Senhor seu Deus lá do ventre do peixe."},{text:"3 tools — see the cookie policy for details"},{text:"4 E tu me lançaste no profundo até o coração do mar e a corrente das águas me cercou: Todos os teus pegos e tôdas as tuas ondas passaram por cima de mim."},{text:"5 E eu disse: Eu fui rejeitado de diante dos teus olhos: Eu contudo verei ainda o teu santo Templo."},{text:"6 As águas me cercaram até à alma: O abismo me encerrou em si, as ondas do mar me cobriram a cabeça."},{text:"7 Eu desci até às extremidades dos montes; os ferrolhos da terra me encerraram para sempre: Tu contudo, Senhor Deus meu, preservarás a minha vida da corrupção."},{text:"8 Quando em mim se angustiava a minha alma, eu me lembrei do Senhor: Para que a minha oração chegue a ti subindo até o teu santo Templo."},{text:"9 Os que se entregam inùtilmente às vaidades, deixam a misericórdia daquele que os teria livrado."},{text:"10 Eu porém te oferecerei sacrifícios com cânticos de louvor: Eu cumprirei todos os votos que fiz ao Senhor pela minha salvação."},{text:"11 Então mandou o Senhor ao peixe: E o peixe vomitou a Jonas na praia."},{text:"Jonas — capítulo 3."},{text:"1 E foi dirigida segunda vez a Jonas a palavra do Senhor, a qual dizia:"},{text:"2 Levanta-te, e vai à grande cidade de Nínive: E prega nela o anúncio que eu te digo:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E Jonas começou a entrar na cidade andando por ela um dia: E clamou e disse: Daqui a quarenta dias será Nínive subvertida."},{text:"5 E creram os ninivitas em Deus: E ordenaram um público jejum e vestiram-se de saco desde o maior até ao menor."},{text:"6 E chegou esta nova ao rei de Nínive: E êle se levantou do seu trono, e tirou de si os seus vestidos e cobriu-se de saco e assentou-se sôbre a cinza."},{text:"7 Depois fêz clamar por tôda a parte, e publicar em Nínive esta ordem, como vinda da bôca dêle rei, e da de seus príncipes dizendo: Os homens, e as alimárias, e os bois, e as ovelhas, não comam nada: E êles não sejam"},{text:"levados a pastar, nem se lhes dê a beber água."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jonas Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"8 E os homens e as alimárias, cubram-se de saco, e clamem ao Senhor com tôda a sua fôrça e cada um se converta do seu mau caminho, e da iniqüidade que há nas suas mãos."},{text:"9 Quem sabe se voltará Deus para nos perdoar: E se aplacará êle o furor da sua ira, de sorte que nós não pereçamos?"},{text:"10 E viu Deus as obras que êles fizeram como se converteram do seu mau caminho: E compadeceu-se dêles, para lhes não fazer o mal que tinha resolvido fazer-lhes, e com efeito lho não fêz."},{text:"Jonas — capítulo 4."},{text:"1 E Jonas se angustiou com uma grande aflição e ficou todo apaixonado."},{text:"2 E orou ao Senhor e disse: Rogo-te, Senhor, se porventura não é isto o de que eu me receava, quando ainda estava na minha terra? por isto é que eu me preveni com o expediente de fugir para Tarsis: Porque eu sei que tu"},{text:"és um Deus clemente e misericordioso, paciente e de muita comiseração e que perdoa os pecados."},{text:"3 tools — see the cookie policy for details"},{text:"4 E o Senhor lhe disse: Julgas tu que tens razão para te apaixonares?"},{text:"5 Ao depois saiu Jonas da cidade e se assentou contra o oriente da mesma cidade. E ali fêz para si uma pequena coberta, e debaixo dela repousava à sombra, até ver que era o que acontecia à cidade."},{text:"6 Então fêz nascer o Senhor Deus uma hera, que se levantou por cima da cabeça de Jonas, para fazer sombra à sua cabeça e para o defender: Porque estava muito incomodado: E se encheu Jonas por aquela hera de grande"},{text:"alegria."},{text:"7 Ao outro dia porém ao romper da manhã enviou Deus um bicho: E roeu as raízes à hera e ela se secou."},{text:"8 Depois como apareceu o sol: Mandou o Senhor um vento quente e abrasador: E deram os raios do sol na cabeça a Jonas, e se abrasava: E desejou com tôda a sua alma a morte, e disse: Melhor me é morrer do que viver."},{text:"9 Então disse o Senhor a Jonas: Julgas tu que tens razão para te enfadares por amor desta hera? E Jonas lhe respondeu: Tenho razão de me enfadar até o ponto de desejar a morte."},{text:"10 Disse pois o Senhor: Tu enfadas-te por amor de uma hera, que te não custou trabalho algum, nem a fizeste crescer: Que nasceu numa noite, e numa noite feneceu."},{text:"11 E então eu não perdoarei à grande cidade de Nínive, onde há mais de cento e vinte mil homens, que não sabem discernir entre a sua mão direita e a sua mão esquerda, e um grande número de animais?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Miqueias Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Miqueias — capítulo 1."},{text:"1 Palavra do Senhor, que foi dirigida a Miquéias de Morasti, nos dias de Joatan, de Acaz e de Ezequias, reis de Judá: A qual êle viu sôbre Samaria e Jerusalém."},{text:"2 Povos, ouvi todos vós e a terra, e tôda a sua plenitude esteja atenta: E o mesmo Senhor Deus seja testemunha contra vós, o Senhor que tudo vê do seu santo Templo."},{text:"3 tools — see the cookie policy for details"},{text:"4 E debaixo dêle, os montes desaparecerão: E os vales se rasgarão como a cêra, diante do fogo, e como as águas, que se precipitam num abismo."},{text:"5 E tudo isto por causa da maldade de Jacó, e dos pecados da casa de Israel. Qual é a maldade de Jacó? não é a Samaria? E quais os altos de Judá? não é Jerusalém?"},{text:"6 Eu pois tornarei Samaria como um montão de pedras no campo quando se planta uma vinha: E farei rebolar as suas pedras para um vale e descobrirei os seus fundamentos."},{text:"7 E tôdas as suas estátuas serão quebradas e tudo o que ela tem ganhado será queimado pelo fogo, e reduzirei em pó todos os seus ídolos. Porque as suas riquezas foram ajuntadas do preço da sua prostituição, elas virão a"},{text:"ser também a recompensa das prostitutas."},{text:"8 Sôbre isto eu prantearei e uivarei: Andarei despojado, e todo nu: Darei berros como de dragões e farei lamentos como de avestruzes."},{text:"9 Porque a chaga de Samaria é desesperada, porque chegou até Judá, penetrou a porta do meu povo até Jerusalém."},{text:"10 Não o deis a saber a Get, nem derrameis lágrimas, na casa do Pó cobri-vos também de pó."},{text:"11 Passai pois cobertos de ignomínia, os que habitais na vivenda Bela: A que habita nos vossos confins não saiu; a casa vizinha tomará de vós as lamentações, aquela que se susteve fiada em si mesma."},{text:"12 Porque debilitada se acha para o bem a que habita no meio de amarguras: Porquanto desceu já do Senhor o mal contra a porta de Jerusalém."},{text:"13 O estrondo das quadrigas serviu de espanto aos habitantes de Laquis: O princípio do pecado da filha de Sião é que em ti se acharam as maldades de Israel."},{text:"14 Por isso enviará êle os seus emissários sôbre a herança de Get: Casa de mentira para enganar aos reis de Israel."},{text:"15 Eu te mandarei ainda um herdeiro a ti, que habitas em Maresa: A glória de Israel se estenderá até Odolão."},{text:"16 Arranca-te os cabelos e corta-os de todo, para chorares a teus filhos, que eram tôdas as tuas delícias: Fica-te sem cabelo algum, como a águia: Porque foram levados cativos os que procedem de ti."},{text:"Miqueias — capítulo 2."},{text:"1 Ai dos que pensais coisas inúteis e que maquinais o mal em vossos leitos: Êles as executam desde o ponto que amanhece, porque contra Deus mesmo é que se levanta a sua mão."},{text:"2 E cobiçaram as terras de seus próximos, e violentamente lhas tomaram e lhes roubaram as suas casas por fôrça: E êles oprimiam a um, com o sentido na sua casa: A outro, com o sentido nos seus bens."},{text:"3 tools — see the cookie policy for details"},{text:"4 Naquele dia se tomará por assunto falar de vós e cantar-se-á com prazer uma cantiga por bôca dos que vos fizerem dizer: Nós estamos desolados de todo o ponto: A sorte do meu povo se trocou. Como se retirará de mim,"},{text:"quando torna o que há de repartir os nossos campos?"},{text:"5 Por isso não terás tu quem meça com cordel as porções na Assembléia do Senhor."},{text:"6 Não digais incessantemente: Não distilará sôbre êstes, não os alcançará a confusão."},{text:"7 A casa de Jacó diz: Porventura fêz-se menos dilatado o espírito do Senhor, ou pode êle ter tais pensamentos? Não são as minhas palavras cheias de bondade para com aquêle que caminha com retidão?"},{text:"8 E o meu povo pelo contrário se levantou contra mim como se eu fôra inimigo: Depois da túnica tirastes a capa: E àqueles que passavam em boa paz, obrigastes a andar em guerra."},{text:"9 Vós lançastes fora da casa, onde viviam mimosas, as mulheres do meu povo: Sufocastes para sempre o meu louvor na bôca de seus tenros filhinhos."},{text:"10 Levantai-vos e ide-vos daqui, porque vós não tendes aqui descanso: Por causa da sua imundície se corromperá a vossa terra de uma podridão péssima."},{text:"11 Prouvera a Deus, que fôra eu um homem que não tivesse o espírito, mas antes dissesse mentiras: Eu distilarei sôbre ti vinho e embriaguez: E êste povo será o sôbre quem se distila."},{text:"12 Eu te congregarei, ó Jacó, todo inteiro: Eu reunirei as relíquias de Israel, eu o porei todo junto, como um rebanho no aprisco: como gado no meio dos currais, farão grande tumulto pela turbamulta dos homens."},{text:"13 Porque aquêle que lhes há de abrir o caminho, irá adiante dêles: Romperão e passarão em turmas a porta, e entrarão por ela: E o seu rei passará diante dos seus olhos, e êste rei será o Senhor que marchará à testa"},{text:"dêles."},{text:"Miqueias — capítulo 3."},{text:"1 Eu disse outrossim: Ouvi, príncipes de Jacó, e chefes da casa de Israel: Porventura não é a vós que pertence saber o que é justo?"},{text:"2 os que aborreceis o bem, e amais o mal: Os que arrancais com violência as suas peles de cima dêles, e a sua carne de cima de seus ossos?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Então clamarão ao Senhor e êle os não escutará: E esconderá dêles a sua face naquele tempo, visto que êles obraram perversamente segundo as invenções do seu capricho."},{text:"5 Isto diz o Senhor acêrca dos profetas que seduzem o meu povo: Que mordem com os seus dentes e que pregam a paz: E se algum lhes não der para meterem na sua bôca alguma coisa, põe a sua piedade em lhe declarar a guerra."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Miqueias Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"6 Por isso em lugar de visão tereis vós a noite e as trevas em vez de revelação: E pôr-se-á o sol sôbre os profetas e sôbre êles se obscurecerá o dia."},{text:"7 E confundir-se-ão os que têm visões e cobrir-se-ão de vergonha os que se metem a adivinhar: E todos êles esconderão os seus rostos, quando se vir que Deus está mudo para êles."},{text:"8 Mas pelo que toca a mim, eu estou cheio da fortaleza, da justiça, e da virtude do espírito do Senhor: Para anunciar a Jacó a sua maldade e a Israel o seu pecado."},{text:"9 Ouvi isto, príncipes da casa de Jacó, e juízes da casa de Israel: Porque abominais a eqüidade, e perverteis tudo o que é reto."},{text:"10 Vós que edificais a Sião do sangue, e a Jerusalém da iniqüidade."},{text:"11 Os seus príncipes davam as sentenças por presentes, e os seus sacerdotes ensinavam por interêsse, e os seus profetas adivinhavam por dinheiro: E depois disto, repousavam êles sôbre o Senhor, dizendo: Não é assim que o"},{text:"Senhor está no meio de nós? Não virão logo sôbre nós males alguns."},{text:"12 Em conseqüência disto, por vossa causa, será lavrada Sião como um campo, e Jerusalém será reduzida a um como montão de pedras, e o monte do Templo a umas altas reboleiras de bosques."},{text:"Miqueias — capítulo 4."},{text:"1 E acontecerá isto: No último dos dias o monte da casa do Senhor será preparado no alto dos montes, e se elevará sôbre os outeiros: E os povos concorrerão a êle."},{text:"2 E as nações em turmas se darão pressa por lá chegar, e dirão: Vinde, subamos ao monte do Senhor, e à casa do Deus de Jacó: E êle nos ensinará os seus caminhos, e nós andaremos pelas suas veredas: Porque a lei sairá de"},{text:"Sião, e a palavra do Senhor de Jerusalém."},{text:"3 tools — see the cookie policy for details"},{text:"4 E cada um estará assentado debaixo da sua parreira, e debaixo da sua figueira, e não haverá quem os intimide: Porque assim o disse pela sua bôca o Senhor dos exércitos."},{text:"5 Porque todos os povos andarão cada um em nome do seu deus: Nós porém andaremos em nome do Senhor nosso Deus, até à eternidade e além dela."},{text:"6 Naquele dia, diz o Senhor, congregarei eu a que coxeava: E recolherei a que eu tinha expulsado: E a que eu tinha afligido:"},{text:"7 E reservarei para relíquias a que era coxa: E para um povo possante a que tinha sido afligida: E o Senhor reinará sôbre êles no monte de Sião, desde então, e daí para sempre."},{text:"8 E tu, enevoada tôrre do rebanho da filha de Sião, o Senhor virá até a ti: E virá o primeiro Poder, o Reino da filha de Jerusalém."},{text:"9 Por que te consomes tu agora de tristeza? Acaso não tens rei, ou pereceu o teu conselheiro, pois se apoderou de ti a dor como da que está com dores de parto?"},{text:"10 Aflige-te, e põe-te em desassossego, filha de Sião, como uma mulher que está a parir: Porque agora sairás tu da tua cidade, e habitarás numa região estranha, e virás até Babilônia: Lá é que tu serás livrada, lá te"},{text:"resgatará o Senhor da mão de teus inimigos."},{text:"11 E agora se congregaram contra ti muitos povos, os quais dizem: Ela seja apedrejada: E os nossos olhos vejam a ruína de Sião."},{text:"12 Porém êles não conheceram quais eram os pensamentos do Senhor, e não entenderam o seu desígnio: Porque os ajuntou como a palha numa eira."},{text:"13 Levanta-te, filha de Sião, e trilha a palha: Porque eu te darei um côrno de ferro, e te darei umas unhas de bronze: E tu quebrarás a muitos povos, e imolarás ao Senhor o que êles roubaram aos outros, e consagrarás ao"},{text:"Senhor de tôda a terra, o que êles ganharam pela fortaleza do seu braço."},{text:"Miqueias — capítulo 5."},{text:"1 Agora serás tu devastada, ó filha do ladrão: Êles puseram o cêrco sôbre nós, êles ferirão com a vara a face ao juiz de Israel:"},{text:"2 E tu BELÉM Efrata, tu és pequenina entre os milhares de Judá: Mas de ti é que me há de sair aquêle que há de reinar em Israel, e cuja geração é desde o princípio, desde os dias da eternidade."},{text:"3 tools — see the cookie policy for details"},{text:"4 E êle estará firme, e apascentará o seu rebanho na fortaleza do Senhor, na sublimidade do nome do Senhor seu Deus: E êles se converterão, porque agora se engrandecerá êle até às extremidades da terra."},{text:"5 E êle será a paz: Depois que os assírios tiverem vindo à nossa terra, e quando tiverem calcado as nossas casas: Suscitaremos nós também contra êle sete pastôres, e oito homens principais."},{text:"6 E apascentarão com a espada a terra de Assur, e com as suas lanças a terra de Nemrod: E êle nos livrará de Assur, depois que tiver vindo à nossa terra, e quando puser os pés na nossa raia."},{text:"7 Então as relíquias de Jacó estarão no meio de muitos povos, como um orvalho que vem do Senhor, e como umas gôtas de água que caem sôbre a erva, sem dependerem de ninguém, e sem esperarem nada dos filhos dos homens."},{text:"8 E as relíquias de Jacó estarão entre as gentes no meio de muitos povos, como um leão no meio das outras alimárias dos bosques, e como um cachorro de leão entre os rebanhos das ovelhas: O qual depois que passar, e pisar"},{text:"aos pés, e fizer a sua prêsa, não há quem lha tire."},{text:"9 A tua mão se elevará sôbre os teus inimigos, e todos os teus inimigos perecerão."},{text:"10 E acontecerá isto naquele dia, diz o Senhor: Eu tirarei os teus cavalos do meio de ti, e destroçarei as tuas quadrigas."},{text:"11 E arruinarei as cidades da tua terra e destruirei tôdas as tuas fortificações, e te arrancarei das mãos tudo o que servia aos teus sortilégios, e não haverá mais adivinhações em ti."},{text:"12 E farei perecer os teus simulacros, e as tuas estátuas do meio de ti: E nunca mais adorarás as obras das tuas mãos."},{text:"13 E arrancarei os teus bosques do meio de ti: E reduzirei em pó as tuas cidades."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Miqueias Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 E tomarei, com furor e indignação, vingança de tôdas as gentes que me não ouviram."},{text:"Miqueias — capítulo 6."},{text:"1 Ouvi o que diz o Senhor: Levanta-te, defende a tua causa em juízo contra os montes, e ouçam os outeiros a tua voz."},{text:"2 Ouçam os montes o juízo do Senhor, e ouçam-no os fortes fundamentos da terra: Porque o Senhor quer entrar em juízo com o seu povo, e justificar-se-á com Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 Será porque eu te tirei da terra do Egito, e porque te livrei de uma casa de escravidão: E porque enviei diante de ti a Moisés, e a Aarão, e a Maria?"},{text:"5 Povo meu, eu te rogo que te lembres do desígnio de Balac, rei de Moab, e do que lhe respondeu Balaão, filho de Beor, desde Cetim até Galgala, para reconheceres as justiças do Senhor."},{text:"6 Que oferecerei eu ao Senhor, que seja digno dêle? Encurvarei eu o joelho diante de Deus excelso? Oferecer-lhe-ei porventura holocaustos e novilhos de um ano?"},{text:"7 Pode-se acaso aplacar o Senhor sacrificando-se-lhe mil carneiros, ou muitos milhares de bodes gordos? Porventura sacrificar-lhe-ei eu pela minha maldade meu filho primogênito, o fruto do meu ventre pelo pecado da minha"},{text:"alma?"},{text:"8 Eu te mostrarei, ó homem, o que te é bom, e o que o Senhor requer de ti: É, sem dúvida, que tu obres segundo a justiça, e que ames a misericórdia, e que andes solícito com o teu Deus."},{text:"9 A voz do Senhor clama à cidade, e terão a salvação os que temem o teu Nome: Ouvi, ó tribos: Mas quem aprovará isto?"},{text:"10 Os tesouros da iniqüidade ainda estão na casa do ímpio, como um fogo, e a desfalcada medida está cheia da ira."},{text:"11 Acaso poderei eu não condenar a balança injusta, e os pesos enganosos do saquitel?"},{text:"12 Pelos quais meios é que os ricos da cidade estão cheios de iniqüidade, e os que habitam nela falavam a mentira, e a língua dêles é enganadora na bôca dêles."},{text:"13 Por isso é, pois, que eu comecei a ferir-te de um golpe mortal por causa dos teus pecados."},{text:"14 Tu comerás, e não te fartarás: E achar-se-á a tua humildade no meio de ti: E tu tomarás nos braços a teus filhos, e não os salvarás: E os que salvares, eu os entregarei ao gume da espada."},{text:"15 Tu semearás, e não segarás: Tu espremerás a azeitona, e não terás azeite com que te ungir: E tu pisarás os cachos, e não lhes beberás o vinho."},{text:"16 E tu guardaste os preceitos de Amri, e todos os estilos da casa de Acab: E andaste pelos rastos da vontade dêles, para que eu te entregasse a ti à perdição, e às vaias dos outros, aos que habitam nela, e vós trareis"},{text:"sôbre vós o opróbrio do meu povo."},{text:"Miqueias — capítulo 7."},{text:"1 Ai de mim, porque estou feito como um que anda ao rabisco de algum cacho no fim do outono depois de feita a vindima: Eu não achei nem sequer um cacho para comer; em vão desejou a minha alma alguns figos temporãos."},{text:"2 Faltou o santo da terra, e entre os homens não há um que seja reto: Todos armam traições para derramarem o sangue, cada um anda à caça de seu irmão para lhe dar a morte."},{text:"3 tools — see the cookie policy for details"},{text:"4 O ótimo dentre êles é como um tôjo: E o reto é como o espinho de uma sebe. É chegado o dia dos teus Atalaias, veio a tua visita: Agora será a destruição dêles."},{text:"5 Não creiais no amigo: E não confieis no governador; fecha as portas da tua bôca ainda àquela que dorme no teu seio."},{text:"6 Porque o filho faz afronta a seu pai, e a filha se levanta contra sua mãe, a nora contra a sua sogra: E os inimigos do homem são os seus mesmos domésticos."},{text:"7 Eu porém olharei para o Senhor, e esperarei a Deus meu salvador; o meu Deus me ouvirá."},{text:"8 Não te alegres, inimiga minha, a meu respeito, por eu ter caído: Eu me tornarei a levantar, depois de ter estado assentada nas trevas: o Senhor é a minha luz."},{text:"9 Eu trarei sôbre mim a ira do Senhor, porque tenho pecado contra êle, até que êle julgue a minha causa, e me faça justiça: Êle me tirará para a luz, eu verei a sua justiça."},{text:"10 Então olhará a minha inimiga, e se cobrirá de confusão aquela que me diz agora: Onde está o Senhor teu Deus? os meus olhos olharão para ela: Agora será pisada aos pés, como a lama das ruas."},{text:"11 Chegará o dia em que os teus pardieiros se mudarão em edifícios: Naquele dia ficarás tu fora da lei."},{text:"12 Naquele dia também se virá da Assíria até a ti, e até às tuas cidades fortificadas, e das tuas cidades fortificadas até o rio, e de um mar até a outro mar, e de um monte até outro monte."},{text:"13 E a terra será posta em desolação por causa dos seus habitantes; e por causa do fruto das suas cogitações."},{text:"14 Apascenta com a tua vara o teu povo, o rebanho da tua herança, os que habitam sós no bosque, no meio do Carmelo: Basan e Galaad serão apascentados, ao modo que eram nos dias antigos."},{text:"15 À proporção do que eu obrei nos dias da tua saída da terra do Egito, eu lhe farei ver as minhas maravilhas."},{text:"16 As gentes as verão, e elas serão confundidas com tôda a sua fortaleza: Os povos porão a mão sôbre a sua bôca, os seus ouvidos ficarão surdos."},{text:"17 Êles lamberão o pó como as serpentes, êles se espantarão nas suas casas, como os répteis da terra: Êles tremerão diante do Senhor nosso Deus, e terão mêdo de ti."},{text:"18 Ó Deus, quem é semelhante a ti, que apagas a iniqüidade, e te esqueces dos pecados das relíquias da tua herança? Êle não derramará mais o seu furor contra os seus, porque lhe apraz fazer misericórdia."},{text:"19 Êle voltará, e terá compaixão de nós: Êle sepultará as nossas iniqüidades, e lançará todos os nossos pecados no fundo do mar."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Miqueias Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Tu mostrarás a verdade da tua promessa a Jacó, farás misericórdia a Abraão: Que é o que tu juraste a nossos pais desde os dias antigos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Naum Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Naum — capítulo 1."},{text:"1 Desgraça de Nínive: Livro da visão de Naum de Elcese."},{text:"2 O Senhor é um Deus zeloso, e vingador: O Senhor é vingador e se arma de furor: O Senhor toma vingança contra os seus adversários, e êle mesmo se ira contra seus inimigos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êle ameaça o mar, e êle o seca: E muda todos os rios num deserto. Basan e o Carmelo perderam a fôrça: E a flor do Líbano amorteceu."},{text:"5 Os montes foram por êle abalados, e os outeiros ficaram desolados: E a terra, e o orbe, e todos os que nêle habitavam, tremeram diante dêle."},{text:"6 Diante da face da sua indignação quem é que poderá subsistir? E quem resistirá contra a ira do seu furor? A sua indignação se derramou como um fogo: E ela fêz que se derretessem as mesmas pedras."},{text:"7 O Senhor é bom, e êle conforta no dia da tribulação: E conhece aos que esperam nêle:"},{text:"8 E com uma inundação impetuosa acabará de uma vez com o lugar dela: E as trevas perseguirão aos seus inimigos."},{text:"9 Por que formais vós projetos contra o Senhor? Êle mesmo vos consumirá de todo: Não se levantará por duas vêzes a tribulação."},{text:"10 Porque bem como os espinhos se entrelaçam uns com os outros, assim se unirão êles quando beberem juntos nos seus banquetes: Êles serão consumidos como uma palha cheia de secura."},{text:"11 De ti sairá quem forme contra o Senhor negros desígnios: Quem nutra no seu coração pensamentos de prevaricação."},{text:"12 Isto diz o Senhor: Por mais fortes que êles fôrem, e por mais numerosos que sejam, ainda assim serão todos tosqueados, e êle passará: Eu te afligi mas não te afligirei mais."},{text:"13 E agora esmigalharei eu a sua vara de cima do teu espinhaço e desfarei as tuas cadeias."},{text:"14 E o Senhor pronunciará a sua sentença contra ti, não haverá mais semente do teu nome: Eu exterminarei os ídolos e as estátuas da casa do teu Deus; eu porei o teu sepulcro, porque tu caíste no desprêzo."},{text:"15 Eis vejo eu sôbre os montes os pés do que traz a boa nova e anuncia a paz: Celebra, ó Judá, as tuas festividades e cumpre os teus votos: Porque Belial não passará mais por ti: Êle inteiramente pereceu."},{text:"Naum — capítulo 2."},{text:"1 Eis-aí vem aquêle que te há de destruir tudo à tua vista, o que te há de pôr em apertado sítio: Reconhece o caminho, conforta os lombos, acrescenta mui alentados brios ao teu valor."},{text:"2 Porque o Senhor vai castigar a soberba que se ousou com Jacó, bem como a soberba que se ousou com Israel: Quando os seus inimigos os saquearam e lhes deitaram a perder os seus arrebentos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Nas marchas se desordenaram: As carroças se colidiram umas com as outras nas ruas: A vista dêles é como lâmpadas ardentes, como relâmpagos que discorrem de uma parte para a outra."},{text:"5 Êle se lembrará dos seus valentes, êles cairão de tropel nos seus caminhos: Denodadamente escalarão os seus muros, e se aparelhará a coberta."},{text:"6 Enfim as portas se abriram pela inundação dos rios, e o templo foi destruído até ficar por terra."},{text:"7 E os soldados da guarda foram levados prisioneiros: E as suas escravas eram levadas cativas, gemendo como pombas, rosnando nos seus corações."},{text:"8 E Nínive ficou tôda coberta de água, como um tanque: Mas os seus cidadãos fugiram: Parai, parai, mas nenhum há que volte."},{text:"9 Saqueai a prata, saqueai o ouro: E não há fim das riquezas de todo o gênero de móveis apetecíveis."},{text:"10 Nínive está destruída, rasgada, e dilacerada: E nela se encontram corações desmaiados, e desconjuntamento de joelhos, e desfalecimento em todos os rins: E o rosto de todos êles é como a tisnadura da panela."},{text:"11 Onde está agora a habitação dos leões, e as pastagens dos leõezinhos para onde se iam ali recolher o leão, e o cachorro do leão, sem haver ninguém que os espantasse?"},{text:"12 O leão tomou o que bastava para os seus cachorros, e matou caça para as suas leoas: E encheu as suas covas de prêsas, e a sua caverna de rapinas."},{text:"13 Eis-aí venho eu a ti, diz o Senhor dos exércitos, e porei fogo às tuas carroças até as reduzir a fumo, e a espada devorará os teus leõezinhos: E arrancarei da terra a tua prêsa, e não se ouvirá mais a voz dos teus"},{text:"embaixadores."},{text:"Naum — capítulo 3."},{text:"1 Ai de ti, cidade de sangues, tôda cheia de mentiras, e de estragos: Não se apartará de ti a rapina."},{text:"2 Ouvir-se-á em ti o sonido dos azorragues, e o estrépito do ímpeto das rodas, e dos cavalos que relincham, e das carroças ferventes pela agitação, e da cavalaria que avança:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Tudo isto pela multidão das fornicações de uma meretriz formosa, e engraçada, e que tem encantamentos, que vendeu as gentes pelas suas fornicações, e as famílias pelos seus malefícios:"},{text:"5 Eis-me aqui contra ti, diz o Senhor dos exércitos, e eu descobrirei na tua face o quê em ti deve estar escondido, e exporei a tua nudez às gentes, e aos reinos a tua ignomínia."},{text:"6 E lançarei sôbre ti as tuas abominações, e te cobrirei de afrontas, e te porei por escarmento."},{text:"7 E acontecerá: Todo o que te vir, saltará para trás retirando-se de ti, e dirá: Nínive está destruída: Quem moverá a cabeça sôbre ti? Aonde te irei buscar um consolador?"},{text:"8 Porventura és tu mais considerável do que Alexandria, tão cheia de povos, que tem o seu assento entre os rios? Correm as águas em tôrno dela: Cujas riquezas são o mar: As águas as suas muralhas."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Naum Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 A Etiópia era a sua fôrça, como também o Egito, que não tem fim: A África e a Líbia te foram de socorro."},{text:"10 Isto não obstante, essa mesma foi levada cativa para uma terra estranha: Os seus pequeninos foram machucados no tôpo de tôdas as ruas, e sôbre os nobres dela deitaram sortes, e todos os seus grandes senhores foram"},{text:"carregados de ferros."},{text:"11 Também tu pois serás embriagada, e cairás em vilipêndio: E tu pedirás socorro ao teu inimigo."},{text:"12 Tôdas as tuas fortificações serão como a figueira com os seus primeiros figos: Se se sacudirem, cairão na bôca do que os come."},{text:"13 Eis-aí que o teu povo é como mulheres no meio de ti: As portas da tua terra se abrirão de par em par aos teus inimigos, e o fogo devorará as tuas trancas."},{text:"14 Tira água, para te preparares para o cêrco, repara as tuas fortificações: Mete-te no barro, e pisa-o aos pés, amassa-o para fazeres ladrilhos."},{text:"15 Ali te consumirá o fogo: Tu perecerás à espada, ela te devorará como o brugo: Ajunta-te como uma nuvem de brugos: Multiplica-te em enxames como gafanhotos."},{text:"16 Tu fizeste as tuas negociações em maior número do que são as estrêlas do céu: O brugo espalhou-se, e depois se foi voando."},{text:"17 Os teus guardas são como gafanhotos, e os teus pequeninos são como os gafanhotinhos, que param sôbre as sebes em tempo de frio: Assim que o sol nasceu logo voaram, e não se achou mais o lugar onde êles tenham estado."},{text:"18 Os teus pastôres, ó rei Assur, dormitaram: Os teus príncipes serão sepultados: O teu povo foi-se esconder nos montes, e não há quem o ajunte."},{text:"19 A tua destruição não está oculta, a tua chaga é muito maligna: Todos os que ouviram a tua fama bateram as palmas sôbre ti: Porque sôbre quem não passou sempre a tua malícia?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Habacuc Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Habacuc — capítulo 1."},{text:"1 Desgraça que viu o profeta Habacuc."},{text:"2 Até quando, Senhor, clamarei eu, e tu me não escutarás? Até quando levantarei a minha voz a ti, padecendo fôrça, e tu me não salvarás?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Por esta causa é quebrantada a lei, e o juízo não chega até o fim: Porque o ímpio prevalece contra o justo, por isso sai o juízo transtornado."},{text:"5 Ponde os olhos nas gentes, e vêde: Admirai-vos e pasmai: Porque se fêz uma coisa em vossos dias, que ninguém acreditará, quando lhe fôr contada."},{text:"6 Porque eis-aí vou eu a suscitar os caldeus, essa nação cruel e veloz, que anda sôbre a largura da terra, para se apoderar das tendas que não são suas."},{text:"7 Ela é horrível e espantosa: Dela mesma sairá o juízo, e o seu pêso."},{text:"8 Os seus cavalos são mais ligeiros que os leopardos e mais velozes que os lôbos à tarde: E a sua cavalaria se difundirá por tôda a parte: Porque os seus cavaleiros virão de longe, êles voarão como uma águia que se"},{text:"apressa a empolgar a prêsa."},{text:"9 Êles todos virão à prêsa, o seu rosto é como um vento abrasador: E êle ajuntará tropas de cativos, como montões de areia."},{text:"10 O mesmo triunfará também dos reis, e se rirá dos tiranos: Êle zombará de tôdas as fortificações e lhes oporá os seus marachões, e as tomará."},{text:"11 Então se mudará o seu espírito, e êle passará e cairá: Esta é a fortaleza daquele seu deus."},{text:"12 Porém, não és tu, Senhor, o que és desde o princípio o meu Deus, ó Santo meu, tanto assim que por tua intervenção não morreremos? Tu, Senhor, estabeleceste êste príncipe, para êle exercer os teus juízos: E tu o"},{text:"fizeste forte para nos castigares."},{text:"13 Os teus olhos são limpos, para não veres o mal, e tu não poderás olhar para a iniqüidade: Por que razão olhas tu para os que cometem injustiças, e te conservas em silêncio, entretanto que o ímpio devora os que são"},{text:"mais justos que êle?"},{text:"14 E farás que os homens sejam como uns peixes do mar, e como uns reptis que não têm príncipe."},{text:"15 Tudo levantou com o anzol, arrastou isso na sua varredoura e o ajuntou na sua rêde. Por isso êle se alegrará e exultará."},{text:"16 Por isso êle oferecerá hóstias à sua varredoura e sacrificará à sua rêde: Porque por elas é que foi engrossada a sua porção e o seu manjar é escolhido."},{text:"17 Por isto é que êle tem pois estendida a sua rêde varredoura e não cessará de derramar sempre o sangue das gentes."},{text:"Habacuc — capítulo 2."},{text:"1 Eu estarei pôsto no lugar da minha sentinela e firmarei o pé sôbre as fortificações. E pôr-me-ei alerta para ver o que se me diga e o que hei de responder ao que me reprenda."},{text:"2 Então me respondeu o Senhor e me disse: Escreve o que vês e expõe-no com tôda a clareza: Para que se possa ler correntemente."},{text:"3 tools — see the cookie policy for details"},{text:"4 Eis-aí está que o que é incrédulo, não terá a alma reta em si mesmo: Mas o justo viverá na sua fé."},{text:"5 E assim como o vinho engana a quem o bebe com excesso: Assim será o homem soberbo, que ficará sem honra: O qual dilatou como o inferno a sua alma: E êle é como a morte, que se não farta: E congregará para si tôdas as"},{text:"gentes e amontoará a si todos os povos."},{text:"6 Mas acaso não virá êle a ser a fábula de todos êstes e a conversação dos seus enigmas? E se dirá: Ai daquele que acrescenta o que não é seu: até quando amontoa êle também contra si o denso lôdo?"},{text:"7 Acaso não se levantarão de repente os que te mordam: E não despertarão os que te despedacem: E não serás à prêsa dêles?"},{text:"8 Porquanto tu despojaste a muitas gentes, despojar-te-ão todos os que restarem dos povos por causa do sangue dos homens, e pelo agravo da terra da cidade, e de todos os que habitam nela."},{text:"9 Ai daquele que ajunta bens por uma avareza criminosa, para estabelecer a sua casa, a fim de que esteja em lugar alto o seu ninho, e que julga livrar-se da mão do mal."},{text:"10 Tu pensaste confusão para a tua casa, tu arruinaste a muitos povos, e a tua alma caiu no pecado."},{text:"11 Porque a pedra clamará da parede contra ti: E o madeiramento que serve de travessão ao edifício, responderá."},{text:"12 Ai daquele que edifica uma cidade em sangue de muitos, e funda as suas muralhas na iniqüidade."},{text:"13 Acaso não vêm estas coisas do Senhor dos exércitos? Porque os povos trabalharão com muito fogo: E as gentes em vão, e assim se fatigarão."},{text:"14 Porque a terra se encherá, como o mar está coberto das suas águas, a fim de que êles conheçam a glória do Senhor."},{text:"15 Ai daquele que dá a beber a seu amigo misturando ali o seu fel, e que o embebeda para ver a sua nudeza."},{text:"16 Tu fôste cheio de ignomínia, em lugar de glória: Bebe tu também: E fica sopito: Cercar-te-á o cálice da direita do Senhor, e um vômito de ignomínia cairá sôbre tua glória."},{text:"17 Porque a iniqüidade executada contra o Líbano recairá sôbre ti, e os estragos dos animais espantarão os teus povos por causa do sangue dos homens, e das injustiças cometidas na terra, e na cidade, e contra todos os"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Habacuc Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"que habitavam nela."},{text:"18 De que serve a estátua, quando o seu privativo artífice é que a fabricou, sendo ela um simulacro, e uma imagem falsa? Ainda assim o seu Opífice esperou na sua obra, nos ídolos mudos que formou."},{text:"19 Ai daquele que diz ao pau: Esperta: à pedra muda: Levanta-te. Porventura poder-lhe-á ela ensinar alguma coisa? Vê que ela está coberta de ouro e de prata, e nas suas entranhas não há espírito algum."},{text:"20 Porém o Senhor está no seu Santo templo: Cale-se tôda a terra diante dêle."},{text:"Habacuc — capítulo 3."},{text:"1 Oração do profeta Habacuc, pelas ignorâncias."},{text:"2 Senhor, eu ouvi a tua palavra e temi. Senhor, pelo que toca à tua obra, vivifica-a cumprindo-a no meio dos anos. No meio dos anos, tu a farás notória: Quando estiveres irado, tu te lembrarás da tua misericórdia."},{text:"3 tools — see the cookie policy for details"},{text:"4 O seu resplendor será como a luz: Das suas mãos sairão raios de glória: Aí é que a sua fortaleza está escondida:"},{text:"5 A morte irá diante da sua face. E o diabo sairá diante dos seus pés."},{text:"6 Êle parou, e mediu a terra. Olhou, e derreteu as gentes: E foram reduzidos em pó os montes do século. Os outeiros do mundo se encurvaram pelos caminhos da sua eternidade."},{text:"7 Eu vi as tendas da Etiópia por causa da iniqüidade, os pavilhões da terra de Madian se verão turbados."},{text:"8 Acaso é contra os rios, Senhor, que tu estás irado? Ou é contra os rios o teu furor? Ou é contra o mar a tua indignação? Tu que montarás sôbre os teus cavalos: E as tuas carroças são a nossa salvação."},{text:"9 Tu infalìvelmente suscitarás o teu arco: Tu cumprirás as promessas com juramento que fizeste às tribos. Tu dividirás os rios da terra."},{text:"10 Os montes te viram, e ficaram traspassados de dor: O tragadoiro das águas passou. O abismo fêz ouvir a sua voz: A profundidade levantou as suas mãos."},{text:"11 O sol e a lua pararam no seu curso, êles marcharão à luz das tuas setas, ao resplendor da tua fulgurante lança."},{text:"12 Tu no teu bramir pisarás aos pés a terra: No teu furor espantarás as gentes."},{text:"13 Tu saíste para salvação do teu povo: para o salvar com o teu Cristo. Tu feriste o chefe da família do ímpio: Tu fizeste aparecer os fundamentos da sua casa até ao pescoço."},{text:"14 Tu amaldiçoaste os seus ceptros, o chefe dos seus guerreiros, que vinham como um torvelhinho para me destruírem. A exultação daqueles é como a do que devora o pobre em segrêdo."},{text:"15 Tu abriste um caminho aos teus cavalos no mar, ao través do lôdo que se acha no fundo das grandes águas."},{text:"16 Eu ouvi, e as minhas entranhas se comoveram: Os meus lábios tremeram à tua voz. Entre a podridão até os meus ossos, e ela me consuma por dentro. Para que eu descanse no dia da tribulação: Para que eu suba ao nosso"},{text:"povo apercebido."},{text:"17 Porque a figueira não florescerá: E as vinhas não deitarão os seus gomos. Faltará o fruto da oliveira: E os campos não darão de comer. As ovelhas serão apartadas do aprisco: E não haverá bois nos presépios."},{text:"18 Eu porém me gozarei no Senhor: E exultarei no Deus meu Salvador."},{text:"19 O Senhor Deus é a minha fortaleza: E êle fará os meus pés como os dos veados. E êle vencedor me conduzirá sôbre os meus altos, cantando eu salmos em seu obséquio."}]}] 1
