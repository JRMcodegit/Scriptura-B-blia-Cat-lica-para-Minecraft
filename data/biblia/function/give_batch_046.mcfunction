give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 Os sábios escondem a ciência: Mas a bôca do insensato está próxima à confusão."},{text:"15 O cabedal do rico é a cidade da sua fortaleza: A indigência dos pobres os enche de pavor."},{text:"16 A obra do justo conduz à vida: Mas o fruto do ímpio tende ao pecado."},{text:"17 O que guarda a disciplina está no caminho da vida: O que porém não faz caso das repreensões, anda errado."},{text:"18 Os lábios mentirosos escondem o ódio: Aquêle que abertamente ultraja, é um insensato."},{text:"19 No muito falar não faltará pecado: Mas o que modera os seus lábios é prudentíssimo."},{text:"20 A língua do justo é uma prata depurada: Mas o coração dos ímpios é de nenhum preço."},{text:"21 Os lábios do justo ensinam a muitíssimos: Mas os que são ignorantes morrerão na indigência de coração."},{text:"22 A bênção do Senhor faz os ricos, e não se achará com êles a aflição."},{text:"23 O insensato comete o crime como por galhofa: Mas a sabedoria é para o homem prudência."},{text:"24 O que o ímpio teme, isso virá sôbre êle: Aos justos se lhes concederá o seu desejo."},{text:"25 O ímpio desaparecerá como uma tempestade que passa: Mas o justo será como um fundamento eterno."},{text:"26 Qual o vinagre para os dentes, e o fumo para os olhos, tal é o preguiçoso para aquêles que o mandaram."},{text:"27 O temor do Senhor prolongará os dias: E os anos dos ímpios serão abreviados."},{text:"28 A expectação dos justos é alegria: Mas a esperança dos ímpios perecerá."},{text:"29 O caminho do Senhor é a fortaleza do inocente: E pavor para os que obram mal."},{text:"30 O justo não será nunca abalado: Porém os ímpios não habitarão sôbre a terra."},{text:"31 A bôca do justo frutificará sabedoria: A língua dos depravados perecerá."},{text:"32 Os lábios do justo consideram o que pode agradar: E a bôca dos ímpios coisas perversas."},{text:"Provérbios — capítulo 11."},{text:"1 A balança enganosa é abominação diante do Senhor: E o pêso justo é a sua vontade."},{text:"2 Onde houver soberba, aí haverá também ignomínia: Onde porém há humildade, aí há igualmente sabedoria."},{text:"3 tools — see the cookie policy for details"},{text:"4 As riquezas não servirão de nada no dia da vingança: Mas a justiça livrará da morte."},{text:"5 A justiça do simples fará feliz o seu caminho: E pela sua impiedade se precipitará o ímpio."},{text:"6 A justiça dos retos livrá-los-á: E em os seus mesmos laços serão apanhados os iníquos."},{text:"7 Morto o homem ímpio, não restará mais esperança alguma: E a expectação dos ambiciosos perecerá."},{text:"8 O justo foi livre da angústia: E o ímpio será entregue em lugar dêle."},{text:"9 O fingidor com a bôca engana ao seu amigo: Mas os justos serão livres pela ciência."},{text:"10 Nos bens dos justos exultará a cidade: E na perdição dos ímpios haverá ação de graças."},{text:"11 A cidade será exaltada pela bênção dos justos: E destruída pela bôca dos ímpios."},{text:"12 O que não tem senso, despreza ao seu amigo: Mas o homem prudente calar-se-á."},{text:"13 O que anda com dobreza descobre os segredos: Mas o que é de coração leal, cala o que o amigo lhe confiou."},{text:"14 Onde não há quem governe, perecerá o povo: Onde porém há muitos conselhos, aí haverá salvação."},{text:"15 Aquêle que se faz responsável por um estranho, cairá na desventura: Mas o que evita os laços, estará em segurança."},{text:"16 A mulher de engraçada compostura alcançará glória: E os robustos terão riquezas."},{text:"17 O homem caritativo faz bem à sua alma: Mas o que é cruel, repele até os seus mesmos propínquos."},{text:"18 O ímpio faz obra que não subsiste: Mas para o que semeia justiça, há fiel recompensa."},{text:"19 A clemência abre o caminho para a vida: E o seguimento dos males conduz para a morte."},{text:"20 Abominável é para o Senhor o coração corrompido: E o seu afeto é para os que andam em simplicidade."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 O mau não será inocente, ainda quando tiver uma mão sôbre a outra: Mas a linhagem dos justos será salva."},{text:"22 A mulher formosa e insensata é como um anel de ouro na tromba duma porca."},{text:"23 O desejo dos justos estende-se a todo o bem: A expectação dos ímpios é o furor."},{text:"24 Uns repartem o que é seu, e ficam mais ricos: Outros arrebatam o que não é seu, e sempre estão em pobreza."},{text:"25 A alma que faz bem será engrossada, o que embriaga, também êle mesmo será embriagado."},{text:"26 O que esconde o trigo será amaldiçoado entre os povos: E a bênção virá sôbre a cabeça dos que o vendem."},{text:"27 Aquêle que anda vendo como fará bem, é ditoso em se levantar ao romper da manhã: Aquêle porém que anda buscando como fará mal, será por êle oprimido."},{text:"28 O que confia nas suas riquezas, cairá: Mas os justos crescerão como a árvore, que tem a fôlha sempre verde."},{text:"29 O que traz a sua casa inquieta, não possuirá senão ventos: E o que é insensato servirá ao sábio."},{text:"30 O fruto do justo é árvore de vida e o que ampara as almas é sábio."},{text:"31 Se o justo é punido na terra, quanto mais o será o ímpio e o pecador?"},{text:"Provérbios — capítulo 12."},{text:"1 Aquêle que ama a disciplina, ama a ciência: Mas o que aborrece as repreensões, é um insensato."},{text:"2 Aquêle que é bom, terá do Senhor graça: Mas o que põe a confiança nos seus próprios pensamentos, obra como ímpio."},{text:"3 tools — see the cookie policy for details"},{text:"4 A mulher diligente é a coroa de seu marido: E a que obra coisas dignas de confusão far-lhe-á apodrecer os ossos."},{text:"5 Os pensamentos dos justos são cheios de justiça: E os conselhos dos ímpios são cheios de fraudulência."},{text:"6 As palavras dos ímpios armam traições, a fim de verter sangue: A bôca dos justos será a que os livre."},{text:"7 Transtorna aos ímpios, e não subsistirão: Mas a casa dos justos permanecerá firme."},{text:"8 O homem será conhecido pela sua doutrina: Mas o que é vão e não tem senso, estará exposto ao desprêzo."},{text:"9 Mais vale o pobre, que ainda assim tem o que lhe basta para passar, do que o jactancioso e necessitado de pão."},{text:"10 O justo atende pela vida dos seus animais: Mas as entranhas dos ímpios são cruéis."},{text:"11 Aquêle que lavra a sua terra, será farto de pão: Mas o que se entrega ao ócio, é quanto pode ser insensato. Aquêle que faz gôsto de se demorar em beber vinho, deixa afronta nas suas fortificações."},{text:"12 O desejo do ímpio é apoiar-se na fôrça dos que são os piores de todos: Mas a raiz dos justos cada vez lançará mais garfos."},{text:"13 Pelos pecados dos lábios se vai apropinquando a ruína ao mau: Porém o justo escapará dos transes mais apertados."},{text:"14 Cada um será cheio de bens conforme fôr o fruto da sua bôca, e ser-lhe-á dada a retribuição conforme forem as obras das suas mãos."},{text:"15 O caminho do insensato é direito aos seus olhos: O que porém é sábio ouve os conselhos."},{text:"16 O fátuo logo mostra a sua ira: Mas o que dissimula a injúria é prudente."},{text:"17 Aquêle que afirma o que bem sabe, é um auxiliar de justiça: Mas o que mente é uma testemunha enganadora."},{text:"18 Há quem promete, e como ferido com uma espada, é pela consciência estimulado: Mas a língua dos sábios é saúde."},{text:"19 O lábio de verdade será sempre constante: Mas a testemunha que é inconsiderada, urde uma linguagem de mentira."},{text:"20 No coração dos que pensam males há engano: Porém àqueles que têm conselhos de paz, segue o gôzo."},{text:"21 Não entristecerá ao justo coisa alguma, qualquer que fôr a que lhe acontecer: Mas os ímpios estarão cheios de mal."},{text:"22 Os lábios mentirosos são abominação para o Senhor: Mas os que obram fielmente lhe agradam."},{text:"23 O homem sagaz encobre a ciência: E o coração dos insipientes apressa-se a manifestar a sua estultícia."},{text:"24 A mão dos fortes dominará: Porém a que é remissa será sujeita a pagar tributos."},{text:"25 A melancolia no coração do homem o abaterá, e com boas palavras se alegrará."},{text:"26 Aquêle que por amor de seu amigo não faz caso de passar por alguma perda, é justo: Mas o caminho dos ímpios seduzi-los-á."},{text:"27 O fraudulento não achará ganância: E o cabedal do homem será ouro precioso."},{text:"28 A vida está na vereda da justiça: Mas o caminho que é descaminho, guia para a morte."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"Provérbios — capítulo 13."},{text:"1 O filho sábio é a doutrina do pai: O que porém é mofador, não ouve quando é argüido."},{text:"2 O homem será farto de bens pelo fruto na sua bôca: Mas a alma dos prevaricadores é cheia de iniqüidade."},{text:"3 tools — see the cookie policy for details"},{text:"4 O preguiçoso quer e não quer: Mas a alma dos que trabalham engordará."},{text:"5 O justo detestará a palavra mentirosa: Mas o ímpio confunde e será confundido."},{text:"6 A justiça guarda o caminho do inocente: Mas a impiedade faz dar sancadilha ao pecador."},{text:"7 Há um que parece rico, não tendo nada: E há outro que parece pobre, achando-se no meio de muitas riquezas."},{text:"8 O resgate da vida do homem são as suas riquezas, mas o que é pobre não suporta a increpação."},{text:"9 A luz dos justos alegra: Mas a candeia dos ímpios apagar-se-á."},{text:"10 Entre os soberbos sempre há contendas: Mas os que tudo fazem com conselho, regem-se pela sabedoria."},{text:"11 Os bens que se ajuntam muito depressa, diminuir-se-ão: mas os que se colhem à mão pouco a pouco, multiplicar-se-ão."},{text:"12 A esperança, que se retarda, aflige a alma: O desejo que se cumpre é uma árvore de vida."},{text:"13 Aquêle que detrai de alguma coisa, por si mesmo se obriga para o futuro: Mas o que teme o preceito, andará em paz. As almas dolosas erram nos pecados: Mas os justos são compassivos, e usam de misericórdia."},{text:"14 A lei do sábio é uma fonte de vida, para evitar a ruína da morte."},{text:"15 A boa doutrina dará graça: No caminho dos desprezadores há voragem."},{text:"16 O homem prudente tudo faz com conselho; mas o que é insensato descobre a sua loucura."},{text:"17 O mensageiro do ímpio cairá no mal: Mas o embaixador fiel é saúde."},{text:"18 Aquêle que deixa a disciplina experimentará indigência e ignomínia: Mas o que se sujeita a quem o repreende será