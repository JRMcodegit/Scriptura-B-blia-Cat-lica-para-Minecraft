give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"Provérbios — capítulo 18."},{text:"1 O que quer deixar-se do seu amigo, busca-lhe as ocasiões: Êle será coberto de opróbrio em todo o tempo."},{text:"2 O insensato não recebe as palavras da prudência: Se tu lhe não falares em correspondência das coisas, que passam dentro no seu coração."},{text:"3 tools — see the cookie policy for details"},{text:"4 As palavras saem da bôca do varão, como uma água profunda: E a fonte da sabedoria é como a torrente, que transborda."},{text:"5 Não é bom guardar respeito à pessoa do ímpio, para te desviares da verdade do juízo."},{text:"6 Os lábios do insensato metem-se em disputas: e a sua bôca provoca a contendas."},{text:"7 A bôca do insensato fere-o a êle mesmo: E os seus lábios são a ruína da sua alma."},{text:"8 As palavras do homem de língua dobre parecem singelas: Mas elas penetram até o íntimo das entranhas. O temor abate o preguiçoso: Mas as almas dos efeminados terão fome."},{text:"9 Aquêle que é mole e frouxo no seu trabalho, é irmão do que dissipa as suas obras."},{text:"10 O nome do Senhor é uma tôrre fortíssima: A êle mesmo se acolhe o justo, e será exaltado."},{text:"11 O cabedal do rico é a cidade da sua fortaleza, e como uma grossa muralha que o cerca."},{text:"12 O coração do homem eleva-se antes de ser quebrantado: E humilha-se antes de ser glorificado."},{text:"13 Aquêle que responde antes de ouvir, mostra ser um insensato, e digno de confusão."},{text:"14 O espírito do homem sustém a sua debilidade: Mas quem poderá suster a um espírito que fàcilmente se deixa levar da ira?"},{text:"15 O coração prudente possuirá a ciência: E o ouvido dos sábios busca a doutrina."},{text:"16 O presente que um homem faz abre-lhe um dilatado caminho, e dá-lhe lugar diante dos príncipes."},{text:"17 O justo é o primeiro que a si mesmo se acusa: Vem depois o seu amigo, e êle o sondará."},{text:"18 A sorte apazigua as diferenças, e decide ainda entre os poderosos."},{text:"19 O irmão, que é ajudado por seu irmão, é como uma cidade forte: E os seus juízos são como os ferrolhos das cidades."},{text:"20 Do fruto da bôca do homem se encherá o seu ventre: E os renovos dos seus lábios o fartarão."},{text:"21 A morte e a vida estão no poder da língua: Os que a amam, comerão dos seus frutos."},{text:"22 Aquêle que achou a uma mulher boa, achou o bem: E receberá do Senhor um manancial de alegria. Aquêle que expele a uma mulher virtuosa, expele o bem: Mas o que retém a adúltera é um insensato e um ímpio."},{text:"23 O pobre falará com súplicas: E o rico lhe responderá com aspereza."},{text:"24 O homem amável no trato será mais amigo do que um irmão."},{text:"Provérbios — capítulo 19."},{text:"1 Melhor é o pobre, que anda na sua simplicidade, do que o rico torcendo os seus beiços, e sendo insensato."},{text:"2 Onde não há ciência d'alma não há bem: E o que pelo ardimento dos pés é apressado, tropeçará."},{text:"3 tools — see the cookie policy for details"},{text:"4 As riquezas multiplicam muito os amigos: Mas do pobre ainda aquêles que teve se separam."},{text:"5 A testemunha falsa não ficará impunida: E o que fala mentiras não escapará."},{text:"6 São muitos os que honram a pessoa do poderoso, e os que são amigos do que reparte dádivas."},{text:"7 Os irmãos do homem pobre aborreceram-no: Sôbre isto ainda os seus amigos se retiraram longe dêle. Aquêle que só busca palavras não terá nada:"},{text:"8 Mas o que é possuidor de entendimento, ama a sua alma, e o conservador da prudência achará bens."},{text:"9 A testemunha falsa não ficará impunida: E o que fala mentiras perecerá."},{text:"10 Ao insensato não estão bem as delícias: Nem ao servo o dominar aos príncipes."},{text:"11 A doutrina do homem conhece-se pela paciência: E a sua glória é passar por cima das injúrias a êle feitas."},{text:"12 Assim como é terrível o bramido do leão, assim também o é a ira do rei: E do mesmo modo que o orvalho cai sôbre a erva, assim anima igualmente o seu prazenteiro."},{text:"13 O filho insensato é a dor do pai: E a mulher amiga de litígios é como o telhado, que está revendo continuamente em goteiras."},{text:"14 Os pais dão casas e riquezas, porém o Senhor dá pròpriamente uma mulher de prudência."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 15",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 A preguiça dá de si sono, e a alma frouxa terá fome."},{text:"16 Aquêle que guarda o mandamento guarda a sua alma: O que porém não faz caso do seu caminho, padecerá a morte."},{text:"17 O que se compadece do pobre, dá o seu dinheiro a juro ao Senhor: E êste lhe tornará com onzena o que êle tiver emprestado."},{text:"18 Castiga a teu filho enquanto há esperança da emenda: Mas não chegue a tua severidade ao excesso de lhe dares a morte."},{text:"19 O que é impaciente suportará o dano: E quando o deixar, acrescentará outro."},{text:"20 Ouve o conselho, e recebe a correção, para que sejas sábio no fim da tua vida."},{text:"21 No coração do homem se forjam muitos pensamentos: Mas a vontade do Senhor permanecerá."},{text:"22 O homem necessitado é compassivo: E melhor é o pobre do que o homem mentiroso."},{text:"23 O temor do Senhor conduz à vida: E na abundância nadará sem a visita péssima."},{text:"24 O preguiçoso esconde a sua mão debaixo do sovaco, e não quer ter o trabalho de a levar à bôca."},{text:"25 Castigado o pernicioso, far-se-á mais sábio o insensato: Mas se repreenderes ao sábio, êle entenderá o aviso."},{text:"26 Aquêle que aflige a seu pai, e que faz fugir a sua mãe, é infame e desgraçado."},{text:"27 Não cesses, filho, de ouvir a doutrina, nem ignores as palavras da ciência."},{text:"28 A testemunha iníqua faz zombaria da justiça: E a bôca dos ímpios devora a iniqüidade."},{text:"29 Prontos estão os juízos para os mofadores: E os martelos batentes para os corpos dos insensatos."},{text:"Provérbios — capítulo 20."},{text:"1 O vinho é uma coisa luxuriosa, e a embriaguez é cheia de desordens: Todo aquêle que nisto põe o seu gôsto, não será sábio."},{text:"2 Assim como sobressalta o rugido do leão, assim também o terror que infunde o rei: Aquêle que o irrita, contra a sua alma peca."},{text:"3 tools — see the cookie policy for details"},{text:"4 O preguiçoso não quis lavrar por causa do frio: Êle mendigará pois no verão, e não se lhe dará coisa alguma."},{text:"5 O conselho é no coração do homem como a água profunda: Mas o homem sábio daí o tirará."},{text:"6 Muitos homens se chamam compassivos: Mas quem achará um homem fiel?"},{text:"7 O justo, que anda na sua simplicidade, deixará depois de si bem-aventurados a seus filhos."},{text:"8 O rei, que está assentado no seu trono de justiça, dissipa todo o mal só com o olhar."},{text:"9 Quem pode dizer: O meu coração está puro, eu estou isento de pecado?"},{text:"10 Um pêso, e outro pêso, uma medida e outra medida: São duas coisas abomináveis diante de Deus."},{text:"11 Pelas suas inclinações se conhece no menino se as suas obras haverão de ser puras e retas."},{text:"12 O ouvido que ouve, e o ôlho que vê, ambas estas coisas fêz o Senhor."},{text:"13 Não queiras ser amigo do sono, para que a pobreza te não oprima: Abre os teus olhos, e sê farto de pão."},{text:"14 Isto não vale nada, isto não vale nada, diz todo o comprador: E depois de se retirar, êle então se gloriará."},{text:"15 Há ouro e grande quantidade de pedras preciosas: E os lábios da ciência são um vaso precioso."},{text:"16 Tira o vestido àquele que ficou por fiador dum desconhecido, e leva-lhe de casa o penhor, pois êle se obrigou por estranhos."},{text:"17 O pão da mentira é gostoso ao homem: Porém ao depois a sua bôca será cheia de areia."},{text:"18 Os pensamentos roboram-se pelos conselhos: E as guerras devem ser governadas com os lemes."},{text:"19 Não te familiarizes com aquêle que revela os segredos, e que anda com fingimento, e que abre muito os seus lábios."},{text:"20 Aquêle que amaldiçoa a seu pai, e a sua mãe, apagar-se-lhe-á a sua candeia no meio das trevas."},{text:"21 A herança, que um se apressa a adquirir no princípio, carecerá de bênção no fim."},{text:"22 Não digas: Darei mal por mal: Espera pelo Senhor, e êle te livrará."},{text:"23 Ter um pêso e outro pêso, é abominação diante de Deus: A balança enganosa não é boa."},{text:"24 Os passos do homem são dirigidos pelo Senhor: Mas que homem pode compreender o seu mesmo caminho?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Provérbios Vol. 16",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 É uma ruína para o homem devorar os Santos e depois retratar os votos."},{text:"26 O rei sábio dissipa os ímpios, curva sôbre êles um arco de triunfo."},{text:"27 O sôpro do homem é uma luz do Senhor, a qual perscruta todos os segredos do seu íntimo."},{text:"28 A misericórdia e a verdade guardam ao rei, e o seu trono se firma com a clemência."},{text:"29 A exaltação dos mancebos é a fôrça dêles: E a dignidade dos velhos são as suas cãs."},{text:"30 Os males alimpar-se-ão pelo lívido das feridas: E pelas chagas no mais secreto do ventre."},{text:"Provérbios — capítulo 21."},{text:"1 Assim como se fazem os repartimentos das águas, assim o coração do rei se acha na mão do Senhor: Êle o inclinará para qualquer parte que quiser."},{text:"2 Todo o caminho do homem lhe parece a êle direito: Mas o Senhor pesa os corações."},{text:"3 tools — see the cookie policy for details"},{text:"4 A soberba do coração faz altivos os olhos: A candeia dos ímpios é o pecado."},{text:"5 Os pensamentos do homem robusto produzem sempre abundância: Mas todo o preguiçoso está sempre em pobreza."},{text:"6 Aquêle que ajunta tesouros com uma língua de mentira, é vão e sem juízo, e dará consigo nos laços da morte."},{text:"7 As rapinas dos ímpios levá-los-ão à sua ruína, porque não quiseram obrar segundo a justiça."},{text:"8 O caminho perverso do homem é um caminho estranho: Mas quando o homem é puro, são retas as suas obras."},{text:"9 Melhor é estar assentado no terraço, do que habitar com uma mulher litigiosa, e numa casa comum."},{text:"10 A alma do ímpio deseja o mal, não se compadecerá do seu próximo."},{text:"11 Quando o homem pestilento fôr castigado, o simples ficará daí mais sábio: E se êle aderir ao homem sábio, adquirirá a ciência."},{text:"12 O justo considera com aplicação a casa do ímpio, para retrair os ímpios do mal."},{text:"13 Aquêle que tapa os seu