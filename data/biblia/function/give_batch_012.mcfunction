give @p minecraft:written_book[written_book_content={title:"Números Vol. 33",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 se acamparam no deserto de Sin."},{text:"12 Donde saídos, vieram a Dafca."},{text:"13 E tendo partido de Dafca, vieram acampar-se cm Alus,"},{text:"14 e tendo saído de Alus, vieram abarracar-se a Rafidim, onde faltou ao povo água para beber."},{text:"15 E partindo de Rafidim, vieram acampar-se no deserto do Sinai."},{text:"16 E abalando do deserto do Sinai, vieram aos se pulcros da Concupiscência."},{text:"17 E partindo dos sepulcros da Concupiscência, vie ram acampar-se em Haserot."},{text:"18 E de Haserot vieram a Retma."},{text:"19 E partindo de Retma, vieram acampar-se em Remonfarés."},{text:"20 Abalando daqui vieram a Lebna."},{text:"21 De Lebna foram acampar-se em Ressa."},{text:"22 E tendo partido de Ressa vieram a Ceelata."},{text:"23 Partindo daqui vieram acampar-se no monte de Sefer."},{text:"24 Deixando o monte de Sefer vieram a Arada."},{text:"25 Partindo dali vieram acampar-se em Macelot."},{text:"26 E partindo de Macelot, vieram a Taat."},{text:"27 De Taat, vieram acampar-se em Tare."},{text:"28 Abalando daqui, vieram abarracar-se em Metca."},{text:"29 E de Metca foram acampar-se em Hesmona."},{text:"30 E partindp de Hesmona, vieram a Moserot."},{text:"31 E de Moserot foram acampar-se em Benejaacandirigiam de Elim pára o Sinai, o único caminho direito que se lhes apresentava para chegar ao mar era o que passa perto do Haman Farom, dal deviam descer por Schebeikoh e"},{text:"Tauglbeh, onde devia ficar éste acampamento."},{text:"32 £ partindo de Benejaacan, vieram ao monte de Gadgad."},{text:"33 Saindo daqui, íoram acampar-se a Jetebata."},{text:"34 E de Jetebata vieram a Hebrona."},{text:"35 E partindo de Hebrona foram acampar-se em Asiongaber."},{text:"36 Partindo daqui, vieram ao deserto de Sin, que c o de Cades."},{text:"37 E saindo de Cades, foram acampar-se no monte Hor, nos confins do país de Edom."},{text:"38 E o sacerdote Aarão subiu por mandado do Se nhor ao monte H or: e ali morreu no primeiro dia do quinto mês do ano quadragésimo, depois da saída dos filhos de Israel do Egito,"},{text:"39 tendo de idade cento e vinte e três anos."},{text:"40 Então ouviu o rei Arad cananeu, que habitava para o Meio-Dia, que os filhos de Tsrael eram chegados à terra de Canaã."},{text:"41 E partindo do monte Hor, vieram acampar-se em Salmona."},{text:"42 Donde tendo saído, vieram a Funon."},{text:"43 E partindo de Funon, foram acampar-se em Obot."},{text:"44 E de Obotvieram a T.jeabarim, que é nos limi tes dos moabitas."},{text:"45 E abalando de Ijeabarim, vieram abarracar-se em Dibongad."},{text:"46 Donde tendo saído, foram acampar-se a Helmondeblataim."},{text:"47 E partindo de Helmondeblataim, vieram _às serras de Abarim defronte de Nabo."},{text:"48 E tendo deixado as serras de Abarim, passaram às planícies de Moab sobre o Jordão defronte de Jericó. — 1 3 5"},{text:"49 E aí se acamparam nos lugares mais rasos do país dos moabitas desde Betsimot até Abelsatim,"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Números Vol. 34",author:"Pe. A. P. de Figueiredo",pages:[{text:"50 onde o Senhor disse a Moisés:"},{text:"51 Ordena aos filhos de Israel, e dize-ihes: Depois de passardes o Jordão, entrando na terra de Canaa,"},{text:"52 exterminai todos os habitantes dêste país: quebrai os seus padrões, e fazei em pedaços as suas estátuas, e deitai abaixo todos os seus altos,"},{text:"53 purificando a terra, e habitando nela: Porque eu vo-la dei para a possuirdes,"},{text:"54 a qual repartireis entre vós por sorte. Aos que forem em maior número dareis maior porção, e aos que forem menos, porção mais pequena. Cada um receberá a sua herança, conforme o que lhe cair por sorte. E a repar tição"},{text:"se fará por tribo e por famílias."},{text:"55 Sé vós não quiserdes matar os habitantes do país: Serão para vós os que ficarem como uns cravos nos olhos e umas lanças nas ilhargas, e éles vos darão que fazer na terra da vossa habitação:"},{text:"56 e todo o mal que eu tinha resoluto fazer-lhes a êles, o farei a vós outros."},{text:"Números — capítulo 34."},{text:"1 Falou mais o Senhor a Moisés, dizendo:"},{text:"2 Manda aos filhos de Israel e lhes dirás: Quan do tiverdes entrado na terra de Canaã, e cada um de"},{text:"3 A parte meridional começará no deserto de Sin, que é perto de Edom: e terá por limites para o Oriente o mar salgadíssimo."},{text:"4 Os quais irão rodeando a parte austral pela su bida do Escorpião, de sorte que passem por Sena, e se estendam desde o Meio-Dia até Cadesbarne, donde irão até à aldeia chamada Adar e se estenderão até Asemona."},{text:"5 E o limite irá dando volta desde Asemona até a torrente do Egito, e acabará na praia do mar grande."},{text:"6 A parte ocidental começará desde o mar grande, e nele igualmente se terminará."},{text:"7 Os termos pela parte setentrional começarão des de o mar grande, e se estenderão até o monte altíssimo,"},{text:"8 do qual virão a Emat, até os confins de Sedada:"},{text:"9 e se estenderão os confins até Zefrona, e até a al deia de E nan: Êstes serão os termos da banda do Aquilão."},{text:"10 Os da banda do Oriente se medirão desde a aldeia de Enan até Sefama,"},{text:"11 e de Sefama descerão os têrmos a Rebla fron teiros à fonte de Dafne, desde ali se estenderão contra o Oriente até o .mar de Ceneret."},{text:"12 e se encaminharão até o Jordão, e alíim se tertomou posse da direção do Povo Escolhido; em uma palavra, foi a última estação dos israelitas no deserto."},{text:"13 Mandou pois Moisés aos filhos de Israel, dizen do: Esta será a terra, que vós possuíreis por sorte, e que o Senhor mandou que se desse às nove tribos, e à meia tribo."},{text:"14 Porque a tribo dos filhos de Rúben com tôdas as suas famílias e a tribo dos filhos de Gad segundo o número das suas famílias, e metade da tribo de Manasses,"},{text:"15 isto é, duas tribos e meia, receberam já a sua parte de aquém do Jordão defronte de Jericó para a banda do Oriente."},{text:"16 Disse outrossim o Senhor a Moisés:"},{text:"17 Êstes são os nomes dos homens, que vos repar tirão a terra, o sacerdote Eleazar, e Josué filho de Nun,"},{text:"18 e um dos príncipes de cada tribo,"},{text:"19 cujos nomes são êstes: Da tribo de Judá, Caleb filho de Jefone."},{text:"20 Da tribo de Simeão, Samuel filho de Amiud."},{text:"21 Da tribo de Benjamim, Elidad filho de Caselon."},{text:"22 Da tribo dos filhos de Dan, Boci filho de Jogli."},{text:"23 Dos filhos de José da tribo de Manassés, Haniel filho de Efod."},{text:"24 Da tribo de Efraim , Camuel filho de Seftam."},{text:"25 Da tribo de Zabulon, Elisafan filho de Farnac."},{text:"26 Da tribo de Issacaro príncipe Faltiel filho de Ozan."},{text:"27 Da tribo de Aser, Aiud filho de Salonii."},{text:"28 Da tribo de Neftali, Zedael filho de Amiud."},{text:"29 Êstes são aqueles, a quem o Senhor mandou que repartissem entre os filhos de Israel a terra de Canal."},{text:"Números — capítulo 35."},{text:"1 Disse também o Senhor estas coisas a Moisés nas planícies de Moab, ao longo do Jordão, defronte de Jericó:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Números Vol. 35",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Manda aos filhos de Israel, que dêm das suas pos sessões aos levitas"},{text:"3 cidades para habitarem, e os seus subúrbios em roda: para que êles morem nas cidades, e os subúrbios sejam para os gados e animais:"},{text:"4 Os quais se estenderão' dos muros das cidades para fora mil passos em rodai"},{text:"5 assim a sua extensão será de dois mil côvados para o Oriente, e da mesma sorte de dois mil côvados para o Meio-Dia: a mesma medida terão élés para a banda do mar que olha para o Ocidente, e por iguais limites se ter"},{text:"minará a banda do Sctentrião: e as cidades estarão no meio, e os subúrbios fora."},{text:"6 Das mesmas cidades porém que haveis de dar aos levitas, seis serão destinadas para asilo dos fugitivos, a fim de que se refugie a elas aquele que tiver derrama do sangue; e além destas, haverá outras quarenta e duas"},{text:"cidades,"},{text:"7 isto é, por tôdas quarenta e oito com os seus su búrbios."},{text:"8 E essas cidades que se hão de dar das possessões dos filhos de Israel, se tomarão mais dos que têm mais: e menos dos que têm menos: cada um dará cidades aos levitas à proporção da sua herança."},{text:"9 Disse o Senhor a Moisés:"},{text:"10 Fala aos filhos de Israel, e lhes dirás: Quando passardes o Jordão entrando na terra de Canaã,"},{text:"11 determinai que cidades devem ser para asilo dos fugitivos, que involuntàriamente derramarem sangue:"},{text:"12 Nas quais tanto que algum se tiver refugiado, não poderá matá-lo o parente do morto, menos que se não apresente diante do povoe seja julgada a sua causa."},{text:"13 dessas cidades porém, que se separam para asilo dos fugitivos,"},{text:"14 três serão de aquém do Jordão, e três na terra de Canaã,"},{text:"15 tanto para os filhos de Israel, como para os ad ventícios e estrangeiros, para que a elas se refugie aquê- le que involuntàriamente derramar sangue."},{text:"16 Se