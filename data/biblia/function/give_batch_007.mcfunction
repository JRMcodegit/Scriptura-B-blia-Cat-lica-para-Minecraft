give @p minecraft:written_book[written_book_content={title:"Levítico Vol. 06",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 Derramou também sôbre a cabeça de Aarão o óleo, com que o ungiu, e sagrou."},{text:"13 E tendo apresentado da mesma sorte ós filhos de Aarão, êle lhes vestiu as suas camisas de linho, cingiu-os com os seus cíngulos, e pôs-lhes as mitras na cabeça, como o Senhor o tinha mandado."},{text:"14 Ofereceu também um novilho pelo pecado. E tendo Aarão, e seus filhos pôsto as suas mãos sôbre a cabeça desta vítima,"},{text:"15 Moisés a imolou: e tomando do sangue, molhou nêle o seu dedo, e tocou com êle as hastes do altar todoem roda: e tendo-o assim purificado, e santificado, derra mou o resto do sangue ao pé do altar."},{text:"16 Fêz queimar sôbre o altar a gordura, que cobre as entranhas, o redenho do fígado, e os dois rins com agordura, que está pegada a êles."},{text:"17 E queimou o novilho fora do campo, com a pele, a carne, e a bosta, como o Senhor o tinha mandado."},{text:"18 Ofereceu também um carneiro em holocausto. E tendo-lhe Aarão com seus filhos pôsto as mãos sôbre a cabeça,"},{text:"19 êle Moisés o imolou, e lhe derramou o sangue aoredor do altar."},{text:"20 Fêz também em pedaços o carneiro, e queimou no fogo a cabeça, os membros, e a gordura,"},{text:"21 depois de lhe ter lavado os intestinos, e os pés. Queimou sôbre o Altar o carneiro todo, por ser isto umholocausto de suavíssimo cheiro para o Senhor, como êleo tinha mandado."},{text:"22 Ofereceu ainda um segundo carneiro para a sagração dos Sacerdotes: e tendo-lhe Aarão com seus filhos pôsto as mãos sôbre a cabeça,"},{text:"23 Moisés o imolou: e tomando do seu sangue, tocou com êle a extremidade da orelha direita de Aarão, e o dedo polegar da sua mão direita, e do seu pé."},{text:"24 Tendo também apresentado os filhos de Aarão, tomou do sangue do carneiro imolado e tocou com êle aextremidade da orelha de cada um dêles, e os dedos polegares da sua mão direita, e do seu pé; e entornou o resto do"},{text:"sangue ao redor do altar."},{text:"25 Pôs à parte a gordura, a cauda, e tôdas as banhas, que cobrem os intestinos, o redenho do fígado, e osdois rins com a banha, que está pegada a êles, e a espádua direita."},{text:"26 E tirando do cês to dos pães asmos, que estavam diante do Senhor, um pão asmo, uma empanada borri fada de azeite, e uma torta, pôs tôdas estas coisas sôbre as banhas da hóstia, e sôbre a espádua direita;"},{text:"27 e entregou-as tôdas a Aarão, e a seus filhos, que as elevaram diante do Senhor."},{text:"28 Tornadas a tomar das mãos dêles, Moisés asqueimou em cima do altar dos holocaustos, por ser estaa oferta da sagração, e um sacrifício de suavíssimo cheiro para o Senhor."},{text:"29 Tomou outrossim o peito do carneiro imolado para a sagração, e elevou-o diante do Senhor, como aparte, que lhe estava destinada, segundo a ordem, que o Senhor lhe dera."},{text:"30 Depois tomando o óleo da unção, e o sangue, queestava sôbre o altar, borrifou com êles a Aarão, e os seusvestidos, os filhos de Aarão, e os filhos dêles."},{text:"31 E depois de os ter santificado nos seus vestidos mandou-lhes, e disse-lhes o seguinte: Fazei cozer a carne das vítimas diante da porta do tabernáculo, e comei-a aímesmo. Comei também os pães da sagração, que estive"},{text:"rem postos no cêsto, como o Senhor mo ordenou, dizen do: Aarão, e seus fiihos comerão êstes pães;"},{text:"32 e tudo o que restar desta carne, e dêstes pães, será consumido pelo fogo."},{text:"33 Vós não saireis da entrada do tabernáculo porsete dias até o dia, em que se complete o tempo da vossa sagração; porque a sagração acaba-se em sete dias,"},{text:"34 como presentemente se fêz, a fim de cumpriremas cerimónias dêste sacrifício."},{text:"35 Estareis de dia, e de noite, no tabernáculo velando diante do Senhor, para que não suceda morrer des: porque assim me foi ordenado."},{text:"36 Aarão pois, e seus filhos fizeram tudo o queo Senhor lhes tinha mandado por Moisés."},{text:"Levítico — capítulo 9."},{text:"1 Ao oitavo dia chamou Moisés a Aarão, e a seus filhos, e aos anciãos de Israel, e disse a Aarão:"},{text:"2 Toma do teu rebanho um novilho pelo pecado, e um carneiro para o holocausto, um e outro sem mancha, e oferece-os diante do Senhor."},{text:"3 Dirás também aos filhos de Israel: Tomai umbode pelo pecado, um novilho e um cordeiro, dum anosem mancha, para se fazer um holocausto."},{text:"4 Tomai outrossim um boi, e um carneiro parahóstias pacíficas, e imolai-os diante do Senhor, ofere cendo no sacrifício de cada um dêstes animais farinha pura misturada com azeite: Porque hoje vos há de aparecer o Senhor."},{text:"5 Puseram êles pois à entrada do tabernáculo tudo o que Moisés lhes tinha Ordenado; e ali posta em pétôda a multidão do povo,"},{text:"6 Moisés lhes disse: Isto é o que o Senhor vos mandou : fazei-o, e aparecer-vos-á a sua glória."},{text:"7 Então disse êle para Aarão: Chega-te ao altar, e imola pelo teu pecado. Oferece o holocausto, e rogapor ti, e pelo povo: e depois de teres sacrificado a hóstia pelo povo, ora por êle, como o Senhor mandou."},{text:"8 Logo Aarão chegando-se ao altar,. imolou umnovilho pelo seu pecado;"},{text:"9 cujo áangue tendo-lhe apresentado seus filhos, molhou nêle o de, e tocou com êle os cornos do altar, ederramou o resto do sangue ao pé do altar."},{text:"10 Queimou também em cima do altar a gordura, os rins, e o redenho do fígado, que são pelo pecado, conforme o tinha mandado o Senhor a Moisés."},{text:"11 A carne, porém, e a pele consumiu-as no fogofora do campo."},{text:"12 Imolou também a vítima do holocausto: e tendo-lhe seus filhos apresentado o sangue dela, Aarão oentornou ao rèdor do altar."}]}] 1
