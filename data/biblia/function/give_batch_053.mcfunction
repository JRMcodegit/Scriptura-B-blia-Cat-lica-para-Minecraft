give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Cheia está a terra de prata e de ouro: E não têm têrmo os seus tesouros:"},{text:"8 E cheia está a sua terra de cavalos: E são inumeráveis as suas quadrigas: E cheia está a sua terra de ídolos: Adoraram a obra de suas mãos, a qual fizeram os seus dedos."},{text:"9 E se encurvou o homem, e o varão se abateu: Portanto não lhes perdoes."},{text:"10 Entra na penha, e nas aberturas da terra esconde-te da espantosa presença do Senhor, e da glória de sua majestade."},{text:"11 Os olhos altivos do homem têm sido abaixados, e encurvada será a altiveza dos varões e só o Senhor será exaltado naquele dia."},{text:"12 Porque o dia do Senhor dos Exércitos será sôbre todo o soberbo, e altivo, e sôbre todo o arrogante: E êle será humilhado."},{text:"13 E sôbre todos os cedros do Líbano altos e levantados, e sôbre todos os carvalhos de Basan."},{text:"14 E sôbre todos os montes altos, e sôbre todos os outeiros elevados."},{text:"15 E sôbre tôda a tôrre eminente, e sôbre todo o muro fortificado,"},{text:"16 e sôbre tôdas as naus de Tarsis, e sôbre tudo o que é belo à vista."},{text:"17 E será encurvada a arrogância dos homens, e abatida a altiveza dos varões, e só o Senhor será sublimado naquele dia:"},{text:"18 E os ídolos serão de todo esmigalhados:"},{text:"19 E entrarão nas cavernas das penhas e nas voragens da terra por causa da presença formidável do Senhor, e da glória de sua majestade, quando se levantar para ferir a terra."},{text:"20 Naquele dia arrojará o homem os seus ídolos de prata, e os seus simulacros de ouro, que para si tinha feito a fim de os adorar não sendo mais que toupeiras e morcegos."},{text:"21 E entrará nas aberturas das pedras, e nas cavernas dos rochedos por causa da presença formidável do Senhor, e da glória de sua majestade, quando se levantar para ferir a terra."},{text:"22 Cessai pois de irritar êste homem, cujo fôlego respira no seu nariz, porquanto êle mesmo é reputado pelo Excelso."},{text:"Isaías — capítulo 3."},{text:"1 Eis-aqui pois que o Soberano Senhor dos Exércitos está para tirar de Jerusalém e de Judá ao valente e ao forte, e tôda a fôrça do pão, e a tôda a fôrça de água:"},{text:"2 Ao homem forte, e ao guerreiro, ao juiz, e ao profeta, e ao adivinho, e ao ancião:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E eu lhes darei meninos para príncipes, e dominá-los-ão efeminados."},{text:"5 E investirá o povo, homem a homem, e cada um a seu próximo: Tumultuará o mancebo contra o velho e o plebeu contra o nobre."},{text:"6 Porque tomará cada um a seu próprio irmão doméstico de seu pai: Tu tens melhor vestido, sê nosso príncipe, e fique esta ruína atalhada debaixo da tua mão."},{text:"7 Êle responderá naquele dia, dizendo: Não sou médico, e em minha casa não há pão, nem vestido: Não queirais constituir-me príncipe do povo."},{text:"8 Pois Jerusalém se vai arruinando, e Judá caindo: Porquanto a língua dêles, e as invenções da sua fantasia são contra o Senhor, para provocarem os olhos de sua majestade."},{text:"9 A mesma vista do seu semblante dá testemunho contra êles: E os tais fizeram como os de Sodoma pública ostentação do seu pecado, e não o encobriram: Ai da alma dêles, porque se lhes têm dado males em recompensa."},{text:"10 Dizei ao justo que êle será bem sucedido, pois comerá o fruto dos seus conselhos."},{text:"11 Ai do ímpio que corre ao mal: Porque lhe será dada a retribuição de suas mãos."},{text:"12 Ao meu povo despojaram os seus exatores, e os têm dominado mulheres. Povo meu, os que te chamam bem-aventurado, êsses mesmos te enganam, e destroem o caminho dos teus passos."},{text:"13 O Senhor está para julgar, e está para julgar os povos."},{text:"14 O Senhor entrará em juízo com os anciãos do seu povo, e com os seus príncipes: Porque vós tendes comido a minha vinha, e a rapina feita ao pobre se acha em vossa casa."},{text:"15 Por que razão meteis vós debaixo dos pés o meu povo, e moeis às pancadas os rostos dos pobres, diz o Senhor Deus dos Exércitos?"},{text:"16 Ainda disse mais o Senhor: Pois que as filhas de Sião se elevaram, e andaram com o pescoço emproado, e iam fazendo acenos com os olhos, e gestos de mãos, passeavam com os seus ruidosos pés, e caminhavam a passo"},{text:"mesurado:"},{text:"17 O Senhor tornará calva a cabeça das filhas de Sião, e despojá-las-á o mesmo Senhor do seu cabelo."},{text:"18 Naquele dia lhes tirará o Senhor o adôrno dos calçados, e os diademas,"},{text:"19 e os colares, e as gargantilhas, e os braceletes, e os garavins,"},{text:"20 e as barreiras, e as ligas de pernas, e as cadeias de ouro, e os vasos de essências, e as arrecadas,"},{text:"21 e os anéis, e os pingentes de pedras preciosas caídos sôbre a fronte."},{text:"22 E os vestidos de reserva, e as charpas, e os volantes, e as agulhetas,"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 e os espelhos, e os delicados lenços, e os listões, e as roupas de verão."},{text:"24 E em lugar de suave cheiro terão hediondez, e por cinta corda, e por cabelo encrespado calva, e por faixa do peito cilício."},{text:"25 Também os teus mais galhardos varões cairão mortos à espada, e os teus valentes em ação de peleja."},{text:"26 E se entristecerão e enlutarão as portas dela e desolada se assentará em terra."},{text:"Isaías — capítulo 4."},{text:"1 E naquele dia lançarão mão de um só homem sete mulheres, dizendo: Nós do nosso pão nos sustentaremos, e dos nossos vestidos nos cobriremos: O nosso único intento é que sejamos nós chamadas do teu nome, tira o nosso"},{text:"opróbrio."},{text:"2 Naquele dia se achará o gérmen do Senhor em magnificência e glória, e o fruto da terra elevado, e exultação para aquêles de Israel, que fôrem salvos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Quando o Senhor limpar as manchas das filhas de Sião, e lavar o sangue do meio de Jerusalém com espírito de justiça, e com espírito de ardor."},{text:"5 E criará o Senhor sôbre todo o lugar do monte de Sião, e onde êle foi invocado, uma nuvem de dia, e fumo e resplendor de fogo chamejante de noite: Porque sôbre tôda a glória será a proteção."},{text:"6 E o tabernáculo será para fazer sombra de dia contra a calma, e para segurança e guarida contra o torvelinho, e a chuva."},{text:"Isaías — capítulo 5."},{text:"1 Cantarei ao meu amado o cântico de meu primo à sua vinha. O meu amado teve uma vinha plantada num alto fertilíssimo."},{text:"2 E a cercou de uma sebe e tirou do pé dela as pedras, e a plantou de bacelo escolhido, e edificou uma tôrre no meio dela, e fêz na mesma tôrre um lagar: E esperava que desse uvas, e veio a produzir labruscas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Que coisa há que eu devesse ainda fazer à minha vinha, que lhe não tenha feito? far-lhe-ia acaso injúria em esperar que ela desse boas uvas em lugar de labruscas que só produziu?"},{text:"5 Pois agora vos mostrarei o que eu hei de fazer à minha vinha, arrancar-lhe-ei a sebe, e ficará exposta a ser roubada: derrubar-lhe-ei o muro, e ficará sujeita a ser pisada."},{text:"6 E farei com que fique deserta: Não será podada, nem cavada: E crescerão nela os espinhos e abrolhos: E mandarei às nuvens que não derramem sôbre ela chuva."},{text:"7 Porque a vinha do Senhor dos exércitos é a casa de Israel: E o varão de Judá o seu renôvo deleitável: E esperei que fizesse juízo, e eis-que só há iniqüidade: E que praticasse justiça, e eis-que só há clamor."},{text:"8 Ai de vós os que ajuntais casa a casa, e ides acrescentando campo a campo até chegar ao fim de todo o terreno: Acaso habitareis vós só no meio da terra?"},{text:"9 Nos meus ouvidos estão estas coisas, diz o Senhor dos exércitos. Verdadeiramente que muitas casas grandes, e vistosas virão a ficar ermas sem habitador."},{text:"10 Porque dez geiras de vinhas darão apenas um barrilzinho, e trinta alqueires de trigo semeado não darão mais que três."},{text:"11 Ai de vós os que vos levantais pela manhã para seguir a embriaguez, e para beberdes até à tarde com tal excesso, que venhais a ficar de todo esquentados do vinho."},{text:"12 A cítara, e a lira, e o pandeiro, e a flauta, e o vinho se acham nos vossos banquetes: E vós não olhais para a obra do Senhor, nem considerais as obras das suas mãos."},{text:"13 Por isso é que o meu povo foi levado cativo, porque não teve inteligência, e as suas nobres personagens morreram de fome, e a sua multidão se mirrou de sêde."},{text:"14 Por isso é que o inferno alargou o seu seio, e sem têrmo algum abriu a sua bôca: E descerão a êle os seus fortes, e o seu povo, e os altos e jactanciosos dêle."},{text:"15 E será incurvado o homem, e humilhado o varão, e os olhos dos altivos ficarão todos baixos."},{text:"16 E será exaltado o Senhor dos exércitos no seu juízo, e o santo Deus será santificado em justiça."},{text:"17 E serão apascentados os cordeiros segundo a sua ordem, e dos desertos convertidos em fertilidade comerão os estranhos."},{text:"18 Ai de vós os que arrastais a iniqüidade com cordas de vaidade, e o pecado como brocha de carro."},{text:"19 Os que dizeis: Avie já com isso, e sem demora venha essa sua obra, para que a vejamos: E chegue-se, e cumpra-se o conselho do Santo de Israel, e saberemos qual êle seja."},{text:"20 Ai de vós, os que ao mau chamais bom, e ao bom mau: Pondo trevas por luz, e luz por trevas: Pondo o amargo pelo doce, e o doce pelo amargo!"},{text:"21 Ai de vós, os que sois sábios a vossos olhos, e diante de vós mesmos prudentes."},{text:"22 Ai de vós, os que sois poderosos para beber vinho, e varões fortes para beberdes a largos sorvos a ebriedade!"},{text:"23 Os que justificais ao ímpio pelas dádivas, e ao justo lhe tirais o seu direito!"},{text:"24 Por esta causa, assim como a língua do fogo devora a palha, e a abrasa o calor da chama: Assim a raiz dêles será como a faísca, e o seu renôvo subirá como o pó. Porquanto êles arrojaram de si a lei do Senhor dos"},{text:"exércitos e blasfemaram da palavra do Santo de Israel."},{text:"25 Por isso o furor do Senhor se acendeu contra o seu povo e estendeu a sua mão sôbre êle, e o feriu: E os montes se abalaram, e os seus corpos mortos foram lançados como estêrco ao meio das praças. Com todos êstes"},{text:"castigos não se tem aplacado o seu furor, mas ainda está alçada a sua mão."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 E arvorará o seu estandarte em as nações de longe, e assobiará a êle desde os confins da terra: E eis que chegará velozmente apressado."},{text:"27 Não há nêle quem sinta cansaço nem trabalho: Não dormitará, nem dormirá, nem se lhe desatará o cinto dos seus rins, nem se lhe romperá a correia do seu sapato."},{text:"28 As suas setas são agudas, e todos os seus arcos estão entesados. As unhas dos seus cavalos são como pederneira, e as suas rodas são como o ímpeto da tempestade."},{text:"29 O seu rugido será como o do leão, rugirá como os cachorros dos leões: E rangerá com os dentes, e agarrará a prêsa: E se abraçará com ela, e não haverá quem lha saque."},{text:"30 E soará sôbre êle naquele dia um como sonido de mar: E eis que tudo serão trevas de tribulação, e a luz se obscureceu com a cerração dela."},{text:"Isaías — capítulo 6."},{text:"1 No ano em que o rei Ozias morreu: vi ao Senhor assentado sôbre um alto e elevado sólio: E as coisas que estavam debaixo dêle, enchiam o templo."},{text:"2 Os Serafins estavam sôbre êle: Seis asas tinha um, e seis asas tinha outro: Com duas cobriam a sua face, e com duas cobriam os seus pés, e com duas voavam:"},{text:"3 tools — see the cookie policy for details"},{text:"4 E estremeceram os umbrais com as couceiras à voz do seu clamor, e a casa se encheu de fumo."},{text:"5 Então disse eu: Ai de mim porque me calei, porque eu sou um homem de lábios impuros, e eu mesmo habito no meio de um Povo que tem os seus lábios também impuros, e vi com os meus olhos ao Rei Senhor dos exércitos."},{text:"6 E voou para mim um dos Serafins, o qual trazia na sua mão uma brasa viva, que êle havia tomado do altar com uma tenaz."},{text:"7 E tocou a minha bôca e disse: Eis-aqui tocou esta brasa os teus lábios, e será tirada a tua iniqüidade, e lavado será o teu pecado."},{text:"8 E ouvi a voz do Senhor que dizia: Quem enviarei eu? E quem nos irá lá? Então disse eu: Aqui me tens a mim, envia-me."},{text:"9 E o Senhor me disse: Vai, e dirás a êste Povo: Ouvi, ouvintes, e não o entendais: E vêde a visão, e não a conheçais."},{text:"10 Obceca o coração dêste Povo, e ensurdece-lhe os ouvidos: E fecha-lhe os olhos: Para que não suceda que veja com seus olhos, e ouça com seus ouvidos, e entenda com seu coração, e se converta, e eu o sare."},{text:"11 E eu disse: Até quando, Senhor? Então disse êle: Até que fiquem desoladas as cidades sem habitador, e as casas sem homem, e assim virá a ficar deserta a terra."},{text:"12 E o Senhor lançará os homens para longe do seu país, e multiplicar-se-á a porção que tinha sido deixada no meio da terra."},{text:"13 E ainda haverá nela dizimação, e converter-se-á, e servirá para mostrar como terebinto, e como carvalho, que estende os seus ramos: A linhagem que ficar nela será santa."},{text:"Isaías — capítulo 7."},{text:"1 E aconteceu nos dias de Acaz, filho de Joatan, filho de Ozias, rei de Judá, que marchou Rasin, rei da Síria, e Facéias, filho de Romélia, rei de Israel, subindo a Jerusalém, para pelejar contra ela: E não a puderam"},{text:"conquistar."},{text:"2 E deram aviso à casa de Davi, dizendo: A Síria coligou-se com Efraim, e ficou agitado o seu coração e o coração do seu povo, como se movem as árvores das selvas à face do vento."},{text:"3 tools — see the cookie policy for details"},{text:"4 E dir-lhe-ás: Trata de te aquietares: Não temas, nem se desanime o teu coração à vista dos dois troços últimos dêsses tições fumegantes em ira de furor, Rasin, rei da Síria, e o filho de Romélia."},{text:"5 Porquanto se têm confederado para mal contra ti a Síria, Efraim e o filho de Romélia, dizendo:"},{text:"6 Vamos contra Judá, e despertemo-lo, e arranque-mo-lo para nós, e ponhamos feito rei no meio dêle ao filho de Tabeel."},{text:"7 Estas coisas diz o Senhor Deus: Não subsistirá, nem terá efeito êste desígnio:"},{text:"8 Mas acabarão Damasco metrópole da Síria, Rasin, soberano de Damasco e ainda dentro de sessenta e cinco anos até Efraim deixará de ser povo:"},{text:"9 E também Samaria, capital de Efraim, e o filho de Romélia, soberano de Samaria. Se o não crerdes não permanecereis."},{text:"10 E continuou o Senhor a falar com Acaz, dizendo:"},{text:"11 Pede para ti ao Senhor teu Deus algum sinal que chegue ao profundo do inferno, ou ao mais alto do Céu."},{text:"12 E disse Acaz: Não pedirei tal, nem tentarei ao Senhor."},{text:"13 E disse: Ouvi pois casa de Davi: Porventura não vos basta ser molestos aos homens, senão que tendes ainda ânimo de também o serdes a meu Deus?"},{text:"14 Pois por isso o mesmo Senhor vos dará êste sinal. Eis que uma virgem conceberá, e dará à luz um filho, e será chamado o seu nome Emanuel."},{text:"15 Êle comerá manteiga e mel, até que saiba rejeitar o mal, e escolher o bem."},{text:"16 Porque antes que o menino saiba rejeitar o mal, e escolher o bem, a terra que tu detestas será desamparada da presença dos seus dois reis."},{text:"17 O Senhor por intervenção do rei dos assírios fará vir sôbre ti, e sôbre o teu povo, e sôbre a casa de teu pai dias tais, quais não foram vistos desde os dias em que Efraim se separou de Judá."},{text:"18 E isto acontecerá naquele dia: O Senhor assobiará à môsca que está no extremo dos rios do Egito, e à abelha que está na terra de Assur,"},{text:"19 e elas virão, e pousarão tôdas nas torrentes dos vales, e nas cavernas dos rochedos, e em todos os matos, e em todos os buracos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 05",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Naquele dia o Senhor com uma navalha alugada por meio dos que estão da banda de além do rio, por intervenção do rei dos assírios, rapará a cabeça e os cabelos dos pés, e a barba tôda."},{text:"21 E isto acontecerá também naquele dia: Um homem criará uma vaca de bois, e duas ovelhas,"},{text:"22 e pela abundância do leite sustentar-se-á de manteiga: Porque todo aquêle que tiver ficado no meio da terra, comerá manteiga e mel."},{text:"23 E isto acontecerá outrossim naquele dia: Todo o lugar onde houver mil vides do valor de mil dinheiros de prata se cobrirá de espinhos e abrolhos."},{text:"24 Com setas e arco entrarão ali: Porque os abrolhos e os espinhos estarão por tôda a terra."},{text:"25 E a todos os montes, que com sacho fôrem sachados, não lhes chegará ali o terror dos espinhos e dos abrolhos, mas servirão para as pastagens dos bois, e para serem pisados dos gados."},{text:"Isaías — capítulo 8."},{text:"1 E o Senhor me disse: Toma um livro grande, e escreve nêle em estilo de homem: Tira depressa os despojos, faze velozmente a prêsa."},{text:"2 E eu tomei duas testemunhas fiéis. Urias sacerdote, e Zacarias, filho de Baraquias:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque antes que o menino saiba chamar por seu pai e por sua mãe, tirar-se-á a fortaleza de Damasco, e levar-se-ão os despojos de Samaria diante do rei dos assírios."},{text:"5 E continuou o Senhor a falar-me ainda, dizendo:"},{text:"6 Por isso mesmo que êste povo rejeitou as águas de Siloé, que correm em silêncio, e quis antes acostar-se ao partido de Rasin, e ao do filho de Romélia:"},{text:"7 Por êste motivo eis que o Senhor fará sôbre êles vir as águas impetuosas e abundantes, ao rei dos assírios, e todo o seu poder: E subirá sôbre todos os seus ribeiros, e correrá por cima de tôdas as suas margens."},{text:"8 E se espraiará por Judá inundando-a, e indo assim passando, lhe chegará até o pescoço. E a extensão de suas asas encherá a largura da tua terra, ó Emanuel."},{text:"9 Ajuntai-vos, povos, e sereis vencidos, e vós tôdas as terras de longe ouvi: Incorporai as vossas fôrças e sereis vencidos, tomai as vossas armas e sereis vencidos:"},{text:"10 Formai qualquer desígnio, e êle sairá frustrado: Proferi alguma palavra de mando, e ela não será executada: Porque Deus é conosco."},{text:"11 Porque o Senhor me diz a mim estas coisas: Assim como êle com a mão forte me deu a instrução de que não fôsse pelo caminho dêste povo, dizendo:"},{text:"12 Não digais: Conspiremo-nos porque tudo o que êste povo diz é uma conspiração: E não temais o que êle teme, nem vos assusteis."},{text:"13 Dai glória à santidade do mesmo Senhor dos exércitos: Êle seja o vosso pavor, e êle o vosso terror."},{text:"14 E êle será para vós um motivo de santificação. Mas servirá de pedra de tropêço, e de pedra de escândalo às duas casas de Israel: De laço e de ruína aos habitantes de Jerusalém."},{text:"15 E tropeçarão muitos dentre êles e cairão, e serão quebrantados, e enredados, e presos."},{text:"16 Ata o testemunho, sela a lei entre os meus discípulos."},{text:"17 E esperarei o Senhor, que esconde a sua face à casa de Jacó, e aguardá-lo-ei."},{text:"18 Eis-aqui estou eu e os meus meninos, que o Senhor me deu, para servirem de sinal, e de portento a Israel da parte do Senhor dos exércitos, que habita no monte Sião."},{text:"19 E quando vos disserem: Consultai os pitões, e os adivinhos, que murmuram em segrêdo nos seus encantamentos: Acaso não consultará o povo ao seu Deus, há de ir falar com os mortos acêrca dos vivos?"},{text:"20 Antes à lei e ao testemunho é que se deve recorrer. Porém se êles não falarem na conformidade desta palavra, não raiará para êles a luz da manhã."},{text:"21 E passará por ela, cairá, e terá fome: E quando padecer esta fome, se agastará, e amaldiçoará ao seu rei, e ao seu Deus, e levantará os olhos lá para cima."},{text:"22 E olhará para a terra, e eis-que tudo será tribulação e trevas, desmaio e angústia, e obscuridade que a persiga, e não poderá escapar do apêrto em que se acha."},{text:"Isaías — capítulo 9."},{text:"1 No primeiro tempo foi levemente combatida a terra de Zabulon, e a terra de Neftali: E no último carregou-se a mão sôbre o caminho do mar no Alem-jordão, a Galiléia dos gentios."},{text:"2 Êste povo, que andava em trevas viu uma grande luz: Aos que habitavam na região da sombra da morte, lhes nasceu o dia."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque tu quebraste o jugo do pêso que o oprimia, e a vara que lhe rasgava as espáduas, e o ceptro do seu exator, como o fizeste na jornada de Madian."},{text:"5 Porque todo o violento saque feito com tumulto e a vestidura manchada de sangue, será entregue à queima, e ficará sendo o pasto do fogo."},{text:"6 Porquanto já UM PEQUENO se acha NASCIDO para nós, e um filho nos foi dado a nós, e foi pôsto o principado sôbre o seu ombro: E o nome com que se apelide será admirável, conselheiro, Deus forte, pai do futuro século,"},{text:"príncipe da paz."},{text:"7 O seu império se estenderá cada vez mais, e a paz não terá fim: Assentar-se-á sôbre o trono de Davi, e sôbre o seu reino: Para o firmar e fortalecer em juízo e justiça, desde então e para sempre: Fará isto o zêlo do"},{text:"Senhor dos exércitos."},{text:"8 O Senhor dirigiu a sua palavra a Jacó, e caiu em Israel."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 06",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 E sabê-lo-á todo o povo de Efraim, e os habitantes de Samaria que cheios de soberba e arrogância de coração dizem:"},{text:"10 Os ladrilhos caíram, mas nós edificaremos de pedras de silharia: Êles cortaram os sicômoros, porém nós substituiremos cedros em seu lugar."},{text:"11 E suscitará o Senhor os adversários de Rasin para virem sôbre êle, e fará entrar em tumulto a seus inimigos:"},{text:"12 Aos sírios da parte do oriente, e aos filisteus da banda do ocidente: E êles devorarão a Israel com a bôca tôda. Com todos êstes males não se apartou o seu furor, mas ainda está alçada a sua mão:"},{text:"13 E êste povo não se voltou para quem o feria, e não buscaram ao Senhor dos exércitos."},{text:"14 E destruirá o Senhor num mesmo dia a cabeça e a cauda a Israel, ao que governa e ao que perverte."},{text:"15 O ancião e o homem respeitável, êsse é a cabeça: E o profeta que ensina mentira, êsse é a cauda."},{text:"16 E os que chamam bem-aventurado a êste povo, enganando-o: E aquêles que são chamados ditosos serão precipitados."},{text:"17 Por esta causa não se alegrará o Senhor sôbre os mancebos dêle: E não se compadecerá dos seus órfãos, nem das suas viúvas: Porque todos êles são uns hipócritas e uns maus homens, e tôda a bôca proferiu loucuras. Com"},{text:"todos êstes males não se apartou o seu furor, mas ainda está alçada a sua mão."},{text:"18 Porque a impiedade se acendeu como um fogo, ela devorará os abrolhos e os espinhos: E se ateará na espessura do bosque, e subirão ao alto nuvens de enovelado fumo."},{text:"19 Turbou-se a terra pela ira do Senhor dos exércitos e virá a ser o povo como pasto do fogo: O homem não perdoará a seu irmão."},{text:"20 E virará à direita, e terá fome: E comerá à esquerda, e não se fartará: Cada um devorará a carne do seu braço: Manassés a Efraim, e Efraim a Manassés, os mesmos juntos se levantarão contra Judá."},{text:"21 Com todos êstes males não se apartou o seu furor, mas ainda está alçada a sua mão."},{text:"Isaías — capítulo 10."},{text:"1 Ai dos que estabelecem leis iníquas: E escrevendo, escreveram injustiça:"},{text:"2 Para oprimirem aos pobres em juízo, e fazerem violência à causa dos fracos do meu povo: Para as viúvas serem a sua prêsa, e roubarem os bens dos pupilos."},{text:"3 tools — see the cookie policy for details"},{text:"4 para não ficardes encurvados debaixo do pêso das cadeias, e para não cairdes com os mortos? Depois de todos êstes males não se apartou o seu furor, mas ainda está alçada a sua mão."},{text:"5 Ai de Assur, êle é a vara e o bastão do meu furor, na mão dêles posta se acha a minha indignação."},{text:"6 Eu o enviarei a uma nação pérfida, e lhe ordenarei que marche contra um Povo, que eu olho com furor, para que leve dêle os despojos, e lhe dê saque, e o ponha para ser pisado aos pés como o lôdo das ruas."},{text:"7 Mas êle não o julgará desta maneira, nem o seu coração o pensará assim: Antes porém se aplicará o seu coração a quebrantar, e a exterminar não poucas Nações."},{text:"8 Porque dirá:"},{text:"9 Não é assim que os meus Príncipes são juntamente Reis? Acaso não me está no mesmo modo sujeita Calâno, como Cárcamis? E assim como o está Emat, não o está também Arfad? Porventura não corre igual paralelo tanto a"},{text:"Samaria, como Damasco?"},{text:"10 Do modo que achou a minha mão os reinos dos ídolos, assim também destruirei os simulacros dos de Jerusalém e de Samaria."},{text:"11 Porventura assim como eu fiz a Samaria e aos seus ídolos, não o farei também a Jerusalém e aos seus simulacros?"},{text:"12 Também acontecerá isto: Quando o Senhor tiver cumprido tôdas as suas obras no monte Sião, e em Jerusalém, farei exame sôbre o fruto do orgulhoso coração do rei de Assur, e sôbre a glória da altiveza de seus olhos."},{text:"13 Porquanto êle disse: Pelo esfôrço da minha mão fiz isto, e com a minha sabedoria o entendi: E tirei os têrmos dos povos, e despojei aos seus príncipes, e desentronizei como poderoso aos que residiam em altura."},{text:"14 E achou a minha mão como a um ninho a fortaleza dos povos: E assim como se recolhem os ovos, que foram deixados, assim ajuntei eu a tôda a terra: E não houve quem movesse a asa, nem abrisse a bôca, nem chilrasse."},{text:"15 Acaso gloriar-se-á o machado contra o que corta com êle? ou levantar-se-á a serra contra aquêle por quem é posta em movimento? Tudo isto é como se a vara se alçasse contra o que a alça, e se levantasse o bastão, que"},{text:"enfim não é mais que um bastão."},{text:"16 Por isso o Dominador, Senhor dos exércitos, enviará fraqueza sôbre os seus robustos: E ela arderá como queima de fogo ateada debaixo da sua glória."},{text:"17 E o lume de Israel estará naquele fogo, e o seu Santo na chama: E serão abrasados, e devorados os espinhos dêle e os seus abrolhos em um só dia."},{text:"18 E a glória do seu bosque, e do seu Carmelo desde a alma até à carne será consumida, e êle fugirá de puro mêdo."},{text:"19 E as árvores que ficarem do seu bosque serão contadas em conseqüência do seu pouco número, e um menino as escreverá."},{text:"20 Também acontecerá isto naquele dia: Os que tiverem ficado de Israel, e os da casa de Jacó que se tiverem salvado, não farão mais firmeza sôbre aquêle que os fere: Mas estribar-se-ão sinceramente sôbre o Senhor, o"},{text:"Santo de Israel."},{text:"21 Converter-se-ão as relíquias, as relíquias, digo, de Jacó ao Deus forte."},{text:"22 Porque se o teu povo, ó Israel, fôr tão numeroso como a areia do mar, só algumas relíquias dêles se converterão, a consumação abreviada inundará justiça."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 07",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 Porque o Senhor Deus dos exércitos fará uma consumação e abreviação no meio de tôda a terra."},{text:"24 Portanto, isso diz o Senhor Deus dos exércitos: Não queiras temer, povo meu, habitador de Sião, o mal que te vier de Assur: Êle te ferirá com a sua vara, e levantará o seu bastão para o descarregar sôbre ti no caminho"},{text:"do Egito."},{text:"25 Porquanto espera ainda um poucochinho e um breve espaço, e será consumada a minha indignação e o meu furor sôbre a maldade dêles."},{text:"26 E o Senhor dos exércitos levantará o flagelo sôbre êle à proporção do estrago de Madian no Penhasco de Oreb, e segundo a sua vara sôbre o mar, e levantá-la-á no caminho do Egito."},{text:"27 Também acontecerá isto naquele dia: Será tirado o seu pêso do teu ombro, e o seu jugo do teu pescoço, e apodrecerá o jugo por causa do azeite."},{text:"28 Virá até Aiat, passará a Magron: Em Macmas deixará depositada a sua bagagem."},{text:"29 Passaram de corrida, Gaba foi a nossa estada: Rama ficou cheia de espanto, Gabaat de Saul se lançou a fugir."},{text:"30 Brada com a tua voz, filha de Galim, atende Laisa, pobrezinha Anatot."},{text:"31 Medemêna já passou para outra parte: Vós, habitantes de Gabim, cobrai alento."},{text:"32 Ainda há dia para se chegar a fazer alto em Nobe, êle moverá a sua mão contra o monte da filha de Sião, contra o outeiro de Jerusalém."},{text:"33 Eis-que o dominador Senhor dos exércitos quebrará a quartinha com terror, os altos de estatura serão cortados, e os sublimes ficarão abatidos."},{text:"34 E as espessuras do bosque serão derribadas com ferro: E o Líbano cairá com os seus altos."},{text:"Isaías — capítulo 11."},{text:"1 E sairá uma vara do tronco de Jessé, e uma flor brotará da sua raiz."},{text:"2 E descansará sôbre êle o espírito do Senhor: Espírito de sabedoria e de entendimento, espírito de conselho e de fortaleza, espírito de ciência e de piedade,"},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas julgará os pobres com justiça: E argüirá com eqüidade em defesa dos mansos da terra: E ferirá a terra com a vara da sua bôca, e matará o ímpio com o assôpro dos seus lábios."},{text:"5 E a justiça será o cinto dos seus lombos: E a fé o talabarte dos seus rins."},{text:"6 O lôbo habitará com o cordeiro: E o leopardo se deitará ao pé do cabrito: O novilho, e o leão, e a ovelha viverão juntos, e um menino pequenino os conduzirá."},{text:"7 O novilho e o urso irão comer às mesmas pastagens: As suas crias descansarão umas com as outras, e o leão comerá palha como o boi."},{text:"8 E divertir-se-á a criança de peito sôbre a toca do áspide: E na caverna do basilisco meterá a sua mão a que estiver já desmamada."},{text:"9 Êles não farão dano algum, nem matarão em todo o meu santo monte: Porque a terra está cheia da ciência do Senhor, assim como as águas do mar que a cobrem."},{text:"10 Naquele dia a raiz de Jessé, que está posta por estandarte dos Povos, virão a ela mesma fazer-lhe suas rogativas as nações, e será glorioso o seu sepulcro."},{text:"11 Também acontecerá isto naquele dia: Estenderá segunda vez o Senhor a sua mão para possuir os restos do seu povo, que tiverem escapado do furor dos assírios e do Egito, e de Fetros, e da Etiópia, e de Elão, e de"},{text:"Senaar, e de Emat, e das Ilhas do mar."},{text:"12 E levantará o seu estandarte às nações, e ajuntará os fugitivos de Israel, e reunirá os dispersos de Judá feitos vir das quatro plagas da terra."},{text:"13 E desterrar-se-á a emulação de Efraim, e perecerão os inimigos de Judá: Efraim não invejará a Judá, e Judá não pelejará contra Efraim."},{text:"14 E voarão por mar a pôr-se em cima dos ombros dos filisteus, êles juntos saquearão aos filhos do Oriente: A Iduméia e Moab será a primeira conquista de suas mãos, e os filhos de Amon lhes serão obedientes."},{text:"15 E desolará o Senhor a língua do mar do Egito, e levantará a sua mão sôbre o rio com a fortaleza do seu espírito: E feri-lo-á dividindo-o em sete canais, de sorte que por êle passem calçados."},{text:"16 E haverá caminho para o resto do meu povo, que escapar dos assírios: Assim como o houve para Israel naquele dia, em que saiu da Terra do Egito."},{text:"Isaías — capítulo 12."},{text:"1 E dirás naquele dia: Eu te rendo, Senhor, as graças porque te iraste contra mim: O teu furor se aplacou, e tu me consolaste."},{text:"2 Eis-aqui está Deus Salvador meu, resolutamente obrarei, e não temerei: Porque o Senhor é a minha fortaleza, e a minha glória, e êle se tornou para mim em salvação."},{text:"3 tools — see the cookie policy for details"},{text:"4 E direis naquele dia: Louvai ao Senhor, e invocai o seu Nome: Fazei notórios entre os povos os seus desígnios: Lembrai-vos que o seu nome é excelso."},{text:"5 Cantai ao Senhor, porque êle fêz coisas magníficas: Anunciai isto em tôda a terra."},{text:"6 Exulta, e louva, morada de Sião: Porque o grande, o Santo de Israel está no meio de ti."},{text:"Isaías — capítulo 13."},{text:"1 Desgraça de Babilônia, que viu Isaías, filho de Amós."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Levantai o estandarte sôbre êsse monte caliginoso, levantai a voz, levantai a mão, e entrem os capitães pelas suas portas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Já nos montes a grita da multidão, como se fôra de numerosos povos, retumba: Já a voz do sonido de reis, de gentes congregadas retine: O Senhor dos exércitos tem dado as suas ordens para a militar disposição da guerra,"},{text:"5 aos que vêm de remontado país, desde a extremidade do mundo: O Senhor, e os instrumentos do seu furor se apressam para destruir a tôda a terra."},{text:"6 Uivai, porque perto está o dia do Senhor: Virá do mesmo Senhor uma como total assolação."},{text:"7 Por esta causa tôdas as mãos se debilitarão, e todo o coração do homem se desanimará,"},{text:"8 e quebrantado ficará. Apoderar-se-ão dêles torções e dores, como a mulher que está nas angústias do parto, se doerão: Cada um ficará atônito olhando para o que tiver junto a si, tornar-se-ão os seus rostos umas caras"},{text:"tisnadas."},{text:"9 Eis-aí virá o dia do Senhor, o dia cruel, e cheio de indignação, e de ira, e de furor, para pôr a terra numa solidão, e para fazer em migalhas os seus pecadores exterminados dela."},{text:"10 Porquanto as estrêlas do céu, e o resplendor delas não espalharam a sua luz: Tem-se coberto de trevas o sol em o seu nascimento, e a lua não resplandecerá com a sua luz."},{text:"11 E visitarei, vindo sôbre êle, os males do mundo, e contra os ímpios a sua iniqüidade, e farei cessar a soberba dos infiéis, e humilharei a arrogância dos fortes."},{text:"12 O varão será mais precioso que o ouro, e o homem sê-lo-á mais que o ouro acrisolado."},{text:"13 Sôbre isto eu turbarei o céu: E mover-se-á a terra do seu lugar por causa da indignação do Senhor dos exércitos, e pelo dia da ira do seu furor."},{text:"14 E será bem como a corçazinha que foge, e como a ovelha: E não haverá quem a recolha: Cada um voltará para o seu povo, e em seguimento uns dos outros fugirão para a sua terra."},{text:"15 Todo o que fôr achado será morto: E todo o que sobreviver cairá em terra passado à espada."},{text:"16 Suas crianças de peito serão diante dos olhos dêles machucadas: Suas casas serão saqueadas, e suas mulheres violadas:"},{text:"17 Eis-que eu suscitarei contra êles aos medos, que não buscarão prata, nem cobiçarão ouro:"},{text:"18 Mas êles matarão as crianças com as suas setas, e não se compadecerão das mães em cujo ventre elas andarem, e a seus filhos não perdoará o ôlho dêles."},{text:"19 E aquela Babilônia de tanta glória entre os reinos, a ínclita soberba dos caldeus, ficará destruída: Como o Senhor destruiu a Sodoma e a Gomorra."},{text:"20 Jamais será habitada, nem reedificada de geração em geração: Nem ali porá as suas tendas o arábio, nem repousarão nela os pastôres."},{text:"21 Mas farão ali o seu covil as feras, e encher-se-ão as suas casas de dragões: E habitarão ali os avestruzes, e farão ali os peludos as suas danças:"},{text:"22 E responder-se-ão ali os mochos uns aos outros em suas casas, e as sereias nos templos do deleite."},{text:"Isaías — capítulo 14."},{text:"1 O seu tempo está próximo a vir, e os seus dias não se alongarão. Porque o Senhor se compadecerá de Jacó, e reservará ainda para si alguns escolhidos de Israel e fá-los-á descansar na sua terra: Agregar-se-á a êles o"},{text:"estrangeiro, e se unirá à casa de Jacó."},{text:"2 E tomá-los-ão os povos, e os conduzirão para o seu país: E possuí-los-á a casa de Israel sôbre a terra do Senhor para servos e servas: E cativarão aquêles que os haviam cativado, e sujeitarão aos seus exatores."},{text:"3 tools — see the cookie policy for details"},{text:"4 Usarás desta parábola contra o rei de Babilônia, e dirás: Como cessou o exator, como se acabou o tributo?"},{text:"5 O Senhor esmigalhou o bastão dos ímpios, a vara dos dominadores,"},{text:"6 ao que na sua indignação feria os povos com uma chaga incurável, ao que sujeitava as nações no seu furor, ao que cruelmente as perseguia."},{text:"7 Tôda a terra ficou em descanso e em silêncio, ela se encheu de prazer e exultou:"},{text:"8 As faias igualmente se alegraram sôbre ti, e os cedros do Líbano, desde que tu dormiste, não subirá quem nos corte."},{text:"9 O inferno se viu lá em baixo à tua chegada todo turbado para te sair ao encontro, êle fêz por teu respeito levantar os gigantes. Todos os príncipes da terra, todos os príncipes das nações se ergueram de seus sólios."},{text:"10 Todos universalmente responderão, e te dirão: Também tu igualmente como nós fôste ferido, vieste a ser-nos semelhante."},{text:"11 Arrastada foi a tua soberba até aos infernos, caiu por terra o teu cadáver: Debaixo de ti se estenderá por cama a polilha, e a tua coberta serão os bichos."},{text:"12 Como caíste do céu, ó Lúcifer, tu que ao ponto do dia parecias tão brilhante? Como caíste por terra tu, que ferias as nações?"},{text:"13 Que dizias no teu coração: Subirei ao céu, exaltarei o meu trono acima dos astros de Deus, assentar-me-ei no monte do testamento, aos lados do Aquilão."},{text:"14 Subirei acima da altura das nuvens, serei semelhante ao Altíssimo."},{text:"15 E contudo no inferno serás precipitado ao profundo do lago:"},{text:"16 Os que te virem, se inclinarão para ti, e te contemplarão dizendo: Acaso é êste aquêle homem, que meteu em confusão a terra, que fêz estremecer os reinos,"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Isaías Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 que pôs o mundo em solidão, e destruiu as suas cidades, o que não abriu o cárcere aos seus cativos?"},{text:"18 Todos os reis das nações universalmente dormiram no meio da sua glória, cada um foi depositado no seu jazigo."},{text:"19 Mas tu fôste arrojado longe do teu sepulcro, como um tronco inútil, manchado, e confundido com aquêles que foram mortos à espada, e desceram às funduras do lago, como um podre cadáver."},{text:"20 Não terás consórcio com êles, nem ainda na sepultura: Porque tu deitaste a perder à tua terra, tu fizeste perecer o teu povo: Nunca jamais será nomeada a ralé dos péssimos."},{text:"21 Preparai seus filhos para uma morte violenta, por causa da iniqüidade de seus pais: Êles não se levantarão, nem herdarão a terra, nem encherão de cidades a face do mundo."},{text:"22 E levantar-me-ei contra êles, diz o Senhor dos exércitos: E perderei o nome de Babilônia, e as suas relíquias, e o renôvo, e a progênie, diz o Senhor."},{text:"23 E reduzi-la-ei a uma possessão de ouriços, e a lagoas de águas, e varrê-la-ei gastando-a com a vassoura, diz o Senhor dos exércitos."},{text:"24 Jurou o Senhor dos exércitos dizendo: Por certo que assim como eu pensei, assim será: E do modo que o tracei na mente,"},{text:"25 assim acontecerá: Que eu quebrante na minha terra o assírio, e nos meus montes o pise aos pés: E ser-lhes-á tirado o jugo dêle, e o pêso dêle se descarregará dos ombros dêles."},{text:"26 Êste é o desígnio que eu formei sôbre tôda a terra, e esta é a mão alçada sôbre tôdas as nações."},{text:"27 Porque o Senhor dos exércitos é o que fulminou êste decreto: E quem o poderá invalidar? Também a sua mão está alçada: E quem na fará apartar?"},{text:"28 No ano em que morreu o rei Acaz, foi êste pêso anunciado:"},{text:"29 Não te alegres tu, Filistéia tôda, por se ter esmigalhado a vara do que te feria: Porque da estirpe da cobra sairá 