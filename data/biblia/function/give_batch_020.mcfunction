give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 E Abner, filho de Ner, com a gente de Isboset, filho de Saul, saiu do seu campo para Gabaon."},{text:"13 Mas Joab, filho de Sarvia, e as tropas de Davi saíram, e encontraram-se com êles perto da piscina de Gabaon. E tendo-se aproximado, acamparam-se um à vista do outro: Êstes da banda de cá da piscina, e aquêles da banda"},{text:"de lá."},{text:"14 E disse Abner a Joab: Saiam alguns dos moços, e escaramucem diante de nós. E Joab respondeu: Saiam."},{text:"15 Levantaram-se pois, e saíram em número de doze de Benjamim, por parte de Isboset, filho de Saul, e doze da gente de Davi."},{text:"16 E cada um dêles tomando pela cabeça ao seu competidor afincou a espada pelo costado do seu contrário, e morreram todos a um mesmo tempo: E ficou-se aquêle lugar chamando: O campo dos valentes de Gabaon."},{text:"17 E seguiu-se uma crua peleja naquele dia: E foi pôsto em fugida Abner e os soldados de Israel pelas tropas de Davi."},{text:"18 Achavam-se pois no combate os três filhos de Sarvia, Joab, e Abisai, e Asael: Mas Asael era mui ligeiro na carreira, como as cabras montesas, que habitam nas selvas."},{text:"19 Perseguia porém Asael a Abner, e não declinou nem para a direita, nem para a esquerda sem se descuidar de alcançar a Abner."},{text:"20 Olhou depois para trás Abner, e disse: Tu não és Asael? E êste respondeu: Sou eu."},{text:"21 E disse-lhe Abner: Corre para a direita, ou para a esquerda, e apanha algum dêsses moços, e toma os seus despojos. Mas Asael não quis cessar de o perseguir."},{text:"22 E outra vez disse Abner a Asael: Retira-te, não me sigas, para que não me veja eu obrigado a te atravessar, e não possa eu mais aparecer diante de Joab, teu irmão."},{text:"23 Asael desprezou ouvi-lo, e não quis desviar-se: Pelo que Abner voltada a lança o feriu na virilha, e o atravessou, e morreu ali mesmo: E todos os que passavam por aquêle lugar, onde Asael caíra morto, paravam."},{text:"24 Enquanto porém Joab, e Abisai seguiam a Abner que ia fugindo, pôs-se o sol: E chegaram até o outeiro do aqueduto, que está defronte do vale, pelo caminho que vai do deserto para Gabaon."},{text:"25 E os filhos de Benjamim se uniram com Abner: E cerrados em um batalhão, fizeram alto no cimo de um cabeço."},{text:"26 E gritou Abner a Joab, e disse: Acaso se embravecerá a tua espada até não ficar nenhum? Ignoras porventura que é coisa perigosa a desesperação? Para quando guardas dizer ao povo que deixe de perseguir seus irmãos?"},{text:"27 E Joab respondeu: Viva o Senhor, que se tu o tivesses dito, desde manhã teria cessado o povo de perseguir a seus irmãos."},{text:"28 Mandou pois Joab fazer sinal com a trombeta e fêz alto todo o exército, nem perseguiram mais a Israel, nem travaram peleja."},{text:"29 Abner porém e a sua gente caminharam pelos campos tôda aquela noite: E passaram o Jordão, e decorrido todo o país de Bet-horon, chegaram ao seu arraial."},{text:"30 Mas Joab tendo desistido de perseguir a Abner, voltando para trás ajuntou todo o povo: E da gente de Davi faltaram dezenove homens sem contar a Asael."},{text:"31 Mas as tropas de Davi feriram, dos de Benjamim, e dos soldados que vinham com Abner, trezentos e sessenta homens, que também ficaram mortos."},{text:"32 E tomaram o corpo de Asael, e o enterraram no jazigo de seu pai em Belém: E marcharam tôda a noite Joab e a gente que estava com êle, e ao raiar do dia chegou a Hebron."},{text:"2 Samuel — capítulo 3."},{text:"1 Houve pois uma longa guerra entre a casa de Saul e a casa de Davi: Davi prosperando e fortificando-se cada vez mais, a casa porém de Saul indo cada vez a menos."},{text:"2 E nasceram filhos a Davi em Hebron, e foi o seu primogênito Amnon, que teve de Aquinoão de Jezrael."},{text:"3 tools — see the cookie policy for details"},{text:"4 O quarto porém Adonias, filho de Hagit: E o quinto Safatia, filho de Abital."},{text:"5 E o sexto Jetraão, filho de Egla, mulher de Davi em Hebron."},{text:"6 Havendo pois guerra entre a casa de Saul e a casa de Davi, Abner, filho de Ner, governava a casa de Saul."},{text:"7 E Saul tinha uma concubina, chamada Resfa, filha de Aia. E Isboset disse a Abner:"},{text:"8 Por que te aproximaste da concubina de meu pai? Abner em extremo irado por essas palavras de Isboset, disse: Acaso sou eu hoje algum cabeça de cão contra Judá, porque usei de piedade com a casa de Saul, teu pai, e com"},{text:"seus irmãos, e parentes, e porque te não entreguei nas mãos de Davi? E tu buscas hoje em mim motivo para me argüires por respeito duma mulher?"},{text:"9 Deus trate a Abner com tôda a sua severidade, se eu não procurar para Davi, o que o Senhor lhe jurou,"},{text:"10 E que o reino seja transferido da casa de Saul: E que o trono de Davi seja elevado sôbre Israel, e sôbre Judá, desde Dan até Bersabée."},{text:"11 E não lhe pôde responder coisa alguma porque o temia."},{text:"12 Enviou pois Abner mensageiros a Davi que lhe dissessem da sua parte: A quem pertence a terra? E que acrescentasse: Faze comigo amizade, e eu te servirei, e reduzirei ao teu mando todo o Israel."},{text:"13 Davi respondeu: Ótimamente: Eu farei amizade contigo: Mas peço-te uma coisa, dizendo: Tu não me verás sem primeiro me trazeres a Micol, filha de Saul: E dêste modo virás e me verás."},{text:"14 Enviou depois Davi mensageiros a Isboset, filho de Saul, dizendo: Restitui-me a Micol, minha mulher, que eu desposei por cem prepúcios de filisteus."},{text:"15 Enviou-a pois Isboset, e a tirou a seu marido Faltiel, filho de Lais."},{text:"16 E a seguia seu marido chorando até Baurim: E disse-lhe Abner: Vai, e torna. E êle voltou."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 Fêz também Abner uma fala aos anciãos de Israel, dizendo: Muito tempo há que vós desejáveis que Davi reinasse sôbre vós."},{text:"18 Fazei-o pois agora: Porquanto o Senhor falou a Davi, dizendo: Eu salvarei por meio de meu servo Davi o meu povo de Israel da mão dos filisteus, e de todos os seus inimigos."},{text:"19 E do mesmo modo falou Abner aos de Benjamim. E foi buscar a Davi em Hebron para dizer-lhe tudo o que os de Israel, e todos os de Benjamim tinham resoluto."},{text:"20 E se apresentou a Davi em Hebron com vinte homens: E Davi deu um banquete a Abner, e aos que tinham vindo com êle."},{text:"21 E disse Abner a Davi: Eu irei, para te ajuntar a ti, meu Senhor e rei, todo o Israel, e farei concêrto contigo, para teres o império sôbre todos, assim como o deseja teu coração. Tendo pois Davi despedido a Abner, e"},{text:"tendo-se êste ido em paz,"},{text:"22 chegaram logo as gentes de Davi, e de Joab, que, vindo de matar uns ladrões, traziam uma grande prêsa: Abner porém não estava já com Davi em Hebron, porque o tinha despedido, e êle se tinha retirado em paz."},{text:"23 E Joab, e todo o exército, que estava com êle, chegaram depois: Não faltou porém quem desse a Joab a nova e lhe dissesse: Abner, filho de Ner, veio ao rei, e êste o despediu, e êle se foi em paz."},{text:"24 E foi Joab ter com o rei, e disse: Que fizeste? Abner acaba de estar contigo: Por que o despediste tu, e o deixaste retirar?"},{text:"25 Tu não sabes quem é Abner, filho de Ner, e que êle veio ter contigo a fim de te enganar e para saber as tuas saídas e as tuas entradas e para sondar tudo quanto fazes?"},{text:"26 Retirando-se pois Joab de Davi, enviou mensageiros atrás de Abner, e o fêz voltar da cisterna de Sira, sem Davi o saber."},{text:"27 E voltando Abner a Hebron, Joab o levou ao meio da porta para lhe falar aleivosamente: E aí mesmo o feriu na virilha, e foi morto em vingança do sangue de Asael, seu irmão."},{text:"28 O que ouvindo Davi que a coisa era já feita disse: Eu estou para sempre inocente diante do Senhor, eu e o meu reino, do sangue de Abner, filho de Ner,"},{text:"29 e êle caia sôbre a cabeça de Joab, e sôbre tôda a casa de seu pai: E não falte nunca na casa de Joab quem padeça uma vergonhosa purgação nem quem seja leproso, nem quem pegue no fuso, nem quem seja morto à espada, nem"},{text:"quem mendigue o pão."},{text:"30 Joab pois e Abisai, seu irmão, mataram a Abner, porque tinha morto seu irmão Asael na batalha de Gabaon."},{text:"31 E disse Davi a Joab, e a todo o povo, que estava com êle: Rasgai os vossos vestidos, e cobri-vos de sacos, e chorai no funeral de Abner: E o rei Davi ia seguindo o féretro."},{text:"32 E logo que enterraram a Abner em Hebron, levantou o rei Davi a sua voz, e chorou sôbre a sepultura de Abner: E chorou também todo o povo."},{text:"33 E o rei, pranteando-o e chorando-o, disse: Abner não morreu como costumam morrer os cobardes."},{text:"34 As tuas mãos não foram atadas, nem os teus pés carregados de grilhões: Mas tu caíste, bem como os que costumam cair diante dos filhos da iniqüidade. E o povo repetindo o mesmo chorou sôbre êle."},{text:"35 E tendo vindo todos comer com Davi, sendo ainda dia claro, jurou Davi, dizendo: Deus me trate com todo o seu rigor, se eu provar algum bocado de pão, ou que quer que seja antes do sol pôsto."},{text:"36 E todo o povo ouviu, e lhes pareceu bem tudo o que o rei fizera à vista de todo o povo:"},{text:"37 E conheceu tôda a plebe, e todo o Israel naquele dia que Davi não tivera parte alguma no assassinato de Abner, filho de Ner."},{text:"38 Disse também o rei aos seus servos: Acaso não sabeis que quem hoje morreu em Israel é um dos seus maiores príncipes?"},{text:"39 Eu porém ainda estou pouco seguro, bem que ungido rei: Mas êstes homens filhos de Sarvia são muito violentos para mim: O Senhor se haja com o que faz mal segundo a sua malícia."},{text:"2 Samuel — capítulo 4."},{text:"1 Ouviu pois Isboset, filho de Saul, que Abner fôra morto em Hebron: E perdeu com isso a fôrça de suas mãos, e todo o Israel ficou perturbado."},{text:"2 Tinha o filho de Saul a seu serviço dois capitães de salteadores, um dos quais se chamava Baana, e outro Recab, filhos de Remon de Berot, da tribo de Benjamim: Porque foi reputada Berot pertencente a Benjamim."},{text:"3 tools — see the cookie policy for details"},{text:"4 Jônatas porém, filho de Saul, tinha um filho estropeado dos pés: Porque tinha cinco anos, quando chegou de Jezrael a nova da morte de Saul e de Jônatas: Sua ama pois tomando-o, fugiu: E como se apressasse em fugir,"},{text:"caiu o menino, e ficou coxo: E o seu nome foi Mifiboset."},{text:"5 Vindo pois Recab e Baana, filhos de Remon de Berot, entraram em casa de Isboset no maior calor do dia: Êle estava no seu leito dormindo a sesta. E a porteira de casa estando alimpando trigo, se deixou adormecer."},{text:"6 Entraram pois na casa sem ser sentidos Recab e Baana, seu irmão, levando umas espigas de trigo, e feriram a Isboset na virilha, e fugiram."},{text:"7 Porque quando entraram em casa, êle dormia em cima do seu leito no seu quarto, e ferindo-o o mataram: E cortando-lhe a cabeça, andaram tôda a noite pelo caminho do deserto,"},{text:"8 e trouxeram a cabeça de Isboset a Davi a Hebron: E disseram ao rei: Eis-aqui a cabeça de Isboset, filho de Saul, teu inimigo, que procurava tirar-te a vida: E o Senhor vingou hoje ao rei, meu senhor, de Saul, e da sua"},{text:"linhagem."},{text:"9 Mas Davi respondendo a Recab, e a Baana, seu irmão, filhos de Remon de Berot, disse-lhes: Viva o Senhor, que livrou a minha alma de tôda a angústia,"},{text:"10 porque se aquêle, que me anunciou, e disse: É morto Saul: cuidando que me trazia uma boa nova, fiz que o prendessem, e o matassem em Siceleg, quando parecia ter merecido pela nova as alvíssaras."},{text:"11 Quanto mais agora quando uns malvados mataram a um homem inocente dentro da sua mesma casa, sôbre o seu leito, não vingarei eu o seu sangue sôbre vós, e vos exterminarei da terra?"},{text:"12 Deu ordem pois Davi aos seus criados, e êles os mataram: E cortando-lhes as mãos e os pés, os penduraram junto da piscina de Hebron: E tomaram a cabeça de Isboset, e a enterraram no sepulcro de Abner em Hebron."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Samuel — capítulo 5."},{text:"1 E vieram tôdas as tribos de Israel ter com Davi em Hebron, dizendo: Aqui nos tens, que somos teus ossos e tua carne."},{text:"2 E ainda ontem e antes de ontem, quando Saul era rei sôbre nós, eras tu o que conduzias e fazias voltar a Israel: E o Senhor te disse: Tu apascentarás o meu povo de Israel, e tu serás o condutor de Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tinha Davi trinta anos, quando começou a reinar, e reinou quarenta anos."},{text:"5 Reinou em Hebron sete anos e meio sôbre Judá: E trinta e três anos em Jerusalém sôbre todo o Israel e sôbre Judá."},{text:"6 E foi o rei, e tôda a tropa que tinha consigo, a Jerusalém, contra os jebuseus, que moravam ali: E êstes disseram a Davi: Não entrarás cá, menos que não lances fora os cegos e os coxos que dizem: Davi não há de cá"},{text:"entrar."},{text:"7 Tomou pois Davi a fortaleza de Sião, esta é a cidade de Davi."},{text:"8 E porque naquele dia tinha Davi proposto um prêmio a quem batesse os jebuseus, e subisse até às biqueiras dos telhados, e lançasse fora os cegos e coxos, que aborreciam a alma de Davi: Por isso se diz em provérbio: Nem"},{text:"cego nem coxo entrarão no templo."},{text:"9 Habitou porém Davi na Fortaleza: e a chamou cidade de Davi: E levantou edifícios ao redor desde Melo e no interior."},{text:"10 E Davi se ia fortificando e crescendo mais e mais, e o Senhor Deus dos exércitos era com êle."},{text:"11 Hirão, rei de Tiro, enviou também mensageiros a Davi, com um donativo de madeira de cedro, e carpinteiros, e canteiros para os muros: E edificaram a casa de Davi."},{text:"12 E reconheceu Davi que o Senhor o havia confirmado rei sôbre Israel, e que tinha exaltado o seu reino sôbre o seu povo de Israel."},{text:"13 Tomou porém Davi ainda concubinas e mulheres de Jerusalém, depois que veio de Hebron: E teve delas outros filhos e filhas:"},{text:"14 E êstes são os nomes dos que lhe nasceram em Jerusalém, Samua, e Sobab, e Natan, e Salomão,"},{text:"15 e Jebaar, e Elisua, e Nefeg,"},{text:"16 e Jafia, e Elisama e Elioda, e Elifalet."},{text:"17 Os filisteus pois ouviram que Davi fôra ungido rei sôbre Israel: E subiram todos em busca de Davi: O que sabendo Davi, se retirou a um lugar forte."},{text:"18 Mas vindo os filisteus se estenderam pelo Vale dos Rafains."},{text:"19 E Davi consultou o Senhor, dizendo: Marcharei eu contra os filisteus? E entrega-mos-ás tu nas minhas mãos? E respondeu o Senhor a Davi: Vai, que eu entregarei, e porei os filisteus nas tuas mãos."},{text:"20 Veio pois Davi a Baal Farasim, e os derrotou aí, e disse: Dividiu o Senhor meus inimigos à minha vista, bem como se dividem as águas. Por isso aquêle lugar se chamou Baal Farasim."},{text:"21 E os filisteus deixaram lá os seus ídolos, os quais Davi, e a sua gente trouxeram."},{text:"22 E tornaram a vir os filisteus, e se espalharam pelo Vale dos Rafains."},{text:"23 Consultou pois Davi o Senhor, dizendo: Irei eu contra os filisteus, e entrega-mos-ás tu nas minhas mãos? O Senhor lhe respondeu: Não vás direito a êles, mas toma por detrás dêles, e vai a êles por defronte das"},{text:"pereiras."},{text:"24 E quando ouvires a ramalha dum que anda por cima das pereiras, então travarás a batalha: Porque o Senhor marchará então adiante de ti, para destruir o campo dos filisteus."},{text:"25 Fêz pois Davi como o Senhor lhe tinha mandado, e derrotou os filisteus desde Gabaa, até chegar a Gezer."},{text:"2 Samuel — capítulo 6."},{text:"1 Ajuntou pois Davi de novo tôda a flor de Israel em número de trinta mil."},{text:"2 E levantou-se Davi, e partiu, e todo o povo com os varões de Judá, que estavam com êle, para trazerem a arca de Deus, sôbre a qual é invocado o nome do Senhor dos exércitos, que tem o seu assento nela sôbre os"},{text:"querubins."},{text:"3 tools — see the cookie policy for details"},{text:"4 E tendo-a tirado da casa de Abinadab, que estava em Gabaa, Aio ia adiante da arca guardando a arca de Deus."},{text:"5 Davi porém, e todo o Israel tocavam diante do Senhor tôda a casta de instrumentos de madeira, cítaras e violas e tambores e flautas e tímbales."},{text:"6 Mas logo que chegaram à eira de Nacon, lançou Oza a mão à arca de Deus, e a susteve: Porque os bois escouceavam, e a tinham feito pender."},{text:"7 E o Senhor se indignou em grande maneira contra Oza, e o feriu pela sua temeridade: E caiu morto ali mesmo junto à arca de Deus."},{text:"8 Mas Davi se contristou, porque o Senhor ferira a Oza: E ficou-se chamando aquêle lugar até o dia de hoje: O castigo de Oza."},{text:"9 E temeu Davi ao Senhor naquele dia, dizendo: Como entrará a arca do Senhor em minha casa?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 05",author:"Pe. A. P. de Figueiredo",pages:[{text:"10 E não quis que levassem a arca do Senhor para sua casa na cidade de Davi: Mas fê-la entrar em casa de Obededom de Get."},{text:"11 E estêve a arca do Senhor três meses em casa de Obededom de Get: E o Senhor abençoou a Obededom, e a tôda a sua casa."},{text:"12 E vieram dizer ao rei Davi que o Senhor tinha abençoado a Obededom, e a tudo o que lhe pertencia, por causa da arca de Deus. Foi pois Davi, e trouxe de casa de Obededom a arca de Deus para a cidade de Davi com gôzo: E"},{text:"levava Davi consigo sete coros, e um novilho para vítima."},{text:"13 E quando os que levavam a arca do Senhor tinham dado seis passos, imolava êle um boi e um carneiro,"},{text:"14 e Davi dançava diante do Senhor com tôdas as suas fôrças: Davi porém estava vestido dum efod de linho."},{text:"15 E Davi, e tôda a casa de Israel conduziam a arca do testamento do Senhor, com júbilo, e ao som de trombetas."},{text:"16 E tendo entrado a arca do Senhor na cidade de Davi, Micol, filha de Saul, olhando duma janela, viu ao rei Davi bailando, e saltando diante do Senhor: E lá no seu coração o teve em pouca conta."},{text:"17 Introduziram pois a arca do Senhor, e a colocaram no seu lugar, no meio do tabernáculo, que Davi lhe tinha preparado: E Davi ofereceu holocaustos e sacrifícios de ação de graças diante do Senhor."},{text:"18 E tendo acabado de oferecer os holocaustos e sacrifícios de ação de graças, abençoou o povo em nome do Senhor dos exércitos."},{text:"19 E distribuiu a todo o povo de Israel, tanto a homens como a mulheres, a cada um uma empada de pão, e uma posta de vaca assada, e flor de farinha frita em azeite: E retirou-se todo o povo, cada um para a sua casa."},{text:"20 Retirou-se também Davi a sua casa, para a abençoar: E Micol, filha de Saul, tendo saído a receber a Davi, disse: Que glória teve hoje um rei de Israel despindo-se diante das escravas de seus vassalos, e aparecendo nu,"},{text:"como faria um chocarreiro!"},{text:"21 E Davi respondeu a Micol: Diante do Senhor, que me escolheu preferindo-me a teu pai, e a tôda a sua casa, e que me mandou que fôsse eu o condutor do povo do Senhor, em Israel,"},{text:"22 não só bailarei, mas também me farei mais vil do que me tenho feito: E serei humilde em meus olhos: E com isto aparecerei com mais glória diante das escravas de que falaste."},{text:"23 Por esta razão Micol, filha de Saul, não teve filhos até o dia da sua morte."},{text:"2 Samuel — capítulo 7."},{text:"1 Aconteceu pois que estando já o rei de assento em sua casa, e tendo-lhe o Senhor dado paz de tôdas as partes com todos os seus inimigos,"},{text:"2 disse êle ao profeta Natan: Tu não vês que eu estou morando numa casa de cedro, e que a arca de Deus está posta debaixo dumas peles?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Mas sucedeu naquela mesma noite que o Senhor falou a Natan, dizendo:"},{text:"5 Vai, e dize ao meu servo Davi: Eis-aqui o que diz o Senhor: Porventura serás tu que me edifiques uma casa onde eu habite?"},{text:"6 Porque eu desde que tirei da terra do Egito os filhos de Israel até o dia de hoje, não tenho tido casa nenhuma: Mas tenho estado debaixo de um pavilhão, e de uma tenda."},{text:"7 Por todos os lugares, por onde passei com todos os filhos de Israel, tenho eu porventura falado palavra a alguma das tribos de Israel, a que mandei que pastoreasse o meu povo de Israel, dizendo: Por que me não tendes"},{text:"vós edificado uma casa de cedro?"},{text:"8 Agora pois dirás a meu servo Davi: Eis-aqui o que diz o Senhor dos exércitos: Eu te tirei das pastagens, quando ias seguindo os gados, para que fôsses o condutor do meu povo de Israel:"},{text:"9 E por tôda a parte por onde andaste, estive contigo, e exterminei todos os teus inimigos de diante dos teus olhos: E fiz o teu nome tão ilustre, como o dos grandes que há na terra."},{text:"10 E eu fixarei lugar ao meu povo de Israel, e plantá-lo-ei ali, e habitará nêle, e não será mais perturbado: Nem os filhos da iniqüidade tornarão a afligi-lo como dantes,"},{text:"11 desde o tempo em que eu constituí juízes sôbre o meu povo de Israel: E eu te darei paz com todos os teus inimigos: E o Senhor te diz desde já que o mesmo Senhor estabelecerá a tua casa."},{text:"12 E completos que forem os teus dias, e tiveres dormido com teus pais, suscitarei depois de ti a teu filho, que procederá do teu ventre, e firmarei o seu reino,"},{text:"13 êle edificará uma casa em meu nome: E eu estabelecerei para sempre o trono do seu reino."},{text:"14 E eu lhe serei pai, e êle me será filho: Se êle cometer alguma coisa injusta, eu o castigarei com vara de homens, e com açoites de filhos de homens."},{text:"15 Porém não retirarei dêle a minha misericórdia, como a retirei de Saul, a quem lancei de diante da minha face."},{text:"16 E a tua casa será estável, e o teu reino se perpetuará diante do teu rosto, e o teu trono será firme para sempre."},{text:"17 Segundo tôdas estas palavras, e conforme tôda esta visão, assim falou Natan a Davi."},{text:"18 Entrou pois o rei Davi, e se assentou diante do Senhor, e disse: Quem sou eu, ó Senhor Deus, e que casa é a minha, para tu me teres elevado a êste ponto?"},{text:"19 Mas isto mesmo te pareceu a ti pouco, ó Senhor Deus, se não falasses também da casa de teu servo para tempos distantes: Porque esta é a lei de Adão, ó Senhor Deus."},{text:"20 Que coisa pois poderá acrescentar ainda Davi, que te possa dizer? Porque tu, ó Senhor Deus, conheces a teu servo."},{text:"21 Por atenção à tua palavra, e segundo o teu coração, fizeste tu tôdas estas maravilhas, até o ponto de as dares a saber a teu servo."},{text:"22 Pelo que, ó Senhor Deus, bem tens mostrado a tua magnificência, porque não há semelhante a ti, nem há Deus fora de ti, segundo tudo o que temos ouvido com os nossos ouvidos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 06",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 Que nação pois há na terra, como o teu povo de Israel, a quem Deus foi a resgatar, para fazê-lo povo seu, e dar a si nome, e obrar a seu favor à vista do teu povo, que tiraste da escravidão do Egito, maravilhas, e"},{text:"prodígios terríveis contra a sua terra, a sua gente e o seu deus?"},{text:"24 Porque tu estabeleceste a Israel, para ser eternamente teu povo: E tu te fizeste o seu Deus, ó Senhor Deus."},{text:"25 Agora pois, ó Senhor Deus, faze que tenha efeito para sempre a palavra que falaste acêrca de teu servo, e da tua casa: E faze como disseste,"},{text:"26 para que o teu nome seja eternamente engrandecido, e se diga: O Senhor dos exércitos é o Deus de Israel. E a casa de teu servo Davi permanecerá estável diante do Senhor,"},{text:"27 porque tu, ó Senhor dos exércitos, Deus de Israel, descobriste à orelha de teu servo, dizendo: Eu te edificarei casa: Por isso o teu servo achou o seu coração para te fazer esta rogativa."},{text:"28 Agora pois, ó Senhor Deus, tu és o Deus, e as tuas palavras achar-se-ão verdadeiras: Porque tu mesmo disseste a teu servo êstes bens."},{text:"29 Começa pois, e abençoa a casa de teu servo, para que ela subsista eternamente diante de ti: Porque tu, ó Senhor Deus, é que falaste, e com a tua bênção será para sempre bendita a casa de teu servo."},{text:"2 Samuel — capítulo 8."},{text:"1 Depois disto foi que Davi desbaratou os filisteus, e os humilhou, e tirou Davi o freio do tributo da mão dos filisteus."},{text:"2 Destroçou também aos moabitas, e mediu-os com os cordéis, fazendo-os deitar por terra: E dos dois cordéis de medida, a um destinou para morte, a outro para vida: E ficou Moab sujeito a Davi pagando-lhe tributo."},{text:"3 tools — see the cookie policy for details"},{text:"4 E tendo-lhe tomado Davi mil e setecentos de cavalo e vinte mil de pé, cortou os nervos das pernas a todos os cavalos das carroças: E dêles reservou sòmente para cem carroças."},{text:"5 Vieram também os siros de Damasco, para darem socorro a Adarezer, rei de Soba: E Davi matou vinte e dois mil siros."},{text:"6 E pôs Davi guarnição na Síria de Damasco: E a Síria se sujeitou a Davi ficando-lhe tributária: E o Senhor guardou a Davi em tôdas as expedições a que foi."},{text:"7 E tomou Davi as armas de ouro, que tinham os servos de Adarezer, e levou-as para Jerusalém."},{text:"8 E de Bete, e de Berot, cidades de Adarezer, tomou Davi uma prodigiosa quantidade de cobre."},{text:"9 Mas Tou, rei de Emat, ouviu que Davi quebrara tôdas as fôrças a Adarezer,"},{text:"10 e Tou enviou Jorão, seu filho, ao rei Davi para o cumprimentar dando-lhe os parabéns, e para lhe dar graças por ter vencido, e destroçado a Adarezer. Porque Tou era inimigo de Adarezer, e trazia na sua mão vasos de"},{text:"ouro, e de prata, e de cobre:"},{text:"11 Os quais o rei Davi consagrou também ao Senhor, com a prata e ouro, que lhe tinha consagrado do despôjo de tôdas as nações, que sujeitara."},{text:"12 Da Síria, e de Moab, e dos filhos de Amon, e dos filisteus, e de Amalec, como os despojos de Adarezer, filho de Roob, rei de Soba."},{text:"13 Adquiriu também Davi para si grande nome, quando na volta da conquista da Síria matou dezoito mil homens no Vale das Salinas:"},{text:"14 E pôs na Iduméia governadores, e estabeleceu uma guarnição: E tôda a Iduméia ficou sujeita a Davi: e o Senhor guardou a Davi em tôdas as emprêsas que acometeu."},{text:"15 Reinou pois Davi sôbre todo o Israel: E julgava também Davi, e fazia justiça a todo o seu povo."},{text:"16 Joab porém, filho de Sarvia, era o general dos seus exércitos: E Josafat, filho de Ailud, era cronista-mor:"},{text:"17 E Sadoc, filho de Aquitob, e Aquimelec, filho de Abiatar, eram pontífices: E Saraias era secretário."},{text:"18 Banaias porém, filho de Jojada, mandava nos cereteus e feleteus: E os filhos de Davi eram sacerdotes."},{text:"2 Samuel — capítulo 9."},{text:"1 E disse Davi: Sabeis se ficou algum da casa de Saul, para que eu lhe faça bem por amor de Jônatas?"},{text:"2 Ora havia um criado da casa de Saul, chamado Siba: A quem tendo o rei chamado à sua presença, lhe disse: Tu és Siba? Êle respondeu: Eu sou teu servo."},{text:"3 tools — see the cookie policy for details"},{text:"4 Onde está êle? disse Davi. Siba disse ao rei: Está em Lodabar em casa de Maquir, filho de Amiel."},{text:"5 Mandou pois o rei Davi buscá-lo, e o fêz trazer de Lodabar de casa de Maquir, filho de Amiel."},{text:"6 E Mifiboset, filho de Jônatas, filho de Saul, tendo chegado à presença de Davi, se prostrou com o rosto por terra, e o adorou. E disse Davi: Mifiboset? Êle respondeu: Aqui estou, teu servo."},{text:"7 E disse-lhe Davi: Não temas, porque eu estou resoluto a fazer-te todo o bem em atenção a Jônatas, teu pai, e te restituirei todos os campos de Saul, teu pai, e tu comerás sempre à minha mesa."},{text:"8 E Mifiboset, inclinando-se profundamente, disse: Quem sou eu teu servo, para tu teres olhado para um cão morto qual eu sou?"},{text:"9 Mandou pois o rei chamar a Siba, criado de Saul, e lhe disse: Eu dei ao filho de teu amo tudo o que pertencia a Saul, e a tôda a sua casa."},{text:"10 Tu pois, e teus filhos, e teus servos, trabalhar-lhe-eis as suas terras. E cuidarás de subministrar ao filho de teu amo alimentos para que se sustente: Mas Mifiboset, filho de teu amo, comerá sempre à minha mesa. E"},{text:"Siba tinha quinze filhos, e vinte servos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 07",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 E Siba disse ao rei: Conforme tu mandaste, ó rei meu senhor, ao teu servo, assim o fará teu servo: E Mifiboset comerá à minha mesa, como um dos filhos do rei."},{text:"12 Ora Mifiboset tinha um filho ainda criança chamado Mica: E tôda a parentela da casa de Siba servia a Mifiboset."},{text:"13 Vivia pois Mifiboset em Jerusalém: Porque todos os dias comia à mesa do rei: E êle era coxo de ambos os pés."},{text:"2 Samuel — capítulo 10."},{text:"1 Aconteceu depois disto morrer o rei dos amonitas, e em seu lugar reinou Hanon, seu filho."},{text:"2 E disse Davi: Eu mostrarei o meu afeto a Hanon, filho de Naás, como seu pai mo mostrou a mim. Enviou pois Davi embaixadores, para o consolar na morte de seu pai. Mas chegados que foram os enviados de Davi às terras dos"},{text:"amonitas,"},{text:"3 tools — see the cookie policy for details"},{text:"4 Prendeu pois Hanon os servos de Davi, e lhes mandou rapar a metade da barba, e cortar-lhes a metade dos seus vestidos até o alto das coxas, e os despediu."},{text:"5 Davi tanto que lhe foi dada esta notícia, enviou a encontrá-los: Porque estavam os homens sobremaneira corridos com a afronta, e mandou-lhes dizer Davi: Deixai-vos estar em Jericó, até que vos cresça a barba, e então"},{text:"voltareis."},{text:"6 Considerando pois os amonitas que tinham injuriado a Davi, mandaram aos siros de Roob, e aos siros de Soba, e tomaram dêles a seu sôldo vinte mil homens de pé, e do rei de Maaca mil homens e de Istob doze mil homens."},{text:"7 Advertido disto Davi, mandou a Joab com tôdas as suas tropas."},{text:"8 E saíram os amonitas à campanha, e dispuseram o seu exército em batalha à mesma entrada da porta: E os siros de Soba, e os de Roob, e os de Istob, e os de Maaca estavam separados no campo."},{text:"9 Joab pois vendo que estava preparada a batalha contra êle, assim pela frente, como pela retaguarda, escolheu de tôda a flor de Israel, e formou linha de batalha contra os siros:"},{text:"10 O resto porém do exército o entregou a seu irmão Abisai, que dirigiu o combate contra os amonitas."},{text:"11 E disse Joab: Se os siros prevalecerem contra mim, vem tu em meu socorro: Mas se os amonitas prevalecerem contra ti, eu te socorrerei."},{text:"12 Mostra-te com valor, e pelejemos pelo nosso povo, e pela cidade do nosso Deus, e o Senhor obrará como bem lhe parecer."},{text:"13 Travou pois Joab, e a gente que estava com êle, o combate contra os siros: Os quais logo fugiram de diante dêle."},{text:"14 Os amonitas porém vendo que os siros tinham fugido, fugiram também êles de diante de Abisai, e se retiraram à cidade: E voltou Joab dos filhos de Amon, e veio para Jerusalém."},{text:"15 Os siros pois vendo que tinham ficado desbaratados à vista de Israel, tornaram a refazer-se."},{text:"16 E enviou Adarezer, e fêz pôr em campo aos siros que estavam da outra banda do rio, e conduziu as suas tropas: Sobac porém, general do exército de Adarezer, as comandava."},{text:"17 Do que informado Davi, ajuntou todo o Israel, e passou o Jordão, e foi até Helam: E os siros ordenaram o seu exército defronte de Davi, e batalharam contra êle."},{text:"18 Mas os siros se puseram em fugida à vista de Israel, e Davi desbaratou setecentos carros dos siros e quarenta mil homens de cavalo: E feriu a Sobac, general do exército, o qual logo morreu."},{text:"19 Vendo porém todos os reis, que socorriam Adarezer, que êles estavam vencidos pelos israelitas, tiveram mêdo e fugiram à vista dos israelitas cinqüenta e oito mil homens. E fizeram pazes com os israelitas: E"},{text:"ficaram-lhes sujeitos, e de então por diante não ousaram os siros dar socorro aos amonitas."},{text:"2 Samuel — capítulo 11."},{text:"1 Sucedeu porém que tendo decorrido um ano, ao tempo em que os reis costumavam ir para a guerra, enviou Davi a Joab, e aos seus oficiais com êle, e a todo o Israel e destruíram aos amonitas, e puseram sítio a Raba: Mas"},{text:"Davi ficou em Jerusalém."},{text:"2 Quando assim passavam as coisas, sucedeu que levantando-se Davi de dormir a sesta se pôs a passear no terraço do palácio real: E viu a uma mulher, que se estava lavando defronte do seu terraço, e era mulher em extremo"},{text:"formosa."},{text:"3 tools — see the cookie policy for details"},{text:"4 E enviou Davi mensageiros, e fêz que lha trouxessem: Chegada que foi Betsabée caiu em adultério: E ela se purificou logo da sua imundícia:"},{text:"5 E voltou para sua casa, tendo concebido. E enviou a avisar Davi, e a dizer-lhe: Eu concebi."},{text:"6 E Davi mandou dizer a Joab: Remete-me a Urias heteu. E Joab remeteu Urias a Davi."},{text:"7 E apresentou-se Urias a Davi: E Davi lhe perguntou, se passava bem Joab, e o povo, e como ia a guerra:"},{text:"8 E disse Davi a Urias: Vai para tua casa, e lava os teus pés. E saiu Urias do palácio do rei, e após êle foram mandados uns pratos da sua mesa."},{text:"9 Mas Urias passou a noite ao pé da porta do palácio do rei com os outros oficiais do seu senhor, e não foi a sua casa."},{text:"10 Avisaram disto a Davi, dizendo: Urias não foi a sua casa. E Davi disse a Urias: Não vieste tu duma jornada? Por que não fôste a tua casa?"},{text:"11 E Urias respondeu a Davi: A arca de Deus e Israel e Judá ficam debaixo dumas tendas, e meu senhor Joab, e os servos de meu senhor dormem na terra nua: E irei eu para minha casa comer e beber, e dormir com minha"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"mulher? Pela tua vida, e pela saúde da tua alma eu não farei tal coisa."},{text:"12 Disse pois Davi a Urias: Fica cá ainda hoje, e amanhã te enviarei. Ficou Urias em Jerusalém aquêle dia e o seguinte:"},{text:"13 E Davi o convidou a comer e a beber em sua presença, e o embebedou: E Urias saindo já de noite, dormiu na sua cama com os oficiais do seu senhor, e não foi a sua casa."},{text:"14 Chegada pois a manhã, escreveu Davi a Joab uma carta: E lha enviou por mão de Urias,"},{text:"15 tendo escrito na carta: Ponde a Urias na frente de um batalhão, onde fôr mais rijo o combate: E desamparai-o para que ferido pereça."},{text:"16 Joab pois tendo sitiado a cidade, pôs a Urias bem defronte do lugar onde sabia que estavam os homens mais valentes."},{text:"17 E tendo os da cidade feito uma sortida, carregaram sôbre Joab, e morreram alguns do exército de Davi, e morreu também Urias heteu."},{text:"18 Enviou pois Joab quem relatasse a Davi tudo o que se tinha passado no combate:"},{text:"19 E ordenou ao correio, dizendo: Depois que tu tiveres acabado de contar ao rei tudo o que se passou no exército,"},{text:"20 se vires que êle se indigna, e diz: Por que fôstes vós combater tão perto dos muros? Vós não sabíeis que são muitos os dardos que se arremessam do alto muro?"},{text:"21 Quem matou a Abimelec, filho de Jerobaal? Não foi uma mulher que do alto da muralha deitou em cima dêle um pedaço de uma mó de moinho, e o matou em Tebes? Por que vos chegastes vós tanto aos muros? Tu lhe dirás:"},{text:"Também morreu teu servo Urias heteu."},{text:"22 Partiu pois o correio, e foi, e referiu a Davi tudo o que Joab lhe tinha mandado."},{text:"23 E o mensageiro disse a Davi: Os inimigos prevaleceram contra nós, e fizeram uma saída ao nosso campo: Mas dando nós sôbre êles os perseguimos até à porta da cidade."},{text:"24 E os frecheiros dirigiram os tiros contra os teus servos desde o alto do muro: E morreram alguns dos servos do rei, e até morreu também Urias heteu, teu servo."},{text:"25 E Davi disse ao correio: Dirás isto a Joab: Não percas por isso o ânimo: Porque os sucessos da guerra são vários, ora perece um, ora perece outro aos golpes da espada: Conforta os teus soldados, e esforça-os contra a"},{text:"cidade, para a destruíres."},{text:"26 Mas a mulher de Urias ouviu que Urias, seu marido, era morto, e o chorou."},{text:"27 E passado o tempo do luto enviou Davi, e a fêz trazer para o seu palácio, e tomou-a por sua mulher, e ela lhe pariu um filho: Mas o que Davi fizera, foi desagradável aos olhos do Senhor."},{text:"2 Samuel — capítulo 12."},{text:"1 Enviou o Senhor pois Natan a Davi: E Natan tendo entrado à sua presença, lhe disse: Havia numa cidade dois homens, um rico, e outro pobre."},{text:"2 O rico tinha ovelhas, e manadas de bois em grande número:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Como pois um forasteiro viesse ver o rico, não querendo êste tocar nas suas ovelhas, nem nos seus bois, por dar um banquete àquele forasteiro, que lhe tinha chegado, tomou a ovelhinha daquele pobre homem, e a preparou"},{text:"para a dar de comer ao hóspede que tinha vindo a sua casa."},{text:"5 Davi porém sumamente indignado contra aquêle homem, disse para Natan: Viva o Senhor, que um homem que tal fêz, é digno de morte."},{text:"6 Êle há de pagar o quádruplo da ovelha, por ter feito dela o que fêz, e por não ter perdoado ao pobre."},{text:"7 Mas Natan disse a Davi: Tu és êste homem. Eis-aqui o que diz o Senhor Deus de Israel: Eu te ungi em rei sôbre Israel, e eu te livrei da mão de Saul,"},{text:"8 e te dei a casa de teu amo, e as mulheres de teu amo no teu seio, e te dei a casa de Israel e de Judá: E se isto é pouco, te ajuntarei ainda coisas muito maiores."},{text:"9 Por que desprezaste tu logo a palavra do Senhor, até cometeres o mal diante de meus olhos? Fizeste perecer à espada a Urias heteu, e tomaste para ti a que era sua mulher, e mataste-lo com a espada dos filhos de Amon."},{text:"10 Por esta razão não se apartará jamais a espada da tua casa, por me teres desprezado, e por teres tomado a mulher de Urias heteu, para ser tua mulher."},{text:"11 Eis-aqui pois o que diz o Senhor: Eu suscitarei da tua mesma casa o mal sôbre ti, e tomarei as tuas mulheres à tua vista, e dá-las-ei a um teu próximo, e êle dormirá com as tuas mulheres aos olhos dêste sol."},{text:"12 Porque tu fizeste isto às escondidas. Mas eu farei estas coisas à vista de todo o Israel, e à vista do sol."},{text:"13 E Davi disse a Natan: Pequei contra o Senhor. E Natan respondeu a Davi: Também o Senhor transferiu o teu pecado: Não morrerás."},{text:"14 Todavia, como tu pelo que fizeste deste lugar a que os inimigos do Senhor blasfemem, morrerá certamente o filho, que te nasceu."},{text:"15 E voltou Natan para sua casa. E o Senhor feriu de enfermidade ao menino, que a mulher de Urias tinha parido a Davi, e perdeu-se a esperança de que vivesse."},{text:"16 E fêz Davi oração ao Senhor pelo menino: E jejuou Davi com rigoroso jejum: E pôsto em retiro prostrou-se sôbre a terra."},{text:"17 Vieram porém os mais anciães da sua casa instando-lhe muito para que se levantasse do chão: Mas êle o não quis fazer, nem comeu com êles."},{text:"18 E aconteceu que no sétimo dia morreu o menino: E os servos de Davi não ousavam dizer-lhe que o menino era morto: Porque diziam: Quando o menino ainda vivia, nós lhe falávamos, e não queria êle ouvir-nos: Quanto mais"},{text:"se afligirá êle, se lhe dissermos que o menino morreu!"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"19 Davi porém vendo a seus servos em segredinhos, entendeu que o menino era morto: E disse aos seus criados: Porventura é morto o menino? Êles lhe responderam: É morto."},{text:"20 Levantou-se pois Davi do chão: E lavou-se e se ungiu: E tendo mudado de vestido, entrou na casa do Senhor: E o adorou, e veio para sua casa, e pediu que lhe pusessem de comer, e comeu."},{text:"21 E os seus servos lhe disseram: Como assim fizeste? Tu jejuaste, e choraste pelo menino, quando ainda vivia: E agora que êle morreu, levantaste-te, e comeste."},{text:"22 E Davi respondeu: Eu jejuei e chorei pelo menino, enquanto vivo: Porque dizia: Quem sabe se talvez o Senhor mo dará, e viva o menino?"},{text:"23 Mas agora que êle morreu, por que hei de jejuar? Acaso posso eu fazê-lo ainda viver? Mais irei eu para êle, do que êle tornará para mim."},{text:"24 Depois consolou Davi a sua mulher Betsabée, e entrando dormiu com ela: Ela gerou um filho, e lhe pôs o nome de Salomão, e o Senhor o amou."},{text:"25 E enviou o Profeta Natan, e deu o nome de Amável ao Senhor, porque o Senhor o amava."},{text:"26 E Joab continuava em bater a Rabat dos amonitas, e tinha pôsto no último apêrto a cidade real."},{text:"27 E enviou Joab correios a Davi, dizendo: Tenho combatido contra Rabat, e a cidade das águas está a tomar-se."},{text:"28 Agora pois ajunta o resto do povo, e vem ao sítio da cidade, e toma-a: Para não suceder, que tendo eu destruído a cidade, se atribua ao meu nome a vitória."},{text:"29 Ajuntou pois Davi todo o povo, e marchou contra Rabat: E depois de combatida, a tomou."},{text:"30 E tirou da cabeça do rei dos amonitas o seu diadema, que pesava um talento de ouro, enriquecido de pedras preciosíssimas, e foi pôsto na cabeça de Davi. E tirou também da cidade um esbulho de muita importância:"},{text:"31 E trazendo os seus moradores os mandou serrar, e que passassem por cima dêles carroças ferradas: E que os fizessem em pedaços com cutelos, e os botassem em fornos de cozer tijolo: Assim o fêz com tôdas as cidades dos"},{text:"amonitas: E voltou Davi e todo o exército para Jerusalém."},{text:"2 Samuel — capítulo 13."},{text:"1 Aconteceu depois disto que Amnon, filho de Davi, se namorou de Tamar, irmã de Absalão, filho de Davi, a qual era duma rara beleza:"},{text:"2 E se apaixonou de sorte por ela, que por causa do seu amor caiu doente: Porque sendo ela virgem, parecia difícil a Amnon fazer com ela coisa alguma contra a honestidade."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êste disse a Amnon: Como assim de dia em dia vais emagrecendo, ó filho do rei? Por que te não descobres tu comigo? E Amnon lhe respondeu: Eu amo a Tamar, irmã de meu irmão Absalão."},{text:"5 Respondeu-lhe Jonadab: Deita-te na tua cama, e finge que estás doente: E quando teu pai te vier visitar, dize-lhe: Peço-te que tragas aqui minha irmã Tamar, para que me dê de comer, e me guise algum prato que eu possa"},{text:"comer da sua mão."},{text:"6 Deitou-se pois Amnon na cama, e começou a dar-se por doente: E tendo vindo o rei visitá-lo, disse Amnon ao rei: Peço-te que mandes vir a minha irmã Tamar, para que faça à minha vista dois pratinhos, que eu coma da sua"},{text:"mão."},{text:"7 Mandou pois Davi à casa de Tamar, a dizer-lhe: Vem à casa de teu irmão Amnon, e faze-lhe alguma coisa de comer."},{text:"8 E veio Tamar à casa de seu irmão Amnon, que estava na cama: E tomando uma pouca de farinha a misturou: E adelgaçando-a, cozeu à sua vista uns caldinhos."},{text:"9 E tomando o que tinha cozido, lançou-o num prato, e pôs-lhe diante, e Amnon não quis comer, e disse: Façam sair todos para fora. E tendo feito sair todos para fora,"},{text:"10 disse Amnon para Tamar: Chega-me cá à alcova essa vianda, para que eu a coma da tua mão. Tomou pois Tamar o que tinha cozido, e levou-o a seu irmão Amnon à alcova."},{text:"11 E logo que lhe pôs diante o manjar, pegou dela, e disse: Vem, minha irmã, deita-te comigo."},{text:"12 Ela lhe respondeu: Não, meu irmão, não me faças esta violência, pois que isto não é lícito em Israel: Não faças tal loucura."},{text:"13 Porque eu não poderei sofrer o meu opróbrio, e tu passarás em Israel por um insensato: Mais vale que fales ao rei e êle não me negará a ti."},{text:"14 Porém Amnon não quis ceder a seus rogos, mas podendo mais do que ela a forçou, e a desflorou."},{text:"15 E Amnon lhe cobrou uma muito estranha aversão: De sorte que o ódio que concebeu contra ela excedia muito ao amor que antes lhe tivera. E Amnon lhe disse: Levanta-te e vai-te."},{text:"16 E ela lhe respondeu: Êste ultraje que tu agora obras para comigo, lançando-me fora, ainda é maior do que o que primeiro me fizeste. E Amnon não a quis ouvir."},{text:"17 Antes chamando a um criado que o servia lhe disse: Deita-a fora, e fecha logo a porta nas suas costas."},{text:"18 Ia Tamar vestida duma túnica talar: Porque êste era o trajo que costumavam trazer as donzelas filhas do rei. E o criado de Amnon a deitou fora: E fechou a porta após ela."},{text:"19 Tamar porém lançando cinza sôbre a sua cabeça, e rasgando a túnica talar, e postas as mãos na cabeça, se foi dali dando gritos."},{text:"20 E Absalão, seu irmão, lhe disse: Acaso teu irmão Amnon abusou de ti? Agora porém, ó minha irmã, cala-te: É teu irmão: Nem se angustie o teu coração por isso. Ficou pois Tamar em casa de seu irmão Absalão definhando-se"},{text:"de pena."},{text:"21 E o rei Davi tendo ouvido estas coisas, se apaixonou muito, mas não quis contristar o ânimo de Amnon, seu filho primogênito."},{text:"22 E Absalão não falou a Amnon nem mal, nem bem: Porque Absalão aborrecia a Amnon, por ter violado a sua irmã Tamar."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 Dois anos depois aconteceu tosquiarem-se as ovelhas de Absalão em Baalhasor, que é ao pé de Efraim: E Absalão convidou a todos os filhos do rei,"},{text:"24 e foi ter com o rei, e lhe disse: Dou-te parte, que se tosquiam as ovelhas de teu servo: Rogo pois que venha o rei com os seus príncipes a casa de seu servo."},{text:"25 E o rei disse a Absalão: Não, meu filho, não nos peças que vamos todos, e te sejamos pesados. Instando-lhe porém Absalão, e não condescendendo Davi, deu-lhe a sua bênção."},{text:"26 E Absalão lhe disse: Se tu não queres vir, suplico-te que ao menos venha conosco meu irmão Amnon. E o rei lhe respondeu: Não é necessário que êle vá contigo."},{text:"27 Finalmente instou-lhe mais Absalão, e Davi deixou ir com êle a Amnon e a todos os mais filhos do rei. E Absalão tinha preparado um banquete como um banquete real."},{text:"28 Absalão porém tinha dado ordem aos seus criados, dizendo: Estai com sentido quando Amnon começar a estar turbado do vinho, e eu vos der sinal, dai nêle, e matai-o: Não tenhais mêdo: Porque eu sou quem vo-lo mando:"},{text:"Tende ânimo, e sêde homens de valor."},{text:"29 Executaram pois os criados de Absalão a respeito de Amnon, o que seu amo lhes havia ordenado. E todos os filhos do rei, levantando-se da mesa, montaram cada um na sua mula, e fugiram."},{text:"30 Indo êles ainda no caminho, chegou aos ouvidos de Davi o rumor, dizendo: Absalão matou a todos os filhos do rei, e não ficou dêles nem um só."},{text:"31 Levantou-se então o rei, e rasgou os seus vestidos: E lançou-se por terra, e todos os seus criados, que assistiam, rasgaram os seus vestidos."},{text:"32 Mas respondendo Jonadab, filho de Semaa, irmão de Davi, disse: Não imagine o rei, meu senhor, que foram mortos todos os seus filhos: Só morreu Amnon, porque assim o tinha resoluto fazer Absalão desde o dia que Amnon"},{text:"forçara a sua irmã Tamar."},{text:"33 Não se lhe meta pois na cabeça ao rei meu senhor tal notícia, que diz: Todos os filhos do rei foram mortos: Porque só morreu Amnon."},{text:"34 Fugiu porém Absalão: E eis que levantando os olhos o criado, que estava de sentinela, viu uma grande tropa de gente, que vinha por um caminho escuso ao lado do monte."},{text:"35 E Jonadab disse ao rei: Eis lá vêm os filhos do rei: Sucedeu o caso como o disse teu servo."},{text:"36 E acabando êle de falar, apareceram os filhos do rei: E entrando levantaram a voz e choraram: E o rei e todos os seus servos também choraram com pranto mui amargo."},{text:"37 Porém Absalão fugindo, foi para casa de Tolomai, filho de Amiud, rei de Gessur. E Davi chorou a seu filho todos os dias."},{text:"38 E Absalão tendo fugido e refugiando-se em Gessur, estêve ali três anos."},{text:"39 E o rei Davi deixou de perseguir a Absalão porque já se tinha consolado da morte de Amnon."},{text:"2 Samuel — capítulo 14."},{text:"1 Joab, filho de Sarvia, conhecendo que o coração do rei estava inclinado para Absalão,"},{text:"2 enviou a Técua, fêz trazer de lá uma mulher mui sabida: E lhe disse: Finge que estás de nojo, e toma um vestido de dó, e não te unjas com óleo, para pareceres como uma mulher que há muito tempo que chora a um morto:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Tendo-se pois apresentado ao rei esta mulher de Técua, deitou-se por terra diante dêle, e o adorou, e disse: Salva-me, ó rei."},{text:"5 E o rei lhe disse: Que tens? Ela respondeu: Ai! eu sou uma mulher viúva: Morreu meu marido."},{text:"6 E a tua serva tinha dois filhos: Os quais tiveram uma briga no campo entre si, e não havia ninguém que os pudesse apartar: E um feriu o outro, e o matou."},{text:"7 E eis que agora tôda a parentela levantando-se contra a tua serva, diz: Dá-nos para cá a êsse que matou a seu irmão, para o matarmos em castigo do sangue de seu irmão, a quem matou, e tirarmos do mundo ao herdeiro: E"},{text:"assim pretendem extinguir a única faísca, que me ficou, para que não se conserve o nome de meu marido, nem resto algum sôbre a terra."},{text:"8 E o rei disse à mulher: Vai para tua casa, eu darei ordem em teu favor."},{text:"9 E a mulher de Técua disse ao rei: Sôbre mim, ó rei meu senhor, recaia a culpa, e sôbre a casa de meu pai: Mas o rei, e o seu trono seja inocente."},{text:"10 E disse o rei: Se alguém te contradisser, traze-o à minha presença, e está certa que êle te não inquietará mais."},{text:"11 E ela disse: Recorde-se o rei do Senhor seu Deus, para que se não multipliquem os parentes de sangue para tomarem vingança, e de modo algum matem a meu filho. Êle respondeu: Viva o Senhor, que não há de cair no chão"},{text:"nem um cabelo de teu filho."},{text:"12 Disse porém a mulher: Permite que a tua serva diga uma palavra ao rei meu senhor. E êle disse: Fala."},{text:"13 E disse a mulher: Por que pensaste tu uma tal coisa contra o povo de Deus, e por que tem o rei determinado fazer êste mal, e não faz antes voltar o seu desterrado?"},{text:"14 Nós morremos todos, e corremos pela terra bem como as águas, que não tornam mais: Nem Deus quer que alguma alma pereça, mas pensadamente suspende o castigo, para que se não perca de todo o que foi rejeitado."},{text:"15 Por isso é pois que eu vim dizer esta palavra ao rei meu senhor, diante do povo. E a tua serva disse: Falarei ao rei, a ver se de algum modo consigo dêle a graça que lhe peço."},{text:"16 E o rei me ouviu, para livrar a sua serva da mão de todos os que me queriam exterminar da herança de Deus, e a meu filho também."},{text:"17 Permite pois à tua serva dizer que a palavra do rei meu senhor se execute como um sacrifício. Porque o rei meu senhor é como um anjo de Deus, que se não move nem de bênçãos, nem de maldições: E por isso também o"},{text:"Senhor teu Deus está contigo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 11",author:"Pe. A. P. de Figueiredo",pages:[{text:"18 E respondendo o rei, disse à mulher: Não me encubras o que te vou a perguntar. E a mulher lhe respondeu: Fala, ó rei meu senhor."},{text:"19 E disse o rei: Não é verdade que a mão de Joab anda contigo em tudo isto? Respondeu a mulher, e disse: Por tua vida, ó rei meu senhor, em nada se aparta de tudo o que disse o rei meu senhor, nem para a direita, nem"},{text:"para a esquerda: Porque com efeito o teu servo Joab é quem me deu esta ordem, e quem pôs tôdas estas palavras na bôca da tua serva."},{text:"20 Teu servo Joab me mandou que te falasse eu assim em parábola: Mas tu, ó rei meu senhor, és sábio como o é um anjo de Deus, para entenderes tudo o que se passa sôbre a terra."},{text:"21 E o rei disse a Joab: Eis-aí eu aplacado te concedo o que pedes: Vai pois, e faze voltar o moço Absalão."},{text:"22 E Joab prostrando-se por terra sôbre o seu rosto adorou e felicitou ao rei: E disse Joab: Hoje, ó rei meu senhor, conheceu o teu servo, que eu achei graça diante de teus olhos: Porque deferiste à súplica de teu servo."},{text:"23 Partiu pois Joab e foi a Gessur, e conduziu Absalão para Jerusalém."},{text:"24 Mas o rei disse: Torne para sua casa, e não veja a minha face. Voltou pois Absalão para sua casa, e não viu a face do rei."},{text:"25 Mas em todo o Israel não havia homem tão bem feito, nem tão gentil, como Absalão: Da planta do pé até à cabeça não havia nêle defeito algum."},{text:"26 E quando cortava o cabelo (o que êle fazia uma vez cada ano, porque lhe carregava o cabelo) o cabelo da sua cabeça pesava duzentos siclos, pelo pêso ordinário."},{text:"27 Teve porém Absalão três filhos: E uma filha chamada Tamar, de elegante parecer."},{text:"28 E estêve Absalão em Jerusalém dois anos, e não viu a face do rei."},{text:"29 Mandou pois chamar a Joab, para o enviar ao rei: O qual não quis vir a êle. E como o mandasse chamar segunda vez, e êle não quisesse ainda vir ter com êle,"},{text:"30 disse aos seus servos: Vós sabeis que Joab tem um campo ao pé do meu, que está semeado de cevada: Ide pois, e lançai-lhe o fogo. Os servos pois de Absalão puseram fogo à seara. E vindo os servos de Joab ter com seu"},{text:"amo, rasgados os seus vestidos, lhe disseram: Os servos de Absalão queimaram parte do teu campo."},{text:"31 E Joab se levantou, e foi a casa de Absalão, e disse: Por que puseram os teus servos fogo à minha seara?"},{text:"32 E respondeu Absalão a Joab: Eu mandei-te chamar, pedindo-te que viesses ter comigo, para te enviar ao rei, e lhe dizeres: Por que vim eu de Gessur? melhor me era estar lá: Peço pois a graça de ver a face do rei; e se"},{text:"êle está lembrado da minha iniqüidade, mande-me matar."},{text:"33 Joab porém apresentando-se ao rei, contou-lhe tudo: E foi chamado Absalão, e entrou à presença do rei, e o adorou prostrado o seu rosto em terra em sua presença: E o rei deu o ósculo a Absalão."},{text:"2 Samuel — capítulo 15."},{text:"1 E depois disto mandou Absalão aprontar para si carroças, e gente de cavalo, e cinqüenta homens, que andassem adiante dêle."},{text:"2 E levantando-se Absalão de manhã, parava à entrada da porta, e a todo o que tinha algum negócio e vinha a pedir justiça ao rei, chamava-o Absalão a si, e lhe dizia: De que cidade és tu? E êle respondia dizendo: Eu teu"},{text:"servo sou de tal tribo de Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 Ó quem me dera ser juiz sôbre a terra, que viessem a mim todos os que têm negócios, e eu os decidisse segundo a justiça?"},{text:"5 E quando se chegava a êle algum homem a cortejá-lo, estendia a sua mão, e abraçando-o o beijava."},{text:"6 E isto praticava com todos os de Israel, que vinham para que o rei os ouvisse, e julgasse, e atraía a si o coração dos homens de Israel."},{text:"7 Mas depois de quarenta anos, disse Absalão ao rei Davi: Eu tenho que ir a Hebron para cumprir os votos que fiz ao Senhor."},{text:"8 Porque quando o teu servo estava em Gessur da Síria, fêz êste voto, dizendo: Se o Senhor me restituir a Jerusalém, eu oferecerei um sacrifício ao Senhor."},{text:"9 E o rei Davi lhe disse: Vai em paz. E êle saiu, e foi para Hebron."},{text:"10 Absalão porém enviou emissários por tôdas as tribos de Israel, dizendo: Tanto que tiverdes ouvido o som da trombeta, publicai: Absalão reina em Hebron."},{text:"11 Mas com Absalão foram duzentos homens de Jerusalém por êle convocados, que o seguiam inocentemente, e que de todo não penetraram a sua intenção."},{text:"12 Chamou também Absalão a Aquitofel gilonita, conselheiro de Davi, que era da sua cidade de Gilo. E quando se imolavam as vítimas fêz-se uma poderosa conjuração, e crescia o povo que tomava o partido de Absalão."},{text:"13 Chegou logo um correio a Davi dizendo: Todo o Israel segue Absalão com tôdas as veras."},{text:"14 E disse Davi aos seus criados, que estavam com êle em Jerusalém: Levantai-vos, fujamos: Porque não poderemos escapar das mãos de Absalão: Apressai-vos a sair, não suceda que êle chegando nos apanhe, e traga sôbre nós"},{text:"a ruína, e mande passar ao fio da espada a cidade."},{text:"15 E os servos do rei lhe disseram: Nós teus servos executaremos de boa vontade tudo o que mandar o rei nosso senhor."},{text:"16 Saiu pois o rei, e tôda a sua família a pé: E deixou dez mulheres suas concubinas para guardarem o palácio."},{text:"17 E tendo saído o rei e todo o Israel a pé, parou estando já longe da sua casa:"},{text:"18 E todos os seus servos iam ao pé dêle, e as legiões dos cereteus e feleteus, e todos os geteus, fortes guerreiros, em número de seiscentos homens de pé, que o tinham seguido em Get, iam adiante do rei."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 12",author:"Pe. A. P. de Figueiredo",pages:[{text:"19 E disse o rei a Etai geteu: Por que vens tu conosco? Volta, e vai viver com o rei, porque és forasteiro, e saíste da tua terra."},{text:"20 Ontem vieste, e hoje serás obrigado a sair conosco? Eu porém irei para onde devo ir: Tu volta, e leva contigo a teus irmãos, e o Senhor usará contigo de misericórdia, e de verdade, porque deste mostras da tua gratidão"},{text:"e fidelidade."},{text:"21 E Etai respondeu ao rei, dizendo: Viva o Senhor, e viva o rei meu amo: Porque em qualquer estado em que tu te achares, ó rei meu senhor, quer seja na morte, quer na vida, aí se achará o teu servo."},{text:"22 E Davi disse a Etai: Vem, e passa. E passou Etai geteu, e todos os homens que estavam com êle, e tôda a mais multidão."},{text:"23 E todos choravam a grandes vozes, e passava todo o povo: O rei também passava a torrente de Cedron, e todo o povo tomava o caminho, que olha para o deserto."},{text:"24 Veio pois também o pontífice Sadoc, e com êle todos os levitas que traziam a arca do testamento de Deus, e assentaram a arca de Deus: E subiu Abiatar, até que tivesse passado todo o povo, que tinha saído da cidade."},{text:"25 E disse o rei a Sadoc: Torna a levar a arca de Deus para a cidade: Se eu achar graça diante dos olhos do Senhor, êle me restituirá, e fará que eu veja a sua arca, e o seu tabernáculo."},{text:"26 Se êle porém me disser: Tu não me agradas: Eu estou pronto, faça de mim o que bem lhe parecer."},{text:"27 E disse o rei ao pontífice Sadoc: Ó Vidente, torna em paz para a cidade: E estejam convosco vossos dois filhos Aquimaas, teu filho, e Jônatas, filho de Abiatar."},{text:"28 Olhai que eu me vou esconder nas campinas do deserto, até que vós me mandeis novas do estado das coisas."},{text:"29 Sadoc pois, e Abiatar tornaram a levar para Jerusalém a arca de Deus: E lá ficaram."},{text:"30 E Davi ia subindo a costa das oliveiras, e a subiu chorando, caminhando com os pés descalços e a cabeça coberta, e todo o povo que ia com êle, subia também chorando coberta a cabeça."},{text:"31 E deu-se notícia a Davi que Aquitofel também entrava na conjuração de Absalão, e disse Davi: Peço-te, Senhor, que enfatues o conselho de Aquitofel."},{text:"32 E quando Davi subia ao cume do monte, onde devia adorar ao Senhor, eis se encontrou com êle Cusai de Arac, rasgados os vestidos, e coberta a cabeça de terra."},{text:"33 E Davi lhe disse: Se vieres comigo, ser-me-ás pesado:"},{text:"34 Mas se tu voltares para a cidade, e disseres a Absalão: Eu, ó rei, sou teu servo, e eu te servirei a ti, como servi a teu pai: Dissiparás os desígnios de Aquitofel."},{text:"35 Tu porém tens contigo aos pontífices Sadoc, e Abiatar: E tudo o que ouvires da casa do rei avisarás aos pontífices Sadoc e Abiatar."},{text:"36 E com êles estão seus dois filhos Aquimaas, filho de Sadoc, e Jônatas, filho de Abiatar: E por êles me avisarás de tudo o que ouvires."},{text:"37 Chegando pois Cusai amigo de Davi à cidade, entrou também Absalão em Jerusalém."},{text:"2 Samuel — capítulo 16."},{text:"1 Tendo pois Davi passado algum tanto, do alto do monte, lhe saiu ao encontro Siba, criado de Mifiboset, com dois jumentos carregados de duzentos pães, e de cem penduras de passas de uvas, e de cem camadas de figos, e de"},{text:"um odre de vinho."},{text:"2 E disse o rei a Siba: Para que é isto? E Siba lhe respondeu: Os jumentos são para se montarem nêles os criados do rei: Os pães e os figos, para os teus criados: E o vinho, para beber quem se achar fraco no deserto."},{text:"3 tools — see the cookie policy for details"},{text:"4 E disse o rei a Siba: Teu é tudo o que era de Mifiboset. E Siba respondeu: O que eu desejo, ó rei meu senhor, é achar graça diante de ti."},{text:"5 Chegou pois o rei Davi até Baurim, e eis que saía dali um homem da parentela da casa de Saul, chamado Semei, filho de Gera, que se adiantava no seu caminho, e amaldiçoava."},{text:"6 E atirava pedradas contra Davi, e contra todos os servos do rei Davi: Todo o povo porém e todos os homens de guerra marchavam à direita, e à esquerda do rei."},{text:"7 E Semei amaldiçoando ao rei, dizia assim: Sai, sai, homem sangüinário, e homem de Belial."},{text:"8 O Senhor te deu agora o pago de todo o sangue da casa de Saul: Porquanto lhe usurpaste o reino, e o Senhor o pôs na mão de teu filho Absalão: E olha como os males te oprimem, porque és um homem sangüinário."},{text:"9 Então disse Abisai, filho de Sarvia, ao rei: Por que amaldiçoa êste cão morto ao rei meu senhor? Eu vou, e cortar-lhe-ei a cabeça."},{text:"10 E o rei disse: Que tenho eu convosco, filhos de Sarvia? Deixai-o maldizer: Porque o Senhor lhe mandou que maldissesse a Davi: E quem se atreverá a dizer: Por que o fêz êle assim?"},{text:"11 E disse o rei a Abisai, e a todos os seus servos: Vós vêdes que meu filho, que eu gerei das minhas entranhas, procura tirar-me a vida: Quanto mais agora um filho de Jemini? Deixai-o maldizer conforme a ordem do"},{text:"Senhor:"},{text:"12 Talvez que o Senhor olhe para a minha aflição: E me faça o Senhor bem pelas maldições dêste dia."},{text:"13 Prosseguia pois Davi o seu caminho acompanhado dos seus. Mas Semei ia pelo alto costeando o monte, defronte dêle, maldizendo-o, e atirando pedras contra êle, e espalhando pó."},{text:"14 Chegou enfim o rei, e com êle todo o povo fatigados, e ali descansaram."},{text:"15 Mas Absalão e todos os do seu partido entraram em Jerusalém, e com êle também Aquitofel."},{text:"16 Como pois Cusai de Arac, amigo de Davi, se tivesse apresentado a Absalão, lhe disse: Deus te salve, ó rei, Deus te salve, ó rei."},{text:"17 E Absalão lhe respondeu: Pois êsse é o teu agradecimento para com o teu amigo? Por que não fôste com o teu amigo?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"18 E respondeu Cusai a Absalão: De nenhuma sorte: Porque eu hei de ser daquele, a quem elegeu o Senhor, e todo êste povo, e todo o Israel, e hei de ficar com êle."},{text:"19 E ainda quero acrescentar mais isto: A quem hei eu de servir? Não é ao filho do rei? Como obedeci a teu pai, assim te obedecerei a ti também."},{text:"20 E disse Absalão a Aquitofel: Consultai entre ambos que é o que devemos fazer."},{text:"21 E Aquitofel disse a Absalão: Entra às concubinas de teu pai, que êle deixou para guardarem o palácio: Para que em soando por todo o Israel que fizeste esta afronta a teu pai, se unam êles mais fortemente ao teu"},{text:"partido."},{text:"22 Armou-se pois para Absalão uma tenda no terraço e êle à vista de todo o Israel abusou das concubinas de seu pai."},{text:"23 Os conselhos porém que Aquitofel dava naqueles dias, eram considerados como os oráculos de um Deus. E assim se consideravam todos os conselhos de Aquitofel, tanto quando estava com Davi, como quando estava com"},{text:"Absalão."},{text:"2 Samuel — capítulo 17."},{text:"1 Disse pois Aquitofel a Absalão: Farei para mim escolha de doze mil homens, e sairei em busca de Davi esta noite."},{text:"2 E dando sôbre êle (pois que está cansado e frouxo das mãos) o destroçarei: E logo que fugir todo o povo, que vem com êle, matarei o rei abandonado."},{text:"3 tools — see the cookie policy for details"},{text:"4 E agradou o seu parecer a Absalão, e a todos os anciãos de Israel."},{text:"5 Todavia Absalão disse: Chamai a Cusai de Arac, e ouçamos também que é o que êle diz."},{text:"6 E chegando Cusai à presença de Absalão, Absalão lhe disse: Eis-aqui o conselho, que Aquitofel nos deu: Devemo-lo nós seguir ou não? Que nos aconselhas tu?"},{text:"7 E Cusai respondeu a Absalão: Não é bom o conselho, que Aquitofel deu esta vez."},{text:"8 E acrescentou mais Cusai: Tu conheces bem que teu pai, e que a gente, que está com êle, são uns homens valentíssimos, e que estão com o coração amargurado, como uma ursa, que discorre enfurecida pelo bosque por lhe"},{text:"terem roubado os seus cachorros: E também teu pai é homem guerreiro e não se demorará com a sua gente."},{text:"9 Talvez agora está êle escondido nalguma caverna, ou outro qualquer lugar, que tenha escolhido: Se nos princípios perecer algum dos teus, publicar-se-á isto, e quem o ouvir, dirá: Foi destroçado o povo que seguia a"},{text:"Absalão."},{text:"10 E os mais fortes, cujos corações são como leões, desfalecerão de pavor: Porque todo o povo de Israel sabe que teu pai é valente, e que todos que estão com êle são esforçados."},{text:"11 Mas o conselho que me parece acertado é êste: Ajunte-se a ti todo o Israel, desde Dan até Bersabée, que será inumerável como a areia do mar: E tu estarás no meio dêles."},{text:"12 E daremos sôbre êle em qualquer lugar em que fôr achado: E cobri-lo-emos, como costuma cair o orvalho sôbre a terra: E não deixaremos nem um só homem dos que estão com êle."},{text:"13 Porém se êle se retirar para alguma cidade, todo o Israel cingirá aquela cidade com cordas, e trazê-la-emos arrastando até um ribeiro para que não apareça dela nem a mais pequena pedrinha."},{text:"14 E disse Absalão, e todos os magnates de Israel: O conselho de Cusai de Arac é melhor do que o conselho de Aquitofel: Mas por disposição do Senhor foi dissipado o útil conselho de Aquitofel, para que o Senhor fizesse"},{text:"cair o mal sôbre Absalão."},{text:"15 E disse Cusai aos pontífices Sadoc e Abiatar: Dêste e dêste modo aconselhou Aquitofel a Absalão, e aos anciãos de Israel: E eu o aconselhei assim e assim."},{text:"16 Agora pois mandai a tôda a diligência avisar a Davi, dizendo-lhe: Não fiques esta noite nas planícies do deserto, mas passa sem dilação à outra banda: Não seja que fique absorvido o rei, e todo o povo que com êle"},{text:"está."},{text:"17 Jônatas porém e Aquimaas estavam esperando junto à fonte de Rogel: E uma escrava lhe foi dar o aviso: E êles partiram a dar parte ao rei Davi: Porque não deviam ser vistos, nem entrar na cidade."},{text:"18 Viu-os todavia um rapaz, e avisou a Absalão: Mas êles apertando o passo entraram em casa de um homem de Baurim, que tinha um poço à entrada da casa ao qual desceram."},{text:"19 E a mulher tomou uma coberta, e a estendeu sôbre o bocal do poço, como quem queria secar cevada pilada: E assim ficou a coisa oculta."},{text:"20 E tendo chegado à casa os servos de Absalão, disseram à mulher: Onde estão Aquimaas e Jônatas? E a mulher lhes respondeu: Foram-se apressadamente, depois de beberem uma pouca de água. E os que os buscavam, como os não"},{text:"achassem, voltaram para Jerusalém."},{text:"21 E logo que se retiraram, saíram Aquimaas e Jônatas do poço, e continuando o seu caminho avisaram ao rei Davi e lhe disseram: Marchai, e passai depressa o rio: Porque Aquitofel deu êste conselho contra vós:"},{text:"22 Marchou pois Davi, e tôda a sua gente que estava com êle e passaram o Jordão antes de amanhecer: E não ficou nem só um que não passasse o rio."},{text:"23 Aquitofel porém vendo que se não tinha seguido o seu conselho, aparelhou o seu jumento, e levantou-se e foi para a sua casa e cidade: E tendo disposto todos os negócios da sua casa, se enforcou, e morreu, e foi"},{text:"sepultado no jazigo de seu pai."},{text:"24 Depois chegou Davi ao arraial, e Absalão passou o Jordão, êle e na sua companhia todo o Israel."},{text:"25 E Absalão deu o mando do exército a Amasa em lugar de Joab: Amasa porém era filho dum homem de Jezrael chamado Jetra, que era casado com Abigail, filha de Naas, irmã de Sarvia, que foi mãe de Joab."}]}] 1
