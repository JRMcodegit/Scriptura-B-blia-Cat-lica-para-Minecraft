give @p minecraft:written_book[written_book_content={title:"Jó Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 Se eu queria ir vê-los, assentava-me no primeiro lugar: Quando eu estava assentado como um rei, rodeado de guardas, era todavia o consolador dos aflitos."},{text:"Jó — capítulo 30."},{text:"1 Porém agora zombam de mim os de menos idade, cujos pais noutro tempo não me dignaria eu pôr com os cães do meu rebanho:"},{text:"2 Aquêles, cuja fôrça de mãos reputava eu em nada, e eram estimados como indignos de viver."},{text:"3 tools — see the cookie policy for details"},{text:"4 E comiam ervas, e cascas de árvores, e que se sustentavam das raízes dos juníperos."},{text:"5 Que arrebatando dos vales estas coisas, logo que as achavam, corriam a elas com gritaria."},{text:"6 Habitavam nas concavidades dos rios e nas cavernas da terra, ou sôbre os penhascos."},{text:"7 Que achavam a sua alegria entre tais coisas, e reputavam por delícia estar debaixo dos espinhos."},{text:"8 Filhos de gente insensata e desprezível, e que nem ainda aparecem na terra."},{text:"9 Agora tenho chegado a ser a sua canção e me tenho feito objeto dos seus escárnios."},{text:"10 Êles me abominam e fogem para longe de mim, e não receiam cuspir-me no rosto."},{text:"11 Porque abriu a sua aljava e me afligiu, e pôs um freio na minha bôca."},{text:"12 Logo que comecei a aparecer se levantaram à minha destra as minhas calamidades: Transtornaram os meus pés, e me oprimiram com as suas veredas, como com ondas."},{text:"13 Desbarataram-me os meus caminhos, armaram-me traições, e prevaleceram, e não houve quem me socorresse."},{text:"14 Como na brecha de uma muralha, e por uma porta aberta se lançaram sôbre mim, e me vieram acabar na minha miséria."},{text:"15 Reduzido me vejo a um nada, arrebataste o meu desejo como vento: E como nuvem passou a minha saúde."},{text:"16 E agora dentro de mim mesmo se murcha a minha alma, e me possuem dias de aflição."},{text:"17 De noite os meus ossos são traspassados de dores: E os que me devoram não dormem."},{text:"18 Com a multidão dêstes se consome o meu vestido, e me cercaram como com cabeção de túnica."},{text:"19 Sou comparado ao lôdo, e sou semelhante ao pó e à cinza."},{text:"20 Clamo a ti e não me ouves: Ponho-me diante de ti e não olhas para mim."},{text:"21 Trocaste-te em severo para comigo, e na dureza da tua mão te mostras inimigo para comigo."},{text:"22 Elevaste-me, e como pondo-me sôbre o vento, me arrojaste com violência."},{text:"23 Sei que me entregarás à morte, onde há casa estabelecida para todo o vivente."},{text:"24 Mas não estendes a tua mão para consumi-los inteiramente: E se caírem, tu mesmo os salvarás."},{text:"25 Eu chorava algum dia sôbre aquêle que estava aflito: A minha alma se compadecia do pobre."},{text:"26 Esperava bens, e vieram-me males: Esperava a luz e saíram trevas."},{text:"27 As minhas entranhas ferveram sem descanso algum: Os dias da aflição me surpreenderam."},{text:"28 Caminhava triste, mas sem furor: Levantando-me gritava no meio da gente."},{text:"29 Fui irmão de dragões, e companheiro de avestruzes."},{text:"30 Denegrida está a minha pele sôbre mim, e os meus ossos se secaram pelo ardor."},{text:"31 A minha cítara se trocou em tristes lamentos, e o meu órgão nas vozes dos que choram."},{text:"Jó — capítulo 31."},{text:"1 Fiz concêrto com os meus olhos de certamente não cogitar, nem ainda em uma virgem."},{text:"2 Pois que parte teria Deus em mim lá de cima, e que herança o Onipotente desde as alturas?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Porventura não considera Êle os meus caminhos, e conta todos os meus passos?"},{text:"5 Se caminhei em vaidade, e se se apressou o meu pé para o engano:"},{text:"6 Pese-me Deus em balança justa, e conheça a minha singeleza."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Se os meus pés se desviaram do caminho, e se o meu coração seguiu os meus olhos, e se às minhas mãos se pegou mácula."},{text:"8 Semeie eu, e outro o coma: E seja a minha descendência arrancada até à raiz."},{text:"9 Se o meu coração foi seduzido por causa de mulher, e se eu armei traições à porta do meu amigo:"},{text:"10 Seja minha mulher desonestada por outro, e prostitua-se à paixão de outros."},{text:"11 Porque êste é um crime enorme, e uma grandíssima maldade."},{text:"12 É fogo que consome até ao extermínio, e que desarraiga até às mais pequenas vergônteas."},{text:"13 Se eu me dedignei de entrar em juízo com o meu servo, ou com a minha serva, quando êles disputavam contra mim."},{text:"14 Pois que farei quando Deus se levantar para me julgar? E quando me perguntar, que lhe responderei?"},{text:"15 Porventura o que me formou no ventre a mim, não o criou também a êle: E não foi um o que nos formou no ventre da mãe?"},{text:"16 Se neguei aos pobres o que queriam, e se fiz esperar os olhos da viúva."},{text:"17 Se comi sòzinho o meu bocado, e se o órfão não comeu dêle:"},{text:"18 (Porque desde a minha infância cresceu comigo a comiseração: E do ventre de minha mãe saiu comigo)"},{text:"19 Se desprezei ao que perecia, porque não tinha de que vestir-se, e ao pobre que não tinha com que cobrir-se:"},{text:"20 Se os seus membros me não abendiçoaram, e não se aquentou com os velos das minhas ovelhas:"},{text:"21 Se eu levantei a minha mão contra o pupilo, ainda quando me via superior na porta:"},{text:"22 Caia o meu ombro da sua juntura, e quebre-se o meu braço com os seus ossos."},{text:"23 Porque eu sempre temi a Deus como a umas ondas, que gravitavam sôbre mim, e eu não pude suportar o seu pêso."},{text:"24 Se eu julguei que o ouro era a minha fôrça, e se eu disse ao ouro mais puro: Tu és minha confiança."},{text:"25 Se eu me alegrei com as minhas grandes riquezas, e com os grandes bens que ajuntei pela minha mão."},{text:"26 Se eu olhei para o sol no seu luzimento, e para a lua quando caminhava com claridade:"},{text:"27 E o meu coração sentiu algum oculto contentamento, e beijei a minha mão com a minha bôca."},{text:"28 O que é o sumo da iniqüidade, e um renunciar ao altíssimo Deus."},{text:"29 Se eu folguei com a ruína daquele que me tinha ódio, e se eu exultei com o mal que lhe sobreveio."},{text:"30 Pois não permiti que pecasse a minha garganta, demandando com imprecações a sua morte."},{text:"31 Se as pessoas da minha casa não disseram: Quem nos dará da sua carne para nos fartarmos dela?"},{text:"32 O peregrino não ficou de fora, a minha porta estêve aberta para o viandante:"},{text:"33 Se encobri como homem o meu pecado, e ocultei no meu coração a minha iniqüidade."},{text:"34 Se a grande multidão me aterrou, ou se eu fiquei atemorizado pelo desprêzo que de mim faziam os meus parentes: E se eu pelo contrário não me conservei em silêncio, sem sair da minha porta."},{text:"35 Quem me dera um que me ouvisse, e que o Onipotente escutasse os meus desejos: E que escrevesse o livro o mesmo que julga."},{text:"36 Para levá-lo sôbre o meu ombro, e rodear-me com êle como coroa?"},{text:"37 A cada um dos meus passos o publicarei, e lho apresentarei como a príncipe."},{text:"38 Se a terra que eu possuo clama contra mim, e se os seus regos choram com ela:"},{text:"39 Se comi seus frutos sem dinheiro, e se afligi o coração dos que a cultivaram:"},{text:"40 Ela me produza abrolhos em lugar de trigo, e espinhos em lugar de cevada. Findaram as palavras de Jó."},{text:"Jó — capítulo 32."},{text:"1 Cessaram porém êstes três homens de responder a Jó, porque se tinha por justo."},{text:"2 Mas Eliú, filho de Baraquel de Buz, da família de Ram, se irou, e encheu de cólera: E inflamou-se em ira contra Jó, porque dizia que êle era justo diante de Deus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Eliú pois esperou que Jó falasse: Porquanto eram mais velhos os que haviam falado."},{text:"5 Mas como viu que os três lhe não puderam responder, se indignou fortemente."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"6 E respondendo Eliú, filho de Baraquel de Buz, disse: Sou o mais moço em idade, e vós mais provectos; portanto abaixando a minha cabeça, não me atrevi a expor-vos o meu parecer."},{text:"7 Porque esperava que falasse a idade mais provecta, e que os muitos anos ensinassem sabedoria."},{text:"8 Mas, pelo que vejo, o espírito está nos homens, e a inspiração do Todo-Poderoso dá a inteligência."},{text:"9 Não são os sábios os de muita idade, nem os anciãos os que julgam o que é justo."},{text:"10 Portanto falarei: Ouvi-me, eu vos mostrarei também a minha sabedoria."},{text:"11 Porque tenho dado lugar aos vossos discursos, tenho ouvido as vossas razões, enquanto têm durado as vossas disputas:"},{text:"12 E enquanto eu cria, que vós dizíeis alguma coisa, atendia: Mas, pelo que vejo, não há entre vós quem possa argüir a Jó, nem responder às suas razões."},{text:"13 Não digais porventura: Nós achamos a sabedoria, Deus é que a lançou de si, e não algum homem."},{text:"14 Êle não falou nada para mim, nem eu lhe responderei também a êle segundo os vossos arrazoados."},{text:"15 Ei-los aí intimidados, e não deram mais resposta, e a si mesmos se taparam a bôca."},{text:"16 E pois que eu tenho esperado, e não têm falado: Ficaram mudos, e não tiveram já que responder:"},{text:"17 Responderei eu também pela minha parte, e mostrarei a minha ciência:"},{text:"18 Porque estou cheio de razões, e me aperta o espírito no meu peito."},{text:"19 Eis-aqui o meu peito é como o môsto sem respiradouro, o qual faz estoirar as vasilhas novas."},{text:"20 Falarei, e respirarei um pouco: Abrirei os meus lábios, e responderei."},{text:"21 Não farei aceitação de pessoa, e não igualarei a Deus com o homem."},{text:"22 Porque não sei o tempo que subsistirei, e se daqui a pouco me levará o meu Criador."},{text:"Jó — capítulo 33."},{text:"1 Ouve pois, Jó, as minhas palavras, e escuta todos os meus discursos."},{text:"2 Eis-aqui abri a minha bôca, fale a minha língua nas minhas fauces."},{text:"3 tools — see the cookie policy for details"},{text:"4 O espírito de Deus me fêz, e o assôpro do Todo-Poderoso me deu vida."},{text:"5 Se podes, responde-me, e põe-te a fazer-me frente."},{text:"6 Eis-aqui, Deus me fêz, a mim, assim como a ti, e do mesmo lôdo também eu fui formado."},{text:"7 Pelo que nada há de maravilhoso em mim que te espante, e a minha eloqüência não te será pesada."},{text:"8 Disseste pois nos meus ouvidos, e ouvi a voz das tuas palavras:"},{text:"9 Eu estou limpo e sem pecado: Eu estou sem mácula, e em mim não há iniqüidade."},{text:"10 Porque Deus achou contra mim queixas, por isso me considerou como seu inimigo."},{text:"11 Pôs os meus pés no cepo, e observou tôdas as minhas veredas."},{text:"12 Isto pois é, no que tens mostrado que não és justo; responder-te-ei, que Deus é maior do que o homem."},{text:"13 Disputas contra êle, por que não respondeu a tôdas as tuas palavras?"},{text:"14 Deus fala uma vez, e segunda vez não repete uma mesma coisa."},{text:"15 Por sonho de visão noturna, quando cai sopor sôbre os homens, e estão dormindo no seu leito."},{text:"16 Então abre os ouvidos dos homens, e admoestando-os lhes adverte o que devem fazer."},{text:"17 Para apartar o homem daquilo que faz e para o livrar da soberba:"},{text:"18 Salvando a sua alma de corrupção: E a sua vida, para que não passe por espada."},{text:"19 Corrige-o também por meio das dores na cama, e faz que todos os seus ossos se mirrem."},{text:"20 Neste estado se lhe faz aborrecido o pão, e o manjar que noutro tempo apetecia a sua alma."},{text:"21 Consumir-se-á a sua carne, e os ossos que haviam estado cobertos, se descobrirão."},{text:"22 Aproximou-se a sua alma à corrupção, e a sua vida ao que traz a morte."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"23 Se houver algum Anjo, um entre milhares, que fale a seu favor, e instrua o homem no seu dever:"},{text:"24 Se compadecerá dêle, e dirá: Livra-o, para que não desça à corrupção: Eu achei por que lhe fazer graça."},{text:"25 A sua carne está consumida dos castigos, torne aos dias da sua mocidade."},{text:"26 Êle pedirá perdão a Deus, e Deus se lhe aplacará: E êle verá com júbilo a sua face, e Deus justificará de novo a êste homem."},{text:"27 Tornará a olhar para os homens, e dirá: Pequei, e deveras delinqüi, e não tenho sido castigado como merecia."},{text:"28 Deus livrou a sua alma para que não caminhasse à morte senão que vivendo visse a luz."},{text:"29 Ora Deus obra tôdas estas coisas três vêzes em cada um."},{text:"30 Para retrair as suas almas da corrupção, e para as esclarecer com a luz dos viventes."},{text:"31 Atende, Jó, e ouve-me: E cala-te, enquanto eu falo."},{text:"32 Se contudo tens alguma coisa que dizer, responde-me, fala: Porque quero que compareças justo."},{text:"33 Se não a tens, ouve-me: Cala-te, e eu te ensinarei a sabedoria."},{text:"Jó — capítulo 34."},{text:"1 Continuando pois Eliú o seu discurso, disse também o que se segue:"},{text:"2 Ouvi, sábios, as minhas palavras; eruditos, escutai-me."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tratemos nós em comum a causa, e vejamos entre nós o que seja o melhor."},{text:"5 Porque Jó disse: Eu sou justo, e Deus transtornou a minha causa."},{text:"6 Porquanto no juízo que se faz de mim, há mentira: Violenta é a minha seta sem pecado algum."},{text:"7 Que homem há semelhante a Jó, que bebe o escárnio como a água?"},{text:"8 Que anda com os que obram a iniqüidade e caminha com os homens ímpios?"},{text:"9 Porque disse: O homem não agradará a Deus, ainda que vá correndo com êle."},{text:"10 Vós pois os cordatos, ouvi-me, a impiedade está longe de Deus, e a injustiça longe do Todo-Poderoso."},{text:"11 Porque êle pagará ao homem a sua obra, e recompensará a cada um segundo os seus caminhos."},{text:"12 Porque certamente Deus não condenará sem razão, nem o Onipotente atropelará a justiça."},{text:"13 A qual outro estabeleceu sôbre a terra? Ou a quem pôs sôbre o mundo, que fabricou?"},{text:"14 Se voltasse a êle o seu coração, atrairia a si o espírito e alento dêle."},{text:"15 Tôda a carne pereceria ao mesmo tempo, e o homem se tornaria em cinza."},{text:"16 Portanto se tens entendimento, ouve o que se diz, e escuta a voz do meu discurso."},{text:"17 Acaso pode ser curado aquêle que não ama a justiça? E como condenas tu tão afoitamente aquêle, que é o justo?"},{text:"18 O que diz ao rei, apóstata: E chama ímpios aos grandes:"},{text:"19 Aquêle que não guarda respeito à pessoa dos príncipes: E que não conheceu o tirano, quando disputava contra o pobre: Porque todos são obra das suas mãos."},{text:"20 Êles morrerão de improviso, e no meio da noite se sublevarão os povos, e passarão, e tirarão o violento sem se ver a mão."},{text:"21 Porque os olhos de Deus estão sôbre os caminhos dos homens, e considera todos os seus passos."},{text:"22 Não há trevas, e não há sombra de morte, de maneira que se escondam ali os que obram a iniqüidade."},{text:"23 Porque já não está mais no poder do homem, o vir a Deus a ser julgado."},{text:"24 Êle destruirá a uma inumerável multidão, e porá outros em seu lugar."},{text:"25 Porque conhece as suas obras: E por isso enviará a noite, e êles serão moídos."},{text:"26 Feriu-os como ímpios à vista de todos."},{text:"27 Os que como de propósito se apartaram dêle, e que não quiseram compreender todos os seus caminhos:"},{text:"28 Para fazerem que o clamor do indigente subisse até êle, e que ouvisse a voz dos pobres."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"29 Porque se êle concede a paz, quem há que o condene? E se êle esconde o seu rosto, quem o poderá contemplar, seja isto sôbre as gentes, seja sôbre todos os homens?"},{text:"30 Êle é o que faz reinar o homem hipócrita por causa dos pecados do povo."},{text:"31 E pois que eu tenho falado de Deus, também te não estorvarei a ti."},{text:"32 Se eu errei, corrige-me tu: Se falei com iniqüidade, não acrescentarei mais."},{text:"33 Porventura te pedirá Deus a ti conta do que eu falei que te desagradou? Mas tu fôste o primeiro a falar, e não eu: Se sabes coisa melhor, dize-a."},{text:"34 Falem-me homens inteligentes, e ouça-me um homem sábio."},{text:"35 Mas Jó falou nèsciamente, e as suas palavras não soam boa doutrina."},{text:"36 Pai meu, seja provado Jó até ao fim: Não retires a tua mão de um homem iníquo."},{text:"37 Porque ajunta a blasfêmia sôbre os seus pecados, entrementes nós o apertemos: E depois apele para o juízo de Deus nos seus discursos."},{text:"Jó — capítulo 35."},{text:"1 Mas Eliú de novo falou desta maneira:"},{text:"2 Parece-te acaso justo o teu pensamento, quando disseste: Mais justo sou eu que Deus?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Assim que eu responderei aos teus discursos, e aos teus amigos contigo."},{text:"5 Levanta os olhos ao céu, e vê, e contempla o firmamento que é mais alto que tu."},{text:"6 Se pecares, em que danarás tu a Deus? E se as tuas iniqüidades se multiplicarem, que farás tu contra êle?"},{text:"7 Demais disso se obrares com justiça, que lhe darás? Ou que receberá êle da tua mão?"},{text:"8 A tua impiedade poderá fazer mal a um homem, que é teu semelhante: E a tua justiça poderá ser útil ao filho do homem."},{text:"9 Êles clamarão por causa da multidão dos caluniadores: E se lamentarão pela fôrça do braço dos tiranos."},{text:"10 E nenhum disse: Onde está o Deus que me fêz, que deu canções na noite?"},{text:"11 O qual nos instrui mais que aos animais da terra, e nos ilustra mais que às aves do céu."},{text:"12 Êles clamarão então, e Deus os não ouvirá, por causa da soberba dos maus."},{text:"13 Não em vão pois ouvirá Deus, e verá o Onipotente as causas de cada um."},{text:"14 Ainda quando disseres: Não atende: Julga-te a ti mesmo na sua presença, e espera-o."},{text:"15 Porque não é agora quando êle exercita o seu furor, nem castiga os delitos com severidade."},{text:"16 Logo Jó em vão abre a sua bôca, e sem ciência multiplica palavras."},{text:"Jó — capítulo 36."},{text:"1 E acrescentou Eliú, e falou assim:"},{text:"2 Escuta-me um pouco, e eu me explicarei, contigo: Porque ainda tenho que falar em defesa de Deus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque o certo é que nos meus discursos não há mentira, e será da tua aprovação uma ciência consumada."},{text:"5 Deus não rejeita os poderosos, visto que também êle é poderoso."},{text:"6 Mas não salva os ímpios, e faz justiça aos pobres."},{text:"7 Não tirará os seus olhos do justo, e põe aos reis sôbre o trono para sempre, e êles são exalçados."},{text:"8 E se estiverem em cadeias e atados com os laços da pobreza:"},{text:"9 Êle lhes fará ver as suas obras, e as suas maldades, porque foram violentos."},{text:"10 E lhes abrirá também o seu ouvido para os repreender: E lhes falará, para que se convertam da sua iniqüidade."},{text:"11 Se ouvirem e cumprirem, acabarão os seus dias em bem, e os seus anos em glória:"},{text:"12 Porém se não ouvirem passarão por espada, e serão consumidos na sua sandice."},{text:"13 Os dissimulados, e dobres do coração provocam contra si a ira de Deus, nem clamarão, quando se virem manietados."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"14 A sua alma morrerá na tempestade, e sua vida acabará entre os depravados."},{text:"15 Êle livrará da sua angústia, ao pobre, e lhe abrirá o ouvido na tribulação."},{text:"16 Êle te salvará pois da bôca da angústia, e que não tem fundo debaixo de si largamente: E o descanso da tua mesa estará cheio de gordura."},{text:"17 A tua causa tem sido julgada, como a de um ímpio; ganharás a causa e sentença."},{text:"18 Não te vença pois a ira, para oprimires a alguém: Nem te dobre multidão de dádivas:"},{text:"19 Reprime a tua grandeza sem tribulação, e todos os robustos com fortaleza."},{text:"20 Não dilates a noite, para que subam os povos por êles."},{text:"21 Guarda-te de declinares para a iniqüidade: Porque tu a começaste a seguir depois que caíste na miséria."},{text:"22 Olha como Deus é excelso na sua fortaleza, e nenhum semelhante a êle entre os legisladores."},{text:"23 Quem poderá esquadrinhar os seus caminhos? Ou quem poderá dizer-lhe: Tu fizeste uma injustiça?"},{text:"24 Lembra-te que não compreendes a sua obra, da qual cantaram os homens."},{text:"25 Todos os homens o vêem, mas cada um o vê de longe."},{text:"26 Com efeito, Deus é grande, que sobreexcede a nossa ciência: Os seus anos são inumeráveis."},{text:"27 Êle detém as gôtas da chuva, e verte as águas do céu como arroios."},{text:"28 As quais caem das nuvens, que cobrem tudo por cima."},{text:"29 Se quiser estender as nuvens como pavilhão seu,"},{text:"30 e fuzilar relâmpagos com a sua luz desde o alto, cobrirá também as extremidades do mar."},{text:"31 Porque por meio destas coisas exercita os seus juízos sôbre os povos, e alimenta a muitos mortais."},{text:"32 Nas suas mãos esconde a luz, e lhe manda que torne de novo."},{text:"33 Faz conhecer a quem ama, que esta é possessão sua, e que até ela pode subir."},{text:"Jó — capítulo 37."},{text:"1 Sôbre isto se espantou o meu coração, e 