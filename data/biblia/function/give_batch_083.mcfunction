give @p minecraft:written_book[written_book_content={title:"1 Timóteo Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 A viúva seja eleita, não tendo menos de sessenta anos, a qual não haja tido mais de um marido."},{text:"10 Aprovada com testemunho de boas obras, se educou a seus filhos, se exercitou a hospitalidade, se lavou os pés aos Santos, se acudiu ao alívio dos atribulados, se praticou tôda a obra boa."},{text:"11 Mas não admitas viúvas moças. Porque depois de terem vivido licenciosamente contra Cristo, querem casar-se:"},{text:"12 Tendo a sua condenação, porque fizeram vã a primeira fé:"},{text:"13 Além disto, vivendo também na ociosidade, elas se acostumam a andar de casa em casa: Não sòmente feitas ociosas, mas também palreiras, e curiosas, falando o que não convém."},{text:"14 Quero, pois, que as que são moças se casem, criem filhos, governem a casa, que não dêem ocasião ao adversário de dizer mal."},{text:"15 Porque já algumas se perverteram por irem após satanás."},{text:"16 Se algum dos fiéis tem viúvas, mantenha-as, e não seja gravada a Igreja: A fim de que haja o que baste para as que são verdadeiramente viúvas."},{text:"17 Os Presbíteros que governam bem sejam honrados com estipêndio dobrado: Principalmente os que trabalham em pregar e ensinar."},{text:"18 Porque diz a Escritura: Não ligarás a bôca ao boi que debulha. E o que trabalha é digno da sua paga."},{text:"19 Não recebas acusação contra os Presbíteros, senão com duas ou três testemunhas."},{text:"20 Aos que pecarem reprende-os diante de todos, para que também os outros tenham mêdo."},{text:"21 Eu te esconjuro diante de Deus, e de Jesus Cristo e dos seus Anjos escolhidos, que guardes estas coisas sem preocupação, não fazendo nada por inclinação particular."},{text:"22 A ninguém imponhas ligeiramente as mãos, e não te faças participante dos pecados de outrem. Conserva-te a ti mesmo puro."},{text:"23 Não bebas mais água só, mas usa de um pouco de vinho por causa do teu estômago, e das tuas freqüentes enfermidades."},{text:"24 Os pecados de alguns homens são manifestos antes de se examinarem em juízo. Mas os de outros se manifestam ainda depois dêle."},{text:"25 Assim mesmo as boas obras também são manifestas: E as que o não são ainda, não podem por muito tempo estar ocultas."},{text:"1 Timóteo — capítulo 6."},{text:"1 Timóteo 6"},{text:"2 E os que têm senhores fiéis não os desprezem, porque são irmãos: Antes os sirvam melhor, porque são fiéis, e amados, como participantes que são do benefício. Isto ensina tu, e admoesta."},{text:"3 tools — see the cookie policy for details"},{text:"4 É um soberbo, que nada sabe, mas antes titubeia sôbre questões e contendas de palavras: De onde se originam invejas, bulhas, blasfêmias, más suspeitas:"},{text:"5 Altercações de homens perversos de entendimento, e que estão privados da verdade, crendo que a piedade é um mero interêsse."},{text:"6 Mas a piedade é um grande lucro com o que basta."},{text:"7 Porque nada trouxemos para êste mundo: E é sem dúvida que não podemos levar nada dêle."},{text:"8 Tendo, pois, com que nos sustentarmos, e com que nos cobrirmos, contentemo-nos com isto."},{text:"9 Porque os que querem fazer-se ricos, caem na tentação, e no laço do diabo, e em muitos desejos inúteis e perniciosos, que submergem os homens no abismo da morte, e da perdição."},{text:"10 Porque a raiz de todos os males é a avareza: A qual cobiçando alguns se desencaminharam da fé, e se enredaram em muitas dores."},{text:"11 Mas tu, ó homem de Deus, foge destas coisas, e segue em tudo a justiça, a piedade, a fé, a caridade, a paciência, a mansidão."},{text:"12 Há-te com valor no santo combate da fé, trabalha por levar a vida eterna, para a qual fôste chamado, havendo também feito boa confissão ante muitas testemunhas."},{text:"13 Eu te mando diante de Deus, que vivifica tôdas as coisas, e diante de Jesus Cristo, que sob Pôncio Pilatos deu testemunho da verdade, por uma boa confissão:"},{text:"14 Que guardes o mandamento sem mácula, nem repreensão, até à vinda de nosso Senhor Jesus Cristo."},{text:"15 A qual mostrará a seu tempo o bem-aventurado, o só Poderoso, o Rei dos Reis, e o Senhor dos Senhores:"},{text:"16 Aquêle que só possui a imortalidade, e que habita numa luz inacessível: A quem nenhum dos homens viu, nem ainda pode ver: Ao qual seja dada honra, e império sem fim. Amém."},{text:"17 Manda aos ricos dêste mundo que não sejam altivos, nem esperem na incerteza das riquezas, senão no Deus vivo (que nos dá abundantemente tôdas as coisas para nosso uso)."},{text:"18 que façam bem, que se façam ricos em boas obras, que dêem, que repartam francamente,"},{text:"19 que façam para si um tesouro, como um fundamento sólido para o futuro, a fim de alcançarem a verdadeira vida."},{text:"20 Ó Timóteo, guarda o depósito, evitando as profanas novidades de palavras, e as contradições duma ciência de falso nome,"},{text:"21 da qual fazendo alguns profissão, descairam da fé. A graça seja contigo. Amém."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Timóteo Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Timóteo — capítulo 1."},{text:"1 Paulo, Apóstolo de Jesus Cristo pela vontade de Deus, segundo a promessa da vida, que é em Jesus Cristo:"},{text:"2 Timóteo 1"},{text:"3 tools — see the cookie policy for details"},{text:"4 Desejando ver-te lembrado das tuas lágrimas, para me encher de gôsto."},{text:"5 Trazendo à memória aquela fé, que há em ti não fingida, a qual não só habitou primeiro em tua avó Loide, mas também na tua mãe Eunice, e estou certo que também em ti."},{text:"6 Pelo qual motivo te admoesto que tornes a acender o fogo da graça de Deus, que recebeste pela imposição das minhas mãos."},{text:"7 Porque Deus não nos deu um espírito de pusilanimidade: Mas de fortaleza, e de caridade, e de temperança."},{text:"8 Portanto não te envergonhes do testemunho de nosso Senhor, nem de mim que sou prêso seu: Antes trabalha comigo no Evangelho, segundo a virtude de Deus:"},{text:"9 Que nos livrou, e chamou com a sua santa vocação, não segundo as nossas obras, mas segundo o seu propósito e graça, que nos foi dada em Jesus Cristo antes de todos os séculos."},{text:"10 E que agora foi manifestada pela aparição de nosso Salvador Jesus Cristo, o qual na verdade destruiu a morte, e tirou à luz a vida, e a imortalidade pelo Evangelho:"},{text:"11 No qual eu fui constituído pregador, e Apóstolo, e mestre das Gentes."},{text:"12 Por cuja causa também padeço isto, mas não me envergonho. Porque sei a quem tenho crido, e estou certo de que êle é poderoso para guardar o meu depósito para aquêle dia."},{text:"13 Guarda a forma das sãs palavras, que me tens ouvido na Fé e no amor em Jesus Cristo."},{text:"14 Guarda o bom depósito pelo Espírito Santo, que habita em nós outros."},{text:"15 Tu sabes isto, que se apartaram de mim todos os que estão na Ásia, do número dos quais é Figelo e Hermógenes."},{text:"16 O Senhor faça misericórdia à casa de Onesíforo: Porque muitas vêzes me consolou, e não teve vergonha das minhas cadeias."},{text:"17 Antes quando veio a Roma, me buscou com diligência e me achou."},{text:"18 O Senhor lhe faça a graça de achar misericórdia diante do Senhor naquele dia. E quanto serviço êle me fêz em Éfeso melhor o sabes tu."},{text:"2 Timóteo — capítulo 2."},{text:"1 Tu pois, filho meu, fortifica-te pela graça, que é em Jesus Cristo:"},{text:"2 Timóteo 2"},{text:"3 tools — see the cookie policy for details"},{text:"4 Ninguém, que milita para Deus, se embaraça com negócio do século: Para assim agradar àquele que o alistou."},{text:"5 Porque também o que combate nos jogos públicos, não é coroado senão depois que combateu conforme a lei."},{text:"6 Convém que o lavrador que trabalha recolha dos frutos primeiro."},{text:"7 Percebe o que te digo: Porque o Senhor te dará inteligência em tôdas as coisas."},{text:"8 Lembra-te que o Senhor JESUS CRISTO, que nasceu do sangue de Davi, ressurgiu dos mortos, segundo o Evangelho que eu prego."},{text:"9 No qual eu trabalho até estar em prisões, como um malfeitor: Mas a palavra de Deus não está comigo atada."},{text:"10 Portanto sofro tudo pelos escolhidos, para que também êles consigam a salvação, que é em Jesus Cristo, com a glória do Céu."},{text:"11 Esta é uma palavra fiel: Se pois somos mortos com êle, também com êle viveremos."},{text:"12 Se sofrermos, reinaremos também com êle, se o negarmos, êle também nos negará a nós."},{text:"13 Se não cremos, êle permanece fiel, não pode negar-se a si mesmo."},{text:"14 Admoesta estas coisas: Dando testemunho diante do Senhor. Foge de contendas de palavras: Que para nada aproveitam, senão para perverter aos que as ouvem."},{text:"15 Cuida muito em te apresentares a Deus digno de aprovação, como um operário que não tem de que se envergonhar, que maneja bem a palavra da verdade."},{text:"16 Mas evita as práticas vãs e profanas: Porque servem muito para a impiedade."},{text:"17 E a prática dêles lavra como gangrena, de cujo número é Himeneu, e Fileto."},{text:"18 Que se extraviaram da verdade, dizendo que a ressurreição era já feita, e perverteram a fé de alguns."},{text:"19 Porém o fundamento de Deus está firme, o qual tem êste sêlo: O Senhor conhece aos que são dêle, e aparte-se da iniqüidade todo aquêle que invoca o Nome do Senhor."},{text:"20 Ora numa grande casa há não sòmente vasos de ouro e de prata, mas também vasos de pau e de barro: E uns por certo são destinados a usos de honra, outros porém a usos de desonra."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Timóteo Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 Se algum pois se purificar destas coisas, será um vaso de honra santificado, e útil para serviço do Senhor, preparado para tôda a boa obra."},{text:"22 Foge outrossim das paixões da gente moça, e segue a justiça, a fé, a esperança, a caridade e paz com aquêles que invocam o Senhor com pureza de coração."},{text:"23 Evita igualmente questões desassizadas, e que não servem para instrução: Sabendo que produzem contendas."},{text:"24 Porque não convém que o servo do Senhor se ponha a altercar: Mas que seja manso para com todos, capaz de instruir, sofrido,"},{text:"25 que corrija com modéstia aos que resistem à verdade: Na esperança de que poderá Deus algum dia dar-lhes o dom da penitência, para lhes fazer conhecer a verdade,"},{text:"26 e que saiam dos laços do diabo, em que estão cativos à vontade dêle."},{text:"2 Timóteo — capítulo 3."},{text:"1 Sabe pois isto, que nos últimos dias virão uns tempos perigosos:"},{text:"2 Timóteo 3"},{text:"3 tools — see the cookie policy for details"},{text:"4 Traidores, protervos, orgulhosos e mais amigos de deleites do que de Deus."},{text:"5 Tendo por certo uma aparência de piedade, porém negando a virtude dela. Foge também dêstes tais."},{text:"6 Porque dêste número são os que entram pelas casas e levam cativas mulherzinhas carregadas de pecados, as quais são arrastadas de diversas paixões,"},{text:"7 Aprendendo sempre, e nunca chegando ao conhecimento da verdade."},{text:"8 E assim como Janes e Mambres resistiram a Moisés: Assim também êstes resistem à verdade, homens corrompidos do coração, réprobos acêrca da fé."},{text:"9 Mas êles não irão com o seu progresso avante: Porque se fará manifesta a todos a sua insipiência, como também se fêz a daqueles."},{text:"10 Tu porém já tens compreendido a minha doutrina, instituição, intento, fé, longanimidade, caridade, paciência."},{text:"11 As minhas perseguiçõe