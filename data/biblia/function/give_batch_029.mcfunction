give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 17",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 Não o quis Amasias ouvir, porque era vontade do Senhor entregá-lo nas mãos dos inimigos por causa dos deuses de Edom."},{text:"21 Saiu pois Joás rei de Israel em marcha, e puseram-se os exércitos à vista um do outro: E Amasias rei de Judá estava acampado em Betsames de Judá:"},{text:"22 E Judá caiu diante de Israel, e fugiu para as suas tendas."},{text:"23 Enfim Joás rei de Israel apanhou a Amasias rei de Judá, filho de Joás, filho de Joacaz em Betsames, e o levou a Jerusalém: E derribou o muro da cidade desde a porta de Efraim até à porta do ângulo quatrocentos"},{text:"côvados."},{text:"24 E trouxe para Samaria todo o ouro, e prata, e todos os vasos, que achou na casa de Deus, e na de Obededom, e nos tesouros da casa real, e assim mesmo os filhos dos que estavam em reféns."},{text:"25 E Amasias filho do rei Joás, rei de Judá, viveu quinze anos depois da morte de Joás, filho de Joacaz, rei de Israel."},{text:"26 E o resto das ações de Amasias tanto as primeiras como as últimas estão escritas nos livros dos reis de Judá e de Israel."},{text:"27 E depois que êste príncipe abandonou o Senhor, armaram uma conjuração contra êle em Jerusalém. E tendo fugido para Laquis, os conjurados mandaram homens, e êstes o mataram ali."},{text:"28 E trazendo-o sôbre uns cavalos, o enterraram com os seus maiores na cidade de Davi."},{text:"2 Crônicas — capítulo 26."},{text:"1 Todo o povo de Judá constituiu rei a seu filho Ozias em idade de dezesseis anos, em lugar de Amasias seu pai."},{text:"2 E reedificou a Ailat, e a restituiu ao domínio de Judá depois que o rei adormeceu com seus pais."},{text:"3 tools — see the cookie policy for details"},{text:"4 E êle fêz o que era reto aos olhos do Senhor conforme tudo o que tinha feito Amasias seu pai."},{text:"5 E buscou o Senhor enquanto viveu Zacarias homem inteligente e profeta de Deus: E como êle buscava o Senhor, o Senhor o dirigiu em tudo."},{text:"6 Enfim êle se pôs em campanha, e fêz guerra aos filisteus e destruiu os muros de Get, e os muros de Jabnia, e os muros de Azoto: Edificou também praças fortes em Azoto, e nas terras dos filisteus."},{text:"7 E Deus o ajudou contra os filisteus, e contra os árabes, que habitavam em Gurbaal, e contra os amonitas."},{text:"8 E os amonitas pagavam tributos a Ozias: E a sua reputação se difundiu até o Egito por causa das suas freqüentes vitórias."},{text:"9 E levantou Ozias tôrres em Jerusalém sôbre a porta do ângulo, e sôbre a porta do vale, e outras mais no mesmo lanço do muro, e fortificou-as."},{text:"10 Edificou também tôrres no deserto, e mandou abrir muitas cisternas, porque tinha muito gado, assim nos campos, como pelo vasto ermo: Tinha também vinhas e vinhateiros nos montes, e no Carmelo: Porque era homem"},{text:"afeiçoado à agricultura."},{text:"11 E o exército dos seus guerreiros, que saíam à campanha estava debaixo do mando de Jeiel secretário, e de Maasias doutor da lei, e debaixo do mando de Hananias, que era um dos generais do rei."},{text:"12 E todo o número dos príncipes das famílias dos homens de valor, montava a dois mil e seiscentos."},{text:"13 E estava debaixo das suas ordens o exército, que era de trezentos e sete mil e quinhentos soldados: Os quais eram gente guerreira, e pelejavam pelo rei contra os inimigos."},{text:"14 E Ozias os proveu, isto é, a todo o exército, de escudos, e de lanças, e de capacetes, e de couraças, e de arcos, e de fundas para atirar pedras."},{text:"15 E mandou fazer em Jerusalém tôda a casta de máquinas, as quais mandou pôr nas tôrres, e nos cantos das muralhas, para se arrojarem flechas, e grossas pedras: E a fama do seu nome voou até muito longe, porque o Senhor"},{text:"o auxiliava, e o fortalecia."},{text:"16 Mas tendo chegado a tanto poder, o seu coração se elevou de soberba para ruína sua: E desprezou o Senhor seu Deus: E tendo entrado no templo do Senhor, quis oferecer incenso sôbre o Altar dos perfumes."},{text:"17 E entrou logo após êle o pontífice Azarias, e com êle oitenta sacerdotes do Senhor, homens da maior firmeza."},{text:"18 E se opuseram ao rei, e disseram: A ti, Ozias, não é que pertence o queimar incenso ao Senhor, mas aos sacerdotes, isto é, aos filhos de Aarão, que foram consagrados para êste ministério: Sai do santuário, não queiras"},{text:"fazer êste desprêzo: Porque esta ação não te será reputada em glória pelo Senhor Deus."},{text:"19 E Ozias irado, tendo na mão o turíbulo para oferecer incenso, ameaçou os sacerdotes. E no mesmo ponto lhe nasceu lepra na testa em presença dos sacerdotes, no templo do Senhor, junto ao altar dos perfumes."},{text:"20 E como o pontífice Azarias, e todos os outros sacerdotes pusessem nêle os olhos, viram a lepra na sua testa, e sem mais detença o lançaram fora. E êle mesmo passado de mêdo, deu pressa a sair, porque logo sentiu a"},{text:"praga com que o Senhor o tinha ferido."},{text:"21 O rei Ozias pois foi leproso até o dia da sua morte, e morou numa casa separada, cheio de lepra, por amor da qual tinha sido lançado fora da casa do Senhor. Joatão seu filho governava a casa do rei, e fazia justiça ao"},{text:"povo da terra."},{text:"22 O resto das ações de Ozias assim das primeiras como das últimas foi escrito pelo profeta Isaías, filho de Amós."},{text:"23 E Ozias adormeceu com seus pais, e foi enterrado no campo dos sepulcros dos reis, porque era leproso: E em seu lugar reinou seu filho Joatão."},{text:"2 Crônicas — capítulo 27."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 18",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Joatão era de vinte e cinco anos quando começou a reinar, e reinou dezesseis anos em Jerusalém: Sua mãe chamava-se Jerusa filha de Sadoc."},{text:"2 E êle fêz o que era reto diante do Senhor conforme tudo o que havia feito Ozias seu pai, exceto que não entrou no templo do Senhor, e ainda o povo prosseguia a delinqüir."},{text:"3 tools — see the cookie policy for details"},{text:"4 Mandou também fundar cidades nos montes de Judá, e castelos, e tôrres nos bosques."},{text:"5 O mesmo fêz guerra ao rei dos amonitas, e os venceu, e por êsse tempo lhe deram os filhos de Amon cem talentos de prata, e dez mil coros de trigo, e outros tantos de cevada: Isto lhe deram os filhos de Amon no segundo"},{text:"e terceiro ano."},{text:"6 E Joatão se fêz pujante, porque tinha dirigido os seus caminhos na presença do Senhor seu Deus."},{text:"7 E o resto das ações de Joatão, e tôdas as suas guerras, e emprêsas, estão escritas no livro dos reis de Israel e de Judá."},{text:"8 E êle tinha vinte e cinco anos quando entrou a reinar, e reinou dezesseis anos em Jerusalém."},{text:"9 E adormeceu Joatão com seus pais e enterraram-no na cidade de Davi: E em lugar dêle reinou seu filho Acaz."},{text:"2 Crônicas — capítulo 28."},{text:"1 Acaz tinha vinte anos quando começou a reinar e reinou dezesseis anos em Jerusalém: Êle não fêz o que era reto na presença do Senhor como Davi seu pai:"},{text:"2 Mas andou pelos caminhos dos reis de Israel e até mandou fundir estátuas a Baal."},{text:"3 tools — see the cookie policy for details"},{text:"4 E sacrificava, e queimava perfumes nos altos e nos outeiros, e debaixo de tôdas as árvores frondosas."},{text:"5 E o Senhor seu Deus o entregou nas mãos do rei da Síria, que o desbaratou, e que levou para Damasco uma grande prêsa do seu domínio: Entregou-o também nas mãos do rei de Israel, e foi ferido de uma grande calamidade."},{text:"6 Porque Facéia, filho de Romélia, matou cento e vinte mil homens de Judá num só dia, todos homens guerreiros: Porque êles tinham abandonado o Senhor Deus de seus pais."},{text:"7 No mesmo tempo Zecri, homem poderoso de Efraim, matou a Maasias filho do rei, e a Ezrica mordomo-mor da sua casa, e a Elcana o segundo abaixo do rei."},{text:"8 E os filhos de Israel fizeram cativos duzentos mil, de seus irmãos, mulheres, meninos, e meninas, e um grande esbulho: E os levaram para Samaria."},{text:"9 Achava-se então lá um profeta do Senhor, por nome Oded: O qual saindo ao encontro ao exército que vinha para Samaria, lhes disse: Vós vêdes que o Senhor Deus de vossos pais, irado contra Judá, vo-los entregou às mãos,"},{text:"e vós os matastes desumanissimamente, de sorte que a vossa crueldade chegou até o céu."},{text:"10 Além disto quereis ainda sujeitar os filhos de Judá, e de Jerusalém, para serem escravos e escravas: O que vós não deveis fazer: Porque nisso pecastes vós contra o Senhor vosso Deus."},{text:"11 Mas ouvi o meu conselho, e reconduzi os cativos, que vós trouxestes de entre vossos irmãos, porque um grande furor do Senhor está a descarregar sôbre vós."},{text:"12 Assim alguns dos príncipes dos filhos de Efraim, a saber, Azarias filho de Joanan, Baraquias filho de Mosolamot, Ezequias filho de Selum, e Amasa filho de Adali se puseram diante dos que voltavam da batalha,"},{text:"13 E lhes disseram: Não introduzais aqui os cativos, não suceda que pequemos contra o Senhor: Por que quereis vós ajuntar novos pecados aos que já temos cometido, e acumulá-los aos antigos delitos? Porque é um grande"},{text:"pecado, e a ira do furor do Senhor está a descarregar sôbre Israel."},{text:"14 E aquêles homens guerreiros deixaram a prêsa, e tudo o que tinham tomado, diante dos príncipes, e de tôda a multidão."},{text:"15 E os sujeitos, de que falamos acima, pararam, e pegando nos cativos, e em todos os que estavam nus, vestiram-nos dos despojos: E depois de os vestirem, e calçarem, e de os refazerem de comer e de beber, de os ungirem"},{text:"para os aliviarem do cansaço, e cuidarem dêles: A todos os que não podiam andar, e eram fracos do corpo, os puseram em bêstas, e os levaram a Jericó, cidade das Palmeiras, a seus irmãos, e êles voltaram para Samaria."},{text:"16 Neste tempo o rei Acaz mandou pedir socorro ao rei dos assírios."},{text:"17 E vieram os idumeus, e mataram a muitos de Judá, e tomaram uma grande prêsa."},{text:"18 Os filisteus também se espalharam pelas cidades campestres, e ao Meio-dia de Judá, e tomaram a Betsames, e Aialon, e Gaderot, e Soco, e Tamnan, e Gamzo, com as suas aldeias, e estabeleceram-se nelas."},{text:"19 O Senhor pois tinha humilhado a Judá por causa de Acaz rei de Judá, porque o tinha despojado de socorro, e porque havia desprezado o Senhor."},{text:"20 Fêz o Senhor também vir contra êle a Telgatfalnasar rei dos assírios, que também o bateu, e destruiu sem resistência alguma."},{text:"21 Acaz pois, despojada a casa do Senhor, e o palácio dos reis, e dos príncipes, presenteou ao rei dos assírios, e todavia lhe não serviu de nada."},{text:"22 Além disto ainda no tempo da sua maior aflição, aumentou o desprêzo contra o Senhor; o rei Acaz, por si mesmo,"},{text:"23 imolou vítimas aos deuses de Damasco, como autores das suas desgraças, e disse: Os deuses dos reis da Síria dão socorro a êstes, a quem eu farei favoráveis com os sacrifícios, e êles me assistirão, quando pelo"},{text:"contrário êles foram a sua ruína, e de todo o Israel."},{text:"24 Acaz pois, tendo tomado, e feito em pedaços todos os vasos da casa de Deus, fechou as portas do templo de Deus, e mandou levantar altares a si em tôdas as praças de Jerusalém."},{text:"25 Levantou também altares em tôdas as cidades de Judá para oferecer incenso, e provocou a ira do Senhor Deus de seus pais."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 19",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 O resto das suas ações, e de todo o seu procedimento, desde o princípio até ao fim está escrito no livro dos reis de Judá e de Israel."},{text:"27 E Acaz adormeceu com seus pais, e o enterraram na cidade de Jerusalém: Mas não o puseram no jazigo dos reis de Israel, e em lugar dêle reinou seu filho Ezequias."},{text:"2 Crônicas — capítulo 29."},{text:"1 Ezequias pois começou a reinar, tendo de idade vinte e cinco anos, e reinou vinte e nove em Jerusalém: Sua mãe chamava-se Abia, filha de Zacarias."},{text:"2 E êle fêz o que era agradável aos olhos do Senhor, conforme tudo o que tinha feito Davi seu pai."},{text:"3 tools — see the cookie policy for details"},{text:"4 Fêz também vir os sacerdotes e os levitas, e ajuntou-os na praça do Oriente."},{text:"5 E lhes disse: Ouvi-me levitas, e purificai-vos, limpai a casa do Senhor Deus de vossos pais, e tirai do Santuário tôda a imundície."},{text:"6 Nossos pais pecaram, e cometeram o mal diante do Senhor nosso Deus, abandonando-o: Apartaram os seus rostos do tabernáculo do Senhor, e deram-lhe as costas."},{text:"7 Fecharam as portas que havia no pórtico, e apagaram as lâmpadas, e não queimaram incenso, e não ofereceram holocaustos no santuário ao Deus de Israel."},{text:"8 Assim a ira do Senhor se inflamou contra Judá e Jerusalém, e êle os entregou à turbação, e à ruína, e aos assobios, como vós mesmos o estais vendo com os vossos olhos."},{text:"9 Reparai, que nossos pais pereceram à espada, e que nossos filhos, e nossas filhas e nossas mulheres foram levadas cativas em pena de tão grande crime."},{text:"10 Agora eu sou logo de parecer que renovemos a aliança com o Senhor Deus de Israel, e êle apartará de cima de nós o furor da sua ira."},{text:"11 Filhos meus, não sejais negligentes: O Senhor escolheu-vos para estardes em sua presença, e para o servirdes, e para lhe dardes culto, e para lhe queimardes incenso."},{text:"12 Levantaram-se pois os levitas: Dentre os descendentes de Caat, Maat filho de Amasai, e Joel filho de Azarias: E dos descendentes de Merari, Cis filho de Abdi, e Azarias filho de Jalaleel. E dos descendentes de Gérson,"},{text:"Joá filho de Zema, e Eden filho de Joá."},{text:"13 E dos descendentes de Elisafan, Samri, e Jaiel. E dos descendentes de Asaf, Zacarias, e Matanias:"},{text:"14 E dos descendentes de Eman, Jaiel, e Semei: E dos descendentes de Iditun, Semeias e Oziel."},{text:"15 E congregaram a seus irmãos, e se purificaram, e entraram segundo a ordem do rei e o mandamento do Senhor para purificarem a casa de Deus."},{text:"16 E tendo os sacerdotes entrado no templo do Senhor para o santificarem, tiraram para fora tôda a imundície que acharam dentro no vestíbulo da casa do Senhor, a qual tomaram os levitas, e a levaram fora à torrente do"},{text:"Cedron."},{text:"17 E começaram a limpar no primeiro dia do primeiro mês, e ao oitavo dia do mesmo mês entraram no pórtico do templo do Senhor, e no espaço de oito dias expiaram o templo: E no dia décimo sexto do mesmo mês acabaram o que"},{text:"tinham começado."},{text:"18 E foram ao palácio do rei Ezequias, e lhe disseram: Nós temos santificado tôda a casa do Senhor, e o altar dos holocaustos, e os seus vasos, e assim mesmo a mesa da proposição com todos os seus vasos,"},{text:"19 e tôdas as alfaias do templo, que o rei Acaz tinha profanado no seu reinado depois que prevaricou: E eis-aí está tudo exposto diante do altar do Senhor."},{text:"20 E o rei Ezequias, levantando-se de madrugada, convocou todos os príncipes da cidade, e subiu à casa do Senhor:"},{text:"21 E todos ofereceram juntos sete touros, e sete carneiros, sete borregos, e sete bodes pelo pecado, pelo reino, e pelo santuário, e por Judá, e disse aos sacerdotes descendentes de Aarão que os oferecessem sôbre o altar"},{text:"do Senhor."},{text:"22 Os sacerdotes pois imolaram os touros, e tomaram o sangue, e o derramaram sôbre o altar, imolaram também os carneiros, e derramaram também o seu sangue sôbre o altar, e imolaram os borregos, e derramaram o sangue"},{text:"sôbre o altar."},{text:"23 E trouxeram diante do rei, e de tôda a multidão os bodes pelo pecado, e impuseram-lhes as suas mãos:"},{text:"24 E os sacerdotes os imolaram, e derramaram o seu sangue diante do altar para expiação de todo o Israel: Porque tinha mandado o rei que se oferecesse o holocausto por todo o Israel, e pelo pecado."},{text:"25 Estabeleceu também os levitas na casa do Senhor com tímbales, e saltérios, e cítaras, segundo o disposto do rei Davi, e de Gad Vidente, e de Natan profeta: Porque o Senhor assim o tinha ordenado pelo ministério dos"},{text:"seus profetas."},{text:"26 E os levitas se puseram em pé tendo os instrumentos de Davi, e os sacerdotes as trombetas."},{text:"27 E mandou Ezequias que oferecessem os holocaustos sôbre o altar: E quando se ofereciam os holocaustos, começaram êles a cantar louvores ao Senhor, e a tocar as trombetas, e a tanger os diversos instrumentos músicos,"},{text:"que Davi rei de Israel tinha disposto."},{text:"28 E enquanto todo o povo adorava, os cantores, e os que tinham as trombetas, cumpriam com o seu ministério, até que o holocausto se acabasse."},{text:"29 E finda que foi a oblação, prostrou-se o rei, e todos os que estavam com êle, e adoraram."},{text:"30 E Ezequias, e os senhores da côrte mandaram aos levitas, que cantassem os louvores a Deus pelas palavras de Davi, e do profeta Asaf: E êles o louvaram com grande alegria, e postos de joelhos o adoraram."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 20",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 E a isto ajuntou Ezequias ainda o seguinte: Vós enchestes as vossas mãos para o Senhor, chegai-vos, e oferecei vítimas, e louvores na casa do Senhor. Ofereceu pois tôda a multidão hóstias, e louvores, e holocaustos"},{text:"com um espírito cheio de devoção."},{text:"32 E o número dos holocaustos, que a multidão ofereceu, foi êste: Setenta touros, cem carneiros, e duzentos borregos."},{text:"33 Consagraram também ao Senhor seiscentos bois, e três mil ovelhas."},{text:"34 Os sacerdotes porém eram poucos, e não podiam bastar para esfolar as vítimas dos holocaustos: E por isso os levitas seus irmãos os ajudaram até se acabar o ministério, e se purificarem os prelados: Porque os levitas"},{text:"se purificavam com menos cerimônias do que os sacerdotes."},{text:"35 Foram pois muitos os holocaustos, as banhas das hóstias pacíficas, e as libações dos holocaustos: E restabeleceu-se o culto da casa do Senhor."},{text:"36 E Ezequias, e todo o povo se alegrou, por se ter restituído o ministério do culto do Senhor. Porque êle quis que isto se fizesse de improviso."},{text:"2 Crônicas — capítulo 30."},{text:"1 Enviou também Ezequias por todo o Israel e Judá e escreveu cartas aos de Efraim e de Manassés, para que viessem à casa do Senhor, em Jerusalém, e celebrassem a Páscoa ao Senhor Deus de Israel."},{text:"2 Tendo pois conselho o rei com os grandes, e com todo o povo em Jerusalém, determinaram celebrar a Páscoa no segundo mês."},{text:"3 tools — see the cookie policy for details"},{text:"4 E tomou esta resolução o rei, e todo o povo."},{text:"5 E ordenaram que se mandassem mensageiros por todo o Israel desde Bersabée até Dan, para que viessem, e celebrassem a Páscoa do Senhor Deus de Israel em Jerusalém: Porque muitos a não tinham celebrado como estava"},{text:"prescrito pela lei."},{text:"6 E partiram os correios com as cartas por mandado do rei e dos seus grandes, para todo o Israel e Judá, conforme o que o rei tinha ordenado, publicando: Filhos de Israel, tornai para o Senhor Deus de Abraão, e de Isaac,"},{text:"e de Israel: E êle tornará para os restos, que escaparam da mão do rei dos assírios."},{text:"7 Não façais como vossos pais e irmãos, que se retiraram do Senhor Deus de seus pais, que os entregou à morte, como vós mesmos o estais vendo."},{text:"8 Não endureçais as vossas cervizes, como vossos pais: Dai as mãos ao Senhor, e vinde ao seu santuário, que êle santificou para sempre: Servi ao Senhor Deus de vossos pais, e se apartará de vós a ira do seu furor."},{text:"9 Porque se vós voltardes para o Senhor: Vossos irmãos e filhos acharão misericórdia diante de seus senhores, que os levaram cativos, e êles tornarão para esta terra: Porque o Senhor vosso Deus é piedoso e clemente, e"},{text:"não apartará de vós o seu rosto, se vós voltardes para êle."},{text:"10 Iam pois os correios a tôda a diligência, de cidade em cidade, por tôda a terra de Efraim, e de Manassés, até à de Zabulon: Zombando êstes dêles, e insultando-os com insolência."},{text:"11 Todavia alguns homens de Aser, e de Manassés, e de Zabulon, estando pelo conselho, vieram a Jerusalém."},{text:"12 Quanto porém a Judá, a mão do Senhor foi nêles dando-lhes um só coração, para cumprir a palavra do Senhor conforme a ordem do rei, e dos grandes."},{text:"13 E ajuntaram-se muitos povos em Jerusalém para celebrar a solenidade dos asmos, no segundo mês:"},{text:"14 E, levantando-se, destruíram os altares, que havia em Jerusalém, e derribando tudo aquilo, em que se queimava incenso aos ídolos, o lançaram na torrente do Cedron."},{text:"15 E imolaram a Páscoa no dia catorzeno do segundo mês. E os sacerdotes, e os levitas, que enfim se tinham santificado, ofereceram holocaustos na casa do Senhor."},{text:"16 E se puseram na sua ordem conforme a ordenança, e Lei de Moisés homem de Deus: E os sacerdotes recebiam da mão dos levitas o sangue que se havia de derramar,"},{text:"17 por causa de que um crescido número não se tinha santificado: E por isso os levitas imolaram a Páscoa por aquêles que não tinham vindo para santificar-se ao Senhor."},{text:"18 E ainda uma grande parte do povo de Efraim, e de Manassés, e de Issacar, e de Zabulon, que se não tinha santificado, comeu a Páscoa, não segundo o que está escrito: Mas Ezequias fêz oração por êles, dizendo: O Senhor,"},{text:"que é bom, será propício"},{text:"19 a todos os que buscam de todo o seu coração o Senhor Deus de seus pais: E êle lhes não imputará falta de não estarem bem purificados."},{text:"20 Ouviu-o o Senhor, e se mostrou favorável ao povo."},{text:"21 E os filhos de Israel, que se acharam em Jerusalém, celebraram a solenidade dos asmos por sete dias com grande júbilo, louvando todos os dias o Senhor: E os levitas também, e os sacerdotes tocando os instrumentos que"},{text:"correspondiam ao seu ofício."},{text:"22 E falou Ezequias ao coração de todos os levitas, que tinham boa inteligência nas coisas do Senhor: E comeram sete dias da solenidade, imolando vítimas pacíficas, e louvando ao Senhor Deus de seus pais."},{text:"23 E conveio tôda a multidão em que celebrassem ainda outros sete dias: O que êles também fizeram com um grande contentamento."},{text:"24 Porque Ezequias rei de Judá tinha dado à multidão mil touros, e sete mil ovelhas: E os grandes deram ao povo mil touros, e dez mil ovelhas: E assim um grande número de sacerdotes se purificou."},{text:"25 E todo o povo de Judá, assim os sacerdotes e os levitas, como tôda a multidão que viera da terra de Israel se banhou de alegria: E os mesmos prosélitos da terra de Israel, e os que habitavam em Judá."},{text:"26 E fêz-se uma grande solenidade em Jerusalém, qual não tinha havido naquela cidade desde o tempo de Salomão filho de Davi, rei de Israel."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"27 Enfim os sacerdotes e os levitas se levantaram para abençoar o povo: E a sua voz foi ouvida: E a sua oração chegou até à santa morada do céu."},{text:"2 Crônicas — capítulo 31."},{text:"1 Feitas estas coisas segundo o rito, todos os israelitas, que se achavam nas cidades de Judá, saíram, e despedaçaram as estátuas, e talaram os bosques, demoliram os altos, e destruíram os altares, não só em tôda a terra"},{text:"de Judá e de Benjamim, senão também na de Efraim e de Manassés, até os destruírem de todo: E voltaram todos os filhos de Israel para as suas possessões, e para as suas cidades."},{text:"2 Mas Ezequias restabeleceu as classes dos sacerdotes, e levitas segundo as suas divisões, a cada um no seu próprio ofício, a saber, tanto dos sacerdotes como dos levitas, para os holocaustos e pacíficos, para servirem e"},{text:"louvarem a Deus, e cantarem às portas do arraial do Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Mandou também ao povo que morava em Jerusalém que desse aos sacerdotes, e aos levitas as suas porções, para se poderem aplicar ao cumprimento da lei do Senhor."},{text:"5 O que tendo chegado aos ouvidos do povo, os filhos de Israel ofereceram muitas primícias de trigo, de vinho, e de azeite, e de mel: E ofereceram o dízimo de tudo o que a terra produz."},{text:"6 E os filhos de Israel e de Judá, que moravam nas cidades de Judá, ofereceram também o dízimo dos bois e das ovelhas, e o dízimo das coisas santificadas, que tinham prometido em voto ao Senhor seu Deus: E, levando tudo,"},{text:"fizeram grandes montões."},{text:"7 Começaram a recolher os primeiros montões no terceiro mês, e os acabaram no sétimo mês."},{text:"8 E tendo entrado Ezequias, e os grandes da sua côrte, viram os montões, e louvaram ao Senhor e ao povo de Israel."},{text:"9 E perguntou Ezequias aos sacerdotes e aos levitas, porque estavam os montões assim expostos."},{text:"10 E o sumo sacerdote Azarias, da linhagem de Sadoc, lhe respondeu, dizendo: Desde que começaram a oferecer primícias na casa do Senhor, temos nós comido, e nos temos fartado delas, e tem sobejado muito, porque o Senhor"},{text:"abençoou o seu povo: E das sobras é esta grande abastança, que vês."},{text:"11 Mandou pois Ezequias que se aprontassem celeiros na casa do Senhor. O que tendo-se feito,"},{text:"12 recolheram dentro fielmente, assim as primícias, como os dízimos, e tudo o que tinham oferecido em voto. E disto foi feito superintendente o levita Conenias, e Semei seu irmão, em segundo lugar,"},{text:"13 depois dêste Jaiel, e Azarias, e Naat, e Asael, e Jerimot, e Jozabad, e Eliel, e Jesmaquias, e Maat, e Banaias, foram subordinados debaixo da autoridade de Conenias, e de Semei seu irmão, por ordem do rei Ezequias e"},{text:"de Azarias, pontífice da casa de Deus, aos quais competia tudo."},{text:"14 O levita Coré, porém, filho de Jemna e guarda da porta oriental, estava encarregado dos dons que voluntàriamente se ofereciam ao Senhor, e das primícias e das coisas consagradas ao Santo dos Santos,"},{text:"15 E debaixo da sua inspeção estavam Eden, e Benjamim, Jesué, e Semeias, e Amarias, e Sequenias nas cidades dos sacerdotes, para distribuírem fielmente aos seus irmãos as porções, tanto aos pequenos como aos grandes:"},{text:"16 compreendidos até os meninos machos desde a idade de três anos e daí para cima, enfim a todos os que entravam no templo do Senhor, e de tudo aquilo que era conducente diàriamente para todos os ministérios, e ofícios"},{text:"segundo as suas distribuições,"},{text:"17 aos sacerdotes por famílias, e aos levitas de vinte anos e daí para cima, pelas suas classes e turmas,"},{text:"18 e à tôda a multidão, tanto às mulheres, como a seus filhos dum e outro sexo, se davam fielmente alimentos daquelas coisas que tinham sido oferecidas."},{text:"19 E também dos filhos de Aarão estavam dispostos pelos campos, e pelos arrabaldes de cada cidade homens, que distribuíssem as porções a todo o sexo masculino que eram dos sacerdotes, e levitas."},{text:"20 Cumpriu pois Ezequias tudo o que temos dito em todo o reino de Judá: E fêz o que era bom e reto, e verdadeiro na presença do Senhor seu Deus"},{text:"21 em tudo o que é concernente ao serviço da casa do Senhor, segundo a lei e as cerimônias, com a vontade de buscar ao seu Deus de todo o seu coração. Êle o fêz e foi bem sucedido."},{text:"2 Crônicas — capítulo 32."},{text:"1 Depois de executadas estas coisas, e como fielmente fica referido, veio Senaquerib, rei dos assírios, e tendo entrado nas terras de Judá, pôs cêrco às cidades fortificadas, com o desígnio de as conquistar."},{text:"2 O que vendo Ezequias, isto é, que Senaquerib tinha vindo, e que todo o ímpeto da guerra se dirigia contra Jerusalém,"},{text:"3 tools — see the cookie policy for details"},{text:"4 ajuntou muita gente, e taparam tôdas as fontes, e o regato, que corria pelo meio da terra, dizendo: Não aconteça que venham os reis dos assírios, e achem abundância de água."},{text:"5 Reparou também, esmerando-se muito, todos os muros, que se achavam desmantelados, e fêz em cima tôrres e outros muros por fora: E reedificou o forte de Melo na cidade de Davi, mandou que se fizessem armas e escudos de"},{text:"todo o gênero,"},{text:"6 E nomeou oficiais que comandassem o exército: E ajuntando-os todos na praça da porta da cidade, falou-lhes ao coração, dizendo:"},{text:"7 Sêde homens de valor, e alentai-vos: Não temais, nem se vos dê do rei dos assírios, nem de tôda a multidão, que o acompanha: Porque muitos mais estão conosco, do que os que estão com êle."},{text:"8 Porque com êle está um braço de carne: Conosco o Senhor nosso Deus, que é nosso auxiliador, e que peleja por nós. E o povo cobrou ânimo com essas palavras de Ezequias rei de Judá."},{text:"9 Depois que estas coisas sucederam, Senaquerib, rei dos assírios, enviou os seus mensageiros a Jerusalém (porque êle com todo o exército estava sitiando Laquis) dizendo a Ezequias, rei de Judá, e a todo o povo, que"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 22",author:"Pe. A. P. de Figueiredo",pages:[{text:"havia na cidade:"},{text:"10 Eis-aqui o que manda dizer Senaquerib rei dos assírios: Em quem estais vós confiados para vos deixardes estar cercados em Jerusalém?"},{text:"11 Porventura Ezequias não vos engana, para vos fazer morrer à fome e à sêde, afirmando que o Senhor vosso Deus vos livrará da mão do rei dos assírios?"},{text:"12 Não é pois êste o Ezequias, que destruiu os seus altos, e os seus altares, e o que ordenou em Judá e em Jerusalém dizendo: Diante de um só altar vós adorareis, e no mesmo queimareis incenso?"},{text:"13 Ignorais acaso o que temos feito eu, e meus pais a todos os povos da terra? Porventura tiveram poder os deuses das nações e de tôdas as terras para livrar os seus países da minha mão?"},{text:"14 Qual é de todos os deuses das nações, a's quais meus antepassados devastaram, que tivesse fôrça para tirar das minhas mãos o seu povo, de sorte que possa também o vosso Deus livrar-vos de um tal poder?"},{text:"15 Não vos engane logo Ezequias, nem zombe de vós por uma vã persuasão, nem lhe deis crédito. Porque se nenhum dos deuses de tôdas as nações e de todos os reinos pôde livrar o seu povo da minha mão nem da de meus pais,"},{text:"logo conseqüentemente o vosso Deus vos não poderá livrar da minha mão."},{text:"16 Outras muitas coisas disseram ainda os mensageiros de Senaquerib contra o Senhor Deus, e contra o seu servo Ezequias:"},{text:"17 Êle escreveu também cartas cheias de blasfêmias contra o Senhor Deus de Israel, e disse contra êle: Assim como os deuses das outras nações não puderam livrar o seu povo da minha mão, assim também o Deus de Ezequias"},{text:"não poderá livrar o seu povo dêste poder."},{text:"18 E além disto a alta voz falava em língua judaica ao povo, que estava sôbre as muralhas de Jerusalém, para os atemorizar, e para se assenhorear da cidade."},{text:"19 E falou contra o Deus de Jerusalém, bem como contra os deuses dos povos da terra, que são obras das mãos dos homens."},{text:"20 Fizeram pois oração o rei Ezequias, e o profeta Isaías filho de Amós, contra esta blasfêmia, e levantaram gritos até o céu."},{text:"21 E o Senhor mandou um anjo, que matou todo o homem forte, e guerreiro, e o general do exército do rei dos assírios: E Senaquerib se recolheu com ignomínia ao seu país. E tendo entrado no templo do seu deus os filhos"},{text:"que tinham saído das suas entranhas, o mataram à espada."},{text:"22 E o Senhor salvou a Ezequias e aos habitantes de Jerusalém da mão de Senaquerib, rei dos assírios, e da mão de todos, e lhes deu paz em os contornos."},{text:"23 E muitos traziam a Jerusalém vítimas, e oferendas ao Senhor, e presentes a Ezequias rei de Judá: O qual depois disto foi engrandecido entre tôdas as nações."},{text:"24 Neste tempo adoeceu Ezequias mortalmente, e fêz a sua oração ao Senhor: E êle o ouviu, e lhe deu um sinal."},{text:"25 Mas não correspondeu aos benefícios, que tinha recebido, porque o seu coração se elevou: E a ira do Senhor se acendeu contra êle, e contra Judá e contra Jerusalém."},{text:"26 Mas depois, por se ter elevado seu coração, se humilhou tanto êle como os habitantes de Jerusalém: E por isso não veio sôbre êles a ira do Senhor durante a vida de Ezequias."},{text:"27 Ezequias porém foi rico, e de grande fama, e ajuntou para si grandes tesouros de prata e de ouro e de pedraria preciosa, de aromas, e de tôda a casta de armas, e de vasos de grande preço."},{text:"28 Teve também grandes celeiros de trigo, de vinho, e de azeite, e cavalariças para tôda a casta de animais, e currais para os gados,"},{text:"29 e edificou também cidades para si: Porque tinha inumeráveis rebanhos de ovelhas, e de gado grosso, porque o Senhor lhe tinha dado uma extraordinária abundância de bens."},{text:"30 Êste é o mesmo Ezequias, que tapou a fonte de cima das águas de Gion, e as fêz correr por baixo da terra para o poente da cidade de Davi: Em tôdas as obras que empreendeu foi bem sucedido."},{text:"31 Todavia na embaixada dos príncipes de Babilônia, que lhe tinham sido enviados, para se informarem do prodígio, que tinha acontecido na terra, Deus o desamparou para que fôsse tentado, e para se fazer patente tudo o"},{text:"que êle tinha no seu coração."},{text:"32 E o resto das ações de Ezequias, e das suas obras de misericórdia, estão escritas na visão do profeta Isaías filho de Amós, e no Livro dos reis de Judá e de Israel."},{text:"33 E adormeceu Ezequias com seus pais, e sepultaram-no sôbre os jazigos dos filhos de Davi: E todo o Judá, e todos os moradores de Jerusalém celebraram as suas exéquias: E em seu lugar reinou seu filho Manassés."},{text:"2 Crônicas — capítulo 33."},{text:"1 Manassés tinha doze anos quando começou a reinar, e reinou cinqüenta e cinco anos em Jerusalém."},{text:"2 Mas êle fêz o mal diante do Senhor seguindo as abominações dos povos, que o Senhor tinha exterminado à vista dos filhos de Israel."},{text:"3 tools — see the cookie policy for details"},{text:"4 Edificou também altares na casa do Senhor, da qual o Senhor tinha dito: O meu nome estará eternamente em Jerusalém."},{text:"5 E êle os edificou à honra de todo o exército celestial nos dois átrios da casa do Senhor."},{text:"6 Fêz também passar seus filhos pelo fogo no vale de Benenom: Observava os sonhos, seguia os agouros, dava-se às artes mágicas, tinha consigo mágicos, e encantadores. E cometeu muitos males diante do Senhor, para o"},{text:"irritar."},{text:"7 Pôs também um ídolo, e uma estátua fundida na casa do Senhor, da qual Deus falou a Davi, e a seu filho Salomão, dizendo: Nesta casa e em Jerusalém, a qual eu escolhi entre tôdas as tribos de Israel, eu estabelecerei o"},{text:"meu nome para sempre."},{text:"8 E eu não farei mais sair a Israel da terra, que dei a seus pais: Contanto que êles procurem cumprir o que eu lhes tenho mandado, e tôda a lei, e as cerimônias, e os preceitos dados por intervenção de Moisés."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 23",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Manassés pois seduziu a Judá, e aos habitantes de Jerusalém, para fazerem maiores males do que tôdas as nações, que o Senhor tinha destruído em presença dos filhos de Israel."},{text:"10 E o Senhor lhe falou a êle, e ao seu povo, e o não quiseram ouvir."},{text:"11 Por isso fêz vir Deus sôbre êles os príncipes do exército do rei dos assírios: E êstes aprisionaram a Manassés, e o levaram para Babilônia prêso com cadeias, e em grilhões."},{text:"12 Êle depois que se viu reduzido a um grande apêrto, orou ao Senhor seu Deus: E fêz grande penitência diante do Deus de seus pais."},{text:"13 E suplicou-o e rogou-o fervorosamente: E o Senhor ouviu a sua deprecação, e tornou-o a trazer a Jerusalém ao seu reino, e Manassés reconheceu que o Senhor mesmo era o Deus."},{text:"14 Depois disto fêz edificar o muro, que está fora da cidade de Davi ao ocidente de Gion no vale, desde a entrada da porta dos peixes, em roda até Ofel, e o levantou muito: E pôs oficiais do exército em tôdas as cidades"},{text:"fortes de Judá:"},{text:"15 E tirou da casa do Senhor os deuses estranhos, e o ídolo: E os altares, que tinha mandado levantar no monte da casa do Senhor, e em Jerusalém, e fêz lançar tudo fora da cidade."},{text:"16 Restituiu também o Altar do Senhor, e imolou sôbre êle vítimas, e hóstias pacíficas, e de ação de graças: E ordenou a Judá que servisse o Senhor Deus de Israel."},{text:"17 Contudo ainda o povo imolava nos altos ao Senhor seu Deus."},{text:"18 O resto dos feitos de Manassés: E a oração que êle fêz ao seu Deus: E as palavras dos profetas, que lhe falaram da parte do Senhor Deus de Israel, se encerram nos Livros dos reis de Israel."},{text:"19 A oração também que êle fêz e como foi ouvido, e todos os seus pecados, e desprezos, os lugares também em que fêz edificar os altos, em que fêz plantar os bosques, e as estátuas antes de fazer penitência, se acha tudo"},{text:"escrito no Livro de Hozai."},{text:"20 Adormeceu pois Manassés com seus pais, e foi sepultado em sua casa: E em seu lugar reinou Amon seu filho."},{text:"21 Tinha Amon vinte e dois anos quando começou a reinar, e reinou dois anos em Jerusalém."},{text:"22 E êle fêz o mal na presença do Senhor como o tinha feito seu pai Manassés: E sacrificou e serviu a todos os ídolos que Manassés mandara fabricar."},{text:"23 E não respeitou a face do Senhor, como seu pai Manassés a tinha respeitado: Mas cometeu muito maiores delitos."},{text:"24 E tendo-se conjurado contra êle seus servos, o mataram em sua casa."},{text:"25 Mas o resto do povo, depois de terem dado a morte aos matadores de Amon, constituíram rei a Josias seu filho em lugar dêle."},{text:"2 Crônicas — capítulo 34."},{text:"1 Josias tinha oito anos, quando começou a reinar, e reinou trinta e um anos em Jerusalém."},{text:"2 E fêz o que era reto na presença do Senhor, e andou nos caminhos de Davi seu pai: Não declinou nem para a direita, nem para a esquerda."},{text:"3 tools — see the cookie policy for details"},{text:"4 E destruíram na sua presença os altares de Baal: E quebraram os ídolos, que se tinham colocado em cima: Mandou cortar os bosques, e fazer em pedaços os ídolos: E ordenou que os pedaços fôssem lançados sôbre as"},{text:"sepulturas daqueles que tinham tido o costume de lhes oferecer vítimas."},{text:"5 Além disto queimou os ossos dos sacerdotes sôbre os altares dos ídolos, e expurgou a Judá e a Jerusalém."},{text:"6 E até nas cidades de Manassés, e de Efraim, e de Simeão, e até Neftali destruiu tudo isto."},{text:"7 E depois que destruiu os altares, e os bosques, e fêz em pedaços os ídolos, e arrasou todos os templos por tôda a terra de Israel, voltou para Jerusalém."},{text:"8 Assim no ano décimo oitavo do seu reinado, depois de já purificada a terra, e o Templo do Senhor, mandou a Safan filho de Eselias, e a Maasias governador da cidade, e a Joá filho de Joacaz seu cronista-mor, que"},{text:"reparassem a casa do Senhor seu Deus."},{text:"9 Vieram êles ter com o sumo sacerdote Helcias: E depois de recebido dêle o dinheiro, que se tinha trazido à casa do Senhor, e que os levitas e os porteiros tinham cobrado de Manassés, e de Efraim, e de tudo o que tinha"},{text:"ficado de Israel, também de todo o Judá e Benjamim, e dos moradores de Jerusalém,"},{text:"10 o entregaram nas mãos dos que eram os superintendentes dos oficiais que trabalhavam na casa do Senhor, para restabelecerem o Templo, e para repararem tôdas as suas ruínas."},{text:"11 E êstes o deram aos artífices, e aos canteiros para comprarem pedras de cantaria, e madeiras para o emadeiramento do edifício, e para os sobrados das casas que os reis de Judá tinham destruído."},{text:"12 Êles fizeram tudo fielmente. E os superintendentes dos oficiais eram Jaat e Abdias, da linhagem de Merari, Zacarias e Mosolão, da linhagem de Caat, os quais diligenciavam a pressa da obra: Todos levitas que sabiam"},{text:"tocar instrumentos."},{text:"13 Mas sôbre os que carregavam com os pesos para diversos usos, eram inspetores os escrivães, juízes, e porteiros da ordem dos levitas."},{text:"14 Quando porém se transportava o dinheiro, que se tinha levado ao Templo, o pontífice Helcias achou um livro da lei do Senhor dada pelas mãos de Moisés."},{text:"15 E Êle disse ao secretário Safan: Eu achei o livro da lei na casa do Senhor: E entregou-lho."},{text:"16 Mas Safan levou o livro ao rei, e deu-lhe conta, dizendo: Tudo o que tu mandaste a teus servos, executa-se fielmente."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 24",author:"Pe. A. P. de Figueiredo",pages:[{text:"17 Êles recolheram a prata, que se achou na casa do Senhor: E se deu aos prefeitos dos artífices, e dos que trabalhavam em diversos misteres."},{text:"18 Além disto o pontífice Helcias me entregou êste livro. E como êle o lêsse diante do rei,"},{text:"19 e êste ouvisse as palavras da lei, rasgou os seus vestidos:"},{text:"20 E ordenou a Helcias, e a Aicão, filho de Safan, e a Abdon filho de Mica, e ao secretário Safan, e a Asaas, servo do rei dizendo:"},{text:"21 Ide, e rogai ao Senhor por mim, e pelas relíquias de Israel, e de Judá, acêrca de tôdas as palavras dêste Livro, que se achou: Porque está a ponto de cair sôbre nós a grande ira do Senhor, porque nossos pais não"},{text:"guardaram as palavras do Senhor, cumprindo tudo o que está escrito neste Livro."},{text:"22 Foi pois Helcias, e os que tinham sido enviados juntamente pelo rei a consultar a profetisa Olda mulher de Selum, filho de Tecuat, filho de Hasra, guarda dos vestidos: A qual habitava em Jerusalém na Segunda: E êles"},{text:"lhe disseram as palavras, que referimos acima."},{text:"23 E Olda lhes respondeu: Eis-aqui o que diz o Senhor Deus de Israel: Dizei ao homem que cá vos mandou:"},{text:"24 Isto disse o Senhor: Eu estou para fazer cair sôbre êste lugar e sôbre seus habitantes os males, e tôdas as maldições que estão escritas neste livro, que foi lido diante do rei de Judá."},{text:"25 Porque êles me abandonaram, e ofereceram sacrifícios aos deuses estranhos, provocando-me a ira por tôdas as obras das suas mãos, por isso o meu furor se derramará sôbre êste lugar, e não se aplacará."},{text:"26 E quanto ao rei de Judá, que vos enviou para implorardes a misericórdia do Senhor, assim lhe direis: Eis-aqui o que diz o Senhor Deus de Israel: Porque tu ouviste as palavras do livro,"},{text:"27 e se enterneceu o teu coração, e tu te humilhaste diante de Deus por causa dos males, que foram cominados contra êste lugar, e os habitantes de Jerusalém, e porque temendo o meu rosto, rasgaste os teus vestidos, e"},{text:"choraste diante de mim: Eu também te ouvi, diz o Senhor."},{text:"28 Por isso eu te ajuntarei com teus pais e serás pôsto em paz no teu sepulcro: E os teus olhos não verão todos os males, que eu estou para mandar sôbre êste lugar, e sôbre os seus moradores. Êles pois vieram referir ao"},{text:"rei tudo o que a profetisa lhes tinha dito."},{text:"29 E o rei, depois de convocados todos os anciãos, de Judá e de Jerusalém,"},{text:"30 subiu à casa do Senhor, e juntamente com êle todos os homens de Judá e os cidadãos de Jerusalém, os sacerdotes e os levitas, e todo o povo desde o mais pequeno até o maior. E ouvindo êles na casa do Senhor leu o rei"},{text:"tôdas as palavras do livro."},{text:"31 E, pôsto em pé no seu tribunal, fêz concêrto com o Senhor, que caminharia após êle, e que guardaria os seus preceitos, e ordenanças, e as suas cerimônias, de todo o seu coração, e de tôda a sua alma, que cumpriria"},{text:"tudo o que estava escrito naquele livro, que acabava de ler."},{text:"32 E fêz prestar juramento sôbre isto a todos os que se tinham achado em Jerusalém e na tribo de Benjamim: E os moradores de Jerusalém o cumpriram, conforme o pacto do Senhor Deus de seus pais."},{text:"33 Tirou pois Josias tôdas as abominações de tôdas as terras dos filhos de Israel: E obrigou todos os que restavam em Israel, a servir ao Senhor seu Deus. E enquanto êle viveu, não se separaram do Senhor Deus de seus"},{text:"pais."},{text:"2 Crônicas — capítulo 35."},{text:"1 Depois celebrou Josias em Jerusalém a Páscoa do Senhor, a qual foi imolada no décimo quarto dia do primeiro mês:"},{text:"2 E estabeleceu os sacerdotes nos seus ministérios, e os exortou a servirem na casa do Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Preparai-vos pois pelas vossas casas, e pelas vossas famílias, segundo a distribuição de cada um de vós, assim como ordenou Davi rei de Israel, e assim o escreveu Salomão seu filho."},{text:"5 E ministrai no Santuário, segundo a distribuição das famílias e das turmas levíticas,"},{text:"6 e depois de santificados, imolai a Páscoa: E disponde também vossos irmãos para que a possam celebrar segundo o que o Senhor ordenou por meio de Moisés."},{text:"7 Deu além disso Josias a todo o povo, que se tinha ajuntado na solenidade da Páscoa, cordeiros e cabritos dos rebanhos, e do resto do seu gado, até trinta mil e três mil bois: Tudo isto da fazenda do rei."},{text:"8 Os seus oficiais também ofereceram o que tinham prometido voluntàriamente tanto ao povo, como aos sacerdotes e aos levitas. Mas Helcias, e Zacarias, e Jaiel príncipes da casa do Senhor, deram aos sacerdotes para"},{text:"celebrar a Páscoa duas mil e seiscentas reses de gado miúdo, e trezentos bois."},{text:"9 Conenias porém, e Semeias, e Natanael seus irmãos, como também Hasabias, e Jeiel, e Jozabad, chefes dos levitas, deram aos outros levitas para celebrarem a Páscoa, cinco mil reses miúdas, e quinhentos bois."},{text:"10 E preparou-se tudo para a função, e puseram-se os sacerdotes na sua ordem: E também os levitas divididos por turmas, segundo o mandado do rei."},{text:"11 Imolou-se pois a Páscoa: E os sacerdotes com as suas mãos derramaram o sangue, e os levitas esfolaram os holocaustos:"},{text:"12 E os separaram para os distribuírem pelas casas e famílias de cada um, e para os oferecerem ao Senhor, conforme o que está escrito no livro de Moisés: E o mesmo fizeram êles aos bois."},{text:"13 Depois assaram a Páscoa sôbre o lume, como está escrito na lei: Mas as hóstias pacíficas êles as cozeram em marmitas, e caldeirões, e panelas, e as distribuíram prontamente a todo o povo:"},{text:"14 E depois as prepararam para si, e para os sacerdotes. Porque os sacerdotes estiveram ocupados até à noite na oblação dos holocaustos e das banhas: Pelo que os levitas prepararam o comer para si e para os sacerdotes"}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 25",author:"Pe. A. P. de Figueiredo",pages:[{text:"filhos de Aarão em último lugar."},{text:"15 E os cantores filhos de Asaf também estavam na sua ordem, conforme o mandamento de Davi, e de Asaf, e de Heman, e de Iditun, profetas do rei. Os porteiros porém guardavam também cuidadosamente tôdas as portas, sem se"},{text:"apartarem nem um só momento do seu ministério: Por conta do que também os levitas seus irmãos lhes prepararam o comer."},{text:"16 Portanto todo o culto do Senhor foi cumprido conforme o rito naquele dia, celebrando-se a Páscoa, e oferecendo-se os holocaustos sôbre o altar do Senhor, segundo o mandado do rei Josias."},{text:"17 E os filhos de Israel, que ali se acharam, naquele tempo celebraram a Páscoa, e a solenidade dos asmos por sete dias."},{text:"18 Não houve Páscoa semelhante a esta em Israel desde o tempo do profeta Samuel: E dentre todos os reis de Israel não houve nenhum que fizesse Páscoa como a que fêz Josias, com os sacerdotes, e com os levitas, e com todo"},{text:"o povo de Judá, e com tudo o que se achou de Israel, e com os habitantes de Jerusalém."},{text:"19 Foi celebrada esta Páscoa no ano décimo oitavo do reinado de Josias."},{text:"20 Depois que Josias reparou o templo, foi Necau rei do Egito fazer guerra em Carcames junto ao Eufrates: E Josias marchou ao seu encontro."},{text:"21 Mas aquêle príncipe, mandando-lhe mensageiros, lhe disse: Por que te embaraças tu comigo, ó rei de Judá? Não venho contra ti hoje, mas eu vou fazer guerra a outra nação, contra a qual me mandou Deus que marchasse a"},{text:"tôda a diligência: Cessa pois de te opores aos desígnios de Deus, o qual é comigo, não suceda que êle te mate."},{text:"22 Não quis Josias tornar atrás, mas preparou-se para o combater, e não estêve pelo que Necau lhe disse da parte de Deus: Mas marchou por diante para lhe dar batalha no campo de Magedo."},{text:"23 E ali sendo ferido pelos frecheiros, disse para os seus criados: Tirai-me da peleja, porque estou muito ferido."},{text:"24 Êles o passaram dum coche para outro coche, que o seguia de reserva, segundo o costume dos reis, e o trouxeram para Jerusalém, e morreu, e foi sepultado no mausoléu de seus pais, e todo Judá e Jerusalém o prantearam."},{text:"25 E muito particularmente Jeremias, cujas Lamentações sôbre Josias se cantam até êste tempo por todos os músicos e músicas, costume que ficou em Israel como lei: Elas se acham escritas entre as Lamentações."},{text:"26 O resto das ações de Josias, e as suas boas obras, conformes com o que ordena a lei do Senhor,"},{text:"27 E as suas façanhas tanto primeiras como últimas, estão escritas no Livro dos reis de Judá e de Israel."},{text:"2 Crônicas — capítulo 36."},{text:"1 Pegou logo o povo da terra em Joacaz filho de Josias, e o aclamou rei em Jerusalém em lugar de seu pai."},{text:"2 Tinha Joacaz vinte e três anos, quando começou a reinar, e reinou em Jerusalém três meses."},{text:"3 tools — see the cookie policy for details"},{text:"4 E em lugar de Joacaz constituiu a Eliaquim seu irmão, rei sôbre Judá e sôbre Jerusalém: E mudou-lhe o nome em Joaquim: E pegou no mesmo Joacaz, e o levou consigo para o Egito."},{text:"5 Joaquim tinha vinte e cinco anos quando começou a reinar, e reinou onze anos em Jerusalém: Mas êle fêz o mal diante do Senhor seu Deus."},{text:"6 Contra êste marchou Nabucodonosor, rei dos caldeus, e carregado de cadeias o levou para Babilônia."},{text:"7 Transportou também para esta cidade os vasos do Senhor, e os pôs no seu Templo."},{text:"8 E o resto das ações de Joaquim, e das suas abominações, que êle cometeu, e o que se achou nêle, se contém no Livro dos reis de Judá e de Israel. Em seu lugar porém reinou seu filho Joaquim."},{text:"9 Joaquim tinha oito anos, quando começou a reinar, e reinou três meses e dez dias em Jerusalém, e êle fêz o mal na presença do Senhor."},{text:"10 E tendo decorrido o espaço de um ano, mandou o rei Nabucodonosor tropas, que o conduziram a Babilônia, levando juntamente os mais preciosos vasos da casa do Senhor. E êle em lugar de Joaquim constituiu rei sôbre Judá"},{text:"e sôbre Jerusalém a Sedecias seu tio paterno."},{text:"11 Sedecias tinha vinte e um anos quando começou a reinar, e reinou onze anos em Jerusalém."},{text:"12 E êle fêz o mal diante dos olhos do Senhor seu Deus, e não teve respeito à pessoa do profeta Jeremias, que lhe falava da parte do Senhor."},{text:"13 Sublevou-se também contra o rei Nabucodonosor, a quem tinha dado juramento de fidelidade em nome de Deus: Êle pois endureceu a sua cerviz e o seu coração, para não voltar para o Senhor Deus de Israel."},{text:"14 E até também todos os príncipes dos sacerdotes, e o povo se entregaram a tôdas as abominações gentílicas, e profanaram a casa do Senhor, que a tinha santificado para si em Jerusalém."},{text:"15 Mas o Senhor Deus de seus pais lhes dirigia freqüentemente a sua palavra por meio dos seus mensageiros, levantando-se de noite, e admoestando-os todos os dias: Porque queria perdoar ao seu povo, e à sua casa."},{text:"16 Mas êles zombavam dos mensageiros de Deus, e desprezavam as suas palavras, e mofavam dos seus profetas, até que o furor do Senhor se levantou contra o seu povo, e não houve remédio algum."},{text:"17 Porque fêz vir contra êles o rei dos caldeus, e degolou seus filhos na casa do seu santuário, não tendo piedade nem do moço, nem da donzela, nem do velho, nem do decrépito, mas Deus lhos entregou todos nas suas mãos."},{text:"18 Trasladou também para Babilônia todos os vasos da casa do Senhor, assim grandes, como pequenos, e os tesouros do templo, e os do rei, e dos príncipes."},{text:"19 Os inimigos queimaram a casa de Deus e arruinaram os muros de Jerusalém, e puseram fogo a tôdas as tôrres, e destruíram tudo o que havia de precioso."},{text:"20 Se algum tinha escapado da espada, êsse levado a Babilônia, foi ser escravo do rei, e de seus filhos, até que teve o império o rei dos persas,"},{text:"21 e se cumpriu a palavra do Senhor pronunciada por bôca de Jeremias, e a terra celebrou os seus sábados: Porque durante todo o tempo da sua desolação ela estêve num sábado continuado até que se completaram setenta anos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"2 Crônicas Vol. 26",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 Mas no primeiro ano de Ciro rei dos persas, para se cumprirem as palavras, que o Senhor tinha dito por bôca de Jeremias, tocou o Senhor o coração de Ciro rei dos persas: O qual mandou publicar por todo o reino, e"},{text:"ainda expedir Patentes, dizendo:"},{text:"23 Eis-aqui o que diz Ciro rei dos persas: O Senhor Deus do céu pôs nas minhas mãos todos os reinos da terra, e êle me mandou também que lhe fizesse uma casa em Jerusalém, que é na Judéia: Qual dentre vós se acha ser de"},{text:"todo o seu povo? O Senhor seu Deus seja com êle e vá-se."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Esdras Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"Esdras — capítulo 1."},{text:"1 No primeiro ano de Ciro rei dos persas para se cumprir a palavra do Senhor pronunciada por bôca de Jeremias, suscitou o Senhor o espírito de Ciro rei dos persas: E êste fêz publicar em todo o seu reino, até por"},{text:"escrito, esta ordem, dizendo:"},{text:"2 Eis-aqui o que diz Ciro rei dos persas: O Senhor Deus do Céu me deu todos os reinos da terra, e êle mesmo me mandou que lhe edificasse um templo em Jerusalém que está na Judéia."},{text:"3 tools — see the cookie policy for details"},{text:"4 E todos os varões que tiverem ficado em todos os lugares onde habitam, os ajudem do lugar onde estão, com prata, e com ouro, e com fazenda, gados, e fora o que êles oferecerem voluntàriamente ao templo de Deus, que é"},{text:"em Jerusalém."},{text:"5 Então os príncipes das famílias paternas de Judá, e de Benjamim, e os sacerdotes, e os levitas, e todos aquêles, cujo coração tinha Deus tocado, se prepararam para ir reedificar o templo do Senhor, que havia em"},{text:"Jerusalém."},{text:"6 E todos os que moravam nos arredores, os ajudaram com as suas baixelas de prata, e de ouro com os seus bens, gados, e com os seus móveis, fora o que êles tinham oferecido voluntàriamente."},{text:"7 O rei Ciro entregou também os vasos do Templo do Senhor, que Nabucodonosor tinha levado de Jerusalém, e que tinha pôsto no templo do seu deus."},{text:"8 Ciro rei dos persas as fêz entregar por Mitridates, filho de Gazabar, e os deu por conta a Sassabasar, príncipe de Judá."},{text:"9 E eis-aqui o número dêles: Trinta copos de ouro, mil copos de prata, vinte e nove facas, trinta taças de ouro,"},{text:"10 quatrocentas e dez taças de prata de segundo tamanho: Outros mil vasos."},{text:"11 Todos os vasos de ouro e de prata eram cinco mil e quatrocentos: Todos levou Sassabasar, com os que tornaram do cativeiro de Babilônia para Jerusalém."},{text:"Esdras — capítulo 2."},{text:"1 Êstes são pois os filhos da província, que tendo sido levados cativos para Babilônia por Nabucodonosor rei de Babilônia, voltaram para Jerusalém e para a Judéia, cada um para a sua cidade."},{text:"2 Os que vieram com Zorobabel, foram Josué, Neemias, Saraias, Raelaias, Mardocai, Belsan, Mesfar, Beguai, Reum, Baana. Eis-aqui o número dos varões do povo de Israel:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Filhos de Sefatia, trezentos e setenta e dois."},{text:"5 Filhos de Aréia, setecentos e setenta e cinco."},{text:"6 Filhos de Faat Moab, dos filhos de Josué: De Joab, dois mil e oitocentos e doze."},{text:"7 Filhos de Elão, mil e duzentos cinqüenta e quatro."},{text:"8 Filhos de Zetua, novecentos e quarenta e cinco."},{text:"9 Filhos de Zacai, setecentos e sessenta."},{text:"10 Filhos de Bani, seiscentos e quarenta e dois."},{text:"11 Filhos de Bebai, seiscentos e vinte e três."},{text:"12 Filhos de Azgad, mil duzentos e vinte e dois."},{text:"13 Filhos de Adonicão, seiscentos e sessenta e seis."},{text:"14 Filhos de Beguai, dois mil e cinqüenta e seis."},{text:"15 Filhos de Adin, quatrocentos e cinqüenta e quatro."},{text:"16 Filhos de Ater, que vinham de Ezequias, noventa e oito."},{text:"17 Filhos de Besai, trezentos e vinte e três."},{text:"18 Filhos de Jora, cento e doze."},{text:"19 Filhos de Hasum, duzentos e vinte e três."},{text:"20 Filhos de Gebar, noventa e cinco."},{text:"21 Filhos de Belém, cento e vinte e três."},{text:"22 Homens de Netufa, cinqüenta e três."},{text:"23 Homens de Anatot, cento e vinte e oito;"},{text:"24 Filhos de Azmavet, quarenta e dois."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Esdras Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 Filhos de Cariatiarim, de Cefira, e de Berot, setecentos e quarenta e três."},{text:"26 Filhos de Rama e de Gabaa, seiscentos e vinte um."},{text:"27 Homens de Macmas, cento e vinte e dois."},{text:"28 Homens de Betel e de Hai, duzentos e vinte e três."},{text:"29 Filhos de Nebo, cinqüenta e dois."},{text:"30 Filhos de Megbis, cento e cinqüenta e seis."},{text:"31 Filhos de outro Elão, mil e duzentos e cinqüenta e quatro."},{text:"32 Filhos de Harim, trezentos e vinte."},{text:"33 Filhos de Lod, de Hadid, de Ono, setecentos e vinte e cinco."},{text:"34 Filhos de Jericó, trezentos e quarenta e cinco."},{text:"35 Filhos de Senaa, três mil e seiscentos e trinta."},{text:"36 Sacerdotes: Os filhos de Jadaia na casa de Josué, novecentos e setenta e três."},{text:"37 Filhos de Emer, mil e cinqüenta e dois."},{text:"38 Filhos de Fesur, mil e duzentos e quarenta e sete."},{text:"39 Filhos de Harim, mil e dezessete."},{text:"40 Levitas: Os filhos de Josué, e de Cedmiel dos filhos de Odovia, setenta e quatro."},{text:"41 Cantores: Os filhos de Asaf, cento e vinte oito."},{text:"42 Filhos dos porteiros: Os filhos de Selum, os filhos de Ater, os filhos de Telmon, os filhos de Acub, os filhos de Hatita, os filhos de Sobai, por todos cento e trinta e nove."},{text:"43 Natineus: Os filhos de Sia, os filhos de Hasufa, os filhos de Tabaot,"},{text:"44 os filhos de Ceros, os filhos de Siaa, os filhos de Fadon,"},{text:"45 os filhos de Lebana, os filhos de Hagaba, os filhos de Acub,"},{text:"46 os filhos de Hagab, os filhos de Semlai, os filhos de Hanan,"},{text:"47 os filhos de Gadel, os filhos de Gaer, os filhos de Raaia,"},{text:"48 os filhos de Rasin, os filhos de Vecoda, os filhos de Gazão,"},{text:"49 os filhos de Asa, os filhos de Facéia, os filhos de Besée,"},{text:"50 os filhos de Asena, os filhos de Munim, os filhos de Nefusim,"},{text:"51 os filhos de Bacbuc, os filhos de Hacufa, os filhos de Hatur,"},{text:"52 os filhos de Beslut, os filhos de Maida, os filhos de Harsa,"},{text:"53 os filhos de Bercos, os filhos de Sisara, os filhos de Tema,"},{text:"54 os filhos de Nasia, os filhos de Hatifa,"},{text:"55 os filhos dos servos de Salomão, os filhos de Sotai, os filhos de Soferet, os filhos de Faruda,"},{text:"56 os filhos de Jala, os filhos de Dercon, os filhos de Gedel,"},{text:"57 os filhos de Safatia, os filhos de Hatil, os filhos de Foqueret, que eram de Asebaim, os filhos de Ami:"},{text:"58 Todos os natineus, e os filhos dos servos de Salomão, eram trezentos e noventa e dois."},{text:"59 E êstes foram os que vieram de Telmala, de Telharsa, de Querub, e de Adon, e de Emer: E que não puderam mostrar qual era a casa de seus pais, e a sua linhagem, se acaso eram de Israel."},{text:"60 Os filhos de Dalaia, os filhos de Tobias, os filhos de Necoda, eram seiscentos e cinqüenta e dois."},{text:"61 E dos filhos dos sacerdotes: Os filhos de Hobia, os filhos de Acos, os filhos de Berzelai, que tomou por mulher uma das filhas de Berzelai de Galaad, e que foi chamado do seu nome."},{text:"62 Êstes buscaram o livro da sua genealogia, e o não acharam, e foram excluídos do sacerdócio."},{text:"63 E Atersata lhes intimou que não comessem do Santo dos Santos, até que se levantasse um pontífice douto e perfeito."},{text:"64 Tôda esta multidão era como um só homem, e compreendia quarenta e duas mil trezentas e sessenta pessoas:"}]}] 1
