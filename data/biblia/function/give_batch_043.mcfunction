give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 44",author:"Pe. A. P. de Figueiredo",pages:[{text:"Salmos — capítulo 98."},{text:"1 Salmo do mesmo Davi. O Senhor reinou, enfureçam-se os povos: Reinou o que está sentado sôbre querubins, mova-se a terra."},{text:"2 O Senhor é grande em Sião: E é exaltado sôbre todos os povos."},{text:"3 tools — see the cookie policy for details"},{text:"4 E a honra do rei está em amar a justiça. Tu preparaste leis retíssimas: Tu fizeste juízo e justiça em Jacó."},{text:"5 Exaltai ao Senhor nosso Deus, e adorai o escabêlo de seus pés: Porque êle é santo."},{text:"6 Moisés e Aarão entre os seus sacerdotes: E Samuel entre aquêles que invocam o seu nome: Invocavam o Senhor, e êle os atendia:"},{text:"7 Em coluna de nuvem lhes falava. Guardavam os seus mandamentos, e o preceito que lhes deu."},{text:"8 Senhor nosso Deus, tu os atendias: Ó Deus, tu lhes fôste favorável e vingador de tôdas as maquinações que lhes faziam."},{text:"9 Exaltai ao Senhor nosso Deus, e adorai-o no seu santo monte: Porque santo é o Senhor nosso Deus."},{text:"Salmos — capítulo 99."},{text:"1 Salmo de louvor."},{text:"2 Celebrai com júbilo ao Senhor povos de tôda a terra: Servi ao Senhor em alegria. Entrai diante dêle com alvorôço."},{text:"3 tools — see the cookie policy for details"},{text:"4 Entrai as suas portas com louvor: Nos átrios dêle com hinos: Glorificai-o. Louvai o seu nome."},{text:"5 Porque suave é o Senhor: É eterna a sua misericórdia: E a sua verdade se dilata de geração em geração."},{text:"Salmos — capítulo 100."},{text:"1 Salmo do mesmo Davi. Eu te cantarei, a ti, Senhor, a tua misericórdia, e a tua justiça. Direi salmos."},{text:"2 E me aplicarei a conhecer o caminho da inocência, quando vieres a mim. Caminhava eu na inocência do meu coração, no meio da minha casa."},{text:"3 tools — see the cookie policy for details"},{text:"4 Coração depravado: Ao malicioso que se afastava de mim não o conhecia."},{text:"5 Ao que secretamente dizia mal do seu próximo a êste perseguia. Com homem de olhos soberbos, e de coração insaciável, com êsse não comia."},{text:"6 Os meus olhos só olhavam para os fiéis do país para que se assentassem comigo: O que andava em caminho de inocência, êsse me servia."},{text:"7 Não habitará no meio da minha casa o que obra com soberba: O que fala coisas iníquas não entrou direito na vista dos meus olhos."},{text:"8 Pela manhã entregava à morte todos os pecadores da terra: A fim de exterminar da cidade do Senhor a todos os que obravam maldade."},{text:"Salmos — capítulo 101."},{text:"1 Oração do pobre, que estiver em tribulação, e derramar as suas preces na presença do Senhor."},{text:"2 Senhor, ouve a minha oração: E chegue a ti o meu clamor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque foram dissipados como fumo os meus dias: E os meus ossos assim como acendalhas se secaram."},{text:"5 Fui ferido como feno, e o meu coração se secou: Porque me esqueci de comer o meu pão."},{text:"6 À voz do meu gemido se pegaram os meus ossos à minha carne."},{text:"7 Tornei-me semelhante ao pelicano do deserto: Cheguei a ser como a coruja em seu albergue."},{text:"8 Vigiei, e estou feito como pássaro solitário no telhado."},{text:"9 Todo o dia me improperavam os meus inimigos: E os que me louvavam se conjuravam contra mim."},{text:"10 Porque comia a cinza como pão, e misturava a minha bebida com pranto."},{text:"11 À vista da tua ira e indignação: Porque levantando-me me arrojaste."},{text:"12 Os meus dias como sombra passaram: E eu como feno me sequei."},{text:"13 Mas tu, Senhor, permaneces para sempre: E a memória do teu Nome vai de geração em geração."},{text:"14 Tu levantando-te terás piedade de Sião: Porque é tempo de teres piedade dela, porque o prazo está já cumprido."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 45",author:"Pe. A. P. de Figueiredo",pages:[{text:"15 Porque as suas ruínas têm sido agradáveis aos teus servos: E êles se compadecerão da sua terra."},{text:"16 E temerão as nações o teu nome, Senhor, e todos os reis da terra respeitarão a tua glória."},{text:"17 Porquanto o Senhor edificou Sião: E será visto na sua glória."},{text:"18 Atendeu à oração dos humildes: E não desprezou o seu rogo."},{text:"19 Sejam escritas estas coisas a outra geração: E o povo, que há de ser criado, louvará o Senhor:"},{text:"20 Porque olhou desde o alto do seu Santuário: O Senhor desde o céu olhou para a terra:"},{text:"21 Para ouvir os gemidos dos encarcerados: Para dar soltura aos filhos dos condenados à morte:"},{text:"22 Para que anunciem em Sião o nome do Senhor: E o seu louvor em Jerusalém."},{text:"23 Quando os povos se juntarem, e os reis para servirem ao Senhor."},{text:"24 Respondeu-lhe no caminho do seu vigor: Dize-me o curto número de meus dias."},{text:"25 Não me chames na metade de meus dias: Os teus anos se estendem de geração em geração."},{text:"26 No princípio tu, Senhor, fundaste a terra: E os céus são obra de tuas mãos."},{text:"27 Êles perecerão, mas tu permaneces: E todos se envelhecerão como um vestido. E como roupa de vestir os mudarás, e serão mudados:"},{text:"28 Mas tu és sempre o mesmo, e os teus anos não se acabarão."},{text:"29 Os filhos de teus servos habitarão: E a sua posteridade será dirigida eternamente."},{text:"Salmos — capítulo 102."},{text:"1 Do mesmo Davi. Bendiz, ó alma minha, ao Senhor: E tôdas as coisas que há dentro de mim bendigam ao seu santo Nome."},{text:"2 Bendiz, ó alma minha, ao Senhor: E não queiras esquecer-te de todos os seus benefícios."},{text:"3 tools — see the cookie policy for details"},{text:"4 O que redime da morte a tua vida: O que te coroa da sua misericórdia, e das suas graças."},{text:"5 O que enche de bens o teu desejo: Renovar-se-á como a da águia a tua mocidade."},{text:"6 O Senhor que faz misericórdias: E justiça a todos os que sofrem agravos."},{text:"7 Fêz conhecer a Moisés os seus caminhos, aos filhos de Israel as suas vontades."},{text:"8 É benigno, e misericordioso o Senhor: Magnânimo e de muita misericórdia."},{text:"9 Não estará irado para sempre: Nem ameaçará eternamente."},{text:"10 Não nos há tratado a nós segundo os nossos pecados: Nem nos tem pago segundo as nossas maldades."},{text:"11 Pois quanto a elevação do céu está remontada sôbre a terra: Tanto êle tem firmado a sua misericórdia sôbre os que o temem."},{text:"12 Quanto dista o Oriente do Ocidente: Tanto êle tem apartado de nós as nossas maldades."},{text:"13 Como o pai se compadece dos filhos, assim se tem compadecido o Senhor dos que o temem:"},{text:"14 Porque êle já tem conhecido a fragilidade da nossa origem. Lembrou-se que somos pó:"},{text:"15 O homem, cujos dias são como feno, assim se murchará como a flor do campo."},{text:"16 Porque o espírito estará nêle de passagem, e êle não subsistirá: E não conhecerá dali em diante o seu lugar."},{text:"17 Mas a misericórdia do Senhor está desde a eternidade e até à eternidade sôbre os que o temem. E a sua justiça sôbre os filhos dos filhos,"},{text:"18 para com aquêles que guardam a sua aliança: E se lembram dos seus mandamentos, para observá-los."},{text:"19 O Senhor tem prevenido no céu o seu trono: E o seu reino dominará sôbre todos."},{text:"20 Bendizei ao Senhor todos os anjos dêle: Poderosos em virtude, que sois executores da sua palavra, para obedecer à voz das suas ordens."},{text:"21 Bendizei ao Senhor tôdas as virtudes dêle: Vós, ministros seus, que fazeis a sua vontade."},{text:"22 Bendizei ao Senhor tôdas as suas obras: Em todo o lugar do seu senhorio, bendiz, ó alma minha, ao Senhor."},{text:"Salmos — capítulo 103."},{text:"1 Do mesmo Davi. Bendiz, ó alma minha, ao Senhor: Senhor Deus meu, tu te tens engrandecido poderosamente. De glória, e de formosura te tens vestido:"}]}] 