give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 39",author:"Pe. A. P. de Figueiredo",pages:[{text:"6 livre entre os mortos. Assim como os feridos que dormem nos sepulcros, de quem jamais te não lembras: E êles são desamparados da tua mão."},{text:"7 Puseram-me em um fôsso profundo, em lugares tenebrosos, e na sombra da morte."},{text:"8 Sôbre mim descarregou o teu furor: E tôdas as tuas ondas fizeste vir sôbre mim."},{text:"9 Alongaste de mim os meus conhecidos: Puseram-me como objeto da sua abominação. Entregue fui, e não tinha saída:"},{text:"10 Os meus olhos desfaleceram de miséria. A ti, Senhor, clamei todo o dia: Para ti estendi as minhas mãos."},{text:"11 Porventura farás maravilhas com os mortos: Ou os médicos os ressuscitarão, e te darão a ti louvor?"},{text:"12 Acaso narrará algum na sepultura a tua misericórdia, e a tua verdade na perdição?"},{text:"13 Porventura serão conhecidas nas trevas as tuas maravilhas: E a tua justiça na terra do esquecimento?"},{text:"14 E eu a ti, Senhor, clamei: E pela manhã se antecipará diante de ti a minha oração."},{text:"15 Por que rejeitas, Senhor, a minha oração, e apartas de mim a tua face?"},{text:"16 Eu sou pobre, e vivo em trabalhos desde a minha mocidade: E depois de exaltado fui humilhado, e conturbado."},{text:"17 Por cima de mim passaram as tuas iras: E os teus terrores me conturbaram."},{text:"18 Cercaram-me assim como água todo o dia: Cercaram-me juntos."},{text:"19 Alongaste de mim ao amigo, e ao parente: E aos meus conhecidos por causa da minha miséria."},{text:"Salmos — capítulo 88."},{text:"1 Inteligência de Etan ezraíta."},{text:"2 Eu cantarei eternamente as misericórdias do Senhor. Anunciarei a tua verdade pela minha bôca de geração em geração."},{text:"3 tools — see the cookie policy for details"},{text:"4 Tenho feito aliança com os meus escolhidos, jurei a Davi meu servo:"},{text:"5 Para sempre estabelecerei a tua descendência. E farei firme o teu trono de geração em geração."},{text:"6 Os céus celebrarão, Senhor, as tuas maravilhas: E a tua verdade se louvará na Igreja dos Santos."},{text:"7 Porque nas nuvens quem se igualará com o Senhor: Quem entre os filhos de Deus será semelhante a Deus?"},{text:"8 Deus que é glorificado na congregação dos santos: Grande e terrível sôbre todos os que estão em roda dêle."},{text:"9 Senhor Deus das virtudes, quem é semelhante a ti? poderoso és Senhor e a tua verdade está sempre em roda de ti."},{text:"10 Tu dominas sôbre o poder do mar: E tu amansas o movimento das suas ondas."},{text:"11 Tu humilhaste ao soberbo assim como um ferido: Com o braço do teu poder puseste em dispersão a teus inimigos."},{text:"12 Teus são os céus, e tua é a terra: A redondeza da terra e a sua plenitude a fundaste:"},{text:"13 O Aquilão, e o Mar tu o criaste. O Tabor e o Hermon em teu Nome saltarão de contentamento."},{text:"14 O teu braço está cheio de poder. Firmada seja a tua mão, e exaltada a tua destra:"},{text:"15 Justiça e eqüidade são a base do teu trono. Misericórdia e verdade irão diante da tua face:"},{text:"16 Bem-aventurado o povo que sabe louvar-te com júbilo. Senhor, no lume do teu rosto andarão."},{text:"17 E em teu Nome se regozijarão todo o dia: E na tua justiça serão exaltados."},{text:"18 Porque tu és a glória da sua virtude: E por tua boa vontade será exaltado o nosso poder."},{text:"19 Porque o Senhor nos tem tomado sob sua proteção: E o Santo de Israel é nosso Rei."},{text:"20 Então falaste em visão aos teus Santos, e lhes disseste: Eu tenho pôsto o socorro em um poderoso: E tenho exaltado a um escolhido do meu povo."},{text:"21 Achei a Davi meu servo: Com o meu santo óleo o ungi."},{text:"22 Porque a minha mão lhe assistirá a êle: E o meu braço o confortará."},{text:"23 Nada adiantará o inimigo nêle, e o filho da iniqüidade não poderá ofendê-lo."},{text:"24 E quebrantarei diante dêle a seus inimigos: E aos que o aborrecem porei em fuga."},{text:"25 E a minha verdade, e a minha clemência serão com êle: E no meu Nome será exaltado o seu poder."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 40",author:"Pe. A. P. de Figueiredo",pages:[{text:"26 E estenderei a sua mão sôbre o mar: E a sua destra sôbre os rios."},{text:"27 Êle me invocará, dizendo: Tu és meu Pai: Deus meu, e amparador da minha salvação."},{text:"28 E eu o estabelecerei por primogênito excelso sôbre os reis da terra."},{text:"29 Eternamente o guardará a minha misericórdia: E a minha aliança será estável com êle."},{text:"30 E farei que a sua descendência subsista por todos os séculos: E o seu trono como os dias do Céu."},{text:"31 Mas se seus filhos abandonarem a minha lei: E não andarem nos meus preceitos:"},{text:"32 Se violarem as minhas justiças, e não guardarem os meus mandamentos."},{text:"33 Visitarei com vara as suas maldades: E com açoites os seus pecados."},{text:"34 Mas não apartarei dêle a minha misericórdia: Nem lhe faltarei em minha verdade:"},{text:"35 Nem violarei a minha aliança: Nem farei vãs as promessas que saem dos meus lábios."},{text:"36 Uma vez jurei pela minha santidade, não faltarei a Davi:"},{text:"37 A sua descendência permanecerá eternamente."},{text:"38 E o seu trono será para sempre como o sol diante de mim, e como a lua cheia: E como o testemunho fiel no céu."},{text:"39 Mas tu repeliste, e desprezaste: Afastaste o teu Cristo."},{text:"40 Transtornaste a aliança do teu servo: Tens pôsto por terra o seu santuário."},{text:"41 Destruíste todos os seus valados: Puseste mêdo na sua fortaleza."},{text:"42 Despojaram-no todos os que passavam pelo caminho: Chegou a ser o opróbrio dos seus vizinhos."},{text:"43 Exaltaste a destra dos que o humilhavam: Alegraste a todos os seus inimigos."},{text:"44 Apartaste a defensa da sua espada: E não o auxiliaste na batalha."},{text:"45 Fizeste cessar o seu esplendor: E derribaste por terra o seu trono."},{text:"46 Abreviaste os dias do seu tempo: Cobriste-o de confusão."},{text:"47 Que acaso estarás apartado, Senhor, até ao fim: Escandecer-se-á como fogo a tua ira?"},{text:"48 Lembra-te de qual é a minha subsistência: Pois que, acaso criaste em vão todos os filhos dos homens?"},{text:"49 Que homem há, que viva, e não veja a morte: Que haja de livrar a sua alma do poder do inferno?"},{text:"50 Onde estão as tuas antigas misericórdias, Senhor, as que juraste a Davi na tua verdade?"},{text:"51 Lembra-te, Senhor, do opróbrio que os teus servos têm sofrido de muitas nações, o qual eu tenho depositado no meu seio."},{text:"52 Com que nos têm insultado, Senhor, os teus inimigos, com que nos têm insultado em recompensa do teu Cristo."},{text:"53 Bendito seja o Senhor para sempre: Assim seja, assim seja."},{text:"Salmos — capítulo 89."},{text:"1 Oração de Moisés homem de Deus. Senhor, tu tens sido o nosso refúgio: De geração em geração."},{text:"2 Antes que os montes fôssem feitos, ou formada a terra, e a sua redondeza: Desde a eternidade tu és Deus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque mil anos aos teus olhos, são como o dia de ontem, que passou. E como vigia na noite,"},{text:"5 coisas que em nada se estimam, assim serão os anos dêles."},{text:"6 De manhã passa como a erva, pela manhã floresce, e passa; à tarde cai, endurece, e se seca."},{text:"7 Porque desfalecemos com a tua ira, e com o teu furor somos turbados."},{text:"8 Puseste as nossas maldades à tua vista: O nosso século ao resplendor do teu rosto."},{text:"9 Porque todos os nossos dias faltaram: E temos sido consumidos pela tua ira: Os nossos anos como aranha serão considerados:"},{text:"10 Os dias da nossa vida são em si setenta anos. E nos mais robustos oitenta anos: E o que passa dêstes não é mais que trabalho e dor. Porque sobreveio mansidão: E seremos arrebatados."},{text:"11 Quem conheceu o poder da tua ira: E soube contar quão terrível é a tua sanha?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 41",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 Faze que seja assim conhecida a tua destra: E que o nosso coração seja instruído em sabedoria."},{text:"13 Volta-te para nós, Senhor, até quando? e sê exorável aos teus servos."},{text:"14 Temos sido cheios da tua misericórdia desde a manhã: E nos temos regozijado, e deleitado em todos os nossos dias."},{text:"15 Alegramo-nos pelos dias que nos humilhaste: Pelos anos em que vimos males."},{text:"16 Põe os olhos nos teus servos, e nas tuas obras: E encaminha os filhos dêles."},{text:"17 E seja o esplendor do Senhor nosso Deus sôbre nós, e encaminha as obras de nossas mãos sôbre nós: E encaminha a obra de nossas mãos."},{text:"Salmos — capítulo 90."},{text:"1 Louvor de cântico de Davi. O que habita à sombra do Altíssimo, na proteção do Deus do céu descansará."},{text:"2 Dirá ao Senhor: Tu és o meu amparador, e o meu refúgio: É o meu Deus, nêle esperarei."},{text:"3 tools — see the cookie policy for details"},{text:"4 Com as suas espáduas te fará sombra: E debaixo das suas asas esperarás."},{text:"5 Com escudo te cercará a sua verdade: Não terás temor de espanto noturno."},{text:"6 De seta que voa de dia, de nenhuma coisa que ande em trevas: De assalto, nem de demônio do meio-dia."},{text:"7 Cairão mil ao teu lado, e dez mil à tua destra: Mas a ti não se chegará."},{text:"8 Certamente com os teus olhos contemplarás: Verás a paga dos pecadores."},{text:"9 Porque tu és, Senhor, a minha esperança: Puseste por teu refúgio ao Altíssimo:"},{text:"10 Não se chegará a ti mal: E o flagelo não se aproximará à tua tenda."},{text:"11 Porquanto mandou aos seus Anjos acêrca de ti: Que te guardem em todos os teus caminhos."},{text:"12 Êles te levarão nas suas mãos: Para que não suceda que o teu pé tropece em pedra."},{text:"13 Sôbre o áspide, e basilisco andarás: E pisarás ao leão e ao dragão."},{text:"14 Porquanto em mim esperou, livrá-lo-ei: Protegê-lo-ei, porquanto conheceu o meu Nome."},{text:"15 Clamará a mim, e eu o ouvirei, com êle estou na tribulação: Livrá-lo-ei, e glorificá-lo-ei."},{text:"16 Saciá-lo-ei com diuturnidade de dias: E mostrar-lhe-ei o meu Salvador."},{text:"Salmos — capítulo 91."},{text:"1 Salmo de Cântico. Para o dia do Sábado."},{text:"2 Bom é louvar ao Senhor: E cantar salmos ao teu nome, ó Altíssimo."},{text:"3 tools — see the cookie policy for details"},{text:"4 Com o saltério de dez cordas: Com cântico, ao som da cítara."},{text:"5 Porquanto me deste prazer, Senhor, na tua feitura: E nas obras das tuas mãos me regozijarei."},{text:"6 Quão magníficas são, Senhor, as tuas obras! Estremadamente profundos são os teus conselhos."},{text:"7 O varão insensato não conhecerá: E o néscio não compreenderá estas coisas."},{text:"8 Apenas se deixarão ver os pecadores como a erva: E aparecerão todos os que obram iniqüidade: Quando perecerão pelo século do século:"},{text:"9 Mas tu, Senhor, és eternamente o Altíssimo."},{text:"10 Pois eis-aqui os teus inimigos, Senhor, eis-aqui os teus inimigos perecerão: E serão dissipados todos os que obram iniqüidade."},{text:"11 E será exaltada a minha fôrça como a do unicórnio: E a minha velhice com abundância de misericórdia:"},{text:"12 E os meus olhos olharam com desprêzo para os meus inimigos: E os meus ouvidos ouvirão o castigo dos malignos que se levantam contra mim."},{text:"13 O justo como palma florescerá: Como cedro do Líbano se multiplicará."},{text:"14 Plantados na casa do Senhor, florescerão nos átrios da casa do nosso Deus."},{text:"15 Ainda se multiplicarão em velhice abundante: E estarão cheios de vigor,"},{text:"16 para anunciar: Que é reto o Senhor nosso Deus: E que não há injustiça nêle."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 42",author:"Pe. A. P. de Figueiredo",pages:[{text:"Salmos — capítulo 92."},{text:"1 Louvor de cântico do mesmo Davi para o dia que precede ao sábado quando a terra foi fundada. O Senhor reinou, vestiu-se de magnificência: Vestiu-se o Senhor de fortaleza, e cingiu-se. Porque firmou a redondeza da"},{text:"terra, que não será comovida."},{text:"2 Desde então se estabeleceu o teu trono: tu és desde a eternidade."},{text:"3 tools — see the cookie policy for details"},{text:"4 Pelas vozes das suas muitas águas. Maravilhosas as inchações do mar, maravilhoso nas alturas o Senhor."},{text:"5 Os teus testemunhos se têm feito críveis em grande maneira: À tua casa convém santidade, Senhor, por diuturnidade de dias."},{text:"Salmos — capítulo 93."},{text:"1 Salmo do mesmo Davi, para o dia quarto da semana. O Deus das vinganças é o Senhor: O Deus das vinganças sempre obrou livremente."},{text:"2 Exalta-te tu que julgas a terra: Dá a retribuição aos soberbos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Pronunciarão, e falarão iniqüidade: E falarão todos os que obram injustiça?"},{text:"5 Ao teu povo, Senhor, humilharam: E à tua herança maltrataram."},{text:"6 À viúva, e ao estrangeiro mataram: E aos órfãos tiraram a vida."},{text:"7 E disseram: Não o verá o Senhor, nem o saberá o Deus de Jacó."},{text:"8 Entendei, insensatos do povo: E vós, néscios, entrai uma vez em prudência."},{text:"9 O que plantou o ouvido, não ouvirá? Ou o que formou o ôlho, não verá?"},{text:"10 O que castiga as gentes, não repreenderá: Êle que ensina ao homem ciência?"},{text:"11 O Senhor conhece os pensamentos dos homens, que são vãos."},{text:"12 Bem-aventurado o homem, a quem tu instruíres, Senhor: E na tua lei amestrares."},{text:"13 A fim de o pôr em descanso nos dias maus: Entretanto que se abre a cova para o pecador."},{text:"14 Porque o Senhor não repelirá o seu povo: Nem abandonará a sua herança."},{text:"15 Até que a justiça venha a fazer juízo: E que estejam perto dela todos os que são retos de coração."},{text:"16 Quem se levantará a meu favor contra os malignos? Ou quem estará comigo contra os que obram iniqüidade?"},{text:"17 Se não fôsse porque o Senhor me valeu: Quase que a minha alma houvera caído no inferno."},{text:"18 Se dizia: Está vacilante o meu pé: A tua misericórdia, Senhor, me sustentava."},{text:"19 Segundo as muitas dores que provou o meu coração, as tuas consolações alegraram a minha alma."},{text:"20 Acaso tem união contigo a cadeira da iniqüidade: Quando tu nos impões mandamentos penosos?"},{text:"21 Êles irão à caça da alma do justo: E condenarão o sangue inocente."},{text:"22 Mas o Senhor me serviu de refúgio: E o meu Deus de socorro da minha esperança."},{text:"23 E fará cair sôbre êles a sua iniqüidade: E na sua malícia os destruirá: Destrui-los-á a êles o Senhor nosso Deus."},{text:"Salmos — capítulo 94."},{text:"1 Louvor de cântico do mesmo Davi. Vinde, regozijemo-nos no Senhor: Celebremos as glórias de Deus nosso Salvador."},{text:"2 Apresentemo-nos ante a sua face para o louvar e celebremo-lo com salmos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque na sua mão estão todos os limites da terra: E as alturas dos montes são suas."},{text:"5 Porquanto seu é o mar, e êle o fêz: E as suas mãos formaram a terra árida."},{text:"6 Vinde, adoremos, e prostremo-nos: E choremos diante do Senhor, que nos criou."},{text:"7 Porque êle é o Senhor nosso Deus: E nós povo do seu pasto, e ovelhas da sua manada."},{text:"8 Se hoje ouvirdes a sua voz, não queirais endurecer os vossos corações:"}]}] 1
