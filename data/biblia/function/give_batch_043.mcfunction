give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 46",author:"Pe. A. P. de Figueiredo",pages:[{text:"2 Coberto de lume como de vestidura: Que estendes o céu como um pavilhão:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Que fazes aos teus anjos espíritos e aos teus ministros fogo queimador."},{text:"5 Que fundaste a terra sôbre a sua própria estabilidade: Não se inclinará pelos séculos dos séculos."},{text:"6 O abismo a cinge a ela, como um vestido: Sôbre os montes estarão as águas."},{text:"7 À tua ameaça fugirão: À voz do teu trovão temerão."},{text:"8 Sobem os montes, e descem as campinas ao lugar que lhes estabeleceste."},{text:"9 Têrmo lhes puseste, que não traspassarão e não voltarão a cobrir a terra."},{text:"10 Que fazes sair fontes nos vales: Por meio dos montes passarão as águas."},{text:"11 Beberão todos os animais do campo: Suspirarão por elas os onagros na sua sêde."},{text:"12 Sôbre elas morarão as aves do Céu: As quais do meio dos rochedos darão vozes."},{text:"13 Que regas os montes das águas mais altas: Do fruto de tuas obras se saciará a terra:"},{text:"14 Que produzes feno para as alimárias, e erva para o serviço dos homens. Para fazeres sair o pão do seio da terra:"},{text:"15 E o vinho que alegra o coração do homem. O azeite para que o homem faça brilhar o seu rosto: E com o pão corrobore o seu coração."},{text:"16 Saciar-se-ão as árvores do campo, e os cedros do Líbano que plantou:"},{text:"17 Ali farão ninho as aves. A casa da cegonha lhes serve de guia a elas:"},{text:"18 Os montes altos são refúgio aos cervos: Os penhascos para os ouriços cacheiros."},{text:"19 Fêz a lua para designar os tempos: O sol conheceu o seu ocaso."},{text:"20 Puseste trevas, e foi feita a noite: Nela transitarão tôdas as alimárias da selva."},{text:"21 Os cachorros dos leões rugem em busca da prêsa, e para pedirem a Deus o seu sustento."},{text:"22 Saiu o sol, e recolheram-se: E meter-se-ão nos seus covis."},{text:"23 Sairá o homem à sua obra: aos seus trabalhos até à noite."},{text:"24 Quão magníficas são as tuas obras, Senhor! tôdas as coisas fizeste com sabedoria! cheia está a terra da tua possessão."},{text:"25 Êste mar grande, e largo de braços: Ali existem peixes que não têm número. Animais pequenos e grandes:"},{text:"26 Ali transitarão as naus. Êste dragão, que formaste para zombar no mar:"},{text:"27 Todos esperam de ti que lhes dês de comer a seu tempo."},{text:"28 Dando-lho tu, êles recolherão: Abrindo tu a tua mão, todos se encherão de bens."},{text:"29 Mas se tu apartares o teu rosto, turbar-se-ão: Tirar-lhes-ás o espírito, e deixarão de ser, e tornar-se-ão no seu pó."},{text:"30 Enviarás o teu espírito, e serão criados: E renovarás a face da terra."},{text:"31 Seja a glória do Senhor para sempre: Alegrar-se-á o Senhor nas suas obras:"},{text:"32 O que olha para a terra, e a faz estremecer: O que toca os montes, e fumegam."},{text:"33 Cantarei ao Senhor em todo o espaço da minha vida: Cantarei salmos ao meu Deus enquanto eu subsistir."},{text:"34 Sejam-lhe aceitas as minhas palavras: Eu certamente me deleitarei no Senhor."},{text:"35 Feneçam da terra os pecadores, e os iníquos, de modo que não subsistam: Bendiz, ó alma minha, ao Senhor."},{text:"Salmos — capítulo 104."},{text:"1 Aleluia. Louvai ao Senhor, e invocai o seu nome: Anunciai entre as gentes as suas obras."},{text:"2 Cantai-lhe, e dizei-lhe salmos: Narrai tôdas as suas maravilhas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Buscai ao Senhor, e fortificai-vos: Buscai sempre a sua face."},{text:"5 Lembrai-vos das suas maravilhas, que fêz: De seus prodígios, e dos juízos que pronunciou com a sua bôca."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 47",author:"Pe. A. P. de Figueiredo",pages:[{text:"6 Vós, ó descendentes de Abraão, que sois seus servos: Vós, ó filhos de Jacó, seus escolhidos."},{text:"7 Êle é o Senhor nosso Deus: Os seus juízos se executarão em tôda a terra."},{text:"8 Êle se lembrou para sempre da sua aliança: E da palavra, que enviou para mil gerações:"},{text:"9 Daquela que deu a Abraão: E do juramento que fêz a Isaac:"},{text:"10 E o confirmou a Jacó por estatuto: E a Israel para que fôsse uma aliança eterna:"},{text:"11 Dizendo: A ti te darei a terra de Canaã, repartimento da vossa herança."},{text:"12 Quando eram em curto número, mui poucos e estrangeiros nesta terra:"},{text:"13 E passaram de gente em gente, e de um reino a outro povo."},{text:"14 Não permitiu que alguém os ofendesse: E castigou por causa dêles aos reis."},{text:"15 Não toqueis os meus ungidos: E não maltrateis aos meus profetas."},{text:"16 E chamou a fome sôbre a terra: E quebrantou tôda a fôrça do pão."},{text:"17 Enviou diante dêles um varão: A José que foi vendido por escravo."},{text:"18 Apertaram com grilhões seus pés, o ferro traspassou a sua alma"},{text:"19 até que foi cumprida a profecia dêle. A palavra do Senhor o havia inflamado:"},{text:"20 Enviou o rei, e o soltou; o príncipe dos povos, e lhe deu a liberdade."},{text:"21 Constituiu-o senhor da sua casa: E por príncipe de tudo o que possuía."},{text:"22 Para que desse luz aos seus grandes como a si mesmo: E ensinasse a prudência aos seus Anciãos."},{text:"23 E entrou Israel no Egito: E foi Israel estrangeiro em a terra de Cam."},{text:"24 E aumentou o seu povo em grande maneira: E o fêz forte sôbre os seus inimigos."},{text:"25 Transtornou o coração dos egípcios para que aborrecessem o seu povo: E usassem de enganos com os seus servos."},{text:"26 Enviou a Moisés seu servo: A Aarão, o mesmo que êle escolheu."},{text:"27 Pôs nêles as palavras de seus sinais, e prodígios na terra de Cam."},{text:"28 Enviou trevas, e difundiu escuridade: E não tornou vãs as suas palavras."},{text:"29 Converteu-lhes as águas em sangue: E matou os seus peixes."},{text:"30 A sua terra produziu rãs até nas câmaras dos mesmos reis."},{text:"31 Disse, e vieram moscas de tôdas as castas: E mosquitos em todos os seus limites."},{text:"32 Mudou as suas chuvas em granizo: Lançou um fogo abrasador na terra dêles."},{text:"33 E feriu as suas vinhas, e os seus figueirais: E quebrou as árvores que havia nos seus limites."},{text:"34 Disse, e vieram gafanhotos, e alforra, em tanta cópia que não tinha número:"},{text:"35 E comeu tôda a erva na terra dêles. E comeu todo o fruto na terra dêles."},{text:"36 E feriu a todos os primogênitos na terra dêles: As primícias de todo o seu trabalho."},{text:"37 E conduziu-os com prata e com ouro: E não havia enfêrmo nas tribos dêles."},{text:"38 Alegrou-se o Egito na partida dêles: Porque estava preocupado do temor que lhes tinha."},{text:"39 Estendeu uma nuvem que os cobrisse, e fogo que os alumiasse de noite."},{text:"40 Pediram, e vieram codornizes: E do pão do Céu os saciou."},{text:"41 Fendeu a pedra, e manaram águas: Correram rios em lugar sêco:"},{text:"42 Porque teve em memória a sua santa palavra, a qual êle havia dado a Abraão seu servo."},{text:"43 E tirou o seu povo com regozijo, e aos seus escolhidos com alegria."},{text:"44 E deu-lhes as terras das nações: E desfrutaram o trabalho de outros povos:"},{text:"45 Para que guardassem os seus mandamentos, e buscassem a sua lei."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 48",author:"Pe. A. P. de Figueiredo",pages:[{text:"Salmos — capítulo 105."},{text:"1 Aleluia. Louvai ao Senhor porque êle é bom: Porque a sua misericórdia é por todos os séculos."},{text:"2 Quem referirá as obras do poder do Senhor, quem fará que sejam ouvidos todos os seus louvores?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Lembra-te de nós, Senhor, segundo a bondade que te apraz mostrar ao teu povo: Visita-nos com a tua salvação:"},{text:"5 Para que vejamos os bens de teus escolhidos, e gozemos a alegria que destinas ao teu povo: Para que sejas glorificado na tua herança."},{text:"6 Temos pecado com os nossos pais: Temos obrado injustamente, cometemos iniqüidade."},{text:"7 Nossos pais no Egito não consideraram as tuas maravilhas: Não se lembraram da multidão da tua misericórdia. E te irritaram estando para entrar no mar, no mar Vermelho."},{text:"8 E êle os salvou por amor do seu nome: Para fazer patente o seu poder."},{text:"9 E ameaçou ao mar Vermelho, e secou-se: E levou-os pelos abismos, como por um deserto."},{text:"10 E salvou-os da mão dos que os aborreciam: E resgatou-os da mão do inimigo."},{text:"11 E cobriu de água aos que os perseguiam: Não ficou dêles nem um só."},{text:"12 E deram crédito às suas palavras: E cantaram o seu louvor."},{text:"13 Porém logo instantâneamente se deram pressa em esquecer as suas obras: E não esperaram o seu conselho."},{text:"14 E cobiçaram delícias no deserto: E tentaram a Deus no lugar sem água."},{text:"15 E lhes concedeu o que pediam: E enviou fartura às suas almas."},{text:"16 E irritaram a Moisés no acampamento: A Aarão o santo do Senhor."},{text:"17 Abriu-se a terra e tragou a Datan: E sorveu a Abiron com seus sequazes."},{text:"18 E ateou-se fogo no meio do seu congresso: A chama abrasou aos pecadores."},{text:"19 E fizeram um bezerro em Horeb: E adoraram a obra que fabricaram."},{text:"20 E trocaram a sua glória pelo simulacro de um bezerro que come feno."},{text:"21 Esqueceram-se de Deus que os salvou, o qual havia feito grandes prodígios no Egito,"},{text:"22 maravilhas na terra de Cam: Portentos no mar Vermelho."},{text:"23 E disse que os destruiria: Se Moisés seu escolhido se não houvesse pôsto em meio ante êle quebrando o ídolo: Para apartar a sua ira, que não os destruísse:"},{text:"24 E por nada reputaram a terra desejada: Não creram na sua palavra,"},{text:"25 e murmuraram nas suas tendas: Não atenderam à voz do Senhor."},{text:"26 E levantou a sua mão sôbre êles: Para os exterminar no deserto:"},{text:"27 E para envilecer a sua estirpe entre as nações: E espalhá-los pelas regiões."},{text:"28 E consagraram-se a Beelfegor: E comeram os sacrifícios dos mortos."},{text:"29 E o irritaram com as suas invenções: E se multiplicou nêles a mortandade."},{text:"30 E apresentou-se Finéias, e o aplacou: E cessou o flagelo."},{text:"31 E isto foi-lhe imputado por justiça por geração e geração para sempre."},{text:"32 E irritaram-no nas águas da contradição: E foi castigado Moisés por causa dêles:"},{text:"33 Porque amarguraram o seu espírito. E foi duvidoso nas suas palavras:"},{text:"34 Não exterminaram as gentes que o Senhor lhes disse."},{text:"35 E se mesclaram com as gentes, e tomaram os seus costumes:"},{text:"36 E serviram aos seus ídolos: E lhes foi causa de tropêço."},{text:"37 E imolaram aos demônios os seus filhos, e as suas filhas."},{text:"38 E derramaram o sangue inocente: O sangue de seus filhos e de suas filhas, que haviam sacrificado aos ídolos de Canaã. E se inficionou a terra com sangues,"},{text:"39 e se contaminou com as suas obras: E se prostituíram nas suas invenções."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 49",author:"Pe. A. P. de Figueiredo",pages:[{text:"40 E se incendeu de furor o Senhor contra o seu povo: E abominou a sua herança."},{text:"41 E os entregou em poder das gentes: E os dominaram aquêles que os aborreciam."},{text:"42 E angustiaram-nos os seus inimigos, e foram humilhados debaixo do seu poder:"},{text:"43 Muitas vêzes o livrou. Mas êles o irritaram com o seu intento: E foram humilhados pelas suas maldades."},{text:"44 E olhou-os quando estavam em angústia: E ouviu a sua oração."},{text:"45 E lembrou-se do seu pacto: E se enterneceu segundo a multidão da sua misericórdia."},{text:"46 E empregou nêles as suas misericórdias à vista de todos aquêles que os haviam cativado."},{text:"47 Salva-nos, Senhor nosso Deus: E congrega-nos de entre as nações: Para que confessemos o teu santo nome: E nos gloriemos no teu louvor."},{text:"48 Bendito o Senhor Deus de Israel pelos séculos dos séculos: E dirá todo o povo: Assim seja, assim seja."},{text:"Salmos — capítulo 106."},{text:"1 Aleluia. Louvai ao Senhor porque é bom: Porque a sua misericórdia é eterna."},{text:"2 Digam-no os que o Senhor tem redimido, os que tem redimido da mão do inimigo: E os que congregou dentre as nações."},{text:"3 tools — see the cookie policy for details"},{text:"4 Foram errando pelo deserto sem água: Não acharam caminho de cidade onde alojar-se."},{text:"5 Padecendo fome, e sêde: A sua alma nêles desfaleceu."},{text:"6 E clamaram ao Senhor quando se viam em angústia: E êle os livrou das suas necessidades."},{text:"7 E os conduziu por caminho direito: Para que fôssem à cidade de povoação."},{text:"8 Glorifiquem ao Senhor as suas misericórdias: E as maravilhas que obrou a favor dos filhos dos homens."},{text:"9 Porque fartou a alma que estava vazia: E saciou de bens a alma faminta."},{text:"10 Os que moravam em trevas, e na sombra da morte: Aprisionados em mendiguez, e em ferro."},{text:"11 Porque foram rebeldes às palavras de Deus: E desprezaram o conselho do Altíssimo."},{text:"12 E foi humilhado o seu coração nos trabalhos: Ficaram sem fôrças, e não houve quem os socorresse."},{text:"13 E clamaram ao Senhor quando se viram em angústia: E livrou-os de suas necessidades."},{text:"14 E tirou-os das trevas, e da sombra da morte: Rompeu as suas cadeias."},{text:"15 Glorifiquem ao Senhor as suas misericórdias: E as maravilhas que obrou a favor dos filhos dos homens."},{text:"16 Porque arrombou as portas de bronze: E quebrou os ferrolhos de ferro."},{text:"17 Êle os recebeu do caminho da sua maldade: Porque pelas suas injustiças foram humilhados."},{text:"18 A alma dêles aborreceu tôda a comida: E chegaram até as portas da morte."},{text:"19 E clamaram ao Senhor quando se viram em angústia: E livrou-os de suas necessidades."},{text:"20 Enviou a sua palavra, e sarou-os: E livrou-os do que lhes era mortal."},{text:"21 Glorifiquem ao Senhor as suas misericórdias: E as maravilhas que obrou a favor dos filhos dos homens:"},{text:"22 E lhe ofereçam sacrifício de louvor: E anunciem as suas obras com regozijo."},{text:"23 Os que descem ao mar em naus para fazerem as suas manobras nas muitas águas."},{text:"24 Êles mesmos viram as obras do Senhor, e as suas maravilhas no profundo."},{text:"25 Disse, e levantou-se um vento de tempestade: E empolaram-se as suas ondas."},{text:"26 Sobem até aos céus, e descem até aos abismos: A sua alma com os males se consumia."},{text:"27 Foram turbados, e titubearam como um temulento: E todo o seu saber foi apurado."},{text:"28 E clamaram ao Senhor quando se viram em angústia, e livrou-os das suas necessidades."},{text:"29 E trocou a sua tempestade em vento suave e acalmaram as ondas do mar."},{text:"30 E êles alegraram-se porque acalmou o mar: E conduziu-os ao pôrto que êles desejavam."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 50",author:"Pe. A. P. de Figueiredo",pages:[{text:"31 Glorifiquem ao Senhor as suas misericórdias e as maravilhas que obrou a favor dos filhos dos homens."},{text:"32 Exaltem-no na Congregação do Povo: E louvem-no no Consistório dos Anciãos."},{text:"33 Mudou os rios em desertos: E os mananciais das águas em terra sedenta."},{text:"34 A terra frutífera em mar salgado, pela malícia dos que habitavam nela."},{text:"35 Trocou o deserto em tanques de água: E a terra sem água em mananciais de água."},{text:"36 E estabeleceu ali aos famintos: E fundaram cidade para povoá-la."},{text:"37 E semearam os campos e plantaram vinhas: E deram fruto nativo."},{text:"38 E abençoou-os, e se multiplicaram em extremo: e não diminuiu o número dos seus animais."},{text:"39 E foram depois reduzidos a poucos: E se viram quebrantados pela fôrça dos males, e com a dor."},{text:"40 Caiu o desprêzo sôbre os príncipes: E os fêz andar errando fora do caminho, e por onde o não havia."},{text:"41 E aliviou o pobre da sua miséria: E multiplicou as famílias como ovelhas."},{text:"42 Vê-lo-ão os retos, e alegrar-se-ão: E tôda a maldade fechará a sua bôca."},{text:"43 Quem é sábio e guardará estas coisas? E compreenderá as misericórdias do Senhor?"},{text:"Salmos — capítulo 107."},{text:"1 Cântico de Salmo do mesmo Davi."},{text:"2 Preparado está o meu coração, ó Deus, preparado está o meu coração, cantarei, e direi salmos na minha glória."},{text:"3 tools — see the cookie policy for details"},{text:"4 Louvar-te-ei no meio dos povos, Senhor: E te direi salmos entre as nações."},{text:"5 Pois grande é sôbre os céus a tua misericórdia e a tua verdade se eleva até às nuvens."},{text:"6 Exalta-te, ó Deus, sôbre os Céus, e resplandeça sôbre tôda a terra a tua glória:"},{text:"7 Para que sejam livres os teus escolhidos. Salva-me com a tua destra, e atende-me:"},{text:"8 Deus falou no seu santo: Regozijar-me-ei, e repartirei Siquém, e medirei o vale das tendas."},{text:"9 Meu é Galaad, e meu é Manassés: E Efraim a segurança da minha cabeça. Judá meu rei:"},{text:"10 Moab vaso da minha esperança. Até à Iduméia estenderei o meu calçado: Os estrangeiros se me têm feito amigos."},{text:"11 Quem me conduzirá à cidade fortificada? Quem me conduzirá até à Iduméia?"},{text:"12 Porventura não és tu, ó Deus, o que nos tens desamparado, e não sairás, ó Deus, na testa dos nossos exércitos?"},{text:"13 Dá-nos socorro na tribulação: Porque é vã a salvação que se espera da parte do homem."},{text:"14 Em Deus faremos proezas: E êle reduzirá a um nada os nossos inimigos."},{text:"Salmos — capítulo 108."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 Ó Deus, não cales o meu louvor: Porque a bôca do pecador, e a bôca do traidor se abriu contra mim."},{text:"3 tools — see the cookie policy for details"},{text:"4 Em vez de amar-me, diziam mal de mim: Mas eu orava."},{text:"5 E tornaram contra mim males por bens: E ódio em câmbio do amor que lhes tinha."},{text:"6 Põe sôbre êle ao pecador: E o diabo esteja à sua direita."},{text:"7 Quando fôr julgado, saia condenado: E a sua oração se lhe impute a pecado."},{text:"8 Sejam abreviados os seus dias: E receba outro o seu bispado."},{text:"9 Fiquem seus filhos órfãos: E sua mulher viúva."},{text:"10 Prófugos andem de um lugar para outro seus filhos, e mendiguem: E sejam lançados fora das suas habitações."},{text:"11 O usurário dê caça a todos os seus bens: E os estranhos roubem o fruto dos seus trabalhos."}]}] 1
