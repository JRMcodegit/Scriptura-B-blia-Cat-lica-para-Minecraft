give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"12 Deus, Juiz justo, forte, e paciente: Ira-se acaso todos os dias?"},{text:"13 Se vós vos não converterdes, vibrará a sua espada: Armou o seu arco, e o tem pronto."},{text:"14 Já pôs nêle os instrumentos da morte; já preparou as suas setas ardentes."},{text:"15 Olha como êle pariu a injustiça: Concebeu dor, e pariu a iniqüidade."},{text:"16 O fôsso abriu, e o cavou: Mas precipitou-se na cova por si aberta."},{text:"17 A sua dor se voltará contra a sua cabeça: E sôbre a sua fronte recairá a sua iniqüidade."},{text:"18 Glorificarei ao Senhor segundo a sua justiça, e cantarei o nome do Senhor altíssimo."},{text:"Salmos — capítulo 8."},{text:"1 Para o fim, para os lagares, Salmo de Davi."},{text:"2 Senhor, nosso dominador soberano, quão admirável é o teu nome em tôda a terra! Porque a tua magnificência se elevou sôbre os céus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque eu hei de ver os teus céus, obra dos teus dedos: A lua e as estrêlas que tu estabeleceste."},{text:"5 Que é o homem, para tu te lembrares dêle? ou que é o filho do homem para tu o visitares?"},{text:"6 Pouco menor o fizeste que os anjos, de glória e de honra o coroaste:"},{text:"7 E tu o puseste sôbre as obras das tuas mãos."},{text:"8 Tôdas as coisas sujeitaste debaixo de seus pés, as ovelhas e as vacas tôdas: E além dêstes os outros animais do campo."},{text:"9 As aves do Céu, e os peixes do mar, que discorrem pelas veredas do mar."},{text:"10 Senhor, nosso dominador soberano, que admirável é o teu nome em tôda a terra!"},{text:"Salmos — capítulo 9."},{text:"1 Para o fim, pelos segredos do Filho, Salmo de Davi."},{text:"2 Eu te glorificarei, Senhor, com todo o meu coração, contarei tôdas as tuas maravilhas."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque fizeste pôr em fugida ao meu inimigo: Serão debilitados, e perecerão diante de ti."},{text:"5 Porque julgaste e defendeste a minha causa: Assentaste-te sôbre o trono tu que julgas segundo a justiça."},{text:"6 Tu repreendeste as nações, e o ímpio pereceu: Apagaste o nome dêles para sempre, e por todos os séculos dos séculos."},{text:"7 As espadas do inimigo perderam a sua fôrça para sempre: E destruíste as suas cidades. A memória dêles pereceu com ruído:"},{text:"8 E o Senhor permanece eternamente. Êle preparou o seu trono para exercer o juízo:"},{text:"9 E êle mesmo julgará tôda a terra em eqüidade, êle julgará os povos em justiça."},{text:"10 O Senhor se fêz o refúgio para o pobre: Socorrendo-o oportunamente na angústia."},{text:"11 Em ti pois esperem os que conhecem o teu nome: Porque tu, Senhor, não desamparaste aos que te buscam."},{text:"12 Cantai ao Senhor, que habita em Sião: Anunciai entre as nações os seus conselhos:"},{text:"13 Porque demandando o sangue dêles os teve presentes: Não se esqueceu do clamor dos pobres."},{text:"14 Tem compaixão de mim, Senhor: Vê a humilhação a que meus inimigos me reduziram."},{text:"15 Tu que me retiras das portas da morte, para que publique todos os teus louvores nas portas da filha de Sião."},{text:"16 Exultarei na tua salvação: Cravaram-se as gentes na ruína, que me haviam preparado. No mesmo laço que esconderam, ficou prêso o pé dêles."},{text:"17 Conhecido será o Senhor que faz justiça: Nas obras das suas mãos foi prêso o pecador."},{text:"18 Sejam precipitados todos os pecadores no inferno, tôdas as nações que se esquecem de Deus."},{text:"19 Porque nem para sempre haverá esquecimento do pobre: Nem a paciência dos pobres será para sempre frustrada."},{text:"20 Levanta-te, Senhor, não se fortifique o homem: Sejam julgadas as nações em tua presença."},{text:"21 Senhor, estabelece sôbre êles um legislador: Para que as nações conheçam que são homens."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 Porque te apartaste, tu, Senhor, para longe, desamparas-nos nas necessidades, na tribulação?"},{text:"23 Entretanto que o ímpio se ensoberbece, é abrasado o pobre: Êles são apanhados nos pensamentos de que o seu espírito está ocupado."},{text:"24 Porque o pecador tira louvor nos desejos da sua alma: E o iníquo é abençoado."},{text:"25 O pecador irritou ao Senhor, não o buscará segundo a grandeza da sua indignação."},{text:"26 Não há Deus diante dêle: Os seus caminhos são maculados em todos os tempos. Os teus juízos estão tirados de diante dêle: Êle dominará a todos os seus inimigos."},{text:"27 Porque êle disse no seu coração: Não serei abalado de geração em geração, sem mal."},{text:"28 A sua bôca está cheia de maledicência, e de amargura e de dolo: Debaixo da sua língua está o trabalho e a dor."},{text:"29 Está de assento em emboscada com os ricos em lugares ocultos, para matar ao inocente."},{text:"30 Os seus olhos estão voltados contra o pobre: Arma ciladas em secreto, como o leão na sua cova. Arma ciladas para arrebatar ao pobre: Para arrebatar ao pobre atraindo-o a si."},{text:"31 Êle o abaterá no seu laço, se inclinará, e se deixará cair, logo que se apoderar dos pobres."},{text:"32 Porque êle disse no seu coração: Deus se esqueceu, apartou o seu rosto para não ver jamais."},{text:"33 Levanta-te, Senhor Deus, eleve-se a tua mão: Não te esqueças dos pobres."},{text:"34 Por que razão irritou o ímpio a Deus? Porque disse no seu coração: Êle não perguntará por isso."},{text:"35 Tu o vês, porque tu consideras o trabalho e a dor: Para os entregares às tuas mãos. Para ti se reservou o cuidado do pobre: Tu serás o que ajudes o órfão."},{text:"36 Quebra o braço do pecador e do maligno: O seu pecado buscar-se-á, e não se achará."},{text:"37 O Senhor reinará eternamente, e por séculos de séculos: Vós, ó Nações, sereis exterminadas da sua terra."},{text:"38 O Senhor ouviu o desejo dos pobres: A tua orelha entendeu a disposição do seu coração."},{text:"39 Para julgares a favor do pupilo e do humilde, a fim de que o homem não empreenda mais engrandecer-se sôbre a terra."},{text:"Salmos — capítulo 10."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 No Senhor confio: Por que dizeis à minha alma: Foge para o monte como pássaro?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque destruíram o que tu tinhas acabado: E que fêz o justo?"},{text:"5 O Senhor habita no seu santo templo, o trono do Senhor é no Céu. Os seus olhos olham para o pobre: As suas pálpebras fazem perguntas aos filhos dos homens."},{text:"6 O Senhor faz perguntas ao justo e ao ímpio: Aquêle porém que ama a iniqüidade, aborrece a sua alma."},{text:"7 Fará chover laços sôbre os pecadores: O fogo, e o enxôfre, e as tempestades são a parte que lhes toca."},{text:"8 Porque o Senhor é justo, e êle amou a justiça: O seu rosto olha para a eqüidade."},{text:"Salmos — capítulo 11."},{text:"1 Para o fim, para a oitava, Salmo de Davi."},{text:"2 Salva-me, Senhor, porque faltou homem santo: Porque vieram a menos as verdades entre os filhos dos homens."},{text:"3 tools — see the cookie policy for details"},{text:"4 Destrua o Senhor todos os lábios dolosos, e a língua que fala arrogâncias."},{text:"5 Os que disseram: Engrandeceremos a nossa língua, nossos lábios de nós são, quem é nosso Senhor?"},{text:"6 Pela miséria dos desvalidos, e o gemido dos pobres agora me levantarei, diz o Senhor. Eu os porei em salvo: Nisto eu obrarei confiadamente."},{text:"7 As palavras do Senhor, palavras sinceras: Prata purificada ao fogo, acendrada em crisol, passada sete vêzes por ardente prova."},{text:"8 Tu, Senhor, nos guardarás: E nos preservarás desta geração para sempre."},{text:"9 Os ímpios andam ao derredor: Segundo o teu altíssimo conselho, multiplicaste os filhos dos homens."},{text:"Salmos — capítulo 12."},{text:"1 Para o fim, Salmo de Davi. Até quando, Senhor, te esquecerás de mim para sempre? Até quando apartarás de mim a tua face?"},{text:"2 Até quando encherei a minha alma de desígnios, cada dia com dor no meu coração?"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 05",author:"Pe. A. P. de Figueiredo",pages:[{text:"3 tools — see the cookie policy for details"},{text:"4 Olha para mim, e ouve-me, Senhor Deus meu. Alumia os meus olhos para que eu não durma jamais na morte:"},{text:"5 Para que nunca o meu inimigo diga: Eu prevaleci contra êle. Os que me atribulam, exultarão se eu fôr abalado:"},{text:"6 Porém eu esperei na tua misericórdia. O meu coração exultará na salvação que me virá de ti: Cantarei ao Senhor que me deu bens: E entoarei salmos ao nome do Senhor altíssimo."},{text:"Salmos — capítulo 13."},{text:"1 Para o fim, Salmo de Davi. O insensato disse no seu coração: Não há Deus. Corromperam-se, e se fizeram abomináveis nos seus desejos: Não há quem faça o bem, não há nem sequer um."},{text:"2 O Senhor olhou desde o céu para os filhos dos homens, para ver se há quem tenha inteligência, ou quem busque a Deus."},{text:"3 tools — see the cookie policy for details"},{text:"4 Acaso não terão conhecimento todos os que obram a iniqüidade, os que devoram o meu povo, como um pedaço de pão?"},{text:"5 Não invocaram o Senhor, ali tremeram de mêdo, onde não havia que temer."},{text:"6 Porque Deus está com a geração dos justos, confundistes o conselho do pobre: porque o Senhor é a sua esperança."},{text:"7 Quem dará de Sião a salvação de Israel? Quando o Senhor puser fim ao cativeiro do seu povo, exultará Jacó, e alegrar-se-á Israel."},{text:"Salmos — capítulo 14."},{text:"1 Salmo de Davi. Senhor, quem habitará no teu tabernáculo? Ou quem descansará no teu santo monte?"},{text:"2 O que caminha na inocência, e faz obras de justiça:"},{text:"3 tools — see the cookie policy for details"},{text:"4 O que nos seus olhos olha o malvado como um nada: Mas honra aos que temem ao Senhor: O que jura a seu próximo, e não o engana."},{text:"5 O que não deu à usura o seu dinheiro, nem recebeu dádivas sôbre o inocente: O que faz estas coisas não será jamais comovido."},{text:"Salmos — capítulo 15."},{text:"1 Inscrição do título, pelo mesmo Davi. Guarda-me, Senhor, porque eu esperei em ti."},{text:"2 Eu disse ao Senhor: Tu és o meu Deus, porque não tens necessidade dos meus bens."},{text:"3 tools — see the cookie policy for details"},{text:"4 Multiplicaram-se as enfermidades dêles: Depois correram aceleradamente. Não congregarei os seus conventículos sangüinários: Nem me lembrarei de seus nomes ainda para pronunciá-los."},{text:"5 O Senhor é a porção da minha herança, e do meu cálice: Tu és o que me restituirás a minha herança."},{text:"6 O meu quinhão me caiu em lugares deliciosos: Porque a minha herança é excelente para mim."},{text:"7 Louvarei ao Senhor, que me deu inteligência: E além disso ainda durante a noite me increparam as minhas entranhas."},{text:"8 Contemplava eu sempre ao Senhor diante de mim: Porquanto está à minha direita para que não seja eu comovido."},{text:"9 Portanto alegrou-se o meu coração, e regozijou-se a minha língua: E além disso também a minha carne repousará em esperança."},{text:"10 Porque não deixarás a minha alma no inferno: Nem permitirás que o teu Santo veja corrupção. A mim me fizeste conhecer os caminhos da vida, encher-me-ás de alegria com teu rosto: Deleites na tua direita para sempre."},{text:"Salmos — capítulo 16."},{text:"1 Oração de Davi. Ouve, Senhor, a minha justiça: Atende ao meu humilde rogo. Chegue aos teus ouvidos a oração que te faço, não com lábios enganosos."},{text:"2 Do teu rosto saia o meu juízo: Vejam teus olhos a eqüidade."},{text:"3 tools — see the cookie policy for details"},{text:"4 Para que a minha bôca não fale as obras dos homens: Por amor às palavras de teus lábios tenho guardado caminhos penosos."},{text:"5 Firma os meus passos nas tuas veredas: Para que os meus pés não vacilem."},{text:"6 Eu clamei, porque tu me tens ouvido, ó Deus: Inclina para mim a tua orelha, e ouve as minhas palavras."},{text:"7 Faze que sejam maravilhosas as tuas misericórdias tu que salvas aos que esperam em ti."},{text:"8 Guarda-me dos que resistem à tua direita, como à menina do ôlho. Debaixo da sombra das tuas asas defende-me"},{text:"9 da face dos ímpios que me afligiram. Os meus inimigos cercaram a minha alma,"},{text:"10 cerraram as suas entranhas: A sua bôca falou com soberba."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 06",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 Depois de me terem lançado fora me cercam agora: E resolveram abaixar os seus olhos para a terra."},{text:"12 Êles me receberam como leão preparado à prêsa: E como um cachorro do leão, que habita nos lugares ocultos."},{text:"13 Levanta-te, Senhor, vem antes dêle, e prostra-o: Livra a minha alma do ímpio, tua espada,"},{text:"14 dos inimigos da tua destra. Separa-os, Senhor, em vida dêles, dos que são poucos sôbre a terra: De tuas coisas escondidas se tem repleto o seu ventre. Fartaram-se de filhos: Deixaram suas sobras aos seus pequeninos."},{text:"15 Mas eu com justiça comparecerei na tua presença: Saciar-me-ei quando aparecer a tua glória."},{text:"Salmos — capítulo 17."},{text:"1 Para o fim, a Davi, servo do Senhor, que pronunciou para glória do Senhor as palavras dêste cântico, no dia em que o Senhor o livrou da mão de todos os seus inimigos, assim como do poder de Saul, e disse:"},{text:"2 Eu te amarei, Senhor, que és a minha fortaleza:"},{text:"3 tools — see the cookie policy for details"},{text:"4 Louvando-o, invocarei ao Senhor: E serei salvo de meus inimigos."},{text:"5 Cercaram-me dores de morte: E torrentes de iniqüidade me conturbaram."},{text:"6 Dores de inferno me cercaram: Surpreenderam-me laços de morte."},{text:"7 Na minha tribulação invoquei o Senhor, e clamei ao meu Deus. E êle ouviu desde o seu santo templo a minha voz: E o clamor que eu dei na sua presença, entrou nos seus ouvidos."},{text:"8 Comoveu-se a terra, e tremeu: Os fundamentos dos montes estremeceram, e se abalaram, porque se indignou contra êles."},{text:"9 Subiu fumo na ira dêle: E saiu fogo ardendo do seu rosto: Por êle foram incendiados carvões."},{text:"10 Inclinou os céus, e desceu: E a obscuridade debaixo de seus pés."},{text:"11 E subiu sôbre querubins, e voou: Voou sôbre as asas dos ventos."},{text:"12 E se ocultou nas trevas como em um pavilhão seu, que o cercava: Água tenebrosa nas nuvens do ar."},{text:"13 Pelo resplendor da sua presença se desfizeram as nuvens em chuva de pedra, e carvões de fogo."},{text:"14 E o Senhor trovejou desde o céu, e o Altíssimo fêz ouvir a sua voz: E caíram pedra e carvões de fogo."},{text:"15 E enviou as suas setas e desbaratou-os: Multiplicou relâmpagos, e os aterrou."},{text:"16 E apareceram os mananciais das águas, e ficaram descobertos os fundamentos da terra: Às tuas ameaças, ó Senhor, ao sôpro impetuoso da tua ira."},{text:"17 Enviou desde o alto, e me tomou: E me tirou das muitas águas."},{text:"18 Êle me livrou de meus fortíssimos inimigos, e dos que me aborreciam: Porque se tinham feito mais poderosos do que eu."},{text:"19 Êles me atacaram no dia da minha aflição: E o Senhor se declarou meu protetor."},{text:"20 Êle me tirou ao largo: Êle me salvou, por efeito de me querer bem."},{text:"21 E o Senhor me retribuirá segundo a minha justiça, e êle me retribuirá segundo a pureza das minhas mãos."},{text:"22 Porque guardei os caminhos do Senhor, e não procedi impiamente contra o meu Deus."},{text:"23 Porque todos os seus juízos estão diante de mim: E porque não repeli de diante de mim as suas justiças."},{text:"24 E serei sem mácula diante dêle: E me guardarei da minha iniqüidade."},{text:"25 E o Senhor me retribuirá segundo a minha justiça: E segundo a pureza das minhas mãos que é presente aos seus olhos."},{text:"26 Tu serás santo com o santo, e serás inocente com varão inocente:"},{text:"27 E com escolhido escolhido serás: E serás perverso com o perverso."},{text:"28 Porque tu salvarás ao povo humilde: E humilharás os olhos dos soberbos."},{text:"29 Pois que tu, Senhor, alumias a minha candeia: Esclarece, meu Deus, as minhas trevas."},{text:"30 Porque por ti sairei livre da tentação, e com o meu Deus traspassarei a muralha."},{text:"31 Meu Deus, sem mácula é o caminho do Senhor: As suas palavras são examinadas no fogo: êle é o protetor de todos os que nêle esperam."},{text:"32 Porque quem é Deus fora do Senhor? Ou que Deus há fora do nosso Deus?"},{text:"33 Êle é o Deus que me revestiu de fôrça: E fêz que o meu caminho fôsse imaculado."},{text:"34 Que fêz os meus pés como de cervos, e me estabeleceu sôbre lugares altos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 07",author:"Pe. A. P. de Figueiredo",pages:[{text:"35 Que adestra as minhas mãos para a peleja: E formaste os meus braços, como arco de bronze."},{text:"36 Que me deste a tua proteção para me salvar: E a tua direita me susteve: A tua disciplina me corrigiu até o fim: E essa tua mesma disciplina ela me ensinará."},{text:"37 Alargaste os meus passos debaixo de mim: E não se enfraqueceram os meus pés:"},{text:"38 Perseguirei os meus inimigos, e apanhá-los-ei: E não me volverei até que êles acabem."},{text:"39 Eu lhes quebrarei as fôrças, e êles não poderão ter-se em pé: E cairão debaixo de meus pés."},{text:"40 Porque tu me guarneceste de fôrça para a guerra: E abateste debaixo de mim aos que se levantaram contra mim:"},{text:"41 E fizeste que os meus inimigos me dessem costas, e aniquilaste aos que me aborreciam."},{text:"42 Gritaram, e não havia quem os salvasse, ao Senhor: E não os ouviu."},{text:"43 E os desfarei, como o pó que o vento espalha: Fá-los-ei desaparecer como a lama das ruas."},{text:"44 Livrar-me-ás das contradições do povo: Estabelecer-me-ás em cabeça das gentes."},{text:"45 Um povo, que não conheci, me serviu: Ao ouvir a minha voz me foi obediente."},{text:"46 Os filhos estranhos me mentiram, os filhos estranhos se envelheceram, e claudicaram dos seus caminhos."},{text:"47 Vive o Senhor, e seja bendito o meu Deus, e seja exaltado o Deus da minha salvação."},{text:"48 Deus que me dás vinganças, e sujeitas os povos debaixo de mim, meu libertador dos meus inimigos enfurecidos."},{text:"49 E tu me elevarás por cima daqueles, que se levantam contra mim: Tu me livrarás do homem iníquo."},{text:"50 Por isso eu, Senhor, te louvarei entre as nações: E cantarei um salmo ao teu nome."},{text:"51 O qual engrandece com magnificência a salvação do seu rei, e que faz misericórdia a Davi seu Cristo, e a fará à sua posteridade por todos os séculos."},{text:"Salmos — capítulo 18."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 Os céus publicam a glória de Deus, e o firmamento anuncia as obras das suas mãos."},{text:"3 tools — see the cookie policy for details"},{text:"4 Não há linguagem, nem fala, por quem não sejam entendidas as suas vozes."},{text:"5 O seu som se estendeu por tôda a terra: E as suas palavras até as extremidades do mundo."},{text:"6 No sol pôs o seu tabernáculo: E êle como espôso que sai do seu tálamo: Deu saltos como gigante para correr o caminho,"},{text:"7 a sua saída é desde uma extremidade do céu: E corre até à outra extremidade dêle: E não há quem se esconda do seu calor."},{text:"8 A lei do Senhor que é imaculada converte as almas: O testemunho do Senhor é fiel, e dá sabedoria aos pequeninos."},{text:"9 As justiças do Senhor são retas, que alegram os corações: O preceito do Senhor é claro, que esclarece os olhos."},{text:"10 O temor do Senhor é santo, que permanece por séculos de séculos: Os juízos do Senhor são verdadeiros, cheios de justiça em si mesmos."},{text:"11 Êles são mais para desejar do que o muito ouro e as muitas pedras preciosas: E são mais doces do que o mel e o favo."},{text:"12 Pelo que o teu servo os guarda, e em os guardar há grande recompensa."},{text:"13 Quem é que conhece os seus delitos? purifica-me dos que me são ocultos:"},{text:"14 E perdoa ao teu servo os alheios. Se êles se não senhorearem de mim, então serei eu imaculado: E serei purificado do delito máximo."},{text:"15 Então as palavras de minha bôca te serão agradáveis: E a meditação do meu coração será sempre na tua presença. Senhor, favorecedor meu, e Redentor meu."},{text:"Salmos — capítulo 19."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 O Senhor te ouça no dia da tribulação: O nome de Deus de Jacó te proteja."},{text:"3 tools — see the cookie policy for details"},{text:"4 Êle se lembre de todos os teus sacrifícios: E o holocausto que tu lhe ofereces lhe seja agradável."},{text:"5 Reparta contigo segundo o teu coração: E cumpra todos os teus desígnios."},{text:"6 Alegrar-nos-emos na tua salvação: E em nome do nosso Deus seremos engrandecidos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Cumpra o Senhor tôdas as tuas petições: Agora tenho conhecido que o Senhor salvou o seu Cristo: Êle o ouvirá desde o seu santo céu: Nos potentados a salvação é da sua direita."},{text:"8 Êstes confiam nas suas carroças, e aquêles nos seus cavalos: Mas nós invocaremos o nome do Senhor nosso Deus."},{text:"9 Êles ficaram atados, e caíram: Mas nós nos levantamos e fomos sustidos."},{text:"10 Senhor, salva ao rei: E ouve-nos no dia em que te invocarmos."},{text:"Salmos — capítulo 20."},{text:"1 Para o fim, Salmo de Davi."},{text:"2 Senhor, o rei se alegrará na tua fortaleza: E na tua salvação se regozijará em grande maneira."},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque tu o preveniste de bênçãos de doçuras: E puseste sôbre a sua cabeça uma coroa de pedras preciosas."},{text:"5 Vida te pediu a ti: E lhe concedeste diuturnidade de dias pelo século, e pelos séculos dos séculos."},{text:"6 Grande é a sua glória na tua salvação: Glória e grande formosura porás sôbre êle."},{text:"7 Porque tu o darás para bênção pelos séculos dos séculos: Enche-lo-ás de alegria com o teu rosto."},{text:"8 Porquanto o rei espera no Senhor: E na misericórdia do Altíssimo não será comovido."},{text:"9 Caia a tua mão sôbre todos os teus inimigos: Caia a tua destra sôbre todos os que te aborrecem."},{text:"10 Tu os porás como um forno aceso ao mostrar-lhes teu rosto: O Senhor na sua ira os conturbará, e o fogo os devorará."},{text:"11 Seu fruto exterminarás da terra: E a sua descendência de entre os filhos dos homens."},{text:"12 Porque urdiram contra ti males: Maquinaram conselhos que não puderam estabelecer."},{text:"13 Porquanto os porás em fugida: Nos teus resíduos prepararás o rosto dêles."},{text:"14 Exalta-te, Senhor, no teu poder: Cantaremos e louvaremos as tuas maravilhas."},{text:"Salmos — capítulo 21."},{text:"1 Para o fim, Salmo de Davi,