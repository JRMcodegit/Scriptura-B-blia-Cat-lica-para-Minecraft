give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 13",author:"Pe. A. P. de Figueiredo",pages:[{text:"5 Êle ama a misericórdia e a justiça: Da misericórdia do Senhor está cheia tôda a terra."},{text:"6 Pela palavra do Senhor se firmaram os céus: E pelo Espírito da sua bôca tôda a sua virtude."},{text:"7 Êle ajunta como em odre as águas do mar: Êle põe os abismos em tesouros."},{text:"8 Tôda a terra tema ao Senhor: E todos os que habitam o universo tremam dêle."},{text:"9 Porque êle disse, e foram feitas as coisas: Êle mandou e foram criadas."},{text:"10 O Senhor dissipa os projetos das nações: E reprova os intentos dos povos, e arruína os conselhos dos príncipes."},{text:"11 Mas o conselho do Senhor permanece eternamente: Os pensamentos do seu coração de geração em geração."},{text:"12 Bem-aventurada a gente que tem ao Senhor por seu Deus: O povo, a quem escolheu em herança para si."},{text:"13 Desde o céu olhou o Senhor e viu todos os filhos dos homens."},{text:"14 Desde a sua morada que tem preparada olhou sôbre todos os que habitam a terra."},{text:"15 Êle é o que formou o coração de cada um dêles: O que entende tôdas as suas obras."},{text:"16 Não se salva o rei por grande exército: Nem o gigante se salvará pela sua fôrça."},{text:"17 Enganoso o cavalo para a salvação: E em a sua grande fôrça não se salvará."},{text:"18 Eis-aqui os olhos do Senhor sôbre os que o temem: E em aquêles que esperam sôbre a sua misericórdia."},{text:"19 Para livrar da morte as suas almas: E para os sustentar na sua fome."},{text:"20 A nossa alma espera ao Senhor: Porque é nosso favorecedor e protetor."},{text:"21 Porque nêle se alegrará o nosso coração: E no seu santo Nome temos esperado."},{text:"22 Faça-se, Senhor, sôbre nós a tua misericórdia: Da maneira que em ti temos esperado."},{text:"Salmos — capítulo 33."},{text:"1 Salmo de Davi, quando mudou o seu rosto diante de Aquimelec, que o despediu, e êle se foi."},{text:"2 Bendirei o Senhor em todo o tempo: Seu louvor será sempre na minha bôca."},{text:"3 tools — see the cookie policy for details"},{text:"4 Engrandecei comigo ao Senhor: E exaltemos o seu nome todos à uma."},{text:"5 Busquei ao Senhor, e me ouviu: E me livrou de tôdas as minhas tribulações."},{text:"6 Chegai-vos a êle, e sereis iluminados: E vossos rostos não serão confundidos."},{text:"7 Êste pobre levantou o grito, e o Senhor o ouviu: E êle o salvou de tôdas as suas tribulações."},{text:"8 O anjo do Senhor andará à roda dos que o temem: E os livrará."},{text:"9 Gostai, e vêde quão suave é o Senhor: Ditoso o homem, que espera nêle."},{text:"10 Temei ao Senhor todos vós os seus Santos: Porque os que o temem, não caem em pobreza."},{text:"11 Os ricos necessitaram e tiveram fome: Mas os que buscam ao Senhor, não serão privados de bem algum."},{text:"12 Vinde, filhos, ouvi-me: Eu vos ensinarei o temor do Senhor."},{text:"13 Quem é o homem que quer a vida: E que deseja ver os dias bem-aventurados?"},{text:"14 Guarda a tua língua do mal: E os teus lábios não falem engano."},{text:"15 Desvia-te do mal, e faze o bem: Busca a paz, e vai em seu seguimento."},{text:"16 Os olhos do Senhor estão sôbre os justos: E os seus ouvidos aos rogos dêles."},{text:"17 Mas o rosto do Senhor sôbre os que fazem o mal: Para apagar da terra a sua memória."},{text:"18 Os justos clamaram, e o Senhor os ouviu: E os salvou de tôdas as suas tribulações."},{text:"19 Perto está o Senhor daqueles que têm o coração atribulado: E aos humildes de espírito os salvará."},{text:"20 Muitas as tribulações dos justos, e de tôdas estas os livrará o Senhor."},{text:"21 O Senhor guarda todos os seus ossos: E nem sequer um dêles se quebrará."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Salmos Vol. 14",author:"Pe. A. P. de Figueiredo",pages:[{text:"22 É péssima a morte dos pecadores: E os que aborrecem o justo, perecerão."},{text:"23 O Senhor remirá as almas dos seus servos: E todos os que esperam nêle não perecerão."},{text:"Salmos — capítulo 34."},{text:"1 Do mesmo Davi. Julga, Senhor, aos que me fazem dano, expugna aos que me combatem."},{text:"2 Toma as tuas armas e o teu escudo: E levanta-te em meu socorro."},{text:"3 tools — see the cookie policy for details"},{text:"4 Sejam confundidos e envergonhados os que buscam a minha alma. Voltem atrás, e sejam confundidos os que meditam males contra mim."},{text:"5 Sejam feitos como o pó ante a face do vento: E o Anjo do Senhor os coarcte."},{text:"6 Torne-se o seu caminho em trevas e escorregadio: E o Anjo do Senhor os persiga."},{text:"7 Porquanto sem razão me esconderam o seu laço da morte: Sem causa encheram de opróbrios a minha alma."},{text:"8 Venha sôbre êle um laço que ignora: E a rêde que escondeu o prenda a êle: E caia no mesmo laço que êle armou."},{text:"9 Mas a minha alma regozijar-se-á no Senhor: E deleitar-se-á em seu Salvador."},{text:"10 Todos os meus ossos dirão: Senhor, quem é semelhante a ti? Que livras ao desvalido das mãos dos mais fortes que êle: Ao necessitado e ao pobre dos que o roubam."},{text:"11 Levantando-se testemunhas iníquas, coisas que não sabia me perguntavam."},{text:"12 Tornavam-me a mim males por bens: Esterilidade à minha alma."},{text:"13 Porém eu quando me eram molestos, me vestia de cilício. Humilhava a minha alma com o jejum: E a minha oração dava voltas no meu seio."},{text:"14 Como a próximo, e como a irmão nosso assim lhe comprazia: Como um que traz luto e está em tristeza assim me humilhava."},{text:"15 E se alegraram e contra mim se ajuntaram: amontoaram-se sôbre mim açoites, e não o sabia."},{text:"16 Foram dissipados, e não se arrependeram, tentaram-me, insultaram-me com escárnios: Rangeram sôbre mim os seus dentes."},{text:"17 Senhor, quando tornarás a olhar-me? resgata a minha alma da malignidade dêles, dos leões a única minha."},{text:"18 Glorificar-te-ei na Igreja grande, no meio do povo numeroso te louvarei."},{text:"19 Não se regozijem sôbre mim os que me são contrários injustamente: Os que me aborrecem sem causa e acenam com os olhos."},{text:"20 Porque na verdade me falavam com demonstrações de paz: Mas falando na comoção da terra, maquinavam enganos."},{text:"21 E alargaram sôbre mim a sua bôca: E disseram: Bem, bem, tem visto os nossos olhos."},{text:"22 Tu o tens visto, Senhor, não cales: Senhor, não te apartes de mim."},{text:"23 Levanta-te e atende ao meu juízo: Deus meu, e Senhor meu, na minha causa."},{text:"24 Julga-me segundo a tua justiça, Senhor Deus meu, e não se alegrem sôbre mim."},{text:"25 Não digam em seus corações: Ainda bem, ainda bem, para nossa alma: Nem digam: Nós o temos devorado."},{text:"26 Fiquem envergonhados, e confundidos todos juntos, os que se congratulam dos meus males. Vestidos sejam de confusão e de vergonha os que falam com orgulho sôbre mim."},{text:"27 Regozijem-se e alegrem-se os que querem a minha justiça: E digam sempre: Engrandecido seja o Senhor, os que querem a paz do seu servo."},{text:"28 A minha língua publicará a tua justiça, todo o dia o teu louvor."},{text:"Salmos — capítulo 35."},{text:"1 Para o fim, do mesmo Davi, servo do Senhor."},{text:"2 Disse o injusto entre si mesmo, que êle delinqüiria: Não há temor de Deus ante seus olhos."},{text:"3 tools — see the cookie policy for details"},{text:"4 As palavras da sua bôca são iniqüidade e engano: Não quis instruir-se para fazer o bem."},{text:"5 Meditou a iniqüidade na sua cama: Deixou-se estar em todos os caminhos que não eram bons, e não aborreceu a malícia."},{text:"6 Senhor, a tua misericórdia está no céu e a tua verdade até às nuvens."},{text:"7 A tua justiça é como os montes de Deus: Os teus juízos são um abismo profundo. Tu, Senhor, salvarás os homens, e as bêstas:"},{text:"8 Segundo tens multiplicado a tua misericórdia, ó Deus. Mas os filhos dos homens esperarão à sombra das tuas asas."}]}] 1
