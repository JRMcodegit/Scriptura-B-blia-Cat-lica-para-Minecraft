give @p minecraft:written_book[written_book_content={title:"Jó Vol. 10",author:"Pe. A. P. de Figueiredo",pages:[{text:"9 Que sabes tu que nós ignoremos? Que entendes tu que nós não saibamos?"},{text:"10 Também há entre nós velhos, e anciãos muito mais antigos que teus pais."},{text:"11 Será porventura dificultoso a Deus consolar-te? Porém as tuas perversas palavras o impedem."},{text:"12 Por que te ensoberbece o teu coração, e como pensando coisas grandes, tens os olhos pasmados?"},{text:"13 Por que se incha o teu espírito contra Deus, para proferires por tua bôca tão estranhos discursos?"},{text:"14 Que é o homem, para ser imaculado, e para parecer justo tendo nascido duma mulher?"},{text:"15 Olha como entre os seus mesmos santos nenhum há imutável, e como nem os céus são puros na sua presença."},{text:"16 Quanto mais o homem abominável e inútil, que bebe a iniqüidade como a água?"},{text:"17 Eu te mostrarei, ouve-me: Eu te contarei o que tenho visto."},{text:"18 Os sábios o publicam, e não ocultam saberem-no de seus pais."},{text:"19 Àqueles sòmente foi dada a terra, e não passou estranho por meio dêles."},{text:"20 Em todos os seus dias o ímpio se ensoberbece, e o número dos anos da sua tirania é incerto."},{text:"21 A zoada do terror está sempre em seus ouvidos: E ainda quando há paz, êle sempre receia traições."},{text:"22 Não crê que se possa voltar das trevas à luz, vendo em roda de tôdas as partes a espada."},{text:"23 Quando se mover para buscar pão conhece que está preparado na sua mão o dia das trevas."},{text:"24 A tribulação o aterrará, e a angústia o cercará, como a um rei que se prepara para a batalha."},{text:"25 Porque estendeu a sua mão contra Deus, e se fêz forte contra o Todo-poderoso."},{text:"26 Correu contra êle com o pescoço levantado, e armou-se duma soberba inflexível."},{text:"27 A gordura cobriu todo o seu rosto, e a enxúndia lhe pende das suas ilhargas."},{text:"28 Habitou em cidades assoladas, e em casas desertas que estão reduzidas a m