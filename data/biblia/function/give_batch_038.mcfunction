give @p minecraft:written_book[written_book_content={title:"Jó Vol. 07",author:"Pe. A. P. de Figueiredo",pages:[{text:"11 De pele e de carne me vestiste: De ossos e de nervos me compuseste:"},{text:"12 Vida, e misericórdia me concedeste, e a tua assistência conservou o meu espírito."},{text:"13 Ainda que tu escondas estas coisas em teu coração, eu sei todavia que tu te lembras de tudo."},{text:"14 Se eu pequei, tu me perdoaste na mesma hora: Por que não permites tu que eu esteja limpo da minha iniqüidade?"},{text:"15 Se fôr mau, desgraçado de mim: Mas se fôr justo, não levantarei cabeça, farto de aflição e de miséria."},{text:"16 E por causa da minha soberba, tu me apanharás como a uma leoa, e me tornarás a atormentar de um modo terrível."},{text:"17 Tu renovas contra mim as testemunhas, e multiplicas contra mim a tua ira, e as penas combatem contra mim."},{text:"18 Por que me tiraste tu do ventre de minha mãe? Oxalá que eu tivera perecido, para que nenhum ôlho me visse."},{text:"19 Que tivera sido como se não fôra, desde o ventre trasladado para a sepultura."},{text:"20 Porventura o pequeno número de meus dias não se acabará em breve? Deixa-me pois que eu chore um pouco a minha dor:"},{text:"21 Antes que vá para não tornar para aquela terra tenebrosa, e coberta da escuridade da morte:"},{text:"22 Terra de miséria, e de trevas, onde habita a sombra da morte, e não há nenhuma ordem, senão um sempiterno horror."},{text:"Jó — capítulo 11."},{text:"1 Depois respondendo Sofar de Naamat, disse:"},{text:"2 Porventura o que fala muito, não ouvirá também? ou bastará a um homem ser grande falador para justificar-se?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Porque tu disseste: As minhas palavras são puras, e eu estou limpo na tua presença."},{text:"5 E oxalá que Deus falasse contigo, e abrisse a sua bôca,"},{text:"6 para te descobrir os segredos da sua sabedoria, e que a sua lei é de muitas maneiras, e que entendesse que é muito menos o com que êle te castiga em comparação do que merece a tua maldade."},{text:"7 Acaso alcançarás os caminhos de Deus, e conhecerás perfeitamente o Todo-Poderoso?"},{text:"8 Êle é mais elevado do que o céu e que farás tu? é mais profundo do que o inferno, e como o conhecerás?"},{text:"9 A sua medida é mais comprida do que a terra, e mais larga que o mar."},{text:"10 Se êle destruir tôdas as coisas ou as apinhoar em uma, quem o contrastará?"},{text:"11 Por que êle conhece a vaidade dos homens, e vendo a iniqüidade dêles, acaso a considera?"},{text:"12 O homem vão eleva-se em soberba, e julga ter nascido livre, como a cria do asno montês."},{text:"13 Mas tu endureceste o teu coração, e levantaste a tua mão para Deus."},{text:"14 Se lançares fora de ti a iniqüidade, que está na tua mão, e se a injustiça não assistir na tua casa:"},{text:"15 Então poderás levantar o teu rosto sem mácula, e serás estável e não temerás."},{text:"16 Também te esquecerás da tua miséria, e lembrar-te-ás dela como de águas, que passaram."},{text:"17 E se levantará pela tarde sôbre ti uma luz como a do meio-dia: E quando te julgares consumido, nascerás como a estrêla dalva."},{text:"18 E terás firmeza na esperança, que te propuseste, e enterrado dormirás seguro."},{text:"19 Repousarás, e não haverá quem te amedronte: e rogarão muitos a tua face."},{text:"20 Mas os olhos dos ímpios desfalecerão, e não lhes ficará refúgio, e a esperança dêles será abominação da sua alma."},{text:"Jó — capítulo 12."},{text:"1 Mas respondendo Jó, disse:"},{text:"2 Logo só vós sois homens, e convosco morrerá a sabedoria?"},{text:"3 tools — see the cookie policy for details"},{text:"4 Aquêle que é escarnecido pelo seu amigo como eu invocará a Deus e êle o ouvirá: Porque se zomba da simplicidade do justo."},{text:"5 É lâmpada desprezada no conceito dos ricos, aparelhada para o tempo determinado."},{text:"6 As casas dos ladrões abundam, e atrevidamente provocam a Deus, quando Êle lhes põe tudo nas suas mãos."}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 08",author:"Pe. A. P. de Figueiredo",pages:[{text:"7 Pergunta pois aos animais, e êles te ensinarão: E às aves do Céu, e elas to indicarão."},{text:"8 Fala com a terra, e ela te responderá: E os peixes do mar te instruirão."},{text:"9 Quem ignora que a mão de Deus fêz tôdas estas coisas?"},{text:"10 Na sua mão está a alma de todo o vivente, e o espírito de tôda a carne humana."},{text:"11 Porventura o ouvido não julga das palavras, e o paladar de quem come não julga do sabor?"},{text:"12 A sabedoria acha-se nos velhos, e a prudência na vida dilatada."},{text:"13 A sabedoria e a fortaleza está em Deus, êle possui o conselho e a inteligência."},{text:"14 Se êle destruir, ninguém há que edifique: Se clausurar um homem, ninguém há que o solte."},{text:"15 Se retiver as águas, tudo se secará: E se as largar, alagarão a terra."},{text:"16 Nêle residem a fortaleza e a sabedoria: Êle conhece assim ao que engana, como ao que é enganado."},{text:"17 Êle conduz aos conselheiros a um fim imprudente, e conduz à estupidez aos juízes."},{text:"18 Êle desata o boldrié aos reis, e cinge os seus rins com uma corda."},{text:"19 Deixa ir aos sacerdotes sem glória, e abate aos magnates."},{text:"20 Muda a linguagem aos que amam a verdade, e tira dos velhos a doutrina."},{text:"21 Derrama desprêzo sôbre os príncipes, elevando outra vez aos que foram oprimidos."},{text:"22 Êle tira das trevas o que estava escondido e põe em claro a sombra da morte."},{text:"23 Êle multiplica as nações e as destrói, e depois de destruídas as restitui ao seu primeiro estado."},{text:"24 Êle muda o coração dos príncipes do povo da terra, e os engana, para os fazer andar debalde por caminhos desviados:"},{text:"25 Andarão às apalpadelas como em trevas, e não em luz, e os fará desatinar como bêbados."},{text:"Jó — capítulo 13."},{text:"1 Eis-aqui tôdas estas coisas viu o meu ôlho, e ouviu o meu ouvido, e as compreendi tôdas."},{text:"2 Isso que vós sabeis, também eu o alcanço: E não vos sou inferior."},{text:"3 tools — see the cookie policy for details"},{text:"4 Fazendo antes ver que vós sois uns forjadores de mentiras, fautores de perversos dogmas."},{text:"5 E oxalá que vós vos calásseis, para poderdes passar por sábios."},{text:"6 Ouvi pois a minha correção, a atendei ao juízo dos meus lábios."},{text:"7 Acaso necessita Deus das vossas mentiras, para que em sua defensa faleis dolosamente?"},{text:"8 Porventura olhais para o seu rosto, e vos esforçais a sentenciar a favor de Deus?"},{text:"9 Ou será isto do agrado daquele, a quem nada se pode ocultar? ou será êle surpreendido como um homem, com os vossos enganos?"},{text:"10 Êle mesmo vos condenará, porque dissimuladamente olhais para o seu rosto."},{text:"11 Logo que se mover, vos perturbará, e o seu terror cairá sôbre vós."},{text:"12 A vossa memória será semelhante à cinza, e as vossas cabeças reduzir-se-ão como a lôdo."},{text:"13 Calai-vos por um pouco, para que eu vos diga tudo o que o meu espírito me sugerir."},{text:"14 Por que razão despedaço eu as minhas carnes com os meus dentes, e por que trago eu a minha vida nas minhas mãos?"},{text:"15 Ainda quando êle me matasse, nêle esperarei: Mas acusarei na sua presença os meus caminhos."},{text:"16 E Êle mesmo será o meu salvador: Porque nenhum hipócrita ousará aparecer diante dos seus olhos."},{text:"17 Ouvi as minhas palavras, e dai ouvidos aos meus enigmas."},{text:"18 Se eu fôr julgado, sei que hei de ser achado justo."},{text:"19 Quem há que queira ser julgado comigo? venha: Por que calando me consumo?"},{text:"20 Duas coisas ao menos não obres comigo, e então não me esconderei da tua face:"}]}] 1
give @p minecraft:written_book[written_book_content={title:"Jó Vol. 09",author:"Pe. A. P. de Figueiredo",pages:[{text:"21 Desvia a tua mão longe de mim, e não me consterne o teu terror."},{text:"22 Chama por mim, e eu te responderei: Ou bem eu falarei, e tu responde-me."},{text:"23 Quantas iniqüidades e pecados tenho eu, mostra-me as minhas maldades e delitos?"},{text:"24 Por que escondes tu de mim o teu rosto, e por que me julgas tu teu inimigo?"},{text:"25 Contra uma fôlha, que é arrebatada do vento, ostentas o teu poder, e persegues a uma palha sêca:"},{text:"26 Pois escreves contra mim amarguras, e queres-me consumir pelos pecados da minha mocidade."},{text:"27 Tu puseste os meus pés num cêpo, e observaste tôdas as minhas veredas, e consideraste os vestígios de meus pés."},{text:"28 E que como a podridão hei de ser consumido, e como vestido que é comido da traça."},{text:"Jó — capítulo 14."},{text:"1 O homem nascido da mulher, que vive breve tempo, é cercado de muitas misérias."},{text:"2 Que como flor sai e é pisado, e foge como a sombra, e jamais permanece num mesmo estado."},{text:"3 tools — see the cookie policy for details"},{text:"4 Quem pode fazer puro ao que foi concebido de imunda semente? Quem senão tu que és só?"},{text:"5 Breves são os dias do homem, em teu poder está o número dos seus meses: Tu lhe demarcaste os limites, dos quais êle não pode passar."},{text:"6 Retira-te um pouco dêle, para que descanse, até que chegue o seu dia desejado, como o do jornaleiro."},{text:"7 Uma árvore tem esperança: Se fôr cortada, torna a reverdecer, e brotam os seus ramos."},{text:"8 Se se envelhecer na terra a sua raiz, e morrer o seu tronco no pó,"},{text:"9 ao cheiro d'água reverdecerá, e fará copa, como no princípio quando foi plantada."},{text:"10 Mas o homem quando morrer, despojado que seja e consumido, dize-me, que é dêle?"},{text:"11 Como se do mar se retirassem as águas, e se se esgotasse um rio, ficaria sêco:"},{text:"12 Assim como o homem quando dormir, 