give @p minecraft:written_book[written_book_content={title:"2 Samuel Vol. 21",author:"Pe. A. P. de Figueiredo",pages:[{text:"25 E edificou ali Davi um altar ao Senhor, e ofereceu holocaustos, e hóstias pacíficas: E o Senhor se aplacou com a terra, e cessou o flagelo que assolava a Israel."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 01",author:"Pe. A. P. de Figueiredo",pages:[{text:"1 Reis — capítulo 1."},{text:"1 O rei Davi porém tinha envelhecido, e achava-se numa idade mui avançada: E por mais que o cobriam de roupa, não aquecia."},{text:"2 Disseram-lhe pois os seus criados: Busquemos para o rei nosso senhor uma rapariga virgem, que esteja diante do rei e o aquente, durma ao seu lado, e preserve do grande frio o rei nosso senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Era esta uma rapariga de extrema beleza, e dormia com o rei, e o servia, mas o rei a deixou sempre virgem."},{text:"5 Adonias porém, filho de Hagit, se elevava, dizendo: Eu reinarei. E mandou fazer para si coches e tomou gente de cavalo, e cinqüenta homens, que corressem adiante dêle."},{text:"6 E nunca seu pai o repreendeu, nem disse: Por que fazes isto? E êle era também muito gentil, e o segundo gênito depois de Absalão."},{text:"7 E tinha inteligência com Joab, filho de Sarvia, e com o pontífice Abiatar, que sustentavam o partido de Adonias."},{text:"8 Mas nem o pontífice Sadoc, nem Banaias, filho de Jojada, nem o profeta Natan, nem Semei e Rei, nem o grosso do exército de Davi eram por Adonias."},{text:"9 Adonias pois tendo imolado carneiros e novilhos, e tôda a sorte de vítimas gordas ao pé da pedra de Zoelet, que está junto da Fonte de Rogel, convidou a todos os seus irmãos, filhos do rei, e a todos os de Judá,"},{text:"criados do rei."},{text:"10 Mas não convidou nem ao profeta Natan, nem a Banaias, nem a algum dos mais valentes, nem a Salomão seu irmão."},{text:"11 Disse pois Natan a Betsabée, mãe de Salomão: Tu não ouviste que Adonias filho de Hagit se tem feito rei, e que nosso senhor Davi ignora isto?"},{text:"12 Vem pois agora, toma o meu conselho, e salva a tua vida, e a de teu filho Salomão."},{text:"13 Vai, e entra ao rei Davi, e dize-lhe: Porventura tu, ó rei meu senhor, não me juraste a mim tua escrava, dizendo: Salomão, teu filho, reinará depois de mim, e êle se assentará no meu trono? Por que reina logo Adonias?"},{text:"14 E estando tu ainda falando com o rei, eu sobrevirei depois de ti, e acabarei as tuas razões."},{text:"15 Entrou pois Betsabée ao rei no seu quarto: E o rei era já muito velho, e Abisag de Sunam o servia:"},{text:"16 Inclinou-se Betsabée profundamente, e adorou o rei. E o rei lhe disse: Que é o que queres?"},{text:"17 Ela respondendo, disse: Meu senhor, tu juraste à tua escrava pelo Senhor teu Deus: Salomão, teu filho, reinará depois de mim, e êle se assentará no meu trono."},{text:"18 E agora eis-aí Adonias reina, sem tu, ó rei meu senhor, o saberes."},{text:"19 Êle imolou bois, e tôda a sorte de gordas vítimas e muitos carneiros, e convidou a todos os filhos do rei, e ao pontífice Abiatar, e a Joab general do exército: Mas não convidou a Salomão, teu servo."},{text:"20 Todavia todo o Israel está com os olhos em ti, ó rei meu senhor, para que tu lhe declares, ó rei meu senhor, quem é o que deve assentar-se no teu trono."},{text:"21 Porque tanto que o rei meu senhor dormir com seus pais, eu e meu filho seremos os pecantes."},{text:"22 E falando ela ainda com o rei, eis que chegou o profeta Natan."},{text:"23 E avisaram ao rei, dizendo: Eis-aí está o profeta Natan. E tendo entrado à presença do rei, e tendo-o adorado, prostrando-se em terra,"},{text:"24 disse Natan: Ó rei meu senhor: Acaso disseste tu: Adonias reine depois de mim e êle seja o que se assente no meu trono?"},{text:"25 Porque êle desceu hoje, e imolou bois, e vítimas gordas, e muitos carneiros, e convidou a todos os filhos do rei e aos generais do exército, e ao pontífice Abiatar: E comendo êles, e bebendo diante dêle, e dizendo:"},{text:"Viva o rei Adonias:"},{text:"26 Não me convidou a mim que sou servo teu, nem ao pontífice Sadoc, nem a Banaias, filho de Jojada, nem a teu servo Salomão."},{text:"27 Acaso saiu esta ordem da parte do rei meu senhor? Mas não é assim que tu me declaraste a mim teu servo, quem era o que devia depois do rei meu senhor assentar-se sôbre o seu trono?"},{text:"28 E o rei Davi respondeu, dizendo: Chamai-me cá a Betsabée. E tendo-se ela apresentado ao rei, e estando em pé diante dêle,"},{text:"29 jurou o rei, e disse: Viva o Senhor, que livrou a minha alma de tôda a angústia."},{text:"30 que assim como eu te jurei pelo Senhor Deus de Israel, dizendo: Salomão, teu filho, reinará depois de mim, e êle se assentará em meu lugar sôbre o meu trono: Assim o cumprirei hoje."},{text:"31 E Betsabée prostrando-se com o rosto em terra, adorou o rei dizendo: Viva: Viva Davi, meu senhor, para todo sempre."},{text:"32 Disse mais o rei Davi: Chamai-me cá ao pontífice Sadoc, e ao profeta Natan, e a Banaias filho de Jojada. E tendo êles entrado à presença do rei,"},{text:"33 disse-lhes: Tomai convosco os servos de vosso amo, e fazei montar na minha mula a meu filho Salomão, e levai-o a Gion."},{text:"34 E o pontífice Sadoc com o profeta Natan o unjam ali em rei de Israel: E vós fareis soar a trombeta, e direis: Viva o rei Salomão."},{text:"35 E voltareis em seu seguimento, e êle virá, e assentar-se-á sôbre o meu trono, e reinará em meu lugar: E eu lhe ordenarei que governe a Israel e a Judá."},{text:"36 E Banaias, filho de Jojada, respondeu ao rei, dizendo: Amém: Assim o confirme o Senhor Deus do rei meu amo."},{text:"37 Bem como o Senhor foi com o rei meu senhor, assim seja êle com Salomão, e eleve o seu trono ainda acima do trono do rei Davi, meu amo."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 02",author:"Pe. A. P. de Figueiredo",pages:[{text:"38 Desceram pois o pontífice Sadoc, e o profeta Natan, e Banaias filho de Jojada, com os cereteus, e os feleteus: E fizeram montar a Salomão na mula do rei Davi, e o levaram a Gion."},{text:"39 E o pontífice Sadoc tomou do tabernáculo o vaso do óleo, e ungiu a Salomão: E tocaram a trombeta, e disse todo o povo: Viva o rei Salomão."},{text:"40 E subiu tôda a multidão após êle, e o povo cantando ao som de flautas, e mostrando grande regozijo, e a terra retiniu com as suas aclamações."},{text:"41 Ouviu pois Adonias, e ouviram todos os que êle tinha convidado, a tempo que o banquete estava já acabado: Mas Joab, como ouvisse soar a trombeta, disse: Que quer dizer êste ruído de cidade alvoroçada?"},{text:"42 Ainda êle falava, eis que chega Jônatas, filho do pontífice Abiatar: Ao qual disse Adonias: Entra, porque tu és um valente homem, e nos trazes boas novas."},{text:"43 E respondeu Jônatas a Adonias: Não por certo: Porque o rei Davi, nosso senhor, constituiu rei a Salomão,"},{text:"44 e enviou com êle ao pontífice Sadoc, e ao profeta Natan, e a Banaias, filho de Jojada, e aos cereteus, e aos feleteus, e êstes o fizeram montar na mula do rei."},{text:"45 E o pontífice Sadoc, e o profeta Natan o ungiram rei em Gion, e dali voltaram cheios de alegria, e a cidade retumbou em clamores: Êste é o estrondo que vós ouvistes."},{text:"46 E até Salomão está já assentado no trono do reino."},{text:"47 E os servos do rei entraram a dar o parabém ao rei Davi nosso senhor, dizendo: Deus faça o nome de Salomão ainda mais ilustre do que o teu, e êle eleve o seu trono sôbre o teu trono. E o rei fêz adoração no seu leito:"},{text:"48 E disse: Bendito seja o Senhor Deus de Israel, que me fêz ver hoje com os meus próprios olhos ao que se assenta sôbre o meu trono."},{text:"49 Aquêles pois a quem Adonias tinha convidado se encheram de mêdo, e se levantaram, e cada um foi para sua parte."},{text:"50 Adonias porém temendo a Salomão, se levantou, e se foi abraçar com o chifre do altar."},{text:"51 E noticiaram a Salomão, dizendo: Eis-aí Adonias que por temer ao rei Salomão está agarrado ao chifre do Altar, dizendo: O rei Salomão me jure hoje, que êle não fará morrer seu servo à espada."},{text:"52 E Salomão respondeu: Se êle se houver como homem de bem, não cairá em terra nem um só cabelo da sua cabeça: Mas se se achar nêle maldade, morrerá."},{text:"53 Mandou pois o rei Salomão, que o fôssem tirar do altar: E Adonias tendo entrado adorou o rei Salomão: E Salomão lhe disse: Vai para tua casa."},{text:"1 Reis — capítulo 2."},{text:"1 Aproximando-se pois o dia da morte de Davi, deu êle êstes mandamentos a Salomão, seu filho, dizendo:"},{text:"2 Eis-me-aqui perto do têrmo de todos os mortais: Arma-te de valor, e porta-te como homem."},{text:"3 tools — see the cookie policy for details"},{text:"4 Para que o Senhor confirme as suas palavras, que êle falou de mim, dizendo: Se os teus filhos vigiarem sôbre os seus caminhos, e andarem diante de mim em verdade, de todo o seu coração, e de tôda a sua alma, terás tu"},{text:"sempre algum dos teus descendentes assentado no trono de Israel."},{text:"5 Tu sabes também como me tratou Joab, filho de Sarvia, e o que êle fêz aos dois generais do exército de Israel, a Abner filho de Ner, e a Amasa filho de Jeter: Os quais êle matou, e derramou o seu sangue em tempo de paz"},{text:"como se fôsse na guerra, e tingiu com êle o boldrié que trazia sôbre seus rins, e os sapatos, que tinha nos pés."},{text:"6 Farás pois conforme a tua sabedoria, e não permitirás que as suas cãs o levem em paz à sepultura."},{text:"7 E mostrarás também o teu agradecimento aos filhos de Berzelai de Galaad, e êles comerão à tua mesa: Porque me saíram ao encontro quando eu fugia de diante de Absalão, teu irmão."},{text:"8 Tens também contigo a Semei filho de Gera filho de Jemini de Baurim, que me maldisse com uma péssima maldição, quando eu ia para o arraial: Mas porque êle veio encontrar-se comigo passando eu o Jordão, eu lhe jurei"},{text:"pelo Senhor, dizendo: Não te matarei à espada:"},{text:"9 Não deixes sem castigo o seu crime. Homem entendido és, para saberes como te hás de haver com êle, e levarás as suas cãs à sepultura com morte violenta."},{text:"10 Adormeceu pois Davi com seus pais, e foi sepultado na cidade de Davi."},{text:"11 E o tempo que Davi reinou sôbre Israel, foram quarenta anos: Em Hebron reinou sete anos: Em Jerusalém, trinta e três."},{text:"12 Salomão porém tomou posse do trono de Davi seu pai, e o seu reino se fortificou sobremaneira."},{text:"13 E entrou Adonias, filho de Hagit, a ver a Betsabée, mãe de Salomão. Ela lhe disse: É porventura de paz a tua entrada? Êle lhe respondeu: De paz é."},{text:"14 E ajuntou: Tenho uma palavra que te dizer. Ela lhe respondeu: Dize-a. E êle disse:"},{text:"15 Tu sabes que o reino era meu, e que todo o Israel me tinha escolhido com preferência para seu rei: Mas o reino foi transferido, e passou para meu irmão: Porque o Senhor o destinou para êle."},{text:"16 Agora pois uma só coisa te peço, não me faças passar pela vergonha de ma recusares. Ela lhe disse: Explica-te."},{text:"17 E Adonias disse: (Como o rei Salomão não pode negar-te nada) peço-te que lhe digas, que me dê a Abisag de Sunam por mulher."},{text:"18 E Betsabée respondeu: Está bem, eu falarei por ti ao rei."},{text:"19 Veio pois Betsabée ter com o rei Salomão, para lhe falar por Adonias: E o rei se levantou a vir recebê-la, e a saudou com profunda reverência, e se assentou no seu trono: E pôs-se um trono para a mãe do rei, a qual se"},{text:"assentou à sua mão direita."}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 03",author:"Pe. A. P. de Figueiredo",pages:[{text:"20 E disse-lhe: Eu só uma pequena coisa te peço: não me envergonhes com a repulsa. E o rei lhe disse: Pede, minha mãe: Porque não é justo que tu vás descontente."},{text:"21 Disse Betsabée: Dê-se Abisag de Sunam por mulher a Adonias, teu irmão."},{text:"22 E respondeu o rei Salomão, e disse a sua mãe: Por que pedes tu Abisag de Sunam para Adonias? Pede também para êle o reino: Porque êle é meu irmão mais velho, e tem por si ao pontífice Abiatar, e a Joab, filho de"},{text:"Sarvia."},{text:"23 Jurou pois o rei Salomão pelo Senhor, dizendo: Deus me trate com todo o seu rigor, se não é verdade que Adonias por esta palavra falou contra a sua própria vida."},{text:"24 E agora juro pelo Senhor, que me segurou, e que me colocou no trono de Davi meu pai, e que estabeleceu a minha casa como tinha dito, que Adonias será hoje morto."},{text:"25 E mandou o rei Salomão com esta ordem a Banaias filho de Jojada, o qual o matou, e assim morreu."},{text:"26 Disse também o rei ao pontífice Abiatar: Vai para Anatot para o teu campo, que na verdade és digno de morte: Mas eu te não matarei hoje, porque levaste a arca do Senhor Deus diante de meu pai Davi, e acompanhaste a"},{text:"meu pai em todos os trabalhos que padeceu."},{text:"27 Desterrou pois Salomão a Abiatar, para não ser mais pontífice do Senhor, para se cumprir a palavra que o Senhor tinha proferido em Silo acêrca da casa de Heli."},{text:"28 E chegou esta notícia a Joab, porque Joab tinha seguido o partido de Adonias, e não o de Salomão: Fugiu pois Joab para o Tabernáculo do Senhor, e pegou-se ao chifre do altar."},{text:"29 E vieram dizer ao rei Salomão, que Joab tinha fugido para o Tabernáculo do Senhor, e estava ao pé do altar: e Salomão mandou a Banaias filho de Jojada, dizendo: Vai, mata-o."},{text:"30 E foi Banaias ao Tabernáculo do Senhor, e disse a Joab: O rei manda isto: Sai daqui. Êle respondeu: Não sairei, mas morrerei neste lugar. Deu Banaias parte disto ao rei, dizendo: Eis-aqui o que disse Joab, e o que me"},{text:"respondeu."},{text:"31 E o rei lhe disse: Faze como êle te disse: E mata-o, e sepulta-o, e com isto tolherás, que nem eu, nem a casa de meu pai fiquemos encarregados no sangue inocente, que Joab derramou."},{text:"32 E o Senhor fará recair o sangue dêle sôbre a sua cabeça, porque assassinou a dois homens justos, e melhores do que êle: E êle os matou à espada, sem meu pai Davi o saber, a Abner, filho de Ner, general do exército de"},{text:"Israel, e Amasa, filho de Jeter, general do exército de Judá:"},{text:"33 E o sangue dêstes recairá para sempre sôbre a cabeça de Joab, e sôbre a cabeça da sua posteridade. Mas a Davi e à sua descendência, e à sua casa, e ao seu trono dê o Senhor paz para sempre."},{text:"34 Partiu pois Banaias, filho de Jojada, e arremetendo a Joab o matou: E foi sepultado em sua casa no deserto."},{text:"35 E em lugar de Joab constituiu o rei a Banaias filho de Jojada por general do exército, e em lugar de Abiatar por pontífice a Sadoc."},{text:"36 Mandou também o rei chamar a Semei, e lhe disse: Faze para ti casa em Jerusalém, e habita aí: E não saias andando duma parte para a outra."},{text:"37 Em qualquer dia pois que daqui saíres, e que passares a torrente de Cedron, sabe que serás morto: O teu sangue recairá sôbre a tua cabeça."},{text:"38 E disse Semei ao rei: Justa ordem é esta. Como o disse o rei meu senhor, assim o executará o seu servo. Morou pois Semei em Jerusalém largo tempo."},{text:"39 Mas passados três anos aconteceu que os escravos de Semei fugiram para Aquis, filho de Maaca rei de Get: E vieram dizer a Semei que os seus escravos tinham ido para Get."},{text:"40 Levantou-se pois Semei, e silhou o seu jumento: E foi ter com Aquis a Get em busca dos seus escravos, e tornou-os a trazer de Get."},{text:"41 E avisou-se a Salomão que Semei tinha ido de Jerusalém a Get, e que tinha voltado."},{text:"42 E mandou-o chamar, e lhe disse: Não te conjurei eu pelo Senhor, e te avisei antes, dizendo: Sabe que em qualquer dia que saíres a uma, ou outra parte, morrerás? E tu me respondeste: Justa ordem é esta que acabo de"},{text:"ouvir."},{text:"43 Por que não guardaste tu logo o juramento do Senhor, e a ordem que eu te tinha dado?"},{text:"44 E o rei disse a Semei: Tu sabes todo o mal que a tua consciência te acusa teres feito a Davi meu pai: O Senhor fêz recair a tua malícia sôbre a tua cabeça."},{text:"45 E o rei Salomão será abençoado, e o trono de Davi será para sempre estável diante do Senhor."},{text:"46 Deu pois o rei ordem a Banaias filho de Jojada: O qual, tendo saído, o feriu, e êle morreu."},{text:"1 Reis — capítulo 3."},{text:"1 Confirmou-se pois o reino na mão de Salomão, e êste se aparentou com Faraó, rei do Egito, porque casou com uma sua filha, e levou-a para a cidade de Davi, até que acabasse de edificar a sua casa, e a casa do Senhor, e"},{text:"o muro à roda de Jerusalém."},{text:"2 Entretanto o povo imolava sôbre os altos: Porque até àquele dia se não tinha edificado templo ao nome do Senhor."},{text:"3 tools — see the cookie policy for details"},{text:"4 Foi Salomão pois a Gabaon, para lá sacrificar: Porque êste era o mais considerável entre todos os altos: E ofereceu mil hóstias em holocausto sôbre aquêle altar em Gabaon."},{text:"5 Apareceu pois o Senhor a Salomão em sonhos de noite, dizendo: Pede-me o que queres que eu te dê."},{text:"6 E Salomão lhe respondeu: Tu usaste de grande misericórdia com meu pai Davi, teu servo, segundo foi a verdade, e a justiça com que êle andou na tua presença, e segundo a retidão de coração para contigo: Tu lhe guardaste"}]}] 1
give @p minecraft:written_book[written_book_content={title:"1 Reis Vol. 04",author:"Pe. A. P. de Figueiredo",pages:[{text:"a tua grande misericórdia, e lhe deste um filho que se assentasse sôbre o seu trono, como hoje o está."},{text:"7 E agora, ó Senhor Deus, tu me fizeste reinar a mim teu servo em lugar de Davi meu pai: Mas eu sou um menino pequenino que, não sei por onde hei de sair nem por onde hei de entrar."},{text:"8 E o teu servo se acha no meio dum povo, que tu escolheste, de um povo infinito, que não pode contar-se nem reduzir-se à número pela sua multidão."},{text:"9 Tu pois darás a teu servo um coração dócil, para poder julgar o teu povo, e discernir entre o bem e o mal: Porque quem poderá julgar a êste povo, a êste teu povo tão vasto?"},{text:"10 Agradou pois ao Senhor esta oração, por ter Salomão pedido uma tal coisa."},{text:"11 E o Senhor disse a Salomão: Pois que esta foi a petição que me fizeste, e não pediste para ti nem muitos dias, nem riquezas, nem a morte de teus inimigos, mas pediste-me para ti a sabedoria para discernires o que é"},{text:"justo:"},{text:"12 Eis pois te fiz o que me pediste, e te dei um coração tão cheio de sabedoria e de inteligência, que nenhum antes de ti te foi semelhante, nem se levantará tal depois de ti."},{text:"13 Mas eu te dei também o que tu me não pediste: A saber, riquezas, e glória em tal grau, que não se achará um semelhante a ti entre os reis de todos os séculos passados."},{text:"14 Se tu porém andares nos meus caminhos, e guardares os meus preceitos, e os meus mandamentos, como teu pai os guardou, eu prolongarei os teus dias."},{text:"15 Então despertou Salomão, e entendeu que era sonho: E tendo vindo a Jerusalém, se pôs diante da arca do concêrto do Senhor, e ofereceu holocaustos, e vítimas pacíficas, e deu a todos os seus criados um grande banquete."},{text:"16 Nesta ocasião vieram ter com o rei duas mulheres prostitutas, e se puseram diante dêle."},{text:"17 Uma das quais disse: Faço-te, meu senhor, esta súplica: Eu e esta mulher habitávamos numa mesma casa, e eu pari na mesma câmara em que ela estava."},{text:"18 E três dias depois de ter parido, pariu ela também: E nós estávamos juntas, e não havia na casa outra alguma pessoa conosco, senão nós ambas."},{text:"19 E uma noite morreu o filho desta mulher: porque estando dormindo o abafou."},{text:"20 E levantando-se no mais profundo silêncio da noite, me tirou a meu filho do meu lado quando eu, tua escrava, dormia, e o pôs junto a si: e pôs junto a mim a seu filho, que estava morto."},{text:"21 E levantando-me eu pela manhã para dar de mamar a meu filho, apareceu-me morto: e olhando para êle com mais atenção, já dia claro, achei que êle não era o meu que eu tinha gerado."},{text:"22 E a outra mulher respondeu: Não é assim como tu dizes, mas o teu filho morreu, o meu porém está vivo. A primeira pelo contrário replicava: Mentes: Porque o meu filho está vivo, e o teu é o que morreu. E dêste modo"},{text:"disputavam diante do rei."},{text:"23 Então disse o rei: Esta diz, o meu filho está vivo, e o teu filho está morto. E a outra responde: Não, mas o teu filho é o que morreu, e o meu é o que está vivo."},{text:"24 Disse pois o rei: Trazei-me cá uma espada. E como fôsse trazida uma espada diante do rei,"},{text:"25 dividi, disse êle, em duas partes o menino que está vivo, e dai metade a uma, e metade à outra."},{text:"26 A mulher porém, cujo filho estava vivo, disse ao rei: (porque as suas entranhas se lhe enterneceram por seu filho:) Senhor, eu te peço que dês a ela o menino vivo, e não o mates. A outra pelo contrário dizia: Não seja"},{text:"nem para mim, nem para ti, mas divida-se."},{text:"27 Respondeu o rei, e disse: Dai a esta o menino vivo, e não se mate: porque esta é sua mãe."},{text:"28 Tendo pois ouvido todo o Israel como o rei havia sentenciado êste negócio, temeram ao rei, vendo que nêle estava a sabedoria de Deus para fazer justiça."},{text:"1 Reis — capítulo 4."},{text:"1 Mas o rei Salomão reinava sôbre tod